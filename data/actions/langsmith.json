{
  "actions": {
    "create_dataset": {
      "description": "Create a new LangSmith dataset to collect examples in.",
      "display_name": "Create dataset",
      "display_str_template": "Create LangSmith dataset '{0}'.",
      "handler": "actions.create_dataset",
      "id": "langsmith_create_dataset",
      "method": "POST",
      "mock_response": {
        "created_at": "2026-07-31T12:00:00Z",
        "data_type": "kv",
        "description": "Golden QA pairs",
        "example_count": 0,
        "id": "3f29a1e2-8c4b-4f7a-9c1a-1b2c3d4e5f60",
        "name": "QA regression set"
      },
      "name": "create_dataset",
      "parameters": [
        {
          "description": "A name for the dataset.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional description of the dataset.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "kv",
          "description": "The kind of examples this dataset holds.",
          "display_name": "Data type",
          "name": "data_type",
          "options": [
            {
              "label": "Key-value (general data)",
              "value": "kv"
            },
            {
              "label": "LLM (prompt / completion text)",
              "value": "llm"
            },
            {
              "label": "Chat (message lists)",
              "value": "chat"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/langsmith/create-dataset",
      "result_str_template": "Dataset created.",
      "returns": {
        "properties": {
          "created_at": {
            "description": "When it was created (ISO 8601).",
            "type": "string"
          },
          "data_type": {
            "description": "The dataset's data type.",
            "type": "string"
          },
          "description": {
            "description": "The dataset description.",
            "type": "string"
          },
          "example_count": {
            "description": "Number of examples in the dataset.",
            "type": "number"
          },
          "id": {
            "description": "The new dataset's ID.",
            "type": "string"
          },
          "name": {
            "description": "The dataset name.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_example": {
      "description": "Add an input/output example to a LangSmith dataset.",
      "display_name": "Create example",
      "display_str_template": "Add an example to a LangSmith dataset.",
      "handler": "actions.create_example",
      "id": "langsmith_create_example",
      "method": "POST",
      "mock_response": {
        "created_at": "2026-07-31T12:05:00Z",
        "dataset_id": "3f29a1e2-8c4b-4f7a-9c1a-1b2c3d4e5f60",
        "id": "7c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f",
        "inputs": {
          "question": "What is the capital of France?"
        },
        "outputs": {
          "answer": "Paris"
        }
      },
      "name": "create_example",
      "parameters": [
        {
          "description": "The dataset to add the example to.",
          "display_name": "Dataset",
          "dynamic_source": "datasets",
          "name": "dataset_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The example's inputs, as fields and values (for example, question: 'What is 2+2?').",
          "display_name": "Inputs",
          "name": "inputs",
          "required": true,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Optional expected outputs, as fields and values (for example, answer: '4').",
          "display_name": "Outputs",
          "name": "outputs",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Optional extra details to store with the example.",
          "display_name": "Metadata",
          "name": "metadata",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Optional split to file the example under (for example, 'train' or 'test'). Defaults to 'base'.",
          "display_name": "Split",
          "name": "split",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/langsmith/create-example",
      "result_str_template": "Example created.",
      "returns": {
        "properties": {
          "created_at": {
            "description": "When it was created (ISO 8601).",
            "type": "string"
          },
          "dataset_id": {
            "description": "The dataset the example belongs to.",
            "type": "string"
          },
          "id": {
            "description": "The new example's ID.",
            "type": "string"
          },
          "inputs": {
            "additionalProperties": true,
            "description": "The example's inputs.",
            "type": "object"
          },
          "outputs": {
            "additionalProperties": true,
            "description": "The example's outputs.",
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "find_datasets": {
      "description": "Search your LangSmith datasets by name and type.",
      "display_name": "Find datasets",
      "display_str_template": "Find LangSmith datasets.",
      "handler": "actions.find_datasets",
      "id": "langsmith_find_datasets",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "datasets": [
          {
            "created_at": "2026-07-31T12:00:00Z",
            "data_type": "kv",
            "description": "Golden QA pairs",
            "example_count": 12,
            "id": "3f29a1e2-8c4b-4f7a-9c1a-1b2c3d4e5f60",
            "name": "QA regression set"
          }
        ]
      },
      "name": "find_datasets",
      "parameters": [
        {
          "description": "Optional text to match within dataset names. Leave blank to return all datasets.",
          "display_name": "Name contains",
          "name": "name_contains",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Only return datasets of this type.",
          "display_name": "Data type",
          "name": "data_type",
          "options": [
            {
              "label": "Key-value (general data)",
              "value": "kv"
            },
            {
              "label": "LLM (prompt / completion text)",
              "value": "llm"
            },
            {
              "label": "Chat (message lists)",
              "value": "chat"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 20,
          "description": "Most datasets to return (1-100). Defaults to 20.",
          "display_name": "Max results",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/langsmith/find-datasets",
      "result_str_template": "Datasets found.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many datasets were returned.",
            "type": "number"
          },
          "datasets": {
            "description": "The matching datasets.",
            "items": {
              "properties": {
                "created_at": {
                  "type": "string"
                },
                "data_type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "example_count": {
                  "type": "number"
                },
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Build and manage LangSmith datasets (create datasets, add examples, and find existing datasets) for evaluating your LLM apps.",
  "display_name": "LangSmith",
  "id": "langsmith"
}
