  "description": "Manage your Wix site: add, look up, update and delete CRM contacts, list your Wix Stores products, review eCommerce orders, and start workflows on new contacts and orders.",
  "display_name": "Wix",
  "id": "wix",
  "logo": "https://www.lodol.com/app-icons/wix-icon.svg",
  "triggers": {
    "wix_new_contact_trigger": {
      "description": "Runs for each new contact on your Wix site, whether added by hand, from a form, or by a purchase or sign-up, with their name, email and phone. Contacts already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New contact",
      "id": "wix_new_contact_trigger",
      "output": {
        "created_date": "When the contact was created.",
        "first_name": "First name.",
        "id": "The contact's ID.",
        "last_name": "Last name.",
        "primary_email": "Their main email address.",
        "primary_phone": "Their main phone number.",
        "revision": "How many times the contact has changed.",
        "updated_date": "When the contact last changed."
      },
      "parameters": []
    },
    "wix_new_order_trigger": {
      "description": "Runs for each new order in your Wix store, with its number, total, who bought it and what they bought. Orders already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New order",
      "id": "wix_new_order_trigger",
      "output": {
        "buyer_email": "The buyer's email address.",
        "buyer_first_name": "The buyer's first name.",
        "buyer_last_name": "The buyer's last name.",
        "created_date": "When the order was placed.",
        "currency": "The currency code, such as USD.",
        "fulfillment_status": "Whether it's been sent out.",
        "id": "The order's ID.",
        "line_items": "What was bought: each item's name and quantity.",
        "number": "The order number shown in your dashboard.",
        "payment_status": "Whether it's paid, such as PAID or NOT_PAID.",
        "status": "APPROVED or CANCELED.",
        "total": "The order total, with its currency symbol."
      },
      "parameters": []
    }
  }
