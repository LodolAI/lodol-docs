{
  "actions": {
    "get_domain_stats": {
      "description": "Get summary statistics for email events, such as delivered or opened, on your Mailgun domain. Requires a full-access account API key; a domain-restricted Sending key cannot read stats.",
      "display_name": "Get domain stats",
      "display_str_template": "Get stats for event '{0}'.",
      "handler": "actions.get_domain_stats",
      "id": "mailgun_domain_stats",
      "method": "POST",
      "mock_response": {
        "stats": {}
      },
      "name": "get_domain_stats",
      "parameters": [
        {
          "description": "The email event to report on.",
          "display_name": "Event",
          "name": "event",
          "options": [
            {
              "label": "Accepted",
              "value": "accepted"
            },
            {
              "label": "Delivered",
              "value": "delivered"
            },
            {
              "label": "Failed",
              "value": "failed"
            },
            {
              "label": "Opened",
              "value": "opened"
            },
            {
              "label": "Clicked",
              "value": "clicked"
            },
            {
              "label": "Unsubscribed",
              "value": "unsubscribed"
            },
            {
              "label": "Complained",
              "value": "complained"
            },
            {
              "label": "Stored",
              "value": "stored"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Start date (YYYY-MM-DD).",
          "display_name": "Start date",
          "name": "start_date",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "End date (YYYY-MM-DD).",
          "display_name": "End date",
          "name": "end_date",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional grouping for the results.",
          "display_name": "Group results by",
          "name": "resolution",
          "options": [
            {
              "label": "Hour",
              "value": "hour"
            },
            {
              "label": "Day",
              "value": "day"
            },
            {
              "label": "Month",
              "value": "month"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailgun/domain-stats",
      "result_str_template": "Domain stats retrieved.",
      "returns": {
        "properties": {
          "stats": {
            "description": "Stats details.",
            "properties": {},
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "list_events": {
      "description": "List what happened to emails sent from your Mailgun domain - accepted, delivered, failed (bounced), opened, clicked, unsubscribed or marked as spam - newest first, or oldest first from a time. Mailgun keeps events for a few days to a month, depending on your plan. Requires a full-access account API key.",
      "display_name": "List events",
      "display_str_template": "List Mailgun events.",
      "handler": "actions.list_events",
      "id": "mailgun_list_events",
      "method": "POST",
      "mock_response": {
        "result": {
          "count": 1,
          "events": [
            {
              "event": "failed",
              "from": "shop@mg.example.com",
              "id": "czsjqFATSlC3QtAK-C80nw",
              "message_id": "20261107120000.1.ABC@mg.example.com",
              "reason": "No such mailbox",
              "recipient": "ana@example.com",
              "severity": "permanent",
              "subject": "Your order has shipped",
              "tags": [
                "orders"
              ],
              "time": "2026-11-07T12:04:31Z",
              "url": ""
            }
          ],
          "next_page": "WzMsIFsiZiJdLCBbXV0="
        }
      },
      "name": "list_events",
      "output_formatter": "actions.format_events_output",
      "parameters": [
        {
          "description": "Only this kind of event. Leave blank for every kind.",
          "display_name": "Event",
          "name": "event",
          "options": [
            {
              "label": "Accepted",
              "value": "accepted"
            },
            {
              "label": "Delivered",
              "value": "delivered"
            },
            {
              "label": "Failed (bounced)",
              "value": "failed"
            },
            {
              "label": "Opened",
              "value": "opened"
            },
            {
              "label": "Clicked",
              "value": "clicked"
            },
            {
              "label": "Unsubscribed",
              "value": "unsubscribed"
            },
            {
              "label": "Marked as spam",
              "value": "complained"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only events for this recipient's email address.",
          "display_name": "Recipient",
          "name": "recipient",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only events from this time on, listed oldest first. Leave blank for the newest first.",
          "display_name": "From",
          "name": "since",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "How many events to return, from 1 to 300. 50 if left blank.",
          "display_name": "How many",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The next_page value of an earlier 'List events', to read on from there. The other fields are ignored then.",
          "display_name": "Next page",
          "name": "page",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailgun/list-events",
      "result_str_template": "Found {mailgun_list_events,result,count} events.",
      "returns": {
        "properties": {
          "result": {
            "description": "The events found.",
            "properties": {
              "count": {
                "description": "How many events are on this page.",
                "type": "number"
              },
              "events": {
                "description": "The events, in the order asked for.",
                "items": {
                  "properties": {
                    "event": {
                      "description": "What happened: delivered, failed, opened and so on.",
                      "type": "string"
                    },
                    "from": {
                      "description": "Who the email was from.",
                      "type": "string"
                    },
                    "id": {
                      "description": "The event's ID.",
                      "type": "string"
                    },
                    "message_id": {
                      "description": "The email's Message-ID.",
                      "type": "string"
                    },
                    "reason": {
                      "description": "For a failure: why, as the receiving server said.",
                      "type": "string"
                    },
                    "recipient": {
                      "description": "The recipient's email address.",
                      "type": "string"
                    },
                    "severity": {
                      "description": "For a failure: permanent (a bounce) or temporary.",
                      "type": "string"
                    },
                    "subject": {
                      "description": "The email's subject.",
                      "type": "string"
                    },
                    "tags": {
                      "description": "The email's tags.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "time": {
                      "description": "When it happened (UTC).",
                      "type": "string"
                    },
                    "url": {
                      "description": "For a click: the link clicked.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "next_page": {
                "description": "Pass as Next page to read on; empty when nothing came back.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "send_email": {
      "description": "Send a plain text or HTML email through a Mailgun sending domain.",
      "display_name": "Send an email",
      "display_str_template": "Send an email to '{0}'.",
      "handler": "actions.send_email",
      "id": "mailgun_send_email",
      "method": "POST",
      "mock_response": {
        "result": {}
      },
      "name": "send_email",
      "parameters": [
        {
          "description": "Sender email address (must belong to the Mailgun domain).",
          "display_name": "From email",
          "name": "from_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Recipient email address or comma-separated list.",
          "display_name": "To",
          "name": "to",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Subject line for the email.",
          "display_name": "Subject",
          "name": "subject",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Plain text body.",
          "display_name": "Body (plain text)",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional HTML version of the email body.",
          "display_name": "Body (HTML)",
          "multiline": true,
          "name": "html",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional CC recipients (comma-separated).",
          "display_name": "CC",
          "name": "cc",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional BCC recipients (comma-separated).",
          "display_name": "BCC",
          "name": "bcc",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailgun/send-email",
      "result_str_template": "Email sent via Mailgun.",
      "returns": {
        "properties": {
          "result": {
            "description": "Result details.",
            "properties": {},
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "send_templated_email": {
      "description": "Send an email whose body is one of your Mailgun templates, filling in its {{variables}}.",
      "display_name": "Send an email with a template",
      "display_str_template": "Send template '{3}' to '{1}'.",
      "handler": "actions.send_templated_email",
      "id": "mailgun_send_templated_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "id": "<20261107120000.1.ABC@mg.example.com>",
          "message": "Queued. Thank you."
        }
      },
      "name": "send_templated_email",
      "parameters": [
        {
          "description": "Sender email address (must belong to the Mailgun domain).",
          "display_name": "From",
          "name": "from_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Recipient email address or comma-separated list.",
          "display_name": "To",
          "name": "to",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Subject line for the email.",
          "display_name": "Subject",
          "name": "subject",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Mailgun template to send.",
          "display_name": "Template",
          "dynamic_source": "templates",
          "dynamic_source_allows_custom": true,
          "name": "template",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The values to fill the template's {{variables}} with, such as first_name: Ana.",
          "display_name": "Template values",
          "name": "variables",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Optional. A version of the template to send instead of its active one, by its tag.",
          "display_name": "Template version",
          "name": "template_version",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional CC recipients (comma-separated).",
          "display_name": "CC",
          "name": "cc",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional BCC recipients (comma-separated).",
          "display_name": "BCC",
          "name": "bcc",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailgun/send-templated-email",
      "result_str_template": "Email sent via Mailgun.",
      "returns": {
        "properties": {
          "result": {
            "description": "What Mailgun said when it took the email.",
            "properties": {
              "id": {
                "description": "The message's ID in Mailgun.",
                "type": "string"
              },
              "message": {
                "description": "Mailgun's answer, such as Queued.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    }
  },
  "categories": [
    "Email"
  ],
  "description": "Send and track emails with Mailgun.",
  "display_name": "Mailgun",
  "id": "mailgun",
  "logo": "https://www.lodol.com/app-icons/mailgun-icon.png",
  "triggers": {
    "mailgun_email_event_trigger": {
      "description": "Runs when something happens to an email sent from your Mailgun domain - delivered, failed (bounced), opened, clicked, unsubscribed or marked as spam - once for each recipient, with who it was and why it failed. Events from before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Email delivered, bounced or opened",
      "id": "mailgun_email_event_trigger",
      "output": {
        "event": "string",
        "from": "string",
        "id": "string",
        "message_id": "string",
        "reason": "string",
        "recipient": "string",
        "severity": "string",
        "subject": "string",
        "tags": "string",
        "time": "string",
        "url": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "What to watch for: accepted, delivered, failed (bounced), opened, clicked, unsubscribed or complained (marked as spam).",
          "display_name": "Event",
          "name": "event",
          "required": true
        }
      ]
    }
  }
}
