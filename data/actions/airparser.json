{
  "actions": {
    "get_parsed_document": {
      "description": "Get the information Airparser extracted from a specific document.",
      "display_name": "Get parsed document",
      "display_str_template": "Get parsed data for Airparser document {document_id}",
      "handler": "actions.get_parsed_document",
      "id": "airparser_get_parsed_document",
      "method": "POST",
      "mock_response": {
        "document": {
          "_id": "doc-001",
          "json": {
            "date": "2024-01-15",
            "invoice_number": "INV-2024-001",
            "total": 1234.56
          },
          "status": "parsed"
        },
        "status": "success"
      },
      "name": "get_parsed_document",
      "output_formatter": "actions.format_get_parsed_document_output",
      "parameters": [
        {
          "description": "The document to retrieve, given by its ID or URL.",
          "display_name": "Document",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/airparser/get-document",
      "result_str_template": "Document data retrieved successfully",
      "returns": {
        "properties": {
          "document": {
            "properties": {
              "_id": {
                "description": "Document ID",
                "type": "string"
              },
              "data_text": {
                "description": "The document's raw extracted text",
                "type": "string"
              },
              "json": {
                "description": "Parsed/extracted fields from the document",
                "type": "object"
              },
              "status": {
                "description": "Document status",
                "type": "string"
              }
            },
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_documents": {
      "description": "List documents in an Airparser inbox.",
      "display_name": "List documents",
      "display_str_template": "List documents in Airparser inbox {inbox_id}",
      "handler": "actions.list_documents",
      "id": "airparser_list_documents",
      "method": "POST",
      "mock_response": {
        "documents": [
          {
            "_id": "doc-001",
            "created_at": "2024-01-15T10:00:00Z",
            "status": "parsed"
          },
          {
            "_id": "doc-002",
            "created_at": "2024-01-16T11:00:00Z",
            "status": "parsed"
          }
        ],
        "status": "success"
      },
      "name": "list_documents",
      "output_formatter": "actions.format_list_documents_output",
      "parameters": [
        {
          "description": "The inbox to list documents from.",
          "display_name": "Inbox",
          "dynamic_source": "inboxes",
          "name": "inbox_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only include documents on or after this date.",
          "display_name": "After This Date",
          "name": "from_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only include documents on or before this date.",
          "display_name": "Before This Date",
          "name": "to_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only include documents with these statuses.",
          "display_name": "Status",
          "multi_select": true,
          "name": "status",
          "options": [
            {
              "label": "New",
              "value": "new"
            },
            {
              "label": "Importing",
              "value": "importing"
            },
            {
              "label": "Parsing",
              "value": "parsing"
            },
            {
              "label": "Parsed",
              "value": "parsed"
            },
            {
              "label": "Failed",
              "value": "fail"
            },
            {
              "label": "Quota Exceeded",
              "value": "quota"
            },
            {
              "label": "Exception",
              "value": "exception"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Filter the list of documents returned.",
          "display_name": "Query Filters",
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/airparser/list-documents",
      "result_str_template": "Documents listed successfully",
      "returns": {
        "properties": {
          "documents": {
            "items": {
              "properties": {
                "_id": {
                  "description": "Document ID",
                  "type": "string"
                },
                "created_at": {
                  "description": "ISO 8601 creation timestamp",
                  "type": "string"
                },
                "status": {
                  "description": "Document status (e.g. parsed, fail, new)",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_inboxes": {
      "description": "List all inboxes in the Airparser account.",
      "display_name": "List inboxes",
      "display_str_template": "List all Airparser inboxes",
      "handler": "actions.list_inboxes",
      "id": "airparser_list_inboxes",
      "method": "POST",
      "mock_response": {
        "inboxes": [
          {
            "_id": "inbox-001",
            "email": "invoices@inbox.airparser.com",
            "name": "Invoices"
          },
          {
            "_id": "inbox-002",
            "email": "receipts@inbox.airparser.com",
            "name": "Receipts"
          }
        ],
        "status": "success"
      },
      "name": "list_inboxes",
      "output_formatter": "actions.format_list_inboxes_output",
      "parameters": [],
      "path": "/actions/library/airparser/list-inboxes",
      "result_str_template": "Inboxes listed successfully",
      "returns": {
        "properties": {
          "inboxes": {
            "items": {
              "properties": {
                "_id": {
                  "description": "Inbox ID",
                  "type": "string"
                },
                "email": {
                  "description": "Inbox email address",
                  "type": "string"
                },
                "name": {
                  "description": "Inbox name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "upload_document": {
      "description": "Upload a document to an Airparser inbox for parsing.",
      "display_name": "Upload document",
      "display_str_template": "Upload document to Airparser inbox {inbox_id}",
      "handler": "actions.upload_document",
      "id": "airparser_upload_document",
      "method": "POST",
      "mock_response": {
        "document_id": "doc-abc123",
        "status": "success"
      },
      "name": "upload_document",
      "output_formatter": "actions.format_upload_document_output",
      "parameters": [
        {
          "description": "The inbox to upload the document to.",
          "display_name": "Inbox",
          "dynamic_source": "inboxes",
          "name": "inbox_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "description": "The document to upload, given by its URL or uploaded here.",
          "display_name": "File",
          "name": "file",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Extra details to attach to the document",
          "display_name": "Metadata",
          "name": "metadata",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/airparser/upload-document",
      "result_str_template": "Document uploaded successfully",
      "returns": {
        "properties": {
          "document_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Automatically pull key information out of documents with Airparser.",
  "display_name": "Airparser",
  "id": "airparser"
}
