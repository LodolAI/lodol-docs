  "description": "Read business profiles and reviews, reply to reviews and manage review tags.",
  "display_name": "Trustpilot",
  "id": "trustpilot",
  "logo": "https://www.lodol.com/app-icons/trustpilot-icon.png",
  "triggers": {
    "trustpilot_new_review_trigger": {
      "description": "Runs for each new review in Trustpilot. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New review",
      "id": "trustpilot_new_review_trigger",
      "output": {
        "record": "object"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Business unit id.",
          "display_name": "Business unit id",
          "name": "business_unit_id",
          "required": false
        }
      ]
    },
    "trustpilot_review_changed_trigger": {
      "description": "Runs for each review changed in Trustpilot. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Review changed",
