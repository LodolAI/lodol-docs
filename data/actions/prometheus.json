            {
              "label": "Every minute",
              "value": "1m"
            },
            {
              "label": "Every 5 minutes",
              "value": "5m"
            },
            {
              "label": "Every 15 minutes",
              "value": "15m"
            },
            {
              "label": "Every hour",
              "value": "1h"
            },
            {
              "label": "Every 6 hours",
              "value": "6h"
            },
            {
              "label": "Every day",
              "value": "1d"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/prometheus/run-range-query",
      "result_str_template": "Query returned {prometheus_run_range_query,count} series.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many series there are",
            "type": "number"
          },
          "end": {
            "description": "When it ended, in UTC (ISO 8601)",
            "type": "string"
          },
          "query": {
            "description": "The query that ran",
            "type": "string"
          },
          "series": {
            "description": "Each series with its points",
            "items": {
              "description": "One series",
              "properties": {
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "The series' labels",
                  "type": "object"
                },
                "points": {
                  "description": "Its points, oldest first",
                  "items": {
                    "description": "One point",
                    "properties": {
