        }
      ],
      "path": "/actions/library/prometheus/list-targets",
      "result_str_template": "{prometheus_list_targets,down_count} target(s) down.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many targets were returned",
            "type": "number"
          },
          "down_count": {
