    "run_query": {
      "description": "Run a PromQL query for one moment, now unless you pick another, and get each result's labels and value. 'value' holds the first result's number, handy for a single total or rate.",
      "display_name": "Run query",
      "display_str_template": "Run the Prometheus query {0}.",
      "handler": "actions.run_query",
      "id": "prometheus_run_query",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "query": "up",
        "result_type": "vector",
        "results": [
          {
            "labels": {
              "__name__": "up",
              "instance": "localhost:9090",
              "job": "prometheus"
            },
            "raw_value": "1",
            "time": "2026-10-27T10:20:00Z",
            "value": 1
          }
        ],
        "truncated": false,
        "value": 1
      },
      "name": "run_query",
      "output_formatter": "actions.format_query",
      "parameters": [
        {
          "description": "A PromQL expression, such as sum(rate(http_requests_total[5m])).",
          "display_name": "Query",
          "examples": [
            {
              "label": "Targets that are down",
              "value": "up == 0"
            },
            {
              "label": "Request rate",
              "value": "sum(rate(http_requests_total[5m]))"
            }
          ],
          "multiline": true,
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The moment to evaluate it at. Leave empty for now.",
          "display_name": "At",
          "name": "at_time",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/prometheus/run-query",
      "result_str_template": "Query returned {prometheus_run_query,count} result(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many results there are",
            "type": "number"
          },
          "query": {
            "description": "The query that ran",
            "type": "string"
          },
          "result_type": {
            "description": "vector, scalar, string or matrix",
            "type": "string"
          },
          "results": {
            "description": "Each result with its labels and value",
            "items": {
              "description": "One result",
              "properties": {
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "The series' labels, such as job and instance",
                  "type": "object"
                },
                "raw_value": {
                  "description": "The value exactly as Prometheus gave it, such as 1 or NaN",
                  "type": "string"
                },
                "time": {
                  "description": "When the value was taken, in UTC (ISO 8601)",
                  "type": "string"
                },
                "value": {
                  "description": "The value as a number; empty for NaN or infinity",
                  "nullable": true,
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "truncated": {
            "description": "True when there were more than 1000 results",
            "type": "boolean"
          },
          "value": {
            "description": "The first result's value; empty when there are none",
            "nullable": true,
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "run_range_query": {
      "description": "Run a PromQL query over a time range, one point per step, and get each series' points. For trends and reports.",
      "display_name": "Run range query",
      "display_str_template": "Run the Prometheus range query {0}.",
      "handler": "actions.run_range_query",
      "id": "prometheus_run_range_query",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "end": "2026-10-27T10:02:00Z",
        "query": "up",
        "series": [
          {
            "labels": {
              "__name__": "up",
              "instance": "localhost:9090",
              "job": "prometheus"
            },
            "points": [
              {
                "raw_value": "1",
                "time": "2026-10-27T10:00:00Z",
                "value": 1
              },
              {
                "raw_value": "1",
                "time": "2026-10-27T10:01:00Z",
                "value": 1
              },
              {
                "raw_value": "1",
                "time": "2026-10-27T10:02:00Z",
                "value": 1
              }
            ]
          }
        ],
        "start": "2026-10-27T10:00:00Z",
        "step_seconds": 60,
        "truncated": false
      },
      "name": "run_range_query",
      "output_formatter": "actions.format_range_query",
      "parameters": [
        {
          "description": "A PromQL expression, such as sum(rate(http_requests_total[5m])).",
          "display_name": "Query",
          "examples": [
            {
              "label": "Targets that are down",
              "value": "up == 0"
            },
            {
              "label": "Request rate",
              "value": "sum(rate(http_requests_total[5m]))"
            }
          ],
          "multiline": true,
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the range begins.",
          "display_name": "From",
          "name": "start",
          "required": true,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "When the range ends. Leave empty for now.",
          "display_name": "To",
          "name": "end",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "default": "1m",
          "description": "How far apart the points are. Defaults to every minute. A duration such as 30s or 2h works too.",
          "display_name": "Resolution",
          "name": "step",
          "options": [
            {
              "label": "Every 15 seconds",
              "value": "15s"
