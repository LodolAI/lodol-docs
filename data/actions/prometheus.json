{
  "actions": {
    "find_series": {
      "description": "List the series that match a selector, with all their labels, optionally only those seen within a time range.",
      "display_name": "Find series",
      "display_str_template": "Find the series matching {0} in Prometheus.",
      "handler": "actions.find_series",
      "id": "prometheus_find_series",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "has_more": false,
        "match": "up",
        "series": [
          {
            "__name__": "up",
            "instance": "localhost:9090",
            "job": "prometheus"
          }
        ]
      },
      "name": "find_series",
      "output_formatter": "actions.format_series",
      "parameters": [
        {
          "description": "A series selector, such as up{job=\"node\"}.",
          "display_name": "Selector",
          "examples": [
            {
              "label": "Node exporter targets",
              "value": "up{job=\"node\"}"
            }
          ],
          "name": "match",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only series with data after this moment.",
          "display_name": "Seen after",
          "name": "start",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Only series with data before this moment.",
          "display_name": "Seen before",
          "name": "end",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "The most to return. Defaults to 100.",
          "display_name": "Limit",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/prometheus/find-series",
      "result_str_template": "{prometheus_find_series,count} series.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many series were returned",
            "type": "number"
          },
          "has_more": {
            "description": "True when more series match than the limit",
            "type": "boolean"
          },
          "match": {
            "description": "The selector",
            "type": "string"
          },
          "series": {
            "description": "The matching series' labels",
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "A series' labels",
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_label_values": {
      "description": "List the values a label takes, such as every job or instance, optionally only on series matching a selector.",
      "display_name": "Get label values",
      "display_str_template": "Get the values of label {0} from Prometheus.",
      "handler": "actions.get_label_values",
      "id": "prometheus_get_label_values",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "has_more": false,
        "label": "job",
        "values": [
          "node",
          "prometheus"
        ]
      },
      "name": "get_label_values",
      "output_formatter": "actions.format_label_values",
      "parameters": [
        {
          "description": "The label, such as job or instance.",
          "display_name": "Label",
          "dynamic_source": "labels",
          "dynamic_source_allows_custom": true,
          "name": "label",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A series selector, such as up{job=\"node\"}. Leave empty for all series.",
          "display_name": "Only on series",
          "name": "match",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most to return. Defaults to 100.",
          "display_name": "Limit",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/prometheus/get-label-values",
      "result_str_template": "{prometheus_get_label_values,count} value(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many values were returned",
            "type": "number"
          },
          "has_more": {
            "description": "True when it has more values than the limit",
            "type": "boolean"
          },
          "label": {
            "description": "The label",
            "type": "string"
          },
          "values": {
            "description": "Its values, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_metric_metadata": {
      "description": "Get a metric's type (counter, gauge, histogram or summary), unit and help text, or list them for every metric.",
      "display_name": "Get metric info",
      "display_str_template": "Get metric info from Prometheus.",
      "handler": "actions.get_metric_metadata",
      "id": "prometheus_get_metric_metadata",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "has_more": false,
        "metrics": [
          {
            "help": "Whether the target is up",
            "name": "up",
            "type": "gauge",
            "unit": ""
          }
        ]
      },
      "name": "get_metric_metadata",
      "output_formatter": "actions.format_metadata",
      "parameters": [
        {
          "description": "The metric. Leave empty to list every metric.",
          "display_name": "Metric",
          "dynamic_source": "metrics",
          "dynamic_source_allows_custom": true,
          "name": "metric",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most to return. Defaults to 100.",
          "display_name": "Limit",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/prometheus/get-metric-metadata",
      "result_str_template": "Info for {prometheus_get_metric_metadata,count} metric(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many metrics were returned",
            "type": "number"
          },
          "has_more": {
            "description": "True when there are more than the limit",
            "type": "boolean"
          },
          "metrics": {
            "description": "The metrics",
            "items": {
              "description": "A metric",
              "properties": {
                "help": {
                  "description": "Its help text",
                  "type": "string"
                },
                "name": {
                  "description": "The metric's name",
                  "type": "string"
                },
                "type": {
                  "description": "counter, gauge, histogram, summary or unknown",
                  "type": "string"
                },
                "unit": {
                  "description": "Its unit, when it declares one",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_alerts": {
      "description": "List the alerts firing or pending now, with their labels, annotations and when they became active. Firing alerts come first.",
      "display_name": "List alerts",
      "display_str_template": "List the alerts in Prometheus.",
      "handler": "actions.list_alerts",
      "id": "prometheus_list_alerts",
      "method": "POST",
      "mock_response": {
        "alerts": [
          {
            "active_since": "2026-10-27T10:15:00Z",
            "annotations": {
              "summary": "More than 5% of requests are failing"
            },
            "labels": {
              "alertname": "HighErrorRate",
              "job": "api",
              "severity": "critical"
            },
            "name": "HighErrorRate",
            "severity": "critical",
            "state": "firing",
            "value": 0.072
          }
        ],
        "count": 1,
        "firing_count": 1
      },
      "name": "list_alerts",
      "output_formatter": "actions.format_alerts",
      "parameters": [
        {
          "default": "any",
          "description": "Which alerts to include. Defaults to firing or pending.",
          "display_name": "State",
          "name": "state",
          "options": [
            {
              "label": "Firing or pending",
              "value": "any"
            },
            {
              "label": "Firing",
              "value": "firing"
            },
            {
              "label": "Pending",
              "value": "pending"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only alerts of this name. Leave empty for all.",
          "display_name": "Alert",
          "dynamic_source": "alert_names",
          "dynamic_source_allows_custom": true,
          "name": "alert_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/prometheus/list-alerts",
      "result_str_template": "{prometheus_list_alerts,firing_count} alert(s) firing.",
      "returns": {
        "properties": {
          "alerts": {
            "description": "The alerts",
            "items": {
              "description": "An alert",
              "properties": {
                "active_since": {
                  "description": "When it became active, in UTC (ISO 8601)",
                  "type": "string"
                },
                "annotations": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Its annotations, such as summary and description",
                  "type": "object"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "All its labels",
                  "type": "object"
                },
                "name": {
                  "description": "The alert's name",
                  "type": "string"
                },
                "severity": {
                  "description": "Its severity label, when it has one",
                  "type": "string"
                },
                "state": {
                  "description": "firing, or pending while it waits out its 'for' time",
                  "type": "string"
                },
                "value": {
                  "description": "The value that set it off",
                  "nullable": true,
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "count": {
            "description": "How many alerts were returned",
            "type": "number"
          },
          "firing_count": {
            "description": "How many of them are firing",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_rules": {
      "description": "List the server's alerting or recording rules with their query, health and, for alerts, whether they are firing.",
      "display_name": "List rules",
      "display_str_template": "List the rules in Prometheus.",
      "handler": "actions.list_rules",
      "id": "prometheus_list_rules",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "rules": [
          {
            "active_alert_count": 1,
            "group": "api",
            "health": "ok",
            "labels": {
              "severity": "critical"
            },
            "last_error": "",
            "name": "HighErrorRate",
            "query": "rate(errors_total[5m]) > 0.05",
            "state": "firing",
            "type": "alert"
          }
        ]
      },
      "name": "list_rules",
      "output_formatter": "actions.format_rules",
      "parameters": [
        {
          "default": "alert",
          "description": "Which rules to list. Defaults to alerting rules.",
          "display_name": "Rules",
          "name": "rule_type",
          "options": [
            {
              "label": "Alerting rules",
              "value": "alert"
            },
            {
              "label": "Recording rules",
              "value": "record"
            },
            {
              "label": "Both",
              "value": "any"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only rules in this group. Leave empty for every group.",
          "display_name": "Group",
          "name": "group",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/prometheus/list-rules",
      "result_str_template": "{prometheus_list_rules,count} rule(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many rules",
            "type": "number"
          },
          "rules": {
            "description": "The rules",
            "items": {
              "description": "A rule",
              "properties": {
                "active_alert_count": {
                  "description": "How many alerts it has firing or pending",
                  "type": "number"
                },
                "group": {
                  "description": "The rule group it is in",
                  "type": "string"
                },
                "health": {
                  "description": "ok, err or unknown",
                  "type": "string"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "The labels it adds",
                  "type": "object"
                },
                "last_error": {
                  "description": "The last error evaluating it; empty when none",
                  "type": "string"
                },
                "name": {
                  "description": "The rule's name",
                  "type": "string"
                },
                "query": {
                  "description": "Its PromQL expression",
                  "type": "string"
                },
                "state": {
                  "description": "For an alert rule: inactive, pending or firing",
                  "type": "string"
                },
                "type": {
                  "description": "alert or record",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
