  "description": "Read Xbox player profiles, presence, achievements, clips and Game Pass catalogs.",
  "display_name": "OpenXBL",
  "id": "openxbl",
  "logo": "https://www.lodol.com/app-icons/openxbl-icon.png",
  "triggers": {
    "openxbl_new_friend_trigger": {
      "description": "Runs each time a xbox friend is added in OpenXBL. Ones added before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Xbox friend added",
      "id": "openxbl_new_friend_trigger",
      "output": {
        "record": "object with the fields xuid, gamertag, presenceState"
      },
      "parameters": []
    },
    "openxbl_new_game_clip_trigger": {
      "description": "Runs for each new Xbox game clip in OpenXBL. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New Xbox game clip",
      "id": "openxbl_new_game_clip_trigger",
      "output": {
        "record": "object with the fields gameClipId, titleName, dateRecorded"
      },
      "parameters": []
    },
    "openxbl_new_screenshot_trigger": {
      "description": "Runs for each new Xbox screenshot in OpenXBL. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New Xbox screenshot",
      "id": "openxbl_new_screenshot_trigger",
      "output": {
        "record": "object with the fields screenshotId, titleName, dateTaken"
      },
      "parameters": []
    }
  }
}
