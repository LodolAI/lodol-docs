{
  "actions": {
    "check_model": {
      "description": "Check whether a model is loaded today before a step relies on it. Models other than default and ui change every day, so a workflow built on one should ask first. A model that is not there is reported as a value rather than a failed step, with the nearest names that are, so the workflow can fall back to one of them.",
      "display_name": "Check a model is available",
      "display_str_template": "Check the {0} model is available.",
      "handler": "actions.check_model",
      "id": "colormind_check_model",
      "method": "POST",
      "mock_response": {
        "available": true,
        "is_permanent": false,
        "message": "The makoto_shinkai model is loaded today. Models other than default and ui change at 08:00 UTC.",
        "model": "makoto_shinkai",
        "model_count": 6,
        "models": [
          "default",
          "ui",
          "makoto_shinkai",
          "metroid_fusion",
          "akira_film",
          "flower_photography"
        ],
        "suggestions": []
      },
      "name": "check_model",
      "output_formatter": "actions.format_check_model_output",
      "parameters": [
        {
          "description": "The model to check, in any spelling: Makoto Shinkai is makoto_shinkai.",
          "display_name": "Model",
          "dynamic_source": "models",
          "dynamic_source_allows_custom": true,
          "examples": [
            {
              "label": "The general model",
              "value": "default"
            },
            {
              "label": "The UI model",
              "value": "ui"
            },
            {
              "label": "A daily model",
              "value": "makoto_shinkai"
            }
          ],
          "name": "model",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/colormind/check-model",
      "result_str_template": "Model checked.",
      "returns": {
