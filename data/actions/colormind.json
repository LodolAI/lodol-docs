    "check_service_status": {
      "description": "Check whether Colormind is answering, how quickly, and how many models it has loaded. This is the one action that reports a problem as a value instead of failing the step, so a workflow can decide what to do about it. It also says whether the check fell in the daily reload window at 08:00 UTC, when the service is down for about 30 seconds while the day's models load, and when the next reload is.",
      "display_name": "Check service status",
      "display_str_template": "Check the Colormind status.",
      "handler": "actions.check_service_status",
      "id": "colormind_check_service_status",
