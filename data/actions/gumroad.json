      "id": "gumroad_new_sale_trigger",
      "output": {
        "created_at": "When the sale happened.",
        "currency": "The currency, such as usd.",
        "email": "The buyer's email address.",
        "formatted_total_price": "What was paid, written out, such as $9.",
        "full_name": "The buyer's name, when they gave one.",
        "id": "The sale's ID, for Get sale.",
        "license_key": "The buyer's license key, for products that give one.",
        "order_id": "Gumroad's order number.",
        "price": "What was paid, in cents (900 is $9.00).",
        "product_id": "The product's ID.",
        "product_name": "The product's name.",
        "quantity": "How many were bought.",
        "subscription_id": "The membership this sale pays for, if it's one.",
        "variants": "The version or options bought, and how many."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only run for sales of this product, by its Gumroad product ID from List products. Leave empty for every product.",
