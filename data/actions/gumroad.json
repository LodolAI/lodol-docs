  "logo": "https://www.lodol.com/app-icons/gumroad-icon.svg",
  "triggers": {
    "gumroad_new_sale_trigger": {
      "description": "Runs for each new sale on your Gumroad account, including each membership payment, with the buyer's email, the product, what they paid and their license key. Sales already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
