      "handler": "actions.get_product",
      "id": "gumroad_get_product",
      "method": "POST",
      "mock_response": {
        "currency": "usd",
        "formatted_price": "$9",
        "id": "kzoJK",
        "name": "The Complete Guide",
        "price": 900,
        "published": true,
        "sales_count": 142,
        "url": "https://example.gumroad.com/l/guide"
      },
      "name": "get_product",
      "parameters": [
        {
          "description": "The Gumroad product ID, as returned by List products.",
          "display_name": "Product ID",
          "name": "product_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gumroad/get-product",
      "result_str_template": "Gumroad product retrieved.",
      "returns": {
        "properties": {
          "currency": {
            "description": "Currency code, for example 'usd'",
            "type": "string"
          },
          "formatted_price": {
            "description": "Human-readable price, for example '$9'",
            "type": "string"
          },
          "id": {
            "description": "Gumroad product ID",
            "type": "string"
          },
          "name": {
            "description": "Product name",
            "type": "string"
          },
          "price": {
            "description": "Price in the currency's smallest unit, for example cents",
            "type": "number"
          },
          "published": {
            "description": "Whether the product is currently published",
            "type": "boolean"
          },
          "sales_count": {
            "description": "Number of sales to date",
            "type": "number"
          },
          "url": {
            "description": "Public URL where the product sells",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
