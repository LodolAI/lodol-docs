{
  "actions": {
    "create_webhook": {
      "description": "Have a form post each completed result to a web address. If the form already posts to that address, its handshake key is updated instead.",
      "display_name": "Create webhook",
      "display_str_template": "Create webhook in Formsite.",
      "handler": "actions.create_webhook",
      "id": "formsite_create_webhook",
      "method": "POST",
      "mock_response": {
        "webhook": {
          "event": "result_completed",
          "handshake_key": "TEST_KEY",
          "url": "https://example.com/hook"
        }
      },
      "name": "create_webhook",
      "output_formatter": "actions.format_create_webhook_output",
      "parameters": [
        {
          "description": "The form. Pick one, or give its directory from an earlier step.",
          "display_name": "Form",
          "dynamic_source": "forms",
          "dynamic_source_allows_custom": true,
          "name": "form_dir",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The web address Formsite posts to, starting with https://.",
          "display_name": "Address",
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A secret text Formsite adds to every post, so your receiver can tell the post is genuine.",
          "display_name": "Handshake key",
          "name": "handshake_key",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/formsite/create-webhook",
      "result_str_template": "Webhook created.",
      "returns": {
        "properties": {
          "webhook": {
            "description": "The webhook",
            "properties": {
              "event": {
                "description": "The event that posts, always result_completed",
                "type": "string"
              },
              "handshake_key": {
                "description": "The secret text Formsite adds to every post",
                "type": "string"
              },
              "url": {
                "description": "The address Formsite posts to",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_webhook": {
      "description": "Stop a form posting to a web address.",
      "display_name": "Delete webhook",
      "display_str_template": "Delete webhook in Formsite.",
      "handler": "actions.delete_webhook",
      "id": "formsite_delete_webhook",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "url": "https://example.com/hook"
      },
      "name": "delete_webhook",
      "output_formatter": "actions.format_delete_webhook_output",
      "parameters": [
        {
          "description": "The form. Pick one, or give its directory from an earlier step.",
          "display_name": "Form",
          "dynamic_source": "forms",
          "dynamic_source_allows_custom": true,
          "name": "form_dir",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The web address Formsite posts to, starting with https://.",
          "display_name": "Address",
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/formsite/delete-webhook",
      "result_str_template": "Webhook deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Always true once deleted",
            "type": "boolean"
          },
          "url": {
            "description": "The address that was removed",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
