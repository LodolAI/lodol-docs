  "triggers": {
    "listen_labs_new_response_trigger": {
      "description": "Runs for each new completed interview response in Listen Labs. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New completed interview response",
      "id": "listen_labs_new_response_trigger",
      "output": {
        "record": "object with the fields id, readableId, createdAt, updatedAt, progress, responseDurationSeconds, answers, answersArray, urlParams, shortTranscript, tagline, bulletSummary, tags, shortAssistantMessages, qualityScore, otherRemarks, personas"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The study's editable link ID (as used in the response URL) or the study UUID.",
          "display_name": "Study",
          "name": "link_id",
          "required": true
        }
      ]
    },
    "listen_labs_new_study_trigger": {
      "description": "Runs for each new study in Listen Labs. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New study",
      "id": "listen_labs_new_study_trigger",
      "output": {
        "record": "object with the fields id, title, createdAt, linkId, responseCount, creator.name, creator.email, folderPath"
      },
      "parameters": []
    },
    "listen_labs_response_updated_trigger": {
      "description": "Runs each time an interview response changes in Listen Labs. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Interview response updated",
      "id": "listen_labs_response_updated_trigger",
      "output": {
        "record": "object with the fields id, readableId, createdAt, updatedAt, progress, responseDurationSeconds, answers, answersArray, urlParams, shortTranscript, tagline, bulletSummary, tags, shortAssistantMessages, qualityScore, otherRemarks, personas"
      },
      "parameters": [
        {
