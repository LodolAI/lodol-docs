      "mock_response": {
        "data": [
          {
            "SessionId": "example",
            "ai_message": "example",
            "ai_name": "example",
            "ai_score": 1,
            "raw_message": "example"
          }
        ]
      },
      "name": "get_conversation",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "The session ID from Send a message to a persona.",
          "display_name": "Session ID",
          "name": "session_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The persona name before .personal.ai. Leave blank to use your default persona.",
          "display_name": "Persona",
          "name": "persona",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The number of messages to return.",
          "display_name": "Limit",
          "maximum": 500,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/personal-ai/get-conversation",
      "result_str_template": "Get a conversation completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response from Personal AI.",
            "items": {
              "description": "An entry from the response.",
              "properties": {
                "SessionId": {
                  "description": "SessionId.",
                  "type": "string"
                },
                "ai_message": {
                  "description": "AI message.",
                  "type": "string"
                },
                "ai_name": {
                  "description": "AI name.",
                  "type": "string"
                },
                "ai_score": {
                  "description": "AI score.",
                  "type": "number"
                },
                "raw_message": {
                  "description": "Raw message.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "minItems": 0,
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
