{
  "actions": {
    "expand_link": {
      "description": "Expand a Short.io short link into its original long web address.",
      "display_name": "Expand a short link",
      "display_str_template": "Expand {0} into its original URL.",
      "handler": "actions.expand_link",
      "id": "short_io_expand_link",
      "method": "POST",
      "mock_response": {
        "domain": "example.short.gy",
        "id": "lnk_abc",
        "long_url": "https://example.com/my-page",
        "path": "abc123",
        "short_link": "https://example.short.gy/abc123"
      },
      "name": "expand_link",
      "parameters": [
        {
          "description": "The Short.io short link to expand, for example example.short.gy/abc123.",
          "display_name": "Short link",
          "name": "short_link",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/short-io/expand-link",
      "result_str_template": "Original URL: {short_io_expand_link,long_url}",
      "returns": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "long_url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "short_link": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "shorten_link": {
      "description": "Turn a long web address into a short, shareable Short.io link on one of your Short.io domains.",
      "display_name": "Shorten a link",
      "display_str_template": "Shorten {0} with Short.io.",
      "handler": "actions.shorten_link",
      "id": "short_io_shorten_link",
      "method": "POST",
      "mock_response": {
        "domain": "example.short.gy",
        "id": "lnk_abc",
        "original_url": "https://example.com/my-page",
        "path": "abc123",
        "short_link": "https://example.short.gy/abc123"
      },
      "name": "shorten_link",
      "parameters": [
        {
          "description": "The full web address you want to shorten, for example https://example.com/my-page.",
          "display_name": "Long URL",
          "name": "long_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Short.io domain to create the link on. Choose one of the domains configured on your account.",
          "display_name": "Domain",
          "dynamic_source": "domains",
          "name": "domain",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. A label to help you recognize this link later in Short.io.",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/short-io/shorten-link",
      "result_str_template": "Short link: {short_io_shorten_link,short_link}",
      "returns": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "original_url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "short_link": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create branded short links with Short.io and look up where existing short links lead.",
  "display_name": "Short.io",
  "id": "short_io"
}
