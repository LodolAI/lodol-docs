          {
            "degree": 10.77,
            "house": 2,
            "sign": "Scorpio"
          }
        ],
        "latitude": 40.71427,
        "link": "https://cosmyday.com/natal-chart",
        "longitude": -74.00597,
        "midheaven_sign": "Cancer",
        "moon_sign": "Pisces",
        "part_of_fortune": {
          "degree": 19.09,
          "house": 4,
          "sign": "Capricorn"
        },
        "planets": [
          {
            "degree": 24.39,
            "dignity": "neutral",
            "house": 9,
            "planet": "Sun",
            "retrograde": false,
            "sign": "Gemini"
          },
          {
            "degree": 18.99,
            "dignity": "neutral",
            "house": 6,
            "planet": "Moon",
            "retrograde": false,
            "sign": "Pisces"
          }
        ],
        "rising_sign": "Libra",
        "sun_sign": "Gemini"
      },
      "name": "calculate_birth_chart",
      "parameters": [
        {
          "description": "The day they were born, from 1900 to 2100.",
          "display_name": "Date of birth",
          "name": "birth_date",
          "required": true,
          "type": "ParameterType.DATE"
        },
        {
          "description": "The local time they were born. Leave empty if unknown and noon is used: the sun sign stays right, but the rising sign and houses may not.",
          "display_name": "Time of birth",
          "name": "birth_time",
          "required": false,
          "type": "ParameterType.TIME"
        },
        {
          "description": "The town or city they were born in, ideally with its country, such as Leeds, United Kingdom. Leave empty if you fill in Latitude and Longitude instead.",
          "display_name": "Place of birth",
          "examples": [
            {
              "label": "A city",
              "value": "New York"
            },
            {
              "label": "A town and country",
              "value": "Leeds, UK"
            }
          ],
          "name": "birth_place",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only if you know the exact spot: the birthplace's latitude, from -90 (south) to 90 (north). Used instead of Place of birth.",
          "display_name": "Latitude",
          "maximum": 90,
          "minimum": -90,
          "name": "latitude",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Only if you know the exact spot: the birthplace's longitude, from -180 (west) to 180 (east).",
          "display_name": "Longitude",
          "maximum": 180,
          "minimum": -180,
          "name": "longitude",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/cosmyday/calculate-birth-chart",
      "result_str_template": "{cosmyday_calculate_birth_chart,sun_sign}",
      "returns": {
        "properties": {
          "aspects": {
            "description": "The angles between the planets.",
            "items": {
              "properties": {
                "applying": {
                  "description": "True when it was still getting closer to exact.",
                  "type": "boolean"
                },
                "aspect": {
                  "description": "The angle between them: conjunction, sextile, square, trine, opposition and so on.",
                  "type": "string"
                },
                "first_planet": {
                  "description": "One planet.",
                  "type": "string"
                },
                "orb": {
                  "description": "How many degrees off exact it is. Smaller is stronger.",
                  "type": "number"
                },
                "second_planet": {
                  "description": "The other planet.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "birth_date": {
            "description": "The date used, YYYY-MM-DD.",
            "type": "string"
          },
          "birth_place": {
            "description": "The place used, as it was found.",
            "type": "string"
          },
          "birth_time": {
            "description": "The local time used, HH:MM.",
            "type": "string"
          },
          "house_system": {
            "description": "How the houses were divided: Placidus.",
            "type": "string"
          },
          "houses": {
            "description": "The 12 houses and the sign each starts in.",
            "items": {
              "properties": {
                "degree": {
                  "description": "Where in that sign it starts.",
                  "type": "number"
                },
                "house": {
                  "description": "The house, 1 to 12.",
                  "type": "integer"
                },
                "sign": {
                  "description": "The sign it starts in.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "latitude": {
            "description": "The place's latitude.",
            "type": "number"
          },
          "link": {
            "description": "The matching page on cosmyday.com. CosmyDay asks for a visible link to it wherever you show this.",
            "type": "string"
          },
          "longitude": {
            "description": "The place's longitude.",
            "type": "number"
          },
          "midheaven_sign": {
            "description": "The sign at the top of the chart.",
            "type": "string"
          },
          "moon_sign": {
            "description": "The sign the moon was in.",
            "type": "string"
          },
          "part_of_fortune": {
            "description": "Where the Part of Fortune falls.",
            "properties": {
              "degree": {
                "description": "Where in that sign.",
                "type": "number"
              },
              "house": {
                "description": "Its house.",
                "type": "integer"
              },
              "sign": {
                "description": "Its sign.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "planets": {
            "description": "Every planet and point in the chart.",
            "items": {
              "properties": {
                "degree": {
                  "description": "How far through that sign it is, 0 to 30 degrees.",
                  "type": "number"
                },
                "dignity": {
                  "description": "How at home it is in its sign: domicile, exaltation, detriment, fall or neutral.",
                  "type": "string"
                },
                "house": {
                  "description": "Which of the 12 houses it is in.",
                  "type": "integer"
                },
                "planet": {
                  "description": "The planet, e.g. Venus.",
                  "type": "string"
                },
                "retrograde": {
                  "description": "True when it appears to be moving backwards.",
                  "type": "boolean"
                },
                "sign": {
                  "description": "The sign it is in.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "rising_sign": {
            "description": "Their rising sign (ascendant).",
            "type": "string"
          },
          "sun_sign": {
            "description": "Their sun sign, the one people mean by 'star sign'.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
