    "email_verifier": {
      "description": "Check whether an email address is deliverable, returning its status and the individual checks Hunter ran.",
      "display_name": "Email verifier",
      "display_str_template": "Verify the email '{0}'.",
      "handler": "actions.email_verifier",
      "id": "hunter_email_verifier",
      "method": "POST",
      "mock_response": {
        "accept_all": false,
        "block": false,
        "disposable": false,
        "email": "patrick@stripe.com",
        "gibberish": false,
        "mx_records": true,
        "regexp": true,
        "score": 99,
        "smtp_check": true,
        "smtp_server": true,
        "status": "valid",
        "webmail": false
      },
      "name": "email_verifier",
      "parameters": [
        {
          "description": "The email address to verify.",
          "display_name": "Email address",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hunter/email-verifier",
      "result_str_template": "Hunter email verification complete.",
      "returns": {
        "properties": {
          "accept_all": {
            "description": "Whether the server accepts all addresses",
            "type": "boolean"
          },
          "block": {
            "description": "Whether the server blocked verification",
            "type": "boolean"
          },
          "disposable": {
            "description": "Whether it's from a disposable-email provider",
            "type": "boolean"
          },
          "email": {
            "description": "The address that was verified",
            "type": "string"
          },
          "gibberish": {
            "description": "Whether the local part looks random",
            "type": "boolean"
          },
          "mx_records": {
            "description": "Whether the domain has mail (MX) records",
            "type": "boolean"
          },
          "regexp": {
            "description": "Whether the address has a valid format",
            "type": "boolean"
          },
          "score": {
            "description": "Deliverability confidence, 0 to 100",
            "type": "number"
          },
          "smtp_check": {
            "description": "Whether the mailbox itself was accepted",
            "type": "boolean"
          },
          "smtp_server": {
            "description": "Whether the mail server is reachable",
            "type": "boolean"
          },
          "status": {
            "description": "Overall result: 'valid', 'invalid', 'accept_all', 'webmail', 'disposable', or 'unknown'",
            "type": "string"
          },
          "webmail": {
            "description": "Whether it's from a free webmail provider",
            "type": "boolean"
          }
        },
        "type": "object"
      }
