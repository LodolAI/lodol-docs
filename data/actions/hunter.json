{
  "actions": {
    "account_information": {
      "description": "Get the connected Hunter account's plan and how many searches and verifications remain this period.",
      "display_name": "Get account information",
      "display_str_template": "Get Hunter account information.",
      "handler": "actions.account_information",
      "id": "hunter_account_information",
      "method": "POST",
      "mock_response": {
        "email": "you@example.com",
        "plan_name": "Growth",
        "reset_date": "2026-08-11",
        "searches": {
          "available": 10000,
          "used": 500
        },
        "verifications": {
          "available": 20000,
          "used": 100
        }
      },
      "name": "account_information",
      "parameters": [],
      "path": "/actions/library/hunter/account-information",
      "result_str_template": "Hunter account information retrieved.",
      "returns": {
        "properties": {
          "email": {
            "description": "The account's email address",
            "type": "string"
          },
          "plan_name": {
            "description": "The account's plan, e.g. 'Free' or 'Growth'",
            "type": "string"
          },
          "reset_date": {
            "description": "When the monthly quota resets (YYYY-MM-DD)",
            "type": "string"
          },
          "searches": {
            "description": "Search requests used and available",
            "properties": {
              "available": {
                "description": "Requests included in the plan for the period",
                "type": "number"
              },
              "used": {
                "description": "Requests used in the current period",
                "type": "number"
              }
            },
            "type": "object"
          },
          "verifications": {
            "description": "Verification requests used and available",
            "properties": {
              "available": {
                "description": "Requests included in the plan for the period",
                "type": "number"
              },
              "used": {
                "description": "Requests used in the current period",
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "domain_search": {
      "description": "Find the email addresses associated with a company domain, with each contact's name, role, and confidence score.",
      "display_name": "Domain search",
      "display_str_template": "Search Hunter for emails at '{0}'.",
      "handler": "actions.domain_search",
      "id": "hunter_domain_search",
      "method": "POST",
      "mock_response": {
        "accept_all": false,
        "disposable": false,
        "domain": "stripe.com",
        "emails": [
          {
            "confidence": 99,
            "department": "executive",
            "first_name": "Patrick",
            "last_name": "Collison",
            "linkedin": "patrickcollison",
            "phone_number": "",
            "position": "CEO",
            "seniority": "executive",
            "twitter": "patrickc",
            "type": "personal",
            "value": "patrick@stripe.com",
            "verification": {
              "date": "2026-04-12",
              "status": "valid"
            }
          }
        ],
        "organization": "Stripe",
        "pattern": "{first}",
        "total_results": 142,
        "webmail": false
      },
      "name": "domain_search",
      "parameters": [
        {
          "description": "The company website domain to search, e.g. 'stripe.com'. Provide this or Company name.",
          "display_name": "Domain",
          "name": "domain",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The company name to search, e.g. 'Stripe'. Used when Domain is not provided.",
          "display_name": "Company name",
          "name": "company",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Number of email addresses to return, from 1 to 100. Defaults to 10.",
          "display_name": "Max results",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional. Number of results to skip, for paging through large domains.",
          "display_name": "Offset",
          "minimum": 0,
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional. Restrict results to 'personal' or 'generic' addresses.",
          "display_name": "Email type",
          "name": "email_type",
          "options": [
            {
              "label": "Personal",
              "value": "personal"
            },
            {
              "label": "Generic",
              "value": "generic"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Filter contacts by seniority. Comma-separate to combine, e.g. 'senior,executive'.",
          "display_name": "Seniority",
          "name": "seniority",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Filter contacts by department, e.g. 'sales' or 'executive,it'. Comma-separate to combine.",
          "display_name": "Department",
          "name": "department",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hunter/domain-search",
      "result_str_template": "Hunter domain search complete.",
      "returns": {
        "properties": {
          "accept_all": {
            "description": "Whether the mail server accepts all addresses",
            "type": "boolean"
          },
          "disposable": {
            "description": "Whether the domain is a disposable-email provider",
            "type": "boolean"
          },
          "domain": {
            "description": "The domain the results are for",
            "type": "string"
          },
          "emails": {
            "description": "Contacts found on this page",
            "items": {
              "properties": {
                "confidence": {
                  "description": "Hunter's confidence the address is valid, from 0 to 100",
                  "type": "number"
                },
                "department": {
                  "description": "Department, e.g. 'sales' or 'executive', if known",
                  "type": "string"
                },
                "first_name": {
                  "description": "Contact's first name, if known",
                  "type": "string"
                },
                "last_name": {
                  "description": "Contact's last name, if known",
                  "type": "string"
                },
                "linkedin": {
                  "description": "LinkedIn handle, if known",
                  "type": "string"
                },
                "phone_number": {
                  "description": "Phone number, if known",
                  "type": "string"
                },
                "position": {
                  "description": "Job title, if known",
                  "type": "string"
                },
                "seniority": {
                  "description": "'junior', 'senior', or 'executive', if known",
                  "type": "string"
                },
                "twitter": {
                  "description": "Twitter/X handle, if known",
                  "type": "string"
                },
                "type": {
                  "description": "'personal' (tied to a person) or 'generic' (e.g. info@)",
                  "type": "string"
                },
                "value": {
                  "description": "The email address",
                  "type": "string"
                },
                "verification": {
                  "description": "Most recent verification of this address, if any",
                  "properties": {
                    "date": {
                      "description": "When it was last verified",
                      "type": "string"
                    },
                    "status": {
                      "description": "Last verification status, e.g. 'valid'",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "organization": {
            "description": "Company name Hunter has for the domain",
            "type": "string"
          },
          "pattern": {
            "description": "The company's email pattern, e.g. '{first}.{last}'",
            "type": "string"
          },
          "total_results": {
            "description": "Total contacts Hunter has for the domain, across all pages",
            "type": "number"
          },
          "webmail": {
            "description": "Whether the domain is a free webmail provider",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "email_count": {
      "description": "Count how many email addresses Hunter has for a domain or company, split by personal and generic. Free and uses no credits.",
      "display_name": "Email count",
      "display_str_template": "Count Hunter emails for '{0}'.",
      "handler": "actions.email_count",
      "id": "hunter_email_count",
      "method": "POST",
      "mock_response": {
        "generic_emails": 14,
        "personal_emails": 128,
        "total": 142
      },
      "name": "email_count",
      "parameters": [
        {
          "description": "The company website domain, e.g. 'stripe.com'. Provide this or Company name.",
          "display_name": "Domain",
          "name": "domain",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The company name, e.g. 'Stripe'. Used when Domain is not provided.",
          "display_name": "Company name",
          "name": "company",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Restrict the count to 'personal' or 'generic' addresses.",
          "display_name": "Email type",
          "name": "email_type",
          "options": [
            {
              "label": "Personal",
              "value": "personal"
            },
            {
              "label": "Generic",
              "value": "generic"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hunter/email-count",
      "result_str_template": "Hunter email count complete.",
      "returns": {
        "properties": {
          "generic_emails": {
            "description": "How many are generic addresses (e.g. info@)",
            "type": "number"
          },
          "personal_emails": {
            "description": "How many are personal addresses",
            "type": "number"
          },
          "total": {
            "description": "Total email addresses Hunter has",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
