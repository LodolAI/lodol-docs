{
  "actions": {
    "add_user": {
      "description": "Add a user to LastPass Business. LastPass emails them an invitation; optionally put them in groups and give them a starting master password.",
      "display_name": "Add user",
      "display_str_template": "Add a LastPass user.",
      "handler": "actions.add_user",
      "id": "lastpass_add_user",
      "method": "POST",
      "mock_response": {
        "fullname": "Jane Doe",
        "groups": [
          "Engineering"
        ],
        "password_reset_required": null,
        "password_set": false,
        "status": "OK",
        "username": "jane.doe@example.com"
      },
      "name": "add_user",
      "parameters": [
        {
          "description": "The new user's email address. It becomes their LastPass username.",
          "display_name": "Username (email)",
          "name": "username",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The user's full name.",
          "display_name": "Full name",
          "name": "full_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Groups to put the user in. Pick existing ones or type a name.",
          "display_name": "Groups",
          "dynamic_source": "groups",
          "dynamic_source_allows_custom": true,
          "multi_select": true,
          "name": "groups",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Optional. A master password for the new account; leave empty to let the user choose their own from the invitation.",
          "display_name": "Starting master password",
          "name": "password",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "With a starting password: make the user change it at first sign-in. LastPass does so by default.",
          "display_name": "Require password change",
          "name": "require_password_change",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/lastpass/add-user",
      "result_str_template": "User added.",
      "returns": {
        "properties": {
          "fullname": {
            "type": "string"
          },
          "groups": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "password_reset_required": {
            "type": "boolean"
          },
          "password_set": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_user": {
      "description": "Disable a user, remove them from LastPass Business, delete their account and vault permanently, or revoke a pending invitation.",
      "display_name": "Delete user",
      "display_str_template": "Remove a LastPass user.",
      "handler": "actions.delete_user",
      "id": "lastpass_delete_user",
      "method": "POST",
      "mock_response": {
        "delete_action": 0,
        "delete_action_label": "Disable the account (blocks sign-in, keeps its data)",
        "status": "OK",
        "username": "jane.doe@example.com"
      },
      "name": "delete_user",
      "parameters": [
        {
          "description": "The user's email address - their LastPass username. Use List users to find one.",
          "display_name": "Username (email)",
          "name": "username",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "0",
          "description": "Permanent deletion erases the user's vault and cannot be undone.",
          "display_name": "What to do",
          "name": "delete_action",
          "options": [
            {
              "label": "Disable the account (blocks sign-in, keeps its data)",
              "value": "0"
            },
            {
              "label": "Remove from LastPass Business (the user keeps a personal account)",
              "value": "1"
            },
            {
              "label": "Delete the account and its vault permanently - cannot be undone",
              "value": "2"
            },
            {
              "label": "Uninvite (revoke a pending invitation)",
              "value": "3"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lastpass/delete-user",
      "result_str_template": "User removed.",
      "returns": {
        "properties": {
          "delete_action": {
            "type": "number"
          },
          "delete_action_label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "disable_multifactor": {
      "description": "Turn off a user's multifactor authentication, for example when they have lost their authenticator.",
      "display_name": "Disable multifactor",
