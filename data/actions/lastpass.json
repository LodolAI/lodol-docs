    "list_events": {
      "description": "Read the audit log between two times, newest first: sign-ins, failed sign-ins, admin changes and vault activity, for every user or one.",
      "display_name": "List events",
      "display_str_template": "List LastPass events.",
      "handler": "actions.list_events",
      "id": "lastpass_list_events",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "events": [
          {
            "action": "Failed Login Attempt",
            "data": "",
            "ip_address": "203.0.113.21",
            "time": "2026-10-01 09:51:51",
            "username": "jane.doe@example.com"
          }
        ],
        "from": "2026-10-01 00:00:00",
        "next_page": null,
        "returned_by_lastpass": 1,
        "to": "2026-10-02 00:00:00",
        "truncated": false
      },
      "name": "list_events",
      "parameters": [
        {
          "description": "Events from this time, in the time zone of your account's oldest admin.",
          "display_name": "From",
          "name": "start",
          "required": true,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Events up to this time. Leave empty for now.",
          "display_name": "To",
          "name": "end",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Only this user's events. Leave empty for everyone.",
          "display_name": "User (email)",
          "name": "username",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only events containing this text.",
          "display_name": "Contains",
          "name": "search",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only events from admin actions.",
          "display_name": "Admin events only",
          "name": "admin_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Keep at most this many of the newest events. Default 100, at most 1000; narrow the time range for older ones.",
          "display_name": "Limit",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The next_page value from a previous call, when LastPass had more than 10,000 events in the range.",
          "display_name": "Next page",
          "name": "next_page",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lastpass/list-events",
