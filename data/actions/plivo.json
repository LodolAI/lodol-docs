  "triggers": {
    "plivo_message_status_changed_trigger": {
      "description": "Runs each time a message status changes in Plivo. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Message status changed",
      "id": "plivo_message_status_changed_trigger",
      "output": {
        "record": "object with the fields message_uuid, from_number, to_number, message_state, message_direction, message_time"
      },
      "parameters": []
    },
    "plivo_new_completed_call_trigger": {
      "description": "Runs for each new completed call in Plivo. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New completed call",
      "id": "plivo_new_completed_call_trigger",
      "output": {
        "record": "object with the fields call_uuid, from_number, to_number, call_direction, call_duration, end_time, hangup_cause_name"
      },
      "parameters": []
    },
    "plivo_new_inbound_message_trigger": {
      "description": "Runs for each new inbound message in Plivo. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New inbound message",
      "id": "plivo_new_inbound_message_trigger",
      "output": {
        "record": "object with the fields message_uuid, from_number, to_number, message_state, message_direction, message_time"
      },
      "parameters": []
    },
    "plivo_new_outbound_message_trigger": {
      "description": "Runs for each new outbound message in Plivo. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
