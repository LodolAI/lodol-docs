{
  "actions": {
    "create_tracking": {
      "description": "Start tracking a shipment.",
      "display_name": "Create tracking",
      "display_str_template": "Create AfterShip tracking for '{0}' via '{1}'.",
      "handler": "actions.create_tracking",
      "id": "aftership_create_tracking",
      "method": "POST",
      "mock_response": {
        "id": "5b7f1a2e4c3d2a0011f5f2a1",
        "tag": "Pending"
      },
      "name": "create_tracking",
      "parameters": [
        {
          "description": "Tracking number issued by the courier.",
          "display_name": "Tracking number",
          "name": "tracking_number",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Courier slug, for example 'ups' or 'fedex'. Use detect_courier to find it.",
          "display_name": "Slug",
          "name": "slug",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional title for the tracking, for example an order number.",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional order ID to associate with the tracking.",
          "display_name": "Order ID",
          "name": "order_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/aftership/create-tracking",
      "result_str_template": "Created AfterShip tracking.",
      "returns": {
        "properties": {
          "id": {
            "description": "AfterShip tracking ID. Use with get_tracking.",
            "type": "string"
          },
          "tag": {
            "description": "Initial tracking status, for example 'Pending'",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "detect_courier": {
      "description": "Identify the likely courier(s) for a tracking number.",
      "display_name": "Detect courier",
      "display_str_template": "Detect courier for tracking number '{0}'.",
      "handler": "actions.detect_courier",
      "id": "aftership_detect_courier",
      "method": "POST",
      "mock_response": {
        "couriers": [
          {
            "name": "UPS",
            "slug": "ups"
          }
        ]
      },
      "name": "detect_courier",
      "parameters": [
        {
          "description": "Tracking number to identify the courier for.",
          "display_name": "Tracking number",
          "name": "tracking_number",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/aftership/detect-courier",
      "result_str_template": "Detected courier(s) for the tracking number.",
      "returns": {
        "properties": {
          "couriers": {
            "description": "Couriers that could match the tracking number",
            "items": {
              "properties": {
                "name": {
                  "description": "Courier display name",
                  "type": "string"
                },
                "slug": {
                  "description": "Courier slug. Use with create_tracking.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_tracking": {
      "description": "Look up a shipment's current status and checkpoint history.",
      "display_name": "Get tracking",
      "display_str_template": "Get AfterShip tracking '{0}'.",
      "handler": "actions.get_tracking",
      "id": "aftership_get_tracking",
      "method": "POST",
      "mock_response": {
        "checkpoints": [
          {
            "checkpoint_time": "2026-01-28T10:00:00Z",
            "location": "Louisville, KY",
            "message": "Departed from facility",
            "tag": "InTransit"
          }
        ],
        "expected_delivery": "2026-02-01T10:00:00-05:00",
        "id": "5b7f1a2e4c3d2a0011f5f2a1",
        "slug": "ups",
        "tag": "InTransit",
        "tracking_number": "1Z999AA10123456784"
      },
      "name": "get_tracking",
      "parameters": [
        {
          "description": "The tracking's AfterShip ID (not the courier tracking number) -- returned as 'id' by create_tracking and list_trackings.",
          "display_name": "Tracking ID",
          "name": "tracking_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/aftership/get-tracking",
      "result_str_template": "Retrieved AfterShip tracking status.",
      "returns": {
        "properties": {
          "checkpoints": {
            "description": "Tracking event history, oldest first",
            "items": {
              "properties": {
                "checkpoint_time": {
                  "description": "Timestamp of the checkpoint",
                  "type": "string"
                },
                "location": {
                  "description": "Checkpoint location, if known",
                  "type": "string"
                },
                "message": {
                  "description": "Checkpoint description",
                  "type": "string"
                },
                "tag": {
                  "description": "Checkpoint status tag, for example 'InTransit' or 'Delivered'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "expected_delivery": {
            "description": "Latest estimated delivery date/time, if known",
            "type": "string"
          },
          "id": {
            "description": "AfterShip tracking ID",
            "type": "string"
          },
          "slug": {
            "description": "Courier slug",
            "type": "string"
          },
          "tag": {
            "description": "Current status, for example 'InTransit' or 'Delivered'",
            "type": "string"
          },
          "tracking_number": {
            "description": "Tracking number",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_trackings": {
      "description": "List the shipments currently being tracked in your AfterShip account.",
      "display_name": "List trackings",
      "display_str_template": "List AfterShip trackings.",
      "handler": "actions.list_trackings",
      "id": "aftership_list_trackings",
      "method": "POST",
      "mock_response": {
        "trackings": [
          {
            "id": "5b7f1a2e4c3d2a0011f5f2a1",
            "slug": "ups",
            "tag": "InTransit",
            "tracking_number": "1Z999AA10123456784"
          }
        ]
      },
      "name": "list_trackings",
      "parameters": [],
      "path": "/actions/library/aftership/list-trackings",
      "result_str_template": "Fetched AfterShip trackings.",
      "returns": {
        "properties": {
          "trackings": {
            "description": "List of tracked shipments",
            "items": {
              "properties": {
                "id": {
                  "description": "AfterShip tracking ID. Use with get_tracking.",
                  "type": "string"
                },
                "slug": {
                  "description": "Courier slug",
                  "type": "string"
                },
                "tag": {
                  "description": "Current tracking status",
                  "type": "string"
                },
                "tracking_number": {
                  "description": "Tracking number",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your AfterShip account to detect couriers, create shipment trackings, and check delivery status.",
  "display_name": "AfterShip",
  "id": "aftership"
}
