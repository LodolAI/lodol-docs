    "send_signature_request": {
      "description": "Send a PDF (or other document) from a web address to be signed. Lumin emails each signer. It answers at once with the new request's id while it prepares the file; read the request with 'Get signature request' a moment later to see its signers.",
      "display_name": "Send signature request",
      "display_str_template": "Send signature request '{title}'.",
      "handler": "actions.send_signature_request",
      "id": "lumin_send_signature_request",
      "method": "POST",
      "mock_response": {
        "signature_request": {
          "created_at": 1794593785943,
          "signature_request_id": "6af753f968dd3c7075ab5a5c",
