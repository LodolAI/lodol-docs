          "examples": [
            {
              "label": "A PDF link",
              "value": "https://example.com/contract.pdf"
            }
          ],
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The request's title, shown to signers and in the email.",
          "display_name": "Title",
          "examples": [
            {
              "label": "A title",
              "value": "Service agreement"
            }
          ],
          "max_length": 255,
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Who has to sign. Each needs a name and an email; add a group number (1, 2, ...) only when signing in order.",
          "display_name": "Signers",
          "name": "signers",
          "required": true,
          "schema": {
            "items": {
              "properties": {
                "email": {
                  "description": "Their email address",
                  "type": "string"
                },
                "group": {
                  "description": "Signing order: 1 signs first, then 2. Only when signing in order.",
                  "type": "number"
                },
                "name": {
                  "description": "Their full name",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "email"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "People who get a copy to read but do not sign.",
          "display_name": "Viewers",
          "name": "viewers",
          "required": false,
          "schema": {
            "items": {
              "properties": {
                "email": {
                  "description": "Their email address",
                  "type": "string"
                },
                "name": {
                  "description": "Their full name",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "email"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "When the request expires. Must be in the future. Defaults to 30 days from now.",
          "display_name": "Due date",
          "name": "expires_at",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Whether everyone signs at once or group by group. Group by group needs a group number on every signer.",
          "display_name": "Signing order",
          "name": "signing_type",
          "options": [
            {
              "label": "Everyone at the same time (default)",
              "value": "SAME_TIME"
            },
            {
              "label": "One group after another, in order",
              "value": "ORDER"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Turn Lumin text tags in the document into signature boxes and form fields.",
          "display_name": "Read text tags in the file",
          "name": "use_text_tags",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/lumin/send-signature-request",
      "result_str_template": "Signature request sent.",
      "returns": {
        "properties": {
          "signature_request": {
            "description": "The new request: its id and status",
            "properties": {
              "created_at": {
                "description": "When it was sent, as Unix milliseconds",
                "type": "number"
              },
              "signature_request_id": {
                "description": "The new request's id",
                "type": "string"
              },
              "status": {
                "description": "WAITING_FOR_PROCESSING until Lumin has the file",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
