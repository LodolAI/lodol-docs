{
  "actions": {
    "create_paste": {
      "description": "Create a new paste on Pastebin and get back its link.",
      "display_name": "Create a paste",
      "display_str_template": "Create a Pastebin paste.",
      "handler": "actions.create_paste",
      "id": "pastebin_create_paste",
      "method": "POST",
      "mock_response": {
        "key": "AbC12345",
        "url": "https://pastebin.com/AbC12345"
      },
      "name": "create_paste",
      "output_formatter": "actions.created_paste_formatter",
      "parameters": [
        {
          "description": "The text to paste.",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. A title for the paste.",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "text",
          "description": "Optional. The language to highlight the paste as.",
          "display_name": "Syntax highlighting",
          "name": "paste_format",
          "options": [
            {
              "label": "Plain text",
              "value": "text"
            },
            {
              "label": "Python",
              "value": "python"
            },
            {
              "label": "JavaScript",
              "value": "javascript"
            },
            {
              "label": "TypeScript",
              "value": "typescript"
            },
            {
              "label": "JSON",
              "value": "json"
            },
            {
              "label": "HTML",
              "value": "html5"
            },
            {
              "label": "CSS",
              "value": "css"
            },
            {
              "label": "Java",
              "value": "java"
            },
            {
              "label": "C",
              "value": "c"
            },
            {
              "label": "C++",
              "value": "cpp"
            },
            {
              "label": "C#",
              "value": "csharp"
            },
            {
              "label": "PHP",
              "value": "php"
            },
            {
              "label": "Ruby",
              "value": "ruby"
            },
            {
              "label": "Go",
              "value": "go"
            },
            {
              "label": "Rust",
              "value": "rust"
            },
            {
              "label": "Swift",
              "value": "swift"
            },
            {
              "label": "Kotlin",
              "value": "kotlin"
            },
            {
              "label": "Bash / Shell",
              "value": "bash"
            },
            {
              "label": "SQL",
              "value": "sql"
            },
            {
              "label": "YAML",
              "value": "yaml"
            },
            {
              "label": "Markdown",
              "value": "markdown"
            },
            {
              "label": "XML",
              "value": "xml"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "1",
          "description": "Who can see the paste.",
          "display_name": "Visibility",
          "name": "visibility",
          "options": [
            {
              "label": "Unlisted (only people with the link)",
              "value": "1"
            },
            {
              "label": "Public (listed on Pastebin)",
              "value": "0"
            },
            {
              "label": "Private (only your account)",
              "value": "2"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "N",
          "description": "How long before the paste is deleted automatically.",
          "display_name": "Expires after",
          "name": "expire",
          "options": [
            {
              "label": "Never",
              "value": "N"
            },
            {
              "label": "10 minutes",
              "value": "10M"
            },
            {
              "label": "1 hour",
              "value": "1H"
            },
            {
              "label": "1 day",
              "value": "1D"
            },
            {
              "label": "1 week",
              "value": "1W"
            },
            {
              "label": "2 weeks",
              "value": "2W"
            },
            {
              "label": "1 month",
              "value": "1M"
            },
            {
              "label": "6 months",
              "value": "6M"
            },
            {
              "label": "1 year",
              "value": "1Y"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/pastebin/create-paste",
      "result_str_template": "Paste created: {create_paste,url}",
      "returns": {
        "properties": {
          "key": {
            "description": "The new paste's key (id)",
            "type": "string"
          },
          "url": {
            "description": "Link to the new paste",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_paste": {
      "description": "Delete one of your pastes by its key.",
      "display_name": "Delete a paste",
      "display_str_template": "Delete a Pastebin paste.",
      "handler": "actions.delete_paste",
      "id": "pastebin_delete_paste",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "key": "AbC12345",
        "message": "Paste Removed"
      },
      "name": "delete_paste",
      "parameters": [
        {
          "description": "The paste's key -- the code at the end of its link, for example 'AbC12345' in pastebin.com/AbC12345.",
          "display_name": "Paste key",
          "name": "paste_key",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/pastebin/delete-paste",
      "result_str_template": "Paste deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True when the paste was removed",
            "type": "boolean"
          },
          "key": {
            "description": "The deleted paste's key",
            "type": "string"
          },
          "message": {
            "description": "Pastebin's confirmation message",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_paste": {
      "description": "Fetch the text content of one of your pastes by its key.",
      "display_name": "Get a paste",
      "display_str_template": "Get a Pastebin paste.",
      "handler": "actions.get_paste",
      "id": "pastebin_get_paste",
      "method": "POST",
      "mock_response": {
        "content": "print('hello world')",
        "key": "AbC12345",
        "url": "https://pastebin.com/AbC12345"
      },
      "name": "get_paste",
      "parameters": [
        {
          "description": "The paste's key -- the code at the end of its link, for example 'AbC12345' in pastebin.com/AbC12345.",
          "display_name": "Paste key",
          "name": "paste_key",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/pastebin/get-paste",
      "result_str_template": "Fetched paste {get_paste,key}",
      "returns": {
        "properties": {
          "content": {
            "description": "The paste's text",
            "type": "string"
          },
          "key": {
            "description": "The paste's key",
            "type": "string"
          },
          "url": {
            "description": "Link to the paste",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_pastes": {
      "description": "List your account's most recent pastes.",
      "display_name": "List pastes",
      "display_str_template": "List Pastebin pastes.",
      "handler": "actions.list_pastes",
      "id": "pastebin_list_pastes",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "pastes": [
          {
            "date": "1712345678",
            "expire_date": "0",
            "format": "yaml",
            "hits": 4,
            "key": "AbC12345",
            "private": "1",
            "size": 128,
            "title": "config.yaml",
            "url": "https://pastebin.com/AbC12345"
          }
        ]
      },
      "name": "list_pastes",
      "output_formatter": "actions.paste_list_formatter",
      "parameters": [
        {
          "default": 50,
          "description": "The maximum number of pastes to return (1 to 1000).",
          "display_name": "How many",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/pastebin/list-pastes",
      "result_str_template": "{list_pastes,count} pastes found.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many pastes were returned",
            "type": "number"
          },
          "pastes": {
            "description": "The account's recent pastes",
            "items": {
              "properties": {
                "date": {
                  "description": "When the paste was created (Unix time)",
                  "type": "string"
                },
                "expire_date": {
                  "description": "When the paste expires (Unix time, 0 if never)",
                  "type": "string"
                },
                "format": {
                  "description": "Syntax highlighting format",
                  "type": "string"
                },
                "hits": {
                  "description": "How many times the paste was viewed",
                  "type": "number"
                },
                "key": {
                  "description": "The paste's key (its id)",
                  "type": "string"
                },
                "private": {
                  "description": "Visibility: 0 public, 1 unlisted, 2 private",
                  "type": "string"
                },
                "size": {
                  "description": "Size of the paste in bytes",
                  "type": "number"
                },
                "title": {
                  "description": "The paste's title",
                  "type": "string"
                },
                "url": {
                  "description": "Link to the paste",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create, read, list, and delete text pastes on Pastebin. Works without a Pastebin account for creating and reading public pastes.",
  "display_name": "Pastebin",
  "id": "pastebin"
}
