    "notion_new_page_trigger": {
      "description": "Runs for each new page in a Notion database. Pages already there when the workflow is turned on don't start it.",
      "display_name": "New page",
      "id": "notion_new_page_trigger",
      "output": {
        "id": "string",
        "last_edited_time": "string",
        "title": "string",
        "url": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The database to watch.",
          "display_name": "Database",
          "name": "database_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "Only pages whose title contains this text. Leave blank for every page.",
          "display_name": "Title contains",
          "name": "title",
          "required": false
        }
      ]
    },
    "notion_updated_page_trigger": {
      "description": "Runs when a page in a Notion database is changed or added, such as when its status or another property is edited. Edits made before the workflow is turned on don't start it.",
