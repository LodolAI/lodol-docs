{
  "actions": {
    "append_block_children": {
      "description": "Add content blocks to an existing Notion page or block.",
      "display_name": "Add content to a page",
      "display_str_template": "Add {1} content blocks to Notion page or block '{0}'.",
      "handler": "actions.append_block_children",
      "id": "notion_append_block_children",
      "method": "POST",
      "mock_response": {
        "appended": 3,
        "has_more": false,
        "next_cursor": null,
        "status": "success"
      },
      "name": "append_block_children",
      "output_formatter": "actions.format_append_block_children_output",
      "parameters": [
        {
          "description": "The ID of the page or block to add content to. To add to a page, use the page ID from 'Create page in database' or 'Retrieve page details'.",
          "display_name": "Page or block ID",
          "name": "block_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Content blocks to add, in Notion's block format. Each block needs a 'type' field and a matching object of that type containing a 'rich_text' list.",
          "display_name": "Content blocks",
          "name": "children",
          "required": true,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/notion/append-block-children",
      "result_str_template": "Blocks added.",
      "returns": {
        "properties": {
          "appended": {
            "description": "Number of blocks appended.",
            "type": "integer"
          },
          "has_more": {
            "description": "Whether more blocks exist.",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Cursor for additional blocks.",
            "type": "string"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_page": {
      "description": "Create a new page in a Notion database, with optional content blocks.",
      "display_name": "Create page in database",
      "display_str_template": "Create Notion page '{0}'.",
      "handler": "actions.create_page",
      "id": "notion_create_page",
      "method": "POST",
      "mock_response": {
        "id": "n7m8l9k0j1i2",
        "status": "success",
        "title": "New Page",
        "url": "https://www.notion.so/New-Page-n7m8l9k0j1i2"
      },
      "name": "create_page",
      "output_formatter": "actions.format_create_page_output",
      "parameters": [
        {
          "description": "The ID of the database to create the page in. Use the 'List databases' action first to find available database IDs.",
          "display_name": "Parent database ID",
          "name": "parent_database_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Page title.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Additional page properties.",
          "display_name": "Properties",
          "name": "properties",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Content blocks to add to the page, in Notion's block format. Each block needs a 'type' field and a matching object of that type containing a 'rich_text' list.",
          "display_name": "Content blocks",
          "name": "children",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The name of the database's title property, if it is not 'Name'.",
          "display_name": "Title property",
          "name": "title_property",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/notion/create-page",
      "result_str_template": "Page created.",
      "returns": {
        "properties": {
          "id": {
            "description": "Created page ID.",
            "type": "string"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          },
          "title": {
            "description": "Created page title.",
            "type": "string"
          },
          "url": {
            "description": "Created page URL.",
            "type": "string"
          }
        },
        "type": "object"
      }
