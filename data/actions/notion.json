    "create_page": {
      "description": "Create a new page in a Notion database: its name, its columns by name, and its text, written plainly or as Markdown.",
      "display_name": "Create page",
      "display_str_template": "Create the page '{1}' in {0}.",
      "handler": "actions.create_page",
      "id": "notion_create_page",
      "method": "POST",
      "mock_response": {
        "id": "n7m8l9k0j1i2",
        "status": "success",
        "title": "New Page",
        "url": "https://www.notion.so/New-Page-n7m8l9k0j1i2"
      },
      "name": "create_page",
      "output_formatter": "actions.format_create_page_output",
      "parameters": [
        {
          "description": "The database to create the page in.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "parent_database_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The page's name, as it shows in the database, such as Weekly sync, 1 March.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Beta. What to write on the page, as plain text or Markdown, such as an AI step's summary: # for a heading, - for a bullet, 1. for a numbered item, - [ ] for a to-do, > for a quote, --- for a divider, **bold**, *italic* and [a link](https://example.com). For example: ## Key points, then a line for each point starting with a dash. Text of any length is fine.",
          "display_name": "Page text",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to put in the page's other columns. Each column name with its value, such as {'Status': 'To review', 'Meeting date': '2026-03-01', 'Attendees': 12}. Beta: a plain value is fitted to its column. Text, number, link, email and phone columns take the value as written; a select or status column takes the choice's name; a multi-select takes a list or names with commas between; a date takes 2026-03-01 or 2026-03-01T14:30:00Z; a checkbox takes yes or no; a people column takes email addresses; a relation takes page IDs. A column left blank is not changed. A value already in Notion's own property format is used as it is.",
          "display_name": "Columns",
          "name": "properties",
          "object_key_name": "Column",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "For advanced layouts only; most pages need just the page text. Blocks in Notion's own block format, added after the page text. Each block needs a 'type' field and a matching object of that type, such as {'type': 'paragraph', 'paragraph': {'rich_text': [{'text': {'content': 'Hello'}}]}}.",
          "display_name": "Content blocks",
          "name": "children",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The name of the column that holds each page's name, if it is not Name, such as Meeting. Not needed when a column above has a plain value: the step then finds it itself.",
          "display_name": "Title column",
          "name": "title_property",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/notion/create-page",
      "result_str_template": "Page created.",
      "returns": {
        "properties": {
          "id": {
            "description": "Created page ID.",
            "type": "string"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          },
          "title": {
            "description": "Created page title.",
            "type": "string"
          },
          "url": {
            "description": "Created page URL.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
