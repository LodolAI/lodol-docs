{
  "actions": {
    "append_block_children": {
      "description": "Add text to the end of an existing Notion page, written plainly or as Markdown, or blocks in Notion's own format.",
      "display_name": "Add content to a page",
      "display_str_template": "Add content to '{0}'.",
      "handler": "actions.append_block_children",
      "id": "notion_append_block_children",
      "method": "POST",
      "mock_response": {
        "appended": 3,
        "has_more": false,
        "next_cursor": null,
        "status": "success"
      },
      "name": "append_block_children",
      "output_formatter": "actions.format_append_block_children_output",
      "parameters": [
        {
          "description": "The page to add to, as an earlier step gave it (Create page or Get page), or its ID.",
          "display_name": "Page",
          "label_source": "page_names",
          "name": "block_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Beta. What to add to the end of the page, as plain text or Markdown, such as an AI step's summary: # for a heading, - for a bullet, 1. for a numbered item, - [ ] for a to-do, > for a quote, --- for a divider, **bold**, *italic* and [a link](https://example.com). For example: ## Key points, then a line for each point starting with a dash. Text of any length is fine. Give this, content blocks, or both.",
          "display_name": "Page text",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "For advanced layouts only; most steps need just the page text. Blocks in Notion's own block format, added after the page text. Each block needs a 'type' field and a matching object of that type, such as {'type': 'paragraph', 'paragraph': {'rich_text': [{'text': {'content': 'Hello'}}]}}. Give this, page text, or both.",
          "display_name": "Content blocks",
          "name": "children",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/notion/append-block-children",
      "result_str_template": "Blocks added.",
      "returns": {
        "properties": {
          "appended": {
            "description": "Number of blocks appended.",
            "type": "integer"
          },
          "has_more": {
            "description": "Whether more blocks exist.",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Cursor for additional blocks.",
            "type": "string"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
