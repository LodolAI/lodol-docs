      "display_str_template": "Fetch details for document '{0}'.",
      "handler": "actions.get_document_details",
      "id": "lucidchart_get_document",
      "method": "POST",
      "mock_response": {
        "document_id": "8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33",
        "name": "Q3 Architecture Diagram",
        "url": "https://lucid.app/lucidchart/8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33/edit"
      },
      "name": "get_document_details",
      "parameters": [
        {
          "description": "The Lucidchart document ID to retrieve, as returned by Search Lucidchart documents.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lucidchart/get-document",
      "result_str_template": "Document details returned.",
      "returns": {
        "properties": {
          "document_id": {
            "description": "Lucidchart document ID. Use with Fetch a Lucidchart document.",
            "type": "string"
          },
          "name": {
            "description": "Document title",
            "type": "string"
          },
          "url": {
            "description": "Link to open the document in Lucid, if Lucid returned one",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_documents": {
      "description": "Search for Lucidchart documents with optional keyword filtering.",
      "display_name": "Search Lucidchart documents",
      "display_str_template": "Search Lucidchart documents.",
      "handler": "actions.list_documents",
      "id": "lucidchart_list_documents",
      "method": "POST",
      "mock_response": {
        "documents": [
          {
            "document_id": "8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33",
