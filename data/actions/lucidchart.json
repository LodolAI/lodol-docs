{
  "actions": {
    "create_document": {
      "description": "Create a new, blank Lucidchart document.",
      "display_name": "Create a Lucidchart document",
      "display_str_template": "Create Lucidchart document '{0}'.",
      "handler": "actions.create_document",
      "id": "lucidchart_create_document",
      "method": "POST",
      "mock_response": {
        "document_id": "8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33",
        "name": "Q3 Architecture Diagram",
        "url": "https://lucid.app/lucidchart/8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33/edit"
      },
      "name": "create_document",
      "parameters": [
        {
          "description": "Title for the new document.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lucidchart/create-document",
      "result_str_template": "Document created.",
      "returns": {
        "properties": {
          "document_id": {
            "description": "Lucidchart document ID. Use with Fetch a Lucidchart document.",
            "type": "string"
          },
          "name": {
            "description": "Document title",
            "type": "string"
          },
          "url": {
            "description": "Link to open the document in Lucid, if Lucid returned one",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_document_details": {
      "description": "Retrieve details for a specific Lucidchart document.",
