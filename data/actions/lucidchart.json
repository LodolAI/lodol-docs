    "trash_document": {
      "description": "Move a Lucidchart document to the trash. Other people it's shared with keep their access.",
      "display_name": "Trash a Lucidchart document",
      "display_str_template": "Trash Lucidchart document '{0}'.",
      "handler": "actions.trash_document",
      "id": "lucidchart_trash_document",
      "method": "POST",
      "mock_response": {
        "document_id": "8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33",
        "trashed": true
      },
      "name": "trash_document",
      "parameters": [
        {
          "description": "The Lucidchart document ID to trash, as returned by Search Lucidchart documents or Create a Lucidchart document.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lucidchart/trash-document",
      "result_str_template": "Document trashed.",
      "returns": {
        "properties": {
          "document_id": {
            "description": "The document that was trashed",
            "type": "string"
          },
          "trashed": {
            "description": "Whether the document was moved to the trash",
            "type": "boolean"
          }
