{
  "actions": {
    "add_comment": {
      "description": "Add a comment to a Lucidchart document, as a new thread on the document rather than on a shape. The document must have been opened in Lucid at least once.",
      "display_name": "Add a comment",
      "display_str_template": "Comment on document '{0}'.",
      "handler": "actions.add_comment",
      "id": "lucidchart_add_comment",
      "method": "POST",
      "mock_response": {
        "created": "2026-11-07T15:04:05Z",
        "document_id": "8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33",
        "thread_id": "c-1f0e7a"
      },
      "name": "add_comment",
      "parameters": [
        {
          "description": "The ID of the document, as returned by Search documents.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The comment, up to 10,000 characters.",
          "display_name": "Comment",
          "multiline": true,
          "name": "comment",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lucidchart/add-comment",
      "result_str_template": "Comment added.",
      "returns": {
        "properties": {
          "created": {
            "description": "When the comment was added",
            "type": "string"
          },
          "document_id": {
            "description": "The document commented on",
            "type": "string"
          },
          "thread_id": {
            "description": "The new comment thread's ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "copy_document": {
      "description": "Make a copy of a Lucidchart document under a new title, for example to start each project from the same diagram. The copy isn't shared with the people the original is shared with.",
      "display_name": "Copy a document",
      "display_str_template": "Copy document '{0}' as '{1}'.",
      "handler": "actions.copy_document",
      "id": "lucidchart_copy_document",
      "method": "POST",
      "mock_response": {
        "document_id": "8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33",
        "name": "Q3 Architecture Diagram",
        "url": "https://lucid.app/lucidchart/8f2b1c4e-3a91-4d77-9b0e-2c6f1a5d7e33/edit"
      },
      "name": "copy_document",
      "parameters": [
        {
          "description": "The ID of the document to copy, as returned by Search documents.",
          "display_name": "Document to copy",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Title for the copy.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. The ID of the folder to put it in, a number. Search folders to find it. Leave blank for My Documents.",
          "display_name": "Folder",
          "name": "folder_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lucidchart/copy-document",
      "result_str_template": "Document copied.",
      "returns": {
        "properties": {
          "document_id": {
            "description": "Lucidchart document ID. Use with Fetch a Lucidchart document.",
            "type": "string"
          },
          "name": {
            "description": "Document title",
            "type": "string"
          },
          "url": {
            "description": "Link to open the document in Lucid, if Lucid returned one",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
