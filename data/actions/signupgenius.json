{
  "actions": {
    "add_group_member": {
      "description": "Add a person to one of your groups by their email address, so they can be sent the group's sign-ups.",
      "display_name": "Add group member",
      "display_str_template": "Add {email} to group {group_id}.",
      "handler": "actions.add_group_member",
      "id": "signupgenius_add_group_member",
      "method": "POST",
      "mock_response": {
        "added": true,
        "email": "sam@example.com",
        "group_id": "1023",
        "result": {
          "memberid": 5531
        }
      },
      "name": "add_group_member",
      "output_formatter": "actions.format_added_output",
      "parameters": [
        {
          "description": "The group. Pick one, or give its id from an earlier step.",
