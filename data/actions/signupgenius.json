            {
              "label": "An email address",
              "value": "sam@example.com"
            }
          ],
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The person's first name.",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The person's last name.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/signupgenius/add-group-member",
      "result_str_template": "Member added.",
      "returns": {
        "properties": {
          "added": {
            "description": "Always true once added",
            "type": "boolean"
          },
          "email": {
            "description": "The email address added",
            "type": "string"
          },
          "group_id": {
            "description": "The group",
            "type": "string"
          },
          "result": {
            "description": "What SignUpGenius returned about the new member",
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
