{
  "actions": {
    "add_contact_to_list": {
      "description": "Add contacts to a SendGrid marketing list.",
      "display_name": "Add contact to list",
      "display_str_template": "Add SendGrid contact '{0}' to list.",
      "handler": "actions.add_contact_to_list",
      "id": "sendgrid_add_contact_to_list",
      "method": "POST",
      "mock_response": {
        "result": {
          "job_id": "job_987"
        }
      },
      "name": "add_contact_to_list",
      "parameters": [
        {
          "description": "Contact email address to add.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Marketing list IDs to add the contact to.",
          "display_name": "List IDS",
          "name": "list_ids",
          "required": true,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/sendgrid/add-contact-to-list",
      "result_str_template": "Contact added to list.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "job_id": {
                "description": "SendGrid job ID for the import.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_list": {
      "description": "Create a marketing list for SendGrid contacts.",
      "display_name": "Create marketing list",
      "display_str_template": "Create SendGrid list '{0}'.",
      "handler": "actions.create_list",
      "id": "sendgrid_create_list",
      "method": "POST",
      "mock_response": {
        "result": {
          "contact_count": 0,
          "id": "list_789",
          "name": "My List"
        }
      },
      "name": "create_list",
      "parameters": [
        {
          "description": "List name.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sendgrid/create-list",
      "result_str_template": "List created.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "contact_count": {
                "description": "Number of contacts in the list.",
                "type": "integer"
              },
              "id": {
                "description": "Created list ID.",
                "type": "string"
              },
              "name": {
                "description": "List name.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
