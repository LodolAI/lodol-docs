    "send_email": {
      "description": "Send an email through SendGrid.",
      "display_name": "Send email",
      "display_str_template": "Send SendGrid email to {1}.",
      "handler": "actions.send_email",
      "id": "sendgrid_send_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "status_code": 202
        }
      },
      "name": "send_email",
      "parameters": [
        {
          "description": "Sender email address.",
          "display_name": "From email",
          "name": "from_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Recipient email address.",
          "display_name": "To email",
          "name": "to_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email subject.",
          "display_name": "Subject",
          "name": "subject",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Plain text email content.",
          "display_name": "Text content",
          "multiline": true,
          "name": "text_content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional HTML email content.",
          "display_name": "HTML content",
          "multiline": true,
          "name": "html_content",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional CC email addresses.",
          "display_name": "CC",
          "name": "cc",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Optional BCC email addresses.",
          "display_name": "BCC",
          "name": "bcc",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/sendgrid/send-email",
      "result_str_template": "Email sent.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "status_code": {
                "description": "HTTP status code (202 on success).",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "send_template_email": {
      "description": "Send an email built from a saved SendGrid template.",
