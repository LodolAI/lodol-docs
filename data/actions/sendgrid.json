    "get_stats": {
      "description": "Retrieve SendGrid email statistics for a date range.",
      "display_name": "Get email stats",
      "display_str_template": "Get SendGrid stats from {0} to {1}.",
      "handler": "actions.get_stats",
      "id": "sendgrid_get_stats",
      "method": "POST",
      "mock_response": {
        "result": {
          "stats": [
            {
              "date": "2024-01-01",
              "stats": [
                {
                  "metrics": {
                    "clicks": 10,
                    "delivered": 95,
                    "opens": 50,
                    "requests": 100
                  }
                }
              ]
            }
          ]
        }
      },
      "name": "get_stats",
      "parameters": [
        {
          "description": "Start date (YYYY-MM-DD).",
          "display_name": "Start date",
          "name": "start_date",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "End date (YYYY-MM-DD).",
          "display_name": "End date",
          "name": "end_date",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sendgrid/get-stats",
      "result_str_template": "Stats retrieved.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "stats": {
                "description": "Stats for the date range.",
                "items": {
                  "properties": {
                    "date": {
                      "description": "Date.",
                      "type": "string"
                    },
                    "stats": {
                      "description": "Metrics for this date.",
                      "items": {
                        "properties": {
                          "metrics": {
                            "description": "Email metrics.",
                            "properties": {
                              "clicks": {
                                "description": "Click count.",
                                "type": "integer"
                              },
                              "delivered": {
                                "description": "Delivered emails.",
                                "type": "integer"
                              },
                              "opens": {
                                "description": "Open count.",
                                "type": "integer"
                              },
                              "requests": {
                                "description": "Total requests.",
                                "type": "integer"
                              }
                            },
                            "type": "object"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
