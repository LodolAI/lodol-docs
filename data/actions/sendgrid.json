      "id": "sendgrid_send_template_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "status_code": 202
        }
      },
      "name": "send_template_email",
      "parameters": [
        {
          "description": "Sender email address.",
          "display_name": "From email",
          "name": "from_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Recipient email address.",
          "display_name": "To email",
          "name": "to_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of the SendGrid template to use.",
          "display_name": "Template ID",
          "name": "template_id",
