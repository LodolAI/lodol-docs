              "properties": {
                "probe": {
                  "description": "Geographic and network metadata for the probe that ran the test.",
                  "properties": {
                    "asn": {
                      "description": "Autonomous System Number of the probe's network.",
                      "type": "number"
                    },
                    "city": {
                      "description": "City the probe is located in.",
                      "type": "string"
                    },
                    "continent": {
                      "description": "Continent code, e.g. 'EU'.",
                      "type": "string"
                    },
                    "country": {
                      "description": "ISO 3166-1 alpha-2 country code.",
                      "type": "string"
                    },
                    "network": {
                      "description": "Name of the probe's network/operator.",
                      "type": "string"
                    },
                    "region": {
                      "description": "UN geographic region.",
                      "type": "string"
                    },
                    "state": {
                      "description": "US state code, or null outside the US.",
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "result": {
                  "properties": {
                    "raw_output": {
                      "description": "The raw text output of the ping command, as a probe returned it.",
                      "type": "string"
                    },
                    "resolved_address": {
                      "description": "The IP address the target resolved to.",
                      "nullable": true,
                      "type": "string"
                    },
                    "resolved_hostname": {
                      "description": "The reverse-DNS hostname of the resolved address, if any.",
                      "nullable": true,
                      "type": "string"
                    },
                    "stats": {
                      "description": "Aggregate round-trip-time statistics, in milliseconds.",
                      "nullable": true,
                      "properties": {
                        "avg": {
                          "description": "Average RTT (ms).",
                          "nullable": true,
                          "type": "number"
                        },
                        "drop": {
                          "description": "Packets dropped (total - rcv).",
                          "nullable": true,
                          "type": "number"
                        },
                        "loss": {
                          "description": "Packet loss percentage.",
                          "nullable": true,
                          "type": "number"
                        },
                        "max": {
                          "description": "Highest RTT (ms).",
                          "nullable": true,
                          "type": "number"
                        },
                        "min": {
                          "description": "Lowest RTT (ms).",
                          "nullable": true,
                          "type": "number"
                        },
                        "rcv": {
                          "description": "Packets received.",
                          "nullable": true,
                          "type": "number"
                        },
                        "total": {
                          "description": "Packets sent.",
                          "nullable": true,
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "status": {
                      "description": "Per-probe test status: 'finished', 'failed', or 'offline'.",
                      "type": "string"
                    },
                    "timings": {
                      "description": "Per-packet timings.",
                      "items": {
                        "properties": {
                          "rtt": {
                            "description": "Round-trip time (ms).",
                            "type": "number"
                          },
                          "ttl": {
                            "description": "Reply TTL.",
                            "nullable": true,
                            "type": "number"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "description": "Overall measurement status; 'finished' once all probes report.",
            "type": "string"
          },
          "target": {
            "description": "The host that was measured.",
            "type": "string"
          },
          "type": {
            "description": "The measurement type ('ping' or 'traceroute').",
            "type": "string"
          }
        },
        "type": "object"
      }
