          ],
          "name": "target",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "world",
          "description": "Where to run the test from, as a Globalping 'magic' location: a city, country, continent, US state, cloud region, ASN (e.g. 'AS13335'), or network name. Combine parts with '+' (e.g. 'London+UK'). Leave blank or use 'world' for any probe worldwide.",
          "display_name": "From (probe location)",
          "examples": [
            {
              "label": "Anywhere in the world",
              "value": "world"
            },
            {
              "label": "Germany",
              "value": "Germany"
            },
            {
              "label": "New York",
              "value": "New York"
            },
            {
              "label": "Cloudflare (AS13335)",
              "value": "AS13335"
            }
          ],
          "name": "from",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 1,
          "description": "How many probes to run the test from (each returns its own result). Between 1 and 100; defaults to 1. Keyless usage is capped by Globalping's per-source limits, and the API returns a clear error if you exceed your tier.",
          "display_name": "Number of probes",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 3,
          "description": "How many ICMP packets to send (1\u201316); defaults to 3. More packets give more stable latency and loss numbers.",
          "display_name": "Packets",
          "maximum": 16,
          "minimum": 1,
          "name": "packets",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": "4",
          "description": "Which IP version to resolve the target to: IPv4 or IPv6. Defaults to IPv4. Ignored when the target is already a literal IP address.",
          "display_name": "IP version",
          "name": "ip_version",
          "options": [
            {
              "label": "IPv4",
              "value": "4"
            },
            {
              "label": "IPv6",
              "value": "6"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/globalping/ping",
      "result_str_template": "Ran the ping measurement.",
      "returns": {
        "properties": {
          "id": {
            "description": "The Globalping measurement ID.",
            "type": "string"
          },
          "probes_count": {
            "description": "Number of probes that ran the measurement.",
            "type": "number"
          },
          "results": {
            "description": "One entry per probe: where it ran and what it measured.",
