    "get_annotation": {
      "description": "Look up one annotation by its Genius ID, along with the lyric it explains, its score, and who wrote it.",
      "display_name": "Get an annotation",
      "display_str_template": "Get Genius annotation {0}.",
      "handler": "actions.get_annotation",
      "id": "genius_get_annotation",
      "method": "POST",
      "mock_response": {
        "authors": [
          "ewokABdevito"
        ],
