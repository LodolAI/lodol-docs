      "parameters": [
        {
          "description": "The annotation's Genius ID, a number. The annotation actions return it.",
          "display_name": "Annotation",
          "minimum": 1,
          "name": "annotation_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/genius/get-annotation",
      "result_str_template": "Genius annotation retrieved.",
      "returns": {
        "properties": {
          "authors": {
            "description": "The Genius contributors who wrote it",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "body": {
            "description": "What the annotation says, as plain text",
            "type": "string"
          },
          "comment_count": {
            "description": "How many comments have been left on it",
            "type": "number"
          },
          "fragment": {
            "description": "The lyric or passage the annotation explains",
            "type": "string"
          },
          "id": {
            "description": "The annotation's Genius ID",
            "type": "number"
          },
          "referent_id": {
            "description": "The Genius ID of the annotated fragment",
            "type": "number"
          },
          "referent_url": {
            "description": "Link to the annotated fragment on Genius",
            "type": "string"
          },
          "state": {
            "description": "Where it stands on Genius: 'accepted', 'verified', 'pending', or 'needs_exegesis'",
            "type": "string"
          },
          "url": {
            "description": "Link to the annotation on Genius",
            "type": "string"
          },
          "verified": {
            "description": "Whether the artist themselves verified the annotation",
            "type": "boolean"
          },
          "votes_total": {
            "description": "The annotation's score: upvotes minus downvotes",
            "type": "number"
          }
        },
        "type": "object"
      }
