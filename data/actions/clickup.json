    "find_tasks": {
      "description": "List the tasks in a ClickUp list that are still open, each with its first assignee's name and email, its due date and a link. Turn on Only overdue to get just the ones past their due date.",
      "display_name": "Find tasks",
      "display_str_template": "Find tasks in list '{0}'.",
      "handler": "actions.find_tasks",
      "id": "clickup_find_tasks",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "tasks": [
          {
            "assignee_email": "ada@example.com",
            "assignee_name": "Ada Lovelace",
            "assignees": [
              "Ada Lovelace"
            ],
            "due_date": "2026-11-02",
            "id": "abc123",
            "name": "Send the proposal",
            "status": "in progress",
            "url": "https://app.clickup.com/t/abc123"
          }
        ]
      },
      "name": "find_tasks",
      "output_formatter": "actions.format_find_tasks_output",
      "parameters": [
        {
          "description": "The ClickUp list to read tasks from. Choosing it by name is in beta: each list is shown with its space and folder, such as Marketing / Events / Follow-ups, from the first 30 spaces of the connected account. A list's ID (the number at the end of its link in ClickUp) works too.",
          "display_name": "List",
          "dynamic_source": "lists",
          "dynamic_source_allows_custom": true,
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only tasks whose due date has passed",
          "display_name": "Only overdue",
          "name": "overdue_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Also return tasks that are done or closed",
          "display_name": "Include finished tasks",
          "name": "include_closed",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/clickup/find-tasks",
      "result_str_template": "Found tasks in list {0}.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many tasks",
            "type": "number"
          },
          "tasks": {
            "description": "The tasks, up to 500",
            "items": {
              "properties": {
                "assignee_email": {
                  "description": "Their email; blank when nobody is assigned",
                  "type": "string"
                },
                "assignee_name": {
                  "description": "The first person it is assigned to; blank when nobody is",
                  "type": "string"
                },
                "assignees": {
                  "description": "Names of everyone it is assigned to",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "due_date": {
                  "description": "When it is due (YYYY-MM-DD); blank when it has none",
                  "type": "string"
                },
                "id": {
                  "description": "Task ID",
                  "type": "string"
                },
                "name": {
                  "description": "Task name",
                  "type": "string"
                },
                "status": {
                  "description": "Its status, such as in progress",
                  "type": "string"
                },
                "url": {
                  "description": "Link that opens the task",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
