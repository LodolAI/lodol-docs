    "update_task_status": {
      "description": "Update the status of an existing ClickUp task.",
      "display_name": "Update task status",
      "display_str_template": "Update task '{0}' status to '{1}'.",
      "handler": "actions.update_task_status",
      "id": "clickup_update_task_status",
      "method": "POST",
      "mock_response": {
        "id": "abc123",
        "name": "My Task",
        "status": {
          "status": "in progress"
        }
      },
      "name": "update_task_status",
      "output_formatter": "actions.format_update_task_status_output",
      "parameters": [
        {
          "description": "The ID of the task to update",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
