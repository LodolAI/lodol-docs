{
  "actions": {
    "add_comment_to_task": {
      "description": "Add a comment to an existing ClickUp task.",
      "display_name": "Add comment to task",
      "display_str_template": "Add comment to task '{0}'.",
      "handler": "actions.add_comment_to_task",
      "id": "clickup_add_comment_to_task",
      "method": "POST",
      "mock_response": {
        "comment_text": "This is a comment",
        "id": "comment123"
      },
      "name": "add_comment_to_task",
      "output_formatter": "actions.format_add_comment_to_task_output",
      "parameters": [
        {
          "description": "The ID of the task to add a comment to",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text content of the comment",
          "display_name": "Comment text",
          "multiline": true,
          "name": "comment_text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/clickup/add-comment",
      "result_str_template": "Added comment to task '{0}'.",
      "returns": {
        "properties": {
          "comment_text": {
            "description": "Comment text",
            "type": "string"
          },
          "id": {
            "description": "Comment ID",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_task": {
      "description": "Create a new task in a ClickUp list.",
      "display_name": "Create task",
      "display_str_template": "Create task '{1}' in list '{0}'.",
      "handler": "actions.create_task",
      "id": "clickup_create_task",
      "method": "POST",
      "mock_response": {
        "id": "abc123",
        "name": "New Task",
        "status": {
          "status": "to do"
        },
        "url": "https://app.clickup.com/t/abc123"
      },
      "name": "create_task",
      "output_formatter": "actions.format_create_task_output",
      "parameters": [
        {
          "description": "The ID of the list to create the task in",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the task",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The description of the task",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The status of the task",
          "display_name": "Status",
          "name": "status",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "List of user IDs to assign to the task",
          "display_name": "Assignee IDS",
          "name": "assignee_ids",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "When the task is due, entered as the number of milliseconds since January 1, 1970 (for example, 1767225600000 for January 1, 2026)",
          "display_name": "Due date",
          "name": "due_date",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/clickup/create-task",
      "result_str_template": "Created task '{1}' with ID {2}.",
      "returns": {
        "properties": {
          "id": {
            "description": "Task ID",
            "type": "string"
          },
          "name": {
            "description": "Task name",
            "type": "string"
          },
          "status": {
            "description": "Task status",
            "type": "object"
          },
          "url": {
            "description": "URL to the task",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_folders": {
      "description": "Retrieve all folders within a ClickUp space.",
