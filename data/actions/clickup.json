        {
          "description": "The ID of the space to list folders from",
          "display_name": "Space ID",
          "name": "space_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/clickup/list-folders",
      "result_str_template": "Returned {1} folders from space {0}.",
      "returns": {
        "description": "List of folders",
        "items": {
          "properties": {
            "id": {
              "description": "Folder ID",
              "type": "string"
            },
            "name": {
              "description": "Folder name",
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      }
    },
