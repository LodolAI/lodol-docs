{
  "actions": {
    "add_comment_to_task": {
      "description": "Add a comment to an existing ClickUp task.",
      "display_name": "Add comment to task",
      "display_str_template": "Add comment to task '{0}'.",
      "handler": "actions.add_comment_to_task",
      "id": "clickup_add_comment_to_task",
      "method": "POST",
      "mock_response": {
        "comment_text": "This is a comment",
        "id": "comment123"
      },
      "name": "add_comment_to_task",
      "output_formatter": "actions.format_add_comment_to_task_output",
      "parameters": [
        {
          "description": "The ID of the task to add a comment to",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text content of the comment",
          "display_name": "Comment text",
          "multiline": true,
          "name": "comment_text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/clickup/add-comment",
      "result_str_template": "Added comment to task '{0}'.",
      "returns": {
        "properties": {
          "comment_text": {
            "description": "Comment text",
            "type": "string"
          },
          "id": {
            "description": "Comment ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_task": {
      "description": "Create a new task in a ClickUp list.",
      "display_name": "Create task",
      "display_str_template": "Create task '{1}' in list '{0}'.",
      "handler": "actions.create_task",
      "id": "clickup_create_task",
      "method": "POST",
      "mock_response": {
        "id": "abc123",
        "name": "New Task",
        "status": {
          "status": "to do"
        },
        "url": "https://app.clickup.com/t/abc123"
      },
      "name": "create_task",
      "output_formatter": "actions.format_create_task_output",
      "parameters": [
        {
          "description": "The ClickUp list to add the task to. Choosing it by name is in beta: each list is shown with its space and folder, such as Marketing / Events / Follow-ups, from the first 30 spaces of the connected account. A list's ID (the number at the end of its link in ClickUp) works too. Leave blank to name the list in List name instead.",
          "display_name": "List",
          "dynamic_source": "lists",
          "dynamic_source_allows_custom": true,
          "name": "list_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Beta. The list's name, such as Bugs; used when no list is chosen. Looks in every space of the workspace and fails if no list or more than one has that name. Capital letters don't matter.",
          "display_name": "List name",
          "name": "list_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the task",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The description of the task",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The status of the task",
          "display_name": "Status",
          "name": "status",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The people to assign the task to. Leave empty to assign nobody. Beta: choose them by name from the members of the connected ClickUp account, or give a person's email address (such as one from a form or a sheet) and the step finds them in ClickUp; it stops without creating the task when nobody there has that email. ClickUp user IDs work too.",
          "display_name": "Assignees",
          "dynamic_source": "members",
          "dynamic_source_allows_custom": true,
          "name": "assignee_ids",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "When the task is due: a date such as 2026-11-20 (Beta: shown as that day, with no time), a date and time such as 2026-11-20T15:00:00Z (Beta), or the number of milliseconds since January 1, 1970 (for example, 1767225600000 for January 1, 2026). A date from an earlier step, such as a new hire's start date, can go here as it is, with no step to convert it. Wins over the counted due dates below.",
          "display_name": "Due date",
          "name": "due_date",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Beta. Due this many working days (Monday to Friday) after Count days from, or after today when that is empty, for example 5 for 'due in a week'. A negative number counts back, such as -3 for 'ready 3 working days before the start date', so no earlier step has to work the date out. Wins over Due in days.",
          "display_name": "Due in working days",
          "name": "due_in_working_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Beta. Due this many calendar days (weekends included) after Count days from, or after today when that is empty, such as 30 for a '30-day check-in'; a negative number counts back. Used when Due date and Due in working days are empty.",
          "display_name": "Due in days",
          "name": "due_in_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Beta. The date Due in working days and Due in days count from, such as a new hire's start date (2026-11-20), instead of today. On its own, without either count, the task is due on this date. Leave empty to count from today.",
          "display_name": "Count days from",
          "name": "days_from",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Beta. To make a subtask, the task to put it under, which must be in the same list. Leave blank for an ordinary task.",
          "display_name": "Parent task",
          "name": "parent_task_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/clickup/create-task",
      "result_str_template": "Created task '{1}' with ID {2}.",
      "returns": {
        "properties": {
          "id": {
            "description": "Task ID",
            "type": "string"
          },
          "name": {
            "description": "Task name",
            "type": "string"
          },
          "status": {
            "description": "Task status",
            "type": "object"
          },
          "url": {
            "description": "URL to the task",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_task": {
      "description": "Delete a ClickUp task. ClickUp keeps it in the Trash, where it can be restored for 30 days.",
