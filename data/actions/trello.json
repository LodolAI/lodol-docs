      },
      "name": "add_attachment_to_card",
      "output_formatter": "actions.format_add_attachment_output",
      "parameters": [
        {
          "description": "The card to attach it to, as an earlier step gave it, or its ID.",
          "display_name": "Card",
          "label_source": "card_names",
          "name": "card_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "autofill_name_param": "name",
          "description": "The file to attach: upload one or pick one from an earlier step. Leave blank to attach a Link instead.",
          "display_name": "File",
          "name": "file",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A web address to attach, starting https://, when there is no File.",
          "display_name": "Link",
          "name": "link",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What the attachment is called on the card. Leave blank for the file's name or the link.",
          "display_name": "Name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/trello/add-attachment-to-card",
      "result_str_template": "Attached to the card.",
      "returns": {
        "properties": {
          "attachment": {
            "description": "The attachment Trello added.",
            "properties": {
              "card_id": {
                "description": "The card it is on.",
                "type": "string"
              },
              "id": {
                "description": "The attachment's ID.",
                "type": "string"
              },
              "is_upload": {
                "description": "True for a file, false for a link.",
                "type": "boolean"
              },
              "name": {
                "description": "What it is called on the card.",
                "type": "string"
              },
              "url": {
                "description": "Where it opens: the file or the link.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
