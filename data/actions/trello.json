          "id": "5e8b9d1234567890abcdef0b",
          "is_upload": true,
          "name": "Quote.pdf",
          "url": "https://trello.com/1/cards/5e8b9d1234567890abcdef03/attachments/5e8b9d1234567890abcdef0b/download/Quote.pdf"
