    "find_cards": {
      "description": "List the cards in one Trello list, longest untouched first, each with its link, due date and how many days since anyone last touched it. Give Untouched for to get only the stuck ones.",
      "display_name": "Find cards in a list",
      "display_str_template": "Find cards in {list_id}.",
      "handler": "actions.find_cards",
      "id": "trello_find_cards",
      "method": "POST",
      "mock_response": {
        "cards": [
          {
            "days_overdue": 14,
            "days_since_activity": 33,
            "description": "",
            "due": "2026-10-20T09:00:00Z",
            "due_display": "Oct 20, 2026",
            "id": "5e8b9d1234567890abcdef03",
            "last_activity": "2026-10-01T09:00:00Z",
            "name": "Waiting on legal review",
            "url": "https://trello.com/c/abc123"
          }
        ],
        "count": 1
      },
      "name": "find_cards",
      "output_formatter": "actions.format_find_cards_output",
      "parameters": [
        {
          "description": "The list to look in, such as Blocked. Pick one, or use one from an earlier step.",
          "display_name": "List",
          "dynamic_source": "lists",
          "dynamic_source_allows_custom": true,
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only cards nobody has touched for at least this many days. Leave empty for every card in the list.",
          "display_name": "Untouched for (days)",
          "name": "idle_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Beta. Turn on to get only the cards whose due date has passed and that are not ticked complete, longest overdue first, with how many days overdue each is. Needs no date steps.",
