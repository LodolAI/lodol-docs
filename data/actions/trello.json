  "description": "Add, find, move, update and archive cards on your Trello boards.",
  "display_name": "Trello",
  "id": "trello",
  "logo": "https://www.lodol.com/app-icons/trello-icon.png",
  "triggers": {
    "trello_card_moved_trigger": {
      "description": "Runs when a card moves from one list to another on a board, such as from Doing to Done, or only when it moves into one list.",
      "display_name": "Card moved",
      "id": "trello_card_moved_trigger",
      "output": {
        "board_id": "The board's ID.",
        "board_name": "The board's name.",
        "card_id": "The card's ID.",
        "card_name": "The card's title.",
        "card_url": "The card's page in Trello.",
        "from_list_id": "The ID of the list it moved from.",
        "from_list_name": "The name of the list it moved from.",
        "move_id": "The ID of the move in the board's activity.",
        "moved_at": "When it moved.",
        "moved_by": "Who moved it.",
        "to_list_id": "The ID of the list it moved to.",
        "to_list_name": "The name of the list it moved to."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The board to watch.",
          "display_name": "Board",
          "name": "board_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "Only run for cards moved into this list. Leave empty for every move on the board.",
          "display_name": "Moved to list",
          "name": "list_id",
          "required": false
        }
      ]
    },
    "trello_new_card_trigger": {
      "description": "Runs for each new card on a board, or only for those added to one list.",
      "display_name": "New card",
      "id": "trello_new_card_trigger",
      "output": {
        "board_id": "string",
        "description": "string",
        "id": "string",
        "list_id": "string",
        "name": "string",
        "url": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The board to watch for new cards.",
          "display_name": "Board",
          "name": "board_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "Only run for cards added to this list. Leave empty for every new card on the board.",
          "display_name": "List",
          "name": "list_id",
          "required": false
        }
      ]
    }
  }
