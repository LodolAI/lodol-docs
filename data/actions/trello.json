    "create_card": {
      "description": "Add a card to a list, with a description, due date and labels if you like.",
      "display_name": "Create a card",
      "display_str_template": "Add the card '{name}' to {list_id}.",
      "handler": "actions.create_card",
      "id": "trello_create_card",
      "method": "POST",
      "mock_response": {
        "card": {
          "id": "5e8b9d1234567890abcdef03",
          "idList": "5e8b9d1234567890abcdef02",
          "name": "New Task",
          "url": "https://trello.com/c/xyz789/new-task"
        }
      },
      "name": "create_card",
      "output_formatter": "actions.format_create_card_output",
      "parameters": [
        {
          "description": "The list to add the card to. Pick one, or use one from an earlier step.",
          "display_name": "List",
          "dynamic_source": "lists",
          "dynamic_source_allows_custom": true,
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The card's title.",
          "display_name": "Title",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "More about the card, shown when it is opened.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the card is due, for example 2026-07-15T09:00:00Z.",
          "display_name": "Due date",
          "name": "due",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Labels to put on the card, from the list's board. Pick them once you have chosen the list.",
          "display_name": "Labels",
          "dynamic_source": "labels",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "list_id"
          ],
          "name": "label_ids",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/trello/create-card",
      "result_str_template": "Card created.",
      "returns": {
        "properties": {
          "card": {
            "description": "Created Trello card object.",
            "properties": {
              "id": {
                "description": "Trello card ID.",
                "type": "string"
              },
              "idList": {
                "description": "List ID containing card.",
                "type": "string"
              },
              "name": {
                "description": "Card name.",
                "type": "string"
              },
              "url": {
                "description": "Card URL.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
