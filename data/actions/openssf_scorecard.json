{
  "actions": {
    "check_requirements": {
      "description": "Answer one question about a set of open source projects: do they meet the bar? Set a minimum score, optionally name the checks that matter to you, and each project comes back as a pass or a fail with the reasons written out in plain words. Use it to hold a release, open a ticket or send an alert. A project with no published result, a check Scorecard could not evaluate, and a result too old to trust all fail rather than quietly pass, and each says which of the three it was.",
      "display_name": "Check security requirements",
      "display_str_template": "Check {repositories} against a minimum score of {minimum_score}.",
      "handler": "actions.check_requirements",
      "id": "openssf_scorecard_check_requirements",
