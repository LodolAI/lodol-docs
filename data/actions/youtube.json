    "search_videos": {
      "description": "Search YouTube for videos that match your keywords.",
      "display_name": "Search for videos",
      "display_str_template": "Search YouTube for '{0}' and return up to {1} results.",
      "handler": "actions.search_videos",
      "id": "youtube_search_videos",
      "method": "POST",
      "mock_response": {
        "items": [
          {
            "channel_id": "UCaBc123XyZ456",
            "channel_title": "Sample Item",
            "description": "Sample text content",
            "published_at": "2024-01-15T10:30:00Z",
            "title": "Sample Item",
            "video_id": "dQw4w9WgXcQ"
          }
        ],
        "next_page_token": "example_value",
        "status": "success"
      },
      "name": "search_videos",
      "output_formatter": "actions.format_search_videos_output",
      "parameters": [
        {
          "description": "Keywords to search for on YouTube.",
          "display_name": "Search terms",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of videos to return",
          "display_name": "Max results",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How to sort the results, for example by relevance or date.",
          "display_name": "Sort order",
          "name": "order",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/youtube/search-videos",
      "result_str_template": "YouTube search completed.",
      "returns": {
        "properties": {
          "items": {
            "description": "Array of video search results. Each item contains video_id (use for details/comments), title, description snippet, channel info (id/title), and published_at timestamp. Use video_id with youtube_video_details for full metadata",
            "items": {
              "properties": {
                "channel_id": {
                  "description": "Channel ID that uploaded this video",
                  "type": "string"
                },
                "channel_title": {
                  "description": "Channel name that uploaded this video",
                  "type": "string"
                },
                "description": {
                  "description": "Video description snippet (truncated)",
                  "type": "string"
                },
                "published_at": {
                  "description": "Video publication timestamp (ISO 8601 format)",
                  "type": "string"
                },
                "title": {
                  "description": "Video title",
                  "type": "string"
                },
                "video_id": {
                  "description": "YouTube video ID",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "next_page_token": {
            "description": "Pagination token for fetching the next page of results. Pass this as pageToken parameter to continue listing. Null if no more results",
            "type": "string"
          },
          "status": {
            "description": "Action execution status",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
