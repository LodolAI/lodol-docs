{
  "actions": {
    "channel_details": {
      "description": "Look up a channel's name, description, subscriber count, and view count.",
      "display_name": "Get channel details",
      "display_str_template": "Get details for YouTube channel '{0}'.",
      "handler": "actions.channel_details",
      "id": "youtube_channel_details",
      "method": "POST",
      "mock_response": {
        "channel_id": {
          "id": "abc123",
          "name": "Sample"
        },
        "description": "Sample text content",
        "related_playlists": "example_value",
        "subscriber_count": 1,
        "title": "Sample Item",
        "video_count": 1,
        "view_count": 1
      },
      "name": "channel_details",
      "output_formatter": "actions.format_channel_details_output",
      "parameters": [
        {
          "description": "The ID of the channel to look up.",
          "display_name": "Channel ID",
          "name": "channel_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/youtube/channel-details",
      "result_str_template": "YouTube channel details retrieved.",
      "returns": {
        "properties": {
          "channel_id": {
            "description": "YouTube channel ID (24-character string starting with 'UC')",
            "type": "string"
          },
          "description": {
            "description": "Channel description/about text",
            "type": "string"
          },
          "related_playlists": {
            "description": "Object containing special playlist IDs like 'uploads' (all channel videos). Use uploads playlist ID with youtube_playlist_items action",
            "properties": {
              "uploads": {
                "description": "Playlist ID containing all uploads from this channel",
                "type": "string"
              }
            },
            "type": "object"
          },
          "status": {
            "description": "Action execution status",
            "type": "string"
          },
          "subscriber_count": {
            "description": "Number of subscribers to this channel. Use for popularity metrics or filtering",
            "type": "integer"
          },
          "title": {
            "description": "Channel name/title as displayed on YouTube",
            "type": "string"
          },
          "video_count": {
            "description": "Total number of public videos uploaded by this channel",
            "type": "integer"
          },
          "view_count": {
            "description": "Total view count across all videos on this channel",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "channel_playlists": {
      "description": "List playlists for a YouTube channel.",
      "display_name": "List channel playlists",
      "display_str_template": "List playlists for YouTube channel '{0}'.",
      "handler": "actions.channel_playlists",
      "id": "youtube_channel_playlists",
      "method": "POST",
      "mock_response": {
        "items": [
          {
            "description": "Sample text content",
            "item_count": 1,
            "playlist_id": "PLabc123xyz456",
            "title": "Sample Item"
          }
        ],
        "next_page_token": "example_value",
        "status": "success"
      },
      "name": "channel_playlists",
      "output_formatter": "actions.format_channel_playlists_output",
      "parameters": [
        {
          "description": "Channel ID to list playlists for",
          "display_name": "Channel ID",
          "name": "channel_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of playlists to return",
          "display_name": "Max results",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/youtube/channel-playlists",
      "result_str_template": "YouTube channel playlists listed.",
      "returns": {
        "properties": {
          "items": {
            "description": "Array of playlists for the specified channel. Each playlist contains playlist_id (use with youtube_playlist_items), title, description, and item_count (video count)",
            "items": {
              "properties": {
                "description": {
                  "description": "Playlist description text",
                  "type": "string"
                },
                "item_count": {
                  "description": "Number of videos in this playlist",
                  "type": "integer"
                },
                "playlist_id": {
                  "description": "YouTube playlist ID",
                  "type": "string"
                },
                "title": {
                  "description": "Playlist title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "next_page_token": {
            "description": "Pagination token for fetching the next page of playlists. Null if no more results",
            "type": "string"
          },
          "status": {
            "description": "Action execution status",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "comment_threads": {
      "description": "List the main comments on a video, not the replies.",
      "display_name": "List video comments",
      "display_str_template": "List comments for YouTube video '{0}'.",
      "handler": "actions.comment_threads",
      "id": "youtube_comment_threads",
      "method": "POST",
      "mock_response": {
        "items": [
          {
            "author": "John Doe",
            "comment_id": "Ugxabc123xyz",
            "like_count": 1,
            "published_at": "2024-01-15T10:30:00Z",
            "reply_count": 0,
            "text": "Sample text content"
          }
        ],
        "next_page_token": "example_value",
        "status": "success"
      },
      "name": "comment_threads",
      "output_formatter": "actions.format_comment_threads_output",
      "parameters": [
        {
          "description": "The ID of the video to read comments from.",
          "display_name": "Video ID",
          "name": "video_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of comments to return",
          "display_name": "Max results",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/youtube/comment-threads",
      "result_str_template": "YouTube comments retrieved.",
      "returns": {
        "properties": {
          "items": {
            "description": "Array of top-level comment threads for the video. Each thread contains comment_id, author name, text content, like_count, published_at timestamp, and reply_count. Use for sentiment analysis or displaying user feedback",
            "items": {
              "properties": {
                "author": {
                  "description": "Comment author's display name",
                  "type": "string"
                },
                "comment_id": {
                  "description": "Top-level comment ID. This is the parent comment in the thread",
                  "type": "string"
                },
                "like_count": {
                  "description": "Number of likes on this comment",
                  "type": "integer"
                },
                "published_at": {
                  "description": "Comment publication timestamp (ISO 8601 format)",
                  "type": "string"
                },
                "reply_count": {
                  "description": "Number of replies to this comment",
                  "type": "integer"
                },
                "text": {
                  "description": "Comment text content",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "next_page_token": {
            "description": "Pagination token for fetching the next page of comments. Null if no more results",
            "type": "string"
          },
          "status": {
            "description": "Action execution status",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "most_popular": {
      "description": "List the trending videos in a country.",
      "display_name": "List trending videos",
      "display_str_template": "List trending YouTube videos for region '{0}'.",
      "handler": "actions.most_popular",
      "id": "youtube_most_popular",
      "method": "POST",
      "mock_response": {
        "items": [
          {
            "channel_id": "UCaBc123XyZ456",
            "channel_title": "Sample Item",
            "published_at": "2024-01-15T10:30:00Z",
            "title": "Sample Item",
            "video_id": "dQw4w9WgXcQ",
            "view_count": 1
          }
        ],
        "next_page_token": "example_value",
        "status": "success"
      },
      "name": "most_popular",
      "output_formatter": "actions.format_most_popular_output",
      "parameters": [
        {
          "description": "Two-letter country code for the trending list, for example US or GB.",
          "display_name": "Country code",
          "name": "region_code",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of trending videos to return",
          "display_name": "Max results",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/youtube/most-popular",
      "result_str_template": "Trending YouTube videos retrieved.",
      "returns": {
        "properties": {
          "items": {
            "description": "Array of trending videos for the specified region. Each video contains video_id (use for details), title, channel info (id/title), view_count, and published_at timestamp. Use for discovering popular content",
            "items": {
              "properties": {
                "channel_id": {
                  "description": "Channel ID that uploaded this video",
                  "type": "string"
                },
                "channel_title": {
                  "description": "Channel name",
                  "type": "string"
                },
                "published_at": {
                  "description": "Publication timestamp (ISO 8601 format)",
                  "type": "string"
                },
                "title": {
                  "description": "Video title",
                  "type": "string"
                },
                "video_id": {
                  "description": "YouTube video ID",
                  "type": "string"
                },
                "view_count": {
                  "description": "Number of views",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "next_page_token": {
            "description": "Pagination token for fetching the next page of trending videos. Null if no more results",
            "type": "string"
          },
          "status": {
            "description": "Action execution status",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
