            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of results to return per page (default 20).",
          "display_name": "Limit",
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "For pagination: the ID of the last item from the previous page. Leave blank for the first page.",
          "display_name": "Continue after ID",
          "name": "starting_after",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/revenuecat/list-customer-subscriptions",
      "result_str_template": "Retrieved customer subscriptions.",
      "returns": {
        "properties": {
          "next_page": {
            "description": "URL of the next page, or null.",
            "type": "string"
          },
          "subscriptions": {
            "description": "The customer's subscriptions.",
            "items": {
              "properties": {
                "auto_renewal_status": {
                  "description": "Renewal state, e.g. will_renew, will_not_renew, will_pause.",
                  "type": "string"
                },
                "current_period_ends_at": {
                  "description": "End of the current billing period (ms since epoch), or null.",
                  "type": "integer"
                },
                "environment": {
                  "description": "Store environment (production or sandbox).",
                  "type": "string"
                },
                "gives_access": {
                  "description": "Whether the customer should currently be given access from this subscription.",
                  "type": "boolean"
                },
                "id": {
                  "description": "Subscription ID (e.g. 'sub1ab2c3d4e5').",
                  "type": "string"
                },
                "product_id": {
                  "description": "RevenueCat product ID.",
                  "type": "string"
                },
                "status": {
                  "description": "Subscription status: trialing, active, expired, in_grace_period, in_billing_retry, paused, unknown, or incomplete.",
                  "type": "string"
                },
                "store": {
                  "description": "Store the subscription belongs to (e.g. app_store, play_store, stripe).",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
