{
  "actions": {
    "get_customer": {
      "description": "Look up a single customer by their App User ID, including the entitlements they currently have active. Optionally expand the customer's subscriber attributes (such as $email).",
      "display_name": "Get customer",
      "display_str_template": "Get RevenueCat customer '{1}'.",
      "handler": "actions.get_customer",
      "id": "revenuecat_get_customer",
      "method": "POST",
      "mock_response": {
        "active_entitlements": [
          {
            "entitlement_id": "entla1b2c3d4e5",
            "expires_at": 1721735423658
          }
        ],
        "first_seen_at": 1658399423658,
        "id": "app_user_0f8fad5b",
        "last_seen_app_version": "2.4.1",
        "last_seen_at": 1690199423658,
        "last_seen_country": "US",
        "last_seen_platform": "ios",
        "project_id": "proj1ab2c3d4"
      },
      "name": "get_customer",
      "output_formatter": "actions.format_get_customer_output",
      "parameters": [
        {
          "description": "The RevenueCat project ID, for example 'proj1ab2c3d4'. Use the 'List projects' action to find it.",
          "display_name": "Project ID",
          "name": "project_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The customer's App User ID in RevenueCat. Use the 'List customers' action (optionally searching by email) to find it.",
          "display_name": "Customer ID",
          "name": "customer_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Set to true to also return the customer's subscriber attributes (name, email, and any custom attributes).",
          "display_name": "Include attributes",
          "name": "expand_attributes",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/revenuecat/get-customer",
      "result_str_template": "Retrieved RevenueCat customer.",
      "returns": {
        "description": "The customer object. 'active_entitlements' lists the entitlements the customer currently has access to.",
        "properties": {
          "active_entitlements": {
            "description": "Entitlements currently active for the customer.",
            "items": {
              "properties": {
                "entitlement_id": {
                  "description": "ID of the active entitlement.",
                  "type": "string"
                },
                "expires_at": {
                  "description": "Expiry (ms since epoch), or null if it never expires.",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "first_seen_at": {
            "description": "First seen (ms since epoch).",
            "type": "integer"
          },
          "id": {
            "description": "The customer's App User ID.",
            "type": "string"
          },
          "last_seen_at": {
            "description": "Last seen (ms since epoch).",
            "type": "integer"
          },
          "last_seen_country": {
            "description": "Last country (ISO code).",
            "type": "string"
          },
          "last_seen_platform": {
            "description": "Last platform (e.g. 'ios').",
            "type": "string"
          },
          "project_id": {
            "description": "ID of the owning project.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
