          "description": "Activity ID to retrieve.",
          "display_name": "Activity ID",
          "name": "activity_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/strava/activity-details",
      "result_str_template": "Activity retrieved.",
      "returns": {
        "description": "Response envelope; the payload is in the \"activity\" field.",
        "properties": {
          "activity": {
            "properties": {
              "distance": {
                "description": "Distance in meters.",
                "type": "number"
              },
              "elapsed_time": {
                "description": "Total elapsed time in seconds.",
                "type": "integer"
              },
              "id": {
                "description": "Activity id.",
