    "create_report": {
      "description": "Build a summary report from the connected athlete's recent activities, with total distance, moving time, elevation, and a per-sport breakdown.",
      "display_name": "Create report",
      "display_str_template": "Create an activity report",
      "handler": "actions.create_report",
      "id": "strava_create_report",
      "method": "POST",
      "mock_response": {
        "activities_by_type": {
          "Ride": 4,
          "Run": 8
        },
        "activity_count": 12,
        "summary": "Activity report for the 12 most recent activities: 84.21 km over 6.0 h moving time, 1240 m of elevation gain. Breakdown: Ride: 4, Run: 8.",
        "total_distance_km": 84.21,
        "total_distance_meters": 84213.0,
        "total_elapsed_time_seconds": 23400,
        "total_elevation_gain_meters": 1240.0,
        "total_moving_time_seconds": 21600
      },
      "name": "create_report",
      "parameters": [
        {
          "description": "How many of the most recent activities to include in the report (1-200). Defaults to 30.",
          "display_name": "Number of activities",
          "maximum": 200,
          "minimum": 1,
          "name": "activity_count",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/strava/create-report",
      "result_str_template": "Report created.",
      "returns": {
        "properties": {
          "activities_by_type": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Count of activities by sport type.",
            "type": "object"
          },
          "activity_count": {
            "description": "Number of activities summarized.",
            "type": "integer"
          },
          "summary": {
            "description": "A human-readable summary of the report.",
            "type": "string"
          },
          "total_distance_km": {
            "description": "Total distance in kilometers.",
            "type": "number"
          },
          "total_distance_meters": {
            "description": "Total distance in meters.",
            "type": "number"
          },
          "total_elapsed_time_seconds": {
            "description": "Total elapsed time in seconds.",
            "type": "integer"
          },
          "total_elevation_gain_meters": {
            "description": "Total elevation gain in meters.",
            "type": "number"
          },
          "total_moving_time_seconds": {
            "description": "Total moving time in seconds.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "get_activity": {
      "description": "Retrieve detailed information about a specific activity.",
      "display_name": "Get activity",
      "display_str_template": "Get activity {activity_id}",
