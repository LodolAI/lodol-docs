              },
              "moving_time": {
                "description": "Moving time in seconds.",
                "type": "integer"
              },
              "name": {
                "description": "Activity name.",
                "type": "string"
              },
              "start_date": {
                "description": "Start date/time in ISO format.",
                "type": "string"
              },
              "type": {
                "description": "Activity type.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
