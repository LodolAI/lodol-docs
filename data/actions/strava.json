        "activity": {
          "distance": 5000,
          "elapsed_time": 1600,
          "id": "987654321",
          "moving_time": 1500,
          "name": "Morning Run",
          "start_date": "2024-01-15T06:30:00Z",
          "type": "Run"
        }
      },
      "name": "get_activity",
      "parameters": [
