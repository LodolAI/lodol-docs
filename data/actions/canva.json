{
  "actions": {
    "create_design": {
      "description": "Create a new design in Canva with a specified type, dimensions, and optional title.",
      "display_name": "Create a Canva design",
      "display_str_template": "Create a '{0}' design in Canva.",
      "handler": "actions.create_design",
      "id": "canva_create_design",
      "method": "POST",
      "mock_response": {
        "id": "DAFVcK_N123",
        "title": "My New Design",
        "urls": {
          "edit_url": "https://www.canva.com/design/DAFVcK_N123/edit",
          "view_url": "https://www.canva.com/design/DAFVcK_N123/view"
        }
      },
      "name": "create_design",
      "output_formatter": "actions.format_create_design_output",
      "parameters": [
        {
          "description": "The type of design to create: 'doc', 'whiteboard', 'presentation', or 'custom'. Custom designs need a width and height.",
          "display_name": "Design type",
          "name": "design_type",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional title for the design (1-255 characters).",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Width in pixels (40-8000) for custom design type.",
          "display_name": "Width",
          "name": "width",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Height in pixels (40-8000) for custom design type.",
          "display_name": "Height",
          "name": "height",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional ID of an image already uploaded to Canva to add to the design.",
          "display_name": "Asset ID",
          "name": "asset_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/canva/create-design",
      "result_str_template": "Created design with ID '{id}'.",
      "returns": {
        "properties": {
          "id": {
            "description": "The unique ID of the created design.",
            "type": "string"
          },
          "title": {
            "description": "The title of the design.",
            "type": "string"
          },
          "urls": {
            "description": "URLs associated with the design (edit, view).",
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "export_design": {
      "description": "Export a Canva design to a file format like PDF, PNG, JPG, or MP4.",
      "display_name": "Export a Canva design",
      "display_str_template": "Export design '{0}' as {1}.",
      "handler": "actions.export_design",
      "id": "canva_export_design",
      "method": "POST",
      "mock_response": {
        "design_id": "DAFVcK_N123",
        "job_id": "export_job_123abc",
        "status": "in_progress"
      },
      "name": "export_design",
      "output_formatter": "actions.format_export_design_output",
      "parameters": [
        {
          "description": "The ID of the design to export.",
          "display_name": "Design ID",
          "name": "design_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "png",
          "description": "The file format to export to: 'pdf', 'jpg', 'png', 'gif', 'pptx', or 'mp4'.",
          "display_name": "File format",
          "name": "format_type",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Quality of the exported file: 'regular' or 'pro'. Applies to JPG and PDF exports.",
          "display_name": "Quality",
          "name": "quality",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional export width (respects aspect ratio).",
          "display_name": "Width",
          "name": "width",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional export height (respects aspect ratio).",
          "display_name": "Height",
          "name": "height",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional list of page numbers to export. The first page is 1.",
          "display_name": "Pages",
          "name": "pages",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/canva/export-design",
      "result_str_template": "Export job '{job_id}' started with status '{status}'.",
      "returns": {
        "properties": {
          "design_id": {
            "description": "The ID of the design being exported.",
            "type": "string"
          },
          "job_id": {
            "description": "The export job ID to check status.",
            "type": "string"
          },
          "status": {
            "description": "Current status of the export job.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_design": {
      "description": "Retrieve details about a specific Canva design.",
      "display_name": "Get design details",
      "display_str_template": "Get details for design '{0}'.",
      "handler": "actions.get_design",
      "id": "canva_get_design",
      "method": "POST",
      "mock_response": {
        "created_at": "2024-01-15T10:30:00Z",
        "id": "DAFVcK_N123",
        "owner": {
          "team_id": "team_456",
          "user_id": "user_123"
        },
        "title": "My Design",
        "updated_at": "2024-01-16T14:45:00Z",
        "urls": {
          "edit_url": "https://www.canva.com/design/DAFVcK_N123/edit",
          "view_url": "https://www.canva.com/design/DAFVcK_N123/view"
        }
      },
      "name": "get_design",
      "output_formatter": "actions.format_get_design_output",
      "parameters": [
        {
          "description": "The ID of the design to retrieve.",
          "display_name": "Design ID",
          "name": "design_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/canva/get-design",
      "result_str_template": "Retrieved design '{id}': {title}.",
      "returns": {
        "properties": {
          "created_at": {
            "description": "Creation timestamp.",
            "type": "string"
          },
          "id": {
            "description": "The design ID.",
            "type": "string"
          },
          "owner": {
            "description": "Owner information.",
            "type": "object"
          },
          "title": {
            "description": "The design title.",
            "type": "string"
          },
          "updated_at": {
            "description": "Last update timestamp.",
            "type": "string"
          },
          "urls": {
            "description": "URLs for the design.",
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_export_job": {
      "description": "Check the status and results of a Canva export job.",
      "display_name": "Get export job status",
      "display_str_template": "Check export job '{0}' status.",
      "handler": "actions.get_export_job",
      "id": "canva_get_export_job",
      "method": "POST",
      "mock_response": {
        "job_id": "export_job_123abc",
        "status": "success",
        "urls": [
          "https://export.canva.com/export_job_123abc/design.png"
        ]
      },
      "name": "get_export_job",
      "output_formatter": "actions.format_get_export_job_output",
      "parameters": [
        {
          "description": "The export job ID returned by the 'Export a Canva design' action.",
          "display_name": "Job ID",
          "name": "job_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/canva/get-export-job",
      "result_str_template": "Export job '{job_id}' status: {status}.",
      "returns": {
        "properties": {
          "job_id": {
            "description": "The export job ID.",
            "type": "string"
          },
          "status": {
            "description": "Job status: 'in_progress', 'success', or 'failed'.",
            "type": "string"
          },
          "urls": {
            "description": "Download URLs when export is complete.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_designs": {
      "description": "List the designs in your connected Canva account.",
      "display_name": "List Canva designs",
      "display_str_template": "List Canva designs{0}.",
      "handler": "actions.list_designs",
      "id": "canva_list_designs",
      "method": "POST",
      "mock_response": {
        "continuation": "next_page_token_xyz",
        "designs": [
          {
            "id": "DAFVcK_N123",
            "thumbnail": {
              "url": "https://thumbnail.canva.com/123.png"
            },
            "title": "My First Design"
          },
          {
            "id": "DAFVcK_N456",
            "thumbnail": {
              "url": "https://thumbnail.canva.com/456.png"
            },
            "title": "My Second Design"
          }
        ]
      },
      "name": "list_designs",
      "output_formatter": "actions.format_list_designs_output",
      "parameters": [
        {
          "description": "Optional text to search for to narrow down the list of designs.",
          "display_name": "Search for",
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "To get the next page of results, pass the 'continuation' value returned by the previous run.",
          "display_name": "Next page token",
          "name": "continuation",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/canva/list-designs",
      "result_str_template": "Retrieved {designs,length} designs.",
      "returns": {
        "properties": {
          "continuation": {
            "description": "Token for fetching the next page of results.",
            "type": "string"
          },
          "designs": {
            "description": "List of design objects.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create, edit, and publish designs in Canva.",
  "display_name": "Canva",
  "id": "canva"
}
