    "get_export_job": {
      "description": "Check on an export that was still running when 'Export a design' stopped waiting, and get its download links once it's done.",
      "display_name": "Get export job status",
      "display_str_template": "Check on export {job_id}.",
      "handler": "actions.get_export_job",
      "id": "canva_get_export_job",
      "method": "POST",
      "mock_response": {
        "job_id": "export_job_123abc",
        "status": "success",
        "urls": [
          "https://export.canva.com/export_job_123abc/design.png"
        ]
      },
      "name": "get_export_job",
      "output_formatter": "actions.format_get_export_job_output",
      "parameters": [
        {
          "description": "The export's ID, as 'Export a design' gave it in its results or its error.",
          "display_name": "Export",
          "name": "job_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/canva/get-export-job",
      "result_str_template": "Export job '{job_id}' status: {status}.",
      "returns": {
        "properties": {
          "job_id": {
            "description": "The export's ID.",
            "type": "string"
          },
          "status": {
            "description": "'in_progress' while Canva is still making the file, then 'success' or 'failed'.",
            "type": "string"
          },
          "urls": {
            "description": "Download links once the export has succeeded. Canva keeps them working for 24 hours.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_designs": {
      "description": "List the designs in your Canva account and those shared with you, or only the ones that match words you search for.",
      "display_name": "List designs",
      "display_str_template": "List your designs.",
      "handler": "actions.list_designs",
      "id": "canva_list_designs",
      "method": "POST",
      "mock_response": {
        "continuation": "next_page_token_xyz",
        "designs": [
          {
            "id": "DAFVcK_N123",
