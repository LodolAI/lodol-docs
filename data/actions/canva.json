{
  "actions": {
    "create_design": {
      "description": "Start a new, empty design in your Canva account: a presentation, doc, whiteboard or one of a size you choose. You get its edit and view links.",
      "display_name": "Create a design",
      "display_str_template": "Create the design '{title}'.",
      "handler": "actions.create_design",
      "id": "canva_create_design",
      "method": "POST",
      "mock_response": {
        "id": "DAFVcK_N123",
        "title": "My New Design",
        "urls": {
          "edit_url": "https://www.canva.com/design/DAFVcK_N123/edit",
          "view_url": "https://www.canva.com/design/DAFVcK_N123/view"
        }
      },
      "name": "create_design",
      "output_formatter": "actions.format_create_design_output",
      "parameters": [
        {
          "default": "presentation",
          "description": "What kind of design to make. A custom size needs a width and height.",
          "display_name": "Design type",
          "name": "design_type",
          "options": [
            {
              "label": "Presentation",
              "value": "presentation"
            },
            {
              "label": "Doc",
              "value": "doc"
            },
            {
              "label": "Whiteboard",
              "value": "whiteboard"
            },
            {
              "label": "Custom size",
              "value": "custom"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The design's name in Canva, up to 255 characters. Leave blank to let Canva name it.",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Width in pixels, from 40 to 8000.",
          "display_name": "Width",
          "name": "width",
          "required": false,
          "type": "ParameterType.NUMBER",
          "visible_when": {
            "design_type": [
              "custom"
            ]
          }
        },
        {
          "description": "Height in pixels, from 40 to 8000.",
          "display_name": "Height",
          "name": "height",
          "required": false,
          "type": "ParameterType.NUMBER",
          "visible_when": {
            "design_type": [
              "custom"
            ]
          }
        },
        {
          "description": "The ID of an image already uploaded to Canva, to put in the new design. Leave blank for an empty design.",
          "display_name": "Image",
          "name": "asset_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/canva/create-design",
      "result_str_template": "Created design with ID '{id}'.",
      "returns": {
        "properties": {
          "id": {
            "description": "The new design's ID.",
            "type": "string"
          },
          "title": {
            "description": "The design's title.",
            "type": "string"
          },
          "urls": {
            "description": "Links to edit and to view the design.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "export_design": {
      "description": "Make a file from a design, such as a PDF, PNG, JPG or MP4, and get its download links. The step waits up to two minutes for Canva to finish the file.",
      "display_name": "Export a design",
      "display_str_template": "Export {design_id} as {format_type}.",
      "handler": "actions.export_design",
      "id": "canva_export_design",
      "method": "POST",
      "mock_response": {
        "design_id": "DAFVcK_N123",
        "job_id": "export_job_123abc",
        "status": "success",
        "urls": [
          "https://export.canva.com/export_job_123abc/design.png"
        ]
      },
      "name": "export_design",
      "output_formatter": "actions.format_export_design_output",
      "parameters": [
        {
          "description": "The design. Pick one, or use a design ID from an earlier step.",
          "display_name": "Design",
          "dynamic_source": "designs",
          "dynamic_source_allows_custom": true,
          "label_source": "design_names",
          "name": "design_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "png",
          "description": "The kind of file to make.",
          "display_name": "File format",
          "name": "format_type",
          "options": [
            {
              "label": "PNG",
              "value": "png"
            },
            {
              "label": "JPG",
              "value": "jpg"
            },
            {
              "label": "PDF",
              "value": "pdf"
            },
            {
              "label": "GIF",
              "value": "gif"
            },
            {
              "label": "PowerPoint",
              "value": "pptx"
            },
            {
              "label": "MP4 video",
              "value": "mp4"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "For a JPG or PDF: 'regular', or 'pro' to keep elements that need a paid Canva plan. Leave blank for regular.",
          "display_name": "Quality",
          "name": "quality",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Width of the file in pixels. Leave blank to keep the design's size; the shape stays the same either way.",
          "display_name": "Width",
          "name": "width",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Height of the file in pixels. Leave blank to keep the design's size; the shape stays the same either way.",
          "display_name": "Height",
          "name": "height",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Which pages to export, as numbers where the first page is 1. Leave blank for every page.",
          "display_name": "Pages",
          "name": "pages",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/canva/export-design",
      "result_str_template": "Exported design '{design_id}'.",
      "returns": {
        "properties": {
          "design_id": {
            "description": "The ID of the design that was exported.",
            "type": "string"
          },
          "job_id": {
            "description": "The export's ID, for the step 'Get export job status'.",
            "type": "string"
          },
          "status": {
            "description": "'success' once the file is ready.",
            "type": "string"
          },
          "urls": {
            "description": "Download links for the file, one per page for an image. Canva keeps them working for 24 hours.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
