  "triggers": {
    "canva_export_complete_trigger": {
      "description": "Starts the workflow when an export that was still running finishes, with its download links.",
      "display_name": "Export finished",
      "id": "canva_export_complete_trigger",
      "output": {
        "job_id": "string",
        "status": "string",
        "urls": "array"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Canva export job to watch for completion.",
          "display_name": "Export job",
          "name": "job_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "Only trigger when the export finishes with this status. Leave blank to match any status.",
          "display_name": "Status",
          "name": "status_filter",
          "required": false
        }
      ]
    }
  }
