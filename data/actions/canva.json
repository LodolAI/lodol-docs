              "url": "https://thumbnail.canva.com/123.png"
            },
            "title": "My First Design"
          },
          {
            "id": "DAFVcK_N456",
            "thumbnail": {
              "url": "https://thumbnail.canva.com/456.png"
            },
            "title": "My Second Design"
          }
        ]
      },
      "name": "list_designs",
      "output_formatter": "actions.format_list_designs_output",
      "parameters": [
        {
          "description": "Words to look for in your designs. Leave blank to list them all.",
          "display_name": "Search for",
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Leave blank for the first page. For the page after, use the Next page value this step gave last time.",
          "display_name": "Next page",
          "name": "continuation",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/canva/list-designs",
      "result_str_template": "Retrieved {designs,length} designs.",
      "returns": {
        "properties": {
          "continuation": {
