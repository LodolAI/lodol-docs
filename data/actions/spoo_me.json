{
  "actions": {
    "check_custom_ending": {
      "description": "Find out whether a short link ending such as spring-sale can still be had on spoo.me before shortening with it, and if not, why not: taken, reserved, the wrong length or characters spoo.me doesn't allow. No account or API key required.",
      "display_name": "Check if a custom ending is free",
      "display_str_template": "Check whether spoo.me/{0} is free.",
      "handler": "actions.check_custom_ending",
      "id": "spoo_me_check_custom_ending",
      "method": "POST",
      "mock_response": {
        "available": false,
        "custom_ending": "lxPhgdE",
        "message": "Another short link already uses this ending.",
        "reason": "taken",
        "short_url": "https://spoo.me/lxPhgdE"
      },
      "name": "check_custom_ending",
      "parameters": [
        {
          "description": "The ending to check: the part after spoo.me/, letters and numbers or emoji.",
          "display_name": "Custom ending",
          "examples": [
            {
              "label": "Words",
              "value": "spring-sale"
            },
            {
              "label": "Emoji",
              "value": "\ud83d\ude80\ud83d\udd25\ud83e\udd84"
            }
          ],
          "name": "custom_ending",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/spoo-me/check-custom-ending",
      "result_str_template": "{spoo_me_check_custom_ending,message}",
      "returns": {
        "properties": {
          "available": {
            "description": "Whether the ending can be used now.",
            "type": "boolean"
          },
          "custom_ending": {
            "description": "The ending that was checked.",
            "type": "string"
          },
          "message": {
            "description": "The answer as a sentence, to show a person.",
            "type": "string"
          },
          "reason": {
            "description": "Why it can't be used: 'taken', 'reserved', 'wrong_length', 'invalid_characters' or 'unsupported_emoji'. Null when it is free.",
            "type": "string"
          },
          "short_url": {
            "description": "The short link this ending makes, e.g. https://spoo.me/spring-sale.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "expand_link": {
      "description": "Follow any link, from spoo.me or any other shortener, through every redirect to where it really ends up, with each stop on the way. The pages themselves are never loaded, so this is safe for checking a link somebody sent you. No account or API key required.",
      "display_name": "Follow a link's redirects",
      "display_str_template": "Follow {0} to where it ends up.",
      "handler": "actions.expand_link",
      "id": "spoo_me_expand_link",
      "method": "POST",
      "mock_response": {
        "final_status_code": 200,
        "final_url": "https://en.wikipedia.org/wiki/URL_shortening?utm_source=lodol&utm_medium=qa",
        "hops": [
          {
            "is_secure": true,
            "status_code": 302,
            "url": "https://spoo.me/lxPhgdE"
          },
          {
            "is_secure": true,
            "status_code": 200,
            "url": "https://en.wikipedia.org/wiki/URL_shortening?utm_source=lodol&utm_medium=qa"
          }
        ],
        "on_blocklist": false,
        "redirect_count": 1,
        "stopped_early": false,
        "url": "https://spoo.me/lxPhgdE"
      },
      "name": "expand_link",
      "parameters": [
        {
          "description": "The link to follow, such as a bit.ly, is.gd or spoo.me link.",
          "display_name": "Link",
          "examples": [
            {
              "label": "A spoo.me link",
              "value": "https://spoo.me/lxPhgdE"
            },
            {
              "label": "An is.gd link",
              "value": "https://is.gd/AG3Hwv"
            }
          ],
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/spoo-me/expand-link",
      "result_str_template": "It ends up at {spoo_me_expand_link,final_url}.",
      "returns": {
        "properties": {
          "final_status_code": {
            "description": "The final page's web status: 200 means it loads, 404 that it's missing. Null when it didn't answer.",
            "type": "integer"
          },
          "final_url": {
            "description": "Where the link ends up after every redirect.",
            "type": "string"
          },
          "hops": {
            "description": "Every stop in order, the link first.",
            "items": {
              "properties": {
                "is_secure": {
                  "description": "Whether this stop uses https.",
                  "type": "boolean"
                },
                "status_code": {
                  "description": "Its web status: 301 or 302 for a redirect, 200 for a page.",
                  "type": "integer"
                },
                "url": {
                  "description": "The address at this stop.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "on_blocklist": {
            "description": "Whether any stop is on spoo.me's list of known harmful sites.",
            "type": "boolean"
          },
          "redirect_count": {
            "description": "How many redirects there were on the way.",
            "type": "integer"
          },
          "stopped_early": {
            "description": "True when there were too many redirects to follow them all.",
            "type": "boolean"
          },
          "url": {
            "description": "The link followed.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
