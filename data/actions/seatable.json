    "delete_row": {
      "description": "Delete up to 10,000 rows from a table by their row IDs. Returns how many rows were deleted.",
      "display_name": "Delete row",
      "display_str_template": "Delete row.",
      "handler": "actions.delete_row",
      "id": "seatable_delete_row",
      "method": "POST",
      "mock_response": {
        "data": {
          "deleted_rows": 1
        }
      },
      "name": "delete_row",
      "output_formatter": "_specs.<locals>.<lambda>",
      "parameters": [
        {
          "description": "The name of the table to perform the operation on. Alternatively, you can use the `table_id` instead of `table_name`. If using `table_id`, ensure that the key in the request body is replaced accordingly.",
          "display_name": "Table name",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "name": "table_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Defines the rows which should be deleted. Maximum 10,000 row IDs per call.",
          "display_name": "Row IDs",
          "name": "row_ids",
          "required": true,
          "schema": {
            "description": "Defines the rows which should be deleted. Maximum 10,000 row IDs per call.",
            "items": {
              "description": "The id of the row. The id of a row is unique inside a base and is often used to identify one specific row.",
              "pattern": "^[A-Za-z0-9\\-\\_]{22}$",
              "type": "string"
            },
            "maxItems": 10000,
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/seatable/delete-row",
      "result_str_template": "Delete row completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "Response.",
            "properties": {
              "deleted_rows": {
                "description": "Number of rows that were deleted. Row IDs that do not exist are ignored.",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
