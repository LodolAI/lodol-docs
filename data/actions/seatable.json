{
  "actions": {
    "append_rows": {
      "description": "Add up to 1,000 new rows to a table by its name, optionally filling empty cells with the columns' default values. Returns how many rows were inserted.",
      "display_name": "Append rows",
      "display_str_template": "Append rows.",
      "handler": "actions.append_rows",
      "id": "seatable_append_rows",
      "method": "POST",
      "mock_response": {
        "data": {
          "first_row": {},
          "inserted_row_count": 1,
          "row_ids": []
        }
      },
      "name": "append_rows",
      "output_formatter": "_specs.<locals>.<lambda>",
      "parameters": [
        {
          "description": "The name of the table to perform the operation on. Alternatively, you can use the `table_id` instead of `table_name`. If using `table_id`, ensure that the key in the request body is replaced accordingly.",
          "display_name": "Table name",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "name": "table_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Defines the rows which should be added. Maximum 1,000 rows per call.",
          "display_name": "Rows",
          "name": "rows",
          "required": true,
          "schema": {
            "description": "Defines the rows which should be added. Maximum 1,000 rows per call.",
            "items": {
              "description": "Pass the set of column names and their values. The column names must be present in your table. Different column types require different ways to input values. For eg:\n{\"Name\":\"Max\", \"Age\":\"21\", \"Birthday\":\"2023-02-18\", \"Checkbox\":\"true\"}\n",
              "title": "Row",
              "type": "object"
            },
            "maxItems": 1000,
            "title": "Row Object X",
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Use the column default values to populate new rows during creation. False by default.",
          "display_name": "Apply default",
          "name": "apply_default",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/seatable/append-rows",
      "result_str_template": "Append rows completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "Response.",
            "properties": {
              "first_row": {
                "description": "First row.",
                "type": "object"
              },
              "inserted_row_count": {
                "description": "Inserted row count.",
                "type": "integer"
              },
              "row_ids": {
                "description": "Row ids.",
                "items": {
                  "description": "One returned record.",
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
