          },
          "size": {
            "description": "Its size in bytes",
            "type": "number"
          },
          "text": {
            "description": "What it says, for a text file of 1 MB or less; otherwise empty",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
