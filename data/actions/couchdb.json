        "file_name": "notes.txt",
        "id": "order-1042",
        "size": 27,
        "text": "Leave the parcel at the door"
      },
      "name": "get_attachment",
      "output_formatter": "actions.format_attachment",
      "parameters": [
        {
          "description": "The database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The document it's attached to, such as order-1042.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
