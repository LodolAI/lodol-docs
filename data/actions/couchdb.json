{
  "actions": {
    "add_attachment": {
      "description": "Attach a file to a document, such as a PDF invoice from an email, or save text as a file on it. A file of the same name is replaced.",
      "display_name": "Add attachment",
      "display_str_template": "Attach a file to document {1} in CouchDB database {0}.",
      "handler": "actions.add_attachment",
      "id": "couchdb_add_attachment",
      "method": "POST",
      "mock_response": {
        "content_type": "application/pdf",
        "database": "orders",
        "file_name": "invoice-1042.pdf",
        "id": "order-1042",
        "rev": "2-b2a3157bd333dbfd109654c7a2cce380",
        "size": 48213
      },
      "name": "add_attachment",
      "output_formatter": "actions.format_attached",
      "parameters": [
        {
          "description": "The database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The document to attach it to, such as order-1042.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "autofill_name_param": "file_name",
          "description": "The file: upload one, pick a file from an earlier step, or paste a link to one. Use this or Text.",
          "display_name": "File",
          "name": "file",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Words to save as the file, such as notes or a CSV. Use this or File, and give a file name.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to call it, such as invoice-1042.pdf. Leave blank to keep the file's own name.",
          "display_name": "File name",
          "name": "file_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/couchdb/add-attachment",
      "result_str_template": "Attached {couchdb_add_attachment,file_name}.",
      "returns": {
        "properties": {
          "content_type": {
            "description": "Its type, such as application/pdf",
            "type": "string"
          },
          "database": {
            "description": "The database, such as orders",
            "type": "string"
          },
          "file_name": {
            "description": "The attachment's name",
            "type": "string"
          },
          "id": {
            "description": "The document's ID",
            "type": "string"
          },
          "rev": {
            "description": "The document's revision now",
            "type": "string"
          },
          "size": {
            "description": "Its size in bytes",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
    "create_database": {
      "description": "Create a database, such as one per customer or per year. Only a server admin can. One of that name already there is reported, not an error.",
      "display_name": "Create database",
      "display_str_template": "Create CouchDB database {0}.",
      "handler": "actions.create_database",
      "id": "couchdb_create_database",
      "method": "POST",
      "mock_response": {
        "created": true,
        "name": "orders_2026"
      },
      "name": "create_database",
      "output_formatter": "actions.format_created_database",
      "parameters": [
        {
          "description": "The new database's name: lowercase letters, digits and _ - + $ ( ) /, starting with a letter, such as orders_2026.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/couchdb/create-database",
      "result_str_template": "Database {couchdb_create_database,name} is ready.",
      "returns": {
        "properties": {
          "created": {
            "description": "False when a database of that name was already there",
            "type": "boolean"
          },
          "name": {
            "description": "The database's name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_document": {
      "description": "Create a document from a form, a webhook or another app: its fields, or the whole document as JSON, with the ID you give or a new random one.",
      "display_name": "Create document",
      "display_str_template": "Create a document in CouchDB database {0}.",
      "handler": "actions.create_document",
      "id": "couchdb_create_document",
      "method": "POST",
      "mock_response": {
        "database": "orders",
        "document": {
          "_id": "order-1042",
          "_rev": "1-967a00dff5e02add41819138abb3284d",
          "customer": "Acme Ltd",
          "status": "paid",
          "total": 120.5,
          "type": "order"
        },
        "id": "order-1042",
        "rev": "1-967a00dff5e02add41819138abb3284d"
      },
      "name": "create_document",
      "output_formatter": "actions.format_created",
      "parameters": [
        {
          "description": "The database to add it to.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The document's fields by name, such as status paid and customer Acme Ltd. Values typed here are text; a value from an earlier step keeps its type.",
          "display_name": "Fields",
          "name": "fields",
          "object_key_name": "Field",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The document as JSON, such as {\"status\": \"paid\", \"total\": 42, \"items\": [...]}, for numbers, lists and nested fields. Fields given in Fields win over these.",
          "display_name": "Document (JSON)",
          "multiline": true,
          "name": "document_json",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The new document's ID, such as order-1042. Leave blank for a random one.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/couchdb/create-document",
      "result_str_template": "Created document {couchdb_create_document,id}.",
      "returns": {
        "properties": {
          "database": {
            "description": "The database, such as orders",
            "type": "string"
          },
          "document": {
            "description": "The document: its fields by name, with _id (its ID) and _rev (its revision)",
            "type": "object"
          },
          "id": {
            "description": "The document's ID",
            "type": "string"
          },
          "rev": {
            "description": "The document's revision now, such as 2-a1b2c3...",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_documents": {
      "description": "Create many documents at once, such as rows from a spreadsheet or records from another app. Each is created or fails on its own, and the result says which.",
      "display_name": "Create documents",
      "display_str_template": "Create documents in CouchDB database {0}.",
      "handler": "actions.create_documents",
      "id": "couchdb_create_documents",
      "method": "POST",
      "mock_response": {
        "created": 2,
        "database": "contacts",
        "failed": 0,
        "results": [
          {
            "error": "",
            "id": "contact-ada",
            "ok": true,
            "rev": "1-4c6114c65e295552ab1019e2b046b10e"
          },
          {
            "error": "",
            "id": "contact-grace",
            "ok": true,
            "rev": "1-0b2d1e3c4f5a6b7c8d9e0f1a2b3c4d5e"
          }
        ]
      },
      "name": "create_documents",
      "output_formatter": "actions.format_created_many",
      "parameters": [
        {
          "description": "The database to add them to.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A list of documents, from an earlier step or as JSON, such as [{\"name\": \"Ada\"}, {\"name\": \"Grace\"}]. Give one an _id to choose its ID. Up to 1000.",
          "display_name": "Documents",
          "name": "documents",
          "required": true,
          "schema": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/couchdb/create-documents",
      "result_str_template": "Created {couchdb_create_documents,created} documents.",
      "returns": {
        "properties": {
          "created": {
            "description": "How many documents were created",
            "type": "number"
          },
          "database": {
            "description": "The database, such as orders",
            "type": "string"
          },
          "failed": {
            "description": "How many weren't, such as for an ID already taken",
            "type": "number"
          },
          "results": {
            "description": "One result per document, in the order given",
            "items": {
              "properties": {
                "error": {
                  "description": "Why it wasn't created, such as a conflict",
                  "type": "string"
                },
                "id": {
                  "description": "The document's ID",
                  "type": "string"
                },
                "ok": {
                  "description": "Whether it was created",
                  "type": "boolean"
                },
                "rev": {
                  "description": "Its revision, when created",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_database": {
      "description": "Delete a database and every document in it. This can't be undone. Only a server admin can.",
      "display_name": "Delete database",
      "display_str_template": "Delete CouchDB database {0}.",
      "handler": "actions.delete_database",
      "id": "couchdb_delete_database",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "name": "orders_2025"
      },
      "name": "delete_database",
      "output_formatter": "actions.format_deleted_database",
      "parameters": [
        {
          "description": "The database to delete.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/couchdb/delete-database",
      "result_str_template": "Database {couchdb_delete_database,name} deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True once deleted; false when there was no such database",
            "type": "boolean"
          },
          "name": {
            "description": "The database's name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "delete_document": {
      "description": "Delete a document by its ID. One that isn't there is left alone and reported, not an error.",
      "display_name": "Delete document",
      "display_str_template": "Delete document {1} from CouchDB database {0}.",
      "handler": "actions.delete_document",
      "id": "couchdb_delete_document",
      "method": "POST",
      "mock_response": {
        "database": "orders",
        "deleted": true,
        "id": "order-1042",
        "rev": "3-f1e2d3c4b5a6978877665544332211aa"
      },
      "name": "delete_document",
      "output_formatter": "actions.format_deleted",
      "parameters": [
        {
          "description": "The database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The document's ID, such as order-1042.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only if the document is still at this revision (its _rev, such as 2-a1b2c3), so a change made since isn't lost. Leave blank for its newest.",
          "display_name": "Revision",
          "name": "revision",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/couchdb/delete-document",
      "result_str_template": "Deleted document {couchdb_delete_document,id}.",
      "returns": {
        "properties": {
          "database": {
            "description": "The database, such as orders",
            "type": "string"
          },
          "deleted": {
            "description": "True once deleted; false when there was no such document",
            "type": "boolean"
          },
          "id": {
            "description": "The document's ID",
            "type": "string"
          },
          "rev": {
            "description": "The revision that marks it deleted; empty when nothing was deleted",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "find_documents": {
      "description": "Find documents with a Mango query: fields equal to values, or a selector in JSON, with the fields, order and number you want, a page at a time.",
      "display_name": "Find documents",
      "display_str_template": "Find documents in CouchDB database {0}.",
      "handler": "actions.find_documents",
      "id": "couchdb_find_documents",
      "method": "POST",
      "mock_response": {
        "bookmark": "g1AAAABEeJzLYWBgYMpgSmHgKy5JLCrJTq2MT8lPzkzJBYpz5RelpBbpGhoYGIFUcMBU",
        "count": 1,
        "database": "orders",
        "documents": [
          {
            "_id": "order-1042",
            "_rev": "1-967a00dff5e02add41819138abb3284d",
            "customer": "Acme Ltd",
            "status": "paid",
            "total": 120.5,
            "type": "order"
          }
        ],
        "has_more": false,
        "warning": ""
      },
      "name": "find_documents",
      "output_formatter": "actions.format_found",
      "parameters": [
        {
          "description": "The database to search.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Fields that must equal these values, such as status paid and type order. Leave blank for every document.",
          "display_name": "Where",
          "name": "match",
          "object_key_name": "Field",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "A Mango selector, for more than equals, such as {\"total\": {\"$gt\": 100}, \"status\": {\"$in\": [\"paid\", \"shipped\"]}}.",
          "display_name": "Selector (JSON)",
          "multiline": true,
          "name": "selector",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only these fields, separated by commas, such as customer, total. Leave blank for whole documents.",
          "display_name": "Fields",
          "name": "fields",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Fields to sort by, with desc for newest or largest first, such as created_at desc. CouchDB needs an index on them.",
          "display_name": "Sort by",
          "name": "sort",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most to return. Defaults to 25, up to 1000.",
          "display_name": "How many",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The bookmark an earlier search returned, to get its next page.",
          "display_name": "Bookmark",
          "name": "bookmark",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/couchdb/find-documents",
      "result_str_template": "Found {couchdb_find_documents,count} documents.",
      "returns": {
        "properties": {
          "bookmark": {
            "description": "Pass this as Bookmark to get the next page",
            "type": "string"
          },
          "count": {
            "description": "How many came back",
            "type": "number"
          },
          "database": {
            "description": "The database, such as orders",
            "type": "string"
          },
          "documents": {
            "description": "The documents found, each with _id and its fields (only the fields asked for, when Fields is set)",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "description": "Whether there may be more: pass the bookmark for the next page",
            "type": "boolean"
          },
          "warning": {
            "description": "CouchDB's note, such as that no index matched; usually empty",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_attachment": {
      "description": "Download a file attached to a document, to send or save in a later step. A text file of 1 MB or less is also given as text.",
      "display_name": "Get attachment",
      "display_str_template": "Download {2} from document {1} in CouchDB.",
      "handler": "actions.get_attachment",
      "id": "couchdb_get_attachment",
      "method": "POST",
      "mock_response": {
