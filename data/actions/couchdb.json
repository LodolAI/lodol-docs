    "get_document": {
      "description": "Get a document's fields by its ID, with the files attached to it. A document that isn't there comes back with found false, so a workflow can check.",
      "display_name": "Get document",
      "display_str_template": "Get document {1} from CouchDB database {0}.",
      "handler": "actions.get_document",
      "id": "couchdb_get_document",
      "method": "POST",
      "mock_response": {
        "attachments": [
          {
            "content_type": "application/pdf",
            "name": "invoice.pdf",
            "size": 48213
          }
        ],
        "database": "orders",
        "document": {
          "_id": "order-1042",
          "_rev": "1-967a00dff5e02add41819138abb3284d",
          "customer": "Acme Ltd",
          "status": "paid",
          "total": 120.5,
          "type": "order"
        },
        "found": true,
        "id": "order-1042",
        "rev": "1-967a00dff5e02add41819138abb3284d"
      },
      "name": "get_document",
      "output_formatter": "actions.format_document",
      "parameters": [
        {
          "description": "The database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The document's ID, such as order-1042.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
