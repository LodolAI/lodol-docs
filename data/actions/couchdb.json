    "query_view": {
      "description": "Read a view a design document defines: its rows for a key or a range of keys, with their documents, or its totals for each key or for everything.",
      "display_name": "Query view",
      "display_str_template": "Query view {2} in CouchDB database {0}.",
      "handler": "actions.query_view",
      "id": "couchdb_query_view",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "database": "orders",
        "design_document": "reports",
        "has_more": false,
        "rows": [
          {
            "doc": null,
            "id": "order-1001",
            "key": "paid",
            "value": 120.5
          },
          {
            "doc": null,
            "id": "order-1004",
            "key": "paid",
            "value": 42.25
          }
        ],
        "total_rows": 6,
        "view": "by_status"
      },
      "name": "query_view",
      "output_formatter": "actions.format_view",
      "parameters": [
        {
          "description": "The database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The design document that holds the view.",
          "display_name": "Design document",
          "dynamic_source": "design_documents",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database"
          ],
          "name": "design_document",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The view.",
          "display_name": "View",
          "dynamic_source": "views",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database",
            "design_document"
          ],
          "name": "view",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only rows with this key, such as paid, 42 or [\"Acme Ltd\", 2026]. Quote text that looks like a number (\"42\").",
          "display_name": "Key",
          "name": "key",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Rows from this key on, such as 2026-01-01.",
          "display_name": "From key",
          "name": "start_key",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Rows up to and including this key, such as 2026-12-31.",
          "display_name": "To key",
          "name": "end_key",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "rows",
          "description": "List the rows, or total them with the view's reduce function.",
          "display_name": "Reduce",
          "name": "reduce",
          "options": [
            {
              "label": "List the rows (don't reduce)",
              "value": "rows"
            },
            {
              "label": "One total for each key",
              "value": "group"
            },
            {
              "label": "One total for every row",
              "value": "total"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "For keys that are lists, total by their first few items, such as 1 for [customer, date] keys to total by customer.",
          "display_name": "Group level",
          "maximum": 100,
          "minimum": 1,
          "name": "group_level",
          "required": false,
          "type": "ParameterType.NUMBER",
          "visible_when": {
            "reduce": [
              "group"
            ]
          }
        },
        {
          "default": false,
          "description": "Also return each row's whole document.",
          "display_name": "Include documents",
          "name": "include_docs",
          "required": false,
          "type": "ParameterType.BOOLEAN",
          "visible_when": {
            "reduce": [
              "rows"
            ]
          }
        },
        {
          "default": false,
          "description": "Return rows from the highest key down. From key is then the higher key.",
          "display_name": "Newest first",
          "name": "descending",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "The most to return. Defaults to 25, up to 1000.",
          "display_name": "How many",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/couchdb/query-view",
      "result_str_template": "Got {couchdb_query_view,count} rows.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many rows came back",
            "type": "number"
          },
          "database": {
            "description": "The database, such as orders",
            "type": "string"
          },
          "design_document": {
            "description": "The design document, without _design/",
            "type": "string"
          },
          "has_more": {
            "description": "Whether there are more rows than the most asked for",
            "type": "boolean"
          },
          "rows": {
            "description": "The rows: each key and value, the document's ID (not when reduced), and the document when Include documents is on",
            "items": {
              "properties": {
                "doc": {
                  "description": "The document, when Include documents is on; otherwise null",
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "id": {
                  "description": "The ID of the document the row came from; empty when reduced",
                  "type": "string"
                },
                "key": {
                  "description": "The row's key, such as paid or [\"Acme\", 2026]",
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "object",
                    "null"
                  ]
                },
                "value": {
                  "description": "The row's value, or the total when reduced",
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "object",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total_rows": {
            "description": "How many rows the whole view has (not when reduced)",
            "type": "number"
          },
          "view": {
            "description": "The view",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "update_document": {
      "description": "Change a document: merge the fields given into its newest revision, keeping the rest, or replace it. If it changes while saving, Lodol reads it again and saves once more.",
      "display_name": "Update document",
      "display_str_template": "Update document {1} in CouchDB database {0}.",
      "handler": "actions.update_document",
      "id": "couchdb_update_document",
      "method": "POST",
      "mock_response": {
        "created": false,
        "database": "orders",
        "document": {
          "_id": "order-1042",
          "_rev": "2-7051cbe5c8faecd085a3fa619e6e6337",
          "customer": "Acme Ltd",
          "status": "shipped",
          "total": 120.5,
          "type": "order"
        },
        "id": "order-1042",
        "previous_rev": "1-967a00dff5e02add41819138abb3284d",
        "retried": false,
        "rev": "2-7051cbe5c8faecd085a3fa619e6e6337"
      },
      "name": "update_document",
      "output_formatter": "actions.format_updated",
      "parameters": [
        {
          "description": "The database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The document's ID, such as order-1042.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The document's fields by name, such as status paid and customer Acme Ltd. Values typed here are text; a value from an earlier step keeps its type.",
          "display_name": "Fields",
          "name": "fields",
          "object_key_name": "Field",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The document as JSON, such as {\"status\": \"paid\", \"total\": 42, \"items\": [...]}, for numbers, lists and nested fields. Fields given in Fields win over these.",
          "display_name": "Document (JSON)",
          "multiline": true,
          "name": "document_json",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "merge",
          "description": "Merge changes only the fields given (a field holding an object is replaced whole). Replace makes the fields given the whole document, keeping its attachments.",
          "display_name": "How",
          "name": "mode",
          "options": [
            {
              "label": "Merge: change the fields given, keep the rest",
              "value": "merge"
            },
            {
              "label": "Replace: the fields given become the whole document",
              "value": "replace"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Create the document with this ID when there isn't one, such as to keep a copy of another app's records in sync.",
          "display_name": "Create if missing",
          "name": "create_if_missing",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Only if the document is still at this revision (its _rev, such as 2-a1b2c3), so a change made since isn't lost. Leave blank for its newest.",
          "display_name": "Revision",
          "name": "revision",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/couchdb/update-document",
      "result_str_template": "Saved document {couchdb_update_document,id}.",
      "returns": {
        "properties": {
          "created": {
            "description": "True when there was no document, and it was created",
            "type": "boolean"
          },
          "database": {
            "description": "The database, such as orders",
            "type": "string"
          },
          "document": {
            "description": "The document as saved, with _id and _rev",
            "type": "object"
          },
          "id": {
            "description": "The document's ID",
            "type": "string"
          },
          "previous_rev": {
            "description": "The revision it replaced; empty when it was created",
            "type": "string"
          },
          "retried": {
            "description": "True when it changed while saving, so it was read again and saved once more",
            "type": "boolean"
          },
          "rev": {
            "description": "The document's revision now, such as 2-a1b2c3...",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write",
        "modify"
      ]
    }
  },
  "categories": [
    "Databases"
  ],
  "description": "Create, read, update and delete documents in Apache CouchDB from workflows, find them with Mango queries, query views, attach files and manage databases. Start a workflow when a document is created, changed or deleted.",
  "display_name": "Apache CouchDB",
  "id": "couchdb",
  "logo": "https://www.lodol.com/app-icons/couchdb-icon.svg",
  "triggers": {
    "couchdb_document_changed_trigger": {
      "description": "Runs when a document in a database is updated, with its fields as they are now, once for all the changes made between two looks. A document created and edited between two looks starts this, not New document.",
      "display_name": "Document changed",
      "id": "couchdb_document_changed_trigger",
      "output": {
        "database": "string",
        "document": "object",
        "document_id": "string",
        "revision": "string",
        "seq": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The database to watch.",
          "display_name": "Database",
          "name": "database",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "Fields to match, such as type=order, status=paid, or a Mango selector in JSON, such as {\"total\": {\"$gt\": 100}}. Leave blank for every document.",
          "display_name": "Only documents where",
          "name": "match",
          "required": false
        }
      ]
    },
    "couchdb_document_deleted_trigger": {
      "description": "Runs when a document is deleted from a database, with its ID. Its fields are gone by then.",
      "display_name": "Document deleted",
      "id": "couchdb_document_deleted_trigger",
      "output": {
        "database": "string",
        "document_id": "string",
        "revision": "string",
        "seq": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The database to watch.",
          "display_name": "Database",
          "name": "database",
          "required": true
        }
      ]
    },
    "couchdb_new_document_trigger": {
      "description": "Runs when a document is created in a database, with its fields, or only documents whose fields match. Documents already there when the workflow is turned on don't start it.",
      "display_name": "New document",
      "id": "couchdb_new_document_trigger",
      "output": {
        "database": "string",
        "document": "object",
        "document_id": "string",
        "revision": "string",
        "seq": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The database to watch.",
          "display_name": "Database",
          "name": "database",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "Fields to match, such as type=order, status=paid, or a Mango selector in JSON, such as {\"total\": {\"$gt\": 100}}. Leave blank for every document.",
          "display_name": "Only documents where",
          "name": "match",
          "required": false
        }
      ]
    }
  }
