  "description": "Look up domains, check availability and manage domain settings.",
  "display_name": "Dynadot",
  "id": "dynadot",
  "logo": "https://www.lodol.com/app-icons/dynadot-icon.svg",
  "triggers": {
    "dynadot_new_domain_trigger": {
      "description": "Runs for each new domain in Dynadot. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New domain",
      "id": "dynadot_new_domain_trigger",
      "output": {
        "record": "object with the fields Name, Expiration, Registration, Locked, Status, RenewOption, Note"
      },
      "parameters": []
    },
    "dynadot_renewal_changed_trigger": {
      "description": "Runs each time a domain renewal changes in Dynadot. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Domain renewal changed",
      "id": "dynadot_renewal_changed_trigger",
      "output": {
        "record": "object with the fields Name, Expiration, Registration, Locked, Status, RenewOption, Note"
      },
      "parameters": []
    }
  }
