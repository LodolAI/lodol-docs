    "list_subscriptions": {
      "description": "List subscriptions in your Chargebee site, one page at a time, optionally filtered by customer ID and/or status. Returns a 'list' of subscription records with a 'next_offset' cursor for paging. Useful for monitoring active subscriptions, spotting cancellations, or auditing a customer's plans. Beta: 'Cancels within days' lists only subscriptions due to cancel soon, soonest first; 'Get every page' reads all pages in one step; and each entry has ready-to-read customer_name, customer_email, plan, mrr_display and cancel_date_display for a table or email.",
      "display_name": "List subscriptions",
      "display_str_template": "List subscriptions.",
      "handler": "actions.list_subscriptions",
      "id": "chargebee_list_subscriptions",
      "method": "POST",
