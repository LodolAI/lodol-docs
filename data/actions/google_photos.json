  "categories": [
    "Images & Design",
    "File Storage",
    "Google"
  ],
  "description": "Manage app-created albums and media, upload photos, and let people pick existing photos.",
  "display_name": "Google Photos",
  "id": "google_photos",
  "logo": "https://www.lodol.com/app-icons/google-photos-icon.png",
  "triggers": {
    "google_photos_new_album_trigger": {
      "description": "Runs for each new app-created album in Google Photos. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New app-created album",
      "id": "google_photos_new_album_trigger",
      "output": {
        "record": "object with the fields id, title, productUrl, mediaItemsCount, coverPhotoBaseUrl, coverPhotoMediaItemId"
      },
      "parameters": []
    },
    "google_photos_new_media_trigger": {
      "description": "Runs for each new app-created media in Google Photos. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New app-created media",
      "id": "google_photos_new_media_trigger",
      "output": {
        "record": "object with the fields id, description, productUrl, baseUrl, mimeType, filename, mediaMetadata.creationTime, mediaMetadata.width, mediaMetadata.height"
      },
      "parameters": []
    },
    "google_photos_new_or_updated_album_trigger": {
      "description": "Runs for each app-created album added or changed in Google Photos. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated app-created album",
      "id": "google_photos_new_or_updated_album_trigger",
      "output": {
        "record": "object with the fields id, title, productUrl, mediaItemsCount, coverPhotoBaseUrl, coverPhotoMediaItemId"
      },
      "parameters": []
    },
    "google_photos_new_or_updated_media_trigger": {
      "description": "Runs for each app-created media added or changed in Google Photos. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated app-created media",
      "id": "google_photos_new_or_updated_media_trigger",
      "output": {
        "record": "object with the fields id, description, productUrl, baseUrl, mimeType, filename, mediaMetadata.creationTime, mediaMetadata.width, mediaMetadata.height"
      },
      "parameters": []
    }
  }
