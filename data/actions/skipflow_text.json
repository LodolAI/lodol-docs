        {
          "description": "",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "",
          "display_name": "Ends with",
          "name": "suffix",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Match upper- and lower-case letters exactly (the default). Turn this off to treat them as the same.",
          "display_name": "Case sensitivity",
          "name": "case_sensitive",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "",
      "result_str_template": "{endswith,result}"
    },
    "extract": {
      "description": "Pull matches out of text: an email address, web address, number, or your own pattern.",
      "display_name": "Extract from text",
      "display_str_template": "Extract the {1} from {0}",
      "handler": "extract",
      "id": "skipflow_text_extract",
      "method": "POST",
      "name": "extract",
