        {
          "description": "",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "email",
          "description": "What to pull out of the text.",
          "display_name": "Extract",
          "name": "type",
          "options": [
            {
              "label": "Email address",
              "value": "email"
            },
            {
              "label": "Web address",
              "value": "url"
            },
            {
              "label": "Number",
              "value": "number"
            },
            {
              "label": "Custom pattern",
              "value": "pattern"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A regular expression to search for. Used only when Extract is set to Custom pattern.",
          "display_name": "Custom pattern",
          "name": "pattern",
          "required": false,
          "type": "ParameterType.STRING"
