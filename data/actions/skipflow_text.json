    "match_keywords": {
      "description": "Score text against your keyword lists to see how well it matches. Useful for tagging, filtering, or deciding what should happen next.",
      "display_name": "Match keywords",
      "display_str_template": "Match keywords in {0}",
      "handler": "match_keywords",
      "id": "skipflow_text_match_keywords",
      "method": "POST",
      "name": "match_keywords",
      "parameters": [
        {
          "description": "",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Most important words or phrases. Each match adds 3 points.",
          "display_name": "Strong keywords",
          "examples": [
            {
              "label": "Hiring intent",
              "value": "[\"we're hiring\", \"open role\", \"#hiring\"]"
            }
          ],
          "name": "strong_terms",
          "required": true,
          "type": "ParameterType.ARRAY"
        },
        {
          "default": [],
          "description": "Fairly important words or phrases. Each match adds 2 points.",
          "display_name": "Medium keywords",
          "examples": [
            {
              "label": "Hiring intent",
              "value": "[\"recruiting\", \"join our team\"]"
            }
          ],
          "name": "medium_terms",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "default": [],
          "description": "Minor words or phrases. Each match adds 1 point.",
          "display_name": "Weak keywords",
          "examples": [
            {
              "label": "Hiring intent",
              "value": "[\"growing\", \"team\", \"careers\"]"
            }
          ],
          "name": "weak_terms",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "default": 3,
          "description": "Total points needed to count as a match. Defaults to 3.",
          "display_name": "Score needed to pass",
          "name": "threshold",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "",
      "result_str_template": "Match: {match_keywords,is_match}\nScore: {match_keywords,score}\nMatched: {match_keywords,matched_terms}"
    },
