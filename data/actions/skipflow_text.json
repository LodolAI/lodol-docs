    "truncate": {
      "description": "Shorten text so it fits within a set number of characters. By default no ending is added; set an ending like \u201c\u2026\u201d to append one when text is cut. The ending counts toward the limit, so the result never exceeds it.",
      "display_name": "Shorten text",
      "display_str_template": "Shorten {0} to {1} characters",
      "handler": "truncate_text",
      "id": "skipflow_text_truncate",
      "method": "POST",
      "name": "truncate",
      "parameters": [
        {
          "description": "",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Text longer than this is shortened.",
          "display_name": "Maximum characters",
          "name": "length",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": "",
          "description": "Optional ending added when text is shortened, e.g. \u201c\u2026\u201d, counted within the character limit. Leave blank (the default) to shorten without any ending.",
          "display_name": "Ending",
          "name": "ellipsis",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Keep whole words instead of cutting one in the middle. When on, the text is shortened at a word boundary, so the result may come out a little shorter than the limit.",
          "display_name": "Whole words",
          "name": "dont_split_words",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
