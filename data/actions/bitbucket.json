{
  "actions": {
    "create_branch": {
      "description": "Create a new branch in a repository. Points the new branch at the tip of an existing branch (defaults to the repository's main branch) unless you supply a specific commit hash.",
      "display_name": "Create branch",
      "display_str_template": "Create branch {2} in {0}/{1}.",
      "handler": "actions.create_branch",
      "id": "bitbucket_create_branch",
      "method": "POST",
      "mock_response": {
        "hash": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0",
        "html_url": "https://bitbucket.org/my-team/hello-world/branch/feature/new-widget",
        "name": "feature/new-widget"
      },
      "name": "create_branch",
      "parameters": [
        {
          "description": "The workspace that owns the repository (the part before the '/' in 'workspace/repository'), visible in any repository's URL at bitbucket.org/<workspace>/<repository>.",
          "display_name": "Workspace",
          "examples": [
            {
              "label": "Example workspace",
              "value": "my-team"
            }
          ],
          "name": "workspace",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The repository to act on (the part after the '/' in 'workspace/repository').",
          "display_name": "Repository",
          "dynamic_source": "repositories",
          "dynamic_source_depends_on": [
            "workspace"
          ],
          "examples": [
            {
              "label": "Example repository",
              "value": "my-repo"
            }
          ],
          "name": "repo_slug",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name for the new branch (without any 'refs/heads/' prefix).",
          "display_name": "New branch name",
          "examples": [
            {
              "label": "Example branch",
              "value": "feature/new-widget"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The existing branch to base the new one on. Defaults to the repository's main branch when not set.",
          "display_name": "Source branch",
          "dynamic_source": "branches",
          "dynamic_source_depends_on": [
            "workspace",
            "repo_slug"
          ],
          "name": "from_branch",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A specific commit hash to point the new branch at. Takes precedence over the source branch when provided.",
          "display_name": "Source commit hash",
          "name": "commit_hash",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/bitbucket/create-branch",
      "result_str_template": "Created branch {0}.",
      "returns": {
        "properties": {
          "hash": {
            "type": "string"
          },
          "html_url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_branch": {
      "description": "Delete a branch from a repository.",
      "display_name": "Delete branch",
      "display_str_template": "Delete branch {2} in {0}/{1}.",
      "handler": "actions.delete_branch",
      "id": "bitbucket_delete_branch",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "name": "feature/old-widget"
      },
      "name": "delete_branch",
      "parameters": [
        {
          "description": "The workspace that owns the repository (the part before the '/' in 'workspace/repository'), visible in any repository's URL at bitbucket.org/<workspace>/<repository>.",
          "display_name": "Workspace",
          "examples": [
            {
              "label": "Example workspace",
              "value": "my-team"
            }
          ],
          "name": "workspace",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The repository to act on (the part after the '/' in 'workspace/repository').",
          "display_name": "Repository",
          "dynamic_source": "repositories",
          "dynamic_source_depends_on": [
            "workspace"
          ],
          "examples": [
            {
              "label": "Example repository",
              "value": "my-repo"
            }
          ],
          "name": "repo_slug",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the branch to delete (without any 'refs/heads/' prefix).",
          "display_name": "Branch name",
          "dynamic_source": "branches",
          "dynamic_source_depends_on": [
            "workspace",
            "repo_slug"
          ],
          "examples": [
            {
              "label": "Example branch",
              "value": "feature/old-widget"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/bitbucket/delete-branch",
      "result_str_template": "Deleted branch {0}.",
      "returns": {
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
