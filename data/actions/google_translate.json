{
  "actions": {
    "detect_language": {
      "description": "Detect which language a piece of text is written in using Google Translate.",
      "display_name": "Detect language",
      "display_str_template": "Detect the language of the text.",
      "handler": "actions.detect_language",
      "id": "google_translate_detect_language",
      "method": "POST",
      "mock_response": {
        "confidence": 0.98,
        "is_reliable": true,
        "language": "es",
        "language_name": "Spanish"
      },
      "name": "detect_language",
      "output_formatter": "actions.format_detect_language_output",
      "parameters": [
        {
          "description": "The text whose language you want to detect.",
          "display_name": "Text",
          "examples": [
            {
              "label": "Spanish greeting",
              "value": "Hola, \u00bfc\u00f3mo est\u00e1s?"
            }
          ],
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-translate/detect-language",
      "result_str_template": "Detected the language of the text.",
      "returns": {
        "properties": {
          "confidence": {
            "description": "Google's confidence in the detection, from 0 to 1",
            "type": "number"
          },
          "is_reliable": {
            "description": "Whether Google considers the detection reliable",
            "type": "boolean"
          },
          "language": {
            "description": "The detected language as a Google Translate language code (e.g. 'es')",
            "type": "string"
          },
          "language_name": {
            "description": "The friendly name of the detected language (e.g. 'Spanish')",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
