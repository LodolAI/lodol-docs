{
  "actions": {
    "add_comment": {
      "description": "Post a comment at the bottom of a Confluence page.",
      "display_name": "Comment on a page",
      "display_str_template": "Comment on {page_id}: '{body}'.",
      "handler": "actions.add_comment",
      "id": "confluence_add_comment",
      "method": "POST",
      "mock_response": {
        "comment": {
          "id": "789012",
          "page_id": "123456",
          "url": "https://your-domain.atlassian.net/wiki/spaces/ENG/pages/123456?focusedCommentId=789012"
        }
      },
      "name": "add_comment",
      "parameters": [
        {
          "description": "The page's ID: the number after /pages/ in its address.",
          "display_name": "Page",
          "label_source": "page_names",
          "name": "page_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Text of the comment. Each line becomes a paragraph.",
          "display_name": "Comment text",
          "multiline": true,
          "name": "body",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/add-comment",
      "result_str_template": "Confluence comment added.",
      "returns": {
        "properties": {
          "comment": {
            "description": "The comment that was posted",
            "properties": {
              "id": {
                "description": "The comment's ID",
                "type": "string"
              },
              "page_id": {
                "description": "The ID of the page it is on",
                "type": "string"
              },
              "url": {
                "description": "Link that opens the comment",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_blog_post": {
      "description": "Publish a blog post in a Confluence space, with a title and text. Confluence tells the space's watchers, as it does for any post.",
      "display_name": "Create a blog post",
      "display_str_template": "Publish the blog post '{title}' in {space_key}.",
      "handler": "actions.create_blog_post",
      "id": "confluence_create_blog_post",
      "method": "POST",
      "mock_response": {
        "blog_post": {
          "id": "654321",
          "space_key": "ENG",
          "title": "Release notes",
          "url": "https://your-domain.atlassian.net/wiki/spaces/ENG/blog/2026/11/09/654321/Release+notes"
        }
      },
      "name": "create_blog_post",
      "parameters": [
        {
          "description": "The space to publish the blog post in.",
          "display_name": "Space",
          "dynamic_source": "spaces",
          "dynamic_source_allows_custom": true,
          "name": "space_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Title of the blog post.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The blog post's text. Each line becomes a paragraph; Markdown headings, bullets and tables become real ones (Beta).",
          "display_name": "Text",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/create-blog-post",
      "result_str_template": "Confluence blog post published.",
      "returns": {
        "properties": {
          "blog_post": {
            "description": "The published blog post",
            "properties": {
              "id": {
                "description": "The blog post's ID",
                "type": "string"
              },
              "space_key": {
                "description": "The key of the space it is in",
                "type": "string"
              },
              "title": {
                "description": "The blog post's title",
                "type": "string"
              },
              "url": {
                "description": "Link that opens the blog post",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_page": {
      "description": "Create a page in a Confluence space, with a title and text.",
      "display_name": "Create a page",
      "display_str_template": "Create the page '{title}' in {space_key}.",
      "handler": "actions.create_page",
      "id": "confluence_create_page",
      "method": "POST",
      "mock_response": {
        "page": {
          "id": "page123456",
          "url": "https://your-domain.atlassian.net/wiki/spaces/ENG/pages/page123456"
        }
      },
      "name": "create_page",
      "parameters": [
        {
          "description": "The space to create the page in.",
          "display_name": "Space",
          "dynamic_source": "spaces",
          "dynamic_source_allows_custom": true,
          "name": "space_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Title of the page.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The page's text. Each line becomes a paragraph. Beta: text written in Markdown (# headings, - bullets, **bold**, tables), as an AI step writes it, becomes real headings, lists and tables.",
          "display_name": "Text",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/create-page",
      "result_str_template": "Confluence page created.",
      "returns": {
        "properties": {
          "page": {
            "description": "Created page details",
            "properties": {
              "id": {
                "description": "Confluence page ID. Use this with get_page to look up the page",
                "type": "string"
              },
              "url": {
                "description": "Full URL of the created page",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_blog_post": {
      "description": "Move a Confluence blog post to its space's trash, where a space admin can restore it.",
      "display_name": "Delete a blog post",
      "display_str_template": "Delete the blog post {blog_post_id}.",
      "handler": "actions.delete_blog_post",
      "id": "confluence_delete_blog_post",
      "method": "POST",
      "mock_response": {
        "blog_post": {
          "deleted": true,
          "id": "654321"
        }
      },
      "name": "delete_blog_post",
      "parameters": [
        {
          "description": "The blog post's ID, as Create a blog post or Blog post published gave it.",
          "display_name": "Blog post",
          "name": "blog_post_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/delete-blog-post",
      "result_str_template": "Confluence blog post moved to the trash.",
      "returns": {
        "properties": {
          "blog_post": {
            "description": "The blog post moved to the trash",
            "properties": {
              "deleted": {
                "description": "True once it is in the trash",
                "type": "boolean"
              },
              "id": {
                "description": "The blog post's ID",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "get_page": {
      "description": "Look up a Confluence page's title and text.",
      "display_name": "Get a page",
      "display_str_template": "Get {page_id}.",
      "handler": "actions.get_page",
      "id": "confluence_get_page",
      "method": "POST",
      "mock_response": {
        "page": {
          "content": "<p>example_value</p>",
          "id": "page123456",
          "space_key": "ENG",
          "title": "example_value"
        }
      },
      "name": "get_page",
      "parameters": [
        {
          "description": "The page's ID: the number after /pages/ in its address.",
          "display_name": "Page",
          "label_source": "page_names",
          "name": "page_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/get-page",
      "result_str_template": "Got the Confluence page.",
      "returns": {
        "properties": {
          "page": {
            "description": "Page details",
            "properties": {
              "content": {
                "description": "Page body content in Confluence storage-format HTML",
                "type": "string"
              },
              "id": {
                "description": "Confluence page ID",
                "type": "string"
              },
              "space_key": {
                "description": "Key of the space the page belongs to",
                "type": "string"
              },
              "title": {
                "description": "Page title",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_spaces": {
      "description": "List the Confluence spaces your connected account can see.",
      "display_name": "List spaces",
      "display_str_template": "List your spaces.",
      "handler": "actions.list_spaces",
      "id": "confluence_list_spaces",
      "method": "POST",
      "mock_response": {
        "spaces": [
          {
            "id": "space123",
            "key": "ENG",
            "name": "Engineering",
            "type": "global"
          }
        ]
      },
      "name": "list_spaces",
      "parameters": [
        {
          "description": "The most spaces to return, from 1 to 100. Leave blank for 25.",
          "display_name": "Most to return",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/confluence/list-spaces",
      "result_str_template": "Listed your Confluence spaces.",
      "returns": {
        "properties": {
          "spaces": {
            "description": "List of Confluence spaces accessible to the authenticated user",
            "items": {
              "properties": {
                "id": {
                  "description": "Space ID",
                  "type": "string"
                },
                "key": {
                  "description": "Space key (e.g., 'ENG'). Use this to create pages.",
                  "type": "string"
                },
                "name": {
                  "description": "Space display name",
                  "type": "string"
                },
                "type": {
                  "description": "Space type, for example 'global' or 'personal'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "search_pages": {
      "description": "Find the Confluence pages that contain some text.",
      "display_name": "Find pages",
      "display_str_template": "Find pages matching '{text}'.",
      "handler": "actions.search_pages",
      "id": "confluence_search_pages",
      "method": "POST",
      "mock_response": {
        "pages": [
          {
            "id": "page123456",
            "space_key": "ENG",
            "title": "example_value"
          }
        ]
      },
      "name": "search_pages",
      "parameters": [
        {
          "description": "Words the pages contain, such as onboarding checklist.",
          "display_name": "Text to find",
          "name": "text",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only if Text to find isn't enough: a search in CQL, Confluence's search language, such as space = ENG ORDER BY created DESC. With Text to find, it narrows that search.",
          "display_name": "Advanced search",
          "name": "cql",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most pages to return, from 1 to 100. Leave blank for 10.",
          "display_name": "Most to return",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/confluence/search-pages",
      "result_str_template": "Found the matching Confluence pages.",
      "returns": {
        "properties": {
          "pages": {
            "description": "The pages that match. Give a page's id to Get a page to read its text",
            "items": {
              "properties": {
                "id": {
                  "description": "Confluence page ID",
                  "type": "string"
                },
                "space_key": {
                  "description": "Key of the space the page belongs to",
                  "type": "string"
                },
                "title": {
                  "description": "Page title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "update_page": {
      "description": "Change a Confluence page's title, replace its text, or add text to the end of it. Confluence keeps the earlier version in the page's history.",
      "display_name": "Update a page",
      "display_str_template": "Update {page_id}.",
      "handler": "actions.update_page",
      "id": "confluence_update_page",
      "method": "POST",
      "mock_response": {
        "page": {
          "id": "123456",
          "title": "Onboarding checklist",
          "url": "https://your-domain.atlassian.net/wiki/spaces/ENG/pages/123456/Onboarding+checklist",
          "version": 4
        }
      },
      "name": "update_page",
      "parameters": [
        {
          "description": "The page's ID: the number after /pages/ in its address.",
          "display_name": "Page",
          "label_source": "page_names",
          "name": "page_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The page's new title. Leave blank to keep it.",
          "display_name": "New title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Replaces all of the page's text. Each line becomes a paragraph; Markdown headings, bullets and tables become real ones (Beta). Leave blank to keep the text.",
          "display_name": "New text",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Added after the page's text, which stays as it is. Each line becomes a paragraph. Use this or New text, not both.",
          "display_name": "Text to add at the end",
          "multiline": true,
          "name": "append",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/update-page",
      "result_str_template": "Confluence page updated.",
      "returns": {
        "properties": {
          "page": {
            "description": "The updated page",
            "properties": {
              "id": {
                "description": "Confluence page ID",
                "type": "string"
              },
              "title": {
                "description": "The page's title after the change",
                "type": "string"
              },
              "url": {
                "description": "Link that opens the page",
                "type": "string"
              },
              "version": {
                "description": "The page's version number after the change",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    }
  },
  "categories": [
    "Documents"
  ],
  "description": "Create, read, update, comment on and find pages, and publish blog posts, in your Confluence spaces.",
  "display_name": "Confluence",
  "id": "confluence",
  "logo": "https://www.lodol.com/app-icons/confluence-icon.svg",
  "triggers": {
    "confluence_blog_post_published_trigger": {
      "description": "Runs when a blog post is published in Confluence, with its title, space, link and who wrote it. Posts already there when the workflow is turned on don't start it.",
      "display_name": "Blog post published",
      "id": "confluence_blog_post_published_trigger",
      "output": {
        "created": "When it was created.",
        "created_by": "Who created it: displayName, email, accountId.",
        "id": "The blog post's ID.",
        "space_key": "The key of the space it is in, such as ENG.",
        "space_name": "The name of the space it is in.",
        "title": "The blog post's title.",
        "url": "The blog post's address."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only run for blog posts in this space. Leave blank for every space the account can see.",
          "display_name": "Space",
          "name": "space",
          "required": false
        }
      ]
    },
    "confluence_new_page_trigger": {
      "description": "Runs when a page is created in Confluence, with its title, space, link and who made it. Pages already there when the workflow is turned on don't start it.",
      "display_name": "New page",
      "id": "confluence_new_page_trigger",
      "output": {
        "created": "When it was created.",
        "created_by": "Who created it: displayName, email, accountId.",
        "id": "The page's ID.",
        "space_key": "The key of the space it is in, such as ENG.",
        "space_name": "The name of the space it is in.",
        "title": "The page's title.",
        "url": "The page's address."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only run for pages in this space. Leave blank for every space the account can see.",
          "display_name": "Space",
          "name": "space",
          "required": false
        }
      ]
    }
  }
}
