{
  "actions": {
    "create_page": {
      "description": "Create a new page in a Confluence space with a title and body text.",
      "display_name": "Create a Confluence page",
      "display_str_template": "Create a Confluence page '{1}' in space '{0}'.",
      "handler": "actions.create_page",
      "id": "confluence_create_page",
      "method": "POST",
      "mock_response": {
        "page": {
          "id": "page123456",
          "url": "https://your-domain.atlassian.net/wiki/spaces/ENG/pages/page123456"
        }
      },
      "name": "create_page",
      "parameters": [
        {
          "description": "Key of the Confluence space to create the page in, for example ENG.",
          "display_name": "Space key",
          "name": "space_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Title of the page.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Body text of the page. Plain text is wrapped into paragraphs.",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/create-page",
      "result_str_template": "Confluence page created.",
      "returns": {
        "properties": {
          "page": {
            "description": "Created page details",
            "properties": {
              "id": {
                "description": "Confluence page ID. Use this with get_page to look up the page",
                "type": "string"
              },
              "url": {
                "description": "Full URL of the created page",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_page": {
      "description": "Look up a Confluence page's title and body content by its ID.",
      "display_name": "Get a Confluence page",
      "display_str_template": "Fetch Confluence page '{0}'.",
      "handler": "actions.get_page",
      "id": "confluence_get_page",
      "method": "POST",
      "mock_response": {
        "page": {
          "content": "<p>example_value</p>",
          "id": "page123456",
          "space_key": "ENG",
          "title": "example_value"
        }
      },
      "name": "get_page",
      "parameters": [
        {
          "description": "ID of the Confluence page to look up.",
          "display_name": "Page ID",
          "name": "page_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/get-page",
      "result_str_template": "Retrieved Confluence page details.",
      "returns": {
        "properties": {
          "page": {
            "description": "Page details",
            "properties": {
              "content": {
                "description": "Page body content in Confluence storage-format HTML",
                "type": "string"
              },
              "id": {
                "description": "Confluence page ID",
                "type": "string"
              },
              "space_key": {
                "description": "Key of the space the page belongs to",
                "type": "string"
              },
              "title": {
                "description": "Page title",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_spaces": {
      "description": "List the Confluence spaces your connected account can access.",
      "display_name": "List Confluence spaces",
      "display_str_template": "List available Confluence spaces.",
      "handler": "actions.list_spaces",
      "id": "confluence_list_spaces",
      "method": "POST",
      "mock_response": {
        "spaces": [
          {
            "id": "space123",
            "key": "ENG",
            "name": "Engineering",
            "type": "global"
          }
        ]
      },
      "name": "list_spaces",
      "parameters": [
        {
          "description": "Maximum number of spaces to return, from 1 to 100 (default 25).",
          "display_name": "Max results",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/confluence/list-spaces",
      "result_str_template": "Fetched Confluence spaces.",
      "returns": {
        "properties": {
          "spaces": {
            "description": "List of Confluence spaces accessible to the authenticated user",
            "items": {
              "properties": {
                "id": {
                  "description": "Space ID",
                  "type": "string"
                },
                "key": {
                  "description": "Space key (e.g., 'ENG'). Use this to create pages.",
                  "type": "string"
                },
                "name": {
                  "description": "Space display name",
                  "type": "string"
                },
                "type": {
                  "description": "Space type, for example 'global' or 'personal'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "search_pages": {
      "description": "Find Confluence pages using a Confluence search query (CQL).",
      "display_name": "Search Confluence pages",
      "display_str_template": "Search Confluence pages with query '{0}'.",
      "handler": "actions.search_pages",
      "id": "confluence_search_pages",
      "method": "POST",
      "mock_response": {
        "pages": [
          {
            "id": "page123456",
            "space_key": "ENG",
            "title": "example_value"
          }
        ]
      },
      "name": "search_pages",
      "parameters": [
        {
          "description": "What to search for, written as a Confluence query (CQL). For example: space = ENG AND type = page ORDER BY created DESC.",
          "display_name": "Search query (CQL)",
          "name": "cql",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of results to return, from 1 to 100.",
          "display_name": "Max results",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/confluence/search-pages",
      "result_str_template": "Confluence pages searched.",
      "returns": {
        "properties": {
          "pages": {
            "description": "Array of Confluence pages matching the search query. Use the id field with get_page to fetch full content",
            "items": {
              "properties": {
                "id": {
                  "description": "Confluence page ID",
                  "type": "string"
                },
                "space_key": {
                  "description": "Key of the space the page belongs to",
                  "type": "string"
                },
                "title": {
                  "description": "Page title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your Confluence account to browse spaces and create, read, and search pages.",
  "display_name": "Confluence",
  "id": "confluence"
}
