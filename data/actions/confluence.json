{
  "actions": {
    "create_page": {
      "description": "Create a page in a Confluence space, with a title and text.",
      "display_name": "Create a page",
      "display_str_template": "Create the page '{title}' in {space_key}.",
      "handler": "actions.create_page",
      "id": "confluence_create_page",
      "method": "POST",
      "mock_response": {
        "page": {
          "id": "page123456",
          "url": "https://your-domain.atlassian.net/wiki/spaces/ENG/pages/page123456"
        }
      },
      "name": "create_page",
      "parameters": [
        {
          "description": "The space to create the page in.",
          "display_name": "Space",
          "dynamic_source": "spaces",
          "dynamic_source_allows_custom": true,
          "name": "space_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Title of the page.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The page's text. Each line becomes a paragraph.",
          "display_name": "Text",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/create-page",
      "result_str_template": "Confluence page created.",
      "returns": {
        "properties": {
          "page": {
            "description": "Created page details",
            "properties": {
              "id": {
                "description": "Confluence page ID. Use this with get_page to look up the page",
                "type": "string"
              },
              "url": {
                "description": "Full URL of the created page",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "get_page": {
      "description": "Look up a Confluence page's title and text.",
      "display_name": "Get a page",
      "display_str_template": "Get {page_id}.",
      "handler": "actions.get_page",
      "id": "confluence_get_page",
      "method": "POST",
      "mock_response": {
        "page": {
          "content": "<p>example_value</p>",
          "id": "page123456",
          "space_key": "ENG",
          "title": "example_value"
        }
      },
      "name": "get_page",
      "parameters": [
        {
          "description": "The page's ID: the number after /pages/ in its address.",
          "display_name": "Page",
          "label_source": "page_names",
          "name": "page_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/confluence/get-page",
      "result_str_template": "Got the Confluence page.",
      "returns": {
        "properties": {
          "page": {
            "description": "Page details",
            "properties": {
              "content": {
                "description": "Page body content in Confluence storage-format HTML",
                "type": "string"
              },
              "id": {
                "description": "Confluence page ID",
                "type": "string"
              },
              "space_key": {
                "description": "Key of the space the page belongs to",
                "type": "string"
              },
              "title": {
                "description": "Page title",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_spaces": {
      "description": "List the Confluence spaces your connected account can see.",
      "display_name": "List spaces",
      "display_str_template": "List your spaces.",
      "handler": "actions.list_spaces",
      "id": "confluence_list_spaces",
      "method": "POST",
      "mock_response": {
        "spaces": [
          {
            "id": "space123",
            "key": "ENG",
            "name": "Engineering",
            "type": "global"
          }
        ]
      },
      "name": "list_spaces",
      "parameters": [
        {
          "description": "The most spaces to return, from 1 to 100. Leave blank for 25.",
          "display_name": "Most to return",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/confluence/list-spaces",
      "result_str_template": "Listed your Confluence spaces.",
      "returns": {
        "properties": {
          "spaces": {
            "description": "List of Confluence spaces accessible to the authenticated user",
            "items": {
              "properties": {
                "id": {
                  "description": "Space ID",
                  "type": "string"
                },
                "key": {
                  "description": "Space key (e.g., 'ENG'). Use this to create pages.",
                  "type": "string"
                },
                "name": {
                  "description": "Space display name",
                  "type": "string"
                },
                "type": {
                  "description": "Space type, for example 'global' or 'personal'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "search_pages": {
      "description": "Find the Confluence pages that contain some text.",
      "display_name": "Find pages",
      "display_str_template": "Find pages matching '{text}'.",
      "handler": "actions.search_pages",
      "id": "confluence_search_pages",
      "method": "POST",
      "mock_response": {
        "pages": [
          {
            "id": "page123456",
            "space_key": "ENG",
            "title": "example_value"
          }
        ]
      },
      "name": "search_pages",
      "parameters": [
        {
          "description": "Words the pages contain, such as onboarding checklist.",
          "display_name": "Text to find",
          "name": "text",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only if Text to find isn't enough: a search in CQL, Confluence's search language, such as space = ENG ORDER BY created DESC. With Text to find, it narrows that search.",
          "display_name": "Advanced search",
          "name": "cql",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most pages to return, from 1 to 100. Leave blank for 10.",
          "display_name": "Most to return",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/confluence/search-pages",
      "result_str_template": "Found the matching Confluence pages.",
      "returns": {
        "properties": {
          "pages": {
            "description": "The pages that match. Give a page's id to Get a page to read its text",
            "items": {
              "properties": {
                "id": {
                  "description": "Confluence page ID",
                  "type": "string"
                },
                "space_key": {
                  "description": "Key of the space the page belongs to",
                  "type": "string"
                },
                "title": {
                  "description": "Page title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    }
  },
  "categories": [
    "Documents"
  ],
  "description": "Create, read and find pages in your Confluence spaces.",
  "display_name": "Confluence",
  "id": "confluence",
  "logo": "https://www.lodol.com/app-icons/confluence-icon.svg",
  "triggers": {}
}
