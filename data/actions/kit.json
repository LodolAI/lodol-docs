{
  "actions": {
    "create_or_update_subscriber": {
      "description": "Add a subscriber to your Kit account, or update the existing subscriber if the email address is already in use.",
      "display_name": "Create or update subscriber",
      "display_str_template": "Create or update Kit subscriber '{0}'.",
      "handler": "actions.create_or_update_subscriber",
      "id": "kit_create_or_update_subscriber",
      "method": "POST",
      "mock_response": {
        "subscriber": {
          "created_at": "2024-10-01T12:00:00Z",
          "email_address": "jane@example.com",
          "fields": {},
          "first_name": "Jane",
          "id": "875403",
          "state": "active"
        }
      },
      "name": "create_or_update_subscriber",
      "parameters": [
        {
          "description": "Email address of the subscriber.",
          "display_name": "Email address",
          "examples": [
            {
              "label": "Email",
              "value": "jane@example.com"
            }
          ],
          "name": "email_address",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "First name of the subscriber.",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "active",
          "description": "State to create the subscriber in. Defaults to 'active'.",
          "display_name": "State",
          "name": "state",
          "options": [
            {
              "label": "Active",
              "value": "active"
            },
            {
              "label": "Inactive",
              "value": "inactive"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Custom field values, keyed by the field's label (e.g. {\"Last name\": \"Doe\"}). Each custom field must already exist on your Kit account.",
          "display_name": "Fields",
          "name": "fields",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/kit/create-or-update-subscriber",
      "result_str_template": "Saved Kit subscriber.",
      "returns": {
        "properties": {
          "subscriber": {
            "description": "The created or updated subscriber",
            "nullable": true,
            "properties": {
              "created_at": {
                "description": "When the subscriber was created (ISO 8601)",
                "type": "string"
              },
              "email_address": {
                "description": "Subscriber email address",
                "type": "string"
              },
              "fields": {
                "description": "Custom field values on the subscriber",
                "type": "object"
              },
              "first_name": {
                "description": "First name, if set",
                "type": "string"
              },
              "id": {
                "description": "Kit subscriber ID",
                "type": "string"
              },
              "state": {
                "description": "Subscriber state, e.g. 'active' or 'inactive'",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_tag": {
      "description": "Create a tag in your Kit account, or return the existing tag if one with the same name already exists.",
      "display_name": "Create tag",
      "display_str_template": "Create Kit tag '{0}'.",
      "handler": "actions.create_tag",
      "id": "kit_create_tag",
      "method": "POST",
      "mock_response": {
        "tag": {
          "created_at": "2024-10-01T12:00:00Z",
          "id": "99123",
          "name": "Newsletter Lead"
        }
      },
      "name": "create_tag",
      "parameters": [
        {
          "description": "Name of the tag to create.",
          "display_name": "Name",
          "examples": [
            {
              "label": "Tag name",
              "value": "Newsletter Lead"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/kit/create-tag",
      "result_str_template": "Created Kit tag.",
      "returns": {
        "properties": {
          "tag": {
            "description": "The created or existing tag",
            "properties": {
              "created_at": {
                "description": "When the tag was created (ISO 8601)",
                "type": "string"
              },
              "id": {
                "description": "Tag ID. Use with tag_subscriber.",
                "type": "string"
              },
              "name": {
                "description": "Tag name",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_subscriber": {
      "description": "Look up a Kit subscriber by email address.",
      "display_name": "Get subscriber",
      "display_str_template": "Get Kit subscriber '{0}'.",
      "handler": "actions.get_subscriber",
      "id": "kit_get_subscriber",
      "method": "POST",
      "mock_response": {
        "subscriber": {
          "created_at": "2024-10-01T12:00:00Z",
          "email_address": "jane@example.com",
          "fields": {},
          "first_name": "Jane",
          "id": "875403",
          "state": "active"
        }
      },
      "name": "get_subscriber",
      "parameters": [
        {
          "description": "Email address of the subscriber to look up.",
          "display_name": "Email address",
          "name": "email_address",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/kit/get-subscriber",
      "result_str_template": "Retrieved Kit subscriber.",
      "returns": {
        "properties": {
          "subscriber": {
            "description": "The matching subscriber, or null if no subscriber has that email address",
            "nullable": true,
            "properties": {
              "created_at": {
                "description": "When the subscriber was created (ISO 8601)",
                "type": "string"
              },
              "email_address": {
                "description": "Subscriber email address",
                "type": "string"
              },
              "fields": {
                "description": "Custom field values on the subscriber",
                "type": "object"
              },
              "first_name": {
                "description": "First name, if set",
                "type": "string"
              },
              "id": {
                "description": "Kit subscriber ID",
                "type": "string"
              },
              "state": {
                "description": "Subscriber state, e.g. 'active' or 'inactive'",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_tags": {
      "description": "List the tags in your Kit account.",
      "display_name": "List tags",
      "display_str_template": "List Kit tags.",
      "handler": "actions.list_tags",
      "id": "kit_list_tags",
      "method": "POST",
      "mock_response": {
        "tags": [
          {
            "created_at": "2024-10-01T12:00:00Z",
            "id": "99123",
            "name": "Newsletter Lead"
          }
        ]
      },
      "name": "list_tags",
      "parameters": [],
      "path": "/actions/library/kit/list-tags",
      "result_str_template": "Fetched Kit tags.",
      "returns": {
        "properties": {
          "tags": {
            "description": "Tags in the account",
            "items": {
              "properties": {
                "created_at": {
                  "description": "When the tag was created (ISO 8601)",
                  "type": "string"
                },
                "id": {
                  "description": "Tag ID. Use with tag_subscriber.",
                  "type": "string"
                },
                "name": {
                  "description": "Tag name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "tag_subscriber": {
      "description": "Apply a tag to a subscriber (by email address) to segment them and trigger any automations attached to the tag.",
      "display_name": "Tag a subscriber",
      "display_str_template": "Tag Kit subscriber '{1}' with tag '{0}'.",
      "handler": "actions.tag_subscriber",
      "id": "kit_tag_subscriber",
      "method": "POST",
      "mock_response": {
        "subscriber": {
          "created_at": "2024-10-01T12:00:00Z",
          "email_address": "jane@example.com",
          "fields": {},
          "first_name": "Jane",
          "id": "875403",
          "state": "active"
        },
        "tag_id": "99123"
      },
      "name": "tag_subscriber",
      "parameters": [
        {
          "description": "ID of the tag to apply.",
          "display_name": "Tag ID",
          "dynamic_source": "tags",
          "name": "tag_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email address of the subscriber to tag.",
          "display_name": "Email address",
          "name": "email_address",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/kit/tag-subscriber",
      "result_str_template": "Tagged Kit subscriber.",
      "returns": {
        "properties": {
          "subscriber": {
            "description": "The tagged subscriber",
            "nullable": true,
            "properties": {
              "created_at": {
                "description": "When the subscriber was created (ISO 8601)",
                "type": "string"
              },
              "email_address": {
                "description": "Subscriber email address",
                "type": "string"
              },
              "fields": {
                "description": "Custom field values on the subscriber",
                "type": "object"
              },
              "first_name": {
                "description": "First name, if set",
                "type": "string"
              },
              "id": {
                "description": "Kit subscriber ID",
                "type": "string"
              },
              "state": {
                "description": "Subscriber state, e.g. 'active' or 'inactive'",
                "type": "string"
              }
            },
            "type": "object"
          },
          "tag_id": {
            "description": "ID of the tag that was applied",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your Kit (formerly ConvertKit) account to grow and manage your email list: create subscribers, look them up, and tag them to trigger automations.",
  "display_name": "Kit",
  "id": "kit"
}
