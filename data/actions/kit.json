      ]
    },
    "tag_subscriber": {
      "description": "Apply a tag to a subscriber (by email address) to segment them and trigger any automations attached to the tag.",
      "display_name": "Tag a subscriber",
      "display_str_template": "Tag subscriber '{1}' with tag '{0}'.",
      "handler": "actions.tag_subscriber",
      "id": "kit_tag_subscriber",
      "method": "POST",
      "mock_response": {
        "subscriber": {
          "created_at": "2024-10-01T12:00:00Z",
          "email_address": "jane@example.com",
          "fields": {},
          "first_name": "Jane",
          "id": "875403",
          "state": "active"
        },
        "tag_id": "99123"
      },
      "name": "tag_subscriber",
      "parameters": [
        {
          "description": "ID of the tag to apply.",
          "display_name": "Tag",
          "dynamic_source": "tags",
          "name": "tag_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email address of the subscriber to tag.",
          "display_name": "Email address",
          "name": "email_address",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/kit/tag-subscriber",
      "result_str_template": "Tagged Kit subscriber.",
      "returns": {
        "properties": {
          "subscriber": {
            "description": "The tagged subscriber",
            "nullable": true,
            "properties": {
              "created_at": {
                "description": "When the subscriber was created (ISO 8601)",
                "type": "string"
              },
              "email_address": {
                "description": "Subscriber email address",
                "type": "string"
              },
              "fields": {
                "description": "Custom field values on the subscriber",
                "type": "object"
              },
              "first_name": {
                "description": "First name, if set",
                "type": "string"
              },
              "id": {
                "description": "Kit subscriber ID",
                "type": "string"
              },
              "state": {
                "description": "Subscriber state, e.g. 'active' or 'inactive'",
                "type": "string"
              }
            },
            "type": "object"
          },
          "tag_id": {
            "description": "ID of the tag that was applied",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    }
  },
  "categories": [
    "Email Marketing"
  ],
  "description": "Connect your Kit (formerly ConvertKit) account to grow and manage your email list: create subscribers, look them up, and tag them to trigger automations.",
  "display_name": "Kit",
  "id": "kit",
  "logo": "https://www.lodol.com/app-icons/kit-icon.svg",
  "triggers": {
    "kit_form_submitted_trigger": {
      "description": "Runs each time someone signs up through a Kit form or landing page you choose, with their email, first name, custom fields and the page they signed up from. Sign-ups from before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Form submitted",
      "id": "kit_form_submitted_trigger",
      "output": {
        "added_at": "When they signed up through the form.",
        "created_at": "When they first subscribed.",
        "email_address": "Their email address.",
        "fields": "Their custom field values.",
        "first_name": "Their first name, if set.",
        "form_id": "The form's ID in Kit.",
        "referrer": "The page they signed up from, if Kit knows it.",
        "state": "Their state, such as active or cancelled.",
        "subscriber_id": "The subscriber's ID in Kit."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The form or landing page to watch.",
          "display_name": "Form",
          "name": "form_id",
          "required": true
        }
      ]
    },
    "kit_new_subscriber_trigger": {
      "description": "Runs when someone new subscribes in Kit, with their email, first name and custom fields. Someone who has to confirm by email starts it once they confirm, if that's within two days. People already subscribed when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New subscriber",
      "id": "kit_new_subscriber_trigger",
      "output": {
        "created_at": "When they first subscribed.",
        "email_address": "Their email address.",
        "fields": "Their custom field values.",
        "first_name": "Their first name, if set.",
        "state": "Their state, such as active or cancelled.",
        "subscriber_id": "The subscriber's ID in Kit."
      },
      "parameters": []
    },
    "kit_subscriber_unsubscribed_trigger": {
      "description": "Runs each time someone unsubscribes from your Kit emails, with their email, first name and when they left. People who unsubscribed before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Subscriber unsubscribed",
      "id": "kit_subscriber_unsubscribed_trigger",
      "output": {
        "created_at": "When they first subscribed.",
        "email_address": "Their email address.",
        "fields": "Their custom field values.",
        "first_name": "Their first name, if set.",
        "state": "Their state, such as active or cancelled.",
        "subscriber_id": "The subscriber's ID in Kit.",
        "unsubscribed_at": "When they unsubscribed."
      },
      "parameters": []
    },
    "kit_tag_added_trigger": {
      "description": "Runs each time a tag you choose is added to an active subscriber in Kit, with their email, first name and custom fields. Tags added before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Tag added to subscriber",
      "id": "kit_tag_added_trigger",
      "output": {
        "created_at": "When they first subscribed.",
        "email_address": "Their email address.",
        "fields": "Their custom field values.",
        "first_name": "Their first name, if set.",
        "state": "Their state, such as active or cancelled.",
        "subscriber_id": "The subscriber's ID in Kit.",
        "tag_id": "The tag's ID in Kit.",
        "tagged_at": "When the tag was added to them."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The tag to watch for.",
          "display_name": "Tag",
          "name": "tag_id",
          "required": true
        }
      ]
    }
  }
}
