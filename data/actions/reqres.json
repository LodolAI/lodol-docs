            }
          ],
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Any made-up password; ReqRes only checks that one is given. Leave it empty to test a refusal. Never use a real password: this is a public test service.",
          "display_name": "Password",
          "examples": [
