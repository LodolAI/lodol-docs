{
  "actions": {
    "create_user": {
      "description": "Send a new user to ReqRes, which answers like a real API: with a new id and a creation time. ReqRes stores nothing, so this is safe to run as often as you like. No API key required.",
      "display_name": "Create user",
      "display_str_template": "Create the ReqRes user {0}.",
      "handler": "actions.create_user",
      "id": "reqres_create_user",
      "method": "POST",
      "mock_response": {
        "created_at": "2026-10-16T18:44:26.271Z",
        "id": "941",
        "job": "leader",
        "name": "morpheus"
      },
      "name": "create_user",
      "output_formatter": "actions.format_write_output",
      "parameters": [
        {
          "description": "The new user's name.",
          "display_name": "Name",
          "examples": [
            {
              "label": "ReqRes's own example",
              "value": "morpheus"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The new user's job.",
          "display_name": "Job",
          "examples": [
            {
              "label": "ReqRes's own example",
              "value": "leader"
            }
          ],
          "name": "job",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/reqres/create-user",
      "result_str_template": "ReqRes created {reqres_create_user,name} as user {reqres_create_user,id}.",
      "returns": {
        "properties": {
          "created_at": {
            "description": "When ReqRes answered, as an ISO 8601 time.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "The id ReqRes gave the new user, e.g. '941'. It is made up for the answer: the user is not stored.",
            "type": [
              "string",
              "null"
            ]
          },
          "job": {
            "description": "The job sent, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name sent.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    "delete_user": {
      "description": "Send a delete for a user to ReqRes, which answers 204 No Content like a real API. ReqRes stores nothing, so this is safe to run as often as you like. No API key required.",
      "display_name": "Delete user",
      "display_str_template": "Delete ReqRes user {0}.",
      "handler": "actions.delete_user",
      "id": "reqres_delete_user",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "status_code": 204,
        "user_id": 2
      },
      "name": "delete_user",
      "output_formatter": "actions.format_write_output",
      "parameters": [
        {
          "description": "The sample user's id, 1 to 12.",
          "display_name": "User id",
          "examples": [
            {
              "label": "Janet Weaver",
              "value": "2"
            },
            {
              "label": "Eve Holt",
              "value": "4"
            }
          ],
          "minimum": 1,
          "name": "reqres_user_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/reqres/delete-user",
      "result_str_template": "ReqRes answered {reqres_delete_user,status_code} to deleting user {reqres_delete_user,user_id}.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True when ReqRes accepted the delete (HTTP 204).",
            "type": "boolean"
          },
          "status_code": {
            "description": "The HTTP status ReqRes answered with, 204 on success.",
            "type": "number"
          },
          "user_id": {
            "description": "The id of the user deleted.",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
