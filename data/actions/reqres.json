    "update_user": {
      "description": "Send a new name or job for a user to ReqRes, as a PUT or a PATCH, and get back what was sent with an update time. ReqRes stores nothing, so this is safe to run as often as you like. No API key required.",
      "display_name": "Update user",
      "display_str_template": "Update ReqRes user {0}.",
      "handler": "actions.update_user",
      "id": "reqres_update_user",
      "method": "POST",
      "mock_response": {
        "job": "zion resident",
        "name": "morpheus",
        "update_method": "PUT",
        "updated_at": "2026-10-16T18:44:27.472Z",
        "user_id": 2
      },
      "name": "update_user",
      "output_formatter": "actions.format_write_output",
      "parameters": [
        {
          "description": "The sample user's id, 1 to 12.",
          "display_name": "User id",
          "examples": [
            {
              "label": "Janet Weaver",
              "value": "2"
            },
            {
              "label": "Eve Holt",
              "value": "4"
            }
          ],
          "minimum": 1,
          "name": "reqres_user_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The user's new name. Give a name, a job or both.",
          "display_name": "Name",
          "examples": [
            {
              "label": "ReqRes's own example",
              "value": "morpheus"
            }
          ],
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The user's new job. Give a name, a job or both.",
          "display_name": "Job",
          "examples": [
            {
              "label": "ReqRes's own example",
              "value": "zion resident"
            }
          ],
          "name": "job",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "PUT",
