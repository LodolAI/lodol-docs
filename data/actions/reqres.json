    "log_in": {
      "description": "Log in as one of ReqRes's sample users and get back a made-up token. A missing password or an unknown address comes back with 'success' false and the reason, so you can test both outcomes. No API key required.",
      "display_name": "Log in",
      "display_str_template": "Log in to ReqRes as {0}.",
      "handler": "actions.log_in",
      "id": "reqres_log_in",
      "method": "POST",
      "mock_response": {
        "email": "eve.holt@reqres.in",
        "error": null,
        "success": true,
        "token": "QpwL5tke4Pnpja7X4"
      },
      "name": "log_in",
      "output_formatter": "actions.format_auth_output",
      "parameters": [
        {
