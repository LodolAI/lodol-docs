  "logo": "https://www.lodol.com/app-icons/printavo-icon.png",
  "triggers": {
    "printavo_new_customer_trigger": {
      "description": "Runs for each new customer in Printavo. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New customer",
      "id": "printavo_new_customer_trigger",
      "output": {
        "record": "object with the fields id, companyName, orderCount"
      },
      "parameters": []
    },
    "printavo_new_invoice_trigger": {
      "description": "Runs for each new invoice in Printavo. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
