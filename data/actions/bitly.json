{
  "actions": {
    "expand_link": {
      "description": "Expand a Bitly short link into its original long web address.",
      "display_name": "Expand a short link",
      "display_str_template": "Expand {0} into its original URL.",
      "handler": "actions.expand_link",
      "id": "bitly_expand_link",
      "method": "POST",
      "mock_response": {
        "id": "bit.ly/3xExAmp",
        "link": "https://bit.ly/3xExAmp",
        "long_url": "https://example.com/my-page"
      },
      "name": "expand_link",
      "parameters": [
        {
          "description": "The Bitly short link to expand, for example bit.ly/abc123.",
          "display_name": "Short link",
          "name": "short_link",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/bitly/expand-link",
      "result_str_template": "Original URL: {bitly_expand_link,long_url}",
      "returns": {
        "properties": {
          "id": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "long_url": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "shorten_link": {
      "description": "Turn a long web address into a short, shareable Bitly link. You can optionally save a title to help you find the link later.",
      "display_name": "Shorten a link",
      "display_str_template": "Shorten {0} with Bitly.",
      "handler": "actions.shorten_link",
      "id": "bitly_shorten_link",
      "method": "POST",
      "mock_response": {
        "id": "bit.ly/3xExAmp",
        "link": "https://bit.ly/3xExAmp",
        "long_url": "https://example.com/my-page",
        "title": "Spring sale landing page"
      },
      "name": "shorten_link",
      "parameters": [
        {
          "description": "The full web address you want to shorten, for example https://example.com/my-page.",
          "display_name": "Long URL",
          "name": "long_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. A label to help you recognize this link later in Bitly, for example \"Spring sale landing page\".",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/bitly/shorten-link",
      "result_str_template": "Short link: {bitly_shorten_link,link}",
      "returns": {
        "properties": {
          "id": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "long_url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create short links with Bitly and look up where existing short links lead.",
  "display_name": "Bitly",
  "id": "bitly"
}
