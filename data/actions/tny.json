{
  "actions": {
    "expand_link": {
      "description": "Expand a Tny short link into its original long web address.",
      "display_name": "Expand a short link",
      "display_str_template": "Expand {0} into its original URL.",
      "handler": "actions.expand_link",
      "id": "tny_expand_link",
      "method": "POST",
      "mock_response": {
        "long_url": "https://example.com/my-page",
        "short_link": "https://tny.dev/abc123",
        "slug": "abc123"
      },
      "name": "expand_link",
      "parameters": [
        {
          "description": "The Tny short link to expand, for example https://tny.dev/abc123.",
          "display_name": "Short link",
          "name": "short_link",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/tny/expand-link",
      "result_str_template": "Original URL: {tny_expand_link,long_url}",
      "returns": {
        "properties": {
          "long_url": {
            "type": "string"
          },
          "short_link": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "shorten_link": {
      "description": "Turn a long web address into a short, shareable Tny link.",
      "display_name": "Shorten a link",
      "display_str_template": "Shorten {0} with Tny.",
      "handler": "actions.shorten_link",
      "id": "tny_shorten_link",
      "method": "POST",
      "mock_response": {
        "long_url": "https://example.com/my-page",
        "short_url": "https://tny.dev/abc123",
        "slug": "abc123"
      },
      "name": "shorten_link",
      "parameters": [
        {
          "description": "The full web address you want to shorten.",
          "display_name": "Long URL",
          "name": "long_url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/tny/shorten-link",
      "result_str_template": "Short link: {tny_shorten_link,short_url}",
      "returns": {
        "properties": {
          "long_url": {
            "type": "string"
          },
          "short_url": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create short links with Tny and look up where existing Tny short links lead.",
  "display_name": "Tny",
  "id": "tny"
}
