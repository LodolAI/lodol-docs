      "id": "imgur_create_album",
      "method": "POST",
      "mock_response": {
        "deletehash": "Zx8Cv6Bn4Mm2Ll0",
        "id": "Qw3Er5T",
        "images_added": 1,
        "link": "https://imgur.com/a/Qw3Er5T"
      },
      "name": "create_album",
      "output_formatter": "actions.create_album_formatter",
      "parameters": [
        {
          "description": "A title for it, up to 255 characters.",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A description for it, up to 5,000 characters.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
