          },
          "id": {
            "description": "The album's Imgur ID",
            "type": "string"
          },
          "images_added": {
            "description": "How many images it was made with",
            "type": "number"
          },
          "link": {
            "description": "Link to the album on Imgur",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
