          "description": "The delete hashes of images uploaded with 'Upload an image', up to 500. A list from an earlier step works, and so does text with the hashes separated by commas.",
          "display_name": "Image delete hashes",
          "name": "image_deletehashes",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/imgur/create-album",
      "result_str_template": "Album created: {imgur_create_album,link}",
      "returns": {
        "properties": {
          "deletehash": {
            "description": "The key that adds images to this album or deletes it. Keep it: Imgur shows it only now.",
