{
  "actions": {
    "add_images_to_album": {
      "description": "Add images uploaded with 'Upload an image' to an album made with 'Create an album', using the delete hashes of both.",
      "display_name": "Add images to an album",
      "display_str_template": "Add images to an Imgur album.",
      "handler": "actions.add_images_to_album",
      "id": "imgur_add_images_to_album",
      "method": "POST",
      "mock_response": {
        "added": true,
        "album_deletehash": "Zx8Cv6Bn4Mm2Ll0",
        "images_added": 2
      },
      "name": "add_images_to_album",
      "output_formatter": "actions.add_images_to_album_formatter",
      "parameters": [
        {
          "description": "The album's delete hash, which 'Create an album' returned. The album's ID won't work here.",
          "display_name": "Album delete hash",
          "name": "album_deletehash",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The delete hashes of images uploaded with 'Upload an image', up to 500. A list from an earlier step works, and so does text with the hashes separated by commas.",
          "display_name": "Image delete hashes",
          "name": "image_deletehashes",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/imgur/add-images-to-album",
      "result_str_template": "Images added to the album.",
      "returns": {
        "properties": {
          "added": {
            "description": "Always true once added",
            "type": "boolean"
          },
          "album_deletehash": {
            "description": "The album's delete hash",
            "type": "string"
          },
          "images_added": {
            "description": "How many images were sent",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_album": {
      "description": "Make an Imgur album, optionally holding images uploaded with 'Upload an image'. Returns its link and the delete hash that adds to it or deletes it later.",
      "display_name": "Create an album",
      "display_str_template": "Create an Imgur album.",
