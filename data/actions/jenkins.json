{
  "actions": {
    "get_build": {
      "description": "Get a build's result, timing, what started it, its parameters and its artifacts.",
      "display_name": "Get build",
      "display_str_template": "Get a build of {0} from Jenkins.",
      "handler": "actions.get_build",
      "id": "jenkins_get_build",
      "method": "POST",
      "mock_response": {
        "artifacts": [
          {
            "file_name": "app.zip",
            "path": "dist/app.zip",
            "url": "https://jenkins.example.com/job/team/job/deploy/42/artifact/dist/app.zip"
          }
        ],
        "building": false,
        "causes": [
          "Started by user Jo Bloggs"
        ],
        "description": "",
        "display_name": "#42",
        "duration_seconds": 93.4,
        "estimated_seconds": 90.0,
        "job": "team/deploy",
        "number": 42,
        "parameters": {
          "ENVIRONMENT": "staging"
        },
        "result": "SUCCESS",
        "started_at": "2026-10-27T10:00:00Z",
        "url": "https://jenkins.example.com/job/team/job/deploy/42/"
      },
      "name": "get_build",
      "output_formatter": "actions.format_build",
      "parameters": [
        {
          "description": "The job. Pick one, type its name (folder/job), or paste its address.",
          "display_name": "Job",
          "dynamic_source": "jobs",
          "dynamic_source_allows_custom": true,
          "name": "job",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The build's number, such as 42. Leave empty to use 'Which build'.",
          "display_name": "Build number",
          "name": "build_number",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "lastBuild",
          "description": "When no number is given. Defaults to the latest build.",
          "display_name": "Which build",
          "name": "which",
          "options": [
            {
              "label": "The latest build",
              "value": "lastBuild"
            },
            {
              "label": "The latest finished build",
              "value": "lastCompletedBuild"
            },
            {
              "label": "The latest successful build",
              "value": "lastSuccessfulBuild"
            },
            {
              "label": "The latest failed build",
              "value": "lastFailedBuild"
            },
            {
              "label": "The latest stable build",
              "value": "lastStableBuild"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/jenkins/get-build",
      "result_str_template": "Build #{jenkins_get_build,number}: {jenkins_get_build,result}.",
      "returns": {
        "properties": {
          "artifacts": {
            "description": "Files the build archived",
            "items": {
              "description": "An artifact",
              "properties": {
                "file_name": {
                  "description": "The file's name",
                  "type": "string"
                },
                "path": {
                  "description": "Its path among the build's artifacts",
                  "type": "string"
                },
                "url": {
                  "description": "Where to download it (needs the same sign-in)",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "building": {
            "description": "True while it runs",
            "type": "boolean"
          },
          "causes": {
            "description": "Why it ran, such as 'Started by user Jo'",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "description": "The build's description",
            "type": "string"
          },
          "display_name": {
            "description": "The build's name, such as #42",
            "type": "string"
          },
          "duration_seconds": {
            "description": "How long it took; empty while it runs",
            "nullable": true,
            "type": "number"
          },
          "estimated_seconds": {
            "description": "How long Jenkins expects it to take",
            "nullable": true,
            "type": "number"
          },
          "job": {
            "description": "The job's full name",
            "type": "string"
          },
          "number": {
            "description": "The build's number",
            "type": "number"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The parameters it ran with",
            "type": "object"
          },
          "result": {
            "description": "SUCCESS, FAILURE, UNSTABLE, ABORTED or NOT_BUILT; empty while it runs",
            "type": "string"
          },
          "started_at": {
            "description": "When it started, in UTC (ISO 8601)",
            "type": "string"
          },
          "url": {
            "description": "The build's page",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_build_log": {
      "description": "Get the last lines of a build's console output, such as where it failed.",
      "display_name": "Get build log",
      "display_str_template": "Get a build log of {0} from Jenkins.",
      "handler": "actions.get_build_log",
      "id": "jenkins_get_build_log",
      "method": "POST",
      "mock_response": {
        "build": "42",
        "job": "team/deploy",
        "line_count": 1,
        "log": "Finished: SUCCESS",
        "truncated": true
      },
      "name": "get_build_log",
      "output_formatter": "actions.format_log",
      "parameters": [
        {
          "description": "The job. Pick one, type its name (folder/job), or paste its address.",
          "display_name": "Job",
          "dynamic_source": "jobs",
          "dynamic_source_allows_custom": true,
          "name": "job",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The build's number, such as 42. Leave empty to use 'Which build'.",
          "display_name": "Build number",
          "name": "build_number",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "lastBuild",
          "description": "When no number is given. Defaults to the latest build.",
          "display_name": "Which build",
          "name": "which",
          "options": [
            {
              "label": "The latest build",
              "value": "lastBuild"
            },
            {
              "label": "The latest finished build",
              "value": "lastCompletedBuild"
            },
            {
              "label": "The latest successful build",
              "value": "lastSuccessfulBuild"
            },
            {
              "label": "The latest failed build",
              "value": "lastFailedBuild"
            },
            {
              "label": "The latest stable build",
              "value": "lastStableBuild"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many lines from the end, up to 5000. Defaults to 200.",
          "display_name": "Last lines",
          "maximum": 5000,
          "minimum": 1,
          "name": "last_lines",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/jenkins/get-build-log",
      "result_str_template": "Read {jenkins_get_build_log,line_count} line(s).",
      "returns": {
        "properties": {
          "build": {
            "description": "The build's number, or which latest build",
            "type": "string"
          },
          "job": {
            "description": "The job's full name",
            "type": "string"
          },
          "line_count": {
            "description": "How many lines were returned",
            "type": "number"
          },
          "log": {
            "description": "The lines, oldest first",
            "type": "string"
          },
          "truncated": {
            "description": "True when earlier lines were left out",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
