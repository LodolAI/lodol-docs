{
  "actions": {
    "query_model": {
      "description": "Sends a prompt to the OpenAI model you select and returns the response text.",
      "display_name": "Send a prompt to an OpenAI model",
      "display_str_template": "Send a prompt to an OpenAI model.",
      "handler": "actions.query_model",
      "id": "openai_query_model",
      "method": "POST",
      "mock_response": {
        "response_text": "Based on your question about quantum computing, here are the key principles...",
        "status": "success"
      },
      "name": "query_model",
      "output_formatter": "actions.format_model_output",
      "parameters": [
        {
          "description": "The question or instructions to send to the model.",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "gpt-5.5",
          "description": "Which OpenAI model to use. Defaults to gpt-5.5.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "GPT-5.5 (latest, most capable)",
              "value": "gpt-5.5"
            },
            {
              "label": "GPT-5.4",
              "value": "gpt-5.4"
            },
            {
              "label": "GPT-5.4 mini (fast, lower cost)",
              "value": "gpt-5.4-mini"
            },
            {
              "label": "GPT-5.4 nano (fastest, lowest cost)",
              "value": "gpt-5.4-nano"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/openai/query-model",
      "result_str_template": "OpenAI response: {openai_query_model,response_text}",
      "returns": {
        "properties": {
          "response_text": {
            "description": "OpenAI response text.",
            "type": "string"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect OpenAI's GPT models to generate text, answer questions, and power AI steps in your workflows.",
  "display_name": "OpenAI",
  "id": "openai"
}
