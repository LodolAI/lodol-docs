    "scrape_page": {
      "description": "Fetch a web page and return both its HTML and a clean markdown version. Browserless starts with a fast HTTP fetch and escalates to a proxy, a headless browser, or a captcha solve only if the site needs it, so JavaScript-rendered and bot-protected pages work too.",
      "display_name": "Scrape a page",
      "display_str_template": "Scrape '{0}' with Browserless.",
      "handler": "actions.scrape_page",
      "id": "browserless_scrape_page",
      "method": "POST",
      "mock_response": {
        "content": "<html lang=\"en\" op=\"news\"><head>...</head></html>",
        "content_type": "text/html; charset=utf-8",
        "markdown": "# Hacker News\n\n1. [Motorola GrapheneOS devices...](...)",
        "status_code": 200,
        "strategy": "http-fetch",
        "url": "https://news.ycombinator.com/"
      },
      "name": "scrape_page",
      "parameters": [
        {
          "description": "The page to load, starting with http:// or https://.",
          "display_name": "Page URL",
          "examples": [
            {
              "label": "Hacker News",
              "value": "https://news.ycombinator.com/"
            }
          ],
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Which proxy network to route through if the site blocks the first, direct attempt. Leave empty to use Browserless's default (residential).",
          "display_name": "Proxy network",
          "name": "proxy",
          "options": [
            {
              "label": "Residential: harder to block",
              "value": "residential"
            },
            {
              "label": "Datacenter: cheaper, blocked more often",
              "value": "datacenter"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/browserless/scrape-page",
      "result_str_template": "Page scraped.",
      "returns": {
        "properties": {
          "content": {
            "description": "The page's HTML. If the URL answers with JSON instead, this is that JSON as a string.",
            "type": "string"
          },
          "content_type": {
            "description": "Content type the page was served with",
            "type": "string"
          },
          "markdown": {
            "description": "The page as markdown, with scripts, styles, and hidden elements stripped",
            "type": "string"
          },
          "status_code": {
            "description": "HTTP status the page responded with",
            "type": "number"
          },
          "strategy": {
            "description": "How Browserless fetched the page, for example 'http-fetch' or 'browser'",
            "type": "string"
          },
          "url": {
            "description": "The page that was scraped",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
