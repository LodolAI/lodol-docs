{
  "actions": {
    "capture_screenshot": {
      "description": "Render a web page in a real browser and capture the full page as a PNG. The image is saved to your workspace's file storage; the action returns a document reference and a download URL so a later step can send, upload, or attach it.",
      "display_name": "Screenshot a page",
      "display_str_template": "Screenshot '{0}'.",
      "handler": "actions.capture_screenshot",
      "id": "browserless_capture_screenshot",
      "method": "POST",
      "mock_response": {
        "byte_size": 184320,
        "content_type": "image/png",
        "document_ref": "doc_9f8e7d6c5b4a3210",
        "documents": [
          {
            "content_type": "image/png",
            "document_ref": "doc_9f8e7d6c5b4a3210",
            "filename": "news-ycombinator-com.png",
            "size_bytes": 184320,
            "url": "/actions/core/serve-document/doc_9f8e7d6c5b4a3210?teamId=6512a1b2c3d4e5f600000001"
          }
        ],
        "page_url": "https://news.ycombinator.com/",
        "status_code": 200,
        "strategy": "browser",
        "url": "/actions/core/serve-document/doc_9f8e7d6c5b4a3210?teamId=6512a1b2c3d4e5f600000001"
      },
      "name": "capture_screenshot",
      "parameters": [
        {
          "description": "The page to load, starting with http:// or https://.",
          "display_name": "Page URL",
          "examples": [
            {
              "label": "Hacker News",
              "value": "https://news.ycombinator.com/"
            }
          ],
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Which proxy network to route through if the site blocks the first, direct attempt. Leave empty to use Browserless's default (residential).",
          "display_name": "Proxy network",
          "name": "proxy",
          "options": [
            {
              "label": "Residential: harder to block",
              "value": "residential"
            },
            {
              "label": "Datacenter: cheaper, blocked more often",
              "value": "datacenter"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/browserless/capture-screenshot",
      "result_str_template": "Screenshot captured.",
      "returns": {
        "properties": {
          "byte_size": {
            "description": "Size of the screenshot in bytes",
            "type": "number"
          },
          "content_type": {
            "description": "MIME type of the screenshot, always image/png",
            "type": "string"
          },
          "document_ref": {
            "description": "ID of the stored screenshot, for use by a later step",
            "type": "string"
          },
          "documents": {
            "description": "The screenshot, saved to your workspace's file storage",
            "items": {
              "properties": {
                "content_type": {
                  "description": "MIME type of the file",
                  "type": "string"
                },
                "document_ref": {
                  "description": "ID of the stored file",
                  "type": "string"
                },
                "filename": {
                  "description": "Name the file was stored under",
                  "type": "string"
                },
                "size_bytes": {
                  "description": "Size of the file in bytes",
                  "type": "number"
                },
                "url": {
                  "description": "Link that serves the file",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "page_url": {
            "description": "The page that was captured",
            "type": "string"
          },
          "status_code": {
            "description": "HTTP status the page responded with",
            "type": "number"
          },
          "strategy": {
            "description": "How Browserless fetched the page, for example 'browser' or 'browser-captcha'",
            "type": "string"
          },
          "url": {
            "description": "Link that serves the screenshot",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "extract_links": {
