  "triggers": {
    "checkfront_new_booking_trigger": {
      "description": "Runs for each new booking in Checkfront. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New booking",
      "id": "checkfront_new_booking_trigger",
      "output": {
        "record": "object with the fields booking_id, code, status_id, status_name, customer_name, created_date"
      },
      "parameters": []
    },
    "checkfront_new_or_updated_booking_trigger": {
      "description": "Runs for each booking added or changed in Checkfront. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated booking",
      "id": "checkfront_new_or_updated_booking_trigger",
      "output": {
        "record": "object with the fields booking_id, code, status_id, status_name, customer_name, created_date"
      },
      "parameters": []
    }
  }
