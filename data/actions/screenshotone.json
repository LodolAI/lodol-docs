{
  "actions": {
    "take_screenshot": {
      "description": "Capture a screenshot of any web page with ScreenshotOne and save it as an image you can use in later steps.",
      "display_name": "Take a screenshot",
      "display_str_template": "Take a screenshot of {0}.",
      "handler": "actions.take_screenshot",
      "id": "screenshotone_take_screenshot",
      "method": "POST",
      "mock_response": {
        "content_type": "image/png",
        "document_ref": "doc_0123456789abcdef0123456789abcdef",
        "documents": [
          {
            "content_type": "image/png",
            "document_ref": "doc_0123456789abcdef0123456789abcdef",
            "filename": "screenshot-example-com.png",
            "size_bytes": 84213,
            "url": "/actions/core/serve-document/doc_0123456789abcdef0123456789abcdef?teamId=team"
          }
        ],
        "filename": "screenshot-example-com.png",
        "size_bytes": 84213,
        "url": "/actions/core/serve-document/doc_0123456789abcdef0123456789abcdef?teamId=team"
      },
      "name": "take_screenshot",
      "parameters": [
        {
          "description": "The web address to capture, for example https://example.com.",
          "display_name": "URL",
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "png",
          "description": "The image format to save the screenshot in.",
          "display_name": "Image format",
          "name": "format",
          "options": [
            {
              "label": "PNG (recommended)",
              "value": "png"
            },
            {
              "label": "JPEG (smaller file)",
              "value": "jpeg"
            },
            {
              "label": "WebP",
              "value": "webp"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Capture the entire scrollable page instead of just the visible area.",
          "display_name": "Full page",
          "name": "full_page",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": 1280,
          "description": "The browser width in pixels.",
          "display_name": "Viewport width",
          "maximum": 3840,
          "minimum": 100,
          "name": "viewport_width",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 1024,
          "description": "The browser height in pixels.",
          "display_name": "Viewport height",
          "maximum": 3840,
          "minimum": 100,
          "name": "viewport_height",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": true,
          "description": "Hide ads for a cleaner screenshot.",
          "display_name": "Block ads",
          "name": "block_ads",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": true,
          "description": "Hide cookie-consent pop-ups for a cleaner screenshot.",
          "display_name": "Block cookie banners",
          "name": "block_cookie_banners",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Render the page in dark mode when the site supports it.",
          "display_name": "Dark mode",
          "name": "dark_mode",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "How long to wait after the page loads before capturing, to let animations or late content finish.",
          "display_name": "Delay (seconds)",
          "maximum": 30,
          "minimum": 0,
          "name": "delay",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": false,
          "description": "Reuse a recent screenshot of the same page when available, for a faster result.",
          "display_name": "Use cache",
          "name": "cache",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/screenshotone/take-screenshot",
      "result_str_template": "Screenshot saved: {screenshotone_take_screenshot,url}",
      "returns": {
        "properties": {
          "content_type": {
            "type": "string"
          },
          "document_ref": {
            "description": "Reference to the saved screenshot image.",
            "type": "string"
          },
          "documents": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "filename": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          },
          "url": {
            "description": "A link that serves the saved screenshot.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Capture pixel-perfect screenshots of any web page with ScreenshotOne.",
  "display_name": "ScreenshotOne",
  "id": "screenshotone"
}
