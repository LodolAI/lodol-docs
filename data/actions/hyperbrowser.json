{
  "actions": {
    "enrich_profile": {
      "description": "Visit one profile and gather details you can use to qualify leads: name, headline, bio, location, recent posts, and any emails or phone numbers that are available (often not shown on the platform).",
      "display_name": "Look up profile details",
      "display_str_template": "Look up {platform} profile",
      "handler": "actions.enrich_profile",
      "id": "hyperbrowser_enrich_profile",
      "method": "POST",
      "mock_response": {
        "bio": "Building tools for go-to-market teams.",
        "emails": [],
        "headline": "Founder at Acme",
        "location": "San Francisco, CA",
        "name": "Jane Doe",
        "phones": [],
        "profile_url": "https://www.linkedin.com/in/jane-doe",
        "recent_posts": [
          "Hiring two AEs this quarter!"
        ]
      },
      "name": "enrich_profile",
      "output_formatter": "actions.format_enrich_profile_output",
      "parameters": [
        {
          "default": "linkedin",
          "description": "Social platform to use. Currently supports: linkedin.",
          "display_name": "Platform",
          "name": "platform",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Web address of the profile to look up (for example, one returned by the List followers/connections action).",
          "display_name": "Profile URL",
          "name": "profile_url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hyperbrowser/enrich-profile",
      "result_str_template": "Profile details retrieved.",
      "returns": {
        "properties": {
          "bio": {
            "type": "string"
          },
          "emails": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "headline": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phones": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "profile_url": {
            "type": "string"
          },
          "recent_posts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_followers": {
      "description": "List one page of the connected account's own friends or followers. To get more, run the action again with the next-page marker from the previous result, and keep the limit small so each run finishes in time.",
      "display_name": "List followers/connections",
      "display_str_template": "List {platform} followers",
      "handler": "actions.list_followers",
      "id": "hyperbrowser_list_followers",
      "method": "POST",
      "mock_response": {
        "followers": [
          {
            "headline": "Founder at Acme",
            "name": "Jane Doe",
            "profile_url": "https://www.linkedin.com/in/jane-doe"
          }
        ],
        "next_cursor": null
      },
      "name": "list_followers",
      "output_formatter": "actions.format_list_followers_output",
      "parameters": [
        {
          "default": "linkedin",
          "description": "Social platform to use. Currently supports: linkedin.",
          "display_name": "Platform",
          "name": "platform",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 25,
          "description": "Maximum number of people to return per page (keep this small; default 25).",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Leave empty for the first page. To get the next page, use the next-page marker returned by the previous result.",
          "display_name": "Next page marker",
          "name": "cursor",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hyperbrowser/list-followers",
      "result_str_template": "Followers listed.",
      "returns": {
        "properties": {
          "followers": {
            "description": "Follower/connection references.",
            "items": {
              "properties": {
                "headline": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "profile_url": {
                  "description": "Canonical profile URL; pass to enrich_profile.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Cursor for the next page; null when no more pages.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "verify_login": {
      "description": "Check whether the connected Hyperbrowser Profile is still logged in to the platform, since saved logins can expire over time. Returns a simple yes or no.",
      "display_name": "Verify social login",
      "display_str_template": "Verify {platform} login",
      "handler": "actions.verify_login",
      "id": "hyperbrowser_verify_login",
      "method": "POST",
      "mock_response": {
        "authenticated": true,
        "platform": "linkedin"
      },
      "name": "verify_login",
      "output_formatter": "actions.format_verify_login_output",
      "parameters": [
        {
          "default": "linkedin",
          "description": "Social platform to use. Currently supports: linkedin.",
          "display_name": "Platform",
          "name": "platform",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hyperbrowser/verify-login",
      "result_str_template": "Login checked.",
      "returns": {
        "properties": {
          "authenticated": {
            "description": "True if the Profile is still logged in.",
            "type": "boolean"
          },
          "platform": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Gather your own social media connections and look up profile details using Hyperbrowser's automated browser (starting with LinkedIn).",
  "display_name": "Hyperbrowser",
  "id": "hyperbrowser"
}
