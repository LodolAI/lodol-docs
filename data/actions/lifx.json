                "type": "integer"
              },
              "results": {
                "description": "Results.",
                "items": {
                  "description": "An entry from the response.",
                  "properties": {
                    "id": {
                      "description": "The light's ID (serial number).",
                      "type": "string"
                    },
                    "label": {
                      "description": "The light's name.",
                      "type": "string"
                    },
                    "status": {
                      "description": "ok, or why the light didn't change: timed_out or offline.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "minItems": 0,
                "type": "array"
              },
              "summary": {
                "description": "Which lights changed, in a sentence.",
                "type": "string"
