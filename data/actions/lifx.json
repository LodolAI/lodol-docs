      "name": "breathe_effect",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "Which lights to breathe: pick from the list, or type a LIFX selector such as all, id:d073d5000000, group_id:..., location_id:... or label:Desk lamp. Separate up to 25 with commas.",
