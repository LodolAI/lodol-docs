          "dynamic_source": "lights",
          "dynamic_source_allows_custom": true,
          "name": "selector",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The color to fade to, such as red, #ff0000, kelvin:2700 or hue:120 saturation:1.",
          "display_name": "Color",
          "name": "color",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The color to start from. Leave blank to start from the light's current color.",
          "display_name": "From color",
          "name": "from_color",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many seconds one cycle takes. LIFX uses 1 if left blank.",
          "display_name": "Period",
          "minimum": 0,
          "name": "period",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How many times to repeat. LIFX uses 1 if left blank.",
          "display_name": "Cycles",
          "minimum": 0,
          "name": "cycles",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Leave the lights on the effect's last color. Off by default, which puts them back as they were.",
          "display_name": "Persist",
          "name": "persist",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Turn on lights that are off for the effect. On by default.",
          "display_name": "Power on",
          "name": "power_on",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Where in each cycle the color is strongest, from 0 to 1. LIFX uses 0.5 if left blank.",
          "display_name": "Peak",
          "maximum": 1,
          "minimum": 0,
          "name": "peak",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
