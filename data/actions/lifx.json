{
  "actions": {
    "activate_scene": {
      "description": "Set the lights in a saved scene to the way the scene has them.",
      "display_name": "Activate a scene",
      "display_str_template": "Activate scene {scene_id}.",
      "handler": "documented_provider._handler.<locals>.handle",
      "id": "lifx_activate_scene",
      "method": "POST",
      "mock_response": {
        "data": {
          "not_ok_count": 1,
          "ok_count": 1,
          "results": [
            {
              "id": "example",
              "label": "example",
              "status": "example"
            }
          ],
          "summary": "example"
        }
      },
      "name": "activate_scene",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "The scene to activate. Pick from the list or use a scene ID from an earlier step.",
          "display_name": "Scene",
          "dynamic_source": "scenes",
          "dynamic_source_allows_custom": true,
          "name": "scene_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many seconds the lights take to change. LIFX uses 1 if left blank.",
          "display_name": "Duration",
          "maximum": 3155760000,
          "minimum": 0,
          "name": "duration",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Parts of the scene to leave as the lights have them now.",
          "display_name": "Ignore",
          "multi_select": true,
          "name": "ignore",
          "options": [
            {
              "label": "Power",
              "value": "power"
            },
            {
              "label": "Infrared",
              "value": "infrared"
            },
            {
              "label": "Duration",
              "value": "duration"
            },
            {
              "label": "Intensity",
              "value": "intensity"
            },
            {
              "label": "Hue",
              "value": "hue"
            },
            {
              "label": "Saturation",
              "value": "saturation"
            },
            {
              "label": "Brightness",
              "value": "brightness"
            },
            {
              "label": "Kelvin",
              "value": "kelvin"
            }
          ],
          "required": false,
          "schema": {
            "description": "Parts of the scene to leave as the lights have them now.",
            "items": {
              "enum": [
                "power",
                "infrared",
                "duration",
                "intensity",
                "hue",
                "saturation",
                "brightness",
                "kelvin"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Send the change without checking the lights first or waiting for them to answer. Quicker, but the step can't say which lights changed.",
          "display_name": "Fast",
          "name": "fast",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/lifx/activate-scene",
      "result_str_template": "Activate a scene completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response from LIFX.",
            "properties": {
              "not_ok_count": {
                "description": "How many lights were offline or didn't answer in time.",
                "type": "integer"
              },
              "ok_count": {
                "description": "How many lights answered ok.",
                "type": "integer"
              },
              "results": {
                "description": "Results.",
                "items": {
                  "description": "An entry from the response.",
                  "properties": {
                    "id": {
                      "description": "The light's ID (serial number).",
                      "type": "string"
                    },
                    "label": {
                      "description": "The light's name.",
                      "type": "string"
                    },
                    "status": {
                      "description": "ok, or why the light didn't change: timed_out or offline.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "minItems": 0,
                "type": "array"
              },
              "summary": {
                "description": "Which lights changed, in a sentence.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
    "breathe_effect": {
      "description": "Fade the lights slowly to a color and back.",
      "display_name": "Breathe lights",
      "display_str_template": "Breathe lights.",
      "handler": "documented_provider._handler.<locals>.handle",
      "id": "lifx_breathe_effect",
