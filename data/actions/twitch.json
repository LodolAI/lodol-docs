{
  "actions": {
    "get_user_profile": {
      "description": "Look up a Twitch user's profile by their username.",
      "display_name": "Get user profile",
      "display_str_template": "Look up Twitch profile for '{0}'.",
      "handler": "actions.get_user_profile",
      "id": "twitch_get_user_profile",
      "method": "POST",
      "mock_response": {
        "user": {
          "description": "mock_value",
          "display_name": "mock_value",
          "id": "mock_value",
          "login": "mock_value"
        }
      },
      "name": "get_user_profile",
      "parameters": [
        {
          "description": "The Twitch username to look up, for example 'ninja'.",
          "display_name": "Username",
          "name": "user_login",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/twitch/get-user-profile",
      "result_str_template": "Profile retrieved.",
      "returns": {
        "properties": {
          "user": {
            "description": "The user's profile details.",
            "properties": {
              "description": {
                "description": "The channel's 'About' description.",
                "type": "string"
              },
              "display_name": {
                "description": "The name shown on the user's channel.",
                "type": "string"
              },
              "id": {
                "description": "The user's unique Twitch ID.",
                "type": "string"
              },
              "login": {
                "description": "The user's username (login name).",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_followers": {
      "description": "List the people who follow a channel, along with when they followed and the total follower count. You can only list followers for your own channel or a channel you moderate.",
      "display_name": "List channel followers",
      "display_str_template": "List followers for the '{0}' channel.",
      "handler": "actions.list_followers",
      "id": "twitch_list_followers",
      "method": "POST",
      "mock_response": {
        "followers": [
          {
            "followed_at": "mock_value",
            "user_id": "mock_value",
            "user_name": "mock_value"
          }
        ],
        "total": 1024
      },
      "name": "list_followers",
      "parameters": [
        {
          "description": "The channel's Twitch username, for example 'ninja'. This must be your own channel or one you moderate.",
          "display_name": "Channel username",
          "name": "channel",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 20,
          "description": "Maximum number of followers to return, from 1 to 100. Defaults to 20.",
          "display_name": "Number of followers",
          "name": "first",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/twitch/list-followers",
      "result_str_template": "Followers retrieved.",
      "returns": {
        "properties": {
          "followers": {
            "description": "The people who follow the channel.",
            "items": {
              "properties": {
                "followed_at": {
                  "description": "When the person started following the channel.",
                  "type": "string"
                },
                "user_id": {
                  "description": "The follower's unique Twitch ID.",
                  "type": "string"
                },
                "user_name": {
                  "description": "The follower's display name.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "The total number of people who follow the channel.",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "list_streams": {
      "description": "List live streams by channel name or game.",
      "display_name": "List live streams",
      "display_str_template": "List Twitch streams for '{0}'.",
      "handler": "actions.list_streams",
      "id": "twitch_list_streams",
      "method": "POST",
      "mock_response": {
        "streams": [
          {
            "id": "mock_value",
            "title": "mock_value",
            "user_id": "mock_value",
            "user_name": "mock_value",
            "viewer_count": 123
          }
        ]
      },
      "name": "list_streams",
      "parameters": [
        {
          "description": "Only show the live stream for this channel's username, for example 'ninja'.",
          "display_name": "Channel username",
          "name": "user_login",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only show streams playing this game or category. Use the numeric ID Twitch assigns to the game or category.",
          "display_name": "Game or category ID",
          "name": "game_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 20,
          "description": "Maximum number of streams to return, from 1 to 100. Defaults to 20.",
          "display_name": "Number of streams",
          "name": "first",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/twitch/list-streams",
      "result_str_template": "Streams retrieved.",
      "returns": {
        "properties": {
          "streams": {
            "description": "The live streams that matched your search.",
            "items": {
              "properties": {
                "id": {
                  "description": "The live stream's unique ID.",
                  "type": "string"
                },
                "title": {
                  "description": "The title of the live stream.",
                  "type": "string"
                },
                "user_id": {
                  "description": "The streamer's unique Twitch ID.",
                  "type": "string"
                },
                "user_name": {
                  "description": "The name shown on the streamer's channel.",
                  "type": "string"
                },
                "viewer_count": {
                  "description": "How many people are watching right now.",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Look up Twitch profiles, find live streams, and list channel followers.",
  "display_name": "Twitch",
  "id": "twitch"
}
