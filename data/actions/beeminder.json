  "description": "Read goals and progress, update goal settings, and create, edit or delete datapoints.",
  "display_name": "Beeminder",
  "id": "beeminder",
  "logo": "https://www.lodol.com/app-icons/beeminder-icon.png",
  "triggers": {
    "beeminder_new_datapoint_trigger": {
      "description": "Runs for each new datapoint in Beeminder. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New datapoint",
      "id": "beeminder_new_datapoint_trigger",
      "output": {
        "record": "object"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Goal.",
          "display_name": "Goal",
          "name": "goal",
          "required": true
        }
      ]
    },
    "beeminder_new_goal_trigger": {
      "description": "Runs for each new goal in Beeminder. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New goal",
      "id": "beeminder_new_goal_trigger",
      "output": {
        "record": "object"
      },
      "parameters": []
    },
    "beeminder_new_or_updated_datapoint_trigger": {
      "description": "Runs for each datapoint added or changed in Beeminder. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated datapoint",
      "id": "beeminder_new_or_updated_datapoint_trigger",
      "output": {
        "record": "object"
      },
      "parameters": [
        {
