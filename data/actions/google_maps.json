{
  "actions": {
    "get_directions": {
      "description": "Get directions between two places. Give a start and end point as an address, a place name, or 'latitude,longitude', and get back the distance, travel time, and turn-by-turn steps for the best route. Choose a travel mode and, for driving, whether to avoid tolls, highways, or ferries.",
      "display_name": "Get directions",
      "display_str_template": "Get directions from {0} to {1}.",
      "handler": "actions.get_directions",
      "id": "google_maps_get_directions",
      "method": "POST",
      "mock_response": {
        "distance_meters": 51234,
        "distance_text": "51.2 km",
        "duration_seconds": 2460,
        "duration_text": "41 mins",
        "found": true,
        "polyline": "ipkcFfichVnP@j@BLoFVwM{E?",
        "steps": [
          {
            "distance": "0.2 km",
            "instruction": "Head north on Amphitheatre Pkwy"
          },
          {
            "distance": "48 km",
            "instruction": "Turn right onto US-101 N"
          }
        ],
        "warnings": []
      },
      "name": "get_directions",
      "parameters": [
        {
          "description": "Where the route starts. An address, a place name, a plus code, or 'latitude,longitude', for example \"1600 Amphitheatre Parkway, Mountain View, CA\" or \"37.4224,-122.0842\".",
          "display_name": "Start",
          "name": "origin",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Where the route ends. An address, a place name, a plus code, or 'latitude,longitude'.",
          "display_name": "End",
          "name": "destination",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "DRIVE",
          "description": "How the trip is made.",
          "display_name": "Travel mode",
          "name": "travel_mode",
          "options": [
            {
              "label": "Driving",
              "value": "DRIVE"
            },
            {
              "label": "Walking",
              "value": "WALK"
            },
            {
              "label": "Bicycling",
              "value": "BICYCLE"
            },
            {
              "label": "Two-wheeler (motorcycle)",
              "value": "TWO_WHEELER"
            },
            {
              "label": "Public transit",
              "value": "TRANSIT"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Avoid toll roads. Applies to Driving and Two-wheeler routes only.",
          "display_name": "Avoid tolls",
          "name": "avoid_tolls",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Avoid highways. Applies to Driving and Two-wheeler routes only.",
          "display_name": "Avoid highways",
          "name": "avoid_highways",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Avoid ferries. Applies to Driving and Two-wheeler routes only.",
          "display_name": "Avoid ferries",
          "name": "avoid_ferries",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": "METRIC",
          "description": "Unit system for the distance and duration text in the result.",
          "display_name": "Units",
          "name": "units",
          "options": [
            {
              "label": "Metric (km)",
              "value": "METRIC"
            },
            {
              "label": "Imperial (miles)",
              "value": "IMPERIAL"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-maps/get-directions",
      "result_str_template": "Distance: {google_maps_get_directions,distance_text}; Duration: {google_maps_get_directions,duration_text}",
      "returns": {
        "properties": {
          "distance_meters": {
            "description": "Total route distance in meters.",
            "nullable": true,
            "type": "integer"
          },
          "distance_text": {
            "description": "Human-readable distance, for example '15.2 km'.",
            "type": "string"
          },
          "duration_seconds": {
            "description": "Estimated travel time in seconds.",
            "nullable": true,
            "type": "integer"
          },
          "duration_text": {
            "description": "Human-readable travel time, for example '22 mins'.",
            "type": "string"
          },
          "found": {
            "description": "Whether a route was found.",
            "type": "boolean"
          },
          "polyline": {
            "description": "Encoded polyline for the route geometry.",
            "type": "string"
          },
          "steps": {
            "description": "Turn-by-turn steps for the route.",
            "items": {
              "properties": {
                "distance": {
                  "description": "Human-readable distance for this step.",
                  "type": "string"
                },
                "instruction": {
                  "description": "The navigation instruction for this step.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "warnings": {
            "description": "Advisory warnings returned for the route.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
