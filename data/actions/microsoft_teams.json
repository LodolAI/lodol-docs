    "resolve_teams_link": {
      "description": "Get the team, channel, and organization (tenant) IDs from a Microsoft Teams link.",
      "display_name": "Get IDs from a Teams link",
      "display_str_template": "Get IDs from Teams link",
      "handler": "actions.resolve_teams_link",
      "id": "microsoft_teams_resolve_teams_link",
      "method": "POST",
      "mock_response": {
        "channel_id": "19:abc123@thread.tacv2",
        "ms_team_id": "72602e12-78ac-474c-99d6-f619710353a9",
        "status": "success",
        "tenant_id": "aaaabbbb-0000-cccc-1111-dddd2222eeee"
      },
      "name": "resolve_teams_link",
      "parameters": [
        {
          "description": "A Microsoft Teams URL (team or channel link).",
          "display_name": "Link",
          "name": "link",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-teams/resolve-teams-link",
      "result_str_template": "Teams link details found.",
      "returns": {
        "properties": {
