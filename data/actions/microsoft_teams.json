{
  "actions": {
    "add_member_to_team": {
      "description": "Add a member to a Teams team.",
      "display_name": "Add member to team",
      "display_str_template": "Add user {1} to team {0}",
      "handler": "actions.add_member_to_team",
      "id": "microsoft_teams_add_member_to_team",
      "method": "POST",
      "mock_response": {
        "ms_team_id": "team123",
        "ms_user_id": "user123",
        "result": {},
        "status": "success"
      },
      "name": "add_member_to_team",
      "parameters": [
        {
          "description": "The ID of the team. You can find it with the List joined teams or Get IDs from a Teams link actions.",
          "display_name": "Team ID",
          "name": "ms_team_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The user ID or email address of the person to add. You can find the ID with the Search team members action, or simply enter their email address.",
          "display_name": "User ID or email",
          "name": "ms_user_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional role for the member (e.g., owner).",
          "display_name": "Role",
          "name": "role",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-teams/add-member",
      "result_str_template": "Member added.",
      "returns": {
        "properties": {
          "ms_team_id": {
            "description": "The team ID.",
            "type": "string"
          },
          "ms_user_id": {
            "description": "The user ID.",
            "type": "string"
          },
          "result": {
            "description": "The member result.",
            "type": "object"
          },
          "status": {
            "description": "Operation status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
