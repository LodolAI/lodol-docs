{
  "actions": {
    "get_identity": {
      "description": "Get the profile of the connected Patreon account, including the ID of the campaign it runs as a creator.",
      "display_name": "Get identity",
      "display_str_template": "Get the connected Patreon account's profile.",
      "handler": "actions.get_identity",
      "id": "patreon_get_identity",
      "method": "POST",
      "mock_response": {
        "about": "I make weekly illustration tutorials.",
        "campaign_id": "12345678",
        "email": "jamie@example.com",
        "full_name": "Jamie Rivera",
        "image_url": "https://c8.patreon.com/2/200/87654321",
        "is_email_verified": true,
        "url": "https://www.patreon.com/jamiecreates",
        "user_id": "87654321",
        "vanity": "jamiecreates"
      },
      "name": "get_identity",
      "parameters": [],
      "path": "/actions/library/patreon/get-identity",
      "result_str_template": "Fetched the Patreon profile.",
      "returns": {
        "properties": {
          "about": {
            "description": "The account's about/bio text",
            "type": "string"
          },
          "campaign_id": {
            "description": "ID of the campaign this account runs as a creator (empty if none). Use with the member/post actions.",
            "type": "string"
          },
          "email": {
            "description": "The account's email address",
            "type": "string"
          },
          "full_name": {
            "description": "The account holder's name",
            "type": "string"
          },
          "image_url": {
            "description": "URL of the profile image",
            "type": "string"
          },
          "is_email_verified": {
            "description": "Whether the account's email is verified",
            "type": "boolean"
          },
          "url": {
            "description": "URL of the Patreon profile",
            "type": "string"
          },
          "user_id": {
            "description": "The account's user ID",
            "type": "string"
          },
          "vanity": {
            "description": "The account's vanity (custom URL) name, if set",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_member": {
      "description": "Retrieve a single campaign member by ID, including their patron status, pledge amount, and entitled tiers.",
      "display_name": "Get member",
      "display_str_template": "Get Patreon member '{0}'.",
      "handler": "actions.get_member",
      "id": "patreon_get_member",
      "method": "POST",
      "mock_response": {
        "currently_entitled_amount_cents": 500,
        "email": "alex@example.com",
        "full_name": "Alex Chen",
        "id": "abcd1234-5678-90ef-ghij-klmnopqrstuv",
        "last_charge_date": "2026-07-01T05:00:00.000+00:00",
        "last_charge_status": "Paid",
        "lifetime_support_cents": 4800,
        "next_charge_date": "2026-08-01T05:00:00.000+00:00",
        "patron_status": "active_patron",
        "pledge_relationship_start": "2025-07-01T05:00:00.000+00:00",
        "tiers": [
          "Supporter"
        ],
        "user_id": "55554444"
      },
      "name": "get_member",
      "parameters": [
        {
          "description": "ID of the member to retrieve (from 'List members').",
          "display_name": "Member ID",
          "name": "member_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/patreon/get-member",
      "result_str_template": "Retrieved the member.",
      "returns": {
        "properties": {
          "currently_entitled_amount_cents": {
            "description": "The member's current pledge amount, in cents",
            "type": "number"
          },
          "email": {
            "description": "The member's email address",
            "type": "string"
          },
          "full_name": {
            "description": "The member's name",
            "type": "string"
          },
          "id": {
            "description": "Member ID",
            "type": "string"
          },
          "last_charge_date": {
            "description": "When the member was last charged (ISO 8601)",
            "type": "string"
          },
          "last_charge_status": {
            "description": "Status of the last charge (e.g. 'Paid', 'Declined')",
            "type": "string"
          },
          "lifetime_support_cents": {
            "description": "Total the member has ever paid this campaign, in cents",
            "type": "number"
          },
          "next_charge_date": {
            "description": "When the member is next scheduled to be charged (ISO 8601)",
            "type": "string"
          },
          "patron_status": {
            "description": "'active_patron', 'declined_patron', 'former_patron', or empty for a follower who has never pledged",
            "type": "string"
          },
          "pledge_relationship_start": {
            "description": "When the member first pledged (ISO 8601)",
            "type": "string"
          },
          "tiers": {
            "description": "Titles of the tiers the member is currently entitled to",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "user_id": {
            "description": "The member's underlying Patreon user ID",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_campaigns": {
      "description": "List the campaigns owned by the connected creator.",
      "display_name": "List campaigns",
      "display_str_template": "List Patreon campaigns.",
      "handler": "actions.list_campaigns",
      "id": "patreon_list_campaigns",
      "method": "POST",
      "mock_response": {
        "campaigns": [
          {
            "creation_name": "illustration tutorials",
            "id": "12345678",
            "is_monthly": true,
            "patron_count": 412,
            "pledge_url": "/join/jamiecreates",
            "published_at": "2024-03-01T10:00:00.000+00:00",
            "summary": "Weekly step-by-step drawing lessons.",
            "url": "https://www.patreon.com/jamiecreates",
            "vanity": "jamiecreates"
          }
        ]
      },
      "name": "list_campaigns",
      "parameters": [],
      "path": "/actions/library/patreon/list-campaigns",
      "result_str_template": "Fetched Patreon campaigns.",
      "returns": {
        "properties": {
          "campaigns": {
            "description": "The creator's campaigns",
            "items": {
              "properties": {
                "creation_name": {
                  "description": "What the creator is creating (e.g. 'illustration tutorials')",
                  "type": "string"
                },
                "id": {
                  "description": "Campaign ID. Use with the other actions.",
                  "type": "string"
                },
                "is_monthly": {
                  "description": "True if the campaign charges monthly, false if per-creation",
                  "type": "boolean"
                },
                "patron_count": {
                  "description": "Number of patrons on the campaign",
                  "type": "number"
                },
                "pledge_url": {
                  "description": "Relative URL of the campaign's join/pledge page",
                  "type": "string"
                },
                "published_at": {
                  "description": "When the campaign was published (ISO 8601), if published",
                  "type": "string"
                },
                "summary": {
                  "description": "The campaign's summary text",
                  "type": "string"
                },
                "url": {
                  "description": "URL of the campaign page",
                  "type": "string"
                },
                "vanity": {
                  "description": "The campaign's vanity (custom URL) name, if set",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_members": {
      "description": "List a campaign's members (patrons and followers), including each member's patron status, pledge amount, and entitled tiers.",
      "display_name": "List members",
      "display_str_template": "List members of the Patreon campaign '{0}'.",
      "handler": "actions.list_members",
      "id": "patreon_list_members",
      "method": "POST",
      "mock_response": {
        "members": [
          {
            "currently_entitled_amount_cents": 500,
            "email": "alex@example.com",
            "full_name": "Alex Chen",
            "id": "abcd1234-5678-90ef-ghij-klmnopqrstuv",
            "last_charge_date": "2026-07-01T05:00:00.000+00:00",
