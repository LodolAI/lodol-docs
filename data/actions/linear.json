          "name": "target_date",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/create-project",
      "result_str_template": "Linear project created.",
      "returns": {
        "properties": {
          "project": {
            "description": "The new project",
            "properties": {
              "description": {
                "description": "Its summary",
