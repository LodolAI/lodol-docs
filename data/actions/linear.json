{
  "actions": {
    "add_comment_to_issue": {
      "description": "Post a comment on a Linear issue thread.",
      "display_name": "Add a comment to a Linear issue",
      "display_str_template": "Add a comment to Linear issue '{0}'.",
      "handler": "actions.add_comment_to_issue",
      "id": "linear_add_comment",
      "method": "POST",
      "mock_response": {
        "comment": {
          "body": "Sample text content",
          "id": "abc123xyz789"
        }
      },
      "name": "add_comment_to_issue",
      "output_formatter": "actions.format_add_comment_to_issue_output",
      "parameters": [
        {
          "description": "Linear issue ID to comment on",
          "display_name": "Issue ID",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The comment text to post",
          "display_name": "Comment",
          "multiline": true,
          "name": "body",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/add-comment",
      "result_str_template": "Linear comment added.",
      "returns": {
        "properties": {
          "comment": {
            "description": "Comment details",
            "properties": {
              "body": {
                "description": "Comment text content (markdown format) that was posted to the issue",
                "type": "string"
              },
              "id": {
                "description": "Comment ID (UUID format)",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_issue": {
      "description": "Create a new Linear issue with optional project, description, priority, and assignee.",
      "display_name": "Create a Linear issue",
      "display_str_template": "Create a Linear issue titled '{0}' in team '{1}'.",
      "handler": "actions.create_issue",
      "id": "linear_create_issue",
      "method": "POST",
      "mock_response": {
        "issue": {
          "id": "abc123xyz789",
          "identifier": "abc123xyz789",
          "state": {
            "id": "state123",
            "name": "Todo",
            "type": "unstarted"
          },
          "title": "Sample Item",
          "url": "https://example.com/path/123"
        }
      },
      "name": "create_issue",
      "output_formatter": "actions.format_create_issue_output",
      "parameters": [
        {
          "description": "Linear team ID for the issue",
          "display_name": "Team ID",
          "name": "team_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Issue title",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Issue description. Markdown formatting is supported.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the project to add the issue to",
          "display_name": "Project ID",
          "name": "project_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Priority level, from 1 to 5",
          "display_name": "Priority",
          "name": "priority",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "ID of the user to assign the issue to",
          "display_name": "Assignee ID",
          "name": "assignee_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/create-issue",
      "result_str_template": "Linear issue created.",
      "returns": {
        "properties": {
          "issue": {
            "description": "Issue details",
            "properties": {
              "id": {
                "description": "Linear issue ID (UUID format)",
                "type": "string"
              },
              "identifier": {
                "description": "Human-readable issue identifier",
                "type": "string"
              },
              "state": {
                "description": "Initial workflow state of the created issue. Contains id (for transitioning other issues) and name (for display/filtering)",
                "properties": {
                  "id": {
                    "description": "State ID (UUID). Use this ID with linear_update_issue_state to transition other issues to this state.",
                    "type": "string"
                  },
                  "name": {
                    "description": "State name (e.g., 'Backlog', 'Todo', 'In Progress'). Shows the initial workflow status assigned to the new issue.",
                    "type": "string"
                  },
                  "type": {
                    "description": "State category, one of 'triage', 'backlog', 'unstarted', 'started', 'completed', 'canceled'. Stable across teams, unlike `name`, so branch on this rather than on the label.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "title": {
                "description": "Issue title/summary text. This is the main heading for the issue",
                "type": "string"
              },
              "url": {
                "description": "Web URL for viewing this issue in Linear's UI. Share this link with team members or use for notifications",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_issue_details": {
      "description": "Retrieve detailed information for a Linear issue.",
      "display_name": "Get Linear issue details",
      "display_str_template": "Fetch details for Linear issue '{0}'.",
      "handler": "actions.get_issue_details",
      "id": "linear_get_issue",
      "method": "POST",
      "mock_response": {
        "issue": {
          "description": "example_value",
          "id": "abc123xyz789",
          "identifier": "abc123xyz789",
          "state": {
            "id": "state123",
            "name": "Active",
            "type": "started"
          },
          "title": "Sample Item",
          "url": "https://example.com/path/123"
        }
      },
      "name": "get_issue_details",
      "output_formatter": "actions.format_get_issue_details_output",
      "parameters": [
        {
          "description": "Linear issue ID to fetch",
          "display_name": "Issue ID",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/get-issue",
      "result_str_template": "Retrieved Linear issue details.",
      "returns": {
        "properties": {
          "issue": {
            "description": "Issue details",
            "properties": {
              "description": {
                "description": "Full issue description in markdown format. May be empty if no description was provided",
                "type": "string"
              },
              "id": {
                "description": "Linear issue ID (UUID format)",
                "type": "string"
              },
              "identifier": {
                "description": "Human-readable issue identifier",
                "type": "string"
              },
              "state": {
                "description": "Current workflow state of the issue. Contains id and name for the issue's current status in the team's workflow",
                "properties": {
                  "id": {
                    "description": "State ID (UUID).",
                    "type": "string"
                  },
                  "name": {
                    "description": "State name (e.g., 'Todo', 'In Progress', 'Done').",
                    "type": "string"
                  },
                  "type": {
                    "description": "State category, one of 'triage', 'backlog', 'unstarted', 'started', 'completed', 'canceled'. Stable across teams, unlike `name`, so branch on this rather than on the label.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "title": {
                "description": "Issue title/summary text",
                "type": "string"
              },
              "url": {
                "description": "Web URL for viewing this issue in Linear's UI",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_issues": {
      "description": "Fetch the latest Linear issues for a specific team.",
      "display_name": "List Linear issues for a team",
      "display_str_template": "List Linear issues for team '{0}'.",
      "handler": "actions.list_issues",
      "id": "linear_list_issues",
      "method": "POST",
      "mock_response": {
        "issues": [
          {
            "id": "item123",
            "name": "Sample Task"
          }
        ]
      },
      "name": "list_issues",
      "output_formatter": "actions.format_list_issues_output",
      "parameters": [
        {
          "description": "Linear team ID to list issues for",
          "display_name": "Team ID",
          "name": "team_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of issues to return (1-50)",
          "display_name": "Maximum issues",
          "name": "first",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/linear/list-issues",
      "result_str_template": "Retrieved Linear issues.",
      "returns": {
        "properties": {
          "issues": {
            "description": "Array of Linear issues for the specified team. Each issue contains id (UUID for actions), identifier (human-readable), title, and state. Use issue id with linear_update_issue_state or linear_add_comment actions",
            "items": {
              "properties": {
                "id": {
                  "description": "Linear issue ID (UUID format)",
                  "type": "string"
                },
                "identifier": {
                  "description": "Human-readable issue identifier",
                  "type": "string"
                },
                "state": {
                  "description": "Current workflow state",
                  "type": "object"
                },
                "title": {
                  "description": "Issue title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_teams": {
      "description": "Fetch available Linear teams for the connected workspace.",
      "display_name": "List Linear teams",
      "display_str_template": "List all active Linear teams.",
      "handler": "actions.list_teams",
      "id": "linear_list_teams",
      "method": "POST",
      "mock_response": {
        "teams": [
          {
            "id": "team123",
            "key": "ENG",
            "name": "Engineering"
          }
        ]
      },
      "name": "list_teams",
      "output_formatter": "actions.format_list_teams_output",
      "parameters": [],
      "path": "/actions/library/linear/list-teams",
      "result_str_template": "Retrieved Linear teams.",
      "returns": {
        "properties": {
          "teams": {
            "description": "Array of Linear teams in the workspace. Each team contains id (use for creating/listing issues), name, and key (issue prefix). Use team id with linear_create_issue action",
            "items": {
              "properties": {
                "id": {
                  "description": "Team ID (UUID format)",
                  "type": "string"
                },
                "key": {
                  "description": "Team key prefix",
                  "type": "string"
                },
                "name": {
                  "description": "Team display name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "update_issue_state": {
      "description": "Move a Linear issue to a different workflow state, such as Todo or Done, using the new state's ID.",
      "display_name": "Update Linear issue state",
      "display_str_template": "Update Linear issue '{0}' to state '{1}'.",
      "handler": "actions.update_issue_state",
      "id": "linear_update_issue_state",
      "method": "POST",
      "mock_response": {
        "issue": {
          "id": "abc123xyz789",
          "identifier": "abc123xyz789",
          "state": {
            "id": "state123",
            "name": "Active",
            "type": "started"
          },
          "title": "Sample Item"
        }
      },
      "name": "update_issue_state",
      "output_formatter": "actions.format_update_issue_state_output",
      "parameters": [
        {
          "description": "Linear issue ID to update",
          "display_name": "Issue ID",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the workflow state to move the issue to",
          "display_name": "State ID",
          "name": "state_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/update-issue-state",
      "result_str_template": "Linear issue updated.",
      "returns": {
        "properties": {
          "issue": {
            "description": "Issue details",
            "properties": {
              "id": {
                "description": "Linear issue ID (UUID format)",
                "type": "string"
              },
              "identifier": {
                "description": "Human-readable issue identifier",
                "type": "string"
              },
              "state": {
                "description": "Current workflow state of the issue. Contains id (for transitioning other issues) and name (for display/filtering)",
                "properties": {
                  "id": {
                    "description": "State ID (UUID). Use this ID with linear_update_issue_state to transition other issues to this state.",
                    "type": "string"
                  },
                  "name": {
                    "description": "State name (e.g., 'Todo', 'In Progress', 'Done'). Shows the current workflow status.",
                    "type": "string"
                  },
                  "type": {
                    "description": "State category, one of 'triage', 'backlog', 'unstarted', 'started', 'completed', 'canceled'. Stable across teams, unlike `name`, so branch on this rather than on the label.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "title": {
                "description": "Issue title/summary text",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create and manage Linear issues with a personal API key.",
  "display_name": "Linear",
  "id": "linear"
}
