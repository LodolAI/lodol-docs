{
  "actions": {
    "add_comment_to_issue": {
      "description": "Post a comment on a Linear issue thread.",
      "display_name": "Add a comment to an issue",
      "display_str_template": "Add a comment to Linear issue '{0}'.",
      "handler": "actions.add_comment_to_issue",
      "id": "linear_add_comment",
      "method": "POST",
      "mock_response": {
        "comment": {
          "body": "Sample text content",
          "id": "abc123xyz789"
        }
      },
      "name": "add_comment_to_issue",
      "output_formatter": "actions.format_add_comment_to_issue_output",
      "parameters": [
        {
          "description": "Linear issue ID to comment on",
          "display_name": "Issue ID",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The comment text to post",
          "display_name": "Comment",
          "multiline": true,
          "name": "body",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/add-comment",
      "result_str_template": "Linear comment added.",
      "returns": {
        "properties": {
          "comment": {
            "description": "Comment details",
            "properties": {
              "body": {
                "description": "Comment text content (markdown format) that was posted to the issue",
                "type": "string"
              },
              "id": {
                "description": "Comment ID (UUID format)",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "add_link": {
      "description": "Attach a web link to a Linear issue, such as the support ticket or document it came from.",
      "display_name": "Add a link to an issue",
      "display_str_template": "Add a link to Linear issue '{0}'.",
      "handler": "actions.add_link",
      "id": "linear_add_link",
      "method": "POST",
      "mock_response": {
        "attachment": {
          "id": "att123",
          "title": "Support ticket #4521",
          "url": "https://support.example.com/tickets/4521"
        }
      },
      "name": "add_link",
      "output_formatter": "actions.format_add_link_output",
      "parameters": [
        {
          "description": "The issue, as an earlier step gave it, or its ID such as ENG-123",
          "display_name": "Issue",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The web address to attach, starting with https://",
          "display_name": "Link",
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What the link shows as on the issue. Leave blank to show the address.",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/add-link",
      "result_str_template": "Link added to the issue.",
      "returns": {
        "properties": {
          "attachment": {
            "description": "The link as it is on the issue",
            "properties": {
              "id": {
                "description": "The attachment's ID",
                "type": "string"
              },
              "title": {
                "description": "What it shows as",
                "type": "string"
              },
              "url": {
                "description": "The address linked",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_issue": {
      "description": "Create a new Linear issue with optional project, description, priority, and assignee.",
      "display_name": "Create an issue",
      "display_str_template": "Create an issue titled '{0}' in team '{1}'.",
      "handler": "actions.create_issue",
      "id": "linear_create_issue",
      "method": "POST",
      "mock_response": {
        "issue": {
          "id": "abc123xyz789",
          "identifier": "abc123xyz789",
          "state": {
            "id": "state123",
            "name": "Todo",
            "type": "unstarted"
          },
          "title": "Sample Item",
          "url": "https://example.com/path/123"
        }
      },
      "name": "create_issue",
      "output_formatter": "actions.format_create_issue_output",
      "parameters": [
        {
          "description": "The Linear team the issue belongs to",
          "display_name": "Team",
          "dynamic_source": "teams",
          "name": "team_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Issue title",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Issue description. Markdown formatting is supported.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the project to add the issue to",
          "display_name": "Project ID",
          "name": "project_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Priority level, from 1 to 5",
          "display_name": "Priority",
          "name": "priority",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "ID of the user to assign the issue to",
          "display_name": "Assignee ID",
          "name": "assignee_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linear/create-issue",
      "result_str_template": "Linear issue created.",
      "returns": {
        "properties": {
          "issue": {
            "description": "Issue details",
            "properties": {
              "id": {
                "description": "Linear issue ID (UUID format)",
                "type": "string"
              },
              "identifier": {
                "description": "Human-readable issue identifier",
                "type": "string"
              },
              "state": {
                "description": "Initial workflow state of the created issue. Contains id (for transitioning other issues) and name (for display/filtering)",
                "properties": {
                  "id": {
                    "description": "State ID (UUID). Use this ID with linear_update_issue_state to transition other issues to this state.",
                    "type": "string"
                  },
                  "name": {
                    "description": "State name (e.g., 'Backlog', 'Todo', 'In Progress'). Shows the initial workflow status assigned to the new issue.",
                    "type": "string"
                  },
                  "type": {
                    "description": "State category, one of 'triage', 'backlog', 'unstarted', 'started', 'completed', 'canceled'. Stable across teams, unlike `name`, so branch on this rather than on the label.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "title": {
                "description": "Issue title/summary text. This is the main heading for the issue",
                "type": "string"
              },
              "url": {
                "description": "Web URL for viewing this issue in Linear's UI. Share this link with team members or use for notifications",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_project": {
      "description": "Start a new project in Linear for a team, with an optional description and target date.",
      "display_name": "Create a project",
