              },
              "id": {
                "description": "The project's ID, for later steps",
                "type": "string"
              },
              "name": {
                "description": "Its name",
                "type": "string"
              },
              "state": {
                "description": "Where it stands, such as planned or started",
                "type": "string"
              },
              "target_date": {
                "description": "When it should be finished (YYYY-MM-DD); blank for none",
                "type": "string"
              },
              "url": {
                "description": "Link to the project in Linear",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
