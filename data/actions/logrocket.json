{
  "actions": {
    "list_audit_logs": {
      "description": "List entries from the project's audit log (who viewed a session or changed a setting, and when). Gets one page; to see more, run it again with the next page it gives.",
      "display_name": "List audit logs",
      "display_str_template": "List audit logs.",
      "handler": "actions.list_audit_logs",
      "id": "logrocket_list_audit_logs",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "has_next": false,
        "logs": [
          {
            "action": "Viewed session",
            "created_date": "2026-10-02T20:48:40.376852Z",
            "description": "1-aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee/1",
            "time": "10/02/26 08:48PM",
            "user": "jo@example.com"
          }
        ],
        "next_cursor": ""
      },
      "name": "list_audit_logs",
      "output_formatter": "actions.format_audit_logs_output",
      "parameters": [
        {
          "description": "Only entries from this time on.",
          "display_name": "Since",
          "name": "since",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "How many entries to return, 1 to 100.",
          "display_name": "Page size",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The 'next_cursor' from an earlier page, to get the page after it. Use instead of 'Since'.",
          "display_name": "Next page cursor",
          "name": "cursor",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/logrocket/list-audit-logs",
      "result_str_template": "Audit logs retrieved.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many entries this page holds",
            "type": "number"
          },
          "has_next": {
            "description": "True if there are more entries",
            "type": "boolean"
          },
          "logs": {
            "description": "The audit log entries",
            "items": {
              "properties": {
                "action": {
                  "description": "What was done, such as Viewed session",
                  "type": "string"
                },
                "created_date": {
                  "description": "When it happened, as an ISO 8601 time",
                  "type": "string"
                },
                "description": {
                  "description": "Details; for a viewed session, the session's id",
                  "type": "string"
                },
                "time": {
                  "description": "When it happened, as shown in LogRocket",
                  "type": "string"
                },
                "user": {
                  "description": "The email or system id of whoever did it",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass as 'Next page cursor' to get the next page",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "update_user": {
      "description": "Create a user in LogRocket, or update their name, email and traits (such as plan or company). Traits you send replace the old values, others stay, and a blank value removes a trait.",
      "display_name": "Update user",
      "display_str_template": "Update user {app_user_id}.",
      "handler": "actions.update_user",
      "id": "logrocket_update_user",
      "method": "POST",
      "mock_response": {
        "user": {
          "email": "jo@example.com",
          "name": "Jo Bloggs",
          "traits": {
            "plan": "free",
            "seats": "3"
          },
          "userID": "user-1234"
        },
        "user_id": "user-1234"
      },
      "name": "update_user",
      "output_formatter": "actions.format_user_output",
      "parameters": [
        {
          "description": "The id your app gives the user, the same one it passes to LogRocket.identify().",
          "display_name": "User ID",
          "examples": [
            {
              "label": "A user id",
              "value": "user-1234"
            }
          ],
          "name": "app_user_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The user's name, up to 1024 characters.",
          "display_name": "Name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The user's email address.",
          "display_name": "Email",
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Facts about the user, such as plan or company. Each value is text, a number or true/false, up to 1024 characters. Leave a value blank to remove that trait.",
          "display_name": "Traits",
          "examples": [
            {
              "label": "A plan",
              "value": "{\"plan\": \"pro\"}"
            }
          ],
          "name": "traits",
          "object_key_name": "Trait",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "When this was true of the user. LogRocket uses it for the user's first and last seen times. Defaults to now.",
          "display_name": "Seen at",
          "name": "seen_at",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/logrocket/update-user",
      "result_str_template": "User updated.",
      "returns": {
        "properties": {
          "user": {
            "description": "The user as LogRocket now holds it",
            "properties": {
              "email": {
                "description": "The user's email address",
                "type": "string"
              },
              "name": {
                "description": "The user's name",
                "type": "string"
              },
              "traits": {
                "description": "The user's traits (numbers and true/false come back as text)",
                "type": "object"
              },
              "userID": {
                "description": "The user's id",
                "type": "string"
              }
            },
            "type": "object"
          },
          "user_id": {
            "description": "The user's id",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    }
  },
  "categories": [
    "Analytics",
    "Monitoring"
  ],
  "description": "Keep LogRocket's user profiles current and read the project's audit log.",
  "display_name": "LogRocket",
  "id": "logrocket",
  "logo": "https://www.lodol.com/app-icons/logrocket-icon.svg",
  "triggers": {}
}
