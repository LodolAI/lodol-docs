{
  "actions": {
    "get_form": {
      "description": "Look up a form's name by ID.",
      "display_name": "Get form",
      "display_str_template": "Get Tally form '{0}'.",
      "handler": "actions.get_form",
      "id": "tally_get_form",
      "method": "POST",
      "mock_response": {
        "id": "wgKq4o",
        "name": "Customer Feedback"
      },
      "name": "get_form",
      "parameters": [
        {
          "description": "ID of the form to look up.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/tally/get-form",
      "result_str_template": "Retrieved the form.",
      "returns": {
        "properties": {
          "id": {
            "description": "Form ID",
            "type": "string"
          },
          "name": {
            "description": "Form name",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_forms": {
      "description": "List the forms in your Tally account.",
      "display_name": "List forms",
      "display_str_template": "List Tally forms.",
      "handler": "actions.list_forms",
      "id": "tally_list_forms",
      "method": "POST",
      "mock_response": {
        "forms": [
          {
            "id": "wgKq4o",
            "name": "Customer Feedback"
          }
        ]
      },
      "name": "list_forms",
      "parameters": [],
      "path": "/actions/library/tally/list-forms",
      "result_str_template": "Fetched Tally forms.",
      "returns": {
        "properties": {
          "forms": {
            "description": "List of forms in the account",
            "items": {
              "properties": {
                "id": {
                  "description": "Form ID. Use with the other actions.",
                  "type": "string"
                },
                "name": {
                  "description": "Form name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_submissions": {
      "description": "List the submissions received for a form.",
      "display_name": "List submissions",
      "display_str_template": "List submissions to Tally form '{0}'.",
      "handler": "actions.list_submissions",
      "id": "tally_list_submissions",
      "method": "POST",
      "mock_response": {
        "submissions": [
          {
            "answers": [
              {
                "answer": "Very satisfied",
                "field_id": "question_1"
              }
            ],
            "id": "sub_1abc2def",
            "submitted_at": "2026-01-15T10:00:00Z"
          }
        ]
      },
      "name": "list_submissions",
      "parameters": [
        {
          "description": "ID of the form to list submissions for.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of submissions to return (default 25).",
          "display_name": "Maximum submissions",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/tally/list-submissions",
      "result_str_template": "Fetched Tally submissions.",
      "returns": {
        "properties": {
          "submissions": {
            "description": "List of submissions",
            "items": {
              "properties": {
                "answers": {
                  "description": "The respondent's answers, one per field answered",
                  "items": {
                    "properties": {
                      "answer": {
                        "description": "The respondent's answer text",
                        "type": "string"
                      },
                      "field_id": {
                        "description": "ID of the question/field this answer belongs to",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "id": {
                  "description": "Submission ID",
                  "type": "string"
                },
                "submitted_at": {
                  "description": "Timestamp the submission was made",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your Tally account to browse forms and read their submissions.",
  "display_name": "Tally",
  "id": "tally"
}
