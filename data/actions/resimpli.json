    "list_appointments": {
      "description": "Paginated appointment list with date range, assignee, status, type, subtype, qualification, upcoming/past, and search filters.",
      "display_name": "Appointment list",
      "display_str_template": "Appointment list.",
      "handler": "actions.list_appointments",
      "id": "resimpli_list_appointments",
      "method": "POST",
      "mock_response": {
        "data": {}
      },
      "name": "list_appointments",
      "output_formatter": "november_service_provider.configure_provider.<locals>.<lambda>",
      "parameters": [
        {
          "default": 9,
          "description": "0 = seller appointment, 1 = buyer showing, 2 = contractor walk through, 3 = other.  Default 9 = all.",
          "display_name": "Appointment type",
          "name": "appointment_type",
          "options": [
            {
              "label": "Seller appointment",
              "value": 0
            },
            {
              "label": "Buyer showing",
              "value": 1
            },
            {
              "label": "Contractor walk through",
              "value": 2
            },
            {
              "label": "Other",
              "value": 3
            },
            {
              "label": "All",
              "value": 9
            }
          ],
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Required when type is seller appointment. 0 = in person, 1 = phone, 2 = drive by.",
          "display_name": "Appointment subtype",
          "name": "appointment_sub_type",
          "options": [
            {
              "label": "In person by appointment",
              "value": 0
            },
            {
              "label": "Phone appointment",
              "value": 1
            },
            {
              "label": "Drive by appointment",
              "value": 2
            }
          ],
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 9,
          "description": "0 = no answer, 1 = kept, 2 = not kept, 3 = dismiss. Default 9 = all.",
          "display_name": "Appointment status",
          "name": "appointment_status",
          "options": [
            {
              "label": "No answer",
              "value": 0
            },
            {
              "label": "Kept",
              "value": 1
            },
            {
              "label": "Not kept",
              "value": 2
            },
            {
              "label": "Dismiss",
              "value": 3
            },
            {
              "label": "All",
              "value": 9
            }
          ],
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 9,
          "description": "0 =not qualified, 1 = qualified. Default 9 = all.",
          "display_name": "Qualification",
          "name": "qualification",
          "options": [
            {
              "label": "Not qualified",
              "value": 0
            },
            {
              "label": "Qualified",
              "value": 1
            },
            {
              "label": "All",
              "value": 9
            }
          ],
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "True for upcoming appointments, false for past appointments.",
          "display_name": "Upcoming",
          "name": "is_upcoming",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Range start date.",
          "display_name": "Start date",
          "name": "start_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Range end date.",
          "display_name": "End date",
          "name": "end_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Filter by assigned user ObjectIds. If sent, at least one ID is required.",
          "display_name": "Assign user IDs",
          "name": "assign_user_id",
          "required": false,
          "schema": {
            "description": "Filter by assigned user ObjectIds. If sent, at least one ID is required.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Page.",
          "display_name": "Page",
          "minimum": 1,
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Results per page (minimum: 1, maximum: 100).",
          "display_name": "Limit",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/resimpli/list-appointments",
      "result_str_template": "Appointment list completed.",
      "returns": {
        "properties": {
