{
  "actions": {
    "analyze_image": {
      "description": "Ask Qwen a question about a picture, such as what it shows, what a receipt's total is, or whether a photo meets your rules, and get a written answer back.",
      "display_name": "Analyze an image",
      "display_str_template": "Ask Qwen about a picture.",
      "handler": "actions.analyze_image",
      "id": "qwen_analyze_image",
      "method": "POST",
      "mock_response": {
        "model": "qwen3.7-plus",
        "response_text": "A golden retriever sitting on a beach at sunset, looking towards the sea."
      },
      "name": "analyze_image",
      "parameters": [
        {
          "accepts_file_upload": true,
          "description": "The picture to look at: upload it, pick a file from an earlier step, or paste its public web address. JPEG, PNG, WebP or BMP, up to 10 MB.",
          "display_name": "Picture",
          "name": "image",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What you want to know about the picture, for example 'Describe this photo in two sentences' or 'What is the total on this receipt?'",
          "display_name": "Question",
          "multiline": true,
          "name": "question",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "qwen3.7-plus",
          "description": "Which Qwen model looks at the picture.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Qwen 3.7 Plus (balanced, recommended)",
              "value": "qwen3.7-plus"
            },
            {
              "label": "Qwen 3.8 Max (most capable)",
              "value": "qwen3.8-max"
            },
            {
              "label": "Qwen3-VL Plus (vision model)",
              "value": "qwen3-vl-plus"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "international",
          "description": "The Model Studio region your API key belongs to. Use International unless you created your key on the China (Beijing) console.",
          "display_name": "Region",
          "name": "region",
          "options": [
            {
              "label": "International (Singapore)",
              "value": "international"
            },
            {
              "label": "China (Beijing)",
              "value": "china"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/qwen/analyze-image",
      "result_str_template": "Qwen answered a question about a picture.",
      "returns": {
        "properties": {
          "model": {
            "description": "The model that answered.",
            "type": "string"
          },
          "response_text": {
            "description": "Qwen's answer.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
