{
  "actions": {
    "get_transcription": {
      "description": "Get Transcription Task.",
      "display_name": "Get Transcription Task",
      "display_str_template": "Get Transcription Task.",
      "handler": "actions.get_transcription",
      "id": "plaud_get_transcription",
      "method": "POST",
      "mock_response": {
        "data": {
          "data": {
            "duration": 0,
            "language": "example",
            "results": [],
            "text": "example"
          },
          "status": "PENDING",
          "transcription_id": "example"
        },
        "has_more": false,
        "next_cursor": "example"
      },
      "name": "get_transcription",
      "output_formatter": "catalog_rest.format_result",
      "parameters": [
        {
          "description": "The `transcription_id` returned when the audio was submitted.",
          "display_name": "Transcription ID",
          "name": "transcription_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/plaud/get-transcription",
      "result_str_template": "Request completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response returned by the service.",
            "properties": {
              "data": {
                "description": "Populated when the status is `SUCCESS`.",
                "properties": {
                  "duration": {
                    "description": "Audio duration in seconds.",
                    "type": "integer"
                  },
                  "language": {
                    "description": "Detected or specified language.",
                    "type": "string"
                  },
                  "results": {
                    "description": "Time-aligned transcript segments.",
                    "items": {
                      "properties": {
                        "end": {
                          "description": "Segment end time, in seconds.",
                          "type": "number"
                        },
                        "language": {
                          "description": "Language",
                          "type": "string"
                        },
                        "language_probabilitiy": {
                          "description": "Probability (0-1) of language confidence",
                          "type": "number"
                        },
                        "speaker_id": {
                          "description": "Speaker label, present when diarization is enabled.",
                          "type": "string"
                        },
                        "start": {
                          "description": "Segment start time, in seconds.",
                          "type": "number"
                        },
                        "text": {
                          "description": "Transcript text for the segment.",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "text": {
                    "description": "Full transcript text.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "status": {
                "description": "`PENDING`, `RECEIVED`, `STARTED`, `PROGRESS` indicate the task is in progress :  keep polling. `SUCCESS` means the data is ready. `FAILURE` and `REVOKED` are terminal failures.",
                "enum": [
                  "PENDING",
                  "RECEIVED",
                  "STARTED",
                  "PROGRESS",
                  "SUCCESS",
                  "FAILURE",
                  "REVOKED"
                ],
                "type": "string"
              },
              "transcription_id": {
                "description": "Transcription id.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "has_more": {
            "description": "Whether another page is available.",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Continuation token for the next page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "transcribe_audio": {
      "description": "Submit Audio for Transcription.",
      "display_name": "Submit Audio for Transcription",
      "display_str_template": "Submit Audio for Transcription.",
      "handler": "actions.transcribe_audio",
      "id": "plaud_transcribe_audio",
      "method": "POST",
      "mock_response": {
        "data": {
          "data": {},
          "status": "PENDING",
          "transcription_id": "example"
        },
        "has_more": false,
        "next_cursor": "example"
      },
      "name": "transcribe_audio",
      "output_formatter": "catalog_rest.format_result",
      "parameters": [
        {
          "description": "Pre-signed download URL returned by complete-upload (M4A, MP3, WAV).",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional transcription parameters.",
          "display_name": "Params",
          "name": "params",
          "required": false,
          "schema": {
            "description": "Optional transcription parameters.",
            "properties": {
              "diarization": {
                "properties": {
                  "enabled": {
                    "default": false,
                    "description": "Identify and label speakers.",
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "hotwords": {
                "description": "comma separated string of hotwords to use for custom vocabulary (i.e. \"plaud,gpt,destros\")",
                "type": "string"
              },
              "transcribe": {
                "properties": {
                  "detection_level": {
                    "default": "segment",
                    "description": "Language identification level (\"segment\" or \"chapter\").",
                    "type": "string"
                  },
                  "language": {
                    "default": "auto",
                    "description": "BCP-47 code (en-US, zh-CN, auto); defaults to auto.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "vad": {
                "properties": {
                  "decode_silence": {
                    "default": false,
                    "description": "Whether to decode silent regions.",
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/plaud/transcribe-audio",
      "result_str_template": "Request completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response returned by the service.",
            "properties": {
              "data": {
                "description": "Empty until the transcription completes.",
                "type": "object"
              },
              "status": {
                "description": "`PENDING`, `RECEIVED`, `STARTED`, `PROGRESS` indicate the task is in progress :  keep polling. `SUCCESS` means the data is ready. `FAILURE` and `REVOKED` are terminal failures.",
                "enum": [
                  "PENDING",
                  "RECEIVED",
                  "STARTED",
                  "PROGRESS",
                  "SUCCESS",
                  "FAILURE",
                  "REVOKED"
                ],
                "type": "string"
              },
              "transcription_id": {
                "description": "Identifier used to poll for results.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "has_more": {
            "description": "Whether another page is available.",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Continuation token for the next page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    }
  },
  "categories": [
    "Meeting Notes",
    "Voice AI"
  ],
  "description": "Submit audio to Plaud Embedded for transcription and retrieve task status and transcript results.",
  "display_name": "Plaud",
  "id": "plaud",
  "logo": "https://www.lodol.com/app-icons/plaud-icon.png",
  "triggers": {}
}
