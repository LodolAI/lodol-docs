  "description": "Create streaming events, monitor their status and retrieve recordings.",
  "display_name": "Restream",
  "id": "restream",
  "logo": "https://www.lodol.com/app-icons/restream-icon.png",
  "triggers": {
    "restream_event_started_trigger": {
      "description": "Runs each time an event is started in Restream. Ones started before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Event started",
      "id": "restream_event_started_trigger",
      "output": {
        "record": "object with the fields id, status, title, description, scheduledFor, startedAt, finishedAt, destinations"
      },
      "parameters": []
    },
    "restream_new_event_trigger": {
      "description": "Runs for each new upcoming event in Restream. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New upcoming event",
      "id": "restream_new_event_trigger",
      "output": {
        "record": "object with the fields id, status, title, description, scheduledFor, startedAt, finishedAt, destinations"
      },
      "parameters": []
    }
  }
