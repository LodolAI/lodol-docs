{
  "actions": {
    "add_to_page": {
      "description": "Add notes to an existing OneNote page, at the end or the start. Nothing already on the page is changed.",
      "display_name": "Add to page",
      "display_str_template": "Add to page {0}.",
      "handler": "actions.add_to_page",
      "id": "microsoft_onenote_add_to_page",
      "method": "POST",
      "mock_response": {
        "id": "page2",
        "updated": true
      },
      "name": "add_to_page",
      "parameters": [
        {
          "description": "The ID of the page, from Create page or List pages.",
          "display_name": "Page ID",
          "name": "page_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to add, written in HTML (for example, <p>Follow-up: send the minutes</p>).",
          "display_name": "Content to add",
          "multiline": true,
          "name": "html_content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "end",
          "description": "Add it at the end of the page (the default) or the start.",
          "display_name": "Where",
          "name": "position",
          "options": [
            {
              "label": "At the end",
              "value": "end"
            },
            {
              "label": "At the start",
              "value": "start"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onenote/add-to-page",
      "result_str_template": "Page updated.",
      "returns": {
        "properties": {
          "id": {
            "description": "Page ID.",
            "type": "string"
          },
          "updated": {
            "description": "Whether the content was added.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
