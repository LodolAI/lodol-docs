          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The point's latitude, for example 38.8977.",
          "display_name": "Latitude",
          "maximum": 90,
          "minimum": -90,
          "name": "latitude",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The point's longitude, for example -77.0365.",
          "display_name": "Longitude",
          "maximum": 180,
          "minimum": -180,
          "name": "longitude",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 0,
          "description": "How far from the point to look. 0 finds only what the point is inside or on, such as its zoning area.",
          "display_name": "Within",
          "maximum": 1000000,
          "minimum": 0,
          "name": "distance",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": "meters",
          "description": "The unit of the distance.",
          "display_name": "Unit",
          "name": "unit",
          "options": [
            {
              "label": "Meters",
              "value": "meters"
            },
            {
              "label": "Kilometers",
              "value": "kilometers"
            },
            {
              "label": "Feet",
              "value": "feet"
            },
            {
              "label": "Miles",
              "value": "miles"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A filter in ArcGIS's SQL style, combined with the filters above, for example POPULATION > 10000 AND STATE = 'TX'.",
          "display_name": "Advanced filter",
          "examples": [
            {
              "label": "Text value",
              "value": "STATUS = 'Open'"
            },
            {
              "label": "Number range",
              "value": "ACRES >= 5 AND ACRES < 50"
            },
            {
              "label": "Starts with",
              "value": "STREET LIKE 'MAIN%'"
            }
          ],
          "name": "where",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The fields each record includes. Leave empty for all of them.",
          "display_name": "Fields",
          "dynamic_source": "dataset_fields",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "dataset"
          ],
          "name": "fields",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "default": 25,
          "description": "The most records to return (up to 5,000).",
          "display_name": "Limit",
          "maximum": 5000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": "location",
          "description": "Whether each record includes where it is: a latitude and longitude (the middle of a line or area), or its full shape.",
          "display_name": "Location",
          "name": "geometry",
          "options": [
            {
              "label": "Leave it out",
              "value": "none"
            },
            {
              "label": "Latitude and longitude",
              "value": "location"
            },
            {
              "label": "Full shape (GeoJSON)",
              "value": "geojson"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/arcgis-hub/find-records-near",
