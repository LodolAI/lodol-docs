            {
              "label": "Atira (inside Earth's orbit)",
              "value": "IEO"
            },
            {
              "label": "Aten (Earth-crossing, a < 1 AU)",
              "value": "ATE"
            },
            {
              "label": "Apollo (Earth-crossing, a > 1 AU)",
              "value": "APO"
            },
            {
              "label": "Amor (just outside Earth's orbit)",
              "value": "AMO"
            },
            {
              "label": "Mars-crosser",
              "value": "MCA"
            },
            {
              "label": "Inner main belt",
              "value": "IMB"
            },
            {
              "label": "Main belt",
              "value": "MBA"
            },
            {
              "label": "Outer main belt",
              "value": "OMB"
            },
            {
              "label": "Jupiter trojan",
              "value": "TJN"
            },
            {
              "label": "Centaur",
              "value": "CEN"
            },
            {
              "label": "Trans-Neptunian object",
              "value": "TNO"
            },
            {
              "label": "Parabolic",
              "value": "PAA"
            },
            {
              "label": "Hyperbolic",
              "value": "HYA"
            },
            {
              "label": "Other asteroid",
              "value": "AST"
            }
