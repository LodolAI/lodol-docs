          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only asteroids of this spectral type, e.g. S (stony), C (carbon-rich) or M (metallic).",
          "display_name": "Spectral type",
          "examples": [
            {
              "label": "Stony",
              "value": "S"
            },
            {
              "label": "Metallic",
              "value": "M"
            }
          ],
          "name": "spectral_type",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only near-Earth objects.",
          "display_name": "Near-Earth only",
          "name": "near_earth_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Only asteroids NASA lists as potentially hazardous.",
          "display_name": "Potentially hazardous only",
          "name": "hazardous_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Only asteroids at least this wide, in kilometres. Leaves out asteroids whose size is unknown.",
          "display_name": "Minimum diameter (km)",
          "examples": [
            {
              "label": "Example",
              "value": "1"
            }
          ],
          "name": "min_diameter_km",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Only asteroids a spacecraft can reach with at most this change in velocity, in km/s (6 is a good reachable target).",
          "display_name": "Maximum delta-v (km/s)",
          "examples": [
            {
              "label": "Example",
              "value": "6"
            }
          ],
          "name": "max_delta_v_km_s",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional. A MongoDB-style JSON filter applied on top of the fields above, for any other field (a, e, i, q, ad, per, moid, H, albedo, price, profit, score). Comparison operators ($lt, $lte, $gt, $gte, $ne, $in, $nin, $exists, $regex) and $and, $or, $nor, $not are allowed; anything else is refused.",
          "display_name": "Advanced filter",
          "examples": [
            {
              "label": "Example",
              "value": "{\"e\": {\"$lt\": 0.1}, \"i\": {\"$lt\": 4}}"
            }
          ],
          "multiline": true,
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many asteroids to return, 1 to 100. Defaults to 10.",
          "display_name": "Number of results",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
