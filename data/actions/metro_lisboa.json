        "count": 4,
        "disrupted_count": 0,
        "lines": [
          {
            "color": "#FFC425",
            "is_normal": true,
            "line_id": "yellow",
            "message_pt": null,
            "message_type": "0",
            "name": "Yellow Line",
            "name_pt": "Linha Amarela",
            "status": "Normal service"
          },
          {
            "color": "#5591CD",
            "is_normal": true,
            "line_id": "blue",
            "message_pt": null,
            "message_type": "0",
            "name": "Blue Line",
            "name_pt": "Linha Azul",
            "status": "Normal service"
          },
          {
            "color": "#00AAA6",
            "is_normal": true,
            "line_id": "green",
            "message_pt": null,
            "message_type": "0",
            "name": "Green Line",
            "name_pt": "Linha Verde",
            "status": "Normal service"
          },
          {
            "color": "#EE2B74",
            "is_normal": true,
            "line_id": "red",
            "message_pt": null,
            "message_type": "0",
            "name": "Red Line",
            "name_pt": "Linha Vermelha",
            "status": "Normal service"
          }
        ],
        "source_url": "https://www.metrolisboa.pt/en/",
        "summary": "Normal service on all lines"
      },
      "name": "get_line_status",
      "parameters": [
        {
          "description": "Only check this line. Leave empty for all four. Portuguese names such as 'azul' work too.",
          "display_name": "Line",
          "name": "line",
          "options": [
            {
              "label": "Yellow Line (Linha Amarela)",
              "value": "yellow"
            },
            {
              "label": "Blue Line (Linha Azul)",
              "value": "blue"
            },
            {
              "label": "Green Line (Linha Verde)",
              "value": "green"
            },
            {
              "label": "Red Line (Linha Vermelha)",
              "value": "red"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/metro-lisboa/get-line-status",
      "result_str_template": "{metro_lisboa_get_line_status,summary}.",
      "returns": {
        "properties": {
          "all_normal": {
            "description": "True when every listed line is running normally.",
            "type": "boolean"
          },
          "count": {
            "description": "How many lines are listed.",
            "type": "integer"
          },
          "disrupted_count": {
            "description": "How many of the listed lines are not running normally.",
            "type": "integer"
          },
          "lines": {
            "description": "Each line's status, in Metro de Lisboa's order (Yellow, Blue, Green, Red).",
            "items": {
              "properties": {
                "color": {
                  "description": "The line's color as a hex code, e.g. '#5591CD'.",
                  "type": "string"
                },
                "is_normal": {
                  "description": "True when trains on the line are running normally.",
                  "type": "boolean"
                },
                "line_id": {
                  "description": "The line's id: 'yellow', 'blue', 'green' or 'red'.",
                  "type": "string"
                },
                "message_pt": {
                  "description": "Metro de Lisboa's notice about the line, in Portuguese, as written. Empty during normal service.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "message_type": {
                  "description": "Metro de Lisboa's code for the kind of notice; '0' during normal service.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "description": "The line's name in English, e.g. 'Blue Line'.",
                  "type": "string"
                },
                "name_pt": {
                  "description": "The line's name in Portuguese, e.g. 'Linha Azul'.",
                  "type": "string"
                },
                "status": {
                  "description": "'Normal service', 'Disrupted', or 'Unknown' when the feed says nothing.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "source_url": {
            "description": "Metro de Lisboa's website, to credit or link to.",
            "type": "string"
          },
          "summary": {
            "description": "One line about the network, e.g. 'Normal service on all lines', or each disrupted line with its notice.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    }
  },
  "categories": [
    "Maps & Travel"
