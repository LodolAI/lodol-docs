                  "type": "string"
                },
                "time_start": {
                  "description": "When the event starts.",
                  "type": "string"
                },
                "url": {
                  "description": "Link to the event page on Yelp.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
