{
  "actions": {
    "get_business_details": {
      "description": "Look up detailed information about a specific Yelp business.",
      "display_name": "Get business details",
      "display_str_template": "Get Yelp business details.",
      "handler": "actions.get_business_details",
      "id": "yelp_business_details",
      "method": "POST",
      "mock_response": {
        "categories": [
          "French",
          "Fine Dining"
        ],
        "id": "the-french-laundry-yountville",
        "name": "The French Laundry",
        "phone": "+17079442380",
        "price": "$$$$",
        "rating": 4.5,
        "review_count": 3200,
        "url": "https://www.yelp.com/biz/the-french-laundry-yountville"
      },
      "name": "get_business_details",
      "parameters": [
        {
          "description": "The ID of the Yelp business to look up.",
          "display_name": "Business ID",
          "name": "business_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/yelp/business-details",
      "result_str_template": "Business details retrieved.",
      "returns": {
        "description": "Detailed information about a single business.",
        "properties": {
          "categories": {
            "description": "Category labels, such as 'Italian' or 'Coffee & Tea'.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "Yelp business ID.",
            "type": "string"
          },
          "name": {
            "description": "Business name.",
            "type": "string"
          },
          "phone": {
            "description": "Business phone number.",
            "type": "string"
          },
          "price": {
            "description": "Price level, shown as $ to $$$$.",
            "type": "string"
          },
          "rating": {
            "description": "Average star rating from 1 to 5.",
            "type": "number"
          },
          "review_count": {
            "description": "Total number of reviews.",
            "type": "integer"
          },
          "url": {
            "description": "Link to the business page on Yelp.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_business_reviews": {
      "description": "List reviews for a Yelp business. Requires a Yelp Places Enhanced or Premium plan: API keys on the free Basic plan will get a 404 error from Yelp for this action.",
      "display_name": "Get business reviews",
      "display_str_template": "Get Yelp reviews for '{business_id}'.",
      "handler": "actions.get_business_reviews",
      "id": "yelp_business_reviews",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "reviews": [
          {
            "id": "xAG4O7l-t1ubbwVAlPnDKg",
            "rating": 5,
            "text": "Amazing meal from start to finish.",
            "time_created": "2024-05-01 12:00:00",
            "url": "https://www.yelp.com/biz/the-french-laundry-yountville",
            "user": "Alex M."
          }
        ]
      },
      "name": "get_business_reviews",
      "parameters": [
        {
          "description": "The ID of the Yelp business to get reviews for.",
          "display_name": "Business ID",
          "name": "business_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of reviews to return. Yelp's API caps this endpoint at 3 review excerpts regardless of the value requested.",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/yelp/business-reviews",
      "result_str_template": "Reviews retrieved.",
      "returns": {
        "properties": {
          "count": {
            "description": "Number of reviews returned.",
            "type": "integer"
          },
          "reviews": {
            "description": "Review excerpts for the business.",
            "items": {
              "properties": {
                "id": {
                  "description": "Yelp review ID.",
                  "type": "string"
                },
                "rating": {
                  "description": "Star rating from 1 to 5.",
                  "type": "integer"
                },
                "text": {
                  "description": "Excerpt of the review text.",
                  "type": "string"
                },
                "time_created": {
                  "description": "When the review was written.",
                  "type": "string"
                },
                "url": {
                  "description": "Link to the full review on Yelp.",
                  "type": "string"
                },
                "user": {
                  "description": "Name of the reviewer.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "search_businesses": {
      "description": "Search for businesses on Yelp by keyword and location.",
      "display_name": "Search businesses",
      "display_str_template": "Search Yelp for '{term}' in '{location}'.",
      "handler": "actions.search_businesses",
      "id": "yelp_search_businesses",
      "method": "POST",
      "mock_response": {
        "businesses": [
          {
            "id": "the-french-laundry-yountville",
            "location": "6640 Washington St",
            "name": "The French Laundry",
            "phone": "+17079442380",
            "rating": 4.5,
            "review_count": 3200,
            "url": "https://www.yelp.com/biz/the-french-laundry-yountville"
          }
        ],
        "count": 1
      },
      "name": "search_businesses",
      "parameters": [
        {
          "description": "What to search for, such as a cuisine, business name, or keyword.",
          "display_name": "Term",
          "name": "term",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "City, neighborhood, or address to search in.",
          "display_name": "Location",
          "name": "location",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of results to return. Defaults to 5.",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Filter results by a Yelp category, for example restaurants.",
          "display_name": "Categories",
          "name": "categories",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only show businesses at this price level.",
          "display_name": "Price level",
          "name": "price",
          "options": [
            {
              "label": "$ (least expensive)",
              "value": "1"
            },
            {
              "label": "$$",
              "value": "2"
            },
            {
              "label": "$$$",
              "value": "3"
            },
            {
              "label": "$$$$ (most expensive)",
              "value": "4"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "best_match",
          "description": "How to order the businesses. Defaults to best match.",
          "display_name": "Sort results by",
          "name": "sort_by",
          "options": [
            {
              "label": "Best match",
              "value": "best_match"
            },
            {
              "label": "Highest rated",
              "value": "rating"
            },
            {
              "label": "Most reviewed",
              "value": "review_count"
            },
            {
              "label": "Closest first",
              "value": "distance"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Set to true to only include businesses that are open right now.",
          "display_name": "Open now",
          "name": "open_now",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/yelp/search-businesses",
      "result_str_template": "Businesses retrieved.",
      "returns": {
        "properties": {
          "businesses": {
            "description": "Matching businesses, best match first.",
            "items": {
              "properties": {
                "id": {
                  "description": "Yelp business ID. Pass this to other Yelp actions.",
                  "type": "string"
                },
                "location": {
                  "description": "Street address of the business.",
                  "type": "string"
                },
                "name": {
                  "description": "Business name.",
                  "type": "string"
                },
                "phone": {
                  "description": "Business phone number.",
                  "type": "string"
                },
                "rating": {
                  "description": "Average star rating from 1 to 5.",
                  "type": "number"
                },
                "review_count": {
                  "description": "Total number of reviews.",
                  "type": "integer"
                },
                "url": {
                  "description": "Link to the business page on Yelp.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "count": {
            "description": "Number of businesses returned.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "search_events": {
      "description": "Find events on Yelp by location. Requires your Yelp app to be enrolled in Yelp's developer beta: join from the app's 'Manage App' page, otherwise this returns a 403 NOT_IN_DEVELOPER_BETA error.",
