{
  "actions": {
    "create_branch": {
      "description": "Create a new branch in a GitLab project from an existing branch or commit.",
      "display_name": "Create branch",
      "display_str_template": "Create branch '{1}' in project {0}.",
      "handler": "actions.create_branch",
      "id": "gitlab_create_branch",
      "method": "POST",
      "mock_response": {
        "branch": {
          "commit_id": "b83d6e391c22777fca1ed3012fce84f633d7fed0",
          "default": false,
          "name": "feature/login",
          "protected": false,
          "web_url": "https://gitlab.com/user/project/-/tree/feature/login"
        }
      },
      "name": "create_branch",
      "parameters": [
        {
          "description": "The project to act on. Pick one from the list, or enter the project path shown in its web address (for example, 'my-group/my-project') or its numeric project ID.",
          "display_name": "Project",
          "dynamic_source": "projects",
          "examples": [
            {
              "label": "Project path",
              "value": "my-group/my-project"
            },
            {
              "label": "Project ID",
              "value": "123"
            }
          ],
          "name": "project",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name for the new branch (for example, 'feature/login').",
          "display_name": "New branch name",
          "name": "branch",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The existing branch to create the new branch from (for example, 'main'). Pick one once you've chosen a project.",
          "display_name": "Start from branch",
          "dynamic_source": "branches",
          "dynamic_source_depends_on": [
            "project"
          ],
          "name": "ref",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gitlab/create-branch",
      "result_str_template": "Created branch '{0}'.",
      "returns": {
        "description": "Response envelope; the payload is in the \"branch\" field.",
        "properties": {
          "branch": {
            "properties": {
              "commit_id": {
                "type": "string"
              },
              "default": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "protected": {
                "type": "boolean"
              },
              "web_url": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_comment": {
      "description": "Add a comment to a GitLab issue or merge request.",
      "display_name": "Create comment",
      "display_str_template": "Comment on {1} #{2} in project {0}.",
      "handler": "actions.create_comment",
      "id": "gitlab_create_comment",
      "method": "POST",
      "mock_response": {
        "note": {
          "body": "This is a comment.",
          "id": 101
        }
      },
      "name": "create_comment",
      "parameters": [
        {
          "description": "The project to act on. Pick one from the list, or enter the project path shown in its web address (for example, 'my-group/my-project') or its numeric project ID.",
          "display_name": "Project",
          "dynamic_source": "projects",
          "examples": [
            {
              "label": "Project path",
              "value": "my-group/my-project"
            },
            {
              "label": "Project ID",
              "value": "123"
            }
          ],
          "name": "project",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "issue",
          "description": "Whether to comment on an issue or a merge request.",
          "display_name": "Comment on",
          "name": "target_type",
          "options": [
            {
              "label": "Issue",
              "value": "issue"
            },
            {
              "label": "Merge request",
              "value": "merge_request"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The issue or merge request to comment on. Pick one once you've chosen a project and whether it's an issue or a merge request, or enter its number (for example, 5).",
          "display_name": "Issue or merge request",
          "dynamic_source": "comment_targets",
          "dynamic_source_depends_on": [
            "project",
            "target_type"
          ],
          "name": "target_iid",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The text of the comment.",
          "display_name": "Comment",
          "multiline": true,
          "name": "body",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gitlab/create-comment",
      "result_str_template": "Added comment.",
      "returns": {
        "description": "Response envelope; the payload is in the \"note\" field.",
        "properties": {
          "note": {
            "properties": {
              "body": {
                "type": "string"
              },
              "id": {
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
