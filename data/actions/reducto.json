{
  "actions": {
    "parse_pdf": {
      "description": "Parse a PDF (or other supported document) with Reducto and return its extracted content as structured chunks.",
      "display_name": "Parse PDF",
      "display_str_template": "Parse a PDF with Reducto",
      "handler": "actions.parse_pdf",
      "id": "reducto_parse_pdf",
      "method": "POST",
      "mock_response": {
        "job_id": "job-abc123",
        "result": {
          "chunks": [
            {
              "content": "# Invoice\n\nInvoice number: INV-2024-001",
              "embed": "Invoice number: INV-2024-001"
            },
            {
              "content": "Total due: $1,234.56",
              "embed": "Total due: $1,234.56"
            }
          ],
          "type": "full"
        },
        "status": "success",
        "usage": {
          "num_pages": 2
        }
      },
      "name": "parse_pdf",
      "output_formatter": "actions.format_parse_pdf_output",
      "parameters": [
        {
          "accepts_file_upload": true,
          "description": "The PDF to parse, given by its public URL or uploaded here. Uploaded files are sent to Reducto first, then parsed.",
          "display_name": "File",
          "name": "file",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/reducto/parse-pdf",
      "result_str_template": "Document parsed successfully",
      "returns": {
        "properties": {
          "job_id": {
            "description": "Reducto job id for this parse",
            "type": "string"
          },
          "result": {
            "description": "The parse result. A 'full' result carries the extracted content under 'chunks'; a 'url' result carries a presigned download link when the payload is too large to inline.",
            "properties": {
              "chunks": {
                "description": "Extracted content chunks",
                "items": {
                  "properties": {
                    "content": {
                      "description": "The chunk's extracted text",
                      "type": "string"
                    },
                    "embed": {
                      "description": "Content optimized for embedding",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "type": {
                "description": "'full' or 'url'",
                "type": "string"
              }
            },
            "type": "object"
          },
          "status": {
            "type": "string"
          },
          "usage": {
            "description": "Usage metadata (e.g. num_pages) for the parse",
            "properties": {
              "num_pages": {
                "description": "Number of pages parsed",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Turn PDFs and other documents into clean, structured content with Reducto's document parsing.",
  "display_name": "Reducto",
  "id": "reducto"
}
