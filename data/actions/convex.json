    "list_audit_log_events": {
      "description": "List changes made to the deployment, oldest first: code pushed, environment variables changed, data edited in the dashboard and more, with who made each. Needs a Convex Pro plan.",
      "display_name": "List audit log events",
      "display_str_template": "List audit log events in Convex.",
