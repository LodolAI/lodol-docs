              "properties": {
                "action": {
                  "description": "What was done, such as update_environment_variable",
                  "nullable": true,
                  "type": "string"
                },
                "actor": {
                  "description": "Who did it: a team member, a token, or system",
                  "type": "string"
                },
                "client_ip": {
                  "description": "The address it was made from, if known",
                  "nullable": true,
                  "type": "string"
                },
                "created_at": {
                  "description": "When (ISO 8601, UTC)",
                  "nullable": true,
                  "type": "string"
                },
                "metadata": {
                  "description": "Details of the change",
                  "nullable": true,
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "description": "True if there are more",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Give this as Next page cursor for more; empty at the end",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
