          "description": "Only changes made at or after this time. Defaults to the last 24 hours.",
          "display_name": "Since",
          "name": "since",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "How many to return, 1 to 100. Defaults to 100.",
          "display_name": "Page size",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The 'next_cursor' from an earlier page, with the same Since, to get the page after it.",
          "display_name": "Next page cursor",
          "name": "cursor",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/convex/list-audit-log-events",
      "result_str_template": "Audit log events listed.",
