{
  "actions": {
    "create_collection": {
      "description": "Create a collection, such as for a project, at the top or inside another. One of that name already there is answered as it is.",
      "display_name": "Create collection",
      "display_str_template": "Create Linkwarden collection '{0}'.",
      "handler": "actions.create_collection",
      "id": "linkwarden_create_collection",
      "method": "POST",
      "mock_response": {
        "already_existed": false,
        "description": "Things to read",
        "id": 3,
        "link": "https://cloud.linkwarden.app/collections/3",
        "link_count": 0,
        "name": "Reading",
        "parent_id": 0,
        "path": "Reading",
        "public": false,
        "shared": false
      },
      "name": "create_collection",
      "output_formatter": "actions.format_collection",
      "parameters": [
        {
          "description": "The collection's name.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What it is for.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Make it inside this collection. Leave blank for the top.",
          "display_name": "Inside",
          "dynamic_source": "collections",
          "dynamic_source_allows_custom": true,
          "name": "parent",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/linkwarden/create-collection",
      "result_str_template": "Collection {linkwarden_create_collection,id} ready.",
      "returns": {
        "properties": {
          "already_existed": {
            "description": "Whether a collection of that name was already there",
            "type": "boolean"
          },
          "description": {
            "description": "Its description",
            "type": "string"
          },
          "id": {
            "description": "The collection's ID",
            "type": "number"
          },
          "link": {
            "description": "A link to it in Linkwarden",
            "type": "string"
          },
          "link_count": {
            "description": "How many links are in it",
            "type": "number"
          },
          "name": {
            "description": "Its name",
            "type": "string"
          },
          "parent_id": {
            "description": "The ID of the collection it is in; 0 at the top",
            "type": "number"
          },
          "path": {
            "description": "Its name with the collections it is in, such as Work / Reading",
            "type": "string"
          },
          "public": {
            "description": "Whether anyone with its link can see it",
            "type": "boolean"
          },
          "shared": {
            "description": "Whether it is shared with other people",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_collection": {
      "description": "Delete an empty collection. One with links or collections in it is refused, because Linkwarden would delete them too.",
