    "send_template_email": {
      "description": "Send one of your Brevo email templates to one person, filling in its {{ params.NAME }} placeholders. The template's sender and subject are used unless you give others.",
      "display_name": "Send template email",
      "display_str_template": "Send template email to {1}.",
      "handler": "actions.send_template_email",
      "id": "brevo_send_template_email",
      "method": "POST",
      "mock_response": {
        "messageId": "<202611071200.44445555666@smtp-relay.brevo.com>",
        "template_id": 12,
        "to_email": "contact@example.com"
      },
      "name": "send_template_email",
      "parameters": [
        {
          "description": "The email template to send.",
          "display_name": "Template",
          "dynamic_source": "templates",
          "dynamic_source_allows_custom": true,
          "name": "template_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Recipient email",
          "display_name": "To email",
          "name": "to_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Recipient name",
          "display_name": "To name",
          "name": "to_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Values for the template's placeholders, by name: ORDER becomes {{ params.ORDER }}.",
          "display_name": "Template values",
          "name": "params",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "A verified sender email to use instead of the template's.",
          "display_name": "Sender email",
          "name": "sender_email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A sender name to use instead of the template's.",
          "display_name": "Sender name",
          "name": "sender_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A subject to use instead of the template's.",
          "display_name": "Subject",
          "name": "subject",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/brevo/send-template-email",
      "result_str_template": "Template email sent.",
      "returns": {
        "properties": {
          "messageId": {
            "description": "Brevo's ID for the email sent.",
            "type": "string"
          },
          "template_id": {
            "description": "The template sent.",
            "type": "integer"
          },
          "to_email": {
            "description": "Who it was sent to.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
