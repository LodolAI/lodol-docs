{
  "actions": {
    "add_contact_to_list": {
      "description": "Add a contact to a Brevo list by email.",
      "display_name": "Add contact to list",
      "display_str_template": "Add contact {1} to list {0}",
      "handler": "actions.add_contact_to_list",
      "id": "brevo_add_contact_to_list",
      "method": "POST",
      "mock_response": {
        "contacts": {
          "failure": [],
          "success": [
            "contact@example.com"
          ]
        }
      },
      "name": "add_contact_to_list",
      "parameters": [
        {
          "description": "The ID of the Brevo list.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Contact email",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/brevo/add-contact-to-list",
      "result_str_template": "Contact added to list.",
      "returns": {
        "properties": {
          "contacts": {
            "properties": {
              "failure": {
                "type": "array"
              },
              "success": {
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_contact": {
      "description": "Create a Brevo contact and optionally add it to lists.",
      "display_name": "Create contact",
      "display_str_template": "Create Brevo contact {0}",
      "handler": "actions.create_contact",
      "id": "brevo_create_contact",
      "method": "POST",
      "mock_response": {
        "id": 42
      },
      "name": "create_contact",
      "parameters": [
        {
          "description": "Contact email",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The contact's details to save, such as first name, last name, or phone number.",
          "display_name": "Attributes",
          "name": "attributes",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "IDs of the lists to add the contact to.",
          "display_name": "List IDS",
          "name": "list_ids",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "default": false,
          "description": "Set to true to update the contact if one with this email already exists.",
          "display_name": "Update existing",
          "name": "update_existing",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/brevo/create-contact",
      "result_str_template": "Contact created.",
      "returns": {
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
