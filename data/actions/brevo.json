  "description": "Automate Brevo: send emails and templates, manage contacts and lists, and create email campaigns.",
  "display_name": "Brevo",
  "id": "brevo",
  "logo": "https://www.lodol.com/app-icons/brevo-icon.svg",
  "triggers": {
    "brevo_new_contact_trigger": {
      "description": "Runs for each new contact in your Brevo account, or each new contact on one list, with their email, name and attributes. Contacts already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New contact",
      "id": "brevo_new_contact_trigger",
      "output": {
        "attributes": "Every attribute Brevo holds for them.",
        "contact_id": "The contact's ID in Brevo.",
        "created_at": "When the contact was added.",
        "email": "Their email address.",
        "first_name": "Their first name (the FIRSTNAME attribute), if set.",
        "last_name": "Their last name (the LASTNAME attribute), if set.",
        "list_ids": "The IDs of the lists they're on."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only new contacts on this list. Leave blank for every new contact.",
          "display_name": "List",
          "name": "list_id",
          "required": false
        }
      ]
    }
