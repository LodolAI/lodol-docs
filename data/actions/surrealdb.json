    "create_record": {
      "description": "Create a record in a table, with an id made by SurrealDB or one you choose. Fails if that id already exists.",
      "display_name": "Create record",
      "display_str_template": "Create record in {table}.",
      "handler": "actions.create_record",
      "id": "surrealdb_create_record",
      "method": "POST",
      "mock_response": {
        "id": "person:ada",
        "record": {
          "age": 36,
          "id": "person:ada",
          "name": "Ada Lovelace"
        }
      },
      "name": "create_record",
      "output_formatter": "actions.format_written",
      "parameters": [
        {
          "description": "The table. Pick one, or type a name: a table that does not exist yet is created by its first record.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Your own id for the record, such as ada. Leave empty to have SurrealDB make one.",
          "display_name": "Record ID",
          "name": "record_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The record's fields as names and values, for example {\"name\": \"Ada\", \"age\": 36}. Dates are stored as text; use 'Run SurrealQL query' for a date-and-time field.",
          "display_name": "Fields",
          "name": "data",
          "object_key_name": "Field",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/surrealdb/create-record",
      "result_str_template": "Record {id} created.",
      "returns": {
        "properties": {
          "id": {
            "description": "The record's id, such as person:abc123",
            "type": "string"
          },
          "record": {
            "description": "The record, with its id",
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_record": {
      "description": "Delete one record by its id and return what it held. A record that is already gone is reported, not an error.",
      "display_name": "Delete record",
      "display_str_template": "Delete record {record_id}.",
      "handler": "actions.delete_record",
      "id": "surrealdb_delete_record",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": "person:ada",
        "record": {
          "age": 36,
          "id": "person:ada",
          "name": "Ada Lovelace"
        }
      },
      "name": "delete_record",
      "output_formatter": "actions.format_deleted",
      "parameters": [
        {
          "description": "The table. Pick one, or type a name: a table that does not exist yet is created by its first record.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The record's id, such as abc123, or the full id (person:abc123) from an earlier step.",
          "display_name": "Record ID",
          "name": "record_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/surrealdb/delete-record",
      "result_str_template": "Record {id} deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True if a record was deleted, false if none existed",
            "type": "boolean"
          },
          "id": {
            "description": "The record's id, such as person:abc123",
            "type": "string"
          },
          "record": {
            "description": "The record as it was before, empty if none existed",
            "type": [
              "object",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "find_records": {
