            {
              "label": "Largest or newest first",
              "value": "desc"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many records to return, 1 to 1000. Defaults to 100.",
          "display_name": "Page size",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How many records to skip before the first one returned. Use the 'next_start' of an earlier page to get the page after it.",
          "display_name": "Skip",
          "minimum": 0,
          "name": "start",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/surrealdb/find-records",
      "result_str_template": "{count} record(s) found.",
