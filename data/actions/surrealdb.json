          "type": "ParameterType.STRING"
        },
        {
          "default": "eq",
          "description": "How to compare the field with the value. Defaults to equals.",
          "display_name": "Filter operator",
          "name": "filter_operator",
          "options": [
            {
              "label": "Equals",
              "value": "eq"
            },
            {
              "label": "Does not equal",
              "value": "ne"
            },
            {
              "label": "Greater than",
              "value": "gt"
            },
            {
              "label": "Greater than or equal to",
              "value": "gte"
            },
            {
              "label": "Less than",
              "value": "lt"
            },
            {
              "label": "Less than or equal to",
              "value": "lte"
            },
            {
              "label": "Contains the text",
              "value": "contains"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The value to compare the field with.",
          "display_name": "Filter value",
          "name": "filter_value",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "text",
          "description": "What the value is, so it is compared as a number, date or true/false rather than as text. Defaults to text.",
          "display_name": "Filter value type",
          "name": "filter_value_type",
          "options": [
            {
              "label": "Text",
              "value": "text"
            },
            {
              "label": "Number",
              "value": "number"
            },
            {
              "label": "True or false",
              "value": "boolean"
            },
            {
              "label": "Date and time",
              "value": "datetime"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Field names separated by commas, such as name, age. The id is always included. Leave empty for every field.",
          "display_name": "Fields to return",
          "name": "fields",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The field to sort by. Leave empty for no sorting.",
          "display_name": "Sort by",
          "name": "order_by",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "asc",
          "description": "Which way to sort. Defaults to smallest first.",
          "display_name": "Sort order",
          "name": "order_direction",
          "options": [
            {
              "label": "Smallest or oldest first",
              "value": "asc"
