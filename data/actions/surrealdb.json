{
  "actions": {
    "calculate_field": {
      "description": "Add up, average, or find the smallest or largest value of a number field across a table's records. Add a filter to count or total only the records that match it.",
      "display_name": "Total a field",
      "display_str_template": "Calculate {field_name} in {table}.",
      "handler": "actions.calculate_field",
      "id": "surrealdb_calculate_field",
      "method": "POST",
      "mock_response": {
        "record_count": 12,
        "statistic": "sum",
        "value": 1280.5
      },
      "name": "calculate_field",
      "output_formatter": "actions.format_calculation",
      "parameters": [
        {
          "description": "The table. Pick one, or type a name: a table that does not exist yet is created by its first record.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The number field, such as price or stats.score.",
          "display_name": "Field",
          "name": "field_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "sum",
          "description": "What to work out. Defaults to the total.",
          "display_name": "Calculation",
          "name": "statistic",
          "options": [
            {
              "label": "Total",
              "value": "sum"
            },
            {
              "label": "Average",
              "value": "mean"
            },
            {
              "label": "Smallest",
              "value": "min"
            },
            {
              "label": "Largest",
              "value": "max"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only records whose field matches the value below, such as status or address.city. Leave empty for every record.",
          "display_name": "Filter field",
          "name": "filter_field",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "eq",
          "description": "How to compare the field with the value. Defaults to equals.",
          "display_name": "Filter operator",
          "name": "filter_operator",
          "options": [
            {
              "label": "Equals",
              "value": "eq"
            },
            {
              "label": "Does not equal",
              "value": "ne"
            },
            {
              "label": "Greater than",
              "value": "gt"
            },
            {
              "label": "Greater than or equal to",
              "value": "gte"
            },
            {
              "label": "Less than",
              "value": "lt"
            },
            {
              "label": "Less than or equal to",
              "value": "lte"
            },
            {
              "label": "Contains the text",
              "value": "contains"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The value to compare the field with.",
          "display_name": "Filter value",
          "name": "filter_value",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "text",
          "description": "What the value is, so it is compared as a number, date or true/false rather than as text. Defaults to text.",
          "display_name": "Filter value type",
          "name": "filter_value_type",
          "options": [
            {
              "label": "Text",
              "value": "text"
            },
            {
              "label": "Number",
              "value": "number"
            },
            {
              "label": "True or false",
              "value": "boolean"
            },
            {
              "label": "Date and time",
              "value": "datetime"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/surrealdb/calculate-field",
      "result_str_template": "Result: {value}.",
      "returns": {
        "properties": {
          "record_count": {
            "description": "How many records were included",
            "type": "integer"
          },
          "statistic": {
            "description": "The calculation that was made",
            "type": "string"
          },
          "value": {
            "description": "The result, empty if there were no values",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "check_health": {
      "description": "Check that the server and its storage answer. An unhealthy server is reported as 'healthy' false, not as a failed step.",
