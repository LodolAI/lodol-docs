    "create_branch": {
      "description": "Create a new branch in a repository. Points the new branch at the tip of an existing branch (defaults to the repository's default branch) unless you supply a specific commit SHA.",
      "display_name": "Create branch",
      "display_str_template": "Create branch {2} in {0}/{1}.",
      "handler": "actions.create_branch",
      "id": "github_create_branch",
      "method": "POST",
      "mock_response": {
        "name": "feature/new-widget",
        "ref": "refs/heads/feature/new-widget",
        "sha": "aa218f56b14c9653891f9e74264a383fa43fefbd"
      },
      "name": "create_branch",
      "parameters": [
        {
          "description": "The username or organization that owns the repository (the part before the '/' in 'owner/repo').",
          "display_name": "Repository owner",
          "dynamic_source": "owners",
          "examples": [
            {
              "label": "Example owner",
              "value": "octocat"
            }
          ],
          "name": "owner",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the repository (the part after the '/' in 'owner/repo').",
          "display_name": "Repository name",
          "dynamic_source": "repositories",
          "dynamic_source_depends_on": [
            "owner"
          ],
          "examples": [
            {
              "label": "Example repository",
              "value": "hello-world"
            }
          ],
          "name": "repo",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name for the new branch (without the 'refs/heads/' prefix).",
          "display_name": "New branch name",
          "examples": [
            {
              "label": "Example branch",
              "value": "feature/new-widget"
            }
          ],
          "name": "branch",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The existing branch to base the new one on. Defaults to the repository's default branch when not set.",
          "display_name": "Source branch",
          "dynamic_source": "branches",
          "dynamic_source_depends_on": [
            "owner",
            "repo"
          ],
          "name": "from_branch",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A specific commit SHA to point the new branch at. Takes precedence over the source branch when provided.",
          "display_name": "Source commit SHA",
          "name": "sha",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/github/create-branch",
      "result_str_template": "Created branch {0}.",
      "returns": {
        "properties": {
          "name": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
