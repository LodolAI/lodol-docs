{
  "actions": {
    "add_label_to_issue": {
      "description": "Add one or more labels to an issue, keeping the labels it already has.",
      "display_name": "Add label to issue",
      "display_str_template": "Add label {3} to issue #{2} in {0}/{1}.",
      "handler": "actions.add_label_to_issue",
      "id": "github_add_label_to_issue",
      "method": "POST",
      "mock_response": {
        "added": [
          "bug"
        ],
        "issue_number": 42,
        "labels": [
          "bug",
          "needs-triage"
        ]
      },
      "name": "add_label_to_issue",
      "parameters": [
        {
          "description": "The username or organization that owns the repository (the part before the '/' in 'owner/repo').",
          "display_name": "Repository owner",
          "dynamic_source": "owners",
          "examples": [
            {
              "label": "Example owner",
              "value": "octocat"
            }
          ],
          "name": "owner",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the repository (the part after the '/' in 'owner/repo').",
          "display_name": "Repository name",
          "dynamic_source": "repositories",
          "dynamic_source_depends_on": [
            "owner"
          ],
          "examples": [
            {
              "label": "Example repository",
              "value": "hello-world"
            }
          ],
          "name": "repo",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The open issue to act on.",
          "display_name": "Issue",
          "dynamic_source": "issues",
          "dynamic_source_depends_on": [
            "owner",
            "repo"
          ],
          "name": "issue_number",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The labels to add. Pick one, or enter several separated by commas.",
          "display_name": "Labels",
          "dynamic_source": "labels",
          "dynamic_source_depends_on": [
            "owner",
            "repo"
          ],
          "name": "labels",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/github/add-label-to-issue",
      "result_str_template": "Labeled issue #{0}.",
      "returns": {
        "properties": {
          "added": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "issue_number": {
            "type": "number"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
