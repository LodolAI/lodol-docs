  "categories": [
    "Video Conferencing",
    "Voice AI"
  ],
  "description": "LiveKit room, participant, ingress and agent dispatch Twirp APIs.",
  "display_name": "LiveKit",
  "id": "livekit",
  "logo": "https://www.lodol.com/app-icons/livekit-icon.ico",
  "triggers": {
    "livekit_new_ingress_trigger": {
      "description": "Runs each time an ingress is created in LiveKit. Ones created before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Ingress created",
      "id": "livekit_new_ingress_trigger",
      "output": {
        "record": "object with the fields ingress_id, name, room_name, participant_identity, url, stream_key, state"
      },
      "parameters": []
    },
    "livekit_new_or_updated_ingress_trigger": {
      "description": "Runs for each ingress added or changed in LiveKit. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Ingress added or updated",
      "id": "livekit_new_or_updated_ingress_trigger",
      "output": {
        "record": "object with the fields ingress_id, name, room_name, participant_identity, url, stream_key, state"
      },
      "parameters": []
    },
    "livekit_new_or_updated_rooms_trigger": {
      "description": "Runs for each room added or changed in LiveKit. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Room added or updated",
      "id": "livekit_new_or_updated_rooms_trigger",
      "output": {
        "record": "object with the fields sid, name, metadata, num_participants, creation_time"
      },
      "parameters": []
    },
    "livekit_new_rooms_trigger": {
      "description": "Runs each time a room is created in LiveKit. Ones created before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Room created",
      "id": "livekit_new_rooms_trigger",
      "output": {
        "record": "object with the fields sid, name, metadata, num_participants, creation_time"
      },
      "parameters": []
    }
  }
