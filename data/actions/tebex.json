  "categories": [
    "Gaming"
  ],
  "description": "Read a Tebex storefront, categories, packages, goals and recent payments.",
  "display_name": "Tebex",
  "id": "tebex",
  "logo": "https://www.lodol.com/app-icons/tebex-icon.png",
  "triggers": {
    "tebex_new_category_trigger": {
      "description": "Runs for each new category in Tebex. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New category",
      "id": "tebex_new_category_trigger",
      "output": {
        "record": "object with the fields id, name"
      },
      "parameters": []
    },
    "tebex_new_package_trigger": {
      "description": "Runs for each new package in Tebex. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New package",
      "id": "tebex_new_package_trigger",
      "output": {
        "record": "object with the fields id, name"
      },
      "parameters": []
    },
    "tebex_new_payment_trigger": {
      "description": "Runs for each new paid purchase in Tebex. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New paid purchase",
      "id": "tebex_new_payment_trigger",
      "output": {
        "record": "object with the fields id, created_at"
      },
      "parameters": []
    }
  }
