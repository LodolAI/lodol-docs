{
  "actions": {
    "get_consent": {
      "description": "Look up what a person has agreed to, purpose by purpose. A person Ketch has not heard from is not an error: 'has_consent_record' is false and the lists are empty.",
      "display_name": "Get consent",
      "display_str_template": "Get the consent of {0}.",
      "handler": "actions.get_consent",
      "id": "ketch_get_consent",
      "method": "POST",
      "mock_response": {
        "allowed_purposes": [
          "analytics"
        ],
        "denied_purposes": [
          "targeted_advertising"
        ],
        "email": "jane@example.com",
        "has_consent_record": true,
        "jurisdiction": "gdpr",
        "purposes": [
          {
            "allowed": true,
            "code": "analytics"
          },
          {
            "allowed": false,
            "code": "targeted_advertising"
          }
        ]
      },
      "name": "get_consent",
      "output_formatter": "actions.format_consent_output",
      "parameters": [
        {
          "description": "The email address Ketch knows the person by.",
          "display_name": "Email address",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The privacy regime the choices are for, such as gdpr or US_California. Leave empty for the property's default.",
          "display_name": "Jurisdiction",
          "dynamic_source": "jurisdictions",
          "dynamic_source_allows_custom": true,
          "name": "jurisdiction",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/ketch/get-consent",
      "result_str_template": "{ketch_get_consent,email} allows {ketch_get_consent,allowed_purposes}.",
      "returns": {
        "properties": {
          "allowed_purposes": {
            "description": "Codes of the purposes the person allows.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "denied_purposes": {
            "description": "Codes of the purposes the person denies.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "email": {
            "description": "The person's email address, lower-cased.",
            "type": "string"
          },
          "has_consent_record": {
            "description": "False when Ketch holds no choice from this person.",
            "type": "boolean"
          },
          "jurisdiction": {
            "description": "The jurisdiction the choices apply under.",
            "type": "string"
          },
          "purposes": {
            "description": "Each purpose the person has chosen for, and the choice.",
            "items": {
              "properties": {
                "allowed": {
                  "description": "True when the person allows this purpose.",
                  "type": "boolean"
                },
                "code": {
                  "description": "The purpose's code.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_property_settings": {
      "description": "Read what the connected Ketch property offers: its environments, jurisdictions, languages and the purposes people can consent to, with each one's legal basis.",
      "display_name": "Get property settings",
      "display_str_template": "Get the Ketch property's settings.",
      "handler": "actions.get_property_settings",
      "id": "ketch_get_property_settings",
      "method": "POST",
      "mock_response": {
        "default_jurisdiction": "default",
        "environment_code": "production",
        "environments": [
          "production"
        ],
        "jurisdictions": [
          "default",
          "gdpr",
          "US_California"
        ],
        "languages": [
          "en"
        ],
        "organization_code": "acme",
        "platform": "WEB",
        "property_code": "website",
        "property_name": "Website",
        "purpose_count": 1,
        "purposes": [
          {
            "code": "analytics",
            "description": "Cookies that measure how the website is used.",
            "legal_basis": "consent_optin",
            "name": "Data Analytics",
            "requires_opt_in": true
          }
        ]
      },
      "name": "get_property_settings",
      "output_formatter": "actions.format_property_settings_output",
      "parameters": [],
      "path": "/actions/library/ketch/get-property-settings",
      "result_str_template": "{ketch_get_property_settings,property_name} has {ketch_get_property_settings,purpose_count} purposes.",
      "returns": {
        "properties": {
          "default_jurisdiction": {
            "description": "The jurisdiction used when none is chosen.",
            "type": "string"
          },
          "environment_code": {
            "description": "The environment this connection uses.",
            "type": "string"
          },
          "environments": {
            "description": "Every environment the property has.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "jurisdictions": {
            "description": "Every jurisdiction the property applies.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "languages": {
            "description": "The languages its banner is offered in.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "organization_code": {
            "description": "The organization's code.",
            "type": "string"
          },
          "platform": {
            "description": "WEB, or the app platform.",
            "type": "string"
          },
          "property_code": {
            "description": "The property's code.",
            "type": "string"
          },
          "property_name": {
            "description": "The property's name.",
            "type": "string"
          },
          "purpose_count": {
            "description": "How many purposes the property has.",
            "type": "number"
          },
          "purposes": {
            "description": "The purposes people can consent to.",
            "items": {
              "properties": {
                "code": {
                  "description": "The purpose's code.",
                  "type": "string"
                },
                "description": {
                  "description": "What people are told the purpose is for.",
                  "type": "string"
                },
                "legal_basis": {
                  "description": "The legal basis, such as consent_optin.",
                  "type": "string"
                },
                "name": {
                  "description": "The purpose's display name.",
                  "type": "string"
                },
                "requires_opt_in": {
                  "description": "True when people must opt in.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "set_consent": {
      "description": "Record a person's consent choices in Ketch: purposes they allow and purposes they deny. Ketch keeps consent as a history, so a choice is changed by recording the opposite one. Only record what the person told you themselves.",
      "display_name": "Record consent",
      "display_str_template": "Record consent choices for {0}.",
      "handler": "actions.set_consent",
      "id": "ketch_set_consent",
      "method": "POST",
      "mock_response": {
        "allowed_purposes": [
          "analytics"
        ],
        "denied_purposes": [
          "targeted_advertising"
        ],
        "email": "jane@example.com",
        "has_consent_record": true,
        "jurisdiction": "gdpr",
        "purposes": [
          {
            "allowed": true,
            "code": "analytics"
          },
          {
            "allowed": false,
            "code": "targeted_advertising"
          }
        ],
        "recorded": true
      },
      "name": "set_consent",
      "output_formatter": "actions.format_consent_output",
      "parameters": [
        {
          "description": "The email address Ketch knows the person by.",
          "display_name": "Email address",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The privacy regime the choices are for, such as gdpr or US_California. Leave empty for the property's default.",
          "display_name": "Jurisdiction",
          "dynamic_source": "jurisdictions",
          "dynamic_source_allows_custom": true,
          "name": "jurisdiction",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The purposes the person agrees to.",
          "display_name": "Purposes allowed",
          "dynamic_source": "purposes",
          "dynamic_source_allows_custom": true,
          "multi_select": true,
          "name": "allowed_purposes",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The purposes the person declines.",
          "display_name": "Purposes denied",
          "dynamic_source": "purposes",
          "dynamic_source_allows_custom": true,
          "multi_select": true,
          "name": "denied_purposes",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/ketch/set-consent",
      "result_str_template": "Recorded consent for {ketch_set_consent,email}.",
      "returns": {
        "properties": {
          "allowed_purposes": {
            "description": "Codes of the purposes the person allows.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "denied_purposes": {
            "description": "Codes of the purposes the person denies.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "email": {
            "description": "The person's email address, lower-cased.",
            "type": "string"
          },
          "has_consent_record": {
            "description": "False when Ketch holds no choice from this person.",
            "type": "boolean"
          },
          "jurisdiction": {
            "description": "The jurisdiction the choices apply under.",
            "type": "string"
          },
          "purposes": {
            "description": "Each purpose the person has chosen for, and the choice.",
            "items": {
              "properties": {
                "allowed": {
                  "description": "True when the person allows this purpose.",
                  "type": "boolean"
                },
                "code": {
                  "description": "The purpose's code.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "recorded": {
            "description": "True once Ketch has stored the choices.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    }
  },
  "categories": [
    "Security"
  ],
  "description": "Read a Ketch property's purposes and jurisdictions, check what a person has consented to, and record their consent choices from your own forms and systems.",
