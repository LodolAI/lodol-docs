{
  "actions": {
    "add_tracks_to_playlist": {
      "description": "Add one or more tracks to a Spotify playlist.",
      "display_name": "Add tracks to playlist",
      "display_str_template": "Add tracks to the Spotify playlist.",
      "handler": "actions.add_tracks_to_playlist",
      "id": "spotify_add_tracks",
      "method": "POST",
      "mock_response": {
        "snapshot_id": "abc123xyz789"
      },
      "name": "add_tracks_to_playlist",
      "parameters": [
        {
          "description": "The playlist to add tracks to. Paste a Spotify playlist link, a spotify:playlist: URI, or the playlist's ID.",
          "display_name": "Playlist",
          "name": "playlist_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A list of tracks to add (up to 100). Each item can be a Spotify track link, a spotify:track: URI, or a track ID. Build the list with a Create a list step.",
          "display_name": "Tracks to add",
          "name": "track_uris",
          "required": true,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Where to place the tracks, counting from 0. Leave empty to add them at the end.",
          "display_name": "Insert position",
          "minimum": 0,
          "name": "position",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/spotify/add-tracks",
      "result_str_template": "Tracks added.",
      "returns": {
        "properties": {
          "snapshot_id": {
            "description": "Playlist snapshot ID representing the current version after tracks were added.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_playlist": {
      "description": "Create a new playlist in your connected Spotify account. You can add a description, choose whether it's public, and make it collaborative.",
      "display_name": "Create playlist",
      "display_str_template": "Create a Spotify playlist named '{name}'.",
      "handler": "actions.create_playlist",
      "id": "spotify_create_playlist",
      "method": "POST",
      "mock_response": {
        "playlist": {
          "collaborative": false,
          "id": "abc123xyz789",
          "name": "Sample Item",
          "public": false,
          "uri": "spotify:playlist:abc123xyz"
        }
      },
      "name": "create_playlist",
      "parameters": [
        {
          "description": "The name of the new playlist.",
          "display_name": "Playlist name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "An optional description shown on the playlist in Spotify.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Make the playlist visible on your public profile.",
          "display_name": "Public",
          "name": "public",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Let others add and remove tracks. A collaborative playlist must be private, so keep Public set to No.",
          "display_name": "Collaborative",
          "name": "collaborative",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/spotify/create-playlist",
      "result_str_template": "Playlist created.",
      "returns": {
        "properties": {
          "playlist": {
            "description": "Playlist details",
            "properties": {
              "collaborative": {
                "description": "Whether the playlist is collaborative",
                "nullable": true,
                "type": "boolean"
              },
              "id": {
                "description": "Spotify playlist ID",
                "type": "string"
              },
              "name": {
                "description": "Playlist name as created in Spotify",
                "type": "string"
              },
              "public": {
                "description": "Whether the playlist is public",
                "nullable": true,
                "type": "boolean"
              },
              "uri": {
                "description": "Spotify URI (format: spotify:playlist:xxx)",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
