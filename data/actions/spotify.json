    "get_current_playback": {
      "description": "Get details about what's currently playing on Spotify.",
      "display_name": "Get current playback",
      "display_str_template": "Fetch the current Spotify playback state.",
      "handler": "actions.get_current_playback",
      "id": "spotify_current_playback",
      "method": "POST",
      "mock_response": {
        "device": "Web Player",
        "is_playing": true,
        "progress_ms": 1,
        "track": {
          "artists": [
            "mock_value"
          ],
          "id": "abc123xyz789",
          "name": "Sample Item",
          "uri": "spotify:track:abc123xyz"
        }
      },
      "name": "get_current_playback",
      "parameters": [],
      "path": "/actions/library/spotify/current-playback",
      "result_str_template": "Playback state retrieved.",
      "returns": {
        "properties": {
          "device": {
            "description": "Active device name, or null when no device is active",
            "nullable": true,
            "type": "string"
          },
          "is_playing": {
            "description": "True if a track is currently playing, false if paused or nothing is playing",
            "type": "boolean"
          },
          "progress_ms": {
            "description": "Current playback position in milliseconds, or null when nothing is playing",
            "nullable": true,
            "type": "integer"
          },
          "track": {
            "description": "Currently playing track, or null when nothing is playing",
            "nullable": true,
            "properties": {
              "artists": {
                "description": "Array of artist names for the currently playing track",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "id": {
                "description": "Spotify track ID of the currently playing track",
                "type": "string"
              },
              "name": {
                "description": "Track name/title currently playing",
                "type": "string"
              },
              "uri": {
                "description": "Spotify URI",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
