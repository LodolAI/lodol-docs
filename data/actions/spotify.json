    "search": {
      "description": "Search Spotify for tracks, albums, artists, or playlists by keyword and return the top matches.",
      "display_name": "Search Spotify",
      "display_str_template": "Search Spotify for '{query}'.",
      "handler": "actions.search",
      "id": "spotify_search",
      "method": "POST",
      "mock_response": {
        "results": [
          {
            "artists": [
              "mock_value"
            ],
            "id": "abc123xyz789",
            "name": "Sample Item",
            "type": "track",
            "uri": "spotify:track:abc123xyz"
          }
        ]
      },
      "name": "search",
      "parameters": [
        {
          "description": "What to look for: a song, album, artist, or playlist.",
          "display_name": "Search terms",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "track",
          "description": "Choose the kind of item to search for.",
          "display_name": "What to search for",
          "name": "search_type",
          "options": [
            {
              "label": "Track",
              "value": "track"
            },
            {
              "label": "Album",
              "value": "album"
            },
            {
              "label": "Artist",
              "value": "artist"
            },
            {
              "label": "Playlist",
              "value": "playlist"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 5,
          "description": "How many results to return (1-50). Defaults to 5.",
          "display_name": "Number of results",
          "maximum": 50,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/spotify/search",
      "result_str_template": "Search results retrieved.",
      "returns": {
        "properties": {
          "results": {
            "description": "List of matching items.",
            "items": {
              "properties": {
                "artists": {
                  "description": "Artist names for a track or album; empty for artists and playlists.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "id": {
                  "description": "Spotify ID for the item.",
                  "type": "string"
                },
                "name": {
                  "description": "Item name/title.",
                  "type": "string"
                },
                "type": {
                  "description": "The result's kind: track, album, artist, or playlist.",
                  "type": "string"
                },
                "uri": {
                  "description": "Spotify URI (e.g. spotify:track:xxx).",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Search tracks, albums, and artists, build and edit playlists, save music to your library, and see what's playing on Spotify.",
  "display_name": "Spotify",
  "id": "spotify"
}
