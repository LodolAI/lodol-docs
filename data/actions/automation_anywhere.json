  "triggers": {
    "automation_anywhere_new_activity_trigger": {
      "description": "Runs for each new activity in Automation Anywhere. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New activity",
      "id": "automation_anywhere_new_activity_trigger",
      "output": {
        "record": "object with the fields id, name"
      },
      "parameters": []
    },
    "automation_anywhere_new_or_updated_activity_trigger": {
      "description": "Runs each time an activity added or changes in Automation Anywhere. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
