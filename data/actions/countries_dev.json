          {
            "alpha2Code": "US",
            "alpha3Code": "USA",
            "area": 9372610,
            "borders": [
              "CAN",
              "MEX"
            ],
            "callingCodes": [
              "1"
            ],
            "capital": "Washington, D.C.",
            "currencies": [
              {
                "code": "USD",
                "name": "United States dollar",
                "symbol": "$"
              }
            ],
            "flag": "https://countries.dev/flags/us.svg",
