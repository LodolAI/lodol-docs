          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional comma-separated list of fields to return, to keep the payload small (for example, name,capital,flag). Leave empty for the full country object.",
          "display_name": "Fields",
          "name": "fields",
          "required": false,
          "type": "ParameterType.STRING"
