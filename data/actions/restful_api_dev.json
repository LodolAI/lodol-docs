          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/restful-api-dev/get-object",
      "result_str_template": "Got {restful_api_dev_get_object,object,name}.",
      "returns": {
        "properties": {
          "object": {
            "description": "A restful-api.dev object.",
            "properties": {
              "created_at": {
                "description": "When the object was created, as ISO 8601 UTC. Only set on the answer to a create.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "data": {
                "description": "The object's own data, whatever fields it was given, e.g. {'year': 2019, 'price': 1849.99}. Null when it has none.",
                "type": [
                  "object",
                  "array",
                  "null"
                ]
              },
              "id": {
                "description": "The object's id: '1' to '13' for the samples, or a 32-character id for one you created.",
                "type": "string"
              },
              "name": {
                "description": "The object's name, e.g. 'Apple MacBook Pro 16'.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at": {
                "description": "When the object was changed, as ISO 8601 UTC. Only set on the answer to a replace or update.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_objects": {
      "description": "List restful-api.dev objects. With no ids you get its 13 sample objects (phones, laptops and tablets); with ids you get just those objects, including ones you created. No API key required.",
      "display_name": "List objects",
      "display_str_template": "List restful-api.dev objects {0}.",
      "handler": "actions.list_objects",
      "id": "restful_api_dev_list_objects",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "ids": [
          "7"
        ],
        "objects": [
          {
            "created_at": null,
            "data": {
              "CPU model": "Intel Core i9",
              "Hard disk size": "1 TB",
              "price": 1849.99,
              "year": 2019
            },
            "id": "7",
            "name": "Apple MacBook Pro 16",
            "updated_at": null
          }
        ]
      },
      "name": "list_objects",
      "output_formatter": "actions.format_objects_output",
      "parameters": [
        {
          "description": "The ids of the objects to get, up to 50. Leave empty for the 13 sample objects.",
          "display_name": "Ids",
          "name": "ids",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/restful-api-dev/list-objects",
      "result_str_template": "Listed {restful_api_dev_list_objects,count} objects.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many objects came back.",
            "type": "number"
          },
          "ids": {
            "description": "The ids asked for; empty for the samples.",
            "items": {
              "description": "One object id.",
              "type": "string"
            },
            "type": "array"
          },
          "objects": {
            "description": "The objects, in the order the service gave.",
            "items": {
              "description": "A restful-api.dev object.",
