{
  "actions": {
    "create_object": {
      "description": "Store a new object on restful-api.dev, with a name and any data you like, and get back its new id. It is really saved, and anyone with the id can read it, so keep it to test data. No API key required.",
      "display_name": "Create object",
      "display_str_template": "Create the restful-api.dev object {0}.",
      "handler": "actions.create_object",
      "id": "restful_api_dev_create_object",
      "method": "POST",
      "mock_response": {
        "object": {
          "created_at": "2026-10-16T18:27:03.241Z",
          "data": {
            "color": "Teal",
            "price": 12.5,
            "year": 2026
          },
          "id": "ff808181a09d98f701a145f7b1c9755b",
          "name": "Lodol QA test object",
          "updated_at": null
        }
      },
      "name": "create_object",
      "output_formatter": "actions.format_object_output",
      "parameters": [
        {
          "description": "The object's name.",
          "display_name": "Name",
          "examples": [
            {
              "label": "A product",
              "value": "Apple MacBook Pro 16"
            },
            {
              "label": "A test record",
              "value": "Lodol test object"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The object's data: any fields and values you like, such as year 2024 and color Teal.",
          "display_name": "Data",
          "name": "data",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/restful-api-dev/create-object",
      "result_str_template": "Created {restful_api_dev_create_object,object,name} with id {restful_api_dev_create_object,object,id}.",
      "returns": {
        "properties": {
          "object": {
            "description": "A restful-api.dev object.",
            "properties": {
              "created_at": {
                "description": "When the object was created, as ISO 8601 UTC. Only set on the answer to a create.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "data": {
                "description": "The object's own data, whatever fields it was given, e.g. {'year': 2019, 'price': 1849.99}. Null when it has none.",
                "type": [
                  "object",
                  "array",
                  "null"
                ]
              },
              "id": {
                "description": "The object's id: '1' to '13' for the samples, or a 32-character id for one you created.",
                "type": "string"
              },
              "name": {
                "description": "The object's name, e.g. 'Apple MacBook Pro 16'.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at": {
                "description": "When the object was changed, as ISO 8601 UTC. Only set on the answer to a replace or update.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "delete_object": {
      "description": "Delete an object you created from restful-api.dev, for good. No API key required.",
      "display_name": "Delete object",
      "display_str_template": "Delete restful-api.dev object {0}.",
      "handler": "actions.delete_object",
      "id": "restful_api_dev_delete_object",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "message": "Object with id = ff808181a09d98f701a145f7b1c9755b has been deleted.",
        "object_id": "ff808181a09d98f701a145f7b1c9755b"
      },
      "name": "delete_object",
      "output_formatter": "actions.format_deleted_output",
      "parameters": [
        {
          "description": "The id of an object you created. The sample objects 1 to 13 can't be changed or deleted.",
          "display_name": "Object id",
          "examples": [
            {
              "label": "A created object",
              "value": "ff808181a09d98f701a145f7b1c9755b"
            }
          ],
          "name": "object_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/restful-api-dev/delete-object",
      "result_str_template": "{restful_api_dev_delete_object,message}",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True once the object is deleted.",
            "type": "boolean"
          },
          "message": {
            "description": "restful-api.dev's confirmation message.",
            "type": [
              "string",
              "null"
            ]
          },
          "object_id": {
            "description": "The id of the object deleted.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
