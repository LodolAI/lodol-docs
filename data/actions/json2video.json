  "description": "Render videos from movie definitions or templates and manage your media library.",
  "display_name": "JSON2Video",
  "id": "json2video",
  "logo": "https://www.lodol.com/app-icons/json2video-icon.svg",
  "triggers": {
    "json2video_movie_status_changed_trigger": {
      "description": "Runs each time a video render status changes in JSON2Video. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Video render status changed",
      "id": "json2video_movie_status_changed_trigger",
      "output": {
        "record": "object with the fields project, status, message, url, created_at, ended_at"
      },
      "parameters": []
    },
    "json2video_new_movie_trigger": {
      "description": "Runs for each new video project in JSON2Video. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New video project",
      "id": "json2video_new_movie_trigger",
      "output": {
        "record": "object with the fields project, status, message, url, created_at, ended_at"
      },
      "parameters": []
    }
  }
