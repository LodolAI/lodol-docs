              "added": {
                "description": "True when the customer is in the group.",
                "type": "boolean"
              },
              "customer_id": {
                "description": "The customer's ID.",
                "type": "string"
              },
              "group_id": {
                "description": "The group's ID.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
