        "result": {
          "customer_id": "cust_123",
          "deleted": true
        }
      },
      "name": "delete_customer",
      "parameters": [
        {
          "description": "The customer, by the ID Create customer or Search customers gave back.",
          "display_name": "Customer ID",
          "name": "customer_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/square/delete-customer",
