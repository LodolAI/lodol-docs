        "result": {
          "added": true,
          "customer_id": "cust_123",
          "group_id": "group_123"
        }
      },
      "name": "add_customer_to_group",
      "parameters": [
        {
          "description": "The customer, by the ID Create customer or Search customers gave back.",
          "display_name": "Customer ID",
          "name": "customer_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The customer group, picked from your Square account.",
          "display_name": "Customer group",
          "dynamic_source": "customer_groups",
          "name": "group_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/square/add-customer-to-group",
      "result_str_template": "Customer added to group.",
      "returns": {
        "properties": {
          "result": {
            "description": "What changed.",
