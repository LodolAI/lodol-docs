    "search_orders": {
      "description": "Search orders. Alongside the orders it returns how many were found, their total_sales and the average_order, each with a ready-to-read display twin (beta), so a daily sales message needs no arithmetic.",
      "display_name": "Search orders",
      "display_str_template": "Search orders.",
      "handler": "actions.search_orders",
      "id": "square_search_orders",
      "method": "POST",
      "mock_response": {
        "average_order": 25.0,
        "average_order_display": "$25.00",
        "count": 1,
        "currency": "USD",
        "orders": [
          {
            "id": "order_123",
            "state": "COMPLETED",
            "total": 25.0,
            "total_money": {
              "amount": 2500,
              "currency": "USD"
            }
          }
        ],
        "total_sales": 25.0,
        "total_sales_display": "$25.00"
      },
      "name": "search_orders",
      "parameters": [
        {
          "description": "Square location ID to search for orders.",
          "display_name": "Location ID",
          "name": "location_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional order states to filter by, such as OPEN, COMPLETED, or CANCELED.",
          "display_name": "States",
          "name": "states",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Only orders closed on or after this day, by the location's own clock. Use with Closed to for one day's sales.",
          "display_name": "Closed from",
          "name": "closed_from",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only orders closed on or before this day, by the location's own clock. For a single day, give the same day as Closed from.",
          "display_name": "Closed to",
          "name": "closed_to",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Beta. Only this customer's orders, by the ID Search customers or New customer gives.",
          "display_name": "Customer ID",
          "name": "customer_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/square/search-orders",
      "result_str_template": "Orders searched.",
      "returns": {
        "properties": {
          "average_order": {
            "description": "Beta. What an order came to on average, in dollars (or the currency's main unit); 0 when no orders were found.",
            "type": "number"
          },
          "average_order_display": {
            "description": "Beta. average_order as a person writes it ($41.25), ready to put in a message.",
