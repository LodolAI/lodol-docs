    "search_orders": {
      "description": "Search orders.",
      "display_name": "Search orders",
      "display_str_template": "Search orders.",
      "handler": "actions.search_orders",
      "id": "square_search_orders",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "currency": "USD",
        "orders": [
          {
            "id": "order_123",
            "state": "COMPLETED",
            "total": 25.0,
            "total_money": {
              "amount": 2500,
              "currency": "USD"
            }
          }
        ],
        "total_sales": 25.0
      },
      "name": "search_orders",
      "parameters": [
        {
          "description": "Square location ID to search for orders.",
          "display_name": "Location ID",
          "name": "location_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional order states to filter by, such as OPEN, COMPLETED, or CANCELED.",
          "display_name": "States",
          "name": "states",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Only orders closed on or after this day, by the location's own clock. Use with Closed to for one day's sales.",
          "display_name": "Closed from",
          "name": "closed_from",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only orders closed on or before this day, by the location's own clock. For a single day, give the same day as Closed from.",
          "display_name": "Closed to",
          "name": "closed_to",
          "required": false,
          "type": "ParameterType.DATE"
        }
      ],
      "path": "/actions/library/square/search-orders",
      "result_str_template": "Orders searched.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many orders were found.",
            "type": "number"
          },
          "currency": {
            "description": "The currency of the totals, such as USD.",
            "type": "string"
          },
          "orders": {
            "description": "Order results.",
            "items": {
              "properties": {
                "id": {
                  "description": "Order ID.",
                  "type": "string"
                },
                "state": {
                  "description": "Order state.",
                  "type": "string"
                },
                "total": {
                  "description": "The order's total in dollars (or the currency's main unit), ready to show.",
                  "type": "number"
                },
                "total_money": {
                  "description": "Total money object, in the smallest unit (cents).",
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total_sales": {
            "description": "All the orders' totals added up, in dollars (or the currency's main unit).",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "update_customer": {
