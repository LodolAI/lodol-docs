{
  "actions": {
    "create_customer": {
      "description": "Create a Square customer profile.",
      "display_name": "Create customer",
      "display_str_template": "Create Square customer '{0} {1}'.",
      "handler": "actions.create_customer",
      "id": "square_create_customer",
      "method": "POST",
      "mock_response": {
        "customer": {
          "family_name": "Doe",
          "given_name": "Jane",
          "id": "cust_123"
        }
      },
      "name": "create_customer",
      "parameters": [
        {
          "description": "Customer first name.",
          "display_name": "First name",
          "name": "given_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Customer last name.",
          "display_name": "Last name",
          "name": "family_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Customer email address.",
          "display_name": "Email address",
          "name": "email_address",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Customer phone number.",
          "display_name": "Phone number",
          "name": "phone_number",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/square/create-customer",
      "result_str_template": "Customer created.",
      "returns": {
        "properties": {
          "customer": {
            "description": "Created customer record.",
            "properties": {
              "family_name": {
                "description": "Customer last name.",
                "type": "string"
              },
              "given_name": {
                "description": "Customer first name.",
                "type": "string"
              },
              "id": {
                "description": "Customer ID.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_payment_link": {
      "description": "Create a Square-hosted payment link to charge a single custom amount.",
      "display_name": "Create payment link",
      "display_str_template": "Create Square payment link.",
      "handler": "actions.create_payment_link",
      "id": "square_create_payment_link",
      "method": "POST",
      "mock_response": {
        "payment_link": {
          "id": "plink_123",
          "order_id": "order_123",
          "url": "https://square.link/u/example"
        }
      },
      "name": "create_payment_link",
      "parameters": [
        {
          "description": "Square location ID to associate with the checkout.",
          "display_name": "Location ID",
          "name": "location_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Amount to charge, in the smallest currency unit (e.g. cents for USD).",
          "display_name": "Amount",
          "minimum": 1,
          "name": "amount",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "ISO 4217 currency code, such as USD.",
          "display_name": "Currency",
          "name": "currency",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/square/create-payment-link",
      "result_str_template": "Payment link created.",
      "returns": {
        "properties": {
          "payment_link": {
            "description": "Created payment link.",
            "properties": {
              "id": {
                "description": "Payment link ID.",
                "type": "string"
              },
              "order_id": {
                "description": "Associated order ID.",
                "type": "string"
              },
              "url": {
                "description": "Payment link URL.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
