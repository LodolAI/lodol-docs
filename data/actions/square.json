    "add_customer_to_group": {
      "description": "Put a Square customer in one of your customer groups. A customer already in it stays as they are.",
      "display_name": "Add customer to group",
      "display_str_template": "Add customer '{0}' to group '{1}'.",
      "handler": "actions.add_customer_to_group",
      "id": "square_add_customer_to_group",
      "method": "POST",
