    "refund_payment": {
      "description": "Give money back on a Square payment: all of it or part. The money goes back to the card or account that paid.",
      "display_name": "Refund payment",
      "display_str_template": "Refund {1} {2} of payment '{0}'.",
      "handler": "actions.refund_payment",
      "id": "square_refund_payment",
      "method": "POST",
      "mock_response": {
        "refund": {
          "amount_money": {
            "amount": 500,
            "currency": "USD"
          },
          "id": "refund_123",
          "order_id": "order_123",
          "payment_id": "pay_123",
          "status": "PENDING"
        }
      },
      "name": "refund_payment",
      "parameters": [
        {
          "description": "The payment to refund. An order's tenders list the payment IDs that paid for it (Get order shows them).",
          "display_name": "Payment ID",
          "name": "payment_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How much to refund, in the smallest currency unit (e.g. cents for USD). Square needs it even for a full refund, and it can't be more than what was paid.",
          "display_name": "Amount",
          "minimum": 1,
          "name": "amount",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The payment's currency code, such as USD.",
          "display_name": "Currency",
          "name": "currency",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional reason for the refund, up to 192 characters.",
          "display_name": "Reason",
          "name": "reason",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/square/refund-payment",
      "result_str_template": "Refund started.",
      "returns": {
        "properties": {
          "refund": {
            "description": "The refund.",
            "properties": {
              "amount_money": {
                "description": "The amount refunded and its currency.",
                "type": "object"
              },
              "id": {
                "description": "Refund ID.",
                "type": "string"
              },
              "order_id": {
                "description": "The order the payment was for.",
                "type": "string"
              },
              "payment_id": {
                "description": "The payment it refunds.",
                "type": "string"
              },
              "status": {
                "description": "Where the refund is: PENDING, COMPLETED, REJECTED or FAILED.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
