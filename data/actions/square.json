  "categories": [
    "E-Commerce",
    "Payments & Billing"
  ],
  "description": "Manage Square customers, catalog items, orders, payment links and refunds, and start workflows on new orders.",
  "display_name": "Square",
  "id": "square",
  "logo": "https://www.lodol.com/app-icons/square-icon.svg",
  "triggers": {
    "square_new_order_trigger": {
      "description": "Runs for each new order at a Square location, with its total, what was ordered and who ordered it. Orders already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New order",
      "id": "square_new_order_trigger",
      "output": {
        "created_at": "When the order was placed.",
        "currency": "The total's currency, such as USD.",
        "customer_id": "The customer's ID, empty when there isn't one.",
        "id": "The order's ID.",
        "line_items": "What was ordered: each item's name and quantity.",
        "location_id": "The location it was placed at.",
        "source": "Where the order came from, such as a payment link.",
        "state": "The order's state: OPEN, COMPLETED or CANCELED.",
        "total_amount": "The total, in the smallest currency unit (cents)."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Square location to watch (List locations shows their IDs). Leave blank to use the default location saved on the connection.",
          "display_name": "Location ID",
          "name": "location_id",
          "required": false
        }
      ]
    }
  }
}
