{
  "actions": {
    "check_ip_address": {
      "description": "Find out how likely an IP address is to be abusive: its abuse confidence score from 0 to 100, how often it was reported, and who runs it (company, kind of network and country). An address nobody reported is an answer, not an error: its score is 0.",
      "display_name": "Check IP address",
      "display_str_template": "Check the IP address '{0}' on AbuseIPDB.",
      "handler": "actions.check_ip_address",
      "id": "abuseipdb_check_ip_address",
      "method": "POST",
      "mock_response": {
        "abuse_confidence_score": 100,
        "country_code": "CN",
        "distinct_reporters": 17,
        "domain": "tencent.com",
        "hostnames": [],
        "ip_address": "118.25.6.39",
        "ip_version": 4,
        "is_public": true,
        "is_tor": false,
        "is_whitelisted": false,
        "isp": "Tencent Cloud Computing (Beijing) Co. Ltd",
        "last_reported_at": "2026-09-26T20:55:14+00:00",
        "total_reports": 42,
        "usage_type": "Data Center/Web Hosting/Transit"
      },
      "name": "check_ip_address",
      "output_formatter": "actions.format_check_ip_address_output",
      "parameters": [
        {
          "description": "The IPv4 or IPv6 address to look up.",
          "display_name": "IP address",
          "examples": [
            {
              "label": "IPv4",
              "value": "118.25.6.39"
            },
            {
              "label": "IPv6",
              "value": "2001:db8::1"
            }
          ],
          "name": "ip_address",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 30,
          "description": "Only count reports from this many days back.",
          "display_name": "Days to look back",
          "maximum": 365,
          "minimum": 1,
          "name": "max_age_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/abuseipdb/check-ip-address",
      "result_str_template": "IP address checked.",
      "returns": {
        "properties": {
          "abuse_confidence_score": {
            "description": "How sure AbuseIPDB is that the address is abusive, from 0 to 100. AbuseIPDB recommends blocking at 75 or more",
            "type": "number"
          },
          "country_code": {
            "description": "Two-letter code of the country it is in, e.g. US",
            "type": "string"
          },
          "distinct_reporters": {
            "description": "How many different users reported it",
            "type": "number"
          },
          "domain": {
            "description": "That company's domain",
            "type": "string"
          },
          "hostnames": {
            "description": "Host names that point to the address",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ip_address": {
            "description": "The address checked",
            "type": "string"
          },
          "ip_version": {
            "description": "4 or 6",
            "type": "number"
          },
          "is_public": {
            "description": "False for private and reserved addresses, like 192.168.x.x",
            "type": "boolean"
          },
          "is_tor": {
            "description": "True for a Tor exit node",
            "type": "boolean"
          },
          "is_whitelisted": {
            "description": "True when it is on one of AbuseIPDB's lists of known-good addresses. Empty when not looked up",
            "type": "boolean"
          },
          "isp": {
            "description": "The company that runs the network",
            "type": "string"
          },
          "last_reported_at": {
            "description": "When it was last reported (ISO 8601), or empty if never",
            "type": "string"
          },
          "total_reports": {
            "description": "How many times it was reported in the days looked back",
            "type": "number"
          },
          "usage_type": {
            "description": "What kind of network it belongs to, such as Data Center/Web Hosting/Transit, Fixed Line ISP or Mobile ISP",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "check_network": {
      "description": "Find every reported IP address in a network, such as 203.0.113.0/24, with each one's abuse confidence score. Give a single IP address to check the /24 network around it. The free plan checks networks up to /24, going back up to 30 days.",
      "display_name": "Check network",
      "display_str_template": "Check the network '{0}' on AbuseIPDB.",
      "handler": "actions.check_network",
      "id": "abuseipdb_check_network",
      "method": "POST",
      "mock_response": {
        "network": "118.25.6.0/24",
        "reported_address_count": 1,
        "reported_addresses": [
          {
            "abuse_confidence_score": 100,
            "country_code": "CN",
            "ip_address": "118.25.6.39",
            "last_reported_at": "2026-09-26T20:55:14+00:00",
            "report_count": 42
          }
        ]
      },
      "name": "check_network",
      "output_formatter": "actions.format_check_network_output",
      "parameters": [
        {
          "description": "The network in CIDR notation, like 203.0.113.0/24, or one IP address to check the /24 around it.",
          "display_name": "Network",
          "examples": [
            {
              "label": "A /24 network",
              "value": "118.25.6.0/24"
            },
            {
              "label": "The network around an address",
              "value": "118.25.6.39"
            }
          ],
          "name": "network",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 30,
          "description": "Only reports from this many days back. The free plan allows up to 30.",
          "display_name": "Days to look back",
          "maximum": 365,
          "minimum": 1,
          "name": "max_age_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/abuseipdb/check-network",
      "result_str_template": "Network checked.",
      "returns": {
        "properties": {
          "network": {
            "description": "The network checked, in CIDR notation, e.g. 203.0.113.0/24. A single address given as the network comes back as the /24 around it (the /64 for IPv6)",
            "type": "string"
          },
          "reported_address_count": {
            "description": "How many addresses were reported",
            "type": "number"
          },
          "reported_addresses": {
            "description": "The reported addresses, highest confidence first",
            "items": {
              "properties": {
                "abuse_confidence_score": {
                  "description": "How sure AbuseIPDB is that the address is abusive, from 0 to 100. AbuseIPDB recommends blocking at 75 or more",
                  "type": "number"
                },
                "country_code": {
                  "type": "string"
                },
                "ip_address": {
                  "type": "string"
                },
                "last_reported_at": {
                  "description": "When it was last reported",
                  "type": "string"
                },
                "report_count": {
                  "description": "How many times it was reported",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
