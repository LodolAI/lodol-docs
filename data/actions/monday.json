            "board_id",
            "column_id"
          ],
          "name": "label",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/update-item-status",
      "result_str_template": "Status updated.",
      "returns": {
        "properties": {
          "item": {
            "description": "The updated item.",
            "properties": {
              "id": {
                "description": "Item ID.",
                "type": "string"
              },
              "name": {
                "description": "Item name.",
