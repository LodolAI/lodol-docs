    "update_item_status": {
      "description": "Update the status column of an item in a Monday.com board.",
      "display_name": "Update item status",
      "display_str_template": "Update status of item {1}.",
      "handler": "actions.update_item_status",
      "id": "monday_update_item_status",
      "method": "POST",
      "mock_response": {
        "item": {
          "id": "item123",
          "name": "Task"
        }
      },
      "name": "update_item_status",
      "parameters": [
        {
          "description": "The board the item is on.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The item to update.",
          "display_name": "Item",
          "dynamic_source": "board_items",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The status column to update. Most boards have a single column named \"Status\".",
          "display_name": "Status column",
          "dynamic_source": "status_columns",
          "dynamic_source_depends_on": [
