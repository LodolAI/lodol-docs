{
  "actions": {
    "add_update": {
      "description": "Post an update (a comment in the item's updates feed) on a Monday.com item.",
      "display_name": "Add an update",
      "display_str_template": "Add update to item {1}.",
      "handler": "actions.add_update",
      "id": "monday_add_update",
      "method": "POST",
      "mock_response": {
        "update": {
          "body": "Update text",
          "id": "update123"
        }
      },
      "name": "add_update",
      "parameters": [
        {
          "description": "Optional. Pick a board to choose its item in the field below.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The item to post the update on.",
          "display_name": "Item",
          "dynamic_source": "board_items",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text of the update to post.",
          "display_name": "Update text",
          "multiline": true,
          "name": "update_text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/add-update",
      "result_str_template": "Update added.",
      "returns": {
        "properties": {
          "update": {
            "description": "The posted update.",
            "properties": {
              "body": {
                "description": "Update body text.",
                "type": "string"
              },
              "id": {
                "description": "Update ID.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_item": {
      "description": "Create a new item in a Monday.com board.",
      "display_name": "Create item",
      "display_str_template": "Create item '{1}' in board {0}.",
      "handler": "actions.create_item",
      "id": "monday_create_item",
      "method": "POST",
      "mock_response": {
        "item": {
          "id": "item123",
          "name": "New Item"
        }
      },
      "name": "create_item",
      "parameters": [
        {
          "description": "The board to add the item to.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the new item.",
          "display_name": "Item name",
          "name": "item_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional group (section) to place the item in. Leave blank to use the board's first group.",
          "display_name": "Group",
          "dynamic_source": "board_groups",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "group_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/create-item",
      "result_str_template": "Item created.",
      "returns": {
        "properties": {
          "item": {
            "description": "The newly created item.",
            "properties": {
              "id": {
                "description": "Item ID.",
                "type": "string"
              },
              "name": {
                "description": "Item name.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_item": {
      "description": "Delete an item and its subitems. Monday.com keeps it in the trash, where it can be restored for 30 days.",
      "display_name": "Delete item",
      "display_str_template": "Delete item {1}.",
      "handler": "actions.delete_item",
      "id": "monday_delete_item",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": "item123"
      },
      "name": "delete_item",
      "parameters": [
        {
          "description": "Optional. Pick a board to choose its item in the field below.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The item to delete.",
          "display_name": "Item",
          "dynamic_source": "board_items",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/delete-item",
      "result_str_template": "Item deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Whether the item was deleted.",
            "type": "boolean"
          },
          "id": {
            "description": "The item deleted.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "list_board_items": {
      "description": "List the items in a Monday.com board (up to 500), each with its group and its columns by title as text, such as Status, Owner and Due date.",
      "display_name": "List board items",
      "display_str_template": "List items in board {0}.",
      "handler": "actions.list_board_items",
      "id": "monday_list_board_items",
      "method": "POST",
      "mock_response": {
        "items": [
          {
            "columns": {
              "Due date": "2026-11-02",
              "Owner": "Ada Lovelace",
              "Status": "Working on it"
            },
            "group": "This week",
            "id": "item1",
            "name": "Task 1",
            "state": "active"
          }
        ]
      },
      "name": "list_board_items",
      "parameters": [
        {
          "description": "The board to list items from.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/list-board-items",
      "result_str_template": "Items listed.",
      "returns": {
        "properties": {
          "items": {
            "description": "List of items.",
            "items": {
              "properties": {
                "columns": {
                  "description": "The item's columns as text, by the column's title on the board, such as Status, Owner or Due date. Read one with its title.",
                  "type": "object"
                },
                "group": {
                  "description": "The title of the group the item sits in.",
                  "type": "string"
                },
                "id": {
                  "description": "Item ID.",
                  "type": "string"
                },
                "name": {
                  "description": "Item name.",
                  "type": "string"
                },
                "state": {
                  "description": "active, archived or deleted.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
