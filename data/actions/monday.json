        },
        {
          "description": "The item to move.",
          "display_name": "Item",
          "dynamic_source": "board_items",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The group (section) to move it to.",
          "display_name": "Group",
          "dynamic_source": "board_groups",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "group_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
