{
  "actions": {
    "add_update": {
      "description": "Post an update (a comment in the item's updates feed) on a Monday.com item.",
      "display_name": "Add an update",
      "display_str_template": "Add update to item {1}",
      "handler": "actions.add_update",
      "id": "monday_add_update",
      "method": "POST",
      "mock_response": {
        "update": {
          "body": "Update text",
          "id": "update123"
        }
      },
      "name": "add_update",
      "parameters": [
        {
          "description": "Optional. Pick a board to choose its item in the field below.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The item to post the update on.",
          "display_name": "Item",
          "dynamic_source": "board_items",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text of the update to post.",
          "display_name": "Update text",
          "multiline": true,
          "name": "update_text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/add-update",
      "result_str_template": "Update added.",
      "returns": {
        "properties": {
          "update": {
            "description": "The posted update.",
            "properties": {
              "body": {
                "description": "Update body text.",
                "type": "string"
              },
              "id": {
                "description": "Update ID.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_item": {
      "description": "Create a new item in a Monday.com board.",
      "display_name": "Create item",
      "display_str_template": "Create item '{1}' in board {0}",
      "handler": "actions.create_item",
      "id": "monday_create_item",
      "method": "POST",
      "mock_response": {
        "item": {
          "id": "item123",
          "name": "New Item"
        }
      },
      "name": "create_item",
      "parameters": [
        {
          "description": "The board to add the item to.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the new item.",
          "display_name": "Item name",
          "name": "item_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional group (section) to place the item in. Leave blank to use the board's first group.",
          "display_name": "Group",
          "dynamic_source": "board_groups",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "group_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/create-item",
      "result_str_template": "Item created.",
      "returns": {
        "properties": {
          "item": {
            "description": "The newly created item.",
            "properties": {
              "id": {
                "description": "Item ID.",
                "type": "string"
              },
              "name": {
                "description": "Item name.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_board_items": {
      "description": "List all items in a Monday.com board.",
      "display_name": "List board items",
      "display_str_template": "List items in board {0}",
      "handler": "actions.list_board_items",
      "id": "monday_list_board_items",
      "method": "POST",
      "mock_response": {
        "items": [
          {
            "id": "item1",
            "name": "Task 1",
            "state": "active"
          }
        ]
      },
      "name": "list_board_items",
      "parameters": [
        {
          "description": "The board to list items from.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/list-board-items",
      "result_str_template": "Items listed.",
      "returns": {
        "properties": {
          "items": {
            "description": "List of items.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_boards": {
      "description": "List all boards your Monday.com account can access.",
      "display_name": "List boards",
      "display_str_template": "List Monday.com boards",
      "handler": "actions.list_boards",
      "id": "monday_list_boards",
      "method": "POST",
      "mock_response": {
        "boards": [
          {
            "id": "123",
            "name": "My Board",
            "workspace": "Main"
          }
        ]
      },
      "name": "list_boards",
      "parameters": [],
      "path": "/actions/library/monday/list-boards",
      "result_str_template": "Boards listed.",
      "returns": {
        "properties": {
          "boards": {
            "description": "List of boards.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_users": {
      "description": "List all users in the Monday.com account.",
      "display_name": "List users",
      "display_str_template": "List Monday.com users",
      "handler": "actions.list_users",
      "id": "monday_list_users",
      "method": "POST",
      "mock_response": {
        "users": [
          {
            "email": "john@example.com",
            "id": "user1",
            "name": "John Doe"
          }
        ]
      },
      "name": "list_users",
      "parameters": [],
      "path": "/actions/library/monday/list-users",
      "result_str_template": "Users listed.",
      "returns": {
        "properties": {
          "users": {
            "description": "List of users.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "update_item_status": {
      "description": "Update the status column of an item in a Monday.com board.",
      "display_name": "Update item status",
      "display_str_template": "Update status of item {1}",
      "handler": "actions.update_item_status",
      "id": "monday_update_item_status",
      "method": "POST",
      "mock_response": {
        "item": {
          "id": "item123",
          "name": "Task"
        }
      },
      "name": "update_item_status",
      "parameters": [
        {
          "description": "The board the item is on.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The item to update.",
          "display_name": "Item",
          "dynamic_source": "board_items",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The status column to update. Most boards have a single column named \"Status\".",
          "display_name": "Status column",
          "dynamic_source": "status_columns",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "column_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The status to set, for example \"Done\". Pick an existing label, or type a new one to create it automatically.",
          "display_name": "Status",
          "dynamic_source": "status_labels",
          "dynamic_source_depends_on": [
            "board_id",
            "column_id"
          ],
          "name": "label",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monday/update-item-status",
      "result_str_template": "Status updated.",
      "returns": {
        "properties": {
          "item": {
            "description": "The updated item.",
            "properties": {
              "id": {
                "description": "Item ID.",
                "type": "string"
              },
              "name": {
                "description": "Item name.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create and manage items on your Monday.com boards.",
  "display_name": "Monday.com",
  "id": "monday"
}
