    "update_item_columns": {
      "description": "Change any of an item's columns at once, such as its Owner, Due date, Status or a text or number column, by the column's title on the board.",
      "display_name": "Update item columns",
      "display_str_template": "Update the columns of item {1}.",
      "handler": "actions.update_item_columns",
      "id": "monday_update_item_columns",
      "method": "POST",
      "mock_response": {
        "item": {
          "columns": {
            "Due date": "2026-11-30",
            "Status": "Done"
          },
          "group": "This week",
          "id": "item123",
          "name": "Task",
          "state": "active"
        }
      },
      "name": "update_item_columns",
      "parameters": [
        {
          "description": "The board the item is on.",
          "display_name": "Board",
          "dynamic_source": "boards",
          "name": "board_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The item to change.",
          "display_name": "Item",
          "dynamic_source": "board_items",
          "dynamic_source_depends_on": [
            "board_id"
          ],
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Each column to change, by its title on the board, and its new value as you would type it: a status label such as Done, a date such as 2026-11-30, a number or some text. A status label the column doesn't have yet is added.",
