  "categories": [
    "Project Management"
  ],
  "description": "Create and manage items on your Monday.com boards.",
  "display_name": "Monday.com",
  "id": "monday",
  "logo": "https://www.lodol.com/app-icons/monday-icon.png",
  "triggers": {
    "monday_new_item_trigger": {
      "description": "Runs for each new item on a Monday.com board. Items already there when the workflow is turned on don't start it.",
      "display_name": "New item",
      "id": "monday_new_item_trigger",
      "output": {
        "board_id": "The board the item is on.",
        "columns": "The item's columns as text, by the column's title on the board, such as Status, Owner or Due date.",
        "group": "The title of the group the item was added to.",
        "id": "The item's ID.",
        "name": "The item's name.",
        "state": "active, archived or deleted."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The board to watch for new items.",
          "display_name": "Board",
          "name": "board_id",
          "required": true
        }
      ]
    }
  }
