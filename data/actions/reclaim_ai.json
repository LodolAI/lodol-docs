{
  "actions": {
    "call_tool": {
      "description": "Run an available tool. Reclaim puts proposed calendar changes in Preview Mode.",
      "display_name": "Run scheduling tool",
      "display_str_template": "Run scheduling tool.",
      "handler": "actions.call_tool",
      "id": "reclaim_ai_call_tool",
      "method": "POST",
      "mock_response": {
        "result": {
          "content": [],
          "data": null
        }
      },
      "name": "call_tool",
      "output_formatter": "hosted_mcp_provider.configure.<locals>.<lambda>",
      "parameters": [
        {
          "description": "Choose a scheduling tool available in your account.",
          "display_name": "Tool name",
          "dynamic_source": "tools",
          "dynamic_source_allows_custom": true,
          "name": "tool_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Fill in the inputs this tool requires.",
          "display_name": "Arguments",
          "dynamic_source": "arguments",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "tool_name"
          ],
          "name": "arguments",
          "required": false,
          "schema": {
            "description": "Fill in the inputs this tool requires.",
            "type": "object"
          },
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/reclaim-ai/call-tool",
      "result_str_template": "Run scheduling tool completed.",
      "returns": {
        "properties": {
          "result": {
            "description": "The structured result and content blocks from the tool.",
            "properties": {
              "content": {
                "description": "Content blocks from the tool.",
                "items": {
                  "description": "One content block from the tool.",
                  "type": "object"
                },
                "type": "array"
              },
              "data": {
                "description": "Structured result, when provided.",
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "list_tools": {
      "description": "Read the current tools and their input schemas from the connected account.",
      "display_name": "List available tools",
      "display_str_template": "List available tools.",
      "handler": "actions.list_tools",
      "id": "reclaim_ai_list_tools",
      "method": "POST",
      "mock_response": {
        "data": [
          {
            "inputSchema": {
              "type": "object"
            },
            "name": "example"
          }
        ]
      },
      "name": "list_tools",
      "output_formatter": "hosted_mcp_provider.configure.<locals>.<lambda>",
      "parameters": [],
      "path": "/actions/library/reclaim-ai/list-tools",
      "result_str_template": "List available tools completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The available tools and their input schemas.",
            "items": {
              "description": "The advertised tool.",
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    }
  },
  "categories": [
    "Calendars",
    "To-Do Lists"
  ],
  "description": "Find scheduling information and prepare calendar changes in Reclaim 2.0.",
  "display_name": "Reclaim.ai",
  "id": "reclaim_ai",
  "logo": "https://www.lodol.com/app-icons/reclaim-ai-icon.png",
  "triggers": {}
}
