    "track_event": {
      "description": "Send Heap an event that happened on your servers, such as an order completed, for an identified user.",
      "display_name": "Track event",
      "display_str_template": "Track event.",
      "handler": "documented_provider._handler.<locals>.handle",
      "id": "heap_track_event",
      "method": "POST",
      "mock_response": {
        "data": {
          "event": "example",
          "tracked": 1
        }
      },
      "name": "track_event",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "The event's name, up to 1024 characters, such as Order completed.",
          "display_name": "Event name",
          "max_length": 1024,
          "name": "event",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The user's identity, such as their email address or your own user ID, the one your app passes to Heap's identify. Up to 255 characters; case matters.",
          "display_name": "Identity",
          "max_length": 255,
          "name": "identity",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Heap's own user ID for an anonymous user, from Heap's SDK, instead of an identity.",
          "display_name": "Heap user ID",
          "name": "heap_user_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Details about the event by name, each a number or text under 1024 characters. Don't use user_id, session_id or screen_name.",
          "display_name": "Properties",
          "name": "properties",
          "required": false,
          "schema": {
            "description": "Details about the event by name, each a number or text under 1024 characters. Don't use user_id, session_id or screen_name.",
            "type": "object"
          },
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "When it happened. Leave empty for now.",
          "display_name": "Time",
          "name": "timestamp",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "The Heap session the event belongs to.",
          "display_name": "Session ID",
          "name": "session_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A unique ID for this event, so sending it twice records it once.",
          "display_name": "Idempotency key",
          "name": "idempotency_key",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/heap/track-event",
      "result_str_template": "Track event completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response from Heap.",
            "properties": {
              "event": {
                "description": "Event.",
                "type": "string"
              },
              "tracked": {
                "description": "Tracked.",
