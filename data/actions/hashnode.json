                "nullable": true,
                "type": "string"
              },
              "profilePicture": {
                "description": "Address of the profile picture",
                "nullable": true,
                "type": "string"
              },
              "tagline": {
                "description": "The short line shown under the name",
                "nullable": true,
                "type": "string"
              },
              "username": {
                "description": "The Hashnode username",
