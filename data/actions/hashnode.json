    "list_publications": {
      "description": "List the blogs the connected user owns. Gets one page; to see more, run it again with the next page it gives.",
      "display_name": "List publications",
      "display_str_template": "List publications.",
      "handler": "actions.list_publications",
      "id": "hashnode_list_publications",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "has_more": false,
        "next_cursor": "",
        "publications": [
          {
            "displayTitle": "Jo's Blog",
            "id": "64b0c0ffee0123456789abcd",
            "isTeam": false,
            "title": "Jo's Blog",
            "url": "https://jo.hashnode.dev"
          }
        ],
        "total": 1
      },
      "name": "list_publications",
      "output_formatter": "formatting.listing.<locals>.format_listing",
      "parameters": [
        {
          "description": "How many to return, 1 to 100. Defaults to 20.",
          "display_name": "Page size",
          "maximum": 100,
          "minimum": 1,
          "name": "first",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The 'next_cursor' from an earlier page, to get the page after it.",
          "display_name": "Next page cursor",
          "name": "after",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hashnode/list-publications",
      "result_str_template": "Publications retrieved.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many on this page",
            "type": "number"
          },
          "has_more": {
            "description": "Whether another page follows",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Pass as 'Next page cursor' for the next page; empty on the last one",
            "type": "string"
          },
          "publications": {
            "description": "The publications",
            "items": {
              "properties": {
                "displayTitle": {
                  "description": "The title as shown on the blog",
                  "nullable": true,
                  "type": "string"
                },
                "id": {
                  "description": "Hashnode's id for it",
                  "nullable": true,
                  "type": "string"
                },
                "isTeam": {
                  "description": "Whether it is a team blog",
                  "nullable": true,
                  "type": "boolean"
                },
                "title": {
                  "description": "The title",
                  "nullable": true,
                  "type": "string"
                },
                "url": {
                  "description": "The web address",
                  "nullable": true,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "How many there are in all, when Hashnode says",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    }
  },
  "categories": [
    "Websites & Blogs"
