    "get_user": {
      "description": "Look up anyone's public Hashnode profile by username: name, tagline, location and follower counts.",
      "display_name": "Get user profile",
      "display_str_template": "Get user {username}.",
      "handler": "actions.get_user",
      "id": "hashnode_get_user",
      "method": "POST",
      "mock_response": {
        "user": {
          "dateJoined": "2024-01-10T09:00:00.000Z",
          "followersCount": 20,
          "followingsCount": 5,
          "id": "64b0c0ffee0123456789abce",
          "location": "London",
          "name": "Jo Bloggs",
          "profilePicture": null,
          "tagline": "Writing about APIs",
          "username": "jo"
        }
      },
      "name": "get_user",
      "output_formatter": "formatting.record.<locals>.format_record",
      "parameters": [
        {
          "description": "The Hashnode username, as in hashnode.com/@username.",
          "display_name": "Username",
          "name": "username",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hashnode/get-user",
      "result_str_template": "User retrieved.",
      "returns": {
        "properties": {
