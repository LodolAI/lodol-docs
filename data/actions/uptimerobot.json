{
  "actions": {
    "create_monitor": {
      "description": "Start monitoring a website, host, or port. UptimeRobot checks it on the schedule you pick and alerts your contacts when it goes down.",
      "display_name": "Create a monitor",
      "display_str_template": "Create the UptimeRobot monitor {0}.",
      "handler": "actions.create_monitor",
      "id": "uptimerobot_create_monitor",
      "method": "POST",
      "mock_response": {
        "created_at": "2026-07-31T12:00:00.000Z",
        "current_state_duration": 86400,
        "friendly_name": "Production API",
        "id": "800123456",
        "interval": 300,
        "status": "UP",
        "tags": [
          "production"
        ],
        "type": "HTTP",
        "url": "https://example.com"
      },
      "name": "create_monitor",
      "output_formatter": "actions.created_monitor_formatter",
      "parameters": [
        {
          "description": "The name to show in UptimeRobot and in alerts, for example 'Production API'.",
          "display_name": "Monitor name",
          "name": "friendly_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to check. Use a full URL such as 'https://example.com' for an HTTP or keyword monitor, or a hostname or IP such as 'example.com' for a ping or port monitor.",
          "display_name": "URL or host",
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "HTTP",
          "description": "How UptimeRobot should test that the target is up.",
          "display_name": "Check type",
          "name": "monitor_type",
          "options": [
            {
              "label": "HTTP(S): the URL responds",
              "value": "HTTP"
            },
            {
              "label": "Keyword: the page contains (or lacks) a word",
              "value": "KEYWORD"
            },
            {
              "label": "Ping: the host answers ICMP",
              "value": "PING"
            },
            {
              "label": "Port: a specific TCP port accepts connections",
              "value": "PORT"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "300",
          "description": "How often to run the check.",
          "display_name": "Check every",
          "name": "interval",
          "options": [
            {
              "label": "Every minute",
              "value": "60"
            },
            {
              "label": "Every 5 minutes",
              "value": "300"
            },
            {
              "label": "Every 10 minutes",
              "value": "600"
            },
            {
              "label": "Every 15 minutes",
              "value": "900"
            },
            {
              "label": "Every 30 minutes",
              "value": "1800"
            },
            {
              "label": "Every hour",
              "value": "3600"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. How long to wait for a response before the check counts as down. Defaults to 30 seconds for HTTP and keyword monitors.",
          "display_name": "Timeout (seconds)",
          "maximum": 60,
          "minimum": 1,
          "name": "timeout",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Keyword monitors only. The word or phrase to look for in the page's response, for example 'Add to cart'.",
          "display_name": "Keyword",
          "name": "keyword_value",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "EXISTS",
          "description": "Keyword monitors only. Whether the monitor goes down when the keyword is missing or when it appears.",
          "display_name": "Keyword rule",
          "name": "keyword_type",
          "options": [
            {
              "label": "Down when the keyword is missing",
              "value": "EXISTS"
            },
            {
              "label": "Down when the keyword is present",
              "value": "NOT_EXISTS"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Port monitors only. The TCP port to connect to, for example 443.",
          "display_name": "Port",
          "maximum": 65535,
          "minimum": 1,
          "name": "port",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/uptimerobot/create-monitor",
      "result_str_template": "Monitor created: {create_monitor,friendly_name}",
      "returns": {
        "properties": {
          "created_at": {
            "description": "When the monitor was created",
            "type": "string"
          },
          "current_state_duration": {
            "description": "How long the monitor has been in its current state, in seconds",
            "type": "number"
          },
          "friendly_name": {
            "description": "The monitor's name in UptimeRobot",
            "type": "string"
          },
          "id": {
            "description": "The monitor's unique id",
            "type": "string"
          },
          "interval": {
            "description": "How often the monitor runs, in seconds",
            "type": "number"
          },
          "status": {
            "description": "The monitor's current state: UP, DOWN, LOOKS_DOWN, PAUSED, or STARTED",
            "type": "string"
          },
          "tags": {
            "description": "The names of the tags on the monitor",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "The check type (HTTP, KEYWORD, PING, or PORT)",
            "type": "string"
          },
          "url": {
            "description": "The URL or host being checked",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_monitor": {
      "description": "Delete a monitor and its history. This cannot be undone; pause the monitor instead if you only want to stop it temporarily.",
      "display_name": "Delete a monitor",
      "display_str_template": "Delete the UptimeRobot monitor {0}.",
      "handler": "actions.delete_monitor",
      "id": "uptimerobot_delete_monitor",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": "800123456"
      },
      "name": "delete_monitor",
      "output_formatter": "actions.deleted_monitor_formatter",
      "parameters": [
        {
          "description": "The id of the monitor, as returned by Create a monitor or List monitors.",
          "display_name": "Monitor ID",
          "name": "monitor_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/uptimerobot/delete-monitor",
      "result_str_template": "Monitor deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True when the monitor was removed",
            "type": "boolean"
          },
          "id": {
            "description": "The id of the deleted monitor",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_monitors": {
      "description": "List the monitors in your account with their current up or down status. Filter by status, name, URL, or tag to check just the ones you care about.",
      "display_name": "List monitors",
      "display_str_template": "List UptimeRobot monitors.",
      "handler": "actions.list_monitors",
      "id": "uptimerobot_list_monitors",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "monitors": [
          {
            "created_at": "2026-07-31T12:00:00.000Z",
            "current_state_duration": 86400,
            "friendly_name": "Production API",
            "id": "800123456",
            "interval": 300,
            "status": "UP",
            "tags": [
              "production"
            ],
            "type": "HTTP",
            "url": "https://example.com"
          }
        ]
      },
      "name": "list_monitors",
      "output_formatter": "actions.monitor_list_formatter",
      "parameters": [
        {
          "description": "Only return monitors in these states. Leave empty for all of them.",
          "display_name": "Status",
          "multi_select": true,
          "name": "status",
          "options": [
            {
              "label": "Up",
              "value": "UP"
            },
            {
              "label": "Down",
              "value": "DOWN"
            },
            {
              "label": "Looks down (being confirmed)",
              "value": "LOOKS_DOWN"
            },
            {
              "label": "Paused",
              "value": "PAUSED"
            },
            {
              "label": "Started (checking)",
              "value": "STARTED"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Only return monitors whose name contains this text. Case-insensitive.",
          "display_name": "Name contains",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Only return monitors whose URL contains this text, for example 'example.com'. Case-insensitive.",
          "display_name": "URL contains",
          "name": "url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Only return monitors carrying any of these tag names, separated by commas. Tag names are case-sensitive.",
          "display_name": "Tags",
          "name": "tags",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 50,
          "description": "The maximum number of monitors to return (1 to 200).",
          "display_name": "How many",
          "maximum": 200,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/uptimerobot/list-monitors",
      "result_str_template": "{list_monitors,count} monitors found.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many monitors were returned",
            "type": "number"
          },
          "monitors": {
            "description": "The monitors that matched the filters",
            "items": {
              "properties": {
                "created_at": {
                  "description": "When the monitor was created",
                  "type": "string"
                },
                "current_state_duration": {
                  "description": "How long the monitor has been in its current state, in seconds",
                  "type": "number"
                },
                "friendly_name": {
                  "description": "The monitor's name in UptimeRobot",
                  "type": "string"
                },
                "id": {
                  "description": "The monitor's unique id",
                  "type": "string"
                },
                "interval": {
                  "description": "How often the monitor runs, in seconds",
                  "type": "number"
                },
                "status": {
                  "description": "The monitor's current state: UP, DOWN, LOOKS_DOWN, PAUSED, or STARTED",
                  "type": "string"
                },
                "tags": {
                  "description": "The names of the tags on the monitor",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
                  "description": "The check type (HTTP, KEYWORD, PING, or PORT)",
                  "type": "string"
                },
                "url": {
                  "description": "The URL or host being checked",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
