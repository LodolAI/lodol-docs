  "triggers": {
    "concept2_new_workout_trigger": {
      "description": "Runs for each new workout in Concept2. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New workout",
      "id": "concept2_new_workout_trigger",
      "output": {
        "record": "object with the fields id, type, date, distance, time"
      },
      "parameters": []
    },
    "concept2_workout_changed_trigger": {
      "description": "Runs each time a workout changes in Concept2. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Workout updated",
      "id": "concept2_workout_changed_trigger",
      "output": {
        "record": "object with the fields id, type, date, distance, time"
      },
