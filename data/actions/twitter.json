      "display_str_template": "Delete {tweet_id}.",
      "handler": "actions.delete_tweet",
      "id": "twitter_delete_tweet",
      "method": "POST",
      "mock_response": {
        "status": "success"
      },
      "name": "delete_tweet",
      "output_formatter": "actions.format_delete_tweet_output",
      "parameters": [
        {
          "description": "The post to delete: its ID, or a link to it such as https://x.com/name/status/1234567890.",
          "display_name": "Post",
          "name": "tweet_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/twitter/delete",
      "result_str_template": "Post deleted.",
      "returns": {
        "properties": {
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
