      "description": "Runs for each new post an X account publishes: yours, or any public account. Posts already there when the workflow is turned on don't start it.",
      "display_name": "New post from an account",
      "id": "twitter_new_post_trigger",
      "output": {
        "conversation_id": "The ID of the first post in its thread.",
        "created_at": "When it was posted, in UTC.",
        "id": "The post's ID.",
        "link": "The post's address on X.",
