  ],
  "description": "Post, reply, like and search posts on X from your account.",
  "display_name": "X",
  "id": "twitter",
  "logo": "https://www.lodol.com/app-icons/twitter-icon.png",
  "triggers": {
    "twitter_new_mention_trigger": {
      "description": "Runs when someone mentions your account in a post on X.",
      "display_name": "New mention",
      "id": "twitter_new_mention_trigger",
      "output": {
        "id": "string",
        "text": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only run for mentions that contain this word or phrase. Leave blank to run for every mention.",
          "display_name": "Containing",
          "name": "keyword",
          "required": false
        }
      ]
    }
  }
