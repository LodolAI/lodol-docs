    "search_recent_tweets": {
      "description": "Find posts on X from the last seven days that match a word, phrase or hashtag.",
      "display_name": "Search recent posts",
      "display_str_template": "Search recent posts for '{query}'.",
      "handler": "actions.search_recent_tweets",
      "id": "twitter_search_recent",
      "method": "POST",
      "mock_response": {
        "status": "success",
        "tweets": [
          {
            "id": "1234567890",
            "text": "Excited about the new AI features! #technology"
          }
        ]
      },
      "name": "search_recent_tweets",
      "output_formatter": "actions.format_search_recent_tweets_output",
      "parameters": [
        {
          "description": "What to search for, such as a word, phrase, or hashtag.",
          "display_name": "Search terms",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most posts to return, from 10 to 100. Leave blank for 10.",
          "display_name": "How many",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/twitter/search-recent",
      "result_str_template": "Posts found.",
      "returns": {
        "properties": {
          "status": {
            "description": "Action execution status.",
            "type": "string"
          },
          "tweets": {
            "description": "The posts found.",
            "items": {
              "properties": {
                "id": {
                  "description": "The post's ID.",
                  "type": "string"
                },
                "text": {
                  "description": "What the post says.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
