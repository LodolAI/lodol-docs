    "extract_data": {
      "description": "Read an invoice, receipt, form or any document with one of your Mindee models and get its fields back as data. Waits for the answer, usually a few seconds. Each document uses Mindee credits.",
      "display_name": "Extract data from a document",
      "display_str_template": "Extract data from a document.",
      "handler": "actions.extract_data",
      "id": "mindee_extract_data",
      "method": "POST",
      "mock_response": {
        "alias": "INV-2026-0042",
        "data": {
          "date": "2026-03-15",
          "invoice_number": "INV-2026-0042",
          "line_items": [
            {
              "description": "Office chair",
              "quantity": 4.0,
              "total_price": 480.0
            }
          ],
          "supplier_name": "Acme Supplies Ltd",
          "total_amount": 1518.0
        },
        "fields": {
          "supplier_name": {
            "confidence": "Certain",
            "value": "Acme Supplies Ltd"
          }
        },
        "file_name": "invoice.pdf",
        "inference_id": "a9ad3299-d322-4c1a-9ea0-ea835a736c66",
        "job_id": "a9ad3299-d322-4c1a-9ea0-ea835a736c66",
        "mime_type": "application/pdf",
        "model_id": "2dd7ea55-71d2-4f11-afdc-af307a3e6207",
        "options": {
          "confidence": true,
          "raw_text": true
        },
        "page_count": 1,
        "rag_document_id": "",
        "raw_text": "INVOICE Invoice number: INV-2026-0042"
      },
      "name": "extract_data",
      "output_formatter": "actions.format_extraction_output",
      "parameters": [
        {
          "description": "The Mindee model that reads the document, such as an invoice model. Pick one, or give its id from an earlier step.",
          "display_name": "Model",
          "dynamic_source": "models",
          "dynamic_source_allows_custom": true,
          "name": "model_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "description": "The document to read: upload one, pick a file from an earlier step (such as an email attachment), or give a public https:// link. PDFs, JPG, PNG, TIFF and more.",
          "display_name": "Document",
          "name": "file",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A label of your own to tag the document with, such as an invoice number or record id. It comes back on the job and the result.",
          "display_name": "Your reference",
          "name": "alias",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Add how sure Mindee is of each value (Certain, High, Medium or Low). Useful for deciding what a person should check.",
          "display_name": "Score each value's confidence",
          "more_options": true,
          "name": "confidence",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Also return all the text Mindee read from the document.",
          "display_name": "Include the document's full text",
          "more_options": true,
          "name": "raw_text",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Add the position of each value on its page, as a box, in the result's fields.",
          "display_name": "Include where each value is",
          "more_options": true,
          "name": "polygon",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Let active reference documents on the model guide the reading (see 'Upload reference document').",
          "display_name": "Use reference documents",
          "more_options": true,
          "name": "rag",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Extra context for the model for this document only, such as 'Amounts are in Canadian dollars'.",
          "display_name": "Extra instructions",
          "more_options": true,
          "multiline": true,
          "name": "text_context",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How long to wait for Mindee before giving up, 5 to 300. Defaults to 90. The document keeps being read; its job id is in the error.",
          "display_name": "Wait up to (seconds)",
          "maximum": 300,
          "minimum": 5,
          "more_options": true,
          "name": "wait_seconds",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/mindee/extract-data",
      "result_str_template": "Document read.",
      "returns": {
        "properties": {
          "alias": {
            "description": "Your reference, if you gave one",
            "type": "string"
          },
          "data": {
            "description": "Every field as a plain value, named as in the model: for an invoice supplier_name, invoice_number, date, total_amount, line_items and so on",
            "type": "object"
          },
          "fields": {
            "description": "Mindee's full answer for each field, with its confidence and, if asked for, its location",
            "type": "object"
          },
          "file_name": {
            "description": "The document's file name",
            "type": "string"
          },
          "inference_id": {
            "description": "The result's id (same as the job's)",
            "type": "string"
          },
          "job_id": {
            "description": "The job that produced it",
            "type": "string"
          },
          "mime_type": {
            "description": "The document's detected type",
            "type": "string"
          },
          "model_id": {
            "description": "The model that read the document",
            "type": "string"
          },
          "options": {
            "description": "Which options were on for this reading",
            "type": "object"
          },
          "page_count": {
            "description": "Pages in the document",
            "type": "number"
          },
          "rag_document_id": {
            "description": "The reference document that guided the reading, if any",
            "type": "string"
          },
          "raw_text": {
            "description": "All the document's text, if asked for",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
