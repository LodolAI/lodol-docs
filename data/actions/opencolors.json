    "check_contrast": {
      "description": "Check a color's WCAG 2.1 contrast against a white and a black background: the ratio on each, whether it passes AA and AAA for small text, large text and UI components, which of the two it reads best on, and the text color OpenColors recommends for anything written on top of it. Built for checking a brand color before it goes on a page.",
      "display_name": "Check WCAG contrast",
      "display_str_template": "Check the contrast of {0}.",
      "handler": "actions.check_contrast",
      "id": "opencolors_check_contrast",
      "method": "POST",
      "mock_response": {
        "best_background": "black",
        "css": "#FF5733",
        "hex": "FF5733",
        "on_black": {
          "large_text": {
            "aa": true,
            "aaa": true
          },
          "ratio": 6.67,
          "small_text": {
            "aa": true,
            "aaa": false
          },
          "ui_components": {
            "aa": true,
