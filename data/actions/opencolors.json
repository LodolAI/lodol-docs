    "check_service_status": {
      "description": "Check whether OpenColors is answering, how quickly, and what it reports about itself: its own status, the state of its database and its version. This is the one action that reports a problem as a value instead of failing the step, so a workflow can decide what to do about it.",
      "display_name": "Check service status",
      "display_str_template": "Check the OpenColors status.",
      "handler": "actions.check_service_status",
      "id": "opencolors_check_service_status",
      "method": "POST",
      "mock_response": {
        "database_status": "healthy",
        "message": "OpenColors 1.0.0 is up and answering.",
        "online": true,
        "reachable": true,
        "reported_status": "healthy",
        "response_time_ms": 45.0,
        "status_code": 200,
        "version": "1.0.0"
      },
      "name": "check_service_status",
      "output_formatter": "actions.format_status_output",
      "parameters": [],
