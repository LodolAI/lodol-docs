          "ratio": 3.15,
          "small_text": {
            "aa": false,
            "aaa": false
          },
          "ui_components": {
            "aa": true,
            "aaa": true
          }
        },
        "recommended_text_color": "dark",
        "rgb": {
          "b": 51,
          "g": 87,
          "r": 255
        }
      },
      "name": "check_contrast",
      "output_formatter": "actions.format_contrast_output",
      "parameters": [
