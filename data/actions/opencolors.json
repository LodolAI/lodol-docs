    "get_brand": {
      "description": "Get one brand's official palette by name. The service only searches, so the name is searched for and matched here: an exact name or slug always wins, and failing that a partial name resolves when it lands on a single brand, so 'spotify' and 'the Spotify brand' both work. A name matching two brands is reported with both rather than guessed between.",
      "display_name": "Get a brand's colors",
      "display_str_template": "Get the {0} brand colors.",
      "handler": "actions.get_brand",
      "id": "opencolors_get_brand",
      "method": "POST",
      "mock_response": {
        "brand": {
          "brand_url": "https://www.spotify.com/",
          "color_count": 2,
          "colors": [
            {
              "css": "#1DB954",
              "hex": "1DB954"
            },
            {
              "css": "#191414",
              "hex": "191414"
            }
          ],
          "id": "abc123",
          "name": "Spotify",
          "slug": "spotify",
          "source_url": "https://developer.spotify.com/design/"
        },
        "matched_exactly": true,
        "requested_brand": "Spotify"
      },
      "name": "get_brand",
      "output_formatter": "actions.format_brand_output",
      "parameters": [
        {
          "description": "The brand to look up, by name or slug. A partial name works when only one brand matches it.",
          "display_name": "Brand",
          "examples": [
            {
              "label": "A brand",
              "value": "Spotify"
            },
            {
              "label": "A slug",
              "value": "netflix"
            }
          ],
          "name": "brand",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/opencolors/get-brand",
      "result_str_template": "Brand colors retrieved.",
      "returns": {
