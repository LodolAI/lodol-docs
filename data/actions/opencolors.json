{
  "actions": {
    "check_color_availability": {
      "description": "Check which of up to 100 colors are still unnamed on OpenColors, in one request. Each color comes back as available or already named, with the name and owner when it is taken, and the two lists are summarised so a step can branch on the counts or take the available hexes straight into the next step.",
      "display_name": "Check color availability",
      "display_str_template": "Check the availability of {0}.",
      "handler": "actions.check_color_availability",
      "id": "opencolors_check_color_availability",
      "method": "POST",
      "mock_response": {
        "available_count": 1,
        "available_hexes": [
          "3366CC"
        ],
        "color_count": 2,
        "colors": [
          {
            "available": false,
            "css": "#FF5733",
            "hex": "FF5733",
            "hex_int": 16734003,
            "is_named": true,
            "name": "Sunset Orange",
            "owner": "John Doe"
          },
          {
            "available": true,
            "css": "#3366CC",
            "hex": "3366CC",
            "hex_int": 3368652,
            "is_named": false,
            "name": null,
            "owner": null
          }
        ],
        "named_count": 1,
        "named_hexes": [
          "FF5733"
        ],
        "requested_count": 2,
        "unanswered_hexes": []
      },
      "name": "check_color_availability",
      "output_formatter": "actions.format_availability_output",
      "parameters": [
        {
          "description": "The colors to check, one per entry, in any hex spelling. Up to 100 at a time; a repeat is checked once. A single text of colors separated by commas works too.",
          "display_name": "Colors",
          "examples": [
            {
              "label": "Three colors",
              "value": "FF5733, 3366CC, 00FF00"
            }
          ],
          "name": "hexes",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/opencolors/check-color-availability",
      "result_str_template": "Availability checked.",
      "returns": {
        "properties": {
