    "get_statistics": {
      "description": "Get the state of the OpenColors catalogue: how many of the 16.7 million colors have been named, how many are still available, how many were named recently, the size of the partner programme, and who has named the most colors.",
      "display_name": "Get color statistics",
      "display_str_template": "Get the OpenColors statistics.",
      "handler": "actions.get_statistics",
      "id": "opencolors_get_statistics",
      "method": "POST",
      "mock_response": {
        "available_colors": 16654766,
        "named_colors": 1250,
        "partner_credits": 500,
        "partners": 15,
        "recent_transactions": 5,
