{
  "actions": {
    "get_definition": {
      "description": "Look up a word's part of speech and definitions.",
      "display_name": "Get definition",
      "display_str_template": "Look up the definition of '{0}'.",
      "handler": "actions.get_definition",
      "id": "merriam_webster_get_definition",
      "method": "POST",
      "mock_response": {
        "definitions": [
          "existing or being everywhere at the same time"
        ],
        "part_of_speech": "adjective",
        "word": "ubiquitous"
      },
      "name": "get_definition",
      "parameters": [
        {
          "description": "Word to look up.",
          "display_name": "Word",
          "examples": [
            {
              "label": "Word",
              "value": "ubiquitous"
            }
          ],
          "name": "word",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/merriam-webster/get-definition",
      "result_str_template": "Retrieved the definition.",
      "returns": {
        "properties": {
          "definitions": {
            "description": "Short definitions, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "part_of_speech": {
            "description": "Part of speech, for example 'noun' or 'verb'",
            "type": "string"
          },
          "word": {
            "description": "The matched dictionary headword. Empty if not found.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_synonyms": {
      "description": "Look up synonyms and antonyms for a word.",
      "display_name": "Get synonyms",
      "display_str_template": "Look up synonyms for '{0}'.",
      "handler": "actions.get_synonyms",
      "id": "merriam_webster_get_synonyms",
      "method": "POST",
      "mock_response": {
        "antonyms": [
          "sad",
          "unhappy"
        ],
        "synonyms": [
          "glad",
          "joyful",
          "content"
        ],
        "word": "happy"
      },
      "name": "get_synonyms",
      "parameters": [
        {
          "description": "Word to look up.",
          "display_name": "Word",
          "examples": [
            {
              "label": "Word",
              "value": "happy"
            }
          ],
          "name": "word",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/merriam-webster/get-synonyms",
      "result_str_template": "Retrieved synonyms and antonyms.",
      "returns": {
        "properties": {
          "antonyms": {
            "description": "Antonyms for the word",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "synonyms": {
            "description": "Synonyms for the word",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "word": {
            "description": "The matched thesaurus headword. Empty if not found.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Look up word definitions, parts of speech, synonyms, and antonyms using Merriam-Webster's Dictionary and Thesaurus APIs.",
  "display_name": "Merriam-Webster",
  "id": "merriam_webster"
}
