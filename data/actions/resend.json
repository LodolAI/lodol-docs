{
  "actions": {
    "cancel_email": {
      "description": "Cancel a scheduled email that has not been sent yet.",
      "display_name": "Cancel scheduled email",
      "display_str_template": "Cancel Resend email {0}.",
      "handler": "actions.cancel_email",
      "id": "resend_cancel_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "id": "49a3999c-0ce1-4ea6-ab68-afcd6dc2e794",
          "object": "email"
        }
      },
      "name": "cancel_email",
      "parameters": [
        {
          "description": "The ID of the scheduled email to cancel.",
          "display_name": "Email ID",
          "name": "email_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/resend/cancel-email",
      "result_str_template": "Email canceled.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "id": {
                "description": "The ID of the canceled email.",
                "type": "string"
              },
              "object": {
                "description": "Object type ('email').",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "retrieve_email": {
      "description": "Retrieve a single email's details and delivery status by ID.",
      "display_name": "Retrieve email",
      "display_str_template": "Retrieve Resend email {0}.",
      "handler": "actions.retrieve_email",
      "id": "resend_retrieve_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "bcc": null,
          "cc": null,
          "created_at": "2024-01-01T00:00:00.000Z",
          "from": "onboarding@resend.dev",
          "html": "<p>Hello World</p>",
          "id": "4ef9a417-02e9-4d39-ad75-9611e0fcc33c",
          "last_event": "delivered",
          "object": "email",
          "reply_to": null,
          "subject": "Hello World",
          "text": null,
          "to": [
            "delivered@resend.dev"
          ]
        }
      },
      "name": "retrieve_email",
      "parameters": [
        {
          "description": "The ID of the email to retrieve (returned when it was sent).",
          "display_name": "Email ID",
          "name": "email_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/resend/retrieve-email",
      "result_str_template": "Email retrieved.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "bcc": {
                "description": "Bcc addresses, if any.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "cc": {
                "description": "Cc addresses, if any.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "created_at": {
                "description": "When the email was created.",
                "type": "string"
              },
              "from": {
                "description": "Sender address.",
                "type": "string"
              },
              "html": {
                "description": "HTML body, if any.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "The email ID.",
                "type": "string"
              },
              "last_event": {
                "description": "Latest delivery event (e.g. sent, delivered, bounced).",
                "type": "string"
              },
              "object": {
                "description": "Object type ('email').",
                "type": "string"
              },
              "reply_to": {
                "description": "Reply-to addresses, if any.",
                "items": {
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "subject": {
                "description": "Email subject.",
                "type": "string"
              },
              "text": {
                "description": "Plain-text body, if any.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "description": "Recipient addresses.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "send_batch_emails": {
      "description": "Send up to 100 transactional emails in a single Resend request.",
      "display_name": "Send batch emails",
      "display_str_template": "Send a batch of Resend emails.",
      "handler": "actions.send_batch_emails",
      "id": "resend_send_batch_emails",
      "method": "POST",
      "mock_response": {
        "result": {
          "data": [
            {
              "id": "ae2014de-c168-4c61-8267-70d2662a1ce1"
            },
            {
              "id": "faccb7a5-8a28-4e9a-ac64-8da1cc3bc1cb"
            }
          ]
        }
      },
      "name": "send_batch_emails",
      "parameters": [
        {
          "description": "A list of email objects to send. Each needs 'from', 'to', 'subject', and 'html' or 'text'.",
          "display_name": "Emails",
          "name": "emails",
          "required": true,
          "schema": {
            "items": {
              "properties": {
                "from": {
                  "description": "Sender address (e.g. onboarding@resend.dev).",
                  "type": "string"
                },
                "html": {
                  "description": "HTML body (html or text).",
                  "type": "string"
                },
                "subject": {
                  "description": "Email subject.",
                  "type": "string"
                },
                "text": {
                  "description": "Plain-text body (html or text).",
                  "type": "string"
                },
                "to": {
                  "description": "One or more recipient email addresses.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "from",
                "to",
                "subject"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/resend/send-batch-emails",
      "result_str_template": "Batch emails sent.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "data": {
                "description": "One entry per sent email.",
                "items": {
                  "properties": {
                    "id": {
                      "description": "The ID of the sent email.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "send_email": {
      "description": "Send a transactional email through Resend.",
      "display_name": "Send email",
      "display_str_template": "Send Resend email '{2}'.",
      "handler": "actions.send_email",
      "id": "resend_send_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "id": "49a3999c-0ce1-4ea6-ab68-afcd6dc2e794"
        }
      },
      "name": "send_email",
      "parameters": [
        {
          "description": "Sender email address. Must use a verified domain, or 'onboarding@resend.dev' for testing to your own account address.",
          "display_name": "From",
          "examples": [
            {
              "label": "Resend test sender",
              "value": "onboarding@resend.dev"
            }
          ],
          "name": "from_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "One or more recipient email addresses.",
          "display_name": "To",
          "name": "to",
          "required": true,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Email subject line.",
          "display_name": "Subject",
          "name": "subject",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "HTML email body. Provide HTML or plain text (or both).",
          "display_name": "HTML content",
          "multiline": true,
          "name": "html",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Plain-text email body. Provide HTML or plain text (or both).",
          "display_name": "Plain text content",
          "multiline": true,
          "name": "text",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional Cc email addresses.",
          "display_name": "CC",
          "name": "cc",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Optional Bcc email addresses.",
          "display_name": "BCC",
          "name": "bcc",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Optional Reply-To email addresses.",
          "display_name": "Reply-to",
          "name": "reply_to",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Optional ISO 8601 time to schedule the email (e.g. 2024-08-05T11:52:01.858Z). Sends immediately if omitted.",
          "display_name": "Schedule for",
          "examples": [
            {
              "label": "Example time",
              "value": "2024-08-05T11:52:01.858Z"
            }
          ],
          "name": "scheduled_at",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/resend/send-email",
      "result_str_template": "Email sent.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "id": {
                "description": "The ID of the sent email.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "update_email": {
      "description": "Update a scheduled email's send time.",
      "display_name": "Reschedule email",
      "display_str_template": "Reschedule Resend email {0}.",
      "handler": "actions.update_email",
      "id": "resend_update_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "id": "49a3999c-0ce1-4ea6-ab68-afcd6dc2e794",
          "object": "email"
        }
      },
      "name": "update_email",
      "parameters": [
        {
          "description": "The ID of the scheduled email to reschedule.",
          "display_name": "Email ID",
          "name": "email_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "New ISO 8601 send time (e.g. 2024-08-05T11:52:01.858Z).",
          "display_name": "New schedule time",
          "examples": [
            {
              "label": "Example time",
              "value": "2024-08-05T11:52:01.858Z"
            }
          ],
          "name": "scheduled_at",
          "required": true,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/resend/update-email",
      "result_str_template": "Email rescheduled.",
      "returns": {
        "properties": {
          "result": {
            "properties": {
              "id": {
                "description": "The ID of the updated email.",
                "type": "string"
              },
              "object": {
                "description": "Object type ('email').",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Send and manage transactional emails with Resend, the email API for developers.",
  "display_name": "Resend",
  "id": "resend"
}
