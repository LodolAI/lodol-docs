{
  "actions": {
    "convert": {
      "description": "Convert an amount from one currency to another at the latest daily rate, or at the rate on a past day since 2 March 2024. Works for fiat, crypto and metals, e.g. USD to EUR or BTC to GBP. No API key required.",
      "display_name": "Convert currency",
      "display_str_template": "Convert {0} {1} to {2}.",
      "handler": "actions.convert",
      "id": "currency_api_convert",
      "method": "POST",
      "mock_response": {
        "amount": 100.0,
        "converted_amount": 89.086065,
        "date": "2026-10-15",
        "from_currency": "USD",
        "rate": 0.89086065,
        "summary": "100.00 USD = 89.09 EUR (rate 0.89086065, 2026-10-15)",
        "to_currency": "EUR"
      },
      "name": "convert",
      "parameters": [
        {
          "description": "The amount to convert, e.g. 100.",
          "display_name": "Amount",
          "examples": [
            {
              "label": "One hundred",
              "value": "100"
            }
          ],
          "name": "amount",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The currency the amount is in, e.g. USD.",
          "display_name": "From currency",
          "examples": [
            {
              "label": "US dollar",
              "value": "USD"
            },
            {
              "label": "Euro",
              "value": "EUR"
            },
            {
              "label": "Bitcoin",
              "value": "BTC"
            }
          ],
          "name": "from_currency",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The currency to convert to, e.g. EUR.",
          "display_name": "To currency",
          "examples": [
            {
              "label": "Euro",
              "value": "EUR"
            },
            {
              "label": "British pound",
              "value": "GBP"
            },
            {
              "label": "Gold (troy ounce)",
              "value": "XAU"
            }
          ],
          "name": "to_currency",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Use the rates published on this day, from 2 March 2024 on. Leave blank for the latest rates.",
          "display_name": "Date",
          "name": "date",
          "required": false,
          "type": "ParameterType.DATE"
        }
      ],
      "path": "/actions/library/currency-api/convert",
      "result_str_template": "{currency_api_convert,summary}.",
      "returns": {
        "properties": {
          "amount": {
            "description": "The amount converted.",
            "type": "number"
          },
          "converted_amount": {
            "description": "The amount in the target currency.",
            "type": "number"
          },
          "date": {
            "description": "The day the rate was published (YYYY-MM-DD).",
            "type": [
              "string",
              "null"
            ]
          },
          "from_currency": {
            "description": "The currency converted from, e.g. 'USD'.",
            "type": "string"
          },
          "rate": {
            "description": "How much of the target currency one unit of the source buys.",
            "type": "number"
          },
          "summary": {
            "description": "One line, e.g. '100.00 USD = 89.09 EUR (rate 0.89086065, 2026-10-15)'.",
            "type": "string"
          },
          "to_currency": {
            "description": "The currency converted to, e.g. 'EUR'.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_rates": {
      "description": "Get what one unit of a currency buys in other currencies, today or on any day since 2 March 2024. Name the currencies you want, or leave them blank for all 300+. Works for fiat, crypto and metals. No API key required.",
      "display_name": "Get exchange rates",
      "display_str_template": "Get exchange rates from {0}.",
      "handler": "actions.get_rates",
      "id": "currency_api_get_rates",
      "method": "POST",
      "mock_response": {
        "base_currency": "USD",
        "count": 5,
        "date": "2026-10-15",
        "not_found": [],
        "rates": [
          {
            "currency": "EUR",
            "rate": 0.89086065
          },
          {
            "currency": "GBP",
            "rate": 0.75481818
          },
          {
            "currency": "JPY",
            "rate": 157.71588597
          },
          {
            "currency": "BTC",
            "rate": 1.2365972e-05
          },
          {
            "currency": "XAU",
            "rate": 0.0002412717
          }
        ]
      },
      "name": "get_rates",
      "parameters": [
        {
          "description": "The currency to give rates from, e.g. USD.",
          "display_name": "From currency",
          "examples": [
            {
              "label": "US dollar",
              "value": "USD"
            },
            {
              "label": "Euro",
              "value": "EUR"
            },
            {
              "label": "Bitcoin",
              "value": "BTC"
            }
          ],
          "name": "base_currency",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The currencies to give rates in, as a list or separated by commas, e.g. EUR, GBP, JPY. Leave blank for all.",
          "display_name": "To currencies",
          "examples": [
            {
              "label": "Euro, pound and yen",
              "value": "EUR,GBP,JPY"
            }
          ],
          "name": "currencies",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Use the rates published on this day, from 2 March 2024 on. Leave blank for the latest rates.",
          "display_name": "Date",
          "name": "date",
          "required": false,
          "type": "ParameterType.DATE"
        }
      ],
      "path": "/actions/library/currency-api/get-rates",
      "result_str_template": "Got {currency_api_get_rates,count} rates from {currency_api_get_rates,base_currency}.",
      "returns": {
        "properties": {
          "base_currency": {
            "description": "The currency the rates are from, e.g. 'USD'.",
            "type": "string"
          },
          "count": {
            "description": "How many rates came back.",
            "type": "integer"
          },
          "date": {
            "description": "The day the rates were published (YYYY-MM-DD).",
            "type": [
              "string",
              "null"
            ]
          },
          "not_found": {
            "description": "Currencies asked for that the API has no rate for.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rates": {
            "description": "The rates, in the order asked for, or A to Z by code when no currencies were named.",
            "items": {
              "properties": {
                "currency": {
                  "description": "The currency code, e.g. 'EUR'.",
                  "type": "string"
                },
                "rate": {
                  "description": "How much of this currency one unit of the base currency buys.",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_currencies": {
      "description": "List the 300+ currencies the Free Currency Exchange Rates API has rates for: fiat money, common cryptocurrencies and metals such as gold, each with its code and name. Optionally search by code or name. No API key required.",
      "display_name": "List currencies",
      "display_str_template": "List currencies.",
      "handler": "actions.list_currencies",
      "id": "currency_api_list_currencies",
      "method": "POST",
      "mock_response": {
        "count": 5,
        "currencies": [
          {
            "code": "BTC",
            "name": "Bitcoin"
          },
          {
            "code": "EUR",
            "name": "Euro"
          },
          {
            "code": "GBP",
            "name": "British Pound"
          },
          {
            "code": "USD",
            "name": "US Dollar"
          },
          {
            "code": "XAU",
            "name": "Gold Ounce"
          }
        ]
      },
      "name": "list_currencies",
      "parameters": [
        {
          "description": "Only currencies whose code or name contains this, e.g. 'dollar' or 'BTC'. Leave blank for all.",
          "display_name": "Search",
          "examples": [
            {
              "label": "Dollars",
              "value": "dollar"
            }
          ],
          "name": "search",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/currency-api/list-currencies",
      "result_str_template": "Found {currency_api_list_currencies,count} currencies.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many currencies came back.",
            "type": "integer"
          },
          "currencies": {
            "description": "The currencies, A to Z by code.",
            "items": {
              "properties": {
                "code": {
                  "description": "The currency code, e.g. 'EUR'.",
                  "type": "string"
                },
                "name": {
                  "description": "The currency's name, e.g. 'Euro'. Empty when the API has none.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "categories": [
    "Market Data",
    "Cryptocurrency"
  ],
  "description": "Convert money and look up daily exchange rates for 300+ currencies, including cryptocurrencies and metals such as gold, today or on any day since March 2024, from the open-source Free Currency Exchange Rates API. No account, API key or rate limit.",
  "display_name": "Free Currency Exchange Rates",
  "id": "currency_api",
  "logo": "https://www.lodol.com/app-icons/currency-api-icon.svg",
  "triggers": {}
}
