        }
      },
      "name": "get_member",
      "parameters": [
        {
          "description": "The group's email address (or its unique ID).",
          "display_name": "Group",
          "name": "group_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The email address of the person to look up.",
          "display_name": "Member email",
          "name": "member_email",
          "required": true,
