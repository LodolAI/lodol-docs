        {
          "description": "The email address for the new group.",
          "display_name": "Group email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The display name for the group.",
          "display_name": "Group name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "An optional description of what the group is for.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-groups/create-group",
      "result_str_template": "Created group '{1}'.",
      "returns": {
        "description": "Response envelope; the payload is in the \"group_id\" field.",
        "properties": {
          "group_id": {
            "description": "ID of the created group",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
