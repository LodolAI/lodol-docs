          "member": {
            "properties": {
              "email": {
                "description": "Member email",
                "type": "string"
              },
              "id": {
                "description": "Member ID",
                "type": "string"
              },
              "role": {
                "description": "Member role (OWNER, MANAGER, or MEMBER)",
