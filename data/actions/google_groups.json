{
  "actions": {
    "add_member": {
      "description": "Add a person to a Google Group.",
      "display_name": "Add member",
      "display_str_template": "Add member '{1}' to group '{0}'.",
      "handler": "actions.add_member",
      "id": "google_groups_add_member",
      "method": "POST",
      "mock_response": {
        "member_id": "user@example.com"
      },
      "name": "add_member",
      "parameters": [
        {
          "description": "The group's email address (or its unique ID).",
          "display_name": "Group",
          "name": "group_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The email address of the person to add.",
          "display_name": "Member email",
          "name": "member_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "MEMBER",
          "description": "The person's role in the group. Owners and managers can manage the group and its members; members can only take part in the group.",
          "display_name": "Role",
          "name": "role",
          "options": [
            {
              "label": "Member",
              "value": "MEMBER"
            },
            {
              "label": "Manager",
              "value": "MANAGER"
            },
            {
              "label": "Owner",
              "value": "OWNER"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-groups/add-member",
      "result_str_template": "Added member {1} to group {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"member_id\" field.",
        "properties": {
          "member_id": {
            "description": "ID or email of the added member",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "check_if_member": {
      "description": "Check whether a person is a member of a Google Group. Counts both direct members and members inherited from nested groups.",
      "display_name": "Check if member",
      "display_str_template": "Check if '{1}' is a member of group '{0}'.",
      "handler": "actions.check_if_member",
      "id": "google_groups_check_if_member",
      "method": "POST",
      "mock_response": {
        "is_member": true
      },
      "name": "check_if_member",
      "parameters": [
        {
          "description": "The group's email address (or its unique ID).",
          "display_name": "Group",
          "name": "group_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The email address of the person to check.",
          "display_name": "Member email",
          "name": "member_email",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-groups/check-if-member",
      "result_str_template": "Checked whether {1} is a member of group {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"is_member\" field.",
        "properties": {
          "is_member": {
            "description": "Whether the person is a member of the group",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "create_group": {
      "description": "Create a new Google Group.",
      "display_name": "Create group",
      "display_str_template": "Create group '{1}'.",
