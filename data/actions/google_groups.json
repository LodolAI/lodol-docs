    "list_groups": {
      "description": "List all Google Groups in your Google Workspace organization.",
      "display_name": "List groups",
      "display_str_template": "List Google Groups.",
      "handler": "actions.list_groups",
      "id": "google_groups_list_groups",
      "method": "POST",
      "mock_response": {
        "groups": [
          {
            "directMembersCount": "15",
            "email": "engineering@example.com",
            "id": "01abc234def56789",
            "name": "Engineering Team"
          }
        ]
      },
      "name": "list_groups",
      "parameters": [
        {
          "description": "The maximum number of groups to return (1-200).",
          "display_name": "Maximum results",
          "name": "page_size",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-groups/list-groups",
      "result_str_template": "Retrieved your Google Groups.",
      "returns": {
        "description": "Response envelope; the payload is in the \"groups\" field.",
        "properties": {
          "groups": {
            "description": "List of groups",
            "items": {
              "properties": {
                "directMembersCount": {
                  "description": "Number of direct members",
                  "type": "string"
                },
                "email": {
                  "description": "Group email",
                  "type": "string"
                },
                "id": {
                  "description": "Group ID",
                  "type": "string"
                },
                "name": {
                  "description": "Group name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
