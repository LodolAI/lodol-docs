        {
          "description": "Title.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Image url.",
          "display_name": "Image url",
          "name": "image_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Ingredients.",
          "display_name": "Ingredients",
          "name": "ingredients",
          "required": true,
          "schema": {
            "description": "Ingredients.",
