              "properties": {
                "display_text": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 0,
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "upcs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Instructions.",
          "display_name": "Instructions",
          "multiline": true,
          "name": "instructions",
          "required": false,
          "schema": {
            "description": "Instructions.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Servings.",
          "display_name": "Servings",
          "minimum": 1,
          "name": "servings",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Cooking time.",
          "display_name": "Cooking time",
          "minimum": 1,
          "name": "cooking_time",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/instacart/create-recipe",
      "result_str_template": "Create recipe completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "Response.",
            "properties": {
              "products_link_url": {
                "description": "Products link url.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
