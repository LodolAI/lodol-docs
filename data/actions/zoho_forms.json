    "add_record": {
      "description": "Add a record.",
      "display_name": "Add a record",
      "display_str_template": "Add a record.",
      "handler": "actions.add_record",
      "id": "zoho_forms_add_record",
      "method": "POST",
      "mock_response": {
        "data": {},
        "has_more": false,
        "next_cursor": null
      },
      "name": "add_record",
      "output_formatter": "catalog_rest.format_result",
      "parameters": [
        {
          "description": "The unique ID of a form you own. Get it from List forms.",
          "display_name": "Form",
          "dynamic_source": "forms",
          "dynamic_source_allows_custom": true,
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A JSON object with the field values to submit. Each key is the API name of a field from Get form details, and each value must use the format of that field type; see Values by field type below.",
          "display_name": "Data",
          "name": "data",
          "required": true,
          "schema": {
            "additionalProperties": {
              "anyOf": [
                {
                  "description": "single_line: text, e.g. \"Jane\". If the field has a pattern, match it (d = one digit).",
                  "type": "string"
                },
                {
                  "description": "multi_line: text, may have line breaks.",
                  "type": "string"
                },
                {
                  "description": "email: email address, e.g. \"jane@example.com\".",
                  "type": "string"
                },
                {
                  "description": "website: URL, e.g. \"https://www.example.com\".",
                  "type": "string"
                },
                {
                  "description": "regular_exp: text that matches the field's regex_pattern.",
                  "type": "string"
                },
                {
                  "description": "number: whole number, e.g. 25.",
                  "type": "integer"
                },
                {
                  "description": "decimal and currency: number as a string with \".\" for decimals, e.g. \"1250.75\".",
                  "type": "string"
                },
                {
                  "description": "slider: whole number within the field's range, e.g. 7.",
                  "type": "integer"
                },
                {
                  "description": "rating: whole number from 1 to rating_count, e.g. 4.",
                  "type": "integer"
                },
                {
                  "description": "date: \"yyyy-MM-dd\", e.g. \"2026-11-02\".",
                  "type": "string"
                },
                {
                  "description": "monthyear: \"yyyy-MM\", e.g. \"2026-11\".",
                  "type": "string"
                },
                {
                  "description": "time: \"HH:mm\", 24-hour, e.g. \"14:30\".",
                  "type": "string"
                },
                {
                  "description": "datetime: UTC, \"yyyy-MM-ddTHH:mm:ssZ\", e.g. \"2026-11-02T09:30:00Z\".",
                  "type": "string"
                },
                {
                  "description": "phone: phone number, e.g. \"9876543210\". If the country code is enabled, also send <api_name>_det.",
                  "type": "string"
                },
                {
                  "description": "<phone api_name>_det: the phone's country code, e.g. {\"country_code\": \"+91\", \"country_iso_code\": \"in\"}.",
                  "properties": {
                    "country_code": {},
                    "country_iso_code": {}
                  },
                  "required": [
                    {},
                    {}
                  ],
                  "type": "object"
                },
                {
                  "description": "dropdown, radio and dataset_single: one choice, exactly as in choices[].value. If the choices are grouped, also send <api_name>_det.",
                  "type": "string"
                },
                {
                  "description": "<choice api_name>_det: the group of the chosen value, e.g. {\"group_name\": \"South\"}.",
                  "properties": {
                    "group_name": {}
                  },
                  "required": [
                    {}
                  ],
                  "type": "object"
                },
                {
                  "description": "checkbox, multiple_choice, image_choice and dataset_multi: list of choices from choices[].value, e.g. [\"Email\", \"SMS\"].",
                  "items": {
                    "description": {},
                    "type": {}
                  },
                  "type": "array"
                },
                {
                  "description": "decision_box, yes_or_no and terms_conditions: true or false.",
                  "type": "boolean"
                },
                {
                  "additionalProperties": {
                    "description": {},
                    "type": {}
                  },
                  "description": "name and address: object keyed by the field's inputs[].api_name, e.g. {\"Name_First\": \"Jane\", \"Name_Last\": \"Doe\"}.",
                  "type": "object"
                },
                {
                  "additionalProperties": {
                    "description": {},
                    "items": {},
                    "type": {}
                  },
                  "description": "matrix_choice: object keyed by rows[].api_name; each row is a list of {columnname, value}, e.g. {\"Row_1\": [{\"columnname\": \"Good\", \"value\": \"true\"}]}.",
                  "type": "object"
                },
                {
                  "description": "signature: PNG image as \"data:image/png;base64,<data>\".",
                  "type": "string"
                },
                {
                  "description": "file_upload, image_upload, media_upload and smart_scan: not supported by these tools; leave them out.",
                  "items": {
                    "description": {},
                    "properties": {},
                    "required": {},
                    "type": {}
                  },
                  "type": "array"
                },
                {
                  "description": "subform: list of rows; each row is an object keyed by the subform's field api_names, e.g. [{\"SingleLine1\": \"Row 1\"}].",
                  "items": {
                    "additionalProperties": {},
                    "description": {},
                    "type": {}
                  },
                  "type": "array"
                }
              ]
            },
            "minProperties": 1,
            "type": "object"
          },
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/zoho-forms/add-record",
      "result_str_template": "Request completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The service response, including all records and metadata.",
            "nullable": true,
            "type": [
              "object",
              "array",
              "null"
            ]
          },
          "has_more": {
            "description": "Whether another page is available.",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Continuation value for the next page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
