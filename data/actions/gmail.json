        "message_id": "18abc123def456",
        "thread_id": "18abc123def456"
      },
      "name": "add_label_to_message",
      "output_formatter": "actions.format_add_label_to_message_output",
      "parameters": [
        {
          "description": "The email, such as the one that started the run.",
          "display_name": "Email",
          "name": "message_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the label to add",
          "display_name": "Label name",
          "name": "label_name",
          "required": true,
          "type": "ParameterType.STRING"
