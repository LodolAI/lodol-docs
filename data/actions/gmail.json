      "returns": {
        "properties": {
          "label_id": {
            "description": "Label ID",
            "type": "string"
          },
          "message_id": {
            "description": "Message ID",
            "type": "string"
          },
          "thread_id": {
            "description": "Thread ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
