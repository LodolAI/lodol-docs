    "create_draft": {
      "description": "Save an email as a draft in Gmail without sending it. Set 'Reply to email' to draft a reply in that email's conversation.",
      "display_name": "Create draft",
      "display_str_template": "Create a draft to '{0}'.",
      "handler": "actions.create_draft",
      "id": "gmail_create_draft",
      "method": "POST",
      "mock_response": {
        "id": "r123456789",
        "message_id": "18abc123def456"
      },
      "name": "create_draft",
      "output_formatter": "actions.format_create_draft_output",
      "parameters": [
        {
          "description": "Recipient email address(es). Separate multiple recipients (including variables) with commas. Required unless 'Reply to email' is set, when leaving it blank addresses the draft to that email's sender.",
          "display_name": "To",
          "name": "to",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email subject line. Required unless 'Reply to email' is set, when leaving it blank reuses that email's subject with a 'Re:' prefix.",
          "display_name": "Subject",
          "name": "subject",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The body of the email: plain text, or HTML (such as a table made with the HTML step), which is sent as a formatted email",
          "display_name": "Body",
          "multiline": true,
          "name": "body",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional Cc recipients. Separate multiple addresses (including variables) with commas.",
          "display_name": "CC",
          "name": "cc",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional Bcc recipients. Separate multiple addresses (including variables) with commas.",
          "display_name": "BCC",
          "name": "bcc",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of an email to draft a reply to. The draft is saved in that email's conversation and threads with it when sent. Leave blank for a new email.",
          "display_name": "Reply to email",
          "name": "reply_to_message_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gmail/create-draft",
      "result_str_template": "Created draft with ID {0}.",
      "returns": {
        "properties": {
          "id": {
            "description": "Draft ID",
            "type": "string"
          },
          "message_id": {
            "description": "Message ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
