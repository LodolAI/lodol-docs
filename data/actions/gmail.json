    "download_attachments": {
      "description": "Save every attachment on an email so later steps can use the files. Choose the email, or a sender to read their latest email. An email with no attachments gives an empty list.",
      "display_name": "Download attachments",
      "display_str_template": "Download the attachments on the latest email from '{sender}'.",
      "handler": "actions.download_attachments",
      "id": "gmail_download_attachments",
      "method": "POST",
      "mock_response": {
        "document_refs": [
          "doc_0123456789abcdef0123456789abcdea",
          "doc_0123456789abcdef0123456789abcdeb"
        ],
        "documents": [
          {
            "content_type": "application/pdf",
            "document_ref": "doc_0123456789abcdef0123456789abcdea",
            "filename": "attachment1.pdf",
            "size_bytes": 2048
          },
          {
            "content_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "document_ref": "doc_0123456789abcdef0123456789abcdeb",
            "filename": "attachment2.docx",
            "size_bytes": 4096
          }
        ]
      },
      "name": "download_attachments",
      "output_formatter": "actions.format_download_attachments_output",
      "parameters": [
        {
          "description": "The email whose attachments to download, such as the one that started the run. Leave blank to use Sender instead.",
          "display_name": "Email",
          "name": "message_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Used when Email is blank: download the attachments on the latest email from this address.",
          "display_name": "Sender",
          "name": "sender",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gmail/download-attachments",
      "result_str_template": "Downloaded {0} attachments.",
      "returns": {
        "properties": {
          "document_refs": {
            "description": "References to the downloaded attachments, usable as file inputs in later steps (e.g. an email's attachments field).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "documents": {
            "description": "Downloaded attachment metadata.",
            "items": {
              "properties": {
                "content_type": {
                  "type": "string"
                },
                "document_ref": {
                  "description": "Reference to the downloaded attachment, usable as a file input in later steps.",
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "size_bytes": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write"
      ]
    },
    "find_email": {
      "description": "Find the first email that matches a Gmail search.",
      "display_name": "Find email",
      "display_str_template": "Find email matching '{0}'.",
      "handler": "actions.find_email",
      "id": "gmail_find_email",
      "method": "POST",
      "mock_response": {
        "email": {
          "body": "Hey, just wanted to follow up on our conversation from last week. Let me know if you have any questions.",
          "from": "sender@example.com",
          "id": "18abc123def456",
          "reply_body": "Hey, just wanted to follow up on our conversation from last week. Let me know if you have any questions.",
          "sender": "sender@example.com",
          "snippet": "Hey, just wanted to follow up on...",
          "subject": "Hello",
          "thread_id": "18abc123def456"
        }
      },
      "name": "find_email",
      "output_formatter": "actions.format_find_email_output",
      "parameters": [
        {
          "description": "What to search for, using Gmail's search format",
          "display_name": "Search query",
          "examples": [
            {
              "label": "From sender",
              "value": "from:sender@example.com"
            },
            {
              "label": "Unread in inbox",
              "value": "is:unread in:inbox"
            },
            {
              "label": "Subject contains",
              "value": "subject:invoice"
            },
            {
              "label": "Subject exact phrase",
              "value": "subject:\"meeting notes\""
            },
            {
              "label": "Has attachment",
              "value": "has:attachment"
            },
            {
              "label": "Recent emails",
              "value": "newer_than:1d"
            }
          ],
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "If true, only search unread emails",
          "display_name": "Unread only",
          "name": "unread_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "If true, only search in inbox",
          "display_name": "In inbox",
          "name": "in_inbox",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/gmail/find-email",
      "result_str_template": "Found email matching query.",
      "returns": {
        "description": "Object containing the found email, or email: null if not found",
        "properties": {
          "email": {
            "description": "Found email or null if not found",
            "nullable": true,
            "properties": {
              "body": {
                "description": "Full plain-text email body",
                "type": "string"
              },
              "from": {
                "description": "Sender email address",
                "type": "string"
              },
              "id": {
                "description": "Gmail message ID",
                "type": "string"
              },
              "reply_body": {
                "description": "Reply-only text with quoted content stripped",
                "type": "string"
              },
              "sender": {
                "description": "Sender email address (alias for from)",
                "type": "string"
              },
              "snippet": {
                "description": "Truncated preview of the email body text",
                "type": "string"
              },
              "subject": {
                "description": "Email subject line",
                "type": "string"
              },
              "thread_id": {
                "description": "Thread ID",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
