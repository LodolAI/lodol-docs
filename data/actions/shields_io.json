  "description": "Generate dynamic SVG badges for your README, docs, or dashboards with Shields.io's keyless badge API. Build static 'subject | status' badges, version and license badges, or dynamic badges that pull a live value from a JSON, XML, or YAML endpoint. No account or API key required.",
  "display_name": "Shields.io",
  "id": "shields_io"
}
