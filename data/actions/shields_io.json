{
  "actions": {
    "generate_badge": {
      "description": "Create a static badge with a label, message, and color: the classic 'subject | status' badge. Add a logo or a custom style to match your project's look.",
      "display_name": "Generate badge",
      "display_str_template": "Generate a Shields.io badge '{0}: {1}'.",
      "handler": "actions.generate_badge",
      "id": "shields_io_generate_badge",
      "method": "POST",
      "mock_response": {
        "badge": {
          "content_type": "image/svg+xml;charset=utf-8",
          "html": "<img src=\"https://img.shields.io/badge/build-passing-brightgreen\" alt=\"build\">",
          "markdown": "![build](https://img.shields.io/badge/build-passing-brightgreen)",
          "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"20\"><title>build: passing</title></svg>",
          "url": "https://img.shields.io/badge/build-passing-brightgreen"
        }
      },
      "name": "generate_badge",
      "parameters": [
        {
          "description": "Left-side text (the subject), for example 'build' or 'coverage'.",
          "display_name": "Label",
          "name": "label",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Right-side text (the status), for example 'passing' or '98%'.",
          "display_name": "Message",
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "blue",
          "description": "Badge color: a named color (brightgreen, green, yellow, orange, red, blue, lightgrey, etc.) or a hex code such as 4c1 or 2ea44f.",
          "display_name": "Color",
          "examples": [
            {
              "label": "Bright green",
              "value": "brightgreen"
            },
            {
              "label": "Blue",
              "value": "blue"
            },
            {
              "label": "Hex",
              "value": "2ea44f"
            }
          ],
          "name": "color",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Badge visual style. Defaults to flat when omitted.",
          "display_name": "Style",
          "name": "style",
          "options": [
            {
              "label": "flat",
              "value": "flat"
            },
            {
              "label": "flat-square",
              "value": "flat-square"
            },
            {
              "label": "plastic",
              "value": "plastic"
            },
            {
              "label": "for-the-badge",
              "value": "for-the-badge"
            },
            {
              "label": "social",
              "value": "social"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional named logo to show before the label (a Simple Icons slug, e.g. github, python, docker).",
          "display_name": "Logo",
          "name": "logo",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional color for the logo (a named color or hex code).",
          "display_name": "Logo color",
          "name": "logo_color",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional background color for the label (left) side of the badge.",
          "display_name": "Label color",
          "name": "label_color",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/shields-io/generate-badge",
      "result_str_template": "Badge generated.",
      "returns": {
        "properties": {
          "badge": {
            "properties": {
              "content_type": {
                "description": "Content-Type returned by Shields.io (image/svg+xml).",
                "type": "string"
              },
              "html": {
                "description": "HTML <img> snippet for the badge.",
                "type": "string"
              },
              "markdown": {
                "description": "Markdown image snippet ready to paste into a README.",
                "type": "string"
              },
              "svg": {
                "description": "The raw SVG markup of the rendered badge.",
                "type": "string"
              },
              "url": {
                "description": "The fully-qualified Shields.io badge URL.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "generate_dynamic_badge": {
      "description": "Create a badge whose message is pulled live from a remote JSON, XML, or YAML document. Shields.io fetches the URL and applies your query to extract the value to display.",
      "display_name": "Generate dynamic badge",
      "display_str_template": "Generate a Shields.io dynamic badge from {0}.",
      "handler": "actions.generate_dynamic_badge",
      "id": "shields_io_generate_dynamic_badge",
      "method": "POST",
      "mock_response": {
        "badge": {
          "content_type": "image/svg+xml;charset=utf-8",
          "html": "<img src=\"https://img.shields.io/badge/dynamic/json?url=https%3A%2F%2Fapi.example.com%2Fdata.json&query=%24.version&label=version&color=blue\" alt=\"version\">",
          "markdown": "![version](https://img.shields.io/badge/dynamic/json?url=https%3A%2F%2Fapi.example.com%2Fdata.json&query=%24.version&label=version&color=blue)",
          "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"20\"><title>version: 1.4.2</title></svg>",
          "url": "https://img.shields.io/badge/dynamic/json?url=https%3A%2F%2Fapi.example.com%2Fdata.json&query=%24.version&label=version&color=blue"
        }
      },
      "name": "generate_dynamic_badge",
      "parameters": [
        {
          "description": "URL of the JSON/XML/YAML document to read the value from.",
          "display_name": "Data URL",
          "name": "data_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Selector for the value: a JSONPath for JSON/YAML (e.g. $.version) or an XPath for XML.",
          "display_name": "Query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "json",
          "description": "Format of the source document. Defaults to JSON.",
          "display_name": "Data type",
          "name": "data_type",
          "options": [
            {
              "label": "JSON",
              "value": "json"
            },
            {
              "label": "XML",
              "value": "xml"
            },
            {
              "label": "YAML",
              "value": "yaml"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Left-side text (the subject) for the badge.",
          "display_name": "Label",
          "name": "label",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional badge color: a named color or a hex code. Defaults to Shields.io's own coloring when omitted.",
          "display_name": "Color",
          "examples": [
            {
              "label": "Bright green",
              "value": "brightgreen"
            },
            {
              "label": "Blue",
              "value": "blue"
            },
            {
              "label": "Hex",
              "value": "2ea44f"
            }
          ],
          "name": "color",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional text prepended to the extracted value.",
          "display_name": "Prefix",
          "name": "prefix",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional text appended to the extracted value.",
          "display_name": "Suffix",
          "name": "suffix",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Badge visual style. Defaults to flat when omitted.",
          "display_name": "Style",
          "name": "style",
          "options": [
            {
              "label": "flat",
              "value": "flat"
            },
            {
              "label": "flat-square",
              "value": "flat-square"
            },
            {
              "label": "plastic",
              "value": "plastic"
            },
            {
              "label": "for-the-badge",
              "value": "for-the-badge"
            },
            {
              "label": "social",
              "value": "social"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional named logo to show before the label (a Simple Icons slug, e.g. github, python, docker).",
          "display_name": "Logo",
          "name": "logo",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional color for the logo (a named color or hex code).",
          "display_name": "Logo color",
          "name": "logo_color",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional background color for the label (left) side of the badge.",
          "display_name": "Label color",
          "name": "label_color",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/shields-io/generate-dynamic-badge",
      "result_str_template": "Dynamic badge generated.",
      "returns": {
        "properties": {
          "badge": {
            "properties": {
              "content_type": {
                "description": "Content-Type returned by Shields.io (image/svg+xml).",
                "type": "string"
              },
              "html": {
                "description": "HTML <img> snippet for the badge.",
                "type": "string"
              },
              "markdown": {
                "description": "Markdown image snippet ready to paste into a README.",
                "type": "string"
              },
              "svg": {
                "description": "The raw SVG markup of the rendered badge.",
                "type": "string"
              },
              "url": {
                "description": "The fully-qualified Shields.io badge URL.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
