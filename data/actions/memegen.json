{
  "actions": {
    "create_meme": {
      "description": "Generate an image from a built-in template and return its URL.",
      "display_name": "Create meme",
      "display_str_template": "Create meme.",
      "handler": "actions.create_meme",
      "id": "memegen_create_meme",
      "method": "POST",
      "mock_response": {
        "data": {
          "url": "https://api.memegen.link/images/drake/Too_much_text/Short_caption.png"
        },
        "has_more": false,
        "next_cursor": null
      },
      "name": "create_meme",
      "output_formatter": "catalog_rest.format_result",
      "parameters": [
        {
          "description": "Choose the image template.",
          "display_name": "Template",
          "dynamic_source": "templates",
          "dynamic_source_allows_custom": true,
          "name": "template_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Enter the caption for each line in template order.",
          "display_name": "Caption lines",
          "name": "text",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Choose the caption font.",
          "display_name": "Font",
          "dynamic_source": "fonts",
          "dynamic_source_allows_custom": true,
          "name": "font",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Choose image format.",
          "display_name": "Image format",
          "name": "extension",
          "options": [
            {
              "label": "png",
              "value": "png"
            },
            {
              "label": "jpg",
              "value": "jpg"
            },
            {
              "label": "webp",
              "value": "webp"
            },
            {
              "label": "gif",
              "value": "gif"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/memegen/create-meme",
      "result_str_template": "Request completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The data returned by the service.",
            "properties": {
              "url": {
                "description": "URL.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "has_more": {
            "description": "Whether the service reports another page.",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Continuation value when the service reports another page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
