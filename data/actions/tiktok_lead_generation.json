      "description": "Polls a complete snapshot. Existing records establish the initial baseline; new records and changes fire after that. Scans exceeding 4,000 records fail without advancing the saved place. Polling follows your workspace plan.",
      "display_name": "Instant form changed",
      "id": "tiktok_lead_generation_instant_form_changed_trigger",
      "output": {
        "record": "object"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Advertiser id.",
          "display_name": "Advertiser id",
          "name": "advertiser_id",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "Library id.",
          "display_name": "Library id",
          "name": "library_id",
          "required": false
        }
      ]
    },
    "tiktok_lead_generation_new_instant_form_trigger": {
      "description": "Polls a complete snapshot. Existing records establish the initial baseline; new records fire after that. Scans exceeding 4,000 records fail without advancing the saved place. Polling follows your workspace plan.",
