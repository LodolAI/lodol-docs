{
  "actions": {
    "chat": {
      "description": "Send a prompt to a model deployed on your Azure OpenAI resource and get its reply. Add earlier messages to continue a conversation, or ask for the reply as JSON.",
      "display_name": "Send a chat message",
      "display_str_template": "Send {0} to Azure OpenAI.",
      "handler": "actions.chat",
      "id": "azure_openai_chat",
      "method": "POST",
      "mock_response": {
        "data": null,
        "deployment": "gpt-4o-mini",
        "finish_reason": "stop",
        "model": "gpt-4o-mini-2024-07-18",
        "text": "Our support team answers within one business day.",
        "usage": {
          "completion_tokens": 11,
          "prompt_tokens": 24,
          "total_tokens": 35
        }
      },
      "name": "chat",
      "output_formatter": "actions.format_chat",
      "parameters": [
        {
          "description": "The message or question to send.",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the deployment to use, which is often the model's name, such as gpt-4o-mini. Leave empty for the connection's default Deployment.",
          "display_name": "Deployment",
          "examples": [
            {
              "label": "GPT-4o",
              "value": "gpt-4o"
            },
            {
              "label": "GPT-4o mini",
              "value": "gpt-4o-mini"
            },
            {
              "label": "GPT-4.1",
              "value": "gpt-4.1"
            },
            {
              "label": "GPT-4.1 mini",
              "value": "gpt-4.1-mini"
            },
            {
              "label": "o4-mini",
              "value": "o4-mini"
            }
          ],
          "name": "model",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How the model should behave, such as 'Answer in one short paragraph.' Sent before everything else.",
          "display_name": "Instructions",
          "multiline": true,
          "name": "system",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The conversation so far, oldest first, to continue it. Each message has a role (user for the person, assistant for the model) and its content. The prompt is sent after them.",
          "display_name": "Earlier messages",
          "examples": [
            {
              "label": "A short chat",
              "value": "[{\"role\": \"user\", \"content\": \"What are your opening hours?\"}, {\"role\": \"assistant\", \"content\": \"9 to 5, Monday to Friday.\"}]"
            }
          ],
          "name": "messages",
          "required": false,
          "schema": {
            "items": {
              "properties": {
                "content": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "user",
                    "assistant",
                    "system",
                    "developer"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The longest the reply may be, in tokens (a token is about three quarters of a word). For a reasoning model this includes its thinking. Leave empty for the model's own limit.",
          "display_name": "Maximum tokens",
          "minimum": 1,
          "name": "max_tokens",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How varied the reply is, from 0 (focused) to 2 (most varied). Leave empty for reasoning models such as o4-mini, which refuse it.",
          "display_name": "Temperature",
          "maximum": 2,
          "minimum": 0,
          "name": "temperature",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": false,
          "description": "Make the reply a JSON object, returned parsed as data. Say in the prompt which fields you want.",
          "display_name": "Reply as JSON",
          "name": "json_output",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/azure-openai/chat",
      "result_str_template": "Azure OpenAI replied.",
      "returns": {
        "properties": {
          "data": {
            "description": "The reply parsed as JSON when Reply as JSON is on, else null.",
            "nullable": true,
            "type": "object"
          },
          "deployment": {
            "description": "The deployment that answered.",
            "type": "string"
          },
          "finish_reason": {
            "description": "Why the reply ended: stop when it was finished, length when it reached Maximum tokens.",
            "type": "string"
          },
          "model": {
            "description": "The model and version the deployment runs, such as gpt-4o-2024-08-06.",
            "nullable": true,
            "type": "string"
          },
          "text": {
            "description": "The model's reply.",
            "type": "string"
          },
          "usage": {
            "description": "The tokens the request used, which Azure bills.",
            "properties": {
              "completion_tokens": {
                "description": "Tokens in the reply.",
                "type": "integer"
              },
              "prompt_tokens": {
                "description": "Tokens in what was sent.",
                "type": "integer"
              },
              "total_tokens": {
                "description": "Both together.",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "create_embeddings": {
      "description": "Turn text into embeddings: lists of numbers that place texts with similar meanings close together, for search and matching. Up to 100 texts at once.",
      "display_name": "Create embeddings",
      "display_str_template": "Create embeddings for {0} with Azure OpenAI.",
      "handler": "actions.create_embeddings",
      "id": "azure_openai_create_embeddings",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "deployment": "text-embedding-3-small",
        "dimensions": 3,
        "embeddings": [
          [
            0.0023064255,
            -0.009327292,
            0.015797347
          ]
        ],
        "model": "text-embedding-3-small",
        "usage": {
          "prompt_tokens": 8,
          "total_tokens": 8
        }
      },
      "name": "create_embeddings",
      "output_formatter": "actions.format_create_embeddings",
      "parameters": [
        {
          "description": "The text to embed, or a list of up to 100 texts. Each gets its own embedding, in the same order.",
          "display_name": "Texts",
          "name": "input",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The name of an embedding model's deployment, which is often the model's name, such as text-embedding-3-small. Leave empty for the connection's default Deployment.",
          "display_name": "Deployment",
          "examples": [
            {
              "label": "text-embedding-3-small",
              "value": "text-embedding-3-small"
            },
            {
              "label": "text-embedding-3-large",
              "value": "text-embedding-3-large"
            },
            {
              "label": "text-embedding-ada-002",
              "value": "text-embedding-ada-002"
            }
          ],
          "name": "model",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many numbers each embedding has, for text-embedding-3 models, which can make them shorter. Leave empty for the model's full size.",
          "display_name": "Dimensions",
          "minimum": 1,
          "name": "dimensions",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/azure-openai/create-embeddings",
      "result_str_template": "Created embeddings with Azure OpenAI.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many embeddings came back.",
            "type": "integer"
          },
          "deployment": {
            "description": "The deployment that answered.",
            "type": "string"
          },
          "dimensions": {
            "description": "How many numbers each embedding has.",
            "type": "integer"
          },
          "embeddings": {
            "description": "One embedding per text, in the order given, each a list of numbers.",
            "items": {
              "description": "One text's embedding.",
              "items": {
                "description": "One number.",
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "model": {
            "description": "The model and version the deployment runs, such as gpt-4o-2024-08-06.",
            "nullable": true,
            "type": "string"
          },
          "usage": {
            "description": "The tokens the request used, which Azure bills.",
            "properties": {
              "prompt_tokens": {
                "description": "Tokens in the texts.",
                "type": "integer"
              },
              "total_tokens": {
                "description": "Tokens billed.",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "list_deployments": {
      "description": "List the deployments on your Azure OpenAI resource, with the model each one runs. Steps call a deployment by its name.",
      "display_name": "List deployments",
      "display_str_template": "List the Azure OpenAI deployments.",
      "handler": "actions.list_deployments",
      "id": "azure_openai_list_deployments",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "deployments": [
          {
            "created_at": "2025-03-04T10:15:27Z",
            "id": "gpt-4o-mini",
            "model": "gpt-4o-mini",
            "name": "gpt-4o-mini",
            "scale_type": "standard",
            "status": "succeeded"
          },
          {
            "created_at": "2025-03-04T10:21:51Z",
            "id": "embeddings",
            "model": "text-embedding-3-small",
            "name": "embeddings",
            "scale_type": "standard",
            "status": "succeeded"
          }
        ]
      },
      "name": "list_deployments",
      "output_formatter": "actions.format_list_deployments",
      "parameters": [],
      "path": "/actions/library/azure-openai/list-deployments",
      "result_str_template": "Listed the Azure OpenAI deployments.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many deployments came back.",
            "type": "integer"
          },
          "deployments": {
            "description": "The resource's deployments.",
            "items": {
              "properties": {
                "created_at": {
                  "description": "When it was created, as an ISO 8601 time.",
                  "type": "string"
                },
                "id": {
                  "description": "The deployment's id, its name.",
                  "type": "string"
                },
                "model": {
                  "description": "The model it runs, such as gpt-4o.",
                  "type": "string"
                },
                "name": {
                  "description": "The name steps use in their Deployment field.",
                  "type": "string"
                },
                "scale_type": {
                  "description": "How it is billed and scaled, such as standard.",
                  "type": "string"
                },
                "status": {
                  "description": "succeeded when it is ready to use.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_models": {
      "description": "List the models your Azure OpenAI resource can use, with what each can do and when Azure retires it.",
      "display_name": "List models",
      "display_str_template": "List the Azure OpenAI models.",
      "handler": "actions.list_models",
      "id": "azure_openai_list_models",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "models": [
          {
            "capabilities": [
              "chat_completion",
              "inference"
            ],
            "created_at": "2024-08-06T00:00:00Z",
            "fine_tuning_ends_on": null,
            "id": "gpt-4o-2024-08-06",
            "inference_ends_on": "2026-03-31",
            "lifecycle_status": "generally-available"
          },
          {
            "capabilities": [
              "embeddings",
              "inference"
            ],
            "created_at": "2024-01-25T00:00:00Z",
            "fine_tuning_ends_on": null,
            "id": "text-embedding-3-small",
            "inference_ends_on": "2027-02-01",
            "lifecycle_status": "generally-available"
          }
        ]
      },
      "name": "list_models",
      "output_formatter": "actions.format_list_models",
      "parameters": [
        {
          "default": "any",
          "description": "Only models that can do this.",
          "display_name": "Can do",
          "name": "capability",
          "options": [
            {
              "label": "Any",
              "value": "any"
            },
            {
              "label": "Chat",
              "value": "chat_completion"
            },
            {
              "label": "Embeddings",
              "value": "embeddings"
            },
            {
              "label": "Text completion",
              "value": "completion"
            },
            {
              "label": "Can be deployed",
              "value": "inference"
            },
            {
              "label": "Fine-tuning",
              "value": "fine_tune"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/azure-openai/list-models",
      "result_str_template": "Listed the Azure OpenAI models.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many models came back.",
            "type": "integer"
          },
          "models": {
            "description": "The models.",
            "items": {
              "properties": {
                "capabilities": {
                  "description": "What it can do: chat_completion, embeddings, completion, inference (can be deployed) and fine_tune.",
                  "items": {
                    "description": "A capability.",
                    "type": "string"
                  },
                  "type": "array"
                },
                "created_at": {
                  "description": "When it was added, as an ISO 8601 time.",
                  "type": "string"
                },
                "fine_tuning_ends_on": {
                  "description": "The date (YYYY-MM-DD) after which it can no longer be fine-tuned, or null.",
                  "nullable": true,
                  "type": "string"
                },
                "id": {
                  "description": "The model and version, such as gpt-4o-2024-08-06.",
                  "type": "string"
                },
                "inference_ends_on": {
                  "description": "The date (YYYY-MM-DD) after which it can no longer be used, or null.",
                  "nullable": true,
                  "type": "string"
                },
                "lifecycle_status": {
                  "description": "preview, generally-available, deprecating or deprecated.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    }
  },
  "categories": [
    "AI Models",
    "Microsoft"
  ],
  "description": "Chat with OpenAI models deployed on your own Azure resource, create embeddings, and list your deployments and the models you can deploy.",
  "display_name": "Azure OpenAI",
  "id": "azure_openai",
  "logo": "https://www.lodol.com/app-icons/azure-openai-icon.svg",
  "triggers": {}
}
