{
  "actions": {
    "create_qr_code": {
      "description": "Create a dynamic QR code that points to a web link. Returns the QR code image and a short link you can edit later without reprinting the code.",
      "display_name": "Create a QR code",
      "display_str_template": "Create a QR code for {0} with CodeQR.",
      "handler": "actions.create_qr_code",
      "id": "codeqr_create_qr_code",
      "method": "POST",
      "mock_response": {
        "created_at": "2026-07-31T12:00:00.000Z",
        "destination_url": "https://example.com",
        "id": "qr_1JGCV8Z9K7X2A0B3C4D5E6F7",
        "key": "abc1234",
        "qr_code": "https://api.codeqr.io/qrcodes/abc1234.png",
        "short_link": "https://codeqr.link/abc1234",
        "type": "url"
      },
      "name": "create_qr_code",
      "output_formatter": "actions.created_qr_formatter",
      "parameters": [
        {
          "description": "The web link the QR code should open when scanned.",
          "display_name": "Destination URL",
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. The colour of the QR code dots, as a hex code (for example '#000000').",
          "display_name": "Foreground colour",
          "name": "fg_color",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. The QR code's background colour, as a hex code (for example '#ffffff').",
          "display_name": "Background colour",
          "name": "bg_color",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/codeqr/create-qr-code",
      "result_str_template": "QR code created: {create_qr_code,short_link}",
      "returns": {
        "properties": {
          "created_at": {
            "description": "When the QR code was created",
            "type": "string"
          },
          "destination_url": {
            "description": "The URL the QR code points to",
            "type": "string"
          },
          "id": {
            "description": "The QR code's unique id",
            "type": "string"
          },
          "key": {
            "description": "The short link's key (slug)",
            "type": "string"
          },
          "qr_code": {
            "description": "The QR code image (an SVG/PNG data URL or link)",
            "type": "string"
          },
          "short_link": {
            "description": "The scannable short link the QR code encodes",
            "type": "string"
          },
          "type": {
            "description": "The QR code type (e.g. 'url')",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_qr_code": {
      "description": "Delete a QR code by its id.",
      "display_name": "Delete a QR code",
      "display_str_template": "Delete a CodeQR QR code.",
      "handler": "actions.delete_qr_code",
      "id": "codeqr_delete_qr_code",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": "qr_1JGCV8Z9K7X2A0B3C4D5E6F7"
      },
      "name": "delete_qr_code",
      "output_formatter": "actions.deleted_qr_formatter",
      "parameters": [
        {
          "description": "The id of the QR code to delete.",
          "display_name": "QR code ID",
          "name": "qr_code_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/codeqr/delete-qr-code",
      "result_str_template": "QR code deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True when the QR code was removed",
            "type": "boolean"
          },
          "id": {
            "description": "The id of the deleted QR code",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_qr_code": {
      "description": "Look up a QR code's details by its short link.",
      "display_name": "Get a QR code",
      "display_str_template": "Get a CodeQR QR code.",
      "handler": "actions.get_qr_code",
      "id": "codeqr_get_qr_code",
      "method": "POST",
      "mock_response": {
        "created_at": "2026-07-31T12:00:00.000Z",
        "destination_url": "https://example.com",
        "id": "qr_1JGCV8Z9K7X2A0B3C4D5E6F7",
        "key": "abc1234",
        "qr_code": "https://api.codeqr.io/qrcodes/abc1234.png",
        "short_link": "https://codeqr.link/abc1234",
        "type": "url"
      },
      "name": "get_qr_code",
      "parameters": [
        {
          "description": "The QR code's short link, for example 'https://qr.codeqr.io/abc1234'. You can also paste just its key (the part after the domain).",
          "display_name": "QR code short link",
          "name": "short_link",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/codeqr/get-qr-code",
      "result_str_template": "Fetched QR code {get_qr_code,id}",
      "returns": {
        "properties": {
          "created_at": {
            "description": "When the QR code was created",
            "type": "string"
          },
          "destination_url": {
            "description": "The URL the QR code points to",
            "type": "string"
          },
          "id": {
            "description": "The QR code's unique id",
            "type": "string"
          },
          "key": {
            "description": "The short link's key (slug)",
            "type": "string"
          },
          "qr_code": {
            "description": "The QR code image (an SVG/PNG data URL or link)",
            "type": "string"
          },
          "short_link": {
            "description": "The scannable short link the QR code encodes",
            "type": "string"
          },
          "type": {
            "description": "The QR code type (e.g. 'url')",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create, look up, and delete dynamic QR codes with CodeQR.",
  "display_name": "CodeQR",
  "id": "codeqr"
}
