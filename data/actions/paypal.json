{
  "actions": {
    "capture_order": {
      "description": "Collect (capture) the payment for an approved PayPal order.",
      "display_name": "Capture a PayPal order",
      "display_str_template": "Capture PayPal order {0}",
      "handler": "actions.capture_order",
      "id": "paypal_capture_order",
      "method": "POST",
      "mock_response": {},
      "name": "capture_order",
      "output_formatter": "actions.format_capture_order_output",
      "parameters": [
        {
          "description": "The ID of the order to collect payment for",
          "display_name": "Order ID",
          "name": "order_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/paypal/capture-order",
      "result_str_template": "Order captured.",
      "returns": {
        "description": "PayPal capture result object returned by the PayPal API containing payment capture details.",
        "type": "object"
      }
    },
    "create_order": {
      "description": "Create a PayPal checkout order ready for buyer approval.",
      "display_name": "Create a PayPal order",
      "display_str_template": "Create PayPal order for {0} {1}",
      "handler": "actions.create_order",
      "id": "paypal_create_order",
      "method": "POST",
      "mock_response": {},
      "name": "create_order",
      "output_formatter": "actions.format_create_order_output",
      "parameters": [
        {
          "description": "Order amount",
          "display_name": "Amount",
          "name": "amount",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Currency code (e.g. USD)",
          "display_name": "Currency",
          "name": "currency",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Order description",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/paypal/create-order",
      "result_str_template": "Order created.",
      "returns": {
        "description": "PayPal order object returned by the PayPal API containing order details and approval links.",
        "type": "object"
      }
    },
