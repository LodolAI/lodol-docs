      "method": "POST",
      "mock_response": {},
      "name": "get_order",
      "output_formatter": "actions.format_get_order_output",
      "parameters": [
        {
          "description": "The ID of the order to look up",
          "display_name": "Order ID",
          "name": "order_id",
