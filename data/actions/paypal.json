          "name": "interval_count",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Billing currency",
          "display_name": "Currency",
          "name": "currency",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Recurring charge amount",
          "display_name": "Amount",
          "name": "amount",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
