{
  "actions": {
    "check_for_payments": {
      "description": "Ask whether anything has just been paid to your address, without needing to know a transaction hash. It looks through the last five blocks and everything still waiting to confirm, which is about the last ten minutes, so schedule it to run at least that often, or a payment can slip past between runs. It needs your wallet's private view key, which can read incoming payments but can never spend. To check a payment you already have the transaction hash for, use 'Check a transaction for a payment' instead.",
      "display_name": "Check for a new payment",
      "display_str_template": "Check a Monero address for a new payment.",
      "handler": "actions.check_for_payments",
      "id": "monero_explorer_check_for_payments",
      "method": "POST",
      "mock_response": {
        "blocks_checked_from": 3760648,
        "blocks_checked_to": 3760652,
        "note": "",
        "payment_count": 1,
        "payments": [
          {
            "amount_xmr": 0.25,
            "block_height": null,
            "confirmed": false,
            "explorer_url": "https://xmrchain.net/tx/9233708004c51d15f44e86ac1a3b99582ed2bede4aaac6e2dd71424a9147b06f",
            "payment_id": "",
            "status": "waiting to confirm",
            "transaction_hash": "9233708004c51d15f44e86ac1a3b99582ed2bede4aaac6e2dd71424a9147b06f"
          }
        ],
        "total_received_xmr": 0.25
      },
      "name": "check_for_payments",
      "output_formatter": "actions.format_payments_output",
      "parameters": [
        {
          "description": "The address the payment was sent to. 95 characters, or 106 for an integrated address.",
          "display_name": "Your Monero address",
          "name": "address",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The private view key of the wallet that owns the address above. Find it in the Monero GUI under Settings > Wallet > Show seed & keys. A view key can only read payments coming in; it can never spend, and it is never stored by the explorer. It does let whoever holds it see what that address receives, so use a wallet you are willing to have read, or connect your own explorer.",
          "display_name": "Your private view key",
          "name": "view_key",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/monero-explorer/check-for-payments",
      "result_str_template": "{monero_explorer_check_for_payments,payment_count} payment(s) found.",
      "returns": {
        "properties": {
          "blocks_checked_from": {
            "type": "number"
          },
          "blocks_checked_to": {
            "type": "number"
          },
          "note": {
            "description": "Set only when nothing was found, explaining what else could account for that. Empty otherwise.",
            "type": "string"
          },
          "payment_count": {
            "type": "number"
          },
          "payments": {
            "description": "Everything paid to the address in the window, including payments not yet in a block.",
            "items": {
              "properties": {
                "amount_xmr": {
                  "type": "number"
                },
                "block_height": {
                  "description": "Empty while the payment is still waiting to confirm.",
                  "type": "number"
                },
                "confirmed": {
                  "type": "boolean"
                },
                "explorer_url": {
                  "type": "string"
                },
                "payment_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "transaction_hash": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total_received_xmr": {
            "type": "number"
          }
