{
  "actions": {
    "create_subscription": {
      "description": "Add a subscriber to a beehiiv publication by email, the core way to grow a list from another source such as a form, CRM, or purchase. Optionally send the welcome email, reactivate a previously unsubscribed contact, record UTM/referrer attribution, set values for existing custom fields, and override double opt-in. Custom fields must already exist on the publication.",
      "display_name": "Create beehiiv subscription",
      "display_str_template": "Add {1} to beehiiv publication {0}.",
      "handler": "actions.create_subscription",
      "id": "beehiiv_create_subscription",
      "method": "POST",
      "mock_response": {
        "data": {
          "created": 1719400000,
          "email": "reader@example.com",
          "id": "sub_11112222-3333-4444-5555-666677778888",
          "referral_code": "ab12cd34",
          "referring_site": "example.com",
          "status": "active",
          "subscription_tier": "free",
          "utm_campaign": "spring-launch",
          "utm_medium": "api",
          "utm_source": "workflow"
