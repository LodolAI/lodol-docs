      },
      "name": "create_subscription",
      "output_formatter": "actions.format_create_subscription_output",
      "parameters": [
        {
          "description": "The beehiiv publication to act on, e.g. 'pub_00000000-0000-0000-0000-000000000000'. Use the 'List beehiiv publications' action to find it.",
