          "examples": [
            {
              "label": "Publication ID",
              "value": "pub_00000000-0000-0000-0000-000000000000"
            }
          ],
          "name": "publication_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email address of the subscriber to add.",
          "display_name": "Email",
          "examples": [
            {
              "label": "Email",
              "value": "reader@example.com"
            }
          ],
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "When true, re-activate the contact if they previously unsubscribed. Defaults to false.",
          "display_name": "Reactivate existing",
          "name": "reactivate_existing",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "When true, send the publication's welcome email to the new subscriber. Defaults to false.",
          "display_name": "Send welcome email",
          "name": "send_welcome_email",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Attribution source recorded on the subscription.",
          "display_name": "UTM source",
          "name": "utm_source",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Attribution medium recorded on the subscription.",
          "display_name": "UTM medium",
          "name": "utm_medium",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Attribution campaign recorded on the subscription.",
          "display_name": "UTM campaign",
          "name": "utm_campaign",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The site the subscriber came from.",
          "display_name": "Referring site",
          "name": "referring_site",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Override the publication's double opt-in setting for this subscriber. 'on' sends a confirmation email, 'off' activates immediately, 'not_set' uses the publication default.",
          "display_name": "Double opt-in override",
          "name": "double_opt_override",
          "options": [
            {
              "label": "Use publication default",
              "value": "not_set"
            },
            {
              "label": "On (send confirmation email)",
              "value": "on"
            },
            {
              "label": "Off (activate immediately)",
              "value": "off"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Values for custom fields that already exist on the publication, as a list of {name, value} objects. Unknown fields are ignored by beehiiv.",
          "display_name": "Custom fields",
          "name": "custom_fields",
          "required": false,
          "schema": {
            "items": {
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/beehiiv/create-subscription",
