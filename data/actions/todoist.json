    "create_task": {
      "description": "Create a new Todoist task, with an optional project and due date.",
      "display_name": "Create a task",
      "display_str_template": "Create task '{0}'.",
      "handler": "actions.create_task",
      "id": "todoist_create_task",
      "method": "POST",
      "mock_response": {
        "content": "Buy milk",
        "due": {
          "date": "2024-01-20",
          "string": "tomorrow"
        },
        "id": "2995104339",
        "project_id": "2203306141"
      },
      "name": "create_task",
      "output_formatter": "actions.format_create_task_output",
      "parameters": [
        {
          "description": "The task text, for example, Buy milk.",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of the project to add the task to.",
          "display_name": "Project ID",
          "name": "project_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the task is due, in plain words, for example, tomorrow or next Monday at 3pm.",
          "display_name": "Due date",
          "name": "due_string",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/todoist/create-task",
      "result_str_template": "Task created.",
      "returns": {
        "description": "Todoist task object from API.",
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
