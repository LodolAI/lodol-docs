  "triggers": {
    "todoist_new_project_trigger": {
      "description": "Runs when a project is added to your Todoist. Projects already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New project",
      "id": "todoist_new_project_trigger",
      "output": {
        "color": "Its colour, such as charcoal.",
        "id": "The project's ID, for steps that take one.",
        "is_favorite": "True when it is a favourite.",
        "name": "The project's name.",
        "parent_id": "The project it sits under, blank for a top-level one.",
        "url": "Link that opens the project."
      },
      "parameters": []
    },
    "todoist_new_task_trigger": {
      "description": "Runs when a new task is added to Todoist.",
      "display_name": "New task",
      "id": "todoist_new_task_trigger",
      "output": {
        "content": "string",
        "due_string": "string",
        "id": "string",
        "project_id": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Todoist project ID to watch. Leave blank to watch all projects.",
          "display_name": "Project",
          "name": "project_id",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "Only trigger for tasks whose text contains this. Leave blank to match any task.",
          "display_name": "Task text filter",
          "name": "content_pattern",
          "required": false
        }
      ]
    },
    "todoist_task_completed_trigger": {
      "description": "Runs when you complete a Todoist task, in one project or any, including each time you complete a recurring one. Tasks completed before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Task completed",
      "id": "todoist_task_completed_trigger",
      "output": {
        "completed_at": "When it was completed (UTC).",
        "content": "The task text.",
        "description": "The task's description.",
        "due_date": "When it was due (YYYY-MM-DD); blank when it had no due date.",
        "id": "The task's ID.",
        "labels": "The task's labels.",
        "priority": "p1 (most urgent) to p4 (none), as the Todoist app shows it.",
        "project_id": "The project it is in.",
        "recurring": "True for a recurring task, which comes back for its next date.",
        "url": "Link that opens the task."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Todoist project ID to watch. Leave blank to watch all projects.",
          "display_name": "Project",
          "name": "project_id",
          "required": false
        }
      ]
    }
  }
