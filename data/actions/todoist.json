    "find_tasks": {
      "description": "List your open Todoist tasks: all of them, those in one project or with one label, or those a filter such as today or overdue picks out.",
      "display_name": "Find tasks",
      "display_str_template": "Find tasks.",
      "handler": "actions.find_tasks",
      "id": "todoist_find_tasks",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "tasks": [
          {
            "content": "Buy milk",
            "description": "",
            "due_date": "2026-11-30",
            "due_string": "tomorrow",
            "id": "2995104339",
            "labels": [
              "Errands"
            ],
            "priority": "p2",
            "project_id": "2203306141",
            "url": "https://app.todoist.com/app/task/2995104339"
          }
        ]
      },
      "name": "find_tasks",
      "output_formatter": "actions.format_find_tasks_output",
      "parameters": [
        {
          "description": "The ID of a project to list tasks from. Leave blank for every project.",
          "display_name": "Project ID",
          "name": "project_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A Todoist filter, written as in the Todoist app, such as today, overdue or today | overdue.",
          "display_name": "Filter",
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only tasks with this label, such as Errands.",
          "display_name": "Label",
          "name": "label",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/todoist/find-tasks",
      "result_str_template": "Tasks found.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many tasks.",
            "type": "integer"
          },
          "tasks": {
            "description": "The open tasks found.",
            "items": {
              "properties": {
                "content": {
                  "description": "The task text.",
                  "type": "string"
                },
                "description": {
                  "description": "The task's description.",
                  "type": "string"
                },
                "due_date": {
                  "description": "When it is due (YYYY-MM-DD); blank when it has no due date.",
                  "type": "string"
                },
                "due_string": {
                  "description": "The due date in words, such as every Monday.",
                  "type": "string"
                },
                "id": {
                  "description": "Task ID.",
                  "type": "string"
                },
                "labels": {
                  "description": "The task's labels.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "priority": {
                  "description": "p1 (most urgent) to p4 (none), as the Todoist app shows it.",
                  "type": "string"
                },
                "project_id": {
                  "description": "The project it is in.",
                  "type": "string"
                },
                "url": {
                  "description": "Link that opens the task.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
