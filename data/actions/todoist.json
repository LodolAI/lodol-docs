{
  "actions": {
    "add_comment": {
      "description": "Add a comment to a Todoist task.",
      "display_name": "Add a task comment",
      "display_str_template": "Add comment to Todoist task '{0}'.",
      "handler": "actions.add_comment",
      "id": "todoist_add_comment",
      "method": "POST",
      "mock_response": {
        "content": "Don't forget to get organic milk",
        "id": "123456789",
        "task_id": "2995104339"
      },
      "name": "add_comment",
      "output_formatter": "actions.format_add_comment_output",
      "parameters": [
        {
          "description": "Task ID to comment on.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Comment text.",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/todoist/add-comment",
      "result_str_template": "Comment added.",
      "returns": {
        "description": "Todoist comment object from API.",
        "type": "object"
      }
    },
    "close_task": {
      "description": "Close a Todoist task.",
      "display_name": "Close a task",
      "display_str_template": "Close Todoist task '{0}'.",
      "handler": "actions.close_task",
      "id": "todoist_close_task",
      "method": "POST",
      "mock_response": {
        "status": "closed"
      },
      "name": "close_task",
      "output_formatter": "actions.format_close_task_output",
      "parameters": [
        {
          "description": "Task ID to close.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/todoist/close-task",
      "result_str_template": "Task closed.",
      "returns": {
        "properties": {
          "status": {
            "description": "Close operation status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_task": {
      "description": "Create a new Todoist task, with an optional project and due date.",
      "display_name": "Create a task",
      "display_str_template": "Create Todoist task '{0}'.",
      "handler": "actions.create_task",
      "id": "todoist_create_task",
      "method": "POST",
      "mock_response": {
        "content": "Buy milk",
        "due": {
          "date": "2024-01-20",
          "string": "tomorrow"
        },
        "id": "2995104339",
        "project_id": "2203306141"
      },
      "name": "create_task",
      "output_formatter": "actions.format_create_task_output",
      "parameters": [
        {
          "description": "The task text, for example, Buy milk.",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of the project to add the task to.",
          "display_name": "Project ID",
          "name": "project_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the task is due, in plain words, for example, tomorrow or next Monday at 3pm.",
          "display_name": "Due date",
          "name": "due_string",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/todoist/create-task",
      "result_str_template": "Task created.",
      "returns": {
        "description": "Todoist task object from API.",
        "type": "object"
      }
    },
    "list_projects": {
      "description": "List all of your Todoist projects.",
      "display_name": "List projects",
      "display_str_template": "List Todoist projects.",
      "handler": "actions.list_projects",
      "id": "todoist_list_projects",
      "method": "POST",
      "mock_response": [
        {
          "color": "blue",
          "id": "2203306141",
          "name": "Shopping"
        }
      ],
      "name": "list_projects",
      "output_formatter": "actions.format_list_projects_output",
      "parameters": [],
      "path": "/actions/library/todoist/list-projects",
      "result_str_template": "Projects fetched.",
      "returns": {
        "description": "Array of Todoist project objects.",
        "items": {
          "description": "Todoist project object from API.",
          "type": "object"
        },
        "type": "array"
      }
    },
    "reopen_task": {
      "description": "Reopen a completed Todoist task.",
      "display_name": "Reopen a task",
      "display_str_template": "Reopen Todoist task '{0}'.",
      "handler": "actions.reopen_task",
      "id": "todoist_reopen_task",
      "method": "POST",
      "mock_response": {
        "status": "reopened"
      },
      "name": "reopen_task",
      "output_formatter": "actions.format_reopen_task_output",
      "parameters": [
        {
          "description": "Task ID to reopen.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/todoist/reopen-task",
      "result_str_template": "Task reopened.",
      "returns": {
        "properties": {
          "status": {
            "description": "Reopen operation status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create and manage tasks, comments, and projects in Todoist.",
  "display_name": "Todoist",
  "id": "todoist"
}
