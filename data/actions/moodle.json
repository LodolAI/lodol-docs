    "moodle_new_calendar_event_trigger": {
      "description": "Runs for each new calendar event in Moodle. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New calendar event",
      "id": "moodle_new_calendar_event_trigger",
      "output": {
        "record": "object with the fields id, name, timestart"
      },
      "parameters": []
    },
    "moodle_new_course_trigger": {
