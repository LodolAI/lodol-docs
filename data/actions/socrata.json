          "name": "where",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only rows containing these words in any text column.",
          "display_name": "Search words",
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 20,
          "description": "How many of the most common values to return.",
          "display_name": "Values",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
