              "label": "NYC Open Data",
              "value": "data.cityofnewyork.us"
            },
            {
              "label": "Chicago Data Portal",
              "value": "data.cityofchicago.org"
            },
            {
              "label": "CDC data",
              "value": "data.cdc.gov"
            }
          ],
          "name": "portal",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Pick a dataset, or enter its id (such as erm2-nwe9), or paste a link to its page. The list shows the portal's most viewed datasets.",
          "display_name": "Dataset",
          "dynamic_source": "datasets",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "portal"
          ],
          "name": "dataset",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The column whose values to count.",
          "display_name": "Column",
          "dynamic_source": "columns",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "portal",
            "dataset"
          ],
          "name": "column",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only rows whose column holds exactly this value, by field name, such as borough = BRONX.",
          "display_name": "Exact matches",
          "name": "filters",
          "object_key_name": "Column field name",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Only rows meeting this condition, written in SoQL with column field names, such as created_date > '2026-01-01' AND borough = 'BRONX'.",
