      "id": "kixie_get_agent_status",
      "method": "POST",
      "mock_response": {
        "data": {
          "result": {
            "device": "example",
            "onCall": 1,
            "registered": 1
          },
          "success": true
        }
      },
      "name": "get_agent_status",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "The agent\u2019s Kixie email address. Leave blank to use the connected agent.",
          "display_name": "Agent email",
          "name": "agent_email",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/kixie/get-agent-status",
      "result_str_template": "Get agent status completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response from Kixie.",
            "properties": {
              "result": {
                "description": "Result.",
                "properties": {
                  "device": {
                    "description": "Device.",
                    "type": "string"
                  },
                  "onCall": {
                    "description": "OnCall.",
                    "type": "integer"
                  },
                  "registered": {
                    "description": "Registered.",
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "success": {
                "description": "Success.",
                "type": "boolean"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "place_call": {
      "description": "Start a call from a Kixie agent to a phone number.",
      "display_name": "Place a call",
      "display_str_template": "Place a call.",
