      "id": "kixie_place_call",
      "method": "POST",
      "mock_response": {
        "data": {}
      },
      "name": "place_call",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "The email address of the Kixie agent placing the call.",
          "display_name": "Agent email",
          "name": "agent_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The destination number with country code, digits only.",
          "display_name": "Phone number",
          "name": "phone_number",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name to show in PowerCall.",
          "display_name": "Dialer label",
          "name": "dialer_label",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/kixie/place-call",
      "result_str_template": "Place a call completed.",
