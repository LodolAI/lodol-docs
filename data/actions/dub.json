{
  "actions": {
    "expand_link": {
      "description": "Expand a Dub short link into its original long web address.",
      "display_name": "Expand a short link",
      "display_str_template": "Expand {0} into its original URL.",
      "handler": "actions.expand_link",
      "id": "dub_expand_link",
      "method": "POST",
      "mock_response": {
        "domain": "dub.sh",
        "id": "link_abc",
        "key": "abc123",
        "long_url": "https://example.com/my-page",
        "short_link": "https://dub.sh/abc123"
      },
      "name": "expand_link",
      "parameters": [
        {
          "description": "The Dub short link to expand, for example https://dub.sh/abc123.",
          "display_name": "Short link",
          "name": "short_link",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/dub/expand-link",
      "result_str_template": "Original URL: {dub_expand_link,long_url}",
      "returns": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "long_url": {
            "type": "string"
          },
          "short_link": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "shorten_link": {
      "description": "Turn a long web address into a short, shareable Dub link. You can optionally choose which short-link domain to use.",
      "display_name": "Shorten a link",
      "display_str_template": "Shorten {0} with Dub.",
      "handler": "actions.shorten_link",
      "id": "dub_shorten_link",
      "method": "POST",
      "mock_response": {
        "domain": "dub.sh",
        "id": "link_abc",
        "key": "abc123",
        "long_url": "https://example.com/my-page",
        "short_link": "https://dub.sh/abc123"
      },
      "name": "shorten_link",
      "parameters": [
        {
          "description": "The full web address you want to shorten.",
          "display_name": "Long URL",
          "name": "long_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. The short-link domain to use. Leave blank to use your Dub workspace's default domain (dub.sh on the free plan).",
          "display_name": "Domain",
          "name": "domain",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/dub/shorten-link",
      "result_str_template": "Short link: {dub_shorten_link,short_link}",
      "returns": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "long_url": {
            "type": "string"
          },
          "short_link": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create short links with Dub and look up where existing Dub short links lead.",
  "display_name": "Dub",
  "id": "dub"
}
