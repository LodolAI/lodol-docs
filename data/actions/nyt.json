{
  "actions": {
    "get_bestsellers": {
      "description": "Get the current New York Times Best Sellers list for a category.",
      "display_name": "Get bestsellers",
      "display_str_template": "Get the New York Times '{0}' bestsellers list.",
      "handler": "actions.get_bestsellers",
      "id": "nyt_get_bestsellers",
      "method": "POST",
      "mock_response": {
        "books": [
          {
            "author": "Sam Author",
            "description": "A sweeping, ambitious debut.",
            "publisher": "Example Publisher",
            "purchase_url": "https://www.amazon.com/example",
            "rank": 1,
            "title": "EXAMPLE NOVEL",
            "weeks_on_list": 3
          }
        ]
      },
      "name": "get_bestsellers",
      "parameters": [
        {
          "description": "Best Sellers list to fetch, for example 'hardcover-fiction' or 'hardcover-nonfiction'. See the docs for the full list of names.",
          "display_name": "List name",
          "examples": [
            {
              "label": "List name",
              "value": "hardcover-fiction"
            }
          ],
          "name": "list_name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/nyt/get-bestsellers",
      "result_str_template": "Fetched the New York Times bestsellers list.",
      "returns": {
        "properties": {
          "books": {
            "description": "Books on the list, in rank order",
            "items": {
              "properties": {
                "author": {
                  "description": "Book author",
                  "type": "string"
                },
                "description": {
                  "description": "Short description of the book",
                  "type": "string"
                },
                "publisher": {
                  "description": "Publisher",
                  "type": "string"
                },
                "purchase_url": {
                  "description": "URL where the book can be purchased",
                  "type": "string"
                },
                "rank": {
                  "description": "Current rank on the list",
                  "type": "number"
                },
                "title": {
                  "description": "Book title",
                  "type": "string"
                },
                "weeks_on_list": {
                  "description": "Number of weeks the book has been on the list",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_most_popular": {
      "description": "Get the most-viewed New York Times articles over the past 1, 7, or 30 days.",
      "display_name": "Get most popular articles",
      "display_str_template": "Get the most popular New York Times articles.",
      "handler": "actions.get_most_popular",
      "id": "nyt_get_most_popular",
      "method": "POST",
      "mock_response": {
        "articles": [
          {
            "abstract": "A viral story about an unexpected topic.",
            "byline": "By Alex Lee",
            "published_date": "2026-01-18",
            "title": "The Most-Read Story This Week",
            "url": "https://www.nytimes.com/example.html"
          }
        ]
      },
      "name": "get_most_popular",
      "parameters": [
        {
          "default": 7,
          "description": "Lookback window in days: 1, 7, or 30.",
          "display_name": "Period",
          "name": "period",
          "options": [
            {
              "label": "Past day",
              "value": "1"
            },
            {
              "label": "Past week",
              "value": "7"
            },
            {
              "label": "Past month",
              "value": "30"
            }
          ],
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/nyt/get-most-popular",
      "result_str_template": "Fetched the most popular New York Times articles.",
      "returns": {
        "properties": {
          "articles": {
            "description": "Most-viewed articles in the period",
            "items": {
              "properties": {
                "abstract": {
                  "description": "Short summary of the article",
                  "type": "string"
                },
                "byline": {
                  "description": "Author byline",
                  "type": "string"
                },
                "published_date": {
                  "description": "Publication date",
                  "type": "string"
                },
                "title": {
                  "description": "Article title",
                  "type": "string"
                },
                "url": {
                  "description": "URL of the article",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_top_stories": {
