                },
                "byline": {
                  "description": "Author byline",
                  "type": "string"
                },
                "published_date": {
                  "description": "Publication date",
                  "type": "string"
                },
                "title": {
                  "description": "Story title",
                  "type": "string"
                },
                "url": {
                  "description": "URL of the story",
