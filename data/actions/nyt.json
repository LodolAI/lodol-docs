    "search_articles": {
      "description": "Search New York Times articles by keyword, optionally within a date range.",
      "display_name": "Search articles",
      "display_str_template": "Search New York Times articles for '{0}'.",
      "handler": "actions.search_articles",
      "id": "nyt_search_articles",
      "method": "POST",
      "mock_response": {
        "articles": [
          {
            "abstract": "A look at urban adaptation efforts.",
            "byline": "By Jane Smith",
            "headline": "How Climate Change Is Reshaping Cities",
            "pub_date": "2026-01-15T10:00:00Z",
            "section_name": "Climate",
            "web_url": "https://www.nytimes.com/example.html"
          }
        ]
      },
      "name": "search_articles",
      "parameters": [
        {
          "description": "Keywords to search for.",
          "display_name": "Search query",
          "examples": [
            {
              "label": "Search query",
              "value": "climate change"
            }
          ],
          "name": "q",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only include articles published on or after this date (YYYYMMDD).",
          "display_name": "Begin date",
          "name": "begin_date",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only include articles published on or before this date (YYYYMMDD).",
          "display_name": "End date",
          "name": "end_date",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/nyt/search-articles",
      "result_str_template": "Searched New York Times articles.",
      "returns": {
        "properties": {
          "articles": {
            "description": "Matching articles",
            "items": {
              "properties": {
                "abstract": {
                  "description": "Short summary of the article",
                  "type": "string"
                },
                "byline": {
                  "description": "Author byline",
                  "type": "string"
                },
                "headline": {
                  "description": "Article headline",
                  "type": "string"
                },
                "pub_date": {
                  "description": "Publication timestamp",
                  "type": "string"
                },
                "section_name": {
                  "description": "Section the article appeared in",
                  "type": "string"
                },
                "web_url": {
                  "description": "URL of the article",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Search New York Times articles, get top stories and trending articles, and look up the current Best Sellers list.",
  "display_name": "New York Times",
  "id": "nyt"
}
