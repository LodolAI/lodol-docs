  "description": "Read your Adobe Lightroom cloud catalog, albums and photos through the Lightroom partner API.",
  "display_name": "Adobe Lightroom",
  "id": "adobe_lightroom",
  "logo": "https://www.lodol.com/app-icons/adobe-lightroom-icon.svg",
  "triggers": {
    "adobe_lightroom_album_updated_trigger": {
      "description": "Runs each time a lightroom album changes in Adobe Lightroom. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Lightroom album updated",
      "id": "adobe_lightroom_album_updated_trigger",
      "output": {
        "record": "object with the fields id, type, subtype, created, updated, payload.name, links"
      },
      "parameters": []
    },
    "adobe_lightroom_new_album_trigger": {
      "description": "Runs for each new Lightroom album in Adobe Lightroom. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New Lightroom album",
      "id": "adobe_lightroom_new_album_trigger",
      "output": {
        "record": "object with the fields id, type, subtype, created, updated, payload.name, links"
      },
      "parameters": []
