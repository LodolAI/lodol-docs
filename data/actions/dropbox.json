{
  "actions": {
    "create_folder": {
      "description": "Create a new folder in Dropbox.",
      "display_name": "Create Dropbox folder",
      "display_str_template": "Create folder '{0}' in Dropbox.",
      "handler": "actions.create_folder",
      "id": "dropbox_create_folder",
      "method": "POST",
      "mock_response": {
        "path": "/Documents/NewFolder",
        "status": "success"
      },
      "name": "create_folder",
      "output_formatter": "actions.format_create_folder_output",
      "parameters": [
        {
          "description": "The path for the new folder (e.g., /Documents/NewFolder).",
          "display_name": "Folder path",
          "name": "folder_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Automatically rename if a folder with the same name exists.",
          "display_name": "Rename automatically",
          "name": "autorename",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/dropbox/create-folder",
      "result_str_template": "Folder created at '{path}'.",
      "returns": {
        "description": "Response envelope; the payload is in the \"path\" field.",
        "properties": {
          "path": {
            "description": "The display path of the created folder.",
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_path": {
      "description": "Delete a file or folder from Dropbox.",
      "display_name": "Delete Dropbox file or folder",
      "display_str_template": "Delete '{0}' from Dropbox.",
      "handler": "actions.delete_path",
      "id": "dropbox_delete_path",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "status": "success"
      },
      "name": "delete_path",
      "output_formatter": "actions.format_delete_path_output",
      "parameters": [
        {
          "description": "The path of the file or folder to delete, for example /folder/file.txt.",
          "display_name": "File or folder path",
          "name": "target_path",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/dropbox/delete-path",
      "result_str_template": "File or folder deleted.",
      "returns": {
        "description": "Response envelope; the payload is in the \"deleted\" field.",
        "properties": {
          "deleted": {
            "description": "True if the deletion was successful.",
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "download_file": {
      "description": "Download a file from Dropbox and save it to a location you choose.",
      "display_name": "Download file from Dropbox",
      "display_str_template": "Download '{0}' from Dropbox.",
      "handler": "actions.download_file",
      "id": "dropbox_download_file",
      "method": "POST",
      "mock_response": {
        "path": "/tmp/downloaded_file.txt",
        "status": "success"
      },
      "name": "download_file",
      "output_formatter": "actions.format_download_file_output",
      "parameters": [
        {
          "description": "The Dropbox path of the file to download.",
          "display_name": "Dropbox path",
          "name": "dropbox_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Where to save the downloaded file. If left blank, a temporary folder is used.",
          "display_name": "Destination path",
          "name": "destination_path",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/dropbox/download-file",
      "result_str_template": "File downloaded to '{path}'.",
      "returns": {
        "description": "Response envelope; the payload is in the \"path\" field.",
        "properties": {
          "path": {
            "description": "The local path where the file was saved.",
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_folder": {
      "description": "List the contents of a Dropbox folder.",
      "display_name": "List Dropbox folder contents",
      "display_str_template": "List contents of '{0}' in Dropbox.",
      "handler": "actions.list_folder",
      "id": "dropbox_list_folder",
      "method": "POST",
      "mock_response": {
        "entries": [
          "/Documents/file1.txt",
          "/Documents/file2.pdf",
          "/Documents/Subfolder"
        ],
        "status": "success"
      },
      "name": "list_folder",
      "output_formatter": "actions.format_list_folder_output",
      "parameters": [
        {
          "description": "The Dropbox folder to list. Leave blank for the top level of your Dropbox.",
          "display_name": "Folder path",
          "name": "folder_path",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Set to true to also include files inside subfolders.",
          "display_name": "Include subfolders",
          "name": "recursive",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Maximum number of items to return (default 200).",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/dropbox/list-folder",
      "result_str_template": "Found {entries,length} items.",
      "returns": {
        "description": "Response envelope; the payload is in the \"entries\" field.",
        "properties": {
          "entries": {
            "description": "List of file and folder paths in the directory.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "upload_file": {
      "description": "Upload a file to Dropbox at the location you choose.",
      "display_name": "Upload file to Dropbox",
      "display_str_template": "Upload '{0}' to Dropbox at '{1}'.",
      "handler": "actions.upload_file",
      "id": "dropbox_upload_file",
      "method": "POST",
      "mock_response": {
        "path": "/Documents/uploaded_file.txt",
        "status": "success"
      },
      "name": "upload_file",
      "output_formatter": "actions.format_upload_file_output",
      "parameters": [
        {
          "description": "The file to upload to Dropbox.",
          "display_name": "File to upload",
          "name": "file_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The destination path in Dropbox (e.g., /folder/file.txt).",
          "display_name": "Dropbox path",
          "name": "dropbox_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Automatically rename the file if one with the same name already exists.",
          "display_name": "Rename automatically",
          "name": "autorename",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/dropbox/upload-file",
      "result_str_template": "File uploaded to '{path}'.",
      "returns": {
        "description": "Response envelope; the payload is in the \"path\" field.",
        "properties": {
          "path": {
            "description": "The display path of the uploaded file in Dropbox.",
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Upload, download, and organize content in Dropbox.",
  "display_name": "Dropbox",
  "id": "dropbox"
}
