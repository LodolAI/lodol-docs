          "dynamic_source_allows_custom": true,
          "name": "ad_account_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A name for finding the form in Ads Manager. People don't see it.",
          "display_name": "Form name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The headline at the top of the form, up to 25 characters.",
          "display_name": "Headline",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What people get for signing up, up to 180 characters.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": [
            "EMAIL",
            "PHONE_NUMBER"
          ],
          "description": "What else to ask. First and last name are always asked. Pick the email address, the phone number, or both. You can't pick both the street address and the postal code.",
          "display_name": "Ask for",
          "multi_select": true,
          "name": "questions",
          "options": [
            {
              "label": "Email address",
              "value": "EMAIL"
            },
            {
              "label": "Phone number",
              "value": "PHONE_NUMBER"
            },
            {
              "label": "Street address",
              "value": "ADDRESS"
            },
            {
              "label": "Postal code",
              "value": "POSTAL_CODE"
            },
            {
              "label": "Birthday",
              "value": "BIRTHDAY_DATE"
            },
            {
              "label": "Job title",
              "value": "JOB_TITLE"
            },
            {
              "label": "Company name",
              "value": "COMPANY_NAME"
            }
          ],
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Your own questions with a typed answer, one per row, up to 8. Answers come back as custom_field_1, custom_field_2 and so on.",
          "display_name": "Extra questions",
          "item_by_item": true,
          "name": "extra_questions",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "A link to your privacy policy, starting with https://. Shown on the confirmation screen.",
          "display_name": "Privacy policy link",
          "name": "privacy_policy_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Text for up to 2 checkboxes people tick before sending, one per row, such as agreeing to be contacted.",
          "display_name": "Consent checkboxes",
          "item_by_item": true,
          "name": "consents",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "default": true,
          "description": "Whether people have to tick the checkboxes to send the form. On by default.",
          "display_name": "Checkboxes must be ticked",
          "name": "consents_required",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": "VIEW_WEBSITE",
          "description": "The button shown after sending. Used when you give a link below.",
          "display_name": "Button on the confirmation screen",
          "name": "end_page_action",
          "options": [
            {
              "label": "View website (default)",
              "value": "VIEW_WEBSITE"
            },
            {
              "label": "Learn more",
              "value": "LEARN_MORE"
            },
            {
              "label": "Book now",
              "value": "BOOK_NOW"
            },
            {
              "label": "Apply now",
              "value": "APPLY_NOW"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Where the button goes, starting with https://. Leave empty for no button.",
          "display_name": "Confirmation screen link",
          "name": "end_page_url",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/snapchat-lead-generation/create-lead-form",
