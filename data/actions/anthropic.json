{
  "actions": {
    "generate_model_response": {
      "description": "Send a prompt to Claude and get back its written response.",
      "display_name": "Generate a Claude response",
      "display_str_template": "Generate a Claude response.",
      "handler": "actions.generate_model_response",
      "id": "anthropic_generate_model_response",
      "method": "POST",
      "mock_response": {
        "model": "claude-opus-4-8",
        "response_text": "Here is a thoughtful response to your question about artificial intelligence and its applications in modern software development.",
        "status": "success"
      },
      "name": "generate_model_response",
      "output_formatter": "actions.format_generate_model_response_output",
      "parameters": [
        {
          "description": "The message or question to send to Claude.",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "claude-opus-4-8",
          "description": "Which Claude model to use. Defaults to claude-opus-4-8.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Claude Opus 4.8 (recommended)",
              "value": "claude-opus-4-8"
            },
            {
              "label": "Claude Fable 5 (most capable, expensive)",
              "value": "claude-fable-5"
            },
            {
              "label": "Claude Sonnet 5",
              "value": "claude-sonnet-5"
            },
            {
              "label": "Claude Haiku 4.5 (fastest, lowest cost)",
              "value": "claude-haiku-4-5"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 4096,
          "description": "Maximum number of tokens Claude may generate in its response. Raise it for longer replies. Leave blank to use the default (4096).",
          "display_name": "Maximum response length",
          "name": "max_tokens",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/anthropic/generate-model-response",
      "result_str_template": "Anthropic response: {anthropic_generate_model_response,response_text}",
      "returns": {
        "properties": {
          "model": {
            "type": "string"
          },
          "response_text": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect Claude, Anthropic's AI assistant, to answer questions, write text, and generate content in your workflows.",
  "display_name": "Anthropic",
  "id": "anthropic"
}
