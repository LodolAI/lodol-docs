{
  "actions": {
    "analyze_document": {
      "description": "Ask Claude a question about a PDF or text document, such as a contract, report or invoice, and get its answer.",
      "display_name": "Analyze a document",
      "display_str_template": "Ask Claude about a document: '{question}'.",
      "handler": "actions.analyze_document",
      "id": "anthropic_analyze_document",
      "method": "POST",
      "mock_response": {
        "model": "claude-opus-5-5",
        "response_text": "The contract has two deadlines: the first payment is due on 1 March and the work must be finished by 30 June."
      },
      "name": "analyze_document",
      "output_formatter": "actions.format_analysis_output",
      "parameters": [
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "description": "The document to read: upload a file, pick one an earlier step produced, paste a link to one, or give the ID of a file uploaded to Claude with 'Upload a file'. PDFs (up to 24 MB and 600 pages) and plain text files work.",
          "display_name": "Document",
          "name": "document",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What you want to know about the document, or what to do with it, such as 'List every deadline in this contract'.",
          "display_name": "Question",
          "multiline": true,
          "name": "question",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "claude-opus-5-5",
          "description": "Which Claude model to use. Defaults to claude-opus-5-5.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Claude Opus 5.5 (recommended)",
              "value": "claude-opus-5-5"
            },
            {
              "label": "Claude Fable 5.1 (most capable, expensive)",
              "value": "claude-fable-5-1"
            },
            {
              "label": "Claude Sonnet 5.5",
              "value": "claude-sonnet-5-5"
            },
            {
              "label": "Claude Haiku 5.5 (fastest, lowest cost)",
              "value": "claude-haiku-5-5"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 16000,
          "description": "Maximum number of tokens Claude may use for its thinking and its answer. Raise it if answers come back cut short. Leave blank to use the default (16000).",
          "display_name": "Maximum response length",
          "name": "max_tokens",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/anthropic/analyze-document",
      "result_str_template": "Claude's answer: {anthropic_analyze_document,response_text}",
      "returns": {
        "properties": {
          "model": {
            "description": "The Claude model that answered.",
            "type": "string"
          },
          "response_text": {
            "description": "Claude's answer.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
