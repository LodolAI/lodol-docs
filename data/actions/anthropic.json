    "generate_model_response": {
      "description": "Ask Claude to write, summarise or answer something, and get its reply.",
      "display_name": "Ask Claude",
      "display_str_template": "Ask Claude: '{0}'.",
      "handler": "actions.generate_model_response",
      "id": "anthropic_generate_model_response",
      "method": "POST",
      "mock_response": {
        "cache_read_tokens": 0,
        "cache_write_tokens": 0,
        "model": "claude-opus-4-8",
        "response_text": "Here is a thoughtful response to your question about artificial intelligence and its applications in modern software development.",
        "status": "success",
        "thinking": ""
      },
      "name": "generate_model_response",
      "output_formatter": "actions.format_generate_model_response_output",
      "parameters": [
        {
          "description": "The message or question to send to Claude.",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Standing instructions Claude follows for every answer, such as its role, tone, rules or background it should know. Keep what changes from run to run in the message: long instructions that stay the same are cached, so runs within a few minutes of each other cost less.",
          "display_name": "Instructions",
          "multiline": true,
          "name": "system_prompt",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "claude-opus-4-8",
          "description": "Which Claude model to use. Defaults to claude-opus-4-8.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Claude Opus 4.8 (recommended)",
              "value": "claude-opus-4-8"
            },
            {
              "label": "Claude Fable 5 (most capable, expensive)",
              "value": "claude-fable-5"
            },
            {
              "label": "Claude Sonnet 5",
              "value": "claude-sonnet-5"
            },
            {
              "label": "Claude Haiku 4.5 (fastest, lowest cost)",
              "value": "claude-haiku-4-5"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 4096,
          "description": "Maximum number of tokens Claude may generate in its response. Raise it for longer replies. Leave blank to use the default (4096).",
          "display_name": "Maximum response length",
          "name": "max_tokens",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": "default",
          "description": "How hard Claude thinks before it answers. More thinking gives better answers to hard questions, but takes longer and uses more API credits. Thinking counts towards the maximum response length, so raise that if answers come back cut short. A summary of what Claude thought comes back with the answer.",
          "display_name": "Think before answering",
          "name": "thinking",
          "options": [
            {
              "label": "Leave it to the model",
              "value": "default"
            },
            {
              "label": "A little",
              "value": "low"
            },
            {
              "label": "Some",
              "value": "medium"
            },
            {
              "label": "A lot",
              "value": "high"
            },
            {
              "label": "As much as it needs (slowest, most expensive)",
              "value": "max"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/anthropic/generate-model-response",
      "result_str_template": "Anthropic response: {anthropic_generate_model_response,response_text}",
      "returns": {
        "properties": {
          "cache_read_tokens": {
            "description": "Tokens of the instructions read from the cache, at a tenth of the usual price.",
            "type": "integer"
          },
          "cache_write_tokens": {
            "description": "Tokens of the instructions written to the cache for the next runs.",
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "response_text": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "thinking": {
            "description": "A summary of what Claude thought before answering; empty when it didn't think or the model doesn't share it.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
