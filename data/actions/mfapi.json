          ],
          "name": "fund",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The day the money went in. If the market was closed that day, the next day's NAV is used, as it would be for a real order.",
          "display_name": "Invested on",
          "examples": [
            {
              "label": "A date",
              "value": "2021-01-05"
            }
          ],
          "name": "start_date",
          "required": true,
          "type": "ParameterType.DATE"
        },
        {
          "description": "The day to value the investment. Leave empty for the latest NAV. If the market was closed that day, the last NAV before it is used.",
          "display_name": "Value on",
          "name": "end_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Rupees invested. Leave empty to get just the return in percent.",
          "display_name": "Amount invested (\u20b9)",
          "examples": [
            {
              "label": "\u20b910,000",
              "value": "10000"
            }
