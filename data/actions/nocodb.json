          "dynamic_source_depends_on": [
            "base_id"
          ],
          "name": "table_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The field that identifies the record, such as Email or Order number. Its values should be unique.",
          "display_name": "Match on",
