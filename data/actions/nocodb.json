            },
            {
              "label": "contains",
              "value": "contains"
            },
            {
              "label": "does not contain",
              "value": "not_contains"
            },
            {
              "label": "is greater than / after",
              "value": "greater"
            },
            {
              "label": "is less than / before",
              "value": "less"
            },
            {
              "label": "is at least / on or after",
              "value": "at_least"
            },
            {
              "label": "is at most / on or before",
              "value": "at_most"
            },
            {
              "label": "is empty",
              "value": "empty"
            },
            {
              "label": "is not empty",
              "value": "not_empty"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to compare the field with. Dates go in as 2026-03-01, checkboxes as yes or no, and several choices separated by commas. Not needed for 'is empty'.",
          "display_name": "Value",
          "name": "value",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The field to put the records in order by.",
          "display_name": "Sort by",
          "dynamic_source": "fields",
          "dynamic_source_depends_on": [
