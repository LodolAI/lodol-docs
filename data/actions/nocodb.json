{
  "actions": {
    "add_field": {
      "description": "Add a field of any common type to a table. On NocoDB Cloud this needs a token whose Fields permission is 'Read & write'.",
      "display_name": "Add a field",
      "display_str_template": "Add the field '{2}' to NocoDB table {1}.",
      "handler": "actions.add_field",
      "id": "nocodb_add_field",
      "method": "POST",
      "mock_response": {
        "id": "c9",
        "title": "Renewal date",
        "type": "Date"
      },
      "name": "add_field",
      "output_formatter": "actions.format_add_field_output",
      "parameters": [
        {
          "description": "The NocoDB base to work in.",
          "display_name": "Base",
          "dynamic_source": "bases",
          "name": "base_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table to work in.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_depends_on": [
            "base_id"
          ],
          "name": "table_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to call the field, such as Renewal date.",
          "display_name": "Field name",
          "name": "field_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "text",
          "description": "What the field holds.",
          "display_name": "Type",
          "name": "field_type",
          "options": [
            {
              "label": "Text",
              "value": "text"
            },
            {
              "label": "Long text",
              "value": "long_text"
            },
            {
              "label": "Whole number",
              "value": "number"
            },
            {
              "label": "Decimal",
              "value": "decimal"
            },
            {
              "label": "Currency",
              "value": "currency"
            },
            {
              "label": "Percent",
              "value": "percent"
            },
            {
              "label": "Rating",
              "value": "rating"
            },
            {
              "label": "Checkbox",
              "value": "checkbox"
            },
            {
              "label": "Date",
              "value": "date"
            },
            {
              "label": "Date & time",
              "value": "datetime"
            },
            {
              "label": "Time",
              "value": "time"
            },
            {
              "label": "Duration",
              "value": "duration"
            },
            {
              "label": "Single select",
              "value": "single_select"
            },
            {
              "label": "Multi select",
              "value": "multi_select"
            },
            {
              "label": "Email",
              "value": "email"
            },
            {
              "label": "URL",
              "value": "url"
            },
            {
              "label": "Phone number",
              "value": "phone"
            },
            {
              "label": "Attachment",
              "value": "attachment"
            },
            {
              "label": "JSON",
              "value": "json"
            },
            {
              "label": "User",
              "value": "user"
            },
            {
              "label": "Links to another table",
              "value": "links"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The options to choose from, for a select field.",
          "display_name": "Choices",
          "name": "choices",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The table to link to, for a Links field.",
          "display_name": "Linked table",
          "dynamic_source": "tables",
          "dynamic_source_depends_on": [
            "base_id"
          ],
          "name": "linked_table_id",
          "required": false,
          "type": "ParameterType.STRING"
