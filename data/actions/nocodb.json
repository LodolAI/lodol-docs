            "description": "The record's values, by field name. Checkboxes read true or false, dates 2026-03-01, date-times in ISO 8601, links as the linked records, and attachments as files with a url.",
            "type": "object"
          },
          "id": {
            "description": "The record's ID, which the other record actions take.",
            "type": "integer"
          }
        },
        "type": "object"
      }
