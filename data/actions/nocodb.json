    "attach_file": {
      "description": "Add a file to a record's Attachment field, alongside any files already there. Files up to 7 MB.",
      "display_name": "Attach a file to a record",
      "display_str_template": "Attach a file to record {2} in NocoDB table {1}.",
      "handler": "actions.attach_file",
      "id": "nocodb_attach_file",
      "method": "POST",
