        "attachment": {
          "mimetype": "application/pdf",
          "size": 48213,
          "title": "contract.pdf",
          "url": "https://app.nocodb.com/dltemp/abc/contract.pdf"
        },
        "attachments": [
          {
            "mimetype": "application/pdf",
            "size": 48213,
            "title": "contract.pdf",
            "url": "https://app.nocodb.com/dltemp/abc/contract.pdf"
          }
        ],
        "field": "Contract",
        "id": 12
      },
      "name": "attach_file",
      "output_formatter": "actions.format_attach_file_output",
      "parameters": [
        {
          "description": "The NocoDB base to work in.",
          "display_name": "Base",
          "dynamic_source": "bases",
          "name": "base_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table to work in.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_depends_on": [
            "base_id"
          ],
          "name": "table_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The record's ID. 'Find records' and 'Create a record' return it as 'id'.",
          "display_name": "Record ID",
          "name": "record_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The field to add the file to.",
          "display_name": "Attachment field",
          "dynamic_source": "attachment_fields",
          "dynamic_source_depends_on": [
            "base_id",
            "table_id"
          ],
          "name": "attachment_field",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "autofill_name_param": "file_name",
          "description": "Upload a file, pick one from an earlier step, or paste a link to one.",
          "display_name": "File",
          "name": "file",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to call the file in NocoDB, such as invoice.pdf. Leave blank to keep its own name.",
          "display_name": "File name",
          "name": "file_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/nocodb/attach-file",
      "result_str_template": "Attached the file.",
      "returns": {
        "properties": {
          "attachment": {
            "description": "The file just added: its title, a url that opens it, its type and size.",
            "type": "object"
          },
          "attachments": {
            "description": "Every file the field holds now.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "field": {
            "description": "The Attachment field.",
            "type": "string"
          },
          "id": {
            "description": "The record the file was added to.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "create_or_update_record": {
