  "categories": [
    "Databases",
    "Monitoring"
  ],
  "description": "Write sensor readings and other data points to InfluxDB from workflows, read a field's latest or average value, run Flux queries, manage buckets and run tasks. Start a workflow when a value crosses a threshold, a task fails or a check changes status.",
  "display_name": "InfluxDB",
  "id": "influxdb",
  "logo": "https://www.lodol.com/app-icons/influxdb-icon.svg",
  "triggers": {
    "influxdb_check_status_changed_trigger": {
      "description": "Runs when one of InfluxDB's checks changes status for a series, such as from ok to crit, or only when it becomes the level you choose, with the check's message.",
      "display_name": "Check status changed",
      "id": "influxdb_check_status_changed_trigger",
      "output": {
        "check_id": "string",
        "check_name": "string",
        "level": "string",
        "message": "string",
        "previous_level": "string",
        "series": "string",
        "source_measurement": "string",
        "tags": "object",
        "time": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only this check, by name or ID. Leave blank for every check.",
          "display_name": "Check",
          "name": "check",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "Any change, or only when it becomes crit, warn, info or ok. Defaults to any change.",
          "display_name": "When it",
          "name": "level",
          "required": false
        }
      ]
    },
    "influxdb_task_run_failed_trigger": {
      "description": "Runs when a run of an InfluxDB task fails, with why it failed, for one task or every active one.",
      "display_name": "Task run failed",
      "id": "influxdb_task_run_failed_trigger",
      "output": {
        "error": "string",
        "finished_at": "string",
        "link": "string",
        "log": "array",
        "run_id": "string",
        "scheduled_for": "string",
        "started_at": "string",
        "status": "string",
        "task_id": "string",
        "task_name": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only this task, by name or ID. Leave blank for every active task (up to 50).",
          "display_name": "Task",
          "name": "task",
          "required": false
        }
      ]
    },
    "influxdb_value_crosses_threshold_trigger": {
      "description": "Runs when a field's value goes above (or below) a threshold, such as a room's temperature over 28, once per crossing for each series (each sensor or room). It runs again only after the value has come back.",
      "display_name": "Value crosses a threshold",
      "id": "influxdb_value_crosses_threshold_trigger",
      "output": {
        "aggregate": "string",
        "bucket": "string",
        "direction": "string",
        "field": "string",
        "measurement": "string",
        "series": "string",
        "tags": "object",
        "threshold": "number",
        "time": "string",
        "time_range": "string",
        "value": "number"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The bucket to watch.",
          "display_name": "Bucket",
          "name": "bucket",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "The measurement, such as environment.",
          "display_name": "Measurement",
          "name": "measurement",
          "required": true
        },
        {
          "arg_index": 2,
          "description": "The field to watch, such as temperature.",
          "display_name": "Field",
          "name": "field",
          "required": true
        },
        {
          "arg_index": 3,
          "description": "Goes above or goes below the threshold. Defaults to goes above.",
          "display_name": "When it",
          "name": "direction",
          "required": false
        },
        {
          "arg_index": 4,
          "description": "The number it crosses, such as 28.5.",
          "display_name": "Threshold",
          "name": "threshold",
          "required": true
        },
        {
          "arg_index": 5,
          "description": "Only series with these tag values, such as room=server room, sensor_id=th-03. Leave blank for every series.",
          "display_name": "Tag filters",
          "name": "filters",
          "required": false
        },
        {
          "arg_index": 6,
          "description": "Which value to compare: the latest (the default), or the average, highest or lowest over the time range.",
          "display_name": "Value",
          "name": "aggregate",
          "required": false
        },
        {
          "arg_index": 7,
          "description": "How far back each look reads, such as 5m or 1h. Defaults to 15m; a series with no points in it is skipped.",
          "display_name": "Over the last",
          "name": "time_range",
          "required": false
        }
      ]
    }
  }
