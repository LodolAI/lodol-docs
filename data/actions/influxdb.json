{
  "actions": {
    "create_bucket": {
      "description": "Create a bucket that keeps data for as long as you choose, such as for a new site or customer. One of that name already there is returned as it is.",
      "display_name": "Create bucket",
      "display_str_template": "Create InfluxDB bucket {0}.",
      "handler": "actions.create_bucket",
      "id": "influxdb_create_bucket",
      "method": "POST",
      "mock_response": {
        "created": true,
        "created_at": "2026-05-01T10:00:00Z",
        "description": "Room sensors",
        "id": "fbc3488665d01e58",
        "link": "https://us-east-1-1.aws.cloud2.influxdata.com/orgs/3a50d630fdda09d3/load-data/buckets/fbc3488665d01e58",
        "name": "sensors",
        "retention": "30 days",
        "retention_seconds": 2592000,
        "type": "user",
        "updated_at": "2026-05-01T10:00:00Z"
      },
      "name": "create_bucket",
      "output_formatter": "actions.format_bucket",
      "parameters": [
        {
          "description": "The bucket's name, such as site-amsterdam.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How long to keep each point, such as 30d, 12w or 1y (at least 1h). Leave blank to keep data forever.",
          "display_name": "Keep data for",
          "name": "retention",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What the bucket is for.",
          "display_name": "Description",
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/influxdb/create-bucket",
      "result_str_template": "Bucket {influxdb_create_bucket,name} is ready.",
      "returns": {
        "properties": {
          "created": {
            "description": "True if it was made now; false if a bucket of that name was there",
            "type": "boolean"
          },
          "created_at": {
            "description": "When it was made",
            "type": "string"
          },
          "description": {
            "description": "Its description",
            "type": "string"
          },
          "id": {
            "description": "The bucket's ID",
            "type": "string"
          },
          "link": {
            "description": "Where to open it in InfluxDB",
            "type": "string"
          },
          "name": {
            "description": "Its name",
            "type": "string"
          },
          "retention": {
            "description": "How long it keeps data, such as 30 days, or Forever",
            "type": "string"
          },
          "retention_seconds": {
            "description": "How long it keeps data, in seconds; 0 is forever",
            "type": "number"
          },
          "type": {
            "description": "user, or system for InfluxDB's own buckets",
            "type": "string"
          },
          "updated_at": {
            "description": "When it last changed",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_bucket": {
      "description": "Delete a bucket and every point in it. This can't be undone.",
      "display_name": "Delete bucket",
      "display_str_template": "Delete InfluxDB bucket {0}.",
      "handler": "actions.delete_bucket",
      "id": "influxdb_delete_bucket",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": "fbc3488665d01e58",
        "name": "sensors-old"
      },
      "name": "delete_bucket",
      "output_formatter": "actions.format_deleted_bucket",
      "parameters": [
        {
          "description": "The bucket to delete: its name or ID.",
          "display_name": "Bucket",
          "dynamic_source": "buckets",
          "dynamic_source_allows_custom": true,
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/influxdb/delete-bucket",
      "result_str_template": "Bucket {influxdb_delete_bucket,name} deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True once it's gone",
