          },
          "name": {
            "description": "Its name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "delete_data": {
      "description": "Delete a measurement's points in a time range, such as a faulty sensor's readings, optionally only those with some tag values. This can't be undone.",
      "display_name": "Delete data",
      "display_str_template": "Delete {1} points from InfluxDB bucket {0}.",
      "handler": "actions.delete_data",
      "id": "influxdb_delete_data",
      "method": "POST",
      "mock_response": {
        "bucket": "sensors",
        "measurement": "environment",
        "predicate": "_measurement=\"environment\" AND \"sensor_id\"=\"th-09\"",
        "start": "2026-05-01T00:00:00Z",
        "stop": "2026-05-02T00:00:00Z"
      },
      "name": "delete_data",
      "output_formatter": "actions.format_deleted_data",
      "parameters": [
        {
          "description": "The bucket to delete from.",
          "display_name": "Bucket",
          "dynamic_source": "buckets",
          "dynamic_source_allows_custom": true,
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The measurement whose points to delete.",
          "display_name": "Measurement",
          "dynamic_source": "measurements",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "bucket"
          ],
          "name": "measurement",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Delete points from this time on.",
          "display_name": "From",
          "name": "start",
          "required": true,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Delete points up to this time. Leave blank for now.",
          "display_name": "Until",
          "name": "stop",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Only points with these tag values, such as sensor_id th-09. Leave blank for all of the measurement's points.",
          "display_name": "Tag filters",
          "dynamic_source": "tag_keys",
          "dynamic_source_depends_on": [
            "bucket",
            "measurement"
          ],
          "name": "filters",
          "object_key_name": "Tag",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/influxdb/delete-data",
      "result_str_template": "Deleted {influxdb_delete_data,measurement} points.",
      "returns": {
        "properties": {
          "bucket": {
            "description": "The bucket",
            "type": "string"
          },
          "measurement": {
            "description": "The measurement whose points were deleted",
            "type": "string"
          },
          "predicate": {
            "description": "Which points, as InfluxDB was asked",
            "type": "string"
          },
          "start": {
            "description": "From when, in UTC",
            "type": "string"
          },
          "stop": {
            "description": "Until when, in UTC",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "get_field_value": {
      "description": "Read a field's latest, average, highest, lowest or total value over the last hour, day or week, such as a room's temperature, without writing a query. Narrow it by tags.",
      "display_name": "Get field value",
      "display_str_template": "Get {2} of {1} from InfluxDB.",
      "handler": "actions.get_field_value",
      "id": "influxdb_get_field_value",
      "method": "POST",
      "mock_response": {
        "aggregate": "last",
        "bucket": "sensors",
        "field": "temperature",
        "found": true,
        "measurement": "environment",
        "series": [
          {
            "series": "room=kitchen,sensor_id=th-01",
            "tags": {
              "room": "kitchen",
              "sensor_id": "th-01"
            },
            "time": "2026-05-04T09:25:00Z",
            "value": 21.5
          },
          {
            "series": "room=server room,sensor_id=th-03",
            "tags": {
              "room": "server room",
              "sensor_id": "th-03"
            },
            "time": "2026-05-04T09:29:00Z",
            "value": 24.1
          }
        ],
        "series_count": 2,
        "time": "2026-05-04T09:29:00Z",
        "time_range": "1h",
        "value": 24.1
      },
      "name": "get_field_value",
      "output_formatter": "actions.format_value",
      "parameters": [
        {
          "description": "The bucket to read.",
          "display_name": "Bucket",
          "dynamic_source": "buckets",
          "dynamic_source_allows_custom": true,
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The measurement, such as environment.",
          "display_name": "Measurement",
          "dynamic_source": "measurements",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "bucket"
          ],
          "name": "measurement",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The field, such as temperature.",
          "display_name": "Field",
          "dynamic_source": "fields",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "bucket",
            "measurement"
          ],
          "name": "field",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only points with these tag values, such as room kitchen. Leave blank for every series.",
          "display_name": "Tag filters",
          "dynamic_source": "tag_keys",
          "dynamic_source_depends_on": [
            "bucket",
            "measurement"
          ],
          "name": "filters",
          "object_key_name": "Tag",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "default": "1h",
          "description": "How far back to look, such as 15m, 1h, 24h or 7d. Defaults to 1h.",
          "display_name": "Over the last",
          "name": "time_range",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "last",
          "description": "Which value: the latest, or the points combined.",
          "display_name": "Value",
          "name": "aggregate",
          "options": [
            {
              "label": "Latest value",
              "value": "last"
            },
            {
              "label": "Earliest value",
              "value": "first"
            },
            {
              "label": "Average",
              "value": "mean"
            },
            {
              "label": "Lowest",
              "value": "min"
            },
            {
              "label": "Highest",
              "value": "max"
            },
            {
              "label": "Total",
              "value": "sum"
            },
            {
              "label": "Number of points",
              "value": "count"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/influxdb/get-field-value",
      "result_str_template": "{influxdb_get_field_value,field} is {influxdb_get_field_value,value}.",
      "returns": {
        "properties": {
          "aggregate": {
            "description": "How the points were combined: last, first, mean, min, max, sum or count",
            "type": "string"
          },
          "bucket": {
            "description": "The bucket read",
            "type": "string"
          },
          "field": {
            "description": "The field read",
            "type": "string"
          },
          "found": {
            "description": "Whether there were any points in the time range",
            "type": "boolean"
          },
          "measurement": {
            "description": "The measurement read",
            "type": "string"
          },
          "series": {
            "description": "The value for each series (each set of tags) on its own",
            "items": {
              "properties": {
                "series": {
                  "description": "The series' tags, such as room=kitchen,sensor_id=th-01",
                  "type": "string"
                },
                "tags": {
                  "description": "The series' tags, by name",
                  "type": "object"
                },
                "time": {
                  "description": "When that value was recorded (latest and earliest only)",
                  "type": "string"
                },
                "value": {
                  "description": "The value for this series",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "series_count": {
            "description": "How many series matched",
            "type": "number"
          },
          "time": {
            "description": "When that value was recorded (latest and earliest only)",
            "type": "string"
          },
          "time_range": {
            "description": "How far back it looked, such as 1h",
            "type": "string"
          },
          "value": {
            "description": "The value: the latest, average, highest and so on, over every series matched together. Empty when there were no points.",
            "nullable": true,
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
