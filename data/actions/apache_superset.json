{
  "actions": {
    "download_chart_csv": {
      "description": "Save a chart's data as a CSV file in Lodol, as Superset's Export to .CSV makes it, to attach to an email or upload.",
      "display_name": "Download chart as CSV",
      "display_str_template": "Download Superset chart {0} as CSV.",
      "handler": "actions.download_chart_csv",
      "id": "apache_superset_download_chart_csv",
      "method": "POST",
      "mock_response": {
        "chart_id": 1,
        "chart_name": "Orders by region",
        "content_type": "text/csv",
        "csv": "region,COUNT(*),Revenue\nSouth,30,3280.00\nEast,30,3250.00\nWest,30,3030.00\nNorth,30,3000.00\n",
        "document_ref": "doc_7f3a9c2e1b",
        "filename": "Orders-by-region.csv",
        "link": "https://superset.example.com/explore/?slice_id=1",
        "row_count": 4,
        "size_bytes": 87
      },
      "name": "download_chart_csv",
      "output_formatter": "actions.format_csv",
      "parameters": [
        {
          "description": "The chart. Pick one, or give its number, link or name.",
          "display_name": "Chart",
          "dynamic_source": "charts",
          "dynamic_source_allows_custom": true,
          "name": "chart",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Read the database now rather than use the results Superset has kept from the chart's last run.",
          "display_name": "Skip the cache",
          "name": "fresh",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/apache-superset/download-chart-csv",
      "result_str_template": "CSV saved.",
      "returns": {
        "properties": {
          "chart_id": {
            "description": "The chart's number",
            "type": "number"
          },
          "chart_name": {
            "description": "Its name",
            "type": "string"
          },
          "content_type": {
            "description": "text/csv, or application/zip for a chart of several queries",
            "type": "string"
          },
          "csv": {
            "description": "The CSV's text, up to its first 200,000 characters",
            "type": "string"
          },
          "document_ref": {
            "description": "The CSV file, for a later step that takes one, such as an email's attachments or a drive upload",
            "type": "string"
          },
          "filename": {
            "description": "The file's name, such as Orders-by-region.csv",
            "type": "string"
          },
          "link": {
            "description": "A link to the chart in Superset",
            "type": "string"
          },
          "row_count": {
            "description": "How many rows the CSV has",
            "type": "number"
          },
          "size_bytes": {
            "description": "The file's size in bytes",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write"
      ]
    },
