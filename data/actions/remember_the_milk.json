      "id": "remember_the_milk_new_list_trigger",
      "output": {
        "record": "object with the fields id, name, archived, smart"
      },
      "parameters": []
    },
    "remember_the_milk_new_or_updated_list_trigger": {
      "description": "Runs for each list added or changed in Remember the Milk. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated list",
      "id": "remember_the_milk_new_or_updated_list_trigger",
      "output": {
        "record": "object with the fields id, name, archived, smart"
