      "result_str_template": "Unsplash photos retrieved.",
      "returns": {
        "properties": {
          "photos": {
            "description": "Photos on the requested page",
            "items": {
              "properties": {
                "color": {
                  "description": "Dominant color as a hex code, for example '#2c5f2d'",
