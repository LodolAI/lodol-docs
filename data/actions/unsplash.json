            "width": 4000
          }
        ],
        "total": 1284
      },
      "name": "search_photos",
      "parameters": [
        {
          "description": "What to search for, for example 'misty forest'.",
          "display_name": "Search terms",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "How many photos to return (1-30).",
          "display_name": "Results per page",
          "maximum": 30,
          "minimum": 1,
          "name": "per_page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 1,
          "description": "Which page of results to return, starting at 1.",
          "display_name": "Page",
          "minimum": 1,
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional. Only return photos in this shape.",
          "display_name": "Orientation",
          "name": "orientation",
          "options": [
            {
              "label": "Landscape",
              "value": "landscape"
            },
            {
              "label": "Portrait",
              "value": "portrait"
            },
            {
              "label": "Squarish",
              "value": "squarish"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
