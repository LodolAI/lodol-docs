{
  "actions": {
    "get_photo": {
      "description": "Fetch details for a single Unsplash photo.",
      "display_name": "Get photo",
      "display_str_template": "Get Unsplash photo '{0}'.",
      "handler": "actions.get_photo",
      "id": "unsplash_get_photo",
      "method": "POST",
      "mock_response": {
        "color": "#2c5f2d",
        "description": "A misty forest at dawn",
        "height": 2667,
        "id": "Dwu85P9SOIk",
        "page_url": "https://unsplash.com/photos/Dwu85P9SOIk",
        "photographer_name": "Jane Doe",
        "photographer_url": "https://unsplash.com/@janedoe",
        "thumbnail_url": "https://images.unsplash.com/photo-1417325384643?w=200",
        "url": "https://images.unsplash.com/photo-1417325384643?w=1080",
        "width": 4000
      },
      "name": "get_photo",
      "parameters": [
        {
          "description": "The Unsplash photo ID, as returned by Search photos.",
          "display_name": "Photo ID",
          "name": "photo_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/unsplash/get-photo",
      "result_str_template": "Unsplash photo retrieved.",
      "returns": {
        "properties": {
          "color": {
            "description": "Dominant color as a hex code, for example '#2c5f2d'",
            "type": "string"
          },
          "description": {
            "description": "Photo caption, falling back to its alt text",
            "type": "string"
          },
          "height": {
            "description": "Image height in pixels",
            "type": "number"
          },
          "id": {
            "description": "Unsplash photo ID",
            "type": "string"
          },
          "page_url": {
            "description": "Unsplash page for the photo, for use when crediting it",
            "type": "string"
          },
          "photographer_name": {
            "description": "Photographer's name -- Unsplash's licence requires crediting them",
            "type": "string"
          },
          "photographer_url": {
            "description": "Photographer's Unsplash profile URL, for the credit link",
            "type": "string"
          },
          "thumbnail_url": {
            "description": "Small preview image URL",
            "type": "string"
          },
          "url": {
            "description": "Full-size image URL",
            "type": "string"
          },
          "width": {
            "description": "Image width in pixels",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
