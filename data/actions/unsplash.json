    "search_photos": {
      "description": "Search Unsplash's free stock photo library.",
      "display_name": "Search photos",
      "display_str_template": "Search Unsplash photos for '{0}'.",
      "handler": "actions.search_photos",
      "id": "unsplash_search_photos",
      "method": "POST",
      "mock_response": {
        "photos": [
          {
            "color": "#2c5f2d",
            "description": "A misty forest at dawn",
            "height": 2667,
            "id": "Dwu85P9SOIk",
            "page_url": "https://unsplash.com/photos/Dwu85P9SOIk",
            "photographer_name": "Jane Doe",
            "photographer_url": "https://unsplash.com/@janedoe",
            "thumbnail_url": "https://images.unsplash.com/photo-1417325384643?w=200",
