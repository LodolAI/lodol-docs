{
  "actions": {
    "chat": {
      "description": "Send a message to a model and get its answer, with an optional system prompt and earlier turns of the conversation.",
      "display_name": "Chat with a model",
      "display_str_template": "Ask the Ollama model '{0}'.",
      "handler": "actions.chat",
      "id": "ollama_chat",
      "method": "POST",
      "mock_response": {
        "done_reason": "stop",
        "duration_seconds": 1.42,
        "model": "llama3.2",
        "prompt_tokens": 26,
        "response_tokens": 14,
        "text": "The sky looks blue because air scatters blue light more.",
        "thinking": ""
      },
      "name": "chat",
      "output_formatter": "actions.format_generation",
      "parameters": [
        {
          "description": "The model to answer, as the server names it, such as llama3.2 or qwen3:8b. It must be downloaded on the server.",
          "display_name": "Model",
          "dynamic_source": "chat_models",
          "dynamic_source_allows_custom": true,
          "examples": [
            {
              "label": "Llama 3.2 (Meta, 3B)",
              "value": "llama3.2"
            },
            {
              "label": "Qwen 3 (Alibaba, thinks before answering)",
              "value": "qwen3"
            },
            {
              "label": "Gemma 3 (Google)",
              "value": "gemma3"
            },
            {
              "label": "Mistral (7B)",
              "value": "mistral"
            },
            {
              "label": "gpt-oss 20B (OpenAI, open weights)",
              "value": "gpt-oss:20b"
            },
            {
              "label": "DeepSeek-R1 (reasoning)",
              "value": "deepseek-r1"
            }
          ],
          "name": "model",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to ask or tell the model.",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Instructions the model follows for the whole answer, such as its role or the format to answer in.",
          "display_name": "System prompt",
          "multiline": true,
          "name": "system",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Earlier turns of the conversation, oldest first, each like {\"role\": \"user\", \"content\": \"Hi\"}. Roles are user, assistant and system.",
          "display_name": "Earlier messages",
          "name": "messages",
          "required": false,
          "schema": {
            "items": {
              "properties": {
                "content": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "How varied the answer is, from 0 (the same answer every time) to 2. Leave empty for the model's own setting.",
          "display_name": "Temperature",
          "maximum": 2.0,
          "minimum": 0,
          "name": "temperature",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Stop the answer after this many tokens (about three quarters of a word each). Leave empty to let the model finish.",
          "display_name": "Max tokens",
          "maximum": 131072,
          "minimum": 1,
          "name": "max_tokens",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Make the answer a JSON object a later step can read. Say in the prompt which fields you want.",
          "display_name": "JSON output",
          "name": "json_output",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "For thinking models such as qwen3 and deepseek-r1: true to reason before answering, false to answer straight away. Other models refuse true. Leave empty for the model's own setting.",
          "display_name": "Think",
          "name": "think",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/ollama/chat",
      "result_str_template": "The Ollama model answered.",
      "returns": {
        "properties": {
          "done_reason": {
            "description": "Why the model stopped: stop when it finished, length when it hit the maximum tokens.",
            "type": "string"
          },
          "duration_seconds": {
            "description": "How long the server took, loading the model included.",
            "type": "number"
          },
          "model": {
            "description": "The model that answered.",
            "type": "string"
          },
          "prompt_tokens": {
            "description": "How many tokens the prompt took.",
            "type": "integer"
          },
          "response_tokens": {
            "description": "How many tokens the answer took.",
            "type": "integer"
          },
          "text": {
            "description": "The model's answer.",
            "type": "string"
          },
          "thinking": {
            "description": "The model's reasoning before it answered, from a thinking model; empty for other models.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "create_embeddings": {
      "description": "Turn text into embeddings: lists of numbers that place similar meanings close together, for search and matching. Takes one text or up to 100.",
      "display_name": "Create embeddings",
      "display_str_template": "Create embeddings with the Ollama model '{0}'.",
      "handler": "actions.create_embeddings",
      "id": "ollama_create_embeddings",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "dimensions": 3,
        "embeddings": [
          [
            0.010071029,
            -0.0017594862,
            0.05007221
          ]
        ],
        "model": "nomic-embed-text"
      },
      "name": "create_embeddings",
      "output_formatter": "actions.format_create_embeddings",
      "parameters": [
        {
          "description": "An embedding model on the server, such as nomic-embed-text or embeddinggemma. A chat model can't make embeddings.",
          "display_name": "Model",
          "dynamic_source": "embedding_models",
          "dynamic_source_allows_custom": true,
          "examples": [
            {
              "label": "Nomic Embed Text",
              "value": "nomic-embed-text"
            },
            {
              "label": "EmbeddingGemma (Google)",
              "value": "embeddinggemma"
            },
            {
              "label": "mxbai-embed-large",
              "value": "mxbai-embed-large"
            },
            {
              "label": "all-minilm (small and fast)",
              "value": "all-minilm"
            }
          ],
          "name": "model",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text to embed, or a list of up to 100 texts, each embedded separately.",
          "display_name": "Text",
          "multiline": true,
          "name": "input",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/ollama/create-embeddings",
      "result_str_template": "Created embeddings with Ollama.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many embeddings came back.",
            "type": "integer"
          },
          "dimensions": {
            "description": "How many numbers each embedding has.",
            "type": "integer"
          },
          "embeddings": {
            "description": "One embedding per text, in the order given; each is a list of numbers.",
            "items": {
              "description": "One text's embedding.",
              "items": {
                "description": "One number.",
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "model": {
            "description": "The model that made them.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
