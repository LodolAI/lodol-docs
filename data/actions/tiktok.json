{
  "actions": {
    "get_user_info": {
      "description": "Get the connected TikTok creator's public profile: display name, avatar, and follower/like/video counts.",
      "display_name": "Get profile info",
      "display_str_template": "Get TikTok profile info.",
      "handler": "actions.get_user_info",
      "id": "tiktok_get_user_info",
      "method": "POST",
      "mock_response": {
        "avatar_url": "https://p16.tiktokcdn.com/avatar.jpeg",
        "display_name": "Lodol Creator",
        "follower_count": 1200,
        "following_count": 80,
        "likes_count": 34000,
        "open_id": "_000abc123",
        "video_count": 42
      },
      "name": "get_user_info",
      "output_formatter": "actions.format_get_user_info_output",
      "parameters": [],
      "path": "/actions/library/tiktok/get-user-info",
      "result_str_template": "Profile fetched.",
      "returns": {
        "properties": {
          "avatar_url": {
            "type": "string"
          },
          "bio_description": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "follower_count": {
            "type": "number"
          },
          "following_count": {
            "type": "number"
          },
          "likes_count": {
            "type": "number"
          },
          "open_id": {
            "type": "string"
          },
          "profile_deep_link": {
            "type": "string"
          },
          "union_id": {
            "type": "string"
          },
          "video_count": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "post_video": {
      "description": "Post a video to TikTok by pulling it from a public URL. The URL's domain must be verified on your TikTok app. Publishing then completes asynchronously on TikTok.",
      "display_name": "Post a video",
      "display_str_template": "Post a TikTok video.",
      "handler": "actions.post_video",
      "id": "tiktok_post_video",
      "method": "POST",
      "mock_response": {
        "publish_id": "v_pub_url~v2.123456789"
      },
      "name": "post_video",
      "output_formatter": "actions.format_post_video_output",
      "parameters": [
        {
          "description": "A publicly reachable URL of the video file, on a domain verified for your TikTok app.",
          "display_name": "Video URL",
          "name": "video_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The video caption (may include #hashtags and @mentions).",
          "display_name": "Caption",
          "multiline": true,
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "SELF_ONLY",
          "description": "Who can see the video. Must be one your account allows (see Query creator info).",
          "display_name": "Privacy",
          "name": "privacy_level",
          "options": [
            {
              "label": "Public",
              "value": "PUBLIC_TO_EVERYONE"
            },
            {
              "label": "Followers only",
              "value": "FOLLOWER_OF_CREATOR"
            },
            {
              "label": "Friends (mutual follows)",
              "value": "MUTUAL_FOLLOW_FRIENDS"
            },
            {
              "label": "Private (only me)",
              "value": "SELF_ONLY"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Turn off comments on the video.",
          "display_name": "Disable comments",
          "name": "disable_comment",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Prevent others from making Duets with the video.",
          "display_name": "Disable Duet",
          "name": "disable_duet",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Prevent others from Stitching the video.",
          "display_name": "Disable Stitch",
          "name": "disable_stitch",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/tiktok/post-video",
      "result_str_template": "Video upload started.",
      "returns": {
        "properties": {
          "publish_id": {
            "description": "ID the upload/publish is tracked by.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "query_creator_info": {
      "description": "Query the account's current posting options (allowed privacy levels and interaction settings) before posting a video.",
      "display_name": "Query creator info",
      "display_str_template": "Query TikTok creator info.",
      "handler": "actions.query_creator_info",
      "id": "tiktok_query_creator_info",
      "method": "POST",
      "mock_response": {
        "comment_disabled": false,
        "creator_nickname": "Lodol Creator",
        "creator_username": "lodolcreator",
        "duet_disabled": false,
        "max_video_post_duration_sec": 600,
        "privacy_level_options": [
          "PUBLIC_TO_EVERYONE",
          "MUTUAL_FOLLOW_FRIENDS",
          "SELF_ONLY"
        ],
        "stitch_disabled": false
      },
      "name": "query_creator_info",
      "output_formatter": "actions.format_query_creator_info_output",
      "parameters": [],
      "path": "/actions/library/tiktok/query-creator-info",
      "result_str_template": "Creator info fetched.",
      "returns": {
        "properties": {
          "comment_disabled": {
            "type": "boolean"
          },
          "creator_nickname": {
            "type": "string"
          },
          "creator_username": {
            "type": "string"
          },
          "duet_disabled": {
            "type": "boolean"
          },
          "max_video_post_duration_sec": {
            "type": "number"
          },
          "privacy_level_options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "stitch_disabled": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Read your TikTok profile and creator options, and post videos from a URL.",
  "display_name": "TikTok",
  "id": "tiktok"
}
