  "description": "Read and update client projects and contacts, and watch for new inquiries.",
  "display_name": "HoneyBook",
  "id": "honeybook",
  "logo": "https://www.lodol.com/app-icons/honeybook-icon.png",
  "triggers": {
    "honeybook_new_inquiry_trigger": {
      "description": "Runs for each new inquiry in HoneyBook. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New inquiry",
      "id": "honeybook_new_inquiry_trigger",
      "output": {
        "record": "object with the fields id, created_at, status"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Choose the HoneyBook company.",
          "display_name": "Company",
          "name": "company",
          "required": true
        }
      ]
    },
    "honeybook_new_project_trigger": {
      "description": "Runs for each new project in HoneyBook. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New project",
      "id": "honeybook_new_project_trigger",
      "output": {
        "record": "object with the fields id, name, project_date, project_details, updated_at"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Choose the HoneyBook company.",
          "display_name": "Company",
          "name": "company",
          "required": true
        }
