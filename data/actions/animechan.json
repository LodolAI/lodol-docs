{
  "actions": {
    "check_service_status": {
      "description": "Check whether Animechan is answering and how quickly, without failing the step when it is not. Put this in front of a workflow that would otherwise spend its daily request allowance discovering the service is down, and branch on 'ok'. It reports a throttle separately, so you can tell 'rate limited' from 'broken'.",
      "display_name": "Check service status",
      "display_str_template": "Check the Animechan service status.",
      "handler": "actions.check_service_status",
      "id": "animechan_check_service_status",
      "method": "POST",
      "mock_response": {
        "latency_ms": 742.0,
        "message": null,
        "ok": true,
        "rate_limited": false,
        "status_code": 200
      },
      "name": "check_service_status",
      "output_formatter": "actions.format_status_output",
      "parameters": [],
      "path": "/actions/library/animechan/check-service-status",
      "result_str_template": "Status checked.",
      "returns": {
        "properties": {
          "latency_ms": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "rate_limited": {
            "type": "boolean"
          },
          "status_code": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "find_anime": {
      "description": "Search the catalogue by title and get back the shows that match, best first, each with how many quotes it has on record. The step to put in front of the others when all a workflow has is a title out of a form field. Matching here is better than the quote routes': it matches whole words and folds accents, so 'cowboy bebop' finds Cowboy Bebop and a title typed without its accents still lands. Alternate titles are searched too.",
      "display_name": "Find an anime",
      "display_str_template": "Find anime matching {0}.",
      "handler": "actions.find_anime",
      "id": "animechan_find_anime",
      "method": "POST",
