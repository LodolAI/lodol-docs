      "parameters": [
        {
          "description": "The show to take quotes from. Matching is loose and case-insensitive, so 'bebop' finds Cowboy Bebop. If all you have is a title typed by a user, run 'Find an anime' first and pass the name it confirms. An empty value is rejected: the API answers a blank name with random quotes rather than an error.",
          "display_name": "Anime",
          "examples": [
            {
              "label": "A series",
              "value": "Naruto"
            },
            {
              "label": "Another series",
              "value": "Cowboy Bebop"
            }
          ],
          "name": "anime",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Which page of results to read, counting from 1. Five quotes come back per page, and the API publishes no way to ask for more. It sends no total, so 'has_more' reports only that a full page arrived. Page 0 is rejected here because the API answers it with an internal server error rather than saying what is wrong.",
          "display_name": "Page",
          "maximum": 10000,
          "minimum": 1,
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Refuse anything that matched only as a substring. Animechan matches names inside words, so asking for the character 'Itachi' returns 'Hikaru Hitachiin' from Ouran High School Host Club: a success as far as the API is concerned, and the wrong show as far as anyone else is. Turn this on and a match that is not at least a whole word is dropped; leave it off and every result still carries 'match_quality' so a later step can decide.",
          "display_name": "Only exact matches",
          "name": "require_exact_match",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
