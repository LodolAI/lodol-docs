                  "description": "The point's latitude, in degrees.",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "longitude": {
                  "description": "The point's longitude, in degrees.",
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "summary": {
            "description": "One line describing the result, e.g. '2,844 m above sea level (mapzen)'.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
