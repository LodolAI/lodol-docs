{
  "actions": {
    "get_elevation": {
      "description": "Get the height above sea level, in metres, of up to 100 places at once from a public elevation dataset: worldwide terrain and sea floor, or a sharper regional dataset for the USA, Europe or New Zealand. A place the dataset does not cover comes back without an elevation rather than failing the step. No API key required.",
      "display_name": "Get elevation",
      "display_str_template": "Get the elevation of {0}.",
      "handler": "actions.get_elevation",
      "id": "open_topo_data_get_elevation",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "dataset": "mapzen",
        "found_count": 2,
        "highest_elevation": 2844.0,
        "interpolation": "bilinear",
        "lowest_elevation": 1590.0,
        "results": [
          {
            "dataset": "mapzen",
            "elevation": 2844.0,
            "has_data": true,
            "latitude": 46.5586,
            "longitude": 7.8355
          },
          {
            "dataset": "mapzen",
            "elevation": 1590.0,
            "has_data": true,
            "latitude": 39.7471,
            "longitude": -104.9963
          }
        ],
