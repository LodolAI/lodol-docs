                  "type": [
                    "string",
                    "null"
                  ]
                },
                "elevation": {
                  "description": "Height above sea level in metres (negative below it, e.g. on the sea floor). Empty when the dataset has no data for this point.",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "has_data": {
                  "description": "False when the point lies outside the dataset's coverage or on a gap in it, so it has no elevation.",
                  "type": "boolean"
