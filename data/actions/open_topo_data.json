            {
              "label": "NZ DEM (New Zealand, 8 m)",
              "value": "nzdem8m"
            },
            {
              "label": "BKG (Germany, 200 m)",
              "value": "bkg200m"
            },
            {
              "label": "ETOPO1 (global, ~1.8 km)",
              "value": "etopo1"
            },
            {
              "label": "GEBCO 2020 (global, ~450 m)",
              "value": "gebco2020"
            },
            {
              "label": "EMODnet 2018 (European seas, ~100 m)",
              "value": "emod2018"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "bilinear",
          "description": "How to estimate the height between the dataset's grid points. Bilinear suits most uses, cubic is smoother, nearest takes the closest grid point as it is. Defaults to bilinear.",
          "display_name": "Interpolation",
          "name": "interpolation",
          "options": [
            {
              "label": "Bilinear (default)",
              "value": "bilinear"
