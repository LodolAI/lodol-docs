    "get_context_value": {
      "description": "Read a value a flow keeps in Node-RED's context, such as a sensor reading or a counter, from global context or one flow's.",
      "display_name": "Get context value",
      "display_str_template": "Get {0} from Node-RED's context.",
      "handler": "actions.get_context_value",
      "id": "node_red_get_context_value",
      "method": "POST",
      "mock_response": {
        "exists": true,
        "flow": "",
        "flow_id": "",
        "format": "number",
        "key": "boilerTemperature",
        "scope": "global",
        "shortened": false,
        "store": "memory",
        "text": "61.5",
        "value": 61.5
      },
      "name": "get_context_value",
      "output_formatter": "actions.format_context",
      "parameters": [
        {
          "description": "The context variable's name, as the flow sets it, such as temperature.",
          "display_name": "Name",
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "global",
          "description": "Global context, shared by every flow, or one flow's context.",
          "display_name": "Scope",
          "name": "scope",
          "options": [
            {
              "label": "Global",
              "value": "global"
            },
            {
              "label": "Flow",
              "value": "flow"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The flow whose context to read, when the scope is Flow.",
          "display_name": "Flow",
          "dynamic_source": "flows",
          "dynamic_source_allows_custom": true,
          "name": "flow",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The context store, such as file, when Node-RED has more than one. Leave blank for the default.",
          "display_name": "Context store",
          "name": "store",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/node-red/get-context-value",
      "result_str_template": "{node_red_get_context_value,key} is {node_red_get_context_value,text}.",
      "returns": {
        "properties": {
          "exists": {
            "description": "False when the variable isn't set",
            "type": "boolean"
          },
          "flow": {
            "description": "The flow's name, for a flow's context",
            "type": "string"
          },
          "flow_id": {
            "description": "The flow's ID, for a flow's context",
            "type": "string"
          },
          "format": {
            "description": "What Node-RED says it is, such as number, Object or string[12]",
            "type": "string"
          },
          "key": {
            "description": "The context variable's name",
            "type": "string"
          },
          "scope": {
            "description": "global or flow",
            "type": "string"
          },
          "shortened": {
            "description": "True when Node-RED shortened the value, as it does past 1,000 characters or items",
            "type": "boolean"
          },
          "store": {
            "description": "The context store it was read from, such as memory",
            "type": "string"
          },
          "text": {
            "description": "The value as text (JSON for an object or list)",
            "type": "string"
          },
          "value": {
            "description": "The value: a number, text, true or false, an object or a list",
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
