        "inject_nodes": 1,
        "label": "Order checks",
        "node_count": 5
      },
      "name": "disable_flow",
      "output_formatter": "actions.format_flow_state",
      "parameters": [
        {
          "description": "The flow (a tab in the editor): its name or ID.",
