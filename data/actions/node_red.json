{
  "actions": {
    "add_flow": {
      "description": "Add a flow to Node-RED from its export (Export in Node-RED's menu, or Get flow's) and deploy it, as a new tab with new node IDs.",
      "display_name": "Add flow",
      "display_str_template": "Add a flow to Node-RED.",
      "handler": "actions.add_flow",
      "id": "node_red_add_flow",
      "method": "POST",
      "mock_response": {
        "config_nodes_reused": 0,
        "disabled": false,
        "id": "6d5c4b3a29180f7e",
        "label": "Order checks (copy)",
        "node_count": 5
      },
      "name": "add_flow",
      "output_formatter": "actions.format_added",
      "parameters": [
        {
          "description": "The flow as JSON, as Node-RED's Export or Get flow gives it.",
          "display_name": "Flow export",
          "multiline": true,
          "name": "flow_json",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A name for the new flow. Leave blank for the export's own.",
          "display_name": "Name",
          "name": "label",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Add the flow switched off, to enable it later.",
          "display_name": "Add it disabled",
          "name": "disabled",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/node-red/add-flow",
      "result_str_template": "Added {node_red_add_flow,label}.",
      "returns": {
        "properties": {
          "config_nodes_reused": {
            "description": "Configuration nodes in the export this Node-RED already had, used as they are",
            "type": "number"
          },
          "disabled": {
            "description": "True when it was added disabled",
            "type": "boolean"
          },
          "id": {
            "description": "The new flow's ID",
            "type": "string"
          },
          "label": {
            "description": "Its name",
            "type": "string"
          },
          "node_count": {
            "description": "How many nodes it has",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "call_flow_endpoint": {
      "description": "Send a request to a flow's own HTTP endpoint (an http in node) and get its answer, so a workflow can use logic built in Node-RED. Fails when the flow answers with an error status.",
      "display_name": "Call flow endpoint",
      "display_str_template": "Call {0} on Node-RED.",
      "handler": "actions.call_flow_endpoint",
      "id": "node_red_call_flow_endpoint",
      "method": "POST",
      "mock_response": {
        "body": {
          "in_stock": true,
          "order": "A-1042",
          "ship_by": "2026-11-12"
        },
        "content_type": "application/json; charset=utf-8",
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "method": "POST",
        "ok": true,
        "status_code": 200,
        "text": "{\"order\":\"A-1042\",\"in_stock\":true,\"ship_by\":\"2026-11-12\"}",
        "url": "https://nodered.example.com/orders/check"
      },
      "name": "call_flow_endpoint",
      "output_formatter": "actions.format_endpoint",
      "parameters": [
        {
          "description": "The URL set in the flow's http in node, such as /orders/check, optionally after its method: POST /orders/check.",
          "display_name": "Endpoint",
          "dynamic_source": "endpoints",
          "dynamic_source_allows_custom": true,
          "name": "path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "auto",
          "description": "The HTTP method. As the endpoint is set up uses the http in node's own.",
          "display_name": "Method",
          "name": "method",
          "options": [
            {
              "label": "As the endpoint is set up",
              "value": "auto"
            },
            {
              "label": "GET",
              "value": "GET"
            },
            {
              "label": "POST",
              "value": "POST"
            },
            {
              "label": "PUT",
              "value": "PUT"
            },
            {
              "label": "PATCH",
              "value": "PATCH"
            },
            {
              "label": "DELETE",
              "value": "DELETE"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to send, as JSON: names and values, such as order: A-1042. Text that isn't JSON is sent as text. The flow gets it in msg.payload.",
          "display_name": "Body",
          "name": "body",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Names and values to add to the address, such as id: 42. The flow gets them in msg.req.query.",
          "display_name": "Query",
          "name": "query",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Extra request headers, by name, such as X-Source: Lodol.",
          "display_name": "Headers",
          "name": "headers",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "How long to wait for the flow to answer. Defaults to 60.",
          "display_name": "Wait up to (seconds)",
          "maximum": 300,
          "minimum": 1,
          "name": "timeout_seconds",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/node-red/call-flow-endpoint",
      "result_str_template": "The flow answered {node_red_call_flow_endpoint,status_code}.",
      "returns": {
        "properties": {
          "body": {
            "description": "What the flow answered: read as JSON (an object, a list, a number) when it is JSON, otherwise the text",
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "content_type": {
            "description": "The answer's content type, such as application/json",
            "type": "string"
          },
          "headers": {
            "additionalProperties": true,
            "description": "The answer's headers, by name",
            "type": "object"
          },
          "method": {
            "description": "The method the flow was called with, such as POST",
            "type": "string"
          },
          "ok": {
            "description": "True when the status is 2xx",
            "type": "boolean"
          },
          "status_code": {
            "description": "The HTTP status the flow answered with, such as 200",
            "type": "number"
          },
          "text": {
            "description": "What the flow answered, as text",
            "type": "string"
          },
          "url": {
            "description": "The address called",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "delete_flow": {
      "description": "Delete a flow and its nodes from Node-RED and deploy. Nothing is deleted when it isn't there.",
      "display_name": "Delete flow",
      "display_str_template": "Delete the flow {0} from Node-RED.",
