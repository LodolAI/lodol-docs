            "description": "False when Node-RED had no such flow, so nothing was deleted",
            "type": "boolean"
          },
          "id": {
            "description": "The flow's ID",
            "type": "string"
          },
          "label": {
            "description": "Its name",
            "type": "string"
          },
          "node_count": {
            "description": "How many nodes were deleted with it",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "disable_flow": {
      "description": "Switch a flow off and deploy it, so its nodes stop running until it's enabled again.",
