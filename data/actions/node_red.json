      },
      "name": "delete_flow",
      "output_formatter": "actions.format_deleted",
      "parameters": [
        {
          "description": "The flow (a tab in the editor): its name or ID.",
          "display_name": "Flow",
          "dynamic_source": "flows",
          "dynamic_source_allows_custom": true,
          "name": "flow",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/node-red/delete-flow",
