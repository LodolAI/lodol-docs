            "type": "INTEGER"
          }
        ],
        "primary_key": [
          "id"
        ],
        "table": "events"
      },
      "name": "describe_table",
      "output_formatter": "formatters.format_description",
      "parameters": [
        {
          "description": "The database to use. Pick one, or leave empty for your MotherDuck default database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The schema in that database. Leave empty for main.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database"
          ],
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table or view. Pick one, or give its name from an earlier step.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database",
            "schema"
          ],
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/duckdb/describe-table",
      "result_str_template": "Table described.",
      "returns": {
        "properties": {
          "column_count": {
            "description": "How many columns",
            "type": "number"
          },
          "columns": {
            "description": "The columns, in order",
            "items": {
              "properties": {
                "default": {
                  "description": "The column's default value, empty if it has none",
                  "nullable": true,
                  "type": "string"
                },
                "name": {
                  "description": "The column's name",
                  "type": "string"
                },
                "nullable": {
                  "description": "True when the column can be empty",
                  "type": "boolean"
                },
                "position": {
                  "description": "Where the column sits in the table, starting at 1",
                  "type": "number"
                },
                "primary_key": {
                  "description": "True when the column is part of the primary key",
                  "type": "boolean"
                },
                "type": {
                  "description": "The column's DuckDB type, such as INTEGER or VARCHAR",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "primary_key": {
            "description": "The primary key's columns, if any",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "table": {
            "description": "The table's name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
