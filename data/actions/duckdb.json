{
  "actions": {
    "count_rows": {
      "description": "Count a table's rows, or only the rows that match column and value pairs.",
      "display_name": "Count rows",
      "display_str_template": "Count rows.",
      "handler": "actions.count_rows",
      "id": "duckdb_count_rows",
      "method": "POST",
      "mock_response": {
        "count": 42
      },
      "name": "count_rows",
      "output_formatter": "formatters.format_count",
      "parameters": [
        {
          "description": "The database to use. Pick one, or leave empty for your MotherDuck default database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The schema in that database. Leave empty for main.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database"
          ],
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table or view. Pick one, or give its name from an earlier step.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database",
            "schema"
          ],
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Column and value pairs a row must equal (all of them). Use null for empty values, or a list to match any of its items. Leave empty for every row.",
          "display_name": "Match rows where",
          "name": "where",
          "object_key_name": "Column",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/duckdb/count-rows",
      "result_str_template": "Rows counted.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many rows",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "create_schema": {
      "description": "Create a schema in a database.",
      "display_name": "Create schema",
      "display_str_template": "Create schema.",
      "handler": "actions.create_schema",
      "id": "duckdb_create_schema",
      "method": "POST",
      "mock_response": {
        "created": true,
        "database": "my_db",
        "schema": "analytics"
      },
      "name": "create_schema",
      "output_formatter": "formatters.format_schema_created",
      "parameters": [
        {
          "description": "The database to use. Pick one, or leave empty for your MotherDuck default database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The new schema's name.",
          "display_name": "Schema name",
          "examples": [
            {
              "label": "A name",
              "value": "analytics"
            }
          ],
          "name": "schema",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Do nothing instead of failing when the schema exists. On by default.",
          "display_name": "Skip if it exists",
          "name": "if_not_exists",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/duckdb/create-schema",
      "result_str_template": "Schema created.",
      "returns": {
        "properties": {
          "created": {
            "description": "True once it ran",
            "type": "boolean"
          },
          "database": {
            "description": "The database it is in",
            "type": "string"
          },
          "schema": {
            "description": "The schema's name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_table": {
      "description": "Create a table from column names and types, with an optional primary key.",
      "display_name": "Create table",
      "display_str_template": "Create table.",
      "handler": "actions.create_table",
      "id": "duckdb_create_table",
      "method": "POST",
      "mock_response": {
        "column_count": 2,
        "created": true,
        "database": "my_db",
        "schema": "main",
        "table": "events"
      },
      "name": "create_table",
      "output_formatter": "formatters.format_table_created",
      "parameters": [
        {
          "description": "The database to use. Pick one, or leave empty for your MotherDuck default database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The schema in that database. Leave empty for main.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database"
          ],
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The new table's name.",
          "display_name": "Table name",
          "examples": [
            {
              "label": "A name",
              "value": "events"
            }
          ],
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Each column's name and type, such as INTEGER, BIGINT, DOUBLE, DECIMAL(18,3), VARCHAR, BOOLEAN, DATE, TIMESTAMP, UUID, JSON or BLOB.",
          "display_name": "Columns",
          "name": "columns",
          "object_key_name": "Column",
          "required": true,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "One of the columns above to make the primary key. Optional.",
          "display_name": "Primary key column",
          "name": "primary_key",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Do nothing instead of failing when the table exists.",
          "display_name": "Skip if it exists",
          "name": "if_not_exists",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/duckdb/create-table",
      "result_str_template": "Table created.",
      "returns": {
        "properties": {
          "column_count": {
            "description": "How many columns",
            "type": "number"
          },
          "created": {
            "description": "True once it ran",
            "type": "boolean"
          },
          "database": {
            "description": "The database it is in",
            "type": "string"
          },
          "schema": {
            "description": "The schema it is in",
            "type": "string"
          },
          "table": {
            "description": "The table's name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
