    "execute_statement": {
      "description": "Run one statement that changes data or tables: INSERT, UPDATE, DELETE, MERGE, CREATE, DROP or ALTER.",
      "display_name": "Run SQL statement",
      "display_str_template": "Run SQL statement.",
      "handler": "actions.execute_statement",
      "id": "duckdb_execute_statement",
      "method": "POST",
      "mock_response": {
        "executed": true,
        "rows_affected": 1
      },
      "name": "execute_statement",
      "output_formatter": "formatters.format_statement",
      "parameters": [
        {
          "description": "One INSERT, UPDATE, DELETE, MERGE, CREATE, DROP or ALTER statement. Use ? for each value listed under Parameters.",
          "display_name": "SQL",
          "multiline": true,
          "name": "sql",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The values for the ? marks in the SQL, in order.",
          "display_name": "Parameters",
          "item_by_item": true,
          "name": "parameters",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/duckdb/execute-statement",
      "result_str_template": "Statement run.",
      "returns": {
        "properties": {
          "executed": {
            "description": "True once it ran",
            "type": "boolean"
          },
          "rows_affected": {
            "description": "Rows inserted, updated or deleted, 0 for CREATE, DROP and ALTER",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "find_rows": {
      "description": "Read rows from a table, optionally only those matching column and value pairs, sorted and paged.",
      "display_name": "Find rows",
      "display_str_template": "Find rows.",
      "handler": "actions.find_rows",
      "id": "duckdb_find_rows",
      "method": "POST",
      "mock_response": {
        "columns": [
          "id",
          "name"
        ],
        "row_count": 1,
        "rows": [
          {
            "id": 1,
            "name": "Ada"
          }
        ],
        "truncated": false
      },
      "name": "find_rows",
      "output_formatter": "formatters.format_rows",
      "parameters": [
        {
          "description": "The database to use. Pick one, or leave empty for your MotherDuck default database.",
          "display_name": "Database",
          "dynamic_source": "databases",
          "dynamic_source_allows_custom": true,
          "name": "database",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The schema in that database. Leave empty for main.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database"
          ],
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table or view. Pick one, or give its name from an earlier step.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database",
            "schema"
          ],
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only these columns. Leave empty for all of them.",
          "display_name": "Columns",
          "item_by_item": true,
          "name": "columns",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Column and value pairs a row must equal (all of them). Use null for empty values, or a list to match any of its items. Leave empty for every row.",
          "display_name": "Match rows where",
          "name": "where",
          "object_key_name": "Column",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The column to sort by. Leave empty for no order.",
          "display_name": "Sort by",
          "dynamic_source": "columns",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "database",
            "schema",
            "table"
          ],
          "name": "order_by",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Which way to sort. Defaults to smallest first.",
          "display_name": "Order",
          "name": "direction",
          "options": [
            {
              "label": "Smallest first (default)",
              "value": "asc"
            },
            {
              "label": "Largest first",
              "value": "desc"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most rows to return, 1 to 10000. Defaults to 100.",
          "display_name": "Maximum rows",
          "maximum": 10000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How many rows to skip first, to read the next page.",
          "display_name": "Skip rows",
          "minimum": 0,
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/duckdb/find-rows",
      "result_str_template": "Rows retrieved.",
      "returns": {
        "properties": {
          "columns": {
            "description": "The column names, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "row_count": {
            "description": "How many rows came back",
            "type": "number"
          },
          "rows": {
            "description": "The rows, by column name",
            "items": {
              "description": "One row, by column name",
              "type": "object"
            },
            "type": "array"
          },
          "truncated": {
            "description": "True when more rows matched than were returned",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
