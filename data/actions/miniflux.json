      "output_formatter": "actions.format_entries",
      "parameters": [
        {
          "default": "unread",
          "description": "Which entries to find.",
          "display_name": "Read or unread",
          "name": "status",
          "options": [
            {
              "label": "Unread",
              "value": "unread"
            },
            {
              "label": "Read",
              "value": "read"
            },
            {
              "label": "Both",
              "value": "any"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
