{
  "actions": {
    "create_category": {
      "description": "Create a category to file feeds in. One of that name already there is answered as it is.",
      "display_name": "Create category",
      "display_str_template": "Create Miniflux category '{0}'.",
      "handler": "actions.create_category",
      "id": "miniflux_create_category",
      "method": "POST",
      "mock_response": {
        "already_existed": false,
        "feed_count": 0,
        "id": 3,
        "link": "https://reader.miniflux.app/category/3/entries",
        "title": "Tech",
        "unread_count": 0
      },
      "name": "create_category",
      "output_formatter": "actions.format_category",
      "parameters": [
        {
          "description": "The category's name.",
          "display_name": "Name",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/miniflux/create-category",
      "result_str_template": "Category {miniflux_create_category,id} ready.",
      "returns": {
        "properties": {
          "already_existed": {
            "description": "Whether a category of that name was already there",
            "type": "boolean"
          },
          "feed_count": {
            "description": "How many feeds are in it",
            "type": "number"
          },
          "id": {
            "description": "The category's ID",
            "type": "number"
          },
          "link": {
            "description": "A link to it in Miniflux",
            "type": "string"
          },
          "title": {
            "description": "Its name",
            "type": "string"
          },
          "unread_count": {
            "description": "How many unread entries its feeds have",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_category": {
      "description": "Delete a category with no feeds in it. One with feeds is refused, because Miniflux would unsubscribe from them too.",
      "display_name": "Delete category",
      "display_str_template": "Delete Miniflux category {0}.",
      "handler": "actions.delete_category",
      "id": "miniflux_delete_category",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": 3,
        "title": "Tech"
      },
      "name": "delete_category",
      "output_formatter": "actions.format_deleted_category",
      "parameters": [
        {
          "description": "The category to delete: its name or ID.",
          "display_name": "Category",
          "dynamic_source": "categories",
          "dynamic_source_allows_custom": true,
          "name": "category",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/miniflux/delete-category",
      "result_str_template": "Category {miniflux_delete_category,id} deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Always true",
            "type": "boolean"
          },
          "id": {
            "description": "The category's ID",
            "type": "number"
          },
          "title": {
            "description": "Its name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "find_entries": {
      "description": "Find entries by unread or read, starred, category, feed, words or when they were published, newest first, with their content as text and HTML.",
      "display_name": "Find entries",
