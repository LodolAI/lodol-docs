                },
                "category": {
                  "description": "The feed's category",
                  "type": "string"
                },
                "category_id": {
                  "description": "The category's ID",
                  "type": "number"
                },
                "comments_url": {
                  "description": "A link to its comments, when the feed has one",
                  "type": "string"
                },
                "content": {
                  "description": "Its content as plain text",
                  "type": "string"
                },
                "content_html": {
                  "description": "Its content as HTML",
                  "type": "string"
                },
                "created_at": {
                  "description": "When Miniflux first read it (ISO 8601)",
                  "type": "string"
                },
                "feed": {
                  "description": "The feed it came from",
                  "type": "string"
                },
                "feed_id": {
                  "description": "The feed's ID",
                  "type": "number"
                },
                "feed_url": {
                  "description": "The feed's address",
                  "type": "string"
                },
                "id": {
                  "description": "The entry's ID in Miniflux",
                  "type": "number"
                },
                "link": {
                  "description": "A link to it in Miniflux",
                  "type": "string"
                },
                "media": {
                  "description": "Links to attached audio, video or pictures, such as a podcast episode",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "published_at": {
                  "description": "When it was published (ISO 8601)",
                  "type": "string"
                },
                "reading_time": {
                  "description": "Minutes it takes to read, as Miniflux estimates",
                  "type": "number"
                },
                "site_url": {
                  "description": "The address of the feed's website",
                  "type": "string"
                },
                "starred": {
                  "description": "Whether it's starred",
                  "type": "boolean"
                },
                "status": {
                  "description": "unread or read",
                  "type": "string"
                },
                "tags": {
                  "description": "Its tags, as the feed gives them",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "title": {
                  "description": "Its title",
                  "type": "string"
                },
                "url": {
                  "description": "The link to the original article",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "How many entries match, including any past the limit",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
