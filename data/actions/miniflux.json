        {
          "description": "Only entries you've starred.",
          "display_name": "Starred only",
          "name": "starred",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Only entries from feeds in this category. Leave blank for every category.",
          "display_name": "Category",
          "dynamic_source": "categories",
          "dynamic_source_allows_custom": true,
          "name": "category",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only entries from this feed. Leave blank for every feed.",
          "display_name": "Feed",
          "dynamic_source": "feeds",
          "dynamic_source_allows_custom": true,
          "name": "feed",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only entries with these words in their title or content.",
          "display_name": "Words",
          "name": "search",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only entries published after this time.",
          "display_name": "Published after",
          "name": "published_after",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "default": "newest",
          "description": "Which come first.",
          "display_name": "Order",
          "name": "order",
          "options": [
            {
              "label": "Newest first",
              "value": "newest"
            },
            {
              "label": "Oldest first",
              "value": "oldest"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most to list, up to 100. Defaults to 25.",
          "display_name": "How many",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/miniflux/find-entries",
      "result_str_template": "Found {miniflux_find_entries,count} entries.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many entries are listed",
            "type": "number"
          },
          "entries": {
            "description": "The entries found",
