    "query_dashboard": {
      "description": "Ask Clarity a question about the dashboard in plain language, such as 'Top browsers in the last 3 days', and get the figures that answer it.",
      "display_name": "Ask the dashboard",
      "display_str_template": "Ask the Microsoft Clarity dashboard a question.",
      "handler": "actions.query_dashboard",
      "id": "microsoft_clarity_query_dashboard",
      "method": "POST",
      "mock_response": {
        "result": "Chrome: 1,204 sessions; Safari: 512 sessions"
      },
      "name": "query_dashboard",
      "parameters": [
        {
          "description": "One question about the dashboard, in plain language, with an explicit time range.",
          "display_name": "Question",
          "examples": [
            {
              "label": "Top browsers",
              "value": "Top browsers in the last 3 days"
            },
            {
              "label": "Rage clicks by page",
              "value": "Pages with the most rage clicks in the last 3 days"
            }
          ],
          "multiline": true,
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "UTC",
          "description": "The time zone 'today' and 'last 3 days' are read in, as an IANA name. Defaults to UTC.",
          "display_name": "Time zone",
          "examples": [
            {
              "label": "UTC",
              "value": "UTC"
            },
            {
              "label": "New York",
              "value": "America/New_York"
            },
            {
              "label": "London",
              "value": "Europe/London"
            }
          ],
          "name": "timezone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-clarity/query-dashboard",
      "result_str_template": "Dashboard answer retrieved.",
      "returns": {
        "description": "Clarity's answer, as sent",
        "properties": {
          "result": {
            "description": "The answer, when Clarity sends something other than an object"
          }
        },
        "type": "object"
      }
    }
  },
