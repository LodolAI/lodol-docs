{
  "actions": {
    "get_live_insights": {
      "description": "Read the Clarity dashboard for the last 24, 48 or 72 hours: sessions, bot sessions, distinct users and pages per session, plus engagement time, scroll depth and the frustration signals (rage clicks, dead clicks, quick backs, excessive scrolling, JavaScript errors). Optionally break them down by up to three of browser, device, country, OS, source, medium, campaign, channel or URL. Clarity allows 10 of these per project per day, shared by every workflow using the project.",
      "display_name": "Get dashboard insights",
      "display_str_template": "Get Microsoft Clarity dashboard insights.",
      "handler": "actions.get_live_insights",
      "id": "microsoft_clarity_get_live_insights",
      "method": "POST",
      "mock_response": {
        "dimensions": [
          "OS"
        ],
        "dimensions_applied": true,
        "metrics": [
          {
            "information": [
              {
                "OS": "Other",
                "PagesPerSessionPercentage": 1.0931,
                "distantUserCount": "189733",
                "totalBotSessionCount": "8369",
                "totalSessionCount": "9554"
              }
            ],
            "metricName": "Traffic"
          }
        ],
        "num_of_days": 1
      },
      "name": "get_live_insights",
      "parameters": [
        {
          "default": "1",
          "description": "How far back to read, counted from now (UTC).",
          "display_name": "Period",
          "name": "num_of_days",
          "options": [
            {
              "label": "Last 24 hours",
              "value": "1"
            },
            {
              "label": "Last 48 hours",
              "value": "2"
            },
            {
              "label": "Last 72 hours",
              "value": "3"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Up to three dimensions to break the metrics down by, such as Device and Country/Region. Leave empty for the overall figures.",
          "display_name": "Break down by",
          "multi_select": true,
          "name": "dimensions",
          "options": [
            {
              "label": "Browser",
              "value": "Browser"
            },
            {
              "label": "Device",
              "value": "Device"
            },
            {
              "label": "Country/Region",
              "value": "Country/Region"
            },
            {
              "label": "Operating system",
              "value": "OS"
            },
            {
              "label": "Source",
              "value": "Source"
            },
            {
              "label": "Medium",
              "value": "Medium"
            },
            {
              "label": "Campaign",
              "value": "Campaign"
            },
            {
              "label": "Channel",
              "value": "Channel"
            },
            {
              "label": "Page URL",
              "value": "URL"
            }
          ],
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/microsoft-clarity/get-live-insights",
      "result_str_template": "Dashboard insights retrieved.",
      "returns": {
        "properties": {
          "dimensions": {
            "description": "The dimensions the data was broken down by",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dimensions_applied": {
            "description": "Whether any row came back broken down by a chosen dimension; empty when none was chosen or there were no rows",
            "type": "boolean"
          },
          "metrics": {
            "description": "Each dashboard metric with its rows",
            "items": {
              "properties": {
                "information": {
                  "description": "The metric's rows, one per dimension combination",
                  "items": {
                    "properties": {
                      "PagesPerSessionPercentage": {
                        "description": "Pages per session (Traffic)",
                        "type": "number"
                      },
                      "distantUserCount": {
                        "description": "Distinct users, as text (Traffic)",
                        "type": "string"
                      },
                      "totalBotSessionCount": {
                        "description": "Sessions from bots, as text (Traffic)",
                        "type": "string"
                      },
                      "totalSessionCount": {
                        "description": "Sessions, as text (Traffic)",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "metricName": {
                  "description": "The metric, such as 'Traffic'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "num_of_days": {
            "description": "How many days back the data covers (1-3)",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "list_session_recordings": {
