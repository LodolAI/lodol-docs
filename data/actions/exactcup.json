{
  "actions": {
    "convert_recipe_to_weights": {
      "description": "Weigh every line of a recipe in one step: give each ingredient with its amount and unit, and get back the grams and ounces for each line plus the total. Lines already in ounces or pounds are converted too. A line that cannot be matched comes back with the reason instead of stopping the step. Up to 50 lines. No API key required.",
      "display_name": "Convert a recipe to grams",
      "display_str_template": "Convert a recipe's ingredients to grams.",
      "handler": "actions.convert_recipe_to_weights",
      "id": "exactcup_convert_recipe_to_weights",
      "method": "POST",
      "mock_response": {
        "attribution": "Ingredient density data by ExactCup (https://exactcup.github.io/)",
        "converted_count": 1,
        "count": 1,
        "failed_count": 0,
        "items": [
          {
            "amount": 2.0,
            "converted": true,
            "error": null,
            "grams": 240.0,
            "ingredient": "all-purpose-flour",
            "ingredient_name": "All-Purpose Flour",
            "input_ingredient": "plain flour",
            "ounces": 8.47,
            "unit": "us_cup"
          }
        ],
        "total_grams": 240.0,
        "total_ounces": 8.47
      },
      "name": "convert_recipe_to_weights",
      "parameters": [
        {
          "description": "One row per ingredient: its name, the amount (1.5, 3/4 or 1 1/2), and the unit. Up to 50 lines.",
          "display_name": "Recipe lines",
          "name": "items",
          "required": true,
          "schema": {
            "properties": {
              "amount": {
                "description": "How much, e.g. '3/4' or '1.5'.",
                "type": "string"
              },
              "ingredient": {
                "description": "The ingredient, e.g. 'brown sugar'.",
                "type": "string"
              },
              "unit": {
                "description": "The unit the amount is in.",
                "enum": [
                  "us_cup",
                  "us_tablespoon",
                  "us_teaspoon",
                  "milliliter",
                  "liter",
                  "us_fluid_ounce",
                  "us_pint",
                  "us_quart",
                  "us_gallon",
                  "metric_cup",
                  "imperial_cup",
                  "imperial_fluid_ounce",
                  "imperial_pint",
                  "australian_tablespoon",
                  "gram",
                  "kilogram",
                  "ounce",
                  "pound"
                ],
                "type": "string"
              }
            },
            "required": [
              "ingredient",
              "amount",
              "unit"
            ],
            "type": "object"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/exactcup/convert-recipe-to-weights",
      "result_str_template": "Weighed {exactcup_convert_recipe_to_weights,converted_count} of {exactcup_convert_recipe_to_weights,count} lines: {exactcup_convert_recipe_to_weights,total_grams} g in total.",
      "returns": {
        "properties": {
          "attribution": {
            "description": "ExactCup's credit line. Its data is CC BY 4.0, so show this with a link wherever the numbers are published.",
            "type": "string"
          },
          "converted_count": {
            "description": "How many lines were converted.",
            "type": "integer"
          },
          "count": {
            "description": "How many lines were given.",
            "type": "integer"
          },
          "failed_count": {
            "description": "How many lines could not be converted.",
            "type": "integer"
          },
          "items": {
            "description": "One row per recipe line, in the order given.",
            "items": {
              "description": "One recipe line and its weight.",
              "properties": {
                "amount": {
                  "description": "The amount, as a number.",
                  "type": "number"
                },
                "converted": {
                  "description": "Whether the line could be converted.",
                  "type": "boolean"
                },
                "error": {
                  "description": "Why the line could not be converted. Empty if it was.",
                  "type": "string"
                },
                "grams": {
                  "description": "What the line weighs.",
                  "type": "number"
                },
                "ingredient": {
                  "description": "The id of the ingredient it matched. Empty if none.",
                  "type": "string"
                },
                "ingredient_name": {
                  "description": "The name of the ingredient it matched.",
                  "type": "string"
                },
                "input_ingredient": {
                  "description": "The ingredient as it was given.",
                  "type": "string"
                },
                "ounces": {
                  "description": "The same weight in ounces.",
                  "type": "number"
                },
                "unit": {
                  "description": "The unit it was measured in.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total_grams": {
            "description": "The weight of every converted line together.",
            "type": "number"
          },
          "total_ounces": {
            "description": "The same total in ounces.",
            "type": "number"
          }
