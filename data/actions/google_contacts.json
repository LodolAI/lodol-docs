{
  "actions": {
    "add_contact_to_label": {
      "description": "Put a contact under one of your labels, such as Customers. A contact already under it stays as it is.",
      "display_name": "Add contact to label",
      "display_str_template": "Add contact '{0}' to a label.",
      "handler": "actions.add_contact_to_label",
      "id": "google_contacts_add_contact_to_label",
      "method": "POST",
      "mock_response": {
        "label": "contactGroups/1a2b3c4d5e",
        "resource_name": "people/c123456789"
      },
      "name": "add_contact_to_label",
      "parameters": [
        {
          "description": "The ID of the contact, for example people/c123456789, as Find contacts, Create contact or a trigger gives it.",
          "display_name": "Contact ID",
          "name": "resource_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The label to put the contact under.",
          "display_name": "Label",
          "dynamic_source": "labels",
          "name": "label",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-contacts/add-contact-to-label",
      "result_str_template": "Added the contact to the label.",
      "returns": {
        "properties": {
          "label": {
            "description": "The label's ID, for example contactGroups/1a2b3c",
            "type": "string"
          },
          "resource_name": {
            "description": "The contact's ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_contact": {
      "description": "Create a new contact in Google Contacts.",
      "display_name": "Create contact",
      "display_str_template": "Create contact '{0}'.",
      "handler": "actions.create_contact",
      "id": "google_contacts_create_contact",
      "method": "POST",
      "mock_response": {
        "resource_name": "people/c987654321"
      },
      "name": "create_contact",
      "parameters": [
        {
          "description": "First name of the contact.",
          "display_name": "First name",
          "examples": [
            {
              "label": "First name",
              "value": "Jane"
            }
          ],
          "name": "given_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name of the contact.",
          "display_name": "Last name",
          "examples": [
            {
              "label": "Last name",
              "value": "Smith"
            }
          ],
          "name": "family_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email address of the contact.",
          "display_name": "Email",
          "examples": [
            {
              "label": "Email",
              "value": "jane@example.com"
            }
          ],
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Phone number of the contact.",
          "display_name": "Phone",
          "examples": [
            {
              "label": "Phone",
              "value": "+14155550123"
            }
          ],
          "name": "phone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-contacts/create-contact",
      "result_str_template": "Created contact '{0}'.",
      "returns": {
        "description": "Response envelope; the payload is in the \"resource_name\" field.",
        "properties": {
          "resource_name": {
            "description": "Resource name of the created contact",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_label": {
      "description": "Make a new label to group contacts under.",
      "display_name": "Create label",
      "display_str_template": "Create label '{0}'.",
      "handler": "actions.create_label",
      "id": "google_contacts_create_label",
      "method": "POST",
      "mock_response": {
        "label": "contactGroups/1a2b3c4d5e",
        "name": "Customers"
      },
      "name": "create_label",
      "parameters": [
        {
          "description": "What to call the label. No two labels can share a name.",
          "display_name": "Name",
          "examples": [
            {
              "label": "Name",
              "value": "Customers"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-contacts/create-label",
      "result_str_template": "Created label '{0}'.",
      "returns": {
        "properties": {
          "label": {
            "description": "The new label's ID, for Add contact to label",
            "type": "string"
          },
          "name": {
            "description": "The label's name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_contact": {
      "description": "Delete a contact from Google Contacts.",
      "display_name": "Delete contact",
      "display_str_template": "Delete contact '{0}'.",
      "handler": "actions.delete_contact",
      "id": "google_contacts_delete_contact",
      "method": "POST",
      "mock_response": {
        "status": "deleted"
      },
      "name": "delete_contact",
      "parameters": [
        {
          "description": "The ID of the contact to delete, for example people/c123456789",
          "display_name": "Contact ID",
          "name": "resource_name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-contacts/delete-contact",
      "result_str_template": "Deleted contact {0}.",
      "returns": {
        "properties": {
          "status": {
            "description": "Deletion status.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "delete_label": {
      "description": "Delete one of your labels. The contacts under it are kept.",
      "display_name": "Delete label",
      "display_str_template": "Delete a label.",
      "handler": "actions.delete_label",
      "id": "google_contacts_delete_label",
      "method": "POST",
      "mock_response": {
        "label": "contactGroups/1a2b3c4d5e",
        "status": "deleted"
      },
      "name": "delete_label",
      "parameters": [
        {
          "description": "The label to delete.",
          "display_name": "Label",
          "dynamic_source": "labels",
          "name": "label",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-contacts/delete-label",
      "result_str_template": "Deleted the label.",
      "returns": {
        "properties": {
          "label": {
            "description": "The deleted label's ID",
            "type": "string"
          },
          "status": {
            "description": "Deletion status",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "find_contacts": {
      "description": "Find contacts by name, email address, phone number or company, such as the contact to update for an email that just arrived. Words match from their start: 'Sam' finds Sam Lee.",
      "display_name": "Find contacts",
      "display_str_template": "Find contacts matching '{0}'.",
      "handler": "actions.find_contacts",
      "id": "google_contacts_find_contacts",
      "method": "POST",
      "mock_response": {
        "contacts": [
          {
            "email": "jane@acme.com",
            "fullName": "Jane Doe",
            "phone": "+1234567890",
            "resourceName": "people/c123456789"
          }
        ],
        "count": 1
      },
      "name": "find_contacts",
      "output_formatter": "actions.format_find_contacts_output",
      "parameters": [
        {
          "description": "A name, email address, phone number or company, or the start of one.",
          "display_name": "Search for",
          "examples": [
            {
              "label": "Email address",
              "value": "jane@acme.com"
            },
            {
              "label": "Name",
              "value": "Jane Doe"
            }
          ],
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "Most contacts to return, from 1 to 30.",
          "display_name": "Maximum contacts",
          "maximum": 30,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-contacts/find-contacts",
      "result_str_template": "Found {0} contact(s).",
      "returns": {
        "properties": {
          "contacts": {
            "description": "The matching contacts, best match first",
            "items": {
              "properties": {
                "email": {
                  "description": "Primary email",
                  "type": "string"
                },
                "fullName": {
                  "description": "Full name",
                  "type": "string"
                },
                "phone": {
                  "description": "Primary phone",
                  "type": "string"
                },
                "resourceName": {
                  "description": "The contact's ID, for Get, Update or Delete contact",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "count": {
            "description": "How many contacts matched",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_contact": {
      "description": "Look up a single contact by its ID.",
      "display_name": "Get contact",
      "display_str_template": "Get contact '{0}'.",
      "handler": "actions.get_contact",
      "id": "google_contacts_get_contact",
      "method": "POST",
      "mock_response": {
        "contact": {
          "email": "john@example.com",
          "etag": "%EgUBAgkLNz4aBAECBQciDFJJREZyWjJIMDdBTT0=",
          "fullName": "John Smith",
          "phone": "+1234567890",
          "resourceName": "people/c123456789"
        }
      },
      "name": "get_contact",
      "parameters": [
        {
          "description": "The ID of the contact, for example people/c123456789",
          "display_name": "Contact ID",
          "name": "resource_name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-contacts/get-contact",
      "result_str_template": "Retrieved contact {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"contact\" field.",
        "properties": {
          "contact": {
            "properties": {
              "email": {
                "description": "Primary email",
                "type": "string"
              },
              "etag": {
                "description": "Contact etag for updates",
                "type": "string"
              },
              "fullName": {
                "description": "Full name",
                "type": "string"
              },
              "phone": {
                "description": "Primary phone",
                "type": "string"
              },
              "resourceName": {
                "description": "Contact resource name",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_contacts": {
      "description": "List contacts from your Google account.",
      "display_name": "List contacts",
      "display_str_template": "List contacts.",
      "handler": "actions.list_contacts",
      "id": "google_contacts_list_contacts",
      "method": "POST",
      "mock_response": {
        "contacts": [
          {
            "email": "john@example.com",
            "fullName": "John Smith",
            "phone": "+1234567890",
            "resourceName": "people/c123456789"
          }
        ]
      },
      "name": "list_contacts",
      "parameters": [
        {
          "description": "Maximum number of contacts to return (1-1000, default 25)",
          "display_name": "Maximum contacts",
          "name": "page_size",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-contacts/list-contacts",
      "result_str_template": "Returned contacts from Google Contacts.",
      "returns": {
        "description": "Response envelope; the payload is in the \"contacts\" field.",
        "properties": {
          "contacts": {
            "description": "List of contacts",
            "items": {
              "properties": {
                "email": {
                  "description": "Primary email",
                  "type": "string"
                },
                "fullName": {
                  "description": "Full name",
                  "type": "string"
                },
                "phone": {
                  "description": "Primary phone",
                  "type": "string"
                },
                "resourceName": {
                  "description": "Contact resource name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "update_contact": {
      "description": "Update an existing contact in Google Contacts.",
      "display_name": "Update contact",
      "display_str_template": "Update contact '{0}'.",
      "handler": "actions.update_contact",
      "id": "google_contacts_update_contact",
      "method": "POST",
      "mock_response": {
        "resource_name": "people/c123456789"
      },
      "name": "update_contact",
      "parameters": [
        {
          "description": "The ID of the contact to update, for example people/c123456789",
          "display_name": "Contact ID",
          "name": "resource_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "New first name of the contact",
          "display_name": "First name",
          "name": "given_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "New last name of the contact",
          "display_name": "Last name",
          "name": "family_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "New email address of the contact",
          "display_name": "Email",
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "New phone number of the contact",
          "display_name": "Phone",
          "name": "phone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-contacts/update-contact",
      "result_str_template": "Updated contact {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"resource_name\" field.",
        "properties": {
          "resource_name": {
            "description": "Resource name of the updated contact",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    }
  },
  "categories": [
    "CRM & Contacts",
    "Google"
  ],
  "description": "Manage your Google Contacts.",
  "display_name": "Google Contacts",
  "id": "google_contacts",
  "logo": "https://www.lodol.com/app-icons/google-contacts-icon.png",
  "triggers": {
    "google_contacts_new_contact_trigger": {
      "description": "Runs when a contact is added to your Google Contacts, with their name, email address, phone number and company. Contacts already there when the workflow is turned on don't start it. Watches address books of up to 4,000 contacts.",
      "display_name": "New contact",
      "id": "google_contacts_new_contact_trigger",
      "output": {
        "company": "The company the contact works for.",
        "email": "The contact's first email address.",
        "first_name": "The contact's first name.",
        "full_name": "The contact's first and last name.",
        "job_title": "The contact's job title.",
        "last_name": "The contact's last name.",
        "link": "The contact's page in Google Contacts.",
        "phone": "The contact's first phone number.",
        "resource_name": "The contact's ID, for Get, Update or Delete contact.",
        "updated_at": "When the contact was last changed."
      },
      "parameters": []
    },
    "google_contacts_new_or_updated_contact_trigger": {
      "description": "Runs when a contact in your Google Contacts is added or changed, with the contact as it is now. A contact changed twice runs twice.",
      "display_name": "New or updated contact",
      "id": "google_contacts_new_or_updated_contact_trigger",
      "output": {
        "company": "The company the contact works for.",
        "email": "The contact's first email address.",
        "first_name": "The contact's first name.",
        "full_name": "The contact's first and last name.",
        "job_title": "The contact's job title.",
        "last_name": "The contact's last name.",
        "link": "The contact's page in Google Contacts.",
        "phone": "The contact's first phone number.",
        "resource_name": "The contact's ID, for Get, Update or Delete contact.",
        "updated_at": "When the contact was last changed."
      },
      "parameters": []
    }
  }
}
