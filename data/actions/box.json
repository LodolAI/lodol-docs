{
  "actions": {
    "add_comment": {
      "description": "Comment on a Box file as the connected account. Everyone who can see the file sees the comment, and @mentions aren't sent as notifications.",
      "display_name": "Add comment to file",
      "display_str_template": "Comment on Box file {0}.",
      "handler": "actions.add_comment",
      "id": "box_add_comment",
      "method": "POST",
      "mock_response": {
        "comment_id": "445566778",
        "created_at": "2026-07-16T10:30:00-07:00",
        "file_id": "123456789",
        "message": "Signed copy received."
      },
      "name": "add_comment",
      "output_formatter": "actions.format_comment_output",
      "parameters": [
        {
          "description": "The Box file's ID: the number at the end of its address, such as 123456789 in app.box.com/file/123456789.",
          "display_name": "File",
          "name": "file_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What the comment says.",
          "display_name": "Comment",
          "multiline": true,
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/box/add-comment",
      "result_str_template": "Comment added in Box.",
      "returns": {
        "properties": {
          "comment_id": {
            "description": "The new comment's Box ID.",
            "type": "string"
          },
          "created_at": {
            "description": "When it was added.",
            "type": "string"
          },
          "file_id": {
            "description": "The file it's on.",
            "type": "string"
          },
          "message": {
            "description": "What the comment says.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "copy_file": {
      "description": "Copy a Box file into a folder, optionally under a new name. Box won't replace a file with the same name already there: the step fails and nothing is copied.",
      "display_name": "Copy file",
      "display_str_template": "Copy Box file {0} to folder {1}.",
      "handler": "actions.copy_file",
      "id": "box_copy_file",
      "method": "POST",
      "mock_response": {
        "id": "123456790",
        "link": "https://app.box.com/file/123456790",
        "name": "report copy.pdf",
        "type": "file"
      },
      "name": "copy_file",
      "output_formatter": "actions.format_item_output",
      "parameters": [
        {
          "description": "The Box file's ID: the number at the end of its address, such as 123456789 in app.box.com/file/123456789.",
          "display_name": "File",
          "name": "file_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The folder to put the copy in: its ID, the number at the end of the folder's address. 0 is your top folder.",
          "display_name": "Copy to folder",
          "name": "folder_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A name for the copy. Leave blank to keep the original's name; a copy into the same folder needs a new one.",
          "display_name": "Name of the copy",
          "name": "new_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/box/copy-file",
      "result_str_template": "File copied in Box.",
      "returns": {
        "properties": {
          "id": {
            "description": "The item's Box ID.",
            "type": "string"
          },
          "link": {
            "description": "The item's page in Box.",
            "type": "string"
          },
          "name": {
            "description": "The item's name.",
            "type": "string"
          },
          "type": {
            "description": "file or folder.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
