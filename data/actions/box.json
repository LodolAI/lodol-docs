{
  "actions": {
    "create_shared_link": {
      "description": "Create a shared link for a Box file. You can control whether the link allows downloads and previews.",
      "display_name": "Create shared link",
      "display_str_template": "Create a {1} shared link for Box file {0}.",
      "handler": "actions.create_shared_link",
      "id": "box_create_shared_link",
      "method": "POST",
      "mock_response": {
        "shared_link": "https://box.com/s/abc123xyz789def456"
      },
      "name": "create_shared_link",
      "output_formatter": "actions.format_create_shared_link_output",
      "parameters": [
        {
          "description": "",
          "display_name": "File ID",
          "name": "file_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Who can open the link.",
          "display_name": "Access",
          "name": "access",
          "options": [
            {
              "label": "Anyone with the link",
              "value": "open"
            },
            {
              "label": "People in your company",
              "value": "company"
            },
            {
              "label": "Only invited collaborators",
              "value": "collaborators"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Set to true to let people who can open the link to download the file.",
          "display_name": "Allow download",
          "name": "allow_download",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": true,
          "description": "Set to true to let people who can open the link to preview the file.",
          "display_name": "Allow preview",
          "name": "allow_preview",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/box/create-shared-link",
      "result_str_template": "Shared link created.",
      "returns": {
        "properties": {
          "shared_link": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "download_file": {
      "description": "Download a file from Box.",
      "display_name": "Download file",
      "display_str_template": "Download Box file {0}.",
      "handler": "actions.download_file",
      "id": "box_download_file",
      "method": "POST",
      "mock_response": {
        "document_ref": "doc_0123456789abcdef0123456789abcdef",
        "file_name": "report.pdf"
      },
      "name": "download_file",
      "output_formatter": "actions.format_download_file_output",
      "parameters": [
        {
          "description": "",
          "display_name": "File ID",
          "name": "file_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/box/download-file",
      "result_str_template": "File downloaded from Box.",
      "returns": {
        "properties": {
          "document_ref": {
            "description": "Reference to the downloaded file, usable as a file input in later steps",
            "type": "string"
          },
          "file_name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_folder_items": {
      "description": "List the files and subfolders inside a Box folder.",
      "display_name": "List folder items",
      "display_str_template": "List items in Box folder {0}.",
      "handler": "actions.list_folder_items",
      "id": "box_list_folder_items",
      "method": "POST",
      "mock_response": {
        "items": [
          {
            "id": "987654321",
            "name": "report.pdf",
            "type": "file"
          }
        ]
      },
      "name": "list_folder_items",
      "output_formatter": "actions.format_list_folder_items_output",
      "parameters": [
        {
          "description": "The ID of the Box folder to look in.",
          "display_name": "Folder ID",
          "name": "folder_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/box/list-folder-items",
      "result_str_template": "Folder contents retrieved.",
      "returns": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "upload_file": {
      "description": "Upload a file to a Box folder and get a shareable link.",
      "display_name": "Upload file",
      "display_str_template": "Upload '{0}' to Box folder {1}.",
      "handler": "actions.upload_file",
      "id": "box_upload_file",
      "method": "POST",
      "mock_response": {
        "file_id": "123456789",
        "file_link": "https://app.box.com/file/123456789"
      },
      "name": "upload_file",
      "output_formatter": "actions.format_upload_file_output",
      "parameters": [
        {
          "description": "",
          "display_name": "Folder ID",
          "name": "folder_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "autofill_name_param": "file_name",
          "description": "",
          "display_name": "File to upload",
          "name": "file_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A different name to save the file as in Box. If left blank, the original file name is used.",
          "display_name": "File name",
          "name": "file_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/box/upload-file",
      "result_str_template": "File uploaded to Box.",
      "returns": {
        "properties": {
          "file_id": {
            "type": "string"
          },
          "file_link": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Upload, share, and manage files stored in Box.",
  "display_name": "Box",
  "id": "box"
}
