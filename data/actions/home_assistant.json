{
  "actions": {
    "ask_assist": {
      "description": "Tell Home Assistant's voice assistant what to do or ask it something, in plain words, such as 'turn off the kitchen lights'.",
      "display_name": "Ask Assist",
      "display_str_template": "Ask Home Assistant: {0}",
      "handler": "actions.ask_assist",
      "id": "home_assistant_ask_assist",
      "method": "POST",
      "mock_response": {
        "conversation_id": "01JB9X",
        "reply": "Turned off the kitchen lights",
        "response_type": "action_done"
      },
      "name": "ask_assist",
      "output_formatter": "actions.format_assist",
      "parameters": [
        {
          "description": "What to say, as you would to Assist.",
          "display_name": "Say",
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The language it's in, such as en or de. Defaults to the server's.",
          "display_name": "Language",
          "name": "language",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/home-assistant/ask-assist",
      "result_str_template": "Assist: {home_assistant_ask_assist,reply}",
      "returns": {
        "properties": {
          "conversation_id": {
            "description": "The conversation, to continue it",
            "type": "string"
          },
          "reply": {
            "description": "What Assist answered",
            "type": "string"
          },
          "response_type": {
            "description": "action_done, query_answer or error",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "call_action": {
      "description": "Run any Home Assistant action, such as setting a thermostat or locking a door, with its data.",
      "display_name": "Run action",
      "display_str_template": "Run {0} in Home Assistant.",
      "handler": "actions.call_action",
      "id": "home_assistant_call_action",
      "method": "POST",
      "mock_response": {
        "action": "climate.set_temperature",
        "changed": [],
        "response": {}
      },
      "name": "call_action",
      "output_formatter": "actions.format_action",
      "parameters": [
        {
          "description": "The action to run, such as climate.set_temperature.",
          "display_name": "Action",
          "dynamic_source": "actions",
          "dynamic_source_allows_custom": true,
          "name": "action_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The entities to run it on, if it takes any.",
          "display_name": "Entities",
          "dynamic_source": "entities",
          "dynamic_source_allows_custom": true,
          "multi_select": true,
          "name": "entity",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The action's fields and values, such as temperature: 21.",
          "display_name": "Data",
          "name": "data",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "default": false,
          "description": "Return the data the action answers with, for actions that give one, such as weather.get_forecasts.",
          "display_name": "Return its answer",
          "name": "return_response",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/home-assistant/call-action",
      "result_str_template": "Ran {home_assistant_call_action,action}.",
      "returns": {
        "properties": {
          "action": {
            "description": "The action that ran",
            "type": "string"
          },
          "changed": {
            "description": "The entities whose state changed",
            "items": {
              "description": "An entity",
              "properties": {
                "attributes": {
                  "additionalProperties": true,
                  "description": "Its attributes, such as brightness or battery level",
                  "type": "object"
                },
                "entity_id": {
                  "description": "The entity's ID, such as light.kitchen",
                  "type": "string"
                },
                "last_changed": {
                  "description": "When its state last changed (ISO 8601)",
                  "type": "string"
                },
                "last_updated": {
                  "description": "When it was last updated (ISO 8601)",
                  "type": "string"
                },
                "name": {
                  "description": "Its name",
                  "type": "string"
                },
                "state": {
                  "description": "Its state, such as on, off, 21.5 or home",
                  "type": "string"
                },
                "unit": {
                  "description": "The state's unit, such as \u00b0C, if it has one",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "response": {
            "additionalProperties": true,
            "description": "What the action answered, when asked to return it",
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
