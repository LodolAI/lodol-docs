    "upload_file": {
      "description": "Upload a file to a SharePoint document library.",
      "display_name": "Upload file",
      "display_str_template": "Upload file '{1}' to SharePoint",
      "handler": "actions.upload_file",
      "id": "microsoft_sharepoint_upload_file",
      "method": "POST",
      "mock_response": {
        "id": "file123",
        "name": "file.txt",
        "webUrl": "https://..."
      },
      "name": "upload_file",
      "parameters": [
        {
          "description": "The web address of your SharePoint site (for example, contoso.sharepoint.com).",
          "display_name": "Site ID",
          "name": "site_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The file to upload. Use a file from an earlier step in your workflow.",
          "display_name": "File",
          "name": "file_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional folder in the site's document library to upload into (for example, Reports/2026).",
          "display_name": "Folder path",
          "name": "folder_path",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to do if a file with the same name already exists: rename, replace, or fail.",
          "display_name": "Conflict behavior",
          "name": "conflict_behavior",
          "required": false,
          "type": "ParameterType.STRING"
