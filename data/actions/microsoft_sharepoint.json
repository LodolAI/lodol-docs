  "description": "Manage SharePoint lists and files: create lists, add and update list items, upload files and search sites for files.",
  "display_name": "Microsoft SharePoint",
  "id": "microsoft_sharepoint",
  "logo": "https://www.lodol.com/app-icons/microsoft-sharepoint-icon.png",
  "triggers": {
    "microsoft_sharepoint_list_item_changed_trigger": {
      "description": "Runs each time an item is added to a SharePoint list or changed, with its columns as they are now. Changes made before the workflow is turned on don't start it.",
      "display_name": "New or updated list item",
      "id": "microsoft_sharepoint_list_item_changed_trigger",
      "output": {
        "created_at": "When it was added.",
        "created_by": "Who added it.",
        "fields": "The item's columns, by their internal names, such as Title.",
        "id": "The item's ID in the list.",
        "list_id": "The list watched, as it was given.",
        "modified_at": "When it was last changed.",
        "modified_by": "Who last changed it.",
        "site_id": "The site watched, as it was given.",
        "webUrl": "The item's page in SharePoint."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The web address of your SharePoint site (for example, contoso.sharepoint.com/sites/clerk).",
          "display_name": "Site",
          "name": "site_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "The ID of the SharePoint list to watch for new and changed items. 'List lists' gives each list's ID.",
          "display_name": "List",
          "name": "list_id",
          "required": true
        }
      ]
    },
    "microsoft_sharepoint_new_list_item_trigger": {
      "description": "Runs for each item added to a SharePoint list, with its columns. Items already in the list when the workflow is turned on don't start it.",
      "display_name": "New list item",
      "id": "microsoft_sharepoint_new_list_item_trigger",
      "output": {
        "created_at": "When it was added.",
        "created_by": "Who added it.",
        "fields": "The item's columns, by their internal names, such as Title.",
        "id": "The item's ID in the list.",
        "list_id": "The list watched, as it was given.",
        "modified_at": "When it was last changed.",
        "modified_by": "Who last changed it.",
        "site_id": "The site watched, as it was given.",
        "webUrl": "The item's page in SharePoint."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The web address of your SharePoint site (for example, contoso.sharepoint.com/sites/clerk).",
          "display_name": "Site",
          "name": "site_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "The ID of the SharePoint list to watch for new items. 'List lists' gives each list's ID.",
          "display_name": "List",
          "name": "list_id",
          "required": true
        }
      ]
    }
  }
