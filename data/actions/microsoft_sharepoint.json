{
  "actions": {
    "add_list_item": {
      "description": "Add a new item to a SharePoint list.",
      "display_name": "Add list item",
      "display_str_template": "Add item to list {1}.",
      "handler": "actions.add_list_item",
      "id": "microsoft_sharepoint_add_list_item",
      "method": "POST",
      "mock_response": {
        "fields": {},
        "id": "item123"
      },
      "name": "add_list_item",
      "parameters": [
        {
          "description": "The web address of your SharePoint site (for example, contoso.sharepoint.com).",
          "display_name": "Site ID",
          "name": "site_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The SharePoint list ID.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The column values for the new item. A basic list only has a 'Title' column; custom columns must be added to the list before they can be used.",
          "display_name": "Fields",
          "name": "fields",
          "required": true,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/microsoft-sharepoint/add-list-item",
      "result_str_template": "Item added.",
      "returns": {
        "properties": {
          "fields": {
            "description": "Item fields.",
            "type": "object"
          },
          "id": {
            "description": "Item ID.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_list": {
      "description": "Create a new SharePoint list in a site.",
      "display_name": "Create list",
      "display_str_template": "Create list '{1}' in site {0}.",
      "handler": "actions.create_list",
      "id": "microsoft_sharepoint_create_list",
      "method": "POST",
      "mock_response": {
        "displayName": "New List",
        "id": "list123"
      },
      "name": "create_list",
      "parameters": [
        {
          "description": "The web address of your SharePoint site (for example, contoso.sharepoint.com).",
          "display_name": "Site ID",
          "name": "site_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name for the list.",
          "display_name": "List name",
          "name": "list_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional list description.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional type of list to create, such as genericList or documentLibrary.",
          "display_name": "Template",
          "name": "template",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-sharepoint/create-list",
      "result_str_template": "List created.",
      "returns": {
        "properties": {
          "displayName": {
            "description": "List name.",
            "type": "string"
          },
          "id": {
            "description": "List ID.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_list_item": {
      "description": "Delete an item from a SharePoint list.",
      "display_name": "Delete list item",
      "display_str_template": "Delete item {2} from list {1}.",
      "handler": "actions.delete_list_item",
      "id": "microsoft_sharepoint_delete_list_item",
      "method": "POST",
      "mock_response": {
        "deleted": true
      },
      "name": "delete_list_item",
      "parameters": [
        {
          "description": "The web address of your SharePoint site (for example, contoso.sharepoint.com).",
          "display_name": "Site ID",
          "name": "site_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The SharePoint list ID.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The item ID to delete.",
          "display_name": "Item ID",
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-sharepoint/delete-list-item",
      "result_str_template": "Item deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Whether deletion succeeded.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "get_list_items": {
      "description": "Get items from a SharePoint list.",
      "display_name": "Get list items",
      "display_str_template": "Get items from list {1}.",
      "handler": "actions.get_list_items",
      "id": "microsoft_sharepoint_get_list_items",
      "method": "POST",
      "mock_response": {
        "value": [
          {
            "id": "item1"
          }
        ]
      },
      "name": "get_list_items",
      "parameters": [
        {
          "description": "The web address of your SharePoint site (for example, contoso.sharepoint.com).",
          "display_name": "Site ID",
          "name": "site_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The SharePoint list ID.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional limit for the number of items to return.",
          "display_name": "Maximum items",
          "name": "top",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional filter to narrow the results, written as an OData $filter (for example, fields/Title eq 'Invoice').",
          "display_name": "Filter query",
          "name": "filter_query",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-sharepoint/get-list-items",
      "result_str_template": "Items retrieved.",
      "returns": {
        "properties": {
          "value": {
            "description": "List of items.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "search_files": {
      "description": "Find the files in the SharePoint sites you name that contain some words, most relevant first, as Microsoft Search finds them. Only those sites are searched, never anyone's OneDrive.",
      "display_name": "Search files",
      "display_str_template": "Search {sites} for {query}",
      "handler": "actions.search_files",
      "id": "microsoft_sharepoint_search_files",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "files": [
          {
            "drive_id": "b!drive",
            "id": "01ABC",
            "modified": "2026-03-14T16:02:11Z",
            "modified_by": "Sam Ortiz",
            "name": "Incident 26-0412.pdf",
            "site": "https://springfield.sharepoint.com/sites/Police",
            "size": 482113,
            "summary": "Incident at 4th Street on March 12...",
            "web_url": "https://springfield.sharepoint.com/sites/Police/Shared%20Documents/Incident%2026-0412.pdf"
          }
        ],
        "total": 1
      },
      "name": "search_files",
      "output_formatter": "actions.format_search_files_output",
      "parameters": [
        {
          "description": "What the files should contain, such as 4th Street incident March 2026. Every word has to be in a file for it to be found.",
          "display_name": "Words to find",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The address of each SharePoint site to search, separated by commas, such as springfield.sharepoint.com/sites/Police. Up to 20.",
          "display_name": "Sites to search",
          "name": "sites",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many files to hand back, from 1 to 50. 50 if left blank.",
          "display_name": "Most files",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/microsoft-sharepoint/search-files",
      "result_str_template": "{microsoft_sharepoint_search_files,count} file(s) found",
      "returns": {
        "properties": {
          "count": {
            "description": "How many files are handed back.",
            "type": "number"
          },
          "files": {
            "description": "The files found, most relevant first.",
            "items": {
              "properties": {
                "drive_id": {
                  "description": "The library it is in, for later OneDrive steps.",
                  "type": "string"
                },
                "id": {
                  "description": "The file, for later OneDrive steps.",
                  "type": "string"
                },
                "modified": {
                  "description": "When it last changed.",
                  "type": "string"
                },
                "modified_by": {
                  "description": "Who last changed it.",
                  "type": "string"
                },
                "name": {
                  "description": "The file's name.",
                  "type": "string"
                },
                "site": {
                  "description": "The site it was found on.",
                  "type": "string"
                },
                "size": {
                  "description": "Its size, in bytes.",
                  "type": "number"
                },
                "summary": {
                  "description": "The words around what was found.",
                  "type": "string"
                },
                "web_url": {
                  "description": "Where to open it.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "How many Microsoft Search found in all.",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
