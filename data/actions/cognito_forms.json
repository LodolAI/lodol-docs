{
  "actions": {
    "create_entry": {
      "description": "Add an entry to a form from field values. The form's own notifications and rules apply as if someone had submitted it.",
      "display_name": "Create entry",
      "display_str_template": "Create an entry in Cognito Forms.",
      "handler": "actions.create_entry",
      "id": "cognito_forms_create_entry",
      "method": "POST",
      "mock_response": {
        "entry": {
          "Email": "jo@example.com",
          "Entry": {
            "Action": "Submit",
            "Number": 12,
            "Status": "Submitted"
          },
          "Id": "12",
          "Name": {
            "First": "Jo",
            "Last": "Bloggs"
          }
        },
        "entry_id": "12",
        "form": "1"
      },
      "name": "create_entry",
      "output_formatter": "actions.format_entry_output",
      "parameters": [
        {
          "description": "The form. Pick one, or give its id or internal name from an earlier step.",
          "display_name": "Form",
          "dynamic_source": "forms",
          "dynamic_source_allows_custom": true,
          "name": "form",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The entry's fields, keyed by the form's JSON field names (see 'Get form schema'), such as {\"Email\": \"jo@example.com\"}. Leave empty for a form with no required fields.",
          "display_name": "Field values",
          "name": "entry",
          "object_key_name": "Field name",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/cognito-forms/create-entry",
      "result_str_template": "Entry created.",
      "returns": {
        "properties": {
          "entry": {
            "description": "The entry, with the form's own fields named by their JSON names",
            "type": "object"
          },
          "entry_id": {
            "description": "The entry's id, to pass to the other entry steps",
            "type": "string"
          },
          "form": {
            "description": "The form the entry is in",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_entry": {
      "description": "Permanently delete an entry. Needs a key with the Read/Write/Delete entry scope.",
      "display_name": "Delete entry",
      "display_str_template": "Delete an entry in Cognito Forms.",
