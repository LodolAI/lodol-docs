    "get_entry_document": {
      "description": "Generate a document (such as a PDF) from an entry with one of the form's document templates, and return its details and a short-lived link to it.",
      "display_name": "Get entry document",
      "display_str_template": "Get an entry document in Cognito Forms.",
      "handler": "actions.get_entry_document",
      "id": "cognito_forms_get_entry_document",
      "method": "POST",
      "mock_response": {
        "document": {
          "content_base64": "JVBERi0=",
          "content_type": "application/pdf",
          "id": "f_01HXAMPLE",
          "name": "agreement.pdf",
          "size": 20480,
          "url": "https://www.cognitoforms.com/d/EXAMPLE"
        },
        "entry_id": "12",
        "form": "1",
        "template_number": 1
      },
      "name": "get_entry_document",
      "output_formatter": "actions.format_document_output",
      "parameters": [
        {
          "description": "The form. Pick one, or give its id or internal name from an earlier step.",
          "display_name": "Form",
          "dynamic_source": "forms",
          "dynamic_source_allows_custom": true,
          "name": "form",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The entry's number (such as 12) or entry id, from 'Create entry' or an earlier step.",
          "display_name": "Entry",
          "name": "entry_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The template's ID, shown at the top right of its entry in the form's Manage Document Templates dialog (1 for the first).",
          "display_name": "Template number",
          "maximum": 1000,
          "minimum": 1,
          "name": "template_number",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": false,
          "description": "Also return the file itself as base64 text. Off by default, because files can be large; the short-lived link is always returned.",
          "display_name": "Include the file's content",
          "name": "include_content",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/cognito-forms/get-entry-document",
      "result_str_template": "Document generated.",
      "returns": {
        "properties": {
          "document": {
            "description": "The generated document",
            "properties": {
              "content_base64": {
                "description": "The file's content as base64, only when asked for",
                "type": "string"
              },
              "content_type": {
                "description": "The file's media type",
                "type": "string"
              },
              "id": {
                "description": "The file's id",
                "type": "string"
              },
              "name": {
                "description": "The file's name",
                "type": "string"
              },
              "size": {
                "description": "The file's size in bytes",
                "type": "number"
              },
              "url": {
                "description": "A short-lived link to the file",
                "type": "string"
              }
            },
            "type": "object"
          },
          "entry_id": {
            "description": "The entry",
            "type": "string"
          },
          "form": {
            "description": "The form",
            "type": "string"
          },
          "template_number": {
            "description": "The template used",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
