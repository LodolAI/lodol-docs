          "description": "The form. Pick one, or give its id or internal name from an earlier step.",
          "display_name": "Form",
          "dynamic_source": "forms",
          "dynamic_source_allows_custom": true,
          "name": "form",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The entry's number (such as 12) or entry id, from 'Create entry' or an earlier step.",
          "display_name": "Entry",
          "name": "entry_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
