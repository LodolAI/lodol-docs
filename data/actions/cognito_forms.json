    "upload_file": {
      "description": "Upload a file (up to 10 MB) to Cognito Forms so an entry's file field can use it. Cognito Forms has no way to delete it afterwards.",
      "display_name": "Upload file",
      "display_str_template": "Upload a file to Cognito Forms.",
      "handler": "actions.upload_file",
      "id": "cognito_forms_upload_file",
