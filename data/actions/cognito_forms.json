    "get_form_schema": {
      "description": "Get a form's schema (Swagger JSON): every field's JSON name and type. Use it to see which fields 'Create entry' and 'Update entry' take.",
      "display_name": "Get form schema",
      "display_str_template": "Get the schema of a form in Cognito Forms.",
      "handler": "actions.get_form_schema",
      "id": "cognito_forms_get_form_schema",
      "method": "POST",
      "mock_response": {
        "form": "1",
        "schema": {
          "definitions": {
            "ContactUs": {}
          },
          "swagger": "2.0"
        }
      },
      "name": "get_form_schema",
      "output_formatter": "actions.format_schema_output",
      "parameters": [
        {
          "description": "The form. Pick one, or give its id or internal name from an earlier step.",
          "display_name": "Form",
          "dynamic_source": "forms",
          "dynamic_source_allows_custom": true,
          "name": "form",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Leave out read-only fields such as the entry number.",
          "display_name": "Only fields you can set",
          "name": "input_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": true,
          "description": "Include the link fields for uploaded files, signatures and entry documents.",
          "display_name": "Include file and document links",
          "name": "include_links",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/cognito-forms/get-form-schema",
      "result_str_template": "Schema retrieved.",
      "returns": {
        "properties": {
          "form": {
            "description": "The form asked about",
            "type": "string"
          },
          "schema": {
            "description": "The form's Swagger schema, with its fields",
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
