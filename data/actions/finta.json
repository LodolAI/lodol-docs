          "name": "date",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/finta/get-balance-sheet",
      "result_str_template": "Retrieved Finta balance sheet.",
      "returns": {
        "description": "Point-in-time balance sheet. 'balance_cents' (NOT 'amount_cents') is the per-row cumulative balance at the report date. assets.total_cents should equal liabilities_and_equity_cents (the accounting equation).",
        "properties": {
          "assets": {
            "description": "Asset section.",
            "properties": {
              "categories": {
                "items": {
