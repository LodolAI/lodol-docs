                    },
                    "name": {
                      "type": "string"
                    },
                    "parent_category_id": {
                      "type": "string"
                    },
                    "position": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "total_cents": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "cash_cents": {
            "description": "Convenience copy of the Cash entry inside assets.categories.",
            "type": "integer"
          },
          "currency": {
            "description": "ISO 4217 code.",
            "type": "string"
          },
          "date": {
            "description": "As-of date (YYYY-MM-DD).",
            "type": "string"
          },
          "equity": {
            "description": "Equity section including retained earnings subtotal.",
            "properties": {
              "categories": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "retained_earnings": {
                "properties": {
                  "beginning_balance_cents": {
                    "description": "Retained earnings at the start of the current fiscal year.",
                    "type": "integer"
                  },
                  "ending_balance_cents": {
                    "description": "beginning + net income.",
                    "type": "integer"
                  },
                  "net_income_cents": {
                    "description": "Net income YTD through the report date.",
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "total_cents": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "liabilities": {
            "description": "Liabilities section.",
            "properties": {
              "categories": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "total_cents": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "liabilities_and_equity_cents": {
            "description": "Sum of liabilities + equity; should equal assets.total_cents.",
            "type": "integer"
          },
          "object": {
            "description": "Always 'balance_sheet'.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
