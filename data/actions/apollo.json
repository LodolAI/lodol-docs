        {
          "description": "Full name of the person",
          "display_name": "Name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the person's employer",
          "display_name": "Organization name",
          "name": "organization_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Domain of the person's employer (e.g. apollo.io)",
          "display_name": "Domain",
          "name": "domain",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Set to true to include the person's personal email addresses. This uses Apollo credits.",
          "display_name": "Reveal personal emails",
          "name": "reveal_personal_emails",
