{
  "actions": {
    "add_contacts_to_sequence": {
      "description": "Add saved contacts to an Apollo sequence, sending from one of your linked mailboxes, so its emails start going out. Apollo skips anyone it won't email and says why. Uses no credits.",
      "display_name": "Add contacts to sequence",
      "display_str_template": "Add {1} to sequence {0}.",
      "handler": "actions.add_contacts_to_sequence",
      "id": "apollo_add_contacts_to_sequence",
      "method": "POST",
      "mock_response": {
        "added": [
          {
            "email": "tim@apollo.io",
            "id": "66e34b81740c50074e3d1bd4",
            "name": "Tim Zheng"
          }
        ],
        "added_count": 1,
        "sequence_id": "66e9e215ece19801b219997f",
        "sequence_name": "New trial follow-up",
        "skipped": [
          {
            "id": "66e34b81740c50074e3d1bd5",
            "reason": "contact_not_found_or_has_no_email"
          }
        ],
        "skipped_count": 1
      },
      "name": "add_contacts_to_sequence",
      "parameters": [
        {
          "description": "The sequence to add the contacts to",
          "display_name": "Sequence",
          "dynamic_source": "sequences",
          "dynamic_source_allows_custom": true,
          "name": "sequence_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The contacts to add, from 'Search contacts' or 'Create contact' (up to 100)",
          "display_name": "Contact IDs",
          "name": "contact_ids",
          "required": true,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The linked mailbox the sequence's emails come from",
          "display_name": "Send from",
          "dynamic_source": "email_accounts",
          "dynamic_source_allows_custom": true,
          "name": "email_account_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Also add contacts who are active in another sequence. Off by default, so no one gets two cadences at once.",
          "display_name": "Include people in other sequences",
          "name": "include_contacts_in_other_sequences",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/apollo/add-contacts-to-sequence",
      "result_str_template": "Contacts added to the sequence.",
      "returns": {
        "properties": {
          "added": {
            "description": "The contacts added: id, name and email",
            "items": {
              "properties": {
                "email": {
                  "description": "Their email address",
                  "type": "string"
                },
                "id": {
                  "description": "The contact's ID",
                  "type": "string"
                },
                "name": {
                  "description": "Their name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "added_count": {
            "description": "How many were added",
            "type": "number"
          },
          "sequence_id": {
            "description": "The sequence",
            "type": "string"
          },
          "sequence_name": {
            "description": "The sequence's name",
            "type": "string"
          },
          "skipped": {
            "description": "The contacts Apollo skipped, and why",
            "items": {
              "properties": {
                "id": {
                  "description": "The contact's ID",
                  "type": "string"
                },
                "reason": {
                  "description": "Why Apollo skipped them",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "skipped_count": {
            "description": "How many were skipped",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
