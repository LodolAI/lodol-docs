    "search_contacts": {
      "description": "Search the contacts that already exist in your Apollo account.",
      "display_name": "Search contacts",
      "display_str_template": "Search Apollo contacts for '{0}'",
      "handler": "actions.search_contacts",
      "id": "apollo_search_contacts",
      "method": "POST",
      "mock_response": {
        "contacts": [],
        "pagination": {}
      },
      "name": "search_contacts",
      "parameters": [
        {
          "description": "Keywords to search for, such as a name or company",
          "display_name": "Keywords",
          "name": "q_keywords",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Page number (starts at 1)",
          "display_name": "Page",
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Results per page (1-100)",
          "display_name": "Per page",
          "name": "per_page",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/apollo/search-contacts",
