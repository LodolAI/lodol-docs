{
  "actions": {
    "create_account": {
      "description": "Add a new account (a company your team is tracking) to your Apollo account.",
      "display_name": "Create account",
      "display_str_template": "Create Apollo account {0}",
      "handler": "actions.create_account",
      "id": "apollo_create_account",
      "method": "POST",
      "mock_response": {
        "account": {}
      },
      "name": "create_account",
      "parameters": [
        {
          "description": "Name of the company",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Domain of the company (e.g. apollo.io)",
          "display_name": "Domain",
          "name": "domain",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Primary phone number for the company",
          "display_name": "Phone",
          "name": "phone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Company address, written as ordinary text",
          "display_name": "Address",
          "name": "raw_address",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/apollo/create-account",
      "result_str_template": "Account created.",
      "returns": {
        "type": "object"
      }
    },
    "create_contact": {
      "description": "Add a new contact to your team's Apollo account.",
      "display_name": "Create contact",
      "display_str_template": "Create Apollo contact {0} {1}",
      "handler": "actions.create_contact",
      "id": "apollo_create_contact",
      "method": "POST",
      "mock_response": {
        "contact": {}
      },
      "name": "create_contact",
      "parameters": [
        {
          "description": "First name of the contact",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name of the contact",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email address of the contact",
          "display_name": "Email",
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Job title of the contact",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the contact's employer",
          "display_name": "Organization name",
          "name": "organization_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the Apollo account (company) to link the contact to",
          "display_name": "Account ID",
          "name": "account_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Website URL of the contact's employer",
          "display_name": "Website URL",
          "name": "website_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Names of the Apollo lists to add the contact to",
          "display_name": "List names",
          "name": "label_names",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/apollo/create-contact",
      "result_str_template": "Contact created.",
      "returns": {
        "type": "object"
      }
    },
    "enrich_organization": {
