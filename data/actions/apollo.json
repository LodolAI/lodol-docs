    "enrich_person": {
      "description": "Enrich a single person with Apollo data such as title, company, and (optionally) personal email addresses.",
      "display_name": "Enrich person",
      "display_str_template": "Enrich Apollo person {0}",
      "handler": "actions.enrich_person",
      "id": "apollo_enrich_person",
      "method": "POST",
      "mock_response": {
        "person": {}
      },
      "name": "enrich_person",
      "parameters": [
        {
          "description": "Email address of the person",
          "display_name": "Email",
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "First name of the person",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name of the person",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
