  "logo": "https://www.lodol.com/app-icons/scoreapp-icon.png",
  "triggers": {
    "scoreapp_finished_result_trigger": {
      "description": "Runs each time a quiz is finished in ScoreApp. Ones finished before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Quiz finished",
      "id": "scoreapp_finished_result_trigger",
      "output": {
        "record": "object with the fields id, key, purchased, first_name, last_name, email, status, created_at"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Scorecard ID.",
          "display_name": "Scorecard ID",
          "name": "scorecard_id",
          "required": true
        }
      ]
    },
    "scoreapp_new_result_trigger": {
      "description": "Runs each time a quiz is started in ScoreApp. Ones started before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Quiz started",
      "id": "scoreapp_new_result_trigger",
      "output": {
        "record": "object with the fields id, key, purchased, first_name, last_name, email, status, created_at"
      },
      "parameters": [
