{
  "actions": {
    "add_transaction": {
      "description": "Record an expense, income or a transfer between your accounts.",
      "display_name": "Add transaction",
      "display_str_template": "Record {2} in Firefly III.",
      "handler": "actions.add_transaction",
      "id": "firefly_iii_add_transaction",
      "method": "POST",
      "mock_response": {
        "amount": 42.5,
        "budget": "Food",
        "category": "Groceries",
        "currency_code": "EUR",
        "date": "2026-10-28",
        "description": "Weekly groceries",
        "destination": "Albert Heijn",
        "id": "1842",
        "journal_id": "1903",
        "link": "https://firefly.example.com/transactions/show/1842",
        "notes": "",
        "source": "Checking account",
        "splits": 1,
        "tags": [
          "family"
        ],
        "type": "withdrawal"
      },
      "name": "add_transaction",
      "output_formatter": "actions.format_transaction",
      "parameters": [
        {
          "default": "withdrawal",
          "description": "An expense, income, or a transfer between your accounts. Defaults to an expense.",
          "display_name": "Kind",
          "name": "transaction_type",
          "options": [
            {
              "label": "Expense",
              "value": "withdrawal"
            },
            {
              "label": "Income",
              "value": "deposit"
            },
            {
              "label": "Transfer between your accounts",
              "value": "transfer"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How much, such as 42.50, without a minus sign.",
          "display_name": "Amount",
          "name": "amount",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What it was for, such as Weekly groceries.",
          "display_name": "Description",
          "name": "description",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The account it's paid from, paid into, or for a transfer, moved from.",
          "display_name": "Your account",
          "dynamic_source": "accounts",
          "dynamic_source_allows_custom": true,
          "name": "account",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Who was paid, or who paid you, such as a shop. For a transfer, your account it moves to. Blank leaves it as cash.",
          "display_name": "Paid to or received from",
          "name": "other_party",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When it happened. Defaults to today.",
          "display_name": "Date",
          "name": "transaction_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "A category, such as Groceries. A new name makes a new category.",
          "display_name": "Category",
          "dynamic_source": "categories",
          "dynamic_source_allows_custom": true,
          "name": "category",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "For an expense, the budget it comes out of.",
          "display_name": "Budget",
          "dynamic_source": "budgets",
          "dynamic_source_allows_custom": true,
          "name": "budget",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Tags, such as holiday-2026.",
          "display_name": "Tags",
          "name": "tags",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Notes kept with it.",
          "display_name": "Notes",
          "multiline": true,
          "name": "notes",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/firefly-iii/add-transaction",
      "result_str_template": "Transaction recorded.",
      "returns": {
        "properties": {
          "amount": {
            "description": "How much",
            "type": "number"
          },
          "budget": {
            "description": "The budget it came out of",
            "type": "string"
          },
          "category": {
            "description": "Its category",
            "type": "string"
          },
          "currency_code": {
            "description": "The currency, such as EUR",
            "type": "string"
          },
          "date": {
            "description": "Its date (YYYY-MM-DD)",
            "type": "string"
          },
          "description": {
            "description": "What it was for",
            "type": "string"
          },
          "destination": {
            "description": "Where it went",
            "type": "string"
          },
          "id": {
            "description": "The transaction's number",
            "type": "string"
          },
          "journal_id": {
            "description": "Its journal number, inside Firefly III",
            "type": "string"
          },
          "link": {
            "description": "A link to it in Firefly III",
            "type": "string"
          },
          "notes": {
            "description": "Its notes",
            "type": "string"
          },
          "source": {
            "description": "Where the money came from",
            "type": "string"
          },
          "splits": {
            "description": "How many parts it's split in; usually 1",
            "type": "number"
          },
          "tags": {
            "description": "Its tags",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "withdrawal, deposit or transfer",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
