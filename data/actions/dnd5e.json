{
  "actions": {
    "get_dnd5eapi_class_level": {
      "description": "Get a class's features, proficiency bonus, ability score improvements, and spell slots at a specific level (1 to 20).",
      "display_name": "Get class level details (D&D 5e API)",
      "display_str_template": "Get D&D 5e {class_index} level {level}.",
      "handler": "actions.get_dnd5eapi_class_level",
      "id": "dnd5e_get_class_level",
      "method": "POST",
      "mock_response": {
        "ability_score_bonuses": 0,
        "class": {
          "index": "wizard",
          "name": "Wizard"
        },
        "features": [
          {
            "index": "spellcasting-wizard",
            "name": "Spellcasting: Wizard",
            "url": "/api/2014/features/spellcasting-wizard"
          },
          {
            "index": "arcane-recovery",
            "name": "Arcane Recovery",
            "url": "/api/2014/features/arcane-recovery"
          }
        ],
        "index": "wizard-1",
        "level": 1,
        "prof_bonus": 2,
        "spellcasting": {
          "cantrips_known": 3,
          "spell_slots_level_1": 2
        },
        "url": "/api/2014/classes/wizard/levels/1"
      },
      "name": "get_dnd5eapi_class_level",
      "parameters": [
        {
          "default": "2014",
          "description": "Which SRD ruleset to read: 2014 (SRD 5.1, the most complete set) or 2024 (SRD 5.2). Defaults to 2014.",
          "display_name": "Ruleset version",
          "name": "version",
          "options": [
            {
              "label": "2014 (SRD 5.1)",
              "value": "2014"
            },
            {
              "label": "2024 (SRD 5.2)",
              "value": "2024"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The class to look up (for example wizard or fighter).",
          "display_name": "Class",
          "dynamic_source": "dnd5e_classes",
          "dynamic_source_depends_on": [
            "version"
          ],
          "name": "class_index",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The class level, 1 through 20.",
          "display_name": "Class level",
          "maximum": 20,
          "minimum": 1,
          "name": "level",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/dnd5e/get-class-level",
      "result_str_template": "Class level details retrieved.",
      "returns": {
        "properties": {
          "features": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "level": {
            "type": "integer"
          },
          "prof_bonus": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
