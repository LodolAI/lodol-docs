{
  "actions": {
    "engagement_overview": {
      "description": "See daily totals for users, page views, and time spent on your site over a date range.",
      "display_name": "Get engagement overview",
      "display_str_template": "Get engagement overview for property '{0}' from {1} to {2}.",
      "handler": "actions.engagement_overview",
      "id": "google_analytics_engagement_overview",
      "method": "POST",
      "mock_response": {
        "metadata": {
          "dimensions": [
            "date"
          ],
          "metrics": [
            "totalUsers",
            "screenPageViews",
            "userEngagementDuration"
          ]
        },
        "rowCount": 7,
        "rows": [
          {
            "date": "20240115",
            "screenPageViews": "5000",
            "totalUsers": "1000",
            "userEngagementDuration": "36000"
          }
        ]
      },
      "name": "engagement_overview",
      "parameters": [
        {
          "description": "Your Google Analytics 4 property ID, for example 123456789. You can find it in Google Analytics under Admin > Property Settings.",
          "display_name": "Property ID",
          "name": "property_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The first day to include. Use a calendar date like 2024-01-01, or a relative value like 7daysAgo, yesterday, or today.",
          "display_name": "Start date",
          "examples": [
            {
              "label": "Last 7 days",
              "value": "7daysAgo"
            },
            {
              "label": "Last 30 days",
              "value": "30daysAgo"
            },
            {
              "label": "Last 90 days",
              "value": "90daysAgo"
            }
          ],
          "name": "start_date",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The last day to include. Use a calendar date like 2024-01-31, or a relative value like today or yesterday.",
          "display_name": "End date",
          "examples": [
            {
              "label": "Today",
              "value": "today"
            },
            {
              "label": "Yesterday",
              "value": "yesterday"
            }
          ],
          "name": "end_date",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-analytics/engagement-overview",
      "result_str_template": "Returned engagement overview for property {0}.",
      "returns": {
        "properties": {
          "metadata": {
            "description": "The dimension and metric names that make up the columns.",
            "properties": {
              "dimensions": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "metrics": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "rowCount": {
            "description": "Total number of rows that matched the report.",
            "type": "integer"
          },
          "rows": {
            "description": "The report data, one object per row.",
            "items": {
              "type": "object"
