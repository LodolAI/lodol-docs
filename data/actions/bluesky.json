{
  "actions": {
    "create_post": {
      "description": "Publish a text post to your Bluesky account.",
      "display_name": "Create a post",
      "display_str_template": "Post to Bluesky.",
      "handler": "actions.create_post",
      "id": "bluesky_create_post",
      "method": "POST",
      "mock_response": {
        "cid": "bafyreicnt42y6vo6pfpvyro234ac4o6ijug6adwwrh7awflgrqlt4zibxq",
