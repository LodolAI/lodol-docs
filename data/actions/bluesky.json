      },
      "name": "create_post",
      "parameters": [
        {
          "description": "What to post. Bluesky allows up to 300 characters.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/bluesky/create-post",
      "result_str_template": "Posted to Bluesky.",
      "returns": {
        "properties": {
          "cid": {
            "description": "Content hash of the created post",
            "type": "string"
          },
          "uri": {
            "description": "The new post's at:// URI. Use with Delete a post.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_post": {
      "description": "Delete one of your own Bluesky posts.",
      "display_name": "Delete a post",
      "display_str_template": "Delete Bluesky post '{0}'.",
      "handler": "actions.delete_post",
      "id": "bluesky_delete_post",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "uri": "at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.feed.post/3l6oveex3ii2l"
      },
      "name": "delete_post",
      "parameters": [
        {
          "description": "The at:// URI of the post to delete, as returned by Create a post.",
          "display_name": "Post URI",
          "name": "uri",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/bluesky/delete-post",
      "result_str_template": "Bluesky post deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Whether the post was deleted",
            "type": "boolean"
          },
          "uri": {
            "description": "The post that was deleted",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
