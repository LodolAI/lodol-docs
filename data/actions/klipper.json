  ],
  "description": "Monitor a Klipper 3D printer through its Moonraker server.",
  "display_name": "Klipper",
  "id": "klipper",
  "logo": "https://www.lodol.com/app-icons/klipper-icon.png",
  "triggers": {
    "klipper_new_print_job_trigger": {
      "description": "Runs for each new print job in Klipper. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New print job",
      "id": "klipper_new_print_job_trigger",
      "output": {
        "record": "object with the fields job_id, filename, status, print_duration"
      },
      "parameters": []
    },
    "klipper_print_status_changed_trigger": {
      "description": "Runs each time a print job status changes in Klipper. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Print job status changed",
      "id": "klipper_print_status_changed_trigger",
      "output": {
        "record": "object with the fields job_id, filename, status, print_duration"
      },
      "parameters": []
    }
  }
}
