{
  "actions": {
    "create_image": {
      "description": "Generate an image from a Placid template, filling in its layers. Returns the image URL once it's ready.",
      "display_name": "Create image",
      "display_str_template": "Create a Placid image from a template.",
      "handler": "actions.create_image",
      "id": "placid_create_image",
      "method": "POST",
      "mock_response": {
        "id": 1,
        "imageUrl": "https://placid.app/u/generated-image.png",
        "pollingUrl": "https://api.placid.app/api/rest/images/1",
        "status": "finished"
      },
      "name": "create_image",
      "parameters": [
        {
          "description": "The Placid template to generate from.",
          "display_name": "Template",
          "dynamic_source": "templates",
          "name": "template_uuid",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The content for each of the template's layers. Text layers take text; picture layers take an image URL. Leave a layer blank to keep the template's default.",
          "display_name": "Layers",
          "dynamic_source": "template_layers",
          "dynamic_source_depends_on": [
            "template_uuid"
          ],
          "name": "layers",
          "required": true,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/placid/create-image",
      "result_str_template": "Image requested.",
      "returns": {
        "properties": {
          "id": {
            "description": "The image's ID (use it to poll).",
            "type": "number"
          },
          "imageUrl": {
            "description": "URL of the finished image, or empty while queued.",
            "type": "string"
          },
          "pollingUrl": {
            "description": "URL to check the image's status.",
            "type": "string"
          },
          "status": {
            "description": "'queued', 'finished', or 'error'.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
