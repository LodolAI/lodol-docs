  "description": "Read and file 311 service requests with any city on Open311 (GeoReport v2): list service types and their questions, find and read requests by type, status and date, file new ones, and run when a request comes in or is closed.",
  "display_name": "Open311",
  "id": "open311",
  "logo": "https://www.lodol.com/app-icons/open311-icon.png",
  "triggers": {
    "open311_new_service_request_trigger": {
      "description": "Runs when a new 311 service request appears on the city's Open311 endpoint, with its type, description, address, status and location. Optionally only one service type.",
      "display_name": "New service request",
      "id": "open311_new_service_request_trigger",
      "output": {
        "address": "The address reported",
        "address_id": "The city's id for the address",
        "agency_responsible": "The department handling it",
        "description": "What the person reported",
        "expected_datetime": "When the city expects to finish (ISO 8601)",
        "lat": "Latitude",
        "long": "Longitude",
        "media_url": "A photo of the problem",
        "requested_datetime": "When it was filed (ISO 8601)",
        "service_code": "The service type's code",
        "service_name": "The service type's name",
        "service_notice": "What the city says to expect",
        "service_request_id": "The request's id",
        "status": "open or closed",
        "status_notes": "The city's notes on the status",
        "token": "The token the request was filed under, where the city shows it",
        "updated_datetime": "When it last changed (ISO 8601)",
        "zipcode": "The ZIP or postal code"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only requests of this type. Leave blank for every type.",
          "display_name": "Service type",
          "name": "service_code",
          "required": false
        }
      ]
    },
    "open311_service_request_status_changed_trigger": {
      "description": "Runs when a service request the city filed recently is closed or reopened, with the city's status notes and the status before. Optionally only one service type, or only closings.",
      "display_name": "Service request status changed",
      "id": "open311_service_request_status_changed_trigger",
      "output": {
        "address": "The address reported",
        "address_id": "The city's id for the address",
        "agency_responsible": "The department handling it",
        "description": "What the person reported",
        "expected_datetime": "When the city expects to finish (ISO 8601)",
        "lat": "Latitude",
        "long": "Longitude",
        "media_url": "A photo of the problem",
        "previous_status": "The status before this change: open or closed",
        "requested_datetime": "When it was filed (ISO 8601)",
        "service_code": "The service type's code",
        "service_name": "The service type's name",
        "service_notice": "What the city says to expect",
        "service_request_id": "The request's id",
        "status": "open or closed",
        "status_notes": "The city's notes on the status",
        "token": "The token the request was filed under, where the city shows it",
        "updated_datetime": "When it last changed (ISO 8601)",
        "zipcode": "The ZIP or postal code"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only requests of this type. Leave blank for every type.",
          "display_name": "Service type",
          "name": "service_code",
          "required": false
        },
        {
          "arg_index": 1,
