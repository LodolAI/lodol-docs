{
  "actions": {
    "create_service_request": {
      "description": "File a new service request (a 311 report) with the city, at an address or a point, with answers to the service type's questions and a photo. Needs the city's API key.",
      "display_name": "File a service request",
      "display_str_template": "File a service request in Open311.",
      "handler": "actions.create_service_request",
      "id": "open311_create_service_request",
      "method": "POST",
      "mock_response": {
        "account_id": "",
        "filed": true,
        "service_notice": "The city will review this within 2 business days.",
        "service_request_id": "",
        "token": "9a4805cb-45e7-46d8-b8b7-04613bd57f3b"
      },
      "name": "create_service_request",
      "output_formatter": "_format_filed",
      "parameters": [
        {
          "description": "The type of request, such as a pothole or missed trash pickup.",
          "display_name": "Service type",
          "dynamic_source": "services",
          "dynamic_source_allows_custom": true,
          "name": "service_code",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What the problem is, in the reporter's words.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Where the problem is, such as 1 City Hall Square. Give an address, or a latitude and longitude, or both.",
          "display_name": "Address",
          "name": "address",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The latitude of the problem, such as 42.3601.",
          "display_name": "Latitude",
          "maximum": 90,
          "minimum": -90,
          "name": "latitude",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The longitude of the problem, such as -71.0589.",
          "display_name": "Longitude",
          "maximum": 180,
          "minimum": -180,
          "name": "longitude",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The extra questions the chosen service type asks, filled in for you once a service type is picked.",
          "display_name": "Answers to the service type's questions",
          "dynamic_source": "service_attributes",
          "dynamic_source_depends_on": [
            "service_code"
          ],
          "name": "attributes",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The https:// address of a photo of the problem.",
          "display_name": "Photo address",
          "name": "media_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The reporter's email address, for the city's updates.",
          "display_name": "Reporter email",
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The reporter's first name.",
          "display_name": "Reporter first name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The reporter's last name.",
          "display_name": "Reporter last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The reporter's phone number.",
          "display_name": "Reporter phone",
          "name": "phone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/open311/create-service-request",
      "result_str_template": "Service request filed.",
      "returns": {
        "properties": {
          "account_id": {
            "description": "The reporter's account with the city, if any",
            "type": "string"
          },
          "filed": {
            "description": "True once the city gave an id or a token",
            "type": "boolean"
          },
          "service_notice": {
            "description": "What the city says to expect",
            "type": "string"
          },
          "service_request_id": {
            "description": "The new request's id, empty while the city is still filing it",
            "type": "string"
          },
          "token": {
            "description": "A token to look the id up with later",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
