  "description": "Browse ShareFile folders, files, users, groups and permissions; create and manage folders and groups.",
  "display_name": "ShareFile",
  "id": "sharefile",
  "logo": "https://www.lodol.com/app-icons/sharefile-icon.ico",
  "triggers": {
    "sharefile_new_folder_item_trigger": {
      "description": "Runs for each new folder item in ShareFile. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New folder item",
      "id": "sharefile_new_folder_item_trigger",
      "output": {
        "record": "object with the fields Id, Name, Description, CreationDate, ProgenyEditDate, FileSizeBytes"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Item ID.",
          "display_name": "Item ID",
          "name": "item_id",
          "required": true
        }
      ]
    },
    "sharefile_new_group_trigger": {
      "description": "Runs for each new group in ShareFile. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New group",
      "id": "sharefile_new_group_trigger",
      "output": {
        "record": "object with the fields Id, Name"
      },
      "parameters": []
    },
    "sharefile_new_or_updated_folder_item_trigger": {
      "description": "Runs for each folder item added or changed in ShareFile. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated folder item",
      "id": "sharefile_new_or_updated_folder_item_trigger",
      "output": {
        "record": "object with the fields Id, Name, Description, CreationDate, ProgenyEditDate, FileSizeBytes"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Item ID.",
          "display_name": "Item ID",
          "name": "item_id",
          "required": true
        }
      ]
    },
    "sharefile_new_or_updated_group_trigger": {
      "description": "Runs for each group added or changed in ShareFile. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated group",
      "id": "sharefile_new_or_updated_group_trigger",
      "output": {
        "record": "object with the fields Id, Name"
      },
      "parameters": []
    },
    "sharefile_new_or_updated_user_trigger": {
      "description": "Runs for each user added or changed in ShareFile. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated user",
      "id": "sharefile_new_or_updated_user_trigger",
      "output": {
        "record": "object with the fields Id, FirstName, LastName, Email"
      },
      "parameters": []
    },
    "sharefile_new_user_trigger": {
      "description": "Runs for each new user in ShareFile. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New user",
      "id": "sharefile_new_user_trigger",
      "output": {
        "record": "object with the fields Id, FirstName, LastName, Email"
      },
      "parameters": []
    }
