    "search_by_common_name": {
      "description": "Find plants, animals and other organisms by a common name, in English, French, Spanish and the other languages ITIS records, e.g. 'blue jay' or 'monarch'. Each match carries the TSN to look the taxon up with. No API key required.",
      "display_name": "Search by common name",
      "display_str_template": "Search ITIS for the common name {0}.",
      "handler": "actions.search_by_common_name",
      "id": "itis_search_by_common_name",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "match": "contains",
        "matches": [
          {
            "common_name": "Blue Jay",
            "language": "English",
            "tsn": "179680"
          },
          {
            "common_name": "Blue Jays",
            "language": "English",
            "tsn": "179679"
          }
        ],
        "query": "blue jay",
        "total_matches": 2
      },
      "name": "search_by_common_name",
      "parameters": [
        {
          "description": "The name or words to look for, e.g. blue jay.",
          "display_name": "Common name",
          "examples": [
            {
              "label": "A bird",
              "value": "blue jay"
            },
            {
              "label": "A butterfly",
              "value": "monarch"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Whether the name should contain, begin with or end with the words. Defaults to contains.",
          "display_name": "Match",
          "name": "match",
          "options": [
            {
              "label": "Contains the words",
              "value": "contains"
            },
            {
              "label": "Begins with the words",
              "value": "begins_with"
            },
            {
              "label": "Ends with the words",
              "value": "ends_with"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many matches to return, 1 to 200. Defaults to 25. Exact matches come first.",
          "display_name": "Number of results",
          "maximum": 200,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/itis/search-by-common-name",
      "result_str_template": "Found {itis_search_by_common_name,total_matches} names in ITIS.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many are in this result (at most the limit).",
            "type": "integer"
          },
          "match": {
            "description": "How names were matched: contains, begins_with or ends_with.",
            "type": "string"
          },
          "matches": {
            "description": "The matching names, exact matches first.",
            "items": {
              "properties": {
                "common_name": {
                  "description": "The common name, e.g. 'Blue Jay'.",
                  "type": "string"
                },
                "language": {
                  "description": "The language of the name, e.g. 'English' or 'French'.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tsn": {
                  "description": "The taxon's TSN, to use with Get taxon or Get classification.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "query": {
            "description": "The words that were searched for.",
            "type": "string"
          },
          "total_matches": {
            "description": "How many names ITIS matched in all.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
