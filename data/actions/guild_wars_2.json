    "get_exchange_rate": {
      "description": "Get the current gem exchange rate for a quantity: how many coins a number of gems is worth, or how many gems a number of coins buys. Public data.",
      "display_name": "Get gem/gold exchange",
      "display_str_template": "Get Guild Wars 2 exchange rate for {1} {0}.",
      "handler": "actions.get_exchange_rate",
      "id": "guild_wars_2_get_exchange_rate",
