            {
              "label": "Gems \u2192 coins (gold)",
              "value": "gems"
            },
            {
              "label": "Coins (copper) \u2192 gems",
              "value": "coins"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The amount to convert: a number of gems, or a number of copper coins (10000 copper = 1 gold).",
          "display_name": "Amount",
          "minimum": 1,
          "name": "quantity",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/guild_wars_2/get-exchange-rate",
      "result_str_template": "Guild Wars 2 exchange rate retrieved.",
