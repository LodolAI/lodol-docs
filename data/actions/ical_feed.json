          "count": {
            "description": "How many events overlap it",
            "type": "number"
          },
          "events": {
            "description": "The events, earliest first",
            "items": {
              "description": "An event",
              "properties": {
                "all_day": {
                  "description": "True for an all-day event",
                  "type": "boolean"
                },
                "categories": {
                  "description": "Its categories, if any",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "description": {
                  "description": "Its description",
                  "type": "string"
                },
                "end": {
                  "description": "When it ends: for an all-day event, the day after its last day",
                  "type": "string"
                },
                "end_utc": {
                  "description": "When it ends, in UTC (ISO 8601)",
                  "type": "string"
                },
                "location": {
                  "description": "Where it is",
                  "type": "string"
                },
                "organizer": {
                  "description": "Who organised it, if the calendar says",
                  "type": "string"
                },
                "recurring": {
                  "description": "True if it is one occurrence of a repeating event",
                  "type": "boolean"
                },
                "start": {
                  "description": "When it starts: a date for an all-day event, otherwise a date and time with its UTC offset",
                  "type": "string"
                },
                "start_utc": {
                  "description": "When it starts, in UTC (ISO 8601)",
                  "type": "string"
                },
                "status": {
                  "description": "confirmed or tentative",
                  "type": "string"
                },
                "time_zone": {
                  "description": "The time zone its times are in",
                  "type": "string"
                },
                "title": {
                  "description": "The event's title",
                  "type": "string"
                },
                "uid": {
                  "description": "The event's ID in the calendar; every occurrence of a repeating event shares it",
                  "type": "string"
                },
                "url": {
                  "description": "A link the event carries, if any",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
