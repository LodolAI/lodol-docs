{
  "actions": {
    "delete_message": {
      "description": "Delete one message from Gotify, by its ID. Needs a client token on the connection.",
      "display_name": "Delete message",
      "display_str_template": "Delete Gotify message {0}.",
      "handler": "actions.delete_message",
      "id": "gotify_delete_message",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": 128
      },
      "name": "delete_message",
      "output_formatter": "actions.format_deleted_message",
      "parameters": [
        {
          "description": "The message's ID, as a step that sent or listed it gives.",
          "display_name": "Message ID",
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gotify/delete-message",
      "result_str_template": "Deleted message {gotify_delete_message,id}.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True once it's deleted",
            "type": "boolean"
          },
          "id": {
            "description": "The deleted message's ID",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "delete_messages": {
      "description": "Clean up Gotify: delete an application's messages, or every application's, all of them or only those older than some days. Needs a client token on the connection.",
      "display_name": "Delete messages",
      "display_str_template": "Delete Gotify messages of {0}.",
      "handler": "actions.delete_messages",
      "id": "gotify_delete_messages",
      "method": "POST",
      "mock_response": {
        "application": "Backups",
        "application_id": 3,
        "deleted_count": 12,
        "has_more": false,
        "older_than": "2026-10-07T02:06:37Z"
      },
      "name": "delete_messages",
      "output_formatter": "actions.format_deleted_messages",
      "parameters": [
        {
          "description": "Whose messages to delete: one application, or Every application.",
          "display_name": "Application",
          "dynamic_source": "applications_or_all",
          "dynamic_source_allows_custom": true,
          "name": "application",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only delete messages older than this many days, such as 30. Leave blank to delete them all.",
          "display_name": "Older than (days)",
          "maximum": 3650,
          "minimum": 0,
          "name": "older_than_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/gotify/delete-messages",
      "result_str_template": "Deleted {gotify_delete_messages,deleted_count} messages.",
      "returns": {
        "properties": {
          "application": {
            "description": "The application's name, or Every application",
            "type": "string"
          },
          "application_id": {
            "description": "The application's ID; 0 for every application",
            "type": "number"
          },
          "deleted_count": {
            "description": "How many messages were deleted",
            "type": "number"
          },
          "has_more": {
            "description": "Whether old messages are left for another run",
            "type": "boolean"
          },
          "older_than": {
            "description": "Messages sent before this time were deleted (ISO 8601, UTC); empty when all were",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "list_applications": {
      "description": "List the applications in Gotify that messages are sent as, with their IDs and default priorities. Needs a client token on the connection.",
      "display_name": "List applications",
      "display_str_template": "List Gotify applications.",
      "handler": "actions.list_applications",
      "id": "gotify_list_applications",
      "method": "POST",
      "mock_response": {
        "applications": [
          {
            "created_at": "2026-11-01T09:00:00Z",
            "default_priority": 5,
            "description": "Nightly backups of the file server",
            "id": 3,
            "image_url": "https://gotify.example.com/static/defaultapp.png",
            "internal": false,
            "last_used": "2026-11-06T02:06:37Z",
            "name": "Backups"
          }
        ],
        "count": 1
      },
      "name": "list_applications",
      "output_formatter": "actions.format_applications",
      "parameters": [],
      "path": "/actions/library/gotify/list-applications",
      "result_str_template": "Listed {gotify_list_applications,count} applications.",
      "returns": {
        "properties": {
          "applications": {
            "description": "The applications",
            "items": {
              "properties": {
                "created_at": {
                  "description": "When it was made (ISO 8601)",
                  "type": "string"
                },
                "default_priority": {
                  "description": "The priority of messages sent without one",
                  "type": "number"
                },
                "description": {
                  "description": "Its description",
                  "type": "string"
                },
                "id": {
                  "description": "The application's ID",
                  "type": "number"
                },
                "image_url": {
                  "description": "A link to its picture",
                  "type": "string"
                },
                "internal": {
                  "description": "Whether a Gotify plugin made it",
                  "type": "boolean"
                },
                "last_used": {
                  "description": "When its token was last used (ISO 8601); empty if never",
                  "type": "string"
                },
                "name": {
                  "description": "Its name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "count": {
            "description": "How many applications there are",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_messages": {
      "description": "List the newest messages in Gotify, from every application or one, newest first. Needs a client token on the connection.",
      "display_name": "List messages",
      "display_str_template": "List Gotify messages.",
      "handler": "actions.list_messages",
      "id": "gotify_list_messages",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "has_more": false,
        "messages": [
          {
            "application": "Backups",
            "application_id": 3,
            "click_url": "https://backups.example.com/runs/42",
            "date": "2026-11-06T02:06:37Z",
            "extras": {
              "client::display": {
                "contentType": "text/markdown"
              },
              "client::notification": {
                "click": {
                  "url": "https://backups.example.com/runs/42"
                }
              }
            },
            "id": 128,
            "image_url": "",
            "markdown": true,
            "message": "**Nightly backup** finished in 4 minutes.",
            "priority": 5,
            "priority_level": "Normal",
            "title": "Backup finished"
          }
        ]
      },
      "name": "list_messages",
      "output_formatter": "actions.format_messages",
      "parameters": [
        {
          "description": "Only this application's messages. Leave blank for every application.",
          "display_name": "Application",
          "dynamic_source": "applications",
          "dynamic_source_allows_custom": true,
          "name": "application",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most to list, newest first. Defaults to 25.",
          "display_name": "How many",
          "maximum": 500,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/gotify/list-messages",
      "result_str_template": "Listed {gotify_list_messages,count} messages.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many messages were listed",
            "type": "number"
          },
          "has_more": {
            "description": "Whether there are more than were listed",
            "type": "boolean"
          },
          "messages": {
            "description": "The messages, newest first",
            "items": {
              "properties": {
                "application": {
                  "description": "The application's name; empty when the connection has no client token",
                  "type": "string"
                },
                "application_id": {
                  "description": "The ID of the application it was sent as",
                  "type": "number"
                },
                "click_url": {
                  "description": "The link opened when the notification is tapped; may be empty",
                  "type": "string"
                },
                "date": {
                  "description": "When it was sent (ISO 8601, UTC)",
                  "type": "string"
                },
                "extras": {
                  "description": "Everything sent with it as Gotify extras, as sent",
                  "type": "object"
                },
                "id": {
                  "description": "The message's ID",
                  "type": "number"
                },
                "image_url": {
                  "description": "The big image shown in the notification; may be empty",
                  "type": "string"
                },
                "markdown": {
                  "description": "Whether it is shown as Markdown",
                  "type": "boolean"
                },
                "message": {
                  "description": "What it says",
                  "type": "string"
                },
                "priority": {
                  "description": "Its priority, usually 0 to 10",
                  "type": "number"
                },
                "priority_level": {
                  "description": "How the Android app shows it: None (no notification), Low (an icon), Normal (with a sound) or High (sound and vibration)",
                  "type": "string"
                },
                "title": {
                  "description": "Its title; Gotify uses the application's name when none is given",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "send_notification": {
      "description": "Send a push notification to the phones and browsers showing Gotify, with a title, a priority, Markdown, a link to open when it's tapped and a big image.",
      "display_name": "Send notification",
      "display_str_template": "Send Gotify notification '{0}'.",
      "handler": "actions.send_notification",
      "id": "gotify_send_notification",
      "method": "POST",
      "mock_response": {
        "application": "Backups",
        "application_id": 3,
        "click_url": "https://backups.example.com/runs/42",
        "date": "2026-11-06T02:06:37Z",
        "extras": {
          "client::display": {
            "contentType": "text/markdown"
          },
          "client::notification": {
            "click": {
              "url": "https://backups.example.com/runs/42"
            }
          }
        },
        "id": 128,
        "image_url": "",
        "markdown": true,
        "message": "**Nightly backup** finished in 4 minutes.",
        "priority": 5,
        "priority_level": "Normal",
        "title": "Backup finished"
      },
      "name": "send_notification",
      "output_formatter": "actions.format_message",
      "parameters": [
        {
          "description": "What the notification says.",
          "display_name": "Message",
          "multiline": true,
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Its title. Leave blank and Gotify uses the application's name.",
          "display_name": "Title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How strongly phones get your attention. Leave blank for the application's default priority.",
          "display_name": "Priority",
          "name": "priority",
          "options": [
            {
              "label": "None: listed in Gotify, no notification (0)",
              "value": "0"
            },
            {
              "label": "Low: an icon, no sound (2)",
              "value": "2"
            },
            {
              "label": "Normal: with a sound (5)",
              "value": "5"
            },
            {
              "label": "High: sound and vibration (8)",
              "value": "8"
            },
            {
              "label": "Highest (10)",
              "value": "10"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Show the message as Markdown: **bold**, lists, links and pictures.",
          "display_name": "Markdown",
          "name": "markdown",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "A link the Android app opens when the notification is tapped, instead of opening Gotify.",
          "display_name": "Link to open",
          "name": "click_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A web link to a picture the Android app shows large in the notification.",
          "display_name": "Big image",
          "name": "image_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Send as this application. Leave blank to send as the one whose token the connection has; another one needs a client token on the connection.",
          "display_name": "Application",
          "dynamic_source": "applications",
          "dynamic_source_allows_custom": true,
          "name": "application",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gotify/send-notification",
      "result_str_template": "Sent message {gotify_send_notification,id}.",
      "returns": {
        "properties": {
          "application": {
            "description": "The application's name; empty when the connection has no client token",
            "type": "string"
          },
          "application_id": {
            "description": "The ID of the application it was sent as",
            "type": "number"
          },
          "click_url": {
            "description": "The link opened when the notification is tapped; may be empty",
            "type": "string"
          },
          "date": {
            "description": "When it was sent (ISO 8601, UTC)",
            "type": "string"
          },
          "extras": {
            "description": "Everything sent with it as Gotify extras, as sent",
            "type": "object"
          },
          "id": {
            "description": "The message's ID",
            "type": "number"
          },
          "image_url": {
            "description": "The big image shown in the notification; may be empty",
            "type": "string"
          },
          "markdown": {
            "description": "Whether it is shown as Markdown",
            "type": "boolean"
          },
          "message": {
            "description": "What it says",
            "type": "string"
          },
          "priority": {
            "description": "Its priority, usually 0 to 10",
            "type": "number"
          },
          "priority_level": {
            "description": "How the Android app shows it: None (no notification), Low (an icon), Normal (with a sound) or High (sound and vibration)",
            "type": "string"
          },
          "title": {
            "description": "Its title; Gotify uses the application's name when none is given",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    }
  },
  "categories": [
    "Notifications"
  ],
  "description": "Send push notifications to your phone with Gotify, your own notification server: titles, priorities, Markdown, links and images. List and clean up messages, and start a workflow when one arrives.",
  "display_name": "Gotify",
  "id": "gotify",
  "logo": "https://www.lodol.com/app-icons/gotify-icon.png",
  "triggers": {
    "gotify_new_message_trigger": {
      "description": "Runs when a message arrives in Gotify, on every application or one, such as to forward what a server sends to Gotify. Needs a client token on the connection. A workflow that sends to the application it watches starts itself again with every message.",
      "display_name": "New message",
      "id": "gotify_new_message_trigger",
      "output": {
        "application": "string",
        "application_id": "number",
        "click_url": "string",
        "date": "string",
        "extras": "object",
        "id": "number",
        "image_url": "string",
        "markdown": "boolean",
        "message": "string",
        "priority": "number",
        "priority_level": "string",
        "title": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only messages sent as this application. Leave blank for every application.",
          "display_name": "Application",
          "name": "application",
          "required": false
        }
      ]
    }
  }
}
