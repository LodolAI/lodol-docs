      "id": "textmagic_new_contact_trigger",
      "output": {
        "record": "object with the fields id, firstName, lastName, phone, email, companyName"
      },
      "parameters": []
    },
    "textmagic_new_list_trigger": {
      "description": "Runs for each new list in Textmagic. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New list",
      "id": "textmagic_new_list_trigger",
      "output": {
        "record": "object with the fields id, name, membersCount, shared"
      },
      "parameters": []
    },
    "textmagic_new_message_trigger": {
      "description": "Runs for each new outgoing message in Textmagic. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New outgoing message",
      "id": "textmagic_new_message_trigger",
      "output": {
        "record": "object with the fields id, text, receiver, sender, status, messageTime"
      },
      "parameters": []
    },
    "textmagic_new_reply_trigger": {
      "description": "Runs for each new incoming reply in Textmagic. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
