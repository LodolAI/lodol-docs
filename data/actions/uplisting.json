  "categories": [
    "Calendars"
  ],
  "description": "Read properties, availability, calendars and bookings from Uplisting.",
  "display_name": "Uplisting",
  "id": "uplisting",
  "logo": "https://www.lodol.com/app-icons/uplisting.png",
  "triggers": {
    "uplisting_booking_cancelled_trigger": {
      "description": "Beta. Runs once when a booking at your Uplisting properties is cancelled, with the guest, the stay dates and the property, ready to free up a cleaner or follow up with the guest. Bookings already cancelled when the workflow is turned on don't start it. It sees bookings for stays from today up to two years ahead, so a stay cancelled after it began is missed. How often it checks follows your workspace plan.",
      "display_name": "Booking cancelled",
      "id": "uplisting_booking_cancelled_trigger",
      "output": {
        "booking": "Everything Uplisting gives for the booking, such as the guest, the stay dates and the channel it came from, under Uplisting's own names (in attributes).",
        "id": "Uplisting's ID for the booking.",
        "property_id": "The ID of the property the booking is for.",
        "property_name": "The property's name. Empty when a Property was chosen, as only its ID is known.",
        "status": "The booking's status as Uplisting shows it, such as confirmed."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The property to watch: its ID, as 'List properties' gives it. Leave blank to watch every property.",
          "display_name": "Property",
          "name": "property_id",
          "required": false
        }
      ]
    },
    "uplisting_new_booking_trigger": {
      "description": "Beta. Runs once for each new booking at your Uplisting properties, from any channel, with the guest, the stay dates and the property, ready to welcome the guest or tell your cleaner. Bookings already there when the workflow is turned on don't start it, nor do ones cancelled before it looked. It sees bookings for stays from today up to two years ahead. How often it checks follows your workspace plan.",
      "display_name": "New booking",
      "id": "uplisting_new_booking_trigger",
