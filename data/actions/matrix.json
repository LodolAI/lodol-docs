  "categories": [
    "Messaging"
  ],
  "description": "Post to and manage Matrix rooms on any homeserver: send and read messages, create and join rooms, set topics, and invite and remove people. Start a workflow when a message is posted in a room.",
  "display_name": "Matrix",
  "id": "matrix",
  "logo": "https://www.lodol.com/app-icons/matrix-icon.svg",
  "triggers": {
    "matrix_new_message_trigger": {
      "description": "Runs when someone posts a message in a Matrix room the account is in. Messages the account sends itself, and those in end-to-end encrypted rooms, don't run it.",
      "display_name": "New message",
      "id": "matrix_new_message_trigger",
      "output": {
        "event_id": "string",
        "kind": "string",
        "room_id": "string",
        "sender": "string",
        "sent_at_ms": "number",
        "text": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only messages in this room. Leave blank for every room the account is in.",
          "display_name": "Room",
          "name": "room",
          "required": false
        }
      ]
    }
  }
