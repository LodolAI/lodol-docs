{
  "actions": {
    "create_room": {
      "description": "Create a room without encryption and invite people to it.",
      "display_name": "Create room",
      "display_str_template": "Create room {0} on Matrix.",
      "handler": "actions.create_room",
      "id": "matrix_create_room",
      "method": "POST",
      "mock_response": {
        "address": "#ops-alerts:matrix.org",
        "encrypted": false,
        "name": "Ops alerts",
        "room_id": "!kBzNxRnXvLqHtYwPJa:matrix.org",
        "topic": "Alerts from our workflows"
      },
      "name": "create_room",
      "output_formatter": "actions.format_room",
      "parameters": [
        {
          "description": "The room's name, such as Ops alerts.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What the room is for.",
          "display_name": "Topic",
          "name": "topic",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "private",
          "description": "Only people invited, or anyone with the address. Defaults to only people invited.",
          "display_name": "Who can join",
          "name": "access",
          "options": [
            {
              "label": "Private (invite only)",
              "value": "private"
            },
            {
              "label": "Public (anyone can join)",
              "value": "public"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A short name for its address, such as ops-alerts for #ops-alerts:matrix.org.",
          "display_name": "Address",
          "name": "address",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Matrix IDs of people to invite, such as @sam:matrix.org.",
          "display_name": "Invite",
          "name": "invite",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/matrix/create-room",
      "result_str_template": "Room {matrix_create_room,name} created.",
      "returns": {
        "properties": {
          "address": {
            "description": "Its address, such as #team:matrix.org; empty if none",
            "type": "string"
          },
          "encrypted": {
            "description": "True when it is end-to-end encrypted",
            "type": "boolean"
          },
          "name": {
            "description": "Its name",
            "type": "string"
          },
          "room_id": {
            "description": "The room's ID",
            "type": "string"
          },
          "topic": {
            "description": "Its topic",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_message": {
      "description": "Remove a message from a room, wiping its words for everyone.",
      "display_name": "Delete message",
      "display_str_template": "Delete a message in {0} on Matrix.",
      "handler": "actions.delete_message",
      "id": "matrix_delete_message",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "event_id": "$9fGh2sKpQwErTyUi0oPlKjHgFdSaZxCv",
        "redaction_id": "$Qw3rTy8uIoPaSdFgHjKlZxCvBnM",
        "room_id": "!kBzNxRnXvLqHtYwPJa:matrix.org"
      },
      "name": "delete_message",
      "output_formatter": "actions.format_deleted",
      "parameters": [
        {
          "description": "The room. Pick one, or give its ID (!abc:matrix.org) or address (#name:matrix.org).",
          "display_name": "Room",
          "dynamic_source": "rooms",
          "dynamic_source_allows_custom": true,
          "name": "room",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The message's event ID, starting with $, from 'Send message' or 'Get messages'.",
          "display_name": "Message",
          "name": "event_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Why it was removed, shown in its place.",
          "display_name": "Reason",
          "name": "reason",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/matrix/delete-message",
      "result_str_template": "Message removed.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True once removed",
            "type": "boolean"
          },
          "event_id": {
            "description": "The removed message's event ID",
            "type": "string"
          },
          "redaction_id": {
            "description": "The ID of the removal itself",
            "type": "string"
          },
          "room_id": {
            "description": "The room",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "get_messages": {
      "description": "Get a room's most recent messages, newest first.",
      "display_name": "Get messages",
      "display_str_template": "Get messages from {0} on Matrix.",
      "handler": "actions.get_messages",
      "id": "matrix_get_messages",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "messages": [
          {
            "event_id": "$9fGh2sKpQwErTyUi0oPlKjHgFdSaZxCv",
            "kind": "text",
            "room_id": "!kBzNxRnXvLqHtYwPJa:matrix.org",
            "sender": "@sam:matrix.org",
            "sent_at_ms": 1793095200000,
            "text": "Deploy finished"
          }
        ],
        "room_id": "!kBzNxRnXvLqHtYwPJa:matrix.org"
      },
      "name": "get_messages",
      "output_formatter": "actions.format_messages",
      "parameters": [
        {
          "description": "The room. Pick one, or give its ID (!abc:matrix.org) or address (#name:matrix.org).",
          "display_name": "Room",
          "dynamic_source": "rooms",
          "dynamic_source_allows_custom": true,
          "name": "room",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many messages. Defaults to 20.",
          "display_name": "How many",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/matrix/get-messages",
      "result_str_template": "{matrix_get_messages,count} message(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many messages",
            "type": "number"
          },
          "messages": {
            "description": "The messages, newest first",
            "items": {
              "description": "A message",
              "properties": {
                "event_id": {
                  "description": "The message's event ID",
                  "type": "string"
                },
                "kind": {
                  "description": "text, notice or emote",
                  "type": "string"
                },
                "room_id": {
                  "description": "The room it is in",
                  "type": "string"
                },
                "sender": {
                  "description": "Who sent it, as a Matrix ID",
                  "type": "string"
                },
                "sent_at_ms": {
                  "description": "When it was sent, in milliseconds since 1970",
                  "type": "number"
                },
                "text": {
                  "description": "What it says",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "room_id": {
            "description": "The room",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
