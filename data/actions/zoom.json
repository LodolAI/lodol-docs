{
  "actions": {
    "add_meeting_registrant": {
      "description": "Register a participant for a Zoom meeting. The meeting must have registration enabled.",
      "display_name": "Add registrant to a Zoom meeting",
      "display_str_template": "Add registrant {email} to Zoom meeting {meeting_id}.",
      "handler": "actions.add_meeting_registrant",
      "id": "zoom_add_registrant",
      "method": "POST",
      "mock_response": {
        "registrant": {
          "id": "abc123XYZ",
          "join_url": "https://zoom.us/w/89012345678?tk=example",
          "registrant_id": "abc123XYZ"
        }
      },
      "name": "add_meeting_registrant",
      "parameters": [
        {
          "description": "The Zoom meeting ID to register the person for.",
          "display_name": "Meeting ID",
          "name": "meeting_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Registrant email address.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Registrant first name.",
          "display_name": "First name",
          "name": "first_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional registrant last name.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zoom/add-registrant",
      "result_str_template": "Registrant added.",
      "returns": {
        "properties": {
          "registrant": {
            "description": "Registrant details.",
            "properties": {
              "id": {
                "description": "The registrant's ID.",
                "type": "string"
              },
              "join_url": {
                "description": "The personal join URL for this registrant.",
                "type": "string"
              },
              "registrant_id": {
                "description": "The registrant's ID.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_meeting": {
      "description": "Schedule a new Zoom meeting for a host.",
      "display_name": "Create a Zoom meeting",
      "display_str_template": "Create a Zoom meeting '{topic}' for {user_id}.",
      "handler": "actions.create_meeting",
      "id": "zoom_create_meeting",
      "method": "POST",
      "mock_response": {
        "meeting": {
          "duration": 30,
          "id": 89012345678,
          "join_url": "https://zoom.us/j/89012345678",
          "start_time": "2026-08-25T14:00:00Z",
          "start_url": "https://zoom.us/s/89012345678?zak=example",
          "topic": "Weekly team sync"
        }
      },
      "name": "create_meeting",
      "parameters": [
        {
          "description": "The Zoom user who will host the meeting. Use their Zoom login email, or 'me' for the account that owns the connection.",
          "display_name": "Host",
          "examples": [
            {
              "label": "Account owner",
              "value": "me"
            },
            {
              "label": "By email",
              "value": "host@example.com"
            }
          ],
          "name": "user_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The meeting topic or title.",
          "display_name": "Topic",
          "examples": [
            {
              "label": "Example",
              "value": "Weekly team sync"
            }
          ],
          "name": "topic",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "2",
          "description": "Whether the meeting starts now or at a scheduled date and time. Defaults to scheduled.",
          "display_name": "Meeting type",
          "name": "meeting_type",
          "options": [
            {
              "label": "Scheduled (starts at a set date and time)",
              "value": "2"
            },
            {
              "label": "Instant (starts right now)",
              "value": "1"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When a scheduled meeting should start. Pick a date and time (stored in UTC).",
          "display_name": "Start time",
          "name": "start_time",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "How long the meeting is expected to run, in minutes.",
          "display_name": "Duration (minutes)",
          "maximum": 1440,
          "minimum": 1,
          "name": "duration_minutes",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional timezone for the start time (e.g., America/Los_Angeles). Leave blank to use UTC.",
          "display_name": "Timezone",
          "examples": [
            {
              "label": "US Pacific",
              "value": "America/Los_Angeles"
            },
            {
              "label": "US Eastern",
              "value": "America/New_York"
            },
            {
              "label": "UTC",
              "value": "UTC"
            }
          ],
          "name": "timezone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional passcode required to join the meeting.",
          "display_name": "Passcode",
          "name": "password",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional agenda or description for the meeting.",
          "display_name": "Agenda",
          "multiline": true,
          "name": "agenda",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Start the meeting with the host's video turned on.",
          "display_name": "Host video on",
          "name": "host_video",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Start the meeting with participants' video turned on.",
          "display_name": "Participant video on",
          "name": "participant_video",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Let participants join before the host arrives.",
          "display_name": "Allow join before host",
          "name": "join_before_host",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Automatically mute participants as they join.",
          "display_name": "Mute on entry",
          "name": "mute_upon_entry",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Hold participants in a waiting room until admitted.",
          "display_name": "Enable waiting room",
          "name": "waiting_room",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Whether attendees must register, and how they're approved. Registration must be on before you can add registrants.",
          "display_name": "Registration",
          "name": "approval_type",
          "options": [
            {
              "label": "No registration required",
              "value": "2"
            },
            {
              "label": "Automatically approve registrants",
              "value": "0"
            },
            {
              "label": "Manually approve registrants",
              "value": "1"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Whether and where to record the meeting automatically.",
          "display_name": "Automatic recording",
          "name": "auto_recording",
          "options": [
            {
              "label": "Do not record automatically",
              "value": "none"
            },
            {
              "label": "Record to the host's computer",
              "value": "local"
            },
            {
              "label": "Record to the Zoom cloud",
              "value": "cloud"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zoom/create-meeting",
      "result_str_template": "Meeting created.",
      "returns": {
        "properties": {
          "meeting": {
            "description": "The created Zoom meeting.",
            "properties": {
              "id": {
                "description": "The numeric meeting ID.",
                "type": "number"
              },
              "join_url": {
                "description": "URL participants use to join.",
                "type": "string"
              },
              "start_time": {
                "description": "Scheduled start time (ISO 8601).",
                "type": "string"
              },
              "start_url": {
                "description": "URL the host uses to start the meeting.",
                "type": "string"
              },
              "topic": {
                "description": "Meeting topic.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_meeting_details": {
      "description": "Look up the details of a Zoom meeting by its ID.",
      "display_name": "Find a Zoom meeting",
      "display_str_template": "Find Zoom meeting {meeting_id}.",
      "handler": "actions.get_meeting_details",
      "id": "zoom_get_meeting",
      "method": "POST",
      "mock_response": {
        "meeting": {
          "id": 89012345678,
          "join_url": "https://zoom.us/j/89012345678",
          "start_time": "2026-08-25T14:00:00Z",
          "status": "waiting",
          "topic": "Weekly team sync",
          "uuid": "abcdEFGH12345=="
        }
      },
      "name": "get_meeting_details",
      "parameters": [
        {
          "description": "The ID of the Zoom meeting to look up.",
          "display_name": "Meeting ID",
          "name": "meeting_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zoom/get-meeting",
      "result_str_template": "Meeting details retrieved.",
      "returns": {
        "properties": {
          "meeting": {
            "description": "Meeting details.",
            "properties": {
              "id": {
                "description": "Meeting ID.",
                "type": "number"
              },
              "join_url": {
                "description": "URL participants use to join.",
                "type": "string"
              },
              "status": {
                "description": "Meeting status (e.g. waiting, started).",
                "type": "string"
              },
              "topic": {
                "description": "Meeting topic.",
                "type": "string"
              },
              "uuid": {
                "description": "The meeting instance UUID; use it with 'Find Zoom meeting participants'.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_meeting_recordings": {
      "description": "Get the cloud recordings for a meeting, including their download links.",
      "display_name": "Find Zoom meeting recordings",
      "display_str_template": "Find recordings for Zoom meeting {meeting_id}.",
      "handler": "actions.get_meeting_recordings",
      "id": "zoom_get_recordings",
      "method": "POST",
      "mock_response": {
        "recordings": {
          "id": 89012345678,
          "recording_files": [
            {
              "download_url": "https://zoom.us/rec/download/example",
              "file_type": "MP4",
              "id": "rec-1",
              "recording_type": "shared_screen_with_speaker_view"
            }
          ],
          "total_size": 20480,
          "uuid": "abcdEFGH12345=="
        }
      },
      "name": "get_meeting_recordings",
      "parameters": [
        {
          "description": "The meeting whose recordings you want. Accepts the numeric meeting ID or the meeting instance UUID.",
          "display_name": "Meeting ID or UUID",
          "name": "meeting_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zoom/get-recordings",
      "result_str_template": "Recordings retrieved.",
      "returns": {
        "properties": {
          "recordings": {
            "description": "The meeting's recording details.",
            "properties": {
              "id": {
                "description": "Meeting ID.",
                "type": "number"
              },
              "recording_files": {
                "description": "The individual recording files.",
                "items": {
                  "properties": {
                    "download_url": {
                      "description": "URL to download the file.",
                      "type": "string"
                    },
                    "file_type": {
                      "description": "File type (e.g. MP4, M4A).",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "total_size": {
                "description": "Total size of all recording files, in bytes.",
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "update_meeting": {
      "description": "Change the details of an existing Zoom meeting.",
      "display_name": "Update a Zoom meeting",
      "display_str_template": "Update Zoom meeting {meeting_id}.",
      "handler": "actions.update_meeting",
      "id": "zoom_update_meeting",
      "method": "POST",
      "mock_response": {
        "meeting": {
          "id": "89012345678",
          "updated": true
        }
      },
      "name": "update_meeting",
      "parameters": [
        {
          "description": "The ID of the Zoom meeting to update.",
          "display_name": "Meeting ID",
          "name": "meeting_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A new topic or title for the meeting.",
          "display_name": "Topic",
          "name": "topic",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A new date and time for the meeting (stored in UTC).",
          "display_name": "Start time",
          "name": "start_time",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "A new meeting length, in minutes.",
          "display_name": "Duration (minutes)",
          "maximum": 1440,
          "minimum": 1,
          "name": "duration_minutes",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "A new timezone for the start time (e.g., UTC).",
          "display_name": "Timezone",
          "name": "timezone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A new agenda or description for the meeting.",
          "display_name": "Agenda",
          "multiline": true,
          "name": "agenda",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Start the meeting with the host's video turned on.",
          "display_name": "Host video on",
          "name": "host_video",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Start the meeting with participants' video turned on.",
          "display_name": "Participant video on",
          "name": "participant_video",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Let participants join before the host arrives.",
          "display_name": "Allow join before host",
          "name": "join_before_host",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Automatically mute participants as they join.",
          "display_name": "Mute on entry",
          "name": "mute_upon_entry",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Hold participants in a waiting room until admitted.",
          "display_name": "Enable waiting room",
          "name": "waiting_room",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Whether and where to record the meeting automatically.",
          "display_name": "Automatic recording",
          "name": "auto_recording",
          "options": [
            {
              "label": "Do not record automatically",
              "value": "none"
            },
            {
              "label": "Record to the host's computer",
              "value": "local"
            },
            {
              "label": "Record to the Zoom cloud",
              "value": "cloud"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zoom/update-meeting",
      "result_str_template": "Meeting updated.",
      "returns": {
        "properties": {
          "meeting": {
            "properties": {
              "id": {
                "description": "The meeting ID that was updated.",
                "type": "string"
              },
              "updated": {
                "description": "True when the update succeeded.",
                "type": "boolean"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Schedule and manage Zoom meetings, registrants, and recordings.",
  "display_name": "Zoom",
  "id": "zoom"
}
