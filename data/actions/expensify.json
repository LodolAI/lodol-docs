{
  "actions": {
    "create_policy": {
      "description": "Create a new Expensify workspace/policy.",
      "display_name": "Create Expensify policy",
      "display_str_template": "Create Expensify policy '{0}'",
      "handler": "actions.create_policy",
      "id": "expensify_create_policy",
      "method": "POST",
      "mock_response": {
        "policyID": "NEW123POLICY"
      },
      "name": "create_policy",
      "output_formatter": "actions.format_create_policy_output",
      "parameters": [
        {
          "description": "Name for the new workspace/policy.",
          "display_name": "Policy name",
          "name": "policy_name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/expensify/create-policy",
      "result_str_template": "Policy created.",
      "returns": {
        "properties": {
          "policyID": {
            "description": "ID of the created policy. Use as policy_id in export_reports.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "export_reports": {
      "description": "Export expense reports from Expensify with flexible filters. Each report includes its expenses, with amounts in dollars (not cents).",
      "display_name": "Export expense reports",
      "display_str_template": "Export Expensify reports from {0}",
      "handler": "actions.export_reports",
      "id": "expensify_export_reports",
      "method": "POST",
      "mock_response": [
        {
          "currency": "USD",
          "expenses": [
            {
              "amount": 350.0,
              "category": "Travel",
              "date": "2024-03-15",
              "merchant": "Delta Airlines",
              "transactionID": "T001"
            }
          ],
          "policyName": "Default Policy",
          "reportID": "R00abc123",
          "reportName": "March Travel",
          "status": "Approved",
          "submitter": "user@example.com",
          "total": 450.75
        }
      ],
      "name": "export_reports",
      "output_formatter": "actions.format_export_reports_output",
      "parameters": [
        {
          "description": "Start date for the export range (YYYY-MM-DD). Required unless you provide a list of report IDs.",
          "display_name": "Start date",
          "name": "start_date",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "End date for the export range (YYYY-MM-DD). Date range cannot exceed one year.",
          "display_name": "End date",
          "name": "end_date",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Report IDs to export, separated by commas. Required unless you provide a start date. You can find report IDs in the results of an earlier 'Export expense reports' action.",
          "display_name": "Report ID list",
          "name": "report_id_list",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Only include reports with this status.",
          "display_name": "Report status",
          "name": "report_state",
          "options": [
            {
              "label": "Open (draft)",
              "value": "OPEN"
            },
            {
              "label": "Submitted (awaiting approval)",
              "value": "SUBMITTED"
            },
            {
              "label": "Approved",
              "value": "APPROVED"
            },
            {
              "label": "Reimbursed",
              "value": "REIMBURSED"
            },
            {
              "label": "Archived / closed",
              "value": "ARCHIVED"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only include reports from this policy (workspace). You can get the ID from the 'List Expensify policies' or 'Create Expensify policy' actions.",
          "display_name": "Policy ID",
          "name": "policy_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of reports to export.",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/expensify/export-reports",
      "result_str_template": "Reports exported.",
      "returns": {
        "description": "Array of exported report objects with nested expenses.",
        "items": {
          "properties": {
            "currency": {
              "description": "Report currency code.",
              "type": "string"
            },
            "expenses": {
              "description": "List of expenses in this report.",
              "items": {
                "properties": {
                  "amount": {
                    "description": "Amount in dollars (modified/converted if applicable).",
                    "type": "number"
                  },
                  "category": {
                    "description": "Expense category.",
                    "type": "string"
                  },
                  "date": {
                    "description": "Expense date.",
                    "type": "string"
                  },
                  "merchant": {
                    "description": "Merchant name (modified name if edited).",
                    "type": "string"
                  },
                  "transactionID": {
                    "description": "Unique expense ID.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "policyName": {
              "description": "Workspace/policy name.",
              "type": "string"
            },
            "reportID": {
              "description": "Report ID. Use in update_report_status (report_id_list) or export_reports (report_id_list).",
              "type": "string"
            },
            "reportName": {
              "description": "Report name.",
              "type": "string"
            },
            "status": {
              "description": "Report status: Open, Processing, Approved, Reimbursed, Closed.",
              "type": "string"
            },
            "submitter": {
              "description": "Email of the report creator.",
              "type": "string"
            },
            "total": {
              "description": "Total amount in dollars.",
              "type": "number"
            }
          },
          "type": "object"
        },
        "type": "array"
      }
    },
    "list_policies": {
      "description": "List all policies (workspaces) your Expensify account has access to.",
      "display_name": "List Expensify policies",
      "display_str_template": "List Expensify policies",
      "handler": "actions.list_policies",
      "id": "expensify_list_policies",
      "method": "POST",
      "mock_response": [
        {
          "id": "ABC123DEF456",
          "name": "Engineering Team",
          "role": "admin",
          "type": "corporate"
        }
      ],
      "name": "list_policies",
      "output_formatter": "actions.format_list_policies_output",
      "parameters": [
        {
          "default": false,
          "description": "Set to true to only include policies where you are an admin.",
          "display_name": "Admin only",
          "name": "admin_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/expensify/list-policies",
      "result_str_template": "Policies listed.",
      "returns": {
        "description": "Array of policy summary objects.",
        "items": {
          "properties": {
            "id": {
              "description": "Policy ID. Use as policy_id in export_reports.",
              "type": "string"
            },
            "name": {
              "description": "Policy/workspace name.",
              "type": "string"
            },
            "role": {
              "description": "User's role in this policy (admin, user, auditor).",
              "type": "string"
            },
            "type": {
              "description": "Policy type (team or corporate).",
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      }
    },
    "update_report_status": {
      "description": "Mark reports as reimbursed. Only Approved reports will be updated; others are skipped. You can get report IDs from the 'Export expense reports' action.",
      "display_name": "Mark reports as reimbursed",
      "display_str_template": "Mark Expensify reports as reimbursed",
      "handler": "actions.update_report_status",
      "id": "expensify_update_report_status",
      "method": "POST",
      "mock_response": {
        "reportIDsUpdated": [
          "R00abc123",
          "R00def456"
        ]
      },
      "name": "update_report_status",
      "output_formatter": "actions.format_update_report_status_output",
      "parameters": [
        {
          "description": "Report IDs to mark as reimbursed, separated by commas. Required unless you provide a start date. You can get report IDs from the 'Export expense reports' action.",
          "display_name": "Report ID list",
          "name": "report_id_list",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Start date filter (YYYY-MM-DD). Required unless you provide a list of report IDs.",
          "display_name": "Start date",
          "name": "start_date",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "End date filter (YYYY-MM-DD).",
          "display_name": "End date",
          "name": "end_date",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional description of the payment source (1-100 characters).",
          "display_name": "Payment source",
          "name": "payment_source",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/expensify/update-report-status",
      "result_str_template": "Reports updated.",
      "returns": {
        "properties": {
          "reportIDsUpdated": {
            "description": "List of report IDs that were successfully marked as reimbursed.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Automate expense reports and policy management in Expensify.",
  "display_name": "Expensify",
  "id": "expensify"
}
