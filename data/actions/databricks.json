{
  "actions": {
    "find_job": {
      "description": "Look up a single Databricks job and its full definition by ID.",
      "display_name": "Find job",
      "display_str_template": "Find job {0}.",
      "handler": "actions.find_job",
      "id": "databricks_find_job",
      "method": "POST",
      "mock_response": {
        "created_time": 1700000000000,
        "creator_user_name": "user@example.com",
        "job_id": 12345,
        "settings": {
          "name": "Nightly ETL",
          "tasks": [
            {
              "task_key": "ingest"
            }
          ]
        }
      },
      "name": "find_job",
      "parameters": [
        {
          "description": "Pick a job, or enter its numeric ID.",
          "display_name": "Job",
          "dynamic_source": "jobs",
          "name": "job_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/databricks/find-job",
      "result_str_template": "Retrieved job {0}.",
      "returns": {
        "properties": {
          "created_time": {
            "description": "When the job was created (epoch ms)",
            "type": "integer"
          },
          "job_id": {
            "description": "The job's ID",
            "type": "integer"
          },
          "settings": {
            "description": "The job's settings",
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "find_run": {
      "description": "Look up a single job run and its current state by run ID.",
      "display_name": "Find run",
      "display_str_template": "Find run {0}.",
      "handler": "actions.find_run",
      "id": "databricks_find_run",
      "method": "POST",
      "mock_response": {
        "job_id": 12345,
        "run_id": 67890,
        "run_name": "Nightly ETL",
        "run_page_url": "https://dbc-1234.cloud.databricks.com/#job/12345/run/1",
        "state": {
          "life_cycle_state": "TERMINATED",
          "result_state": "SUCCESS"
        }
      },
      "name": "find_run",
      "parameters": [
        {
          "description": "Pick a recent run, or enter its numeric ID.",
          "display_name": "Run",
          "dynamic_source": "runs",
          "name": "run_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/databricks/find-run",
      "result_str_template": "Retrieved run {0}.",
      "returns": {
        "properties": {
          "job_id": {
            "description": "The ID of the job this run belongs to",
            "type": "integer"
          },
          "run_id": {
            "description": "The run's ID",
            "type": "integer"
          },
          "state": {
            "description": "Life-cycle and result state of the run",
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "find_sql_warehouse": {
      "description": "Look up a single SQL warehouse's configuration and state by ID.",
      "display_name": "Find SQL warehouse",
      "display_str_template": "Find SQL warehouse '{0}'.",
      "handler": "actions.find_sql_warehouse",
      "id": "databricks_find_sql_warehouse",
      "method": "POST",
      "mock_response": {
        "cluster_size": "Small",
        "creator_name": "user@example.com",
        "id": "0123456789abcdef",
        "name": "Serverless Starter Warehouse",
        "num_clusters": 1,
        "state": "RUNNING"
      },
      "name": "find_sql_warehouse",
      "parameters": [
        {
          "description": "Pick a SQL warehouse, or enter its ID.",
          "display_name": "SQL warehouse",
          "dynamic_source": "sql_warehouses",
          "name": "warehouse_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/databricks/find-sql-warehouse",
      "result_str_template": "Retrieved SQL warehouse '{0}'.",
      "returns": {
        "properties": {
          "id": {
            "description": "The SQL warehouse's ID",
            "type": "string"
          },
          "name": {
            "description": "The SQL warehouse's name",
            "type": "string"
          },
          "state": {
            "description": "Current state (e.g. RUNNING, STOPPED)",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_jobs": {
      "description": "List the jobs defined in your Databricks workspace. Results come back a page at a time when there are many.",
      "display_name": "List jobs",
      "display_str_template": "List Databricks jobs.",
      "handler": "actions.list_jobs",
      "id": "databricks_list_jobs",
      "method": "POST",
      "mock_response": {
        "has_more": false,
        "jobs": [
          {
            "created_time": 1700000000000,
            "job_id": 12345,
            "settings": {
              "name": "Nightly ETL"
            }
          }
        ],
        "jobs_count": 1,
        "next_page_token": null
      },
      "name": "list_jobs",
      "parameters": [
        {
          "description": "Maximum number of results to return in one page (up to 100).",
          "display_name": "Limit",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "To get the next page of results, paste the next page token from a previous run's results. Leave blank to start from the first page.",
          "display_name": "Next page token",
          "name": "page_token",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only return jobs whose name matches this value exactly.",
          "display_name": "Name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/databricks/list-jobs",
      "result_str_template": "Found {1} job(s).",
      "returns": {
        "properties": {
          "has_more": {
            "description": "Whether more results are available",
            "type": "boolean"
          },
          "jobs": {
            "description": "List of jobs",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "jobs_count": {
            "description": "Number of jobs returned on this page",
            "type": "integer"
          },
          "next_page_token": {
            "description": "Token for fetching the next page",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_runs": {
      "description": "List job runs in your workspace. Optionally narrow to a single job or to only active or only completed runs.",
      "display_name": "List runs",
      "display_str_template": "List Databricks runs.",
      "handler": "actions.list_runs",
      "id": "databricks_list_runs",
      "method": "POST",
      "mock_response": {
        "has_more": false,
        "next_page_token": null,
        "runs": [
          {
            "job_id": 12345,
            "run_id": 67890,
            "run_name": "Nightly ETL",
            "state": {
              "life_cycle_state": "TERMINATED",
              "result_state": "SUCCESS"
            }
          }
        ],
        "runs_count": 1
      },
      "name": "list_runs",
      "parameters": [
        {
          "description": "Pick a job to filter by, or leave blank for all jobs.",
          "display_name": "Job",
          "dynamic_source": "jobs",
          "name": "job_id",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Only return runs that are currently active (in progress).",
          "display_name": "Active only",
          "name": "active_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Only return runs that have already finished.",
          "display_name": "Completed only",
          "name": "completed_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Maximum number of runs to return in one page (up to 25).",
          "display_name": "Limit",
          "maximum": 25,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "To get the next page of results, paste the next page token from a previous run's results. Leave blank to start from the first page.",
          "display_name": "Next page token",
          "name": "page_token",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/databricks/list-runs",
      "result_str_template": "Found {1} run(s).",
      "returns": {
        "properties": {
          "has_more": {
            "description": "Whether more results are available",
            "type": "boolean"
          },
          "next_page_token": {
            "description": "Token for fetching the next page",
            "type": "string"
          },
          "runs": {
            "description": "List of runs",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "runs_count": {
            "description": "Number of runs returned on this page",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "list_sql_warehouses": {
      "description": "List all SQL warehouses in the workspace. SQL warehouses are a separate compute type from clusters.",
      "display_name": "List SQL warehouses",
      "display_str_template": "List Databricks SQL warehouses.",
      "handler": "actions.list_sql_warehouses",
      "id": "databricks_list_sql_warehouses",
      "method": "POST",
      "mock_response": {
        "warehouses": [
          {
            "cluster_size": "Small",
            "id": "0123456789abcdef",
            "name": "Serverless Starter Warehouse",
            "state": "RUNNING"
          }
        ],
        "warehouses_count": 1
      },
      "name": "list_sql_warehouses",
      "parameters": [],
      "path": "/actions/library/databricks/list-sql-warehouses",
      "result_str_template": "Found {1} SQL warehouse(s).",
      "returns": {
        "properties": {
          "warehouses": {
            "description": "List of SQL warehouses",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "warehouses_count": {
            "description": "Number of SQL warehouses returned",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "run_job": {
      "description": "Trigger a single run of an existing Databricks job right away.",
      "display_name": "Run job",
      "display_str_template": "Run job {0} now.",
      "handler": "actions.run_job",
      "id": "databricks_run_job",
      "method": "POST",
      "mock_response": {
        "number_in_job": 1,
        "run_id": 67890
      },
      "name": "run_job",
      "parameters": [
        {
          "description": "Pick a job, or enter its numeric ID.",
          "display_name": "Job",
          "dynamic_source": "jobs",
          "name": "job_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional values to pass to the job's notebook when it runs, entered as names and values.",
          "display_name": "Notebook parameters",
          "name": "notebook_params",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/databricks/run-job",
      "result_str_template": "Started run {0} for the job.",
      "returns": {
        "properties": {
          "number_in_job": {
            "description": "The run number within the job",
            "type": "integer"
          },
          "run_id": {
            "description": "The ID of the triggered run",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "List and run jobs, inspect runs, and view SQL warehouses in your Databricks workspace.",
  "display_name": "Databricks",
  "id": "databricks"
}
