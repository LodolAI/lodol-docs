{
  "actions": {
    "create_invite_link": {
      "description": "Generate a new join link for a chat.",
      "display_name": "Create an invite link",
      "display_str_template": "Create invite link for chat '{0}'.",
      "handler": "actions.create_invite_link",
      "id": "telegram_create_invite_link",
      "method": "POST",
      "mock_response": {
        "expire_date": 1706745600,
        "invite_link": "https://t.me/+abcdef123456",
        "member_limit": 100,
        "status": "success"
      },
      "name": "create_invite_link",
      "output_formatter": "actions.format_create_invite_link_output",
      "parameters": [
        {
          "description": "The chat to create an invite link for.",
          "display_name": "Chat ID",
          "dynamic_source": "chats",
          "dynamic_source_allows_custom": true,
          "name": "chat_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional label to help you recognize this link, up to 32 characters.",
          "display_name": "Name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. When the link should expire. Leave blank for a link that never expires.",
          "display_name": "Expiration date",
          "name": "expire_date",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Optional. The maximum number of people who can join using this link, between 1 and 99999.",
          "display_name": "Member limit",
          "maximum": 99999,
          "minimum": 1,
          "name": "member_limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/telegram/create-invite-link",
      "result_str_template": "Invite link created.",
      "returns": {
        "properties": {
          "expire_date": {
            "description": "Link expiration timestamp.",
            "type": "integer"
          },
          "invite_link": {
            "description": "Telegram invite link URL.",
            "type": "string"
          },
          "member_limit": {
            "description": "Maximum users allowed.",
            "type": "integer"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "forward_message": {
      "description": "Forward a message from one chat to another.",
      "display_name": "Forward a message",
      "display_str_template": "Forward message {0} to chat '{1}'.",
      "handler": "actions.forward_message",
      "id": "telegram_forward_message",
      "method": "POST",
      "mock_response": {
        "chat_id": 123456789,
        "message_id": 12347,
        "status": "success"
      },
      "name": "forward_message",
      "output_formatter": "actions.format_forward_message_output",
      "parameters": [
        {
          "description": "The chat to forward the message to.",
          "display_name": "Destination chat",
          "dynamic_source": "chats",
          "dynamic_source_allows_custom": true,
          "name": "chat_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The chat that currently has the message.",
          "display_name": "Source chat",
          "dynamic_source": "chats",
          "dynamic_source_allows_custom": true,
          "name": "from_chat_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of the message to forward.",
          "display_name": "Message ID",
          "name": "message_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/telegram/forward-message",
      "result_str_template": "Message forwarded.",
      "returns": {
        "properties": {
          "chat_id": {
            "description": "Destination chat ID.",
            "type": "integer"
          },
          "message_id": {
            "description": "Forwarded message ID.",
            "type": "integer"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_chat_member_count": {
      "description": "Retrieve the number of members in a chat.",
      "display_name": "Get chat member count",
      "display_str_template": "Get member count for chat '{0}'.",
      "handler": "actions.get_chat_member_count",
      "id": "telegram_get_chat_member_count",
      "method": "POST",
      "mock_response": {
        "count": 147,
        "status": "success"
      },
      "name": "get_chat_member_count",
      "output_formatter": "actions.format_get_chat_member_count_output",
      "parameters": [
        {
          "description": "The chat to count members in.",
          "display_name": "Chat ID",
          "dynamic_source": "chats",
          "dynamic_source_allows_custom": true,
          "name": "chat_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/telegram/get-chat-member-count",
      "result_str_template": "Member count retrieved.",
      "returns": {
        "properties": {
          "count": {
            "description": "Member count.",
            "type": "integer"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "pin_chat_message": {
      "description": "Pin a message in a chat with optional silent notification.",
      "display_name": "Pin a chat message",
      "display_str_template": "Pin message {0} in chat '{1}'.",
      "handler": "actions.pin_chat_message",
      "id": "telegram_pin_chat_message",
      "method": "POST",
      "mock_response": {
        "status": "success"
      },
      "name": "pin_chat_message",
      "output_formatter": "actions.format_pin_chat_message_output",
      "parameters": [
        {
          "description": "The chat that has the message.",
          "display_name": "Chat ID",
          "dynamic_source": "chats",
          "dynamic_source_allows_custom": true,
          "name": "chat_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of the message to pin.",
          "display_name": "Message ID",
          "name": "message_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Set to true to pin the message without notifying members.",
          "display_name": "Disable notification",
          "name": "disable_notification",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/telegram/pin-chat-message",
      "result_str_template": "Message pinned.",
      "returns": {
        "properties": {
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "send_message": {
      "description": "Send a text message to a Telegram chat.",
      "display_name": "Send a message",
      "display_str_template": "Send a Telegram message to chat '{0}'.",
      "handler": "actions.send_message",
      "id": "telegram_send_message",
      "method": "POST",
      "mock_response": {
        "chat_id": 987654321,
        "message_id": 12345,
        "status": "success"
      },
      "name": "send_message",
      "output_formatter": "actions.format_send_message_output",
      "parameters": [
        {
          "description": "Which chat to send to. Pick it from the list, or switch to manual entry to type a numeric chat ID.",
          "display_name": "Chat ID",
          "dynamic_source": "chats",
          "dynamic_source_allows_custom": true,
          "name": "chat_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text of the message to send.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. How to format the message text. Leave blank for plain text. Prefer MarkdownV2 over Markdown, which Telegram keeps only for backward compatibility.",
          "display_name": "Text formatting",
          "name": "parse_mode",
          "options": [
            {
              "label": "HTML",
              "value": "HTML"
            },
            {
              "label": "MarkdownV2",
              "value": "MarkdownV2"
            },
            {
              "label": "Markdown (legacy)",
              "value": "Markdown"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/telegram/send-message",
      "result_str_template": "Message sent.",
      "returns": {
        "properties": {
          "chat_id": {
            "description": "Telegram chat ID.",
            "type": "integer"
          },
          "message_id": {
            "description": "Telegram message ID.",
            "type": "integer"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "send_photo": {
      "description": "Send a photo to a Telegram chat, with an optional caption.",
      "display_name": "Send a photo",
      "display_str_template": "Send a photo to chat '{0}'.",
      "handler": "actions.send_photo",
      "id": "telegram_send_photo",
      "method": "POST",
      "mock_response": {
        "chat_id": 987654321,
        "message_id": 12346,
        "status": "success"
      },
      "name": "send_photo",
      "output_formatter": "actions.format_send_photo_output",
      "parameters": [
        {
          "description": "Which chat to send to. Pick it from the list, or switch to manual entry to type a numeric chat ID.",
          "display_name": "Chat ID",
          "dynamic_source": "chats",
          "dynamic_source_allows_custom": true,
          "name": "chat_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A link to the photo you want to send.",
          "display_name": "Photo URL",
          "name": "photo_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional caption to show below the photo, up to 1024 characters.",
          "display_name": "Caption",
          "multiline": true,
          "name": "caption",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/telegram/send-photo",
      "result_str_template": "Photo sent.",
      "returns": {
        "properties": {
          "chat_id": {
            "description": "Telegram chat ID.",
            "type": "integer"
          },
          "message_id": {
            "description": "Telegram message ID.",
            "type": "integer"
          },
          "status": {
            "description": "Action execution status.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Send Telegram messages, manage chat pins, and generate invite links.",
  "display_name": "Telegram",
  "id": "telegram"
}
