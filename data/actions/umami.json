  "description": "Read your website traffic from Umami: visitors, page views, top pages and referrers, and who's on the site now, for reports and alerts. Start a workflow when traffic spikes.",
  "display_name": "Umami",
  "id": "umami",
  "logo": "https://www.lodol.com/app-icons/umami-icon.png",
  "triggers": {
    "umami_visitors_above_trigger": {
      "description": "Runs when the people on a website reach a number, such as a traffic spike. It runs again only after the count has dropped below the number.",
      "display_name": "Visitors above",
