        ],
        "total_rows": 1,
        "truncated": false
      },
      "name": "get_run_result",
      "parameters": [
        {
          "description": "The run ID returned by the Launch Phantom action. This identifies one run, and is not the Phantom's own ID. The address of the run's log page in PhantomBuster works too.",
          "display_name": "Run ID",
          "name": "container_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of rows to return.",
          "display_name": "Limit",
          "minimum": 0,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 0,
          "description": "Skip this many rows before returning results, so you can fetch large results in batches.",
          "display_name": "Rows to skip",
          "minimum": 0,
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/phantombuster/get-run-result",
      "result_str_template": "Returned {rows,length} of {total_rows} rows.",
      "returns": {
        "properties": {
          "container_id": {
            "type": "string"
          },
          "result_object": {
            "description": "What the run saved, when it isn't a list of rows.",
            "type": "object"
          },
          "result_url": {
            "description": "The file the rows came from, when the run saved too many to hold inline.",
            "type": "string"
          },
          "row_count": {
            "type": "number"
          },
          "rows": {
            "description": "The rows the run collected.",
            "items": {
