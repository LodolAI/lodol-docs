    "get_run_status": {
      "description": "Check the status of a Phantom run: running, finished, error or stopped. A run that ends with an error is reported as 'error', with the errors the Phantom gave. To wait for a run to end, use Wait for run to finish.",
      "display_name": "Get run status",
      "display_str_template": "Check status of run {0}.",
      "handler": "actions.get_run_status",
      "id": "phantombuster_get_run_status",
      "method": "POST",
      "mock_response": {
