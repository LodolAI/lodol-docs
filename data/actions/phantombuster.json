{
  "actions": {
    "describe_agent": {
      "description": "Look up a Phantom's saved settings, including its saved inputs, useful for finding the exact input field names the Phantom expects.",
      "display_name": "Describe Phantom",
      "display_str_template": "Describe Phantom {0}.",
      "handler": "actions.describe_agent",
      "id": "phantombuster_describe_agent",
      "method": "POST",
      "mock_response": {
        "argument": {
          "columnName": "profileUrl",
          "sessionCookie": "<li_at cookie>",
          "spreadsheetUrl": "https://docs.google.com/spreadsheets/d/..."
        },
        "id": "1234567890123456",
        "name": "LinkedIn Followers Export",
        "script": "LinkedIn Profile Scraper"
      },
      "name": "describe_agent",
      "parameters": [
        {
          "description": "The ID of the Phantom to describe.",
          "display_name": "Phantom ID",
          "name": "agent_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/phantombuster/describe-agent",
      "result_str_template": "Described Phantom {name}.",
      "returns": {
        "properties": {
          "argument": {
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "script": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "fetch_result": {
      "description": "Bring a Phantom's results (the rows it collected) into the workflow. For large results, use the Limit and Rows to skip fields to fetch a portion at a time; a link to the full results file is always included.",
      "display_name": "Fetch result data",
      "display_str_template": "Fetch results for Phantom {0}.",
      "handler": "actions.fetch_result",
      "id": "phantombuster_fetch_result",
      "method": "POST",
      "mock_response": {
        "format": "json",
        "result_url": "https://phantombuster.s3.amazonaws.com/orgFolder/agentFolder/result.json",
        "row_count": 1,
        "rows": [
          {
            "email": "jane@example.com",
            "firstName": "Jane",
            "lastName": "Doe",
            "profileUrl": "https://www.linkedin.com/in/jane-doe"
          }
        ],
        "total_rows": 1,
        "truncated": false
      },
      "name": "fetch_result",
      "parameters": [
        {
          "description": "The ID of the Phantom whose results to fetch.",
          "display_name": "Phantom ID",
          "name": "agent_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional run ID to note which run these results relate to. The latest results file is read either way.",
          "display_name": "Run ID",
          "name": "container_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "auto",
          "description": "Result file format: 'auto', 'json', or 'csv'.",
          "display_name": "Format",
          "name": "format",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of rows to return.",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 0,
          "description": "Skip this many rows before returning results, so you can fetch large results in batches.",
          "display_name": "Rows to skip",
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/phantombuster/fetch-result",
      "result_str_template": "Returned {rows,length} of {total_rows} rows.",
      "returns": {
        "properties": {
          "format": {
            "type": "string"
          },
          "result_url": {
            "type": "string"
          },
          "row_count": {
            "type": "number"
          },
          "rows": {
            "description": "Parsed result rows.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "total_rows": {
            "type": "number"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "get_run_status": {
      "description": "Check the status of a Phantom run. Keep checking until the status is 'finished' or 'error'.",
      "display_name": "Get run status",
      "display_str_template": "Check status of run {0}.",
      "handler": "actions.get_run_status",
      "id": "phantombuster_get_run_status",
      "method": "POST",
      "mock_response": {
        "container_id": "9876543210987654",
        "ended_at": 1716969600000,
        "progress": 100,
        "raw_status": "finished",
        "status": "finished"
      },
      "name": "get_run_status",
      "parameters": [
        {
          "description": "The run ID returned by the Launch Phantom action. This identifies one run, and is not the Phantom's own ID.",
          "display_name": "Run ID",
          "name": "container_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/phantombuster/get-run-status",
      "result_str_template": "Run status: {status}.",
      "returns": {
        "properties": {
          "container_id": {
            "type": "string"
          },
          "ended_at": {
            "type": "number"
          },
          "progress": {
            "type": "number"
          },
          "raw_status": {
            "type": "string"
          },
          "status": {
            "description": "running | finished | error | unknown",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "launch_agent": {
      "description": "Launch a Phantom. Any run inputs you provide (for example, a spreadsheet URL, a column name, or a profile URL) apply to this run only. The run continues in the background, so use Get run status with the returned run ID to see when it finishes.",
      "display_name": "Launch Phantom",
      "display_str_template": "Launch Phantom {0}.",
      "handler": "actions.launch_agent",
      "id": "phantombuster_launch_agent",
      "method": "POST",
      "mock_response": {
        "container_id": "9876543210987654",
        "status": "launched"
      },
      "name": "launch_agent",
      "parameters": [
        {
          "description": "The ID of the Phantom to launch.",
          "display_name": "Phantom ID",
          "name": "agent_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Inputs for this run only, such as a spreadsheet URL or profile URL. They override the Phantom's saved settings for this launch.",
          "display_name": "Run inputs",
          "name": "arguments",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Only launch if fewer than this many runs of this Phantom are already in progress. Helps you stay within your PhantomBuster limits.",
          "display_name": "Max runs at once",
          "name": "max_instance_count",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Your own labels and values to save with this run, so you can identify it later.",
          "display_name": "Metadata",
          "name": "metadata",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/phantombuster/launch-agent",
      "result_str_template": "Launched run {container_id}.",
      "returns": {
        "properties": {
          "container_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_agents": {
      "description": "List all Phantoms in the connected PhantomBuster workspace, so you can pick which one to launch.",
      "display_name": "List Phantoms",
      "display_str_template": "List PhantomBuster Phantoms.",
      "handler": "actions.list_agents",
      "id": "phantombuster_list_agents",
      "method": "POST",
      "mock_response": {
        "agent_count": 1,
        "agents": [
          {
            "id": "1234567890123456",
            "name": "LinkedIn Followers Export",
            "script": "LinkedIn Profile Scraper"
          }
        ]
      },
      "name": "list_agents",
      "parameters": [],
      "path": "/actions/library/phantombuster/list-agents",
      "result_str_template": "Found {agents,length} Phantoms.",
      "returns": {
        "properties": {
          "agent_count": {
            "type": "number"
          },
          "agents": {
            "description": "List of Phantoms with id, name, and script.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Launch PhantomBuster Phantoms and pull their extracted data (LinkedIn, social, and web scraping results) into your workflows.",
  "display_name": "PhantomBuster",
  "id": "phantombuster"
}
