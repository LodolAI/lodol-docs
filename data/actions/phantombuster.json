    "fetch_result": {
      "description": "Bring a Phantom's results file (the rows it has collected across its runs) into the workflow. For one run's rows only, use Get run results. For large results, use the Limit and Rows to skip fields to fetch a portion at a time; a link to the full results file is always included.",
      "display_name": "Fetch result data",
      "display_str_template": "Fetch results for Phantom {0}.",
      "handler": "actions.fetch_result",
      "id": "phantombuster_fetch_result",
      "method": "POST",
      "mock_response": {
        "format": "json",
        "result_url": "https://phantombuster.s3.amazonaws.com/orgFolder/agentFolder/result.json",
        "row_count": 1,
        "rows": [
          {
            "email": "jane@example.com",
            "firstName": "Jane",
            "lastName": "Doe",
            "profileUrl": "https://www.linkedin.com/in/jane-doe"
          }
        ],
        "total_rows": 1,
        "truncated": false
      },
      "name": "fetch_result",
      "parameters": [
        {
          "description": "The Phantom whose results to fetch.",
          "display_name": "Phantom",
          "dynamic_source": "agents",
          "dynamic_source_allows_custom": true,
          "name": "agent_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional run ID to note which run these results relate to. The results file is read either way; Get run results reads just one run's rows.",
          "display_name": "Run ID",
          "name": "container_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "auto",
          "description": "Which results file to read. Auto reads the JSON file and falls back to the CSV one, which is all PhantomBuster's free plan exports.",
          "display_name": "Format",
          "name": "format",
          "options": [
            {
              "label": "Auto",
              "value": "auto"
            },
            {
              "label": "JSON",
              "value": "json"
            },
            {
              "label": "CSV",
              "value": "csv"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of rows to return.",
          "display_name": "Limit",
          "minimum": 0,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 0,
          "description": "Skip this many rows before returning results, so you can fetch large results in batches.",
          "display_name": "Rows to skip",
          "minimum": 0,
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/phantombuster/fetch-result",
      "result_str_template": "Returned {rows,length} of {total_rows} rows.",
      "returns": {
        "properties": {
          "format": {
            "type": "string"
          },
          "result_url": {
            "type": "string"
          },
          "row_count": {
            "type": "number"
          },
          "rows": {
            "description": "Parsed result rows.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "total_rows": {
            "type": "number"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "get_run_result": {
      "beta": true,
      "description": "Bring the rows one run collected into the workflow, by its run ID. Unlike Fetch result data, which reads everything the Phantom has collected across its runs, this is only what that run found. Use it once the run has finished.",
      "display_name": "Get run results",
      "display_str_template": "Get results of run {0}.",
      "handler": "actions.get_run_result",
      "id": "phantombuster_get_run_result",
