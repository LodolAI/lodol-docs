{
  "actions": {
    "create_agent": {
      "beta": true,
      "description": "Add a Phantom to the workspace from PhantomBuster's catalogue, such as a LinkedIn Profile Scraper, optionally with its inputs filled in. It uses one of your plan's Phantom slots.",
      "display_name": "Create Phantom",
      "display_str_template": "Create a {0} Phantom.",
      "handler": "actions.create_agent",
      "id": "phantombuster_create_agent",
      "method": "POST",
      "mock_response": {
        "agent_id": "1234567890123457",
        "name": "Profile Scraper for Lodol",
        "script": "LinkedIn Profile Scraper"
      },
      "name": "create_agent",
      "parameters": [
        {
          "description": "The Phantom to create, named exactly as its page on phantombuster.com shows it.",
          "display_name": "Phantom type",
          "examples": [
            {
              "label": "LinkedIn Profile Scraper",
              "value": "LinkedIn Profile Scraper"
            },
            {
              "label": "LinkedIn Search Export",
              "value": "LinkedIn Search Export"
            },
            {
              "label": "Instagram Follower Collector",
              "value": "Instagram Follower Collector"
            }
          ],
          "name": "script",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to call the Phantom in your workspace, up to 100 characters.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Phantom's inputs and settings, under the field names it uses, such as spreadsheetUrl, sessionCookie or numberOfProfiles. You can paste the JSON from the Phantom's JSON view in PhantomBuster.",
          "display_name": "Inputs",
          "name": "arguments",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/phantombuster/create-agent",
      "result_str_template": "Created Phantom {agent_id}.",
      "returns": {
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "script": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_agent": {
      "beta": true,
      "description": "Delete a Phantom from the workspace, freeing its slot. PhantomBuster won't delete a Phantom while it is running.",
      "display_name": "Delete Phantom",
      "display_str_template": "Delete Phantom {0}.",
      "handler": "actions.delete_agent",
      "id": "phantombuster_delete_agent",
      "method": "POST",
      "mock_response": {
        "agent_id": "1234567890123457",
        "deleted": true
      },
      "name": "delete_agent",
      "parameters": [
        {
          "description": "The Phantom. Pick it from the list, give its ID, or paste the address of its page in PhantomBuster: the ID is the number after /phantoms/.",
          "display_name": "Phantom",
          "dynamic_source": "agents",
          "dynamic_source_allows_custom": true,
          "name": "agent_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/phantombuster/delete-agent",
      "result_str_template": "Deleted Phantom {agent_id}.",
