      "parameters": [
        {
          "description": "The run ID returned by the Launch Phantom action. This identifies one run, and is not the Phantom's own ID. The address of the run's log page in PhantomBuster works too.",
          "display_name": "Run ID",
          "name": "container_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
