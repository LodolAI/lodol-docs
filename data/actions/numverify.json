      "path": "/actions/library/numverify/validate-phone-number",
      "result_str_template": "Phone number checked.",
      "returns": {
        "properties": {
          "carrier": {
            "description": "The phone company the number is registered with, where known",
            "type": "string"
          },
          "country_code": {
            "description": "The number's two-letter country code, e.g. US",
            "type": "string"
          },
          "country_name": {
            "description": "That country's name",
            "type": "string"
          },
          "dialling_code": {
            "description": "That country's dialling code, e.g. +1",
            "type": "string"
          },
          "extension": {
            "description": "The extension written after the number, if there was one",
            "type": "string"
          },
          "international_format": {
            "description": "The number with its country code, e.g. +14158586273: the format to store, or to send a text or call to",
            "type": "string"
