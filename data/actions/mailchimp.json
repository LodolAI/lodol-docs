              "properties": {
                "id": {
                  "description": "Tag ID",
                  "type": "integer"
                },
                "name": {
                  "description": "Tag name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
