{
  "actions": {
    "add_member_to_audience": {
      "description": "Add or subscribe a contact to a Mailchimp audience.",
      "display_name": "Add member to audience",
      "display_str_template": "Add member {0} to audience {1}",
      "handler": "actions.add_member_to_audience",
      "id": "mailchimp_add_member",
      "method": "POST",
      "mock_response": {
        "email_address": "user@example.com",
        "id": "abc123xyz789",
        "status": "subscribed",
        "unique_email_id": "abc123xyz789"
      },
      "name": "add_member_to_audience",
      "parameters": [
        {
          "description": "The ID of the Mailchimp audience.",
          "display_name": "Audience ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Subscriber email",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "subscribed",
          "description": "Whether the contact is subscribed now, or pending until they confirm via email.",
          "display_name": "Subscription status",
          "name": "status",
          "options": [
            {
              "label": "Subscribed",
              "value": "subscribed"
            },
            {
              "label": "Pending (send a confirmation email first)",
              "value": "pending"
            },
            {
              "label": "Unsubscribed",
              "value": "unsubscribed"
            },
            {
              "label": "Cleaned (invalid or bounced)",
              "value": "cleaned"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "First name",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailchimp/add-member",
      "result_str_template": "Member added.",
      "returns": {
        "properties": {
          "email_address": {
            "description": "Member's email address",
            "type": "string"
          },
          "id": {
            "description": "Member ID (MD5 hash of lowercase email address)",
            "type": "string"
          },
          "status": {
            "description": "Subscription status",
            "type": "string"
          },
          "unique_email_id": {
            "description": "Unique identifier for this email address",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_audience": {
      "description": "Create a new Mailchimp audience with contact and sender defaults.",
      "display_name": "Create a Mailchimp audience",
      "display_str_template": "Create Mailchimp audience '{0}'",
      "handler": "actions.create_audience",
      "id": "mailchimp_create_audience",
      "method": "POST",
      "mock_response": {
        "id": "abc123xyz789",
        "name": "Newsletter Subscribers",
        "web_id": 1
      },
      "name": "create_audience",
      "parameters": [
        {
          "description": "Audience name",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A short note reminding subscribers why they're receiving your emails.",
          "display_name": "Permission reminder",
          "name": "permission_reminder",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Default from name",
          "display_name": "From name",
          "name": "from_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Default from email",
          "display_name": "From email",
          "name": "from_email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Company name",
          "display_name": "Company",
          "name": "company",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Street address",
          "display_name": "Street address",
          "name": "address1",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "City",
          "display_name": "City",
          "name": "city",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "State or region. Mailchimp requires this for the audience contact address.",
          "display_name": "State / region",
          "name": "state",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ZIP or postal code. Mailchimp requires this for the audience contact address.",
          "display_name": "ZIP / postal code",
          "name": "zip",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Country",
          "display_name": "Country",
          "name": "country",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Set to true to let subscribers choose between HTML and plain-text emails.",
          "display_name": "Email type option",
          "name": "email_type_option",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/mailchimp/create-audience",
      "result_str_template": "Audience created.",
      "returns": {
        "properties": {
          "id": {
            "description": "Mailchimp audience/list ID",
            "type": "string"
          },
          "name": {
            "description": "Audience name as displayed in Mailchimp",
            "type": "string"
          },
          "web_id": {
            "description": "Web-accessible ID for the audience",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "create_campaign": {
      "description": "Create a new campaign for a given audience.",
      "display_name": "Create a Mailchimp campaign",
      "display_str_template": "Create campaign '{0}'",
      "handler": "actions.create_campaign",
      "id": "mailchimp_create_campaign",
      "method": "POST",
      "mock_response": {
        "id": "abc123xyz789",
        "status": "save",
        "type": "regular",
        "web_id": 1
      },
      "name": "create_campaign",
      "parameters": [
        {
          "description": "The ID of the Mailchimp audience.",
          "display_name": "Audience ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Campaign subject",
          "display_name": "Subject",
          "name": "subject",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Sender name",
          "display_name": "From name",
          "name": "from_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Reply-to email",
          "display_name": "Reply to",
          "name": "reply_to",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "regular",
          "description": "The kind of email campaign to create.",
          "display_name": "Campaign type",
          "name": "type",
          "options": [
            {
              "label": "Regular (standard HTML email)",
              "value": "regular"
            },
            {
              "label": "Plain-text email",
              "value": "plaintext"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailchimp/create-campaign",
      "result_str_template": "Campaign created.",
      "returns": {
        "properties": {
          "id": {
            "description": "Mailchimp campaign ID",
            "type": "string"
          },
          "status": {
            "description": "Current campaign status",
            "type": "string"
          },
          "type": {
            "description": "Campaign type",
            "type": "string"
          },
          "web_id": {
            "description": "Web-accessible ID for the campaign",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "create_tag_and_assign_member": {
      "description": "Create a tag and apply it to a subscriber.",
      "display_name": "Tag a Mailchimp member",
      "display_str_template": "Tag member {0} with '{1}'",
      "handler": "actions.create_tag_and_assign_member",
      "id": "mailchimp_tag_member",
      "method": "POST",
      "mock_response": {
        "tags": [
          {
            "id": 1,
            "name": "VIP"
          }
        ]
      },
      "name": "create_tag_and_assign_member",
      "parameters": [
        {
          "description": "The ID of the Mailchimp audience.",
          "display_name": "Audience ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Subscriber email",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Tag name",
          "display_name": "Tag name",
          "name": "tag_name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailchimp/tag-member",
      "result_str_template": "Member tagged.",
      "returns": {
        "properties": {
          "tags": {
            "description": "Array of all tags assigned to this member",
