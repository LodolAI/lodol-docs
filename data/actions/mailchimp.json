    "set_campaign_content": {
      "description": "Set the HTML and/or plain-text content of a campaign so it is ready to send.",
      "display_name": "Set Mailchimp campaign content",
      "display_str_template": "Set content for campaign {0}",
      "handler": "actions.set_campaign_content",
      "id": "mailchimp_set_campaign_content",
      "method": "POST",
      "mock_response": {
        "html": "<p>This is a test campaign. Please ignore.</p>",
        "plain_text": "This is a test campaign. Please ignore."
      },
      "name": "set_campaign_content",
      "parameters": [
        {
          "description": "The ID of the Mailchimp campaign to set content for.",
          "display_name": "Campaign ID",
          "name": "campaign_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Full HTML body of the email. Provide this and/or plain-text content.",
          "display_name": "HTML content",
          "name": "html",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Plain-text body of the email. Provide this and/or HTML content.",
