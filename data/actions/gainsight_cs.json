    "create_timeline_activity": {
      "description": "Log an activity on a company's Timeline. Fill Company, Author email, Subject, Notes and Activity type; use Advanced records for other contexts.",
      "display_name": "Create timeline activity",
      "display_str_template": "Log an activity on a company's Timeline. Fill Company, Author email, Subject, Notes and Activity type; use Advanced records for other contexts.",
      "handler": "actions.create_timeline_activity",
      "id": "gainsight_cs_create_timeline_activity",
      "method": "POST",
      "mock_response": {
        "response": {
          "result": true
        }
      },
      "name": "create_timeline_activity",
      "output_formatter": "documented_api.render_response",
      "parameters": [
        {
          "description": "Use this list and Lookups for other activity contexts or tenant-specific fields. Leave the individual fields empty.",
          "display_name": "Advanced records",
          "name": "records",
          "required": false,
          "schema": {
            "items": {
              "type": "object"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "For advanced records, map values such as emails to Gainsight IDs. Leave empty when using the individual activity fields.",
          "display_name": "Advanced lookups",
          "name": "lookups",
          "required": false,
          "schema": {
            "type": "object"
          },
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The company whose Timeline receives the activity.",
          "display_name": "Company",
          "dynamic_source": "companies",
          "dynamic_source_allows_custom": true,
          "name": "company_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Gainsight user who owns the activity. Their email is resolved automatically.",
          "display_name": "Author email",
          "name": "author_email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The activity subject.",
          "display_name": "Subject",
          "name": "subject",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The activity notes. HTML is supported.",
          "display_name": "Notes",
          "multiline": true,
          "name": "notes",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The activity type name from your Gainsight account, such as Update.",
          "display_name": "Activity type",
          "name": "type_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The activity time. Leave empty to use Gainsight\u2019s current time.",
          "display_name": "Activity date",
          "name": "activity_date",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Your unique activity identifier. Leave empty to generate one automatically.",
          "display_name": "External ID",
          "name": "external_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
