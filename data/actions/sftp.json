{
  "actions": {
    "delete_file": {
      "description": "Delete a file from the server, or an empty folder, such as an export once it has been processed.",
      "display_name": "Delete a file",
      "display_str_template": "Delete {path}",
      "handler": "actions.delete_file",
      "id": "sftp_delete_file",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "path": "/exports/report.csv"
      },
      "name": "delete_file",
      "output_formatter": "actions.format_delete_output",
      "parameters": [
        {
          "description": "The full path of the file to delete, such as /incoming/report.csv. A folder is deleted only when it is empty.",
          "display_name": "Path",
          "name": "path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "fail",
          "description": "What to do when nothing is at that path: stop the workflow, or carry on, which suits a cleanup step that may run more than once.",
          "display_name": "If there is no such file",
          "name": "if_missing",
          "options": [
            {
              "label": "Stop the workflow",
              "value": "fail"
            },
            {
              "label": "Carry on",
              "value": "ignore"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sftp/delete-file",
      "returns": {
        "description": "Whether something was deleted.",
        "examples": [
          {
            "deleted": true,
            "path": "/exports/report.csv"
          },
          {
            "deleted": false,
            "path": "/incoming/old.csv"
          }
        ],
        "properties": {
          "deleted": {
            "description": "True when a file or folder was deleted; false when there was nothing there and the step carried on.",
            "type": "boolean"
          },
          "path": {
            "description": "The path that was deleted.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "download_file": {
      "description": "Fetch a file from the server and store it, ready to read with Read a file, attach to an email, or upload somewhere else. Files are kept for 30 days.",
      "display_name": "Download a file",
      "display_str_template": "Download {path}",
      "handler": "actions.download_file",
      "id": "sftp_download_file",
      "method": "POST",
      "mock_response": {
        "content_type": "text/csv",
        "document_ref": "doc_7f3b2c9e4d1a4f0b8e6c5a1d2b3c4d5e",
        "documents": [
          {
            "content_type": "text/csv",
            "document_ref": "doc_7f3b2c9e4d1a4f0b8e6c5a1d2b3c4d5e",
            "filename": "report.csv",
            "size_bytes": 18422
          }
        ],
        "filename": "report.csv",
        "modified_at": "2026-03-09T06:00:12Z",
        "path": "/exports/report.csv",
        "size_bytes": 18422
      },
      "name": "download_file",
      "output_formatter": "actions.format_download_output",
      "parameters": [
        {
          "description": "The file's full path on the server, such as /exports/report.csv. Use List files to find it.",
          "display_name": "Path",
          "name": "path",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sftp/download-file",
      "returns": {
        "description": "The downloaded file, stored for 30 days. Pass document_ref to any step that takes a file, or documents to one that takes several, such as an email's attachments.",
        "examples": [
          {
            "content_type": "text/csv",
            "document_ref": "doc_7f3b2c9e4d1a4f0b8e6c5a1d2b3c4d5e",
            "documents": [
              {
                "content_type": "text/csv",
                "document_ref": "doc_7f3b2c9e4d1a4f0b8e6c5a1d2b3c4d5e",
                "filename": "report.csv",
                "size_bytes": 18422
              }
            ],
            "filename": "report.csv",
            "modified_at": "2026-03-09T06:00:12Z",
            "path": "/exports/report.csv",
            "size_bytes": 18422
          }
        ],
        "properties": {
          "content_type": {
            "description": "The file's type, worked out from its name.",
            "type": "string"
          },
          "document_ref": {
            "description": "The stored file's id, for later steps.",
            "type": "string"
          },
          "documents": {
            "description": "The same file as a one-entry list, the shape a download step returns.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "filename": {
            "description": "The file's name.",
            "type": "string"
          },
          "modified_at": {
            "description": "When the file was last changed on the server, in UTC.",
            "nullable": true,
            "type": "string"
          },
          "path": {
            "description": "Where it was on the server.",
            "type": "string"
          },
          "size_bytes": {
            "description": "The file's size.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "list_files": {
      "description": "See what a folder on the server holds: each file and folder with its path, size and when it last changed. Go through the list with a Repeat for each to download, move or delete each file.",
      "display_name": "List files",
      "display_str_template": "List files in {folder}",
      "handler": "actions.list_files",
      "id": "sftp_list_files",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "files": [
          {
            "link": false,
            "modified_at": "2026-03-09T06:00:12Z",
            "name": "report.csv",
            "path": "/exports/report.csv",
            "size_bytes": 18422,
            "type": "file"
          },
          {
            "link": false,
            "modified_at": "2026-02-28T17:45:03Z",
            "name": "archive",
            "path": "/exports/archive",
            "size_bytes": null,
            "type": "folder"
          }
        ],
        "folder": "/exports",
        "truncated": false
      },
      "name": "list_files",
      "output_formatter": "actions.format_list_output",
      "parameters": [
        {
          "description": "The folder on the server, such as /uploads. A path without a leading / is inside the folder the account lands in when it signs in, and . is that folder itself.",
          "display_name": "Folder",
          "examples": [
            {
              "label": "A folder",
              "value": "/exports"
            },
            {
              "label": "The sign-in folder",
              "value": "."
            }
          ],
          "name": "folder",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Also list what each folder inside it holds, all the way down.",
          "display_name": "Include files in subfolders",
          "name": "recursive",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/sftp/list-files",
      "returns": {
        "description": "The folder's entries, folders included, in name order.",
        "examples": [
          {
            "count": 2,
            "files": [
              {
                "link": false,
                "modified_at": "2026-03-09T06:00:12Z",
                "name": "report.csv",
                "path": "/exports/report.csv",
                "size_bytes": 18422,
                "type": "file"
              },
              {
                "link": false,
                "modified_at": "2026-02-28T17:45:03Z",
                "name": "archive",
                "path": "/exports/archive",
                "size_bytes": null,
                "type": "folder"
              }
            ],
            "folder": "/exports",
            "truncated": false
          }
        ],
        "properties": {
          "count": {
            "description": "How many entries were listed.",
            "type": "integer"
          },
          "files": {
            "description": "One entry per file or folder: name, path, type (file or folder), size_bytes (files only), modified_at, and link, true for a link, which is listed as what it points to (type link when that can't be reached).",
            "items": {
              "properties": {
                "link": {
                  "type": "boolean"
                },
                "modified_at": {
                  "nullable": true,
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "size_bytes": {
                  "nullable": true,
                  "type": "integer"
                },
                "type": {
                  "enum": [
                    "file",
                    "folder",
                    "link",
                    "other"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "folder": {
            "description": "The folder that was listed.",
            "type": "string"
          },
          "truncated": {
            "description": "True when the folder holds more than 10,000 entries and only the first of them are listed.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "move_file": {
      "description": "Move a file into another folder, give it a new name, or both, such as moving a processed export into an archive folder. The destination folder is created if it isn't there.",
      "display_name": "Move or rename a file",
      "display_str_template": "Move {path} to {new_path}",
      "handler": "actions.move_file",
      "id": "sftp_move_file",
      "method": "POST",
      "mock_response": {
        "filename": "report-2026-03-09.csv",
        "folder": "/archive",
        "path": "/archive/report-2026-03-09.csv",
        "previous_path": "/exports/report.csv",
        "replaced": false
      },
      "name": "move_file",
      "output_formatter": "actions.format_move_output",
      "parameters": [
        {
          "description": "The file's current full path on the server, such as /incoming/report.csv.",
          "display_name": "Path",
          "name": "path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Where the file goes: its new full path, such as /archive/report-march.csv, or an existing folder, such as /archive, to move it there under its own name.",
          "display_name": "New path",
          "name": "new_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "replace",
          "description": "What to do when a file with that name already exists at the destination: replace it, or stop the workflow so nothing is overwritten.",
          "display_name": "If a file is already there",
          "name": "if_exists",
          "options": [
            {
              "label": "Replace it",
              "value": "replace"
            },
            {
              "label": "Stop the workflow",
              "value": "fail"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sftp/move-file",
      "returns": {
        "description": "Where the file is now.",
        "examples": [
          {
            "filename": "report-2026-03-09.csv",
            "folder": "/archive",
            "path": "/archive/report-2026-03-09.csv",
            "previous_path": "/exports/report.csv",
            "replaced": false
          }
        ],
        "properties": {
          "filename": {
            "description": "Its name now.",
            "type": "string"
          },
          "folder": {
            "description": "The folder it is in now.",
            "type": "string"
          },
          "path": {
            "description": "The file's full path now.",
            "type": "string"
          },
          "previous_path": {
            "description": "Where it was.",
            "type": "string"
          },
          "replaced": {
            "description": "Whether a file at the new path was replaced.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
    "upload_file": {
      "description": "Put a file on the server: an upload, an email attachment, or a file an earlier step made or downloaded. The folder is created if it isn't there yet, and the file keeps its own name unless you give it another.",
      "display_name": "Upload a file",
      "display_str_template": "Upload {file} to {folder}",
      "handler": "actions.upload_file",
      "id": "sftp_upload_file",
      "method": "POST",
      "mock_response": {
        "filename": "report.csv",
        "folder": "/uploads",
        "path": "/uploads/report.csv",
        "replaced": false,
        "size_bytes": 18422
      },
      "name": "upload_file",
      "output_formatter": "actions.format_upload_output",
      "parameters": [
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "autofill_name_param": "filename",
          "description": "The file to upload. Upload one, or pick a file from an earlier step, such as an email attachment or a file Create a file made.",
          "display_name": "File",
          "name": "file",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The folder on the server, such as /uploads. A path without a leading / is inside the folder the account lands in when it signs in, and . is that folder itself. It is created, with any folders above it, if it doesn't exist.",
          "display_name": "Folder",
          "examples": [
            {
              "label": "A folder",
              "value": "/uploads"
            },
            {
              "label": "The sign-in folder",
              "value": "."
            }
          ],
          "name": "folder",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name to save the file under, such as report.csv. Leave it empty to keep the file's own name.",
          "display_name": "File name",
          "name": "filename",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "replace",
          "description": "What to do when a file with that name already exists at the destination: replace it, or stop the workflow so nothing is overwritten.",
          "display_name": "If a file is already there",
          "name": "if_exists",
          "options": [
            {
              "label": "Replace it",
              "value": "replace"
            },
            {
              "label": "Stop the workflow",
              "value": "fail"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sftp/upload-file",
      "returns": {
        "description": "Where the file was put on the server.",
        "examples": [
          {
            "filename": "report.csv",
            "folder": "/uploads",
            "path": "/uploads/report.csv",
            "replaced": false,
            "size_bytes": 18422
          }
        ],
        "properties": {
          "filename": {
            "description": "The name it was saved under.",
            "type": "string"
          },
          "folder": {
            "description": "The folder it was put in.",
            "type": "string"
          },
          "path": {
            "description": "The file's full path on the server.",
            "type": "string"
          },
          "replaced": {
            "description": "Whether a file of that name was already there and was replaced.",
            "type": "boolean"
          },
          "size_bytes": {
            "description": "How many bytes were uploaded.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    }
  },
  "categories": [
    "File Storage",
    "Cloud Computing"
  ],
  "description": "Upload, download, list, move and delete files on any server that speaks SFTP (file transfer over SSH): a hosting account, a bank's or supplier's file drop, a NAS, or a legacy system's export folder.",
  "display_name": "SFTP",
  "id": "sftp",
  "logo": "https://www.lodol.com/app-icons/sftp-icon.svg",
  "triggers": {}
}
