          "battery": 80,
          "calibrate": true,
          "deviceId": "C271111EC0AB",
          "deviceType": "Curtain3",
          "group": false,
          "hubDeviceId": "FA7310762361",
          "moving": false,
          "slidePosition": 0,
          "version": "V4.2"
