  "categories": [
    "Smart Home & Cars"
  ],
  "description": "Control your SwitchBot smart home: turn devices on or off, press a Bot, lock or unlock a door, move curtains, send any command to a device or infrared remote, read a device's status and run scenes. Start a workflow when a device's status changes.",
  "display_name": "SwitchBot",
  "id": "switchbot",
  "logo": "https://www.lodol.com/app-icons/switchbot-icon.png",
  "triggers": {
    "switchbot_device_status_changed_trigger": {
      "description": "Runs when a SwitchBot device's status changes, such as a lock being unlocked, a contact sensor opening, a plug turning off or a curtain moving. Watch every value the device reports, or only the ones you name. Each check uses one of your account's 10,000 SwitchBot calls a day, so watch only the devices you need.",
      "display_name": "Device status changed",
      "id": "switchbot_device_status_changed_trigger",
      "output": {
        "changed_fields": "The names of the values that changed",
        "checked_at": "When the change was noticed (ISO 8601)",
        "device_id": "The device's ID, for the SwitchBot steps",
        "device_type": "Its type, such as Smart Lock or Contact Sensor",
        "previous": "What each changed value was at the look before",
        "status": "Every value the device reports now"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The SwitchBot device to watch.",
          "display_name": "Device",
          "name": "device_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "The status values to watch, separated by commas, as 'Get device status' names them, such as lockState, or power, battery. Leave blank to watch every value; a sensor's temperature then starts a run each time it moves.",
          "display_name": "Only these values",
          "name": "fields",
          "required": false
        }
      ]
    }
  }
}
