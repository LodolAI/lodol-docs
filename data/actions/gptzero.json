{
  "actions": {
    "detect_ai_text": {
      "description": "Detect AI in text.",
      "display_name": "Detect AI in text",
      "display_str_template": "Detect AI in text.",
      "handler": "actions.detect_ai_text",
      "id": "gptzero_detect_ai_text",
      "method": "POST",
      "mock_response": {
        "data": {
          "documents": [],
          "neatVersion": "example",
          "scanId": "example",
          "version": "example"
        },
        "has_more": false,
        "next_cursor": "example"
      },
      "name": "detect_ai_text",
      "output_formatter": "catalog_rest.format_result",
      "parameters": [
        {
          "description": "The text to scan.",
          "display_name": "Document",
          "name": "document",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The model version to use. Defaults to the latest version. `GET /v2/model-versions/ai-scan` lists the available versions, and the [release notes](https://docs.superhuman.com/d/Project-engineering-import_doYGpUuF477/GPTZero-Release-Notes-Model-and-API_suN_Kut5#_luA8d53F) say what changed in each. An unknown version is rejected with a `400` that lists the valid ones.",
          "display_name": "ModelVersion",
          "name": "modelVersion",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gptzero/detect-ai-text",
      "result_str_template": "Request completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The scan result. Each document is split into sentences and grouped into paragraphs, so you can use the result at the level of detail you need.",
            "properties": {
              "documents": {
                "description": "Documents.",
                "items": {
                  "properties": {
                    "average_generated_prob": {
                      "description": "**Internal.** Don't use this field to evaluate the detector. The average probability that each sentence was generated by AI.",
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "class_probabilities": {
                      "description": "The probability the detector assigns to each class, from 0 to 1. The probability of `predicted_class` is the chance the prediction is correct.",
                      "properties": {
                        "ai": {
                          "description": "Ai.",
                          "maximum": 1,
                          "minimum": 0,
                          "type": "number"
                        },
                        "human": {
                          "description": "Human.",
                          "maximum": 1,
                          "minimum": 0,
                          "type": "number"
                        },
                        "mixed": {
                          "description": "Mixed.",
                          "maximum": 1,
                          "minimum": 0,
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "completely_generated_prob": {
                      "description": "The probability that the whole document was generated by AI, with little or no human involvement. From 0 to 1.",
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "confidence_category": {
                      "description": "How confident the detector is in `predicted_class`. The thresholds are set so that `high` confidence has an error rate under 1%.\n\n- `high`, `medium`, `low`: the confidence band.\n- `reject`: the confidence is at or below the `reject` threshold, too low to call.",
                      "enum": [
                        "high",
                        "medium",
                        "low",
                        "reject"
                      ],
                      "type": "string"
                    },
                    "confidence_score": {
                      "description": "**Internal.** A normalized confidence score used for visualization. Show `confidence_category` to your users instead.",
                      "type": "number"
                    },
                    "document_classification": {
                      "description": "A simpler classification of the document.\n\n- `HUMAN_ONLY`: the document is most likely written mostly by a human.\n- `MIXED`: part of the document has a strong AI signature, or the whole document has a weak one.\n- `AI_ONLY`: the document was written entirely by AI.",
                      "type": "string"
                    },
                    "document_id": {
                      "description": "The ID of the scanned document.",
                      "type": "string"
                    },
                    "excluded_spans": {
                      "description": "The parts of the document that were masked out of AI scoring.",
                      "items": {
                        "description": "A part of the document that was masked out of AI scoring.",
                        "properties": {
                          "end": {
                            "description": "The index in the document where the masked text ends.",
                            "type": "integer"
                          },
                          "reason": {
                            "description": "Why the text was masked.",
                            "type": "string"
                          },
                          "start": {
                            "description": "The index in the document where the masked text starts.",
                            "type": "integer"
                          },
                          "text": {
                            "description": "The masked text.",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "paragraphs": {
                      "description": "The paragraphs in the document. A paragraph is text separated by newlines.",
                      "items": {
                        "properties": {
                          "completely_generated_prob": {
                            "description": "**Internal.** Kept for backward compatibility. Don't use this field.",
                            "type": "number"
                          },
                          "num_sentences": {
                            "description": "The number of sentences in the paragraph.",
                            "type": "integer"
                          },
                          "start_sentence_index": {
                            "description": "The index in `sentences` of the paragraph's first sentence.",
                            "type": "integer"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "predicted_class": {
                      "description": "The class the detector thinks is most likely. Use it with `class_probabilities` to see how likely the prediction is to be correct, and with `result_message` for what to show your users.\n\n- `human`: the document contains only human text.\n- `ai`: the document contains only AI text.\n- `mixed`: the document contains both human and AI text.",
                      "type": "string"
                    },
                    "result_message": {
                      "description": "The message GPTZero shows for this result. You can show it to your users. It's one of:\n\n- \"Our detector is highly confident that the text is written by AI\"\n- \"Our detector is highly confident that the text may include parts written by AI\"\n- \"Our detector is highly confident that the text is written entirely by a human\"\n- \"Our detector is moderately confident that the text is written by AI\"\n- \"Our detector is moderately confident that the text may include parts written by AI\"\n- \"Our detector is moderately confident that the text is written entirely by a human\"\n- \"Our detector is highly uncertain about this document. The writing style and content are not particularly AI-like\"",
                      "type": "string"
                    },
                    "result_sub_message": {
                      "description": "More detail or context for `result_message`, if there is any.",
                      "nullable": true,
                      "type": "string"
                    },
                    "sentences": {
                      "description": "The sentences in the document, in order.",
                      "items": {
                        "properties": {
                          "generated_prob": {
                            "description": "The probability that the sentence was generated by AI, from 0 to 1.",
                            "maximum": 1,
                            "minimum": 0,
                            "type": "number"
                          },
                          "highlight_sentence_for_ai": {
                            "description": "Whether GPTZero would highlight the sentence as AI-written. It's `true` when both the sentence's `generated_prob` and its paragraph's `completely_generated_prob` are over a threshold.",
                            "type": "boolean"
                          },
                          "interpretability_alpha": {
                            "description": "**Internal.** Available to allow-listed customers only. The highlight intensity for the sentence in Advanced Scan.",
                            "nullable": true,
                            "type": "number"
                          },
                          "interpretability_designation": {
                            "description": "**Internal.** Available to allow-listed customers only. Whether the sentence contributes to the `human` or `ai` class, which sets its Advanced Scan highlight color.",
                            "nullable": true,
                            "type": "string"
                          },
                          "interpretability_normalized_value": {
                            "description": "**Internal.** Available to allow-listed customers only. The sentence's normalized contribution to the document's prediction in Advanced Scan, used to group sentences into low, medium and high impact.",
                            "nullable": true,
                            "type": "number"
                          },
                          "interpretability_value": {
                            "description": "**Internal.** Available to allow-listed customers only. The raw interpretability value from Advanced Scan.",
                            "nullable": true,
                            "type": "number"
                          },
                          "masking_reason": {
                            "description": "Why the sentence is masked, for example `references`, `table` or `code_block`. `null` when `should_mask` is `false`.",
                            "nullable": true,
                            "type": "string"
                          },
                          "perplexity": {
                            "description": "The perplexity of the sentence. The lower it is, the more likely the sentence was written by AI.",
                            "type": "integer"
                          },
                          "sentence": {
                            "description": "The text of the sentence.",
                            "type": "string"
                          },
                          "should_mask": {
                            "description": "Whether the sentence is left out of AI scoring and highlighting, for example because it's part of a reference list, table or code block.",
                            "type": "boolean"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "subclass": {
                      "description": "A more specific class, set only when `predicted_class` is `ai` or `mixed`. It has either an `ai` or a `mixed` key, never both.\n\n- For `ai`: `pure_ai` is the direct output of an LLM, and `ai_paraphrased` is AI text run through a paraphraser or bypasser.\n- For `mixed`: `concatenated` is AI and human writing joined together, and `polished` is human writing polished with AI.",
                      "properties": {
                        "ai": {
                          "description": "Ai.",
                          "properties": {
                            "class_probabilities": {
                              "description": "The probability the detector assigns to each class, from 0 to 1. The probability of `predicted_class` is the chance the prediction is correct.",
                              "properties": {
                                "ai_paraphrased": {
                                  "description": "Ai paraphrased.",
                                  "format": "float",
                                  "maximum": 1,
                                  "minimum": 0,
                                  "type": "number"
                                },
                                "pure_ai": {
                                  "description": "Pure ai.",
                                  "format": "float",
                                  "maximum": 1,
                                  "minimum": 0,
                                  "type": "number"
                                }
                              },
                              "type": "object"
                            },
                            "confidence_category": {
                              "description": "How confident the detector is in `predicted_class`. The thresholds are set so that `high` confidence has an error rate under 1%.\n\n- `high`, `medium`, `low`: the confidence band.\n- `reject`: the confidence is at or below the `reject` threshold, too low to call.",
                              "enum": [
                                "high",
                                "medium",
                                "low",
                                "reject"
                              ],
                              "type": "string"
                            },
                            "confidence_score": {
                              "description": "**Internal.** A normalized confidence score used for visualization. Show `confidence_category` to your users instead.",
                              "format": "float",
                              "maximum": 1,
                              "minimum": 0,
                              "type": "number"
                            },
                            "predicted_class": {
                              "description": "The subclass the detector thinks is most likely. Use it with `class_probabilities` to see how likely the prediction is to be correct.",
                              "enum": [
                                "pure_ai",
                                "ai_paraphrased"
                              ],
                              "type": "string"
                            },
                            "result_message": {
                              "description": "A message you can show your users to explain the subclass, for example \"We are highly confident that this text has been rewritten by AI, an AI paraphraser or AI bypasser\".",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "mixed": {
                          "description": "Mixed.",
                          "properties": {
                            "class_probabilities": {
                              "description": "The probability the detector assigns to each class, from 0 to 1. The probability of `predicted_class` is the chance the prediction is correct.",
                              "properties": {
                                "concatenated": {
                                  "description": "Concatenated.",
                                  "format": "float",
                                  "maximum": 1,
                                  "minimum": 0,
                                  "type": "number"
                                },
                                "polished": {
                                  "description": "Polished.",
                                  "format": "float",
                                  "maximum": 1,
                                  "minimum": 0,
                                  "type": "number"
                                }
                              },
                              "type": "object"
                            },
                            "confidence_category": {
                              "description": "How confident the detector is in `predicted_class`. The thresholds are set so that `high` confidence has an error rate under 1%.\n\n- `high`, `medium`, `low`: the confidence band.\n- `reject`: the confidence is at or below the `reject` threshold, too low to call.",
                              "enum": [
                                "high",
                                "medium",
                                "low",
                                "reject"
                              ],
                              "type": "string"
                            },
                            "confidence_score": {
                              "description": "**Internal.** A normalized confidence score used for visualization. Show `confidence_category` to your users instead.",
                              "format": "float",
                              "maximum": 1,
                              "minimum": 0,
                              "type": "number"
                            },
                            "predicted_class": {
                              "description": "The subclass the detector thinks is most likely. Use it with `class_probabilities` to see how likely the prediction is to be correct.",
                              "enum": [
                                "concatenated",
                                "polished"
                              ],
                              "type": "string"
                            },
                            "result_message": {
                              "description": "A message you can show your users to explain the subclass, for example \"We are highly confident that this text has been rewritten by AI, an AI paraphraser or AI bypasser\".",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    "version": {
                      "description": "The version of the detector that produced this result.",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "neatVersion": {
                "description": "The short-form version of the detector that produced this result, in the form `x.y{model_indicator}`. For example, `4.1o` or `4.1m`. See the [release notes](https://docs.superhuman.com/d/Project-engineering-import_doYGpUuF477/GPTZero-Release-Notes-Model-and-API_suN_Kut5#_luA8d53F).",
                "type": "string"
              },
              "scanId": {
                "description": "The ID of the dashboard scan this result is linked to, if there is one.",
                "type": "string"
              },
              "version": {
                "description": "The long-form version of the detector that produced this result, in the form `yyyy-mm-dd-{model_name}`. For example, `2026-10-07-base` or `2026-06-10-multilingual`. See the [release notes](https://docs.superhuman.com/d/Project-engineering-import_doYGpUuF477/GPTZero-Release-Notes-Model-and-API_suN_Kut5#_luA8d53F).",
                "type": "string"
              }
            },
            "type": "object"
          },
          "has_more": {
            "description": "Whether another page is available.",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Continuation token for the next page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
