{
  "actions": {
    "add_bulleted_list": {
      "description": "Add a bulleted list at the end of a Google Docs document.",
      "display_name": "Add bulleted list",
      "display_str_template": "Add bulleted list to document https://docs.google.com/document/d/{0}/edit.",
      "handler": "actions.add_bulleted_list",
      "id": "google_docs_add_bulleted_list",
      "method": "POST",
      "mock_response": {
        "range": {
          "end": 120,
          "start": 70
        }
      },
      "name": "add_bulleted_list",
      "output_formatter": "actions.format_add_bulleted_list_output",
      "parameters": [
        {
          "description": "The ID of the document",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The lines of text to add as bullet points",
          "display_name": "Items",
          "name": "items",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/google-docs/add-bulleted-list",
      "result_str_template": "Added bulleted list from position {0} to {1}.",
      "returns": {
        "description": "Bulleted-list insertion result",
        "properties": {
          "range": {
            "description": "Start and end indexes of the inserted list",
            "properties": {
              "end": {
                "type": "number"
              },
              "start": {
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "append_text": {
