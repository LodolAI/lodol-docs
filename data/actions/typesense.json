{
  "actions": {
    "create_collection": {
      "description": "Create a collection with the fields you name, or let Typesense work them out from the documents added. One of that name already there is returned as it is, not an error.",
      "display_name": "Create collection",
      "display_str_template": "Create Typesense collection {0}.",
      "handler": "actions.create_collection",
      "id": "typesense_create_collection",
      "method": "POST",
      "mock_response": {
        "auto_schema": true,
        "created": true,
        "created_at": "2026-10-01T09:00:00Z",
        "default_sorting_field": "",
        "documents": 0,
        "fields": [
          {
            "facet": false,
            "index": true,
            "name": "title",
            "optional": false,
            "sort": false,
            "type": "string"
          },
          {
            "facet": true,
            "index": true,
            "name": "brand",
            "optional": true,
            "sort": false,
            "type": "string"
          },
          {
            "facet": false,
            "index": true,
            "name": "price",
            "optional": true,
            "sort": true,
            "type": "float"
          }
        ],
        "name": "products"
      },
      "name": "create_collection",
      "output_formatter": "actions.format_collection",
      "parameters": [
        {
          "description": "The new collection's name, such as products.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Each field's name and type: string (text), int64 (whole number), float (number), bool (true/false), string[] (list of text) or auto. Leave empty to let Typesense work them out.",
          "display_name": "Fields",
          "name": "fields",
          "object_key_name": "Field",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The fields in Typesense's own form, for settings Fields doesn't offer, such as [{\"name\": \"title\", \"type\": \"string\", \"locale\": \"fr\"}].",
          "display_name": "Fields (JSON)",
          "multiline": true,
          "name": "fields_json",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Fields whose values results can be counted by (facets), such as brand or category.",
          "display_name": "Count by",
          "name": "facet_fields",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "A number field in Fields that results are sorted by when nothing else decides, such as popularity. Every document must have it.",
          "display_name": "Default sort",
          "name": "default_sorting_field",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Also add any other field Typesense finds in the documents, with the type it finds. On by default.",
          "display_name": "Detect other fields",
          "name": "detect_other_fields",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/typesense/create-collection",
      "result_str_template": "Collection {typesense_create_collection,name} is ready.",
      "returns": {
        "properties": {
          "auto_schema": {
            "description": "Whether Typesense adds fields it finds in new documents",
            "type": "boolean"
          },
          "created": {
            "description": "False when a collection of that name was already there",
            "type": "boolean"
          },
          "created_at": {
            "description": "When it was made (ISO 8601, UTC)",
            "type": "string"
          },
          "default_sorting_field": {
            "description": "The number field results are sorted by when nothing else decides; empty if none",
            "type": "string"
          },
          "documents": {
            "description": "How many documents it holds",
            "type": "number"
          },
          "fields": {
            "description": "Its fields",
            "items": {
              "properties": {
                "facet": {
                  "description": "Whether results can be counted by its values (a facet)",
                  "type": "boolean"
                },
                "index": {
                  "description": "Whether it can be searched and filtered",
                  "type": "boolean"
                },
                "name": {
                  "description": "The field's name",
                  "type": "string"
                },
                "optional": {
                  "description": "Whether a document may leave it out",
                  "type": "boolean"
                },
                "sort": {
                  "description": "Whether results can be sorted by it",
                  "type": "boolean"
                },
                "type": {
                  "description": "Its type, such as string, float or string[]",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "description": "The collection's name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_search_key": {
      "description": "Make an API key that can only search, to give to a website or app, such as one per customer that only finds that customer's documents. It needs an admin key.",
      "display_name": "Create search-only key",
      "display_str_template": "Create a Typesense search-only key.",
      "handler": "actions.create_search_key",
      "id": "typesense_create_search_key",
      "method": "POST",
      "mock_response": {
        "collections": [
          "products"
        ],
        "description": "Acme's storefront search",
        "expires_at": "2027-01-01T00:00:00Z",
        "filter_by": "brand:=Acme",
        "key": "RDhxa2VOTnBWOU1QcWdxbWk4NWVSa0FONnBZZ0ZKcXV7ImZpbHRlcl9ieSI6ImJyYW5kOj1BY21lIn0=",
        "key_id": 7,
        "scoped": true
      },
      "name": "create_search_key",
      "output_formatter": "actions.format_key",
      "parameters": [
        {
          "description": "The collections it may search. Leave empty for all of them.",
          "display_name": "Collections",
          "dynamic_source": "collections",
          "dynamic_source_allows_custom": true,
          "multi_select": true,
          "name": "collections",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Limit every search with the key to documents matching this, such as customer_id:=4221. Whoever has the key can't remove it.",
          "display_name": "Only documents matching",
          "examples": [
            {
              "label": "Equals",
              "value": "brand:=Acme"
            },
            {
              "label": "A range",
              "value": "price:>=10 && price:<50"
            },
            {
              "label": "Any of",
              "value": "status:=[draft, review]"
            }
          ],
          "name": "filter_by",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many days the key works for. Leave empty for a key that doesn't expire.",
          "display_name": "Expires after (days)",
          "maximum": 3650,
          "minimum": 1,
          "name": "expires_in_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "What the key is for, to recognise it later, such as Acme's storefront.",
          "display_name": "Description",
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/typesense/create-search-key",
      "result_str_template": "Made search-only key {typesense_create_search_key,key_id}.",
      "returns": {
        "properties": {
          "collections": {
            "description": "The collections it can search; * for all",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "description": "What the key is for",
            "type": "string"
          },
          "expires_at": {
            "description": "When it stops working (ISO 8601, UTC); empty if never",
            "type": "string"
          },
          "filter_by": {
            "description": "The filter every search with it is limited to; empty if none",
            "type": "string"
          },
          "key": {
            "description": "The new key, to give to a website or app. It can only search, and only documents matching the filter when one was given",
            "type": "string"
          },
          "key_id": {
            "description": "The key's ID, for 'Delete API key'",
            "type": "number"
          },
          "scoped": {
            "description": "Whether the key carries that filter",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_api_key": {
      "description": "Delete an API key by its ID, so it stops working, such as a customer's search-only key when they leave. It needs an admin key.",
      "display_name": "Delete API key",
      "display_str_template": "Delete Typesense API key {0}.",
      "handler": "actions.delete_api_key",
