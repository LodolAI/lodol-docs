    "import_documents": {
      "description": "Add or replace many documents at once, such as the rows of a spreadsheet or records from another app. Each is saved or refused on its own, and the result lists the refused ones and why.",
      "display_name": "Import documents",
      "display_str_template": "Import documents into Typesense collection {0}.",
      "handler": "actions.import_documents",
      "id": "typesense_import_documents",
      "method": "POST",
      "mock_response": {
        "collection": "products",
        "failed": 1,
        "failed_rows": [
          {
            "error": "Field `price` must be a float.",
            "id": "sku-3001",
            "row": 3
          }
        ],
        "imported": 2,
        "mode": "upsert",
        "total": 3
      },
      "name": "import_documents",
      "output_formatter": "actions.format_imported",
      "parameters": [
        {
          "description": "The collection to import them into.",
          "display_name": "Collection",
          "dynamic_source": "collections",
          "dynamic_source_allows_custom": true,
          "name": "collection",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A list of documents, such as the rows of an earlier step, or JSON such as [{\"id\": \"1\", \"title\": \"Lamp\"}]. Give each an id so the next import replaces it. Up to 10,000.",
          "display_name": "Documents",
          "name": "documents",
          "required": true,
          "schema": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "default": "upsert",
          "description": "What to do with documents already in the collection (with the same id). Defaults to adding new ones and replacing existing ones.",
          "display_name": "How",
          "name": "mode",
          "options": [
            {
              "label": "Add new ones, replace existing ones",
              "value": "upsert"
            },
            {
              "label": "Add new ones, change only the fields given in existing ones",
              "value": "emplace"
            },
            {
              "label": "Add new ones only (existing ones fail)",
              "value": "create"
            },
            {
              "label": "Change existing ones only (new ones fail)",
              "value": "update"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/typesense/import-documents",
      "result_str_template": "Imported {typesense_import_documents,imported} document(s).",
      "returns": {
        "properties": {
          "collection": {
            "description": "The collection, such as products",
            "type": "string"
          },
          "failed": {
            "description": "How many it refused",
            "type": "number"
          },
          "failed_rows": {
            "description": "The documents it refused, each with why",
            "items": {
              "properties": {
                "error": {
                  "description": "Why Typesense refused it, such as a field of the wrong type",
                  "type": "string"
                },
                "id": {
                  "description": "Its ID, when it had one",
                  "type": "string"
                },
                "row": {
                  "description": "Its place in the list, from 1",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "imported": {
            "description": "How many Typesense saved",
            "type": "number"
          },
          "mode": {
            "description": "How existing documents were treated: upsert, emplace, create or update",
            "type": "string"
          },
          "total": {
            "description": "How many documents were sent",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write",
        "modify"
      ]
    },
