{
  "actions": {
    "create_record": {
      "description": "Create a new record in an Airtable table.",
      "display_name": "Create record",
      "display_str_template": "Create a record in '{1}'.",
      "handler": "actions.create_record",
      "id": "airtable_create_record",
      "method": "POST",
      "mock_response": {
        "createdTime": "2024-01-15T10:30:00Z",
        "fields": {
          "Email": "john@example.com",
          "Name": "John Smith",
          "Status": "Active"
        },
        "id": "rec9K3L2mN4P5Q6R"
      },
      "name": "create_record",
      "output_formatter": "actions.format_create_record_output",
      "parameters": [
        {
          "description": "The Airtable base to use.",
          "display_name": "Base",
          "dynamic_source": "bases",
          "name": "base_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table to use.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_depends_on": [
            "base_id"
          ],
          "name": "table_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The value to set for each field in the table.",
          "display_name": "Fields",
          "dynamic_source": "fields",
          "dynamic_source_depends_on": [
            "base_id",
            "table_name"
          ],
          "name": "fields",
          "required": true,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/airtable/create-record",
      "result_str_template": "Created record {2} in {1}.",
      "returns": {
        "properties": {
          "createdTime": {
            "description": "Creation timestamp",
            "type": "string"
          },
          "fields": {
            "description": "Record fields",
            "type": "object"
          },
          "id": {
            "description": "Created record ID (use this as record_id in update_record or delete_record)",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
