{
  "actions": {
    "create_record": {
      "description": "Add a new record to a table.",
      "display_name": "Create a record",
      "display_str_template": "Add a record to {table_name}.",
      "handler": "actions.create_record",
      "id": "airtable_create_record",
      "method": "POST",
      "mock_response": {
        "createdTime": "2024-01-15T10:30:00Z",
        "fields": {
          "Email": "john@example.com",
          "Name": "John Smith",
          "Status": "Active"
        },
        "id": "rec9K3L2mN4P5Q6R"
      },
      "name": "create_record",
      "output_formatter": "actions.format_create_record_output",
      "parameters": [
        {
          "description": "The base. Pick one, or use one from an earlier step.",
          "display_name": "Base",
          "dynamic_source": "bases",
          "dynamic_source_allows_custom": true,
          "name": "base_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table. Pick one, or type its name.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "base_id"
          ],
          "name": "table_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The value to give each field. Leave a field empty to leave it blank.",
          "display_name": "Fields",
          "dynamic_source": "fields",
          "dynamic_source_depends_on": [
            "base_id",
            "table_name"
          ],
          "name": "fields",
          "required": true,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/airtable/create-record",
      "result_str_template": "Created record {2} in {1}.",
      "returns": {
        "properties": {
          "createdTime": {
            "description": "Creation timestamp",
            "type": "string"
          },
          "fields": {
            "description": "Record fields",
            "type": "object"
          },
          "id": {
            "description": "Created record ID (use this as record_id in update_record or delete_record)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
