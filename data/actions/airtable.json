  "description": "List, add, update and delete records in your Airtable bases.",
  "display_name": "Airtable",
  "id": "airtable",
  "logo": "https://www.lodol.com/app-icons/airtable-icon.png",
  "triggers": {
    "airtable_new_or_updated_record_trigger": {
      "description": "Runs for each record added to a table, and again each time someone changes one of its fields. Fields Airtable works out itself, such as formulas and lookups, don't count as a change. Records added or changed before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New or updated record",
      "id": "airtable_new_or_updated_record_trigger",
      "output": {
        "created_time": "string",
        "fields": "object",
        "id": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The base the table is in.",
          "display_name": "Base",
          "name": "base_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "The table to watch for new and changed records.",
          "display_name": "Table",
          "name": "table_name",
          "required": true
        }
      ]
    },
    "airtable_new_record_trigger": {
      "description": "Runs for each new record added to a table.",
      "display_name": "New record",
      "id": "airtable_new_record_trigger",
      "output": {
        "created_time": "string",
        "fields": "object",
        "id": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The base the table is in.",
          "display_name": "Base",
          "name": "base_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "The table to watch for new records.",
          "display_name": "Table",
          "name": "table_name",
          "required": true
        }
      ]
    }
  }
