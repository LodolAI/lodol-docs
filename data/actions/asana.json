    "create_task": {
      "description": "Create a new Asana task in a workspace, and optionally in one or more of its projects.",
      "display_name": "Create a task",
      "display_str_template": "Create task '{0}'.",
      "handler": "actions.create_task",
      "id": "asana_create_task",
      "method": "POST",
      "mock_response": {
        "completed": false,
        "due_on": "2024-06-15",
        "gid": "1201234567890",
        "name": "Review Q3 budget",
        "permalink_url": "https://app.asana.com/0/0/1201234567890"
      },
      "name": "create_task",
      "output_formatter": "actions.format_create_task_output",
      "parameters": [
        {
          "description": "The title of the task, for example, Review Q3 budget.",
          "display_name": "Task name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The workspace to create the task in. Every task needs a workspace or a project: when building a workflow, write this as an empty value so the person picks theirs, rather than leaving it out.",
          "display_name": "Workspace",
          "dynamic_source": "workspaces",
          "name": "workspace",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Projects to add the task to. Pick a workspace first to load its projects.",
          "display_name": "Projects",
          "dynamic_source": "projects",
          "dynamic_source_depends_on": [
            "workspace"
          ],
          "name": "projects",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The task description / notes.",
          "display_name": "Description",
          "multiline": true,
          "name": "notes",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The workspace member to assign the task to. Pick a workspace first to load its members. A person's email address works too, such as one read from a form or a sheet.",
          "display_name": "Assignee",
          "dynamic_source": "workspace_users",
          "dynamic_source_depends_on": [
            "workspace"
          ],
          "name": "assignee",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The day the task is due, in YYYY-MM-DD format.",
          "display_name": "Due date",
          "name": "due_on",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Beta. Due this many working days (Monday to Friday) after the day the step runs, for example 5 for 'due in a week'. Use it instead of Due date when the deadline is a number of days from now, so no earlier step has to work the date out. Due date wins when both are given.",
          "display_name": "Due in working days",
          "minimum": 0,
          "name": "due_in_working_days",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Beta. With Due in working days: count from this date instead of from the day the step runs, such as a new hire's start date, so no earlier step has to work the due date out. Leave empty to count from today.",
          "display_name": "Count working days from",
          "name": "working_days_from",
          "required": false,
          "type": "ParameterType.DATE"
        }
      ],
      "path": "/actions/library/asana/create-task",
      "result_str_template": "Task created.",
      "returns": {
