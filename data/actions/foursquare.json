{
  "actions": {
    "ask": {
      "description": "Ask Foursquare a question in plain language, such as 'best cocktail lounge in Williamsburg', and get back the places that answer it along with why each one matches.",
      "display_name": "Ask for places",
      "display_str_template": "Ask Foursquare '{query}'.",
      "handler": "actions.ask",
      "id": "foursquare_ask",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "places": [
          {
            "address": "53 W Jackson Blvd, Chicago, IL 60604",
            "categories": [
              "Coffee Shop"
            ],
            "fsq_place_id": "4b6f0b40f964a520bce02ce3",
            "justifications": [
              "Reviewers mention quiet seating and wifi"
            ],
            "latitude": 41.878,
            "longitude": -87.629,
            "name": "Intelligentsia Coffee",
            "price": 2,
            "rating": 8.7,
            "tel": "(312) 253-0594",
            "website": "https://www.intelligentsiacoffee.com"
          }
        ],
        "summary": "Three well-rated cafes with quiet seating downtown."
      },
      "name": "ask",
      "parameters": [
        {
          "description": "The question to answer, for example 'show me all cheap cafes in Williamsburg'.",
          "display_name": "Query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A place to search in, such as 'Chicago, IL'. Needed unless the question already names one, or coordinates are given.",
          "display_name": "Location",
          "name": "location",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Coordinates to search around, as 'latitude,longitude' (e.g. 41.8781,-87.6298). An alternative to naming a location.",
          "display_name": "Latitude, longitude",
          "name": "ll",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Extra preferences to weigh, for example 'traveling with kids, need outdoor seating'.",
          "display_name": "Context",
          "multiline": true,
          "name": "context",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/foursquare/ask",
      "result_str_template": "Places retrieved.",
      "returns": {
        "properties": {
          "count": {
            "description": "Number of places returned.",
            "type": "integer"
          },
          "places": {
            "description": "Places that answer the question.",
