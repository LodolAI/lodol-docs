              "properties": {
                "address": {
                  "description": "Full formatted street address.",
                  "type": "string"
                },
                "categories": {
                  "description": "Category labels, such as 'Coffee Shop' or 'Italian Restaurant'.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "fsq_place_id": {
                  "description": "Foursquare place ID. Pass this to the other Foursquare actions.",
                  "type": "string"
                },
                "justifications": {
                  "description": "Why Foursquare picked this place for the question.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "latitude": {
                  "description": "Latitude of the place.",
                  "type": "number"
                },
                "longitude": {
                  "description": "Longitude of the place.",
                  "type": "number"
                },
                "name": {
                  "description": "Name of the place.",
                  "type": "string"
                },
                "price": {
                  "description": "Price tier from 1 (most affordable) to 4 (most expensive).",
                  "type": "integer"
                },
                "rating": {
                  "description": "Foursquare rating from 0 to 10.",
                  "type": "number"
                },
                "tel": {
                  "description": "Phone number of the place.",
                  "type": "string"
                },
                "website": {
                  "description": "Website of the place.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "summary": {
            "description": "Foursquare's written summary of the results, when it provides one.",
            "type": "string"
          }
        },
        "type": "object"
      }
