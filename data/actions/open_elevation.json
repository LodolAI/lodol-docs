{
  "actions": {
    "get_elevation": {
      "description": "Find out how high the ground is above sea level at one place, anywhere in the world. The height comes back in both metres and feet, and a place below sea level reads as a negative number. Coverage runs from 56\u00b0S to 60\u00b0N; a place outside that band is reported as having no reading rather than as sea level.",
      "display_name": "Get elevation",
      "display_str_template": "Get the elevation at {0}, {1}.",
      "handler": "actions.get_elevation",
      "id": "open_elevation_get_elevation",
      "method": "POST",
      "mock_response": {
        "attribution": {
          "text": "Elevation data courtesy of Open-Elevation",
          "url": "https://open-elevation.com"
        },
        "coverage_note": null,
        "elevation_feet": 383.9,
        "elevation_meters": 117.0,
        "in_coverage": true,
        "latitude": 41.161758,
        "longitude": -8.583933
      },
      "name": "get_elevation",
      "output_formatter": "actions.format_elevation_output",
      "parameters": [
        {
          "description": "Latitude of the place, in decimal degrees from -90 to 90. Positive is north of the equator.",
          "display_name": "Latitude",
          "examples": [
            {
              "label": "Denver",
              "value": "39.7392"
            },
            {
              "label": "Zurich",
              "value": "47.3769"
            },
            {
              "label": "Cape Town",
              "value": "-33.9249"
            }
          ],
          "maximum": 90,
          "minimum": -90,
          "name": "latitude",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Longitude of the place, in decimal degrees from -180 to 180. The Americas take a negative longitude.",
          "display_name": "Longitude",
          "examples": [
            {
              "label": "Denver",
              "value": "-104.9903"
            },
            {
              "label": "Zurich",
              "value": "8.5417"
            },
            {
              "label": "Cape Town",
              "value": "18.4241"
            }
          ],
          "maximum": 180,
          "minimum": -180,
          "name": "longitude",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/open-elevation/get-elevation",
      "result_str_template": "Elevation retrieved.",
      "returns": {
        "properties": {
          "attribution": {
            "description": "Credit to show wherever this data appears.",
            "properties": {
              "text": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "coverage_note": {
            "description": "Set only when something had no reading, explaining why. Empty otherwise.",
            "type": "string"
          },
          "elevation_feet": {
            "description": "The same height in feet.",
            "type": "number"
          },
          "elevation_meters": {
            "description": "Height of the ground above sea level, in metres. Empty when the place is outside the dataset's coverage.",
            "type": "number"
          },
          "in_coverage": {
            "description": "False when the place falls outside the dataset and has no reading.",
            "type": "boolean"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        },
        "type": "object"
      }
