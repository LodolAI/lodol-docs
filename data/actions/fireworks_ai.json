{
  "actions": {
    "ask_model": {
      "description": "Send a prompt, and any pictures, to an open model on Fireworks and get its reply: write, summarize, translate, answer or describe an image.",
      "display_name": "Ask a model",
      "display_str_template": "Ask a Fireworks model: {0}",
      "handler": "actions.ask_model",
      "id": "fireworks_ai_ask_model",
      "method": "POST",
      "mock_response": {
        "finish_reason": "stop",
        "input_tokens": 212,
        "model": "accounts/fireworks/models/kimi-k2p6",
        "output_tokens": 9,
        "reply": "Paris.",
        "thinking": null,
        "total_tokens": 221,
        "was_cut_off": false
      },
      "name": "ask_model",
      "parameters": [
        {
          "description": "What to ask or tell the model.",
          "display_name": "Prompt",
          "examples": [
            {
              "label": "Summarize",
              "value": "Summarize this customer email in two sentences: ..."
            }
          ],
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "accounts/fireworks/models/kimi-k2p6",
          "description": "The model that does the work. Kimi K2.6 reads images and suits most jobs. You can also type any model id, including your own fine-tuned models.",
          "display_name": "Model",
          "dynamic_source": "chat_models",
          "dynamic_source_allows_custom": true,
          "name": "model",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How the model should behave, such as 'Answer in one short paragraph' or 'You are a friendly support agent for Acme'.",
          "display_name": "Instructions",
          "multiline": true,
          "name": "instructions",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "description": "Pictures for the model to look at: upload them, pick files from an earlier step, or paste public web addresses. PNG, JPEG, GIF, BMP or TIFF, up to 30.",
          "display_name": "Images",
          "name": "images",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "default": "default",
          "description": "How much the model reasons before it answers. More is slower and uses more tokens; the thinking comes back separately from the reply.",
          "display_name": "Thinking",
          "name": "thinking",
          "options": [
            {
              "label": "Model's default",
              "value": "default"
            },
            {
              "label": "Off",
              "value": "none"
            },
            {
              "label": "Low",
              "value": "low"
            },
            {
              "label": "Medium",
              "value": "medium"
            },
            {
              "label": "High",
              "value": "high"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most tokens the reply may use; a token is about three-quarters of a word. Leave empty to let the model decide.",
          "display_name": "Maximum reply length",
          "minimum": 1,
          "name": "max_tokens",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "From 0 (focused and repeatable) to 2 (most varied). Leave empty for the model's default.",
          "display_name": "Creativity",
          "maximum": 2,
          "minimum": 0,
          "name": "temperature",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/fireworks-ai/ask-model",
      "result_str_template": "{reply}",
      "returns": {
        "properties": {
          "finish_reason": {
            "description": "stop when it finished, length when cut off.",
            "type": "string"
          },
          "input_tokens": {
            "description": "Tokens read, as billed.",
            "type": "number"
          },
          "model": {
            "description": "The model that answered.",
            "type": "string"
          },
          "output_tokens": {
            "description": "Tokens written, as billed.",
            "type": "number"
          },
          "reply": {
            "description": "The model's answer.",
            "type": "string"
          },
          "thinking": {
            "description": "Its reasoning, when it thought first.",
            "type": "string"
          },
          "total_tokens": {
            "description": "Both together.",
            "type": "number"
          },
          "was_cut_off": {
            "description": "Whether it hit the maximum reply length.",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "classify_text": {
      "description": "Have a model pick the one category that fits a piece of text, such as routing a support email. The answer is always exactly one of the categories you list.",
      "display_name": "Sort text into a category",
      "display_str_template": "Sort text into one of {1,length} categories.",
      "handler": "actions.classify_text",
      "id": "fireworks_ai_classify_text",
      "method": "POST",
      "mock_response": {
        "categories": [
          "Refund request",
          "Bug report",
          "Sales question"
        ],
        "category": "Refund request",
        "input_tokens": 212,
        "model": "accounts/fireworks/models/kimi-k2p6",
        "output_tokens": 9,
        "total_tokens": 221
      },
      "name": "classify_text",
      "parameters": [
        {
          "description": "The text to sort, such as an email, a review or a support ticket.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The categories to choose from, one per entry. The step always returns exactly one of them, spelled as you wrote it.",
          "display_name": "Categories",
          "examples": [
            {
              "label": "Support triage",
              "value": "[\"Refund request\", \"Bug report\", \"Sales question\"]"
            }
          ],
          "name": "categories",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Rules for borderline cases, such as 'Anything that mentions money back is a Refund request'.",
          "display_name": "How to decide",
          "multiline": true,
          "name": "instructions",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "accounts/fireworks/models/kimi-k2p6",
          "description": "The model that does the work. Kimi K2.6 reads images and suits most jobs. You can also type any model id, including your own fine-tuned models.",
          "display_name": "Model",
          "dynamic_source": "chat_models",
          "dynamic_source_allows_custom": true,
          "name": "model",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/fireworks-ai/classify-text",
      "result_str_template": "Sorted into {category}.",
      "returns": {
        "properties": {
          "categories": {
            "description": "The categories it chose from.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "category": {
            "description": "The category chosen.",
            "type": "string"
          },
          "input_tokens": {
            "description": "Tokens read, as billed.",
            "type": "number"
          },
          "model": {
            "description": "The model that chose.",
            "type": "string"
          },
          "output_tokens": {
            "description": "Tokens written, as billed.",
            "type": "number"
          },
          "total_tokens": {
            "description": "Both together.",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "create_embeddings": {
      "description": "Turn texts into vectors for semantic search, deduplication or clustering. Vectors come back at unit length, so a dot product of two is their cosine similarity.",
      "display_name": "Create embeddings",
      "display_str_template": "Embed {0,length} texts with Fireworks.",
      "handler": "actions.create_embeddings",
      "id": "fireworks_ai_create_embeddings",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "dimensions": 3,
        "embedding": [
          0.012,
          -0.043,
          0.031
        ],
        "embeddings": [
          [
            0.012,
            -0.043,
            0.031
          ],
          [
            0.018,
            -0.039,
            0.027
          ]
        ],
        "model": "fireworks/qwen3-embedding-8b",
        "total_tokens": 14
      },
      "name": "create_embeddings",
      "parameters": [
        {
          "description": "The texts to turn into vectors, one per entry. Each gives one vector, in the same order.",
          "display_name": "Texts",
          "name": "texts",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "default": "fireworks/qwen3-embedding-8b",
          "description": "Qwen3 Embedding 8B is the best for search. Match the model already used for any vectors you will compare these with.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Qwen3 Embedding 8B (recommended)",
              "value": "fireworks/qwen3-embedding-8b"
            },
            {
              "label": "Nomic Embed v1.5 (768 numbers)",
              "value": "nomic-ai/nomic-embed-text-v1.5"
            },
            {
              "label": "BGE Base English v1.5 (768 numbers)",
              "value": "BAAI/bge-base-en-v1.5"
            },
            {
              "label": "BGE Small English v1.5 (384 numbers)",
              "value": "BAAI/bge-small-en-v1.5"
            },
            {
              "label": "GTE Large (1,024 numbers)",
              "value": "thenlper/gte-large"
            },
            {
              "label": "mxbai Embed Large v1 (1,024 numbers)",
              "value": "mixedbread-ai/mxbai-embed-large-v1"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Shorter vectors take less storage. Only Qwen3 Embedding 8B (up to 4,096) and Nomic Embed v1.5 (up to 768) can be shortened; leave empty for the full length.",
          "display_name": "Vector length",
          "minimum": 1,
          "name": "dimensions",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/fireworks-ai/create-embeddings",
      "result_str_template": "Created {count} vectors of {dimensions} numbers.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many vectors.",
            "type": "number"
          },
          "dimensions": {
            "description": "How many numbers each vector has.",
            "type": "number"
          },
          "embedding": {
            "description": "The first text's vector.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "embeddings": {
            "description": "One vector per text, in the same order.",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "model": {
            "description": "The model used.",
            "type": "string"
          },
          "total_tokens": {
            "description": "Tokens billed.",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "extract_data": {
      "description": "Pull the fields you name out of text or pictures, such as the total on a photographed receipt or the sender's company in an email, ready for a spreadsheet row or a CRM record.",
