{
  "actions": {
    "get_form": {
      "description": "Look up a form's title and field count.",
      "display_name": "Get form",
      "display_str_template": "Get Typeform form '{0}'.",
      "handler": "actions.get_form",
      "id": "typeform_get_form",
      "method": "POST",
      "mock_response": {
        "field_count": 8,
        "id": "lT4Z3j",
        "title": "Customer Feedback"
      },
      "name": "get_form",
      "parameters": [
        {
          "description": "ID of the form to look up.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/typeform/get-form",
      "result_str_template": "Retrieved the form.",
      "returns": {
        "properties": {
          "field_count": {
            "description": "Number of fields (questions) on the form",
            "type": "number"
          },
          "id": {
            "description": "Form ID",
            "type": "string"
          },
          "title": {
            "description": "Form title",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_form_fields": {
      "description": "List the fields (questions) defined on a form.",
      "display_name": "List form fields",
      "display_str_template": "List fields on Typeform form '{0}'.",
      "handler": "actions.list_form_fields",
      "id": "typeform_list_form_fields",
      "method": "POST",
      "mock_response": {
        "fields": [
          {
            "field_id": "DlXVaz2XM2cV",
            "title": "How satisfied are you with our service?",
            "type": "multiple_choice"
          }
        ]
      },
      "name": "list_form_fields",
      "parameters": [
        {
          "description": "ID of the form to list fields for.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/typeform/list-form-fields",
      "result_str_template": "Fetched the form's fields.",
      "returns": {
        "properties": {
          "fields": {
            "description": "List of fields on the form",
            "items": {
              "properties": {
                "field_id": {
                  "description": "Field ID, referenced by list-responses answers",
                  "type": "string"
                },
                "title": {
                  "description": "The field's question text",
                  "type": "string"
                },
                "type": {
                  "description": "Typeform field type, for example 'multiple_choice' or 'short_text'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_forms": {
      "description": "List the forms in your Typeform account.",
      "display_name": "List forms",
      "display_str_template": "List Typeform forms.",
      "handler": "actions.list_forms",
      "id": "typeform_list_forms",
      "method": "POST",
      "mock_response": {
        "forms": [
          {
            "id": "lT4Z3j",
            "title": "Customer Feedback"
          }
        ]
      },
      "name": "list_forms",
      "parameters": [],
      "path": "/actions/library/typeform/list-forms",
      "result_str_template": "Fetched Typeform forms.",
      "returns": {
        "properties": {
          "forms": {
            "description": "List of forms in the account",
            "items": {
              "properties": {
                "id": {
                  "description": "Form ID. Use with the other actions.",
                  "type": "string"
                },
                "title": {
                  "description": "Form title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_responses": {
      "description": "List the responses submitted to a form.",
      "display_name": "List responses",
      "display_str_template": "List responses to Typeform form '{0}'.",
      "handler": "actions.list_responses",
      "id": "typeform_list_responses",
      "method": "POST",
      "mock_response": {
        "responses": [
          {
            "answers": [
              {
                "answer": "Very satisfied",
                "field_id": "DlXVaz2XM2cV"
              }
            ],
            "id": "a3a12ec67cae7c1c78d19e3c1d8c92f5",
            "submitted_at": "2026-01-15T10:00:00Z"
          }
        ]
      },
      "name": "list_responses",
      "parameters": [
        {
          "description": "ID of the form to list responses for.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of responses to return (default 25).",
          "display_name": "Maximum responses",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/typeform/list-responses",
      "result_str_template": "Fetched Typeform responses.",
      "returns": {
        "properties": {
          "responses": {
            "description": "List of responses",
            "items": {
              "properties": {
                "answers": {
                  "description": "The respondent's answers, one per field answered",
                  "items": {
                    "properties": {
                      "answer": {
                        "description": "The respondent's answer text",
                        "type": "string"
                      },
                      "field_id": {
                        "description": "ID of the field this answer belongs to (matches a field_id from list_form_fields)",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "id": {
                  "description": "Response ID",
                  "type": "string"
                },
                "submitted_at": {
                  "description": "Timestamp the response was submitted",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your Typeform account to browse forms and read their responses.",
  "display_name": "Typeform",
  "id": "typeform"
}
