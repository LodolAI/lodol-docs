{
  "actions": {
    "add_event": {
      "description": "Add an event to a calendar.",
      "display_name": "Create event",
      "display_str_template": "Create the event '{0}' from {1} to {2}.",
      "handler": "actions.add_event",
      "id": "google_calendar_add_event",
      "method": "POST",
      "mock_response": {
        "event_id": "abc123xyz",
        "html_link": "https://calendar.google.com/calendar/event?eid=abc123xyz"
      },
      "name": "add_event",
      "output_formatter": "actions.format_add_event_output",
      "parameters": [
        {
          "description": "Title of the event",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the event starts (for example, 2024-01-15T10:00:00-05:00)",
          "display_name": "Start date and time",
          "name": "start_date_time",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the event ends (for example, 2024-01-15T11:00:00-05:00)",
          "display_name": "End date and time",
          "name": "end_date_time",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The calendar to add the event to. Leave blank to use your main calendar ('primary')",
          "display_name": "Calendar",
          "name": "calendar_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Description or notes for the event",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Location of the event",
          "display_name": "Location",
          "name": "location",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Time zone for the event (e.g., America/New_York)",
          "display_name": "Time zone",
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "List of attendee email addresses",
          "display_name": "Attendees",
          "name": "attendees",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/google-calendar/add-event",
      "result_str_template": "Created event with ID {0}.",
      "returns": {
        "properties": {
          "event_id": {
            "description": "ID of the created event",
            "type": "string"
          },
          "html_link": {
            "description": "URL link to the event",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "check_timeslot": {
      "description": "Check whether a calendar has nothing booked between two times.",
      "display_name": "Check if the calendar is free",
      "display_str_template": "Check if the calendar is free from {1} to {2}.",
      "handler": "actions.check_timeslot",
      "id": "google_calendar_check_timeslot",
      "method": "POST",
      "mock_response": {
        "busy": [],
        "busy_summary": "None",
        "is_available": true
      },
      "name": "check_timeslot",
      "output_formatter": "actions.format_check_timeslot_output",
      "parameters": [
        {
          "description": "The calendar to check (use 'primary' for your main calendar)",
          "display_name": "Calendar",
          "name": "calendar_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the time slot starts (for example, 2024-01-15T10:00:00-05:00)",
          "display_name": "Start date and time",
          "name": "start_date_time",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the time slot ends (for example, 2024-01-15T11:00:00-05:00)",
          "display_name": "End date and time",
          "name": "end_date_time",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Time zone for the check (e.g., America/New_York)",
          "display_name": "Time zone",
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-calendar/check-timeslot",
      "result_str_template": "Time slot is {0}.",
      "returns": {
        "properties": {
          "busy": {
            "description": "List of busy time windows",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "busy_summary": {
            "description": "Human-readable summary of busy times",
            "type": "string"
          },
          "is_available": {
            "description": "Whether the time slot is free",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "find_events": {
      "description": "List the events on a Google Calendar in a time range, soonest first, with each event's title, start and end, location, description and guest emails.",
      "display_name": "Find events",
      "display_str_template": "Find events from {start_date_time} to {end_date_time} matching '{search}'.",
      "handler": "actions.find_events",
      "id": "google_calendar_find_events",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "events": [
          {
            "attendees": [
              "jane@acme.com"
            ],
            "created": "2024-01-10T09:00:00Z",
            "description": "",
            "end": "2024-01-15T10:30:00-05:00",
            "html_link": "https://calendar.google.com/calendar/event?eid=abc123xyz",
            "id": "abc123xyz",
            "location": "",
            "start": "2024-01-15T10:00:00-05:00",
            "summary": "Intro call with Acme",
            "updated": "2024-01-10T09:00:00Z"
          }
        ]
      },
      "name": "find_events",
      "output_formatter": "actions.format_find_events_output",
      "parameters": [
        {
          "description": "The calendar to read. Leave blank to use your main calendar ('primary')",
          "display_name": "Calendar",
          "name": "calendar_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only events ending after this time (for example, 2024-01-15T00:00:00-05:00). Leave blank to start from now",
          "display_name": "From",
          "name": "start_date_time",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only events starting before this time (for example, 2024-01-22T00:00:00-05:00)",
          "display_name": "Until",
          "name": "end_date_time",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Time zone for dates written without an offset (e.g., America/New_York)",
          "display_name": "Time zone",
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only events whose title, description, location or guests contain this text",
          "display_name": "Search",
          "name": "search",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Most events to return (1-250, default 25)",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-calendar/find-events",
      "result_str_template": "Found {0} event(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "Number of events returned",
            "type": "number"
          },
          "events": {
            "items": {
              "properties": {
                "attendees": {
                  "description": "Guest email addresses",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "created": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                },
                "html_link": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "start": {
                  "description": "Start dateTime, or date for all-day events",
                  "type": "string"
                },
                "summary": {
                  "description": "Event title",
                  "type": "string"
                },
                "updated": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "remove_event": {
      "description": "Delete an event by its title: the first one found, or every event with that title.",
      "display_name": "Delete event",
      "display_str_template": "Delete the first event called '{1}'.",
      "handler": "actions.remove_event",
      "id": "google_calendar_remove_event",
      "method": "POST",
      "mock_response": {
        "deletedEventIds": {
          "deleted_event_ids": [
            "event123"
          ]
        }
      },
      "name": "remove_event",
      "output_formatter": "actions.format_remove_event_output",
      "parameters": [
        {
          "description": "The calendar to remove the event from. Leave blank to use your main calendar ('primary')",
          "display_name": "Calendar",
          "name": "calendar_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Title of the event to delete",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "first",
          "description": "Whether to delete only the first event with this title, or every one.",
          "display_name": "If multiple events match",
          "name": "multiple_mode",
          "options": [
            {
              "label": "Delete only the first one found",
              "value": "first"
            },
            {
              "label": "Delete every one",
              "value": "all"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "none",
          "description": "Whether to email the event's guests that it was cancelled.",
          "display_name": "Tell the guests",
          "name": "send_updates",
          "options": [
            {
              "label": "No",
              "value": "none"
            },
            {
              "label": "Yes, every guest",
              "value": "all"
            },
            {
              "label": "Only guests outside your organization",
              "value": "externalOnly"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-calendar/remove-event",
      "result_str_template": "Deleted {0} event(s).",
      "returns": {
        "description": "Response envelope; the payload is in the \"deletedEventIds\" field.",
        "properties": {
          "deletedEventIds": {
            "properties": {
              "deleted_event_ids": {
                "description": "IDs of the deleted events",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    }
  },
  "categories": [
    "Calendars",
    "Google"
  ],
  "description": "Create and manage events on Google Calendar.",
  "display_name": "Google Calendar",
  "id": "google_calendar",
  "logo": "https://www.lodol.com/app-icons/google-calendar-icon.png",
  "triggers": {
    "google_calendar_new_event_trigger": {
      "description": "Runs when a new event is created in Google Calendar.",
      "display_name": "New event",
      "id": "google_calendar_new_event_trigger",
      "output": {
        "attendees": "array",
        "created": "string",
        "description": "string",
        "end": "string",
        "html_link": "string",
        "id": "string",
        "location": "string",
        "start": "string",
        "summary": "string",
        "updated": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Google Calendar ID to watch. Leave blank to use your primary calendar.",
          "display_name": "Calendar",
          "name": "calendar_id",
          "required": false
        }
      ]
    }
  }
}
