{
  "actions": {
    "create_form": {
      "description": "Create a new, blank Google Form with a title.",
      "display_name": "Create form",
      "display_str_template": "Create Google Form '{0}'.",
      "handler": "actions.create_form",
      "id": "google_forms_create_form",
      "method": "POST",
      "mock_response": {
        "form_id": "1FAIpQLSd_example_form_id",
        "responder_uri": "https://docs.google.com/forms/d/e/example/viewform"
      },
      "name": "create_form",
      "parameters": [
        {
          "description": "Title of the new form.",
          "display_name": "Title",
          "examples": [
            {
              "label": "Title",
              "value": "Customer Feedback"
            }
          ],
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/create-form",
      "result_str_template": "Created Google Form '{0}'.",
      "returns": {
        "properties": {
          "form_id": {
            "description": "ID of the created form. Use this to fetch the form or its responses.",
            "type": "string"
          },
          "responder_uri": {
            "description": "URL responders use to fill out the form",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_form": {
      "description": "Look up a form's title, description, and questions.",
      "display_name": "Get form",
      "display_str_template": "Get Google Form '{0}'.",
      "handler": "actions.get_form",
      "id": "google_forms_get_form",
      "method": "POST",
      "mock_response": {
        "description": "",
        "form_id": "1FAIpQLSd_example_form_id",
        "responder_uri": "https://docs.google.com/forms/d/e/example/viewform",
        "title": "Customer Feedback"
      },
      "name": "get_form",
      "parameters": [
        {
          "description": "ID of the form to fetch.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/get-form",
      "result_str_template": "Retrieved Google Form '{0}'.",
      "returns": {
        "properties": {
          "description": {
            "description": "Description shown to responders",
            "type": "string"
          },
          "form_id": {
            "description": "ID of the form",
            "type": "string"
          },
          "responder_uri": {
            "description": "URL responders use to fill out the form",
            "type": "string"
          },
          "title": {
            "description": "Title of the form",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_response": {
      "description": "Look up a single form response by its ID.",
      "display_name": "Get form response",
      "display_str_template": "Get response '{1}' to Google Form '{0}'.",
      "handler": "actions.get_response",
      "id": "google_forms_get_response",
      "method": "POST",
      "mock_response": {
        "answers": {
          "abc123": {
            "textAnswers": {
              "answers": [
                {
                  "value": "Very satisfied"
                }
              ]
            }
          }
        },
        "create_time": "2026-01-01T00:00:00.000Z",
        "respondent_email": "user@example.com",
        "response_id": "resp_123"
      },
      "name": "get_response",
      "parameters": [
        {
          "description": "ID of the form the response belongs to.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the response to fetch.",
          "display_name": "Response ID",
          "name": "response_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/get-response",
      "result_str_template": "Retrieved form response '{0}'.",
      "returns": {
        "properties": {
          "answers": {
            "description": "Answers keyed by question ID, in Google Forms API answer format",
            "type": "object"
          },
          "create_time": {
            "description": "Timestamp the response was first submitted",
            "type": "string"
          },
          "respondent_email": {
            "description": "Respondent's email address, if collected",
            "type": "string"
          },
          "response_id": {
            "description": "Response ID",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_responses": {
      "description": "List the responses submitted to a form.",
      "display_name": "List form responses",
      "display_str_template": "List responses to Google Form '{0}'.",
      "handler": "actions.list_responses",
      "id": "google_forms_list_responses",
      "method": "POST",
      "mock_response": {
        "next_page_token": null,
        "responses": [
          {
            "answers": {
              "abc123": {
                "textAnswers": {
                  "answers": [
                    {
                      "value": "Very satisfied"
                    }
                  ]
                }
              }
            },
            "create_time": "2026-01-01T00:00:00.000Z",
            "respondent_email": "user@example.com",
            "response_id": "resp_123"
          }
        ]
      },
      "name": "list_responses",
      "parameters": [
        {
          "description": "ID of the form to list responses for.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of responses to return (default 25).",
          "display_name": "Maximum responses",
          "name": "page_size",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-forms/list-responses",
      "result_str_template": "Fetched responses to Google Form '{0}'.",
      "returns": {
        "properties": {
          "next_page_token": {
            "description": "Cursor for fetching more responses. Null when there are no more.",
            "nullable": true,
            "type": "string"
          },
          "responses": {
            "description": "List of form responses",
            "items": {
              "properties": {
                "answers": {
                  "description": "Answers keyed by question ID, in Google Forms API answer format",
                  "type": "object"
                },
                "create_time": {
                  "description": "Timestamp the response was first submitted",
                  "type": "string"
                },
                "respondent_email": {
                  "description": "Respondent's email address, if collected",
                  "type": "string"
                },
                "response_id": {
                  "description": "Response ID. Use with get_response to fetch it again.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create forms and read responses in Google Forms.",
  "display_name": "Google Forms",
  "id": "google_forms"
}
