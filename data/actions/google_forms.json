{
  "actions": {
    "add_question": {
      "description": "Add a question to the end of a form: a short or long answer, multiple choice, checkboxes or a dropdown.",
      "display_name": "Add a question",
      "display_str_template": "Add the question '{1}' to '{0}'.",
      "handler": "actions.add_question",
      "id": "google_forms_add_question",
      "method": "POST",
      "mock_response": {
        "form_id": "1FAIpQLSd_example_form_id",
        "item_id": "3a1b2c4d",
        "question_id": "5e6f7a8b"
      },
      "name": "add_question",
      "parameters": [
        {
          "description": "The form: the link you edit it at, or the id in it.",
          "display_name": "Form",
          "label_source": "form_names",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The question, as people filling in the form see it.",
          "display_name": "Question",
          "examples": [
            {
              "label": "Question",
              "value": "How did you hear about us?"
            }
          ],
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "short_answer",
          "description": "How people answer: in a line of text, in a paragraph, or by picking from the choices.",
          "display_name": "Kind of answer",
          "name": "question_type",
          "options": [
            {
              "label": "Short answer",
              "value": "short_answer"
            },
            {
              "label": "Paragraph",
              "value": "paragraph"
            },
            {
              "label": "Multiple choice",
              "value": "multiple_choice"
            },
            {
              "label": "Checkboxes",
              "value": "checkboxes"
            },
            {
              "label": "Dropdown",
              "value": "dropdown"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The choices to pick from, one per row.",
          "display_name": "Choices",
          "item_by_item": true,
          "name": "choices",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY",
          "visible_when": {
            "question_type": [
              "multiple_choice",
              "checkboxes",
              "dropdown"
            ]
          }
        },
        {
          "default": false,
          "description": "Whether the form can't be sent without an answer to this question.",
          "display_name": "Answer required",
          "name": "required",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/google-forms/add-question",
      "result_str_template": "Added a question to Google Form '{0}'.",
      "returns": {
        "properties": {
          "form_id": {
            "description": "ID of the form",
            "type": "string"
          },
          "item_id": {
            "description": "ID of the new item on the form",
            "type": "string"
          },
          "question_id": {
            "description": "ID of the new question. A response's answers are keyed by it.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_form": {
      "description": "Create a new, blank Google Form with a title.",
      "display_name": "Create form",
      "display_str_template": "Create the form '{0}'.",
      "handler": "actions.create_form",
      "id": "google_forms_create_form",
      "method": "POST",
      "mock_response": {
        "form_id": "1FAIpQLSd_example_form_id",
        "responder_uri": "https://docs.google.com/forms/d/e/example/viewform"
      },
      "name": "create_form",
      "parameters": [
        {
          "description": "Title of the new form.",
          "display_name": "Title",
          "examples": [
            {
              "label": "Title",
              "value": "Customer Feedback"
            }
          ],
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/create-form",
      "result_str_template": "Created Google Form '{0}'.",
      "returns": {
        "properties": {
          "form_id": {
            "description": "ID of the created form. Use this to fetch the form or its responses.",
            "type": "string"
          },
          "responder_uri": {
            "description": "URL responders use to fill out the form",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_form": {
      "description": "Move a form a workflow made to the trash in Google Drive, where it can be restored for 30 days. Only forms made by workflows can be deleted.",
      "display_name": "Delete form",
      "display_str_template": "Delete '{0}'.",
      "handler": "actions.delete_form",
      "id": "google_forms_delete_form",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "form_id": "1FAIpQLSd_example_form_id"
      },
      "name": "delete_form",
      "parameters": [
        {
          "description": "The form: the link you edit it at, or the id in it. It must have been made by a workflow.",
          "display_name": "Form",
          "label_source": "form_names",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/delete-form",
      "result_str_template": "Google Forms form moved to the trash.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Whether the form was moved to the trash",
            "type": "boolean"
          },
          "form_id": {
            "description": "ID of the form moved to the trash",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "get_form": {
      "description": "Look up a form's title, description, and questions.",
      "display_name": "Get form",
      "display_str_template": "Get '{0}'.",
      "handler": "actions.get_form",
      "id": "google_forms_get_form",
      "method": "POST",
      "mock_response": {
        "description": "",
        "form_id": "1FAIpQLSd_example_form_id",
        "responder_uri": "https://docs.google.com/forms/d/e/example/viewform",
        "title": "Customer Feedback"
      },
      "name": "get_form",
      "parameters": [
        {
          "description": "The form: the link you edit it at, or the id in it.",
          "display_name": "Form",
          "label_source": "form_names",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/get-form",
      "result_str_template": "Retrieved Google Form '{0}'.",
      "returns": {
        "properties": {
          "description": {
            "description": "Description shown to responders",
            "type": "string"
          },
          "form_id": {
            "description": "ID of the form",
            "type": "string"
          },
          "responder_uri": {
            "description": "URL responders use to fill out the form",
            "type": "string"
          },
          "title": {
            "description": "Title of the form",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_response": {
      "description": "Look up a single form response by its ID.",
      "display_name": "Get form response",
      "display_str_template": "Get response '{1}' to '{0}'.",
      "handler": "actions.get_response",
      "id": "google_forms_get_response",
      "method": "POST",
      "mock_response": {
        "answers": {
          "abc123": {
            "textAnswers": {
              "answers": [
                {
                  "value": "Very satisfied"
                }
              ]
            }
          }
        },
        "create_time": "2026-01-01T00:00:00.000Z",
        "respondent_email": "user@example.com",
        "response_id": "resp_123"
      },
      "name": "get_response",
      "parameters": [
        {
          "description": "The form: the link you edit it at, or the id in it.",
          "display_name": "Form",
          "label_source": "form_names",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the response to fetch.",
          "display_name": "Response ID",
          "name": "response_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/get-response",
      "result_str_template": "Retrieved form response '{0}'.",
      "returns": {
        "properties": {
          "answers": {
            "description": "Answers keyed by question ID, in Google Forms API answer format",
            "type": "object"
          },
          "create_time": {
            "description": "Timestamp the response was first submitted",
            "type": "string"
          },
          "respondent_email": {
            "description": "Respondent's email address, if collected",
            "type": "string"
          },
          "response_id": {
            "description": "Response ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_responses": {
      "description": "List the responses submitted to a form.",
      "display_name": "List form responses",
      "display_str_template": "List the responses to '{0}'.",
      "handler": "actions.list_responses",
      "id": "google_forms_list_responses",
      "method": "POST",
      "mock_response": {
        "next_page_token": null,
        "responses": [
          {
            "answers": {
              "abc123": {
                "textAnswers": {
                  "answers": [
                    {
                      "value": "Very satisfied"
                    }
                  ]
                }
              }
            },
            "create_time": "2026-01-01T00:00:00.000Z",
            "respondent_email": "user@example.com",
            "response_id": "resp_123"
          }
        ]
      },
      "name": "list_responses",
      "parameters": [
        {
          "description": "The form: the link you edit it at, or the id in it.",
          "display_name": "Form",
          "label_source": "form_names",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of responses to return (default 25).",
          "display_name": "Maximum responses",
          "name": "page_size",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-forms/list-responses",
      "result_str_template": "Fetched responses to Google Form '{0}'.",
      "returns": {
        "properties": {
          "next_page_token": {
            "description": "Cursor for fetching more responses. Null when there are no more.",
            "nullable": true,
            "type": "string"
          },
          "responses": {
            "description": "List of form responses",
            "items": {
              "properties": {
                "answers": {
                  "description": "Answers keyed by question ID, in Google Forms API answer format",
                  "type": "object"
                },
                "create_time": {
                  "description": "Timestamp the response was first submitted",
                  "type": "string"
                },
                "respondent_email": {
                  "description": "Respondent's email address, if collected",
                  "type": "string"
                },
                "response_id": {
                  "description": "Response ID. Use with get_response to fetch it again.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "set_accepting_responses": {
      "description": "Stop a form taking responses, for example when an event is full or a deadline passes, or open it again. A closed form's link tells people it is no longer accepting responses.",
      "display_name": "Open or close a form",
      "display_str_template": "Set '{0}' {1} to responses.",
      "handler": "actions.set_accepting_responses",
      "id": "google_forms_set_accepting_responses",
      "method": "POST",
      "mock_response": {
        "accepting_responses": false,
        "form_id": "1FAIpQLSd_example_form_id",
        "published": true
      },
      "name": "set_accepting_responses",
      "parameters": [
        {
          "description": "The form: the link you edit it at, or the id in it.",
          "display_name": "Form",
          "label_source": "form_names",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Whether the form takes responses from now on.",
          "display_name": "Responses",
          "name": "responses",
          "options": [
            {
              "label": "Closed (stop taking responses)",
              "value": "closed"
            },
            {
              "label": "Open (take responses)",
              "value": "open"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-forms/set-accepting-responses",
      "result_str_template": "Google Form's responses set.",
      "returns": {
        "properties": {
          "accepting_responses": {
            "description": "Whether the form now takes responses",
            "type": "boolean"
          },
          "form_id": {
            "description": "ID of the form",
            "type": "string"
          },
          "published": {
            "description": "Whether the form is published, so its link opens",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    }
  },
  "categories": [
    "Forms & Surveys",
    "Google"
  ],
  "description": "Create forms and read responses in Google Forms.",
  "display_name": "Google Forms",
  "id": "google_forms",
  "logo": "https://www.lodol.com/app-icons/google-forms-icon.png",
  "triggers": {
    "google_forms_new_response_trigger": {
      "description": "Runs for each new response to a form, with its answers by question. Responses already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New response",
      "id": "google_forms_new_response_trigger",
      "output": {
        "answers": "object",
        "form_id": "string",
        "respondent_email": "string",
        "response_id": "string",
        "submitted_at": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The form to watch: the link you edit it at (docs.google.com/forms/d/.../edit), or the id in it.",
          "display_name": "Form",
          "name": "form_id",
          "required": true
        }
      ]
    }
  }
}
