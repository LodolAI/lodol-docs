{
  "actions": {
    "create_draft_event": {
      "description": "Create a new draft event in an Eventbrite organization.",
      "display_name": "Create draft event",
      "display_str_template": "Create draft event '{1}' in organization '{0}'.",
      "handler": "actions.create_draft_event",
      "id": "eventbrite_create_draft_event",
      "method": "POST",
      "mock_response": {
        "id": "222222222",
        "name": {
          "text": "New Draft Event"
        },
        "status": "draft"
      },
      "name": "create_draft_event",
      "output_formatter": "actions.format_create_draft_event_output",
      "parameters": [
        {
          "description": "The organization ID.",
          "display_name": "Organization ID",
          "name": "organization_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The event name.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the event starts, in UTC (for example, 2026-07-15T09:00:00Z).",
          "display_name": "Start time (UTC)",
          "name": "start_utc",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the event ends, in UTC (for example, 2026-07-15T17:00:00Z).",
          "display_name": "End time (UTC)",
          "name": "end_utc",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The event timezone (e.g., 'America/Los_Angeles').",
          "display_name": "Timezone",
          "name": "timezone",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "USD",
          "description": "Currency code for tickets (e.g., 'USD').",
          "display_name": "Currency",
          "name": "currency",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Summary or subtitle displayed with the event.",
          "display_name": "Summary",
          "name": "summary",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/eventbrite/create-draft-event",
      "result_str_template": "Created draft event with ID '{id}'.",
      "returns": {
        "description": "The created draft event details.",
        "type": "object"
      }
    },
    "list_organization_events": {
      "description": "List events for a specific Eventbrite organization.",
      "display_name": "List organization events",
      "display_str_template": "List events for organization '{0}'.",
      "handler": "actions.list_organization_events",
      "id": "eventbrite_list_organization_events",
      "method": "POST",
      "mock_response": {
        "events": [
          {
            "id": "111111111",
            "name": {
              "text": "Annual Conference 2025"
            },
            "status": "live"
          }
        ]
      },
      "name": "list_organization_events",
      "output_formatter": "actions.format_list_organization_events_output",
      "parameters": [
        {
          "description": "The organization ID.",
          "display_name": "Organization ID",
          "name": "organization_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Filter by event status (e.g., 'live', 'draft', 'completed').",
          "display_name": "Status",
          "name": "status",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/eventbrite/list-events",
      "result_str_template": "Retrieved {events,length} events.",
      "returns": {
        "description": "Response envelope; the payload is in the \"events\" field.",
        "properties": {
          "events": {
            "description": "List of events.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_user_organizations": {
      "description": "List all Eventbrite organizations your account belongs to.",
      "display_name": "List user organizations",
      "display_str_template": "List Eventbrite organizations.",
      "handler": "actions.list_user_organizations",
      "id": "eventbrite_list_user_organizations",
      "method": "POST",
      "mock_response": {
        "organizations": [
          {
            "id": "123456789",
            "name": "My Event Company"
          },
          {
            "id": "987654321",
            "name": "Secondary Org"
          }
        ]
      },
      "name": "list_user_organizations",
      "output_formatter": "actions.format_list_user_organizations_output",
      "parameters": [],
      "path": "/actions/library/eventbrite/list-organizations",
      "result_str_template": "Retrieved {organizations,length} organizations.",
      "returns": {
        "description": "Response envelope; the payload is in the \"organizations\" field.",
        "properties": {
          "organizations": {
            "description": "List of organizations.",
            "items": {
              "properties": {
                "id": {
                  "description": "Organization ID.",
                  "type": "string"
                },
                "name": {
                  "description": "Organization name.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Manage Eventbrite organizations and events with a personal token.",
  "display_name": "Eventbrite",
  "id": "eventbrite"
}
