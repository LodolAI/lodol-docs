  "categories": [
    "Events"
  ],
  "description": "Manage Eventbrite organizations and events with a personal token.",
  "display_name": "Eventbrite",
  "id": "eventbrite",
  "logo": "https://www.lodol.com/app-icons/eventbrite-icon.png",
  "triggers": {
    "eventbrite_new_attendee_trigger": {
      "description": "Runs for each new registration on your Eventbrite events, one per ticket, with the attendee's name, email, ticket type and order. Attendees already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New attendee",
      "id": "eventbrite_new_attendee_trigger",
      "output": {
        "company": "Their company, if asked for.",
        "created": "When they registered.",
        "email": "Their email address.",
        "event_id": "The event they registered for, for Get event.",
        "event_name": "The event's name (beta), for a confirmation that says which event.",
        "first_name": "Their first name.",
        "id": "The attendee's ID.",
        "job_title": "Their job title, if asked for.",
        "last_name": "Their last name.",
        "name": "Their full name.",
        "order_id": "The order their ticket was bought in.",
        "phone": "Their mobile number, if asked for.",
        "quantity": "How many this ticket is for.",
        "status": "Their status, such as Attending.",
        "ticket_class_name": "The ticket type, such as General Admission."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only run for this event: the number at the end of its Eventbrite link. Leave empty for every event in your organizations.",
          "display_name": "Event ID",
          "name": "event_id",
          "required": false
        }
      ]
    },
    "eventbrite_new_event_trigger": {
      "description": "Runs when a new event is created in Eventbrite",
      "display_name": "New event",
      "id": "eventbrite_new_event_trigger",
      "output": {
        "event_id": "string",
        "name": "string",
        "start_utc": "string",
        "status": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only trigger for events whose name contains this text. Leave blank to match any event.",
          "display_name": "Event name filter",
          "name": "event_name",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "Only trigger for events with this status (e.g. live, draft). Leave blank to match any status.",
          "display_name": "Status",
          "name": "status",
          "required": false
        }
      ]
    }
  }
}
