{
  "actions": {
    "create_draft_event": {
      "description": "Create a new draft event in an Eventbrite organization.",
      "display_name": "Create draft event",
      "display_str_template": "Create draft event '{1}' in organization '{0}'.",
      "handler": "actions.create_draft_event",
      "id": "eventbrite_create_draft_event",
      "method": "POST",
      "mock_response": {
        "id": "222222222",
        "name": {
          "text": "New Draft Event"
        },
        "status": "draft"
      },
      "name": "create_draft_event",
      "output_formatter": "actions.format_create_draft_event_output",
      "parameters": [
        {
          "description": "The organization ID.",
          "display_name": "Organization ID",
          "name": "organization_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The event name.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the event starts, in UTC (for example, 2026-07-15T09:00:00Z).",
          "display_name": "Start time (UTC)",
          "name": "start_utc",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the event ends, in UTC (for example, 2026-07-15T17:00:00Z).",
          "display_name": "End time (UTC)",
          "name": "end_utc",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The event timezone (e.g., 'America/Los_Angeles').",
          "display_name": "Timezone",
          "name": "timezone",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "USD",
          "description": "Currency code for tickets (e.g., 'USD').",
          "display_name": "Currency",
          "name": "currency",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Summary or subtitle displayed with the event.",
          "display_name": "Summary",
          "name": "summary",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/eventbrite/create-draft-event",
      "result_str_template": "Created draft event with ID '{id}'.",
      "returns": {
        "description": "The created draft event details.",
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "get_event": {
      "description": "Look up one event: its name, summary, link, status, start and end times, and capacity.",
      "display_name": "Get event",
      "display_str_template": "Get event '{0}'.",
      "handler": "actions.get_event",
      "id": "eventbrite_get_event",
      "method": "POST",
      "mock_response": {
        "capacity": 200,
        "changed": "2026-11-01T12:00:00Z",
        "created": "2026-10-01T12:00:00Z",
        "end_local": "2026-12-01T17:00:00",
        "end_utc": "2026-12-02T01:00:00Z",
        "id": "123456789012",
        "is_free": false,
        "name": "Annual Conference 2026",
        "online_event": false,
        "organization_id": "123456789",
        "start_local": "2026-12-01T09:00:00",
        "start_utc": "2026-12-01T17:00:00Z",
        "status": "live",
        "summary": "A day of talks and workshops.",
        "timezone": "America/Los_Angeles",
        "url": "https://www.eventbrite.com/e/annual-conference-2026-tickets-123456789012",
        "venue_id": "55555555"
      },
      "name": "get_event",
      "output_formatter": "actions.format_get_event_output",
      "parameters": [
        {
          "description": "The event's ID: the number at the end of its Eventbrite link, or from List organization events.",
          "display_name": "Event ID",
          "examples": [
            {
              "label": "Event ID",
              "value": "123456789012"
            }
          ],
          "name": "event_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/eventbrite/get-event",
      "result_str_template": "Retrieved event '{name}'.",
      "returns": {
        "properties": {
          "capacity": {
            "description": "How many people it can take, if set.",
            "type": [
              "number",
              "null"
            ]
          },
          "changed": {
            "description": "When it last changed.",
            "type": "string"
          },
          "created": {
            "description": "When it was created.",
            "type": "string"
          },
          "end_local": {
            "description": "When it ends, in its own time zone.",
            "type": "string"
          },
          "end_utc": {
            "description": "When it ends, in UTC.",
            "type": "string"
          },
          "id": {
            "description": "The event's ID.",
            "type": "string"
          },
          "is_free": {
            "description": "Whether its tickets are free.",
            "type": "boolean"
          },
          "name": {
            "description": "Its name.",
            "type": "string"
          },
          "online_event": {
            "description": "Whether it's online.",
            "type": "boolean"
          },
          "organization_id": {
            "description": "The organization it belongs to.",
            "type": "string"
          },
          "start_local": {
            "description": "When it starts, in its own time zone.",
            "type": "string"
          },
          "start_utc": {
            "description": "When it starts, in UTC.",
            "type": "string"
          },
          "status": {
            "description": "draft, live, started, ended, completed or canceled.",
            "type": "string"
          },
          "summary": {
            "description": "Its short summary.",
            "type": "string"
          },
          "timezone": {
            "description": "Its time zone, such as America/New_York.",
            "type": "string"
          },
          "url": {
            "description": "Its public Eventbrite page.",
            "type": "string"
          },
          "venue_id": {
            "description": "Its venue's ID, if it has one.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_attendees": {
      "description": "List the people registered for an event, one per ticket, with their name, email, ticket type and whether they've checked in.",
      "display_name": "List attendees",
      "display_str_template": "List attendees of event '{0}'.",
      "handler": "actions.list_attendees",
      "id": "eventbrite_list_attendees",
      "method": "POST",
      "mock_response": {
        "attendees": [
          {
            "cancelled": false,
            "changed": "2026-11-06T18:22:03Z",
            "checked_in": false,
            "company": "",
            "created": "2026-11-06T18:22:03Z",
            "email": "jamie@example.com",
            "event_id": "123456789012",
            "first_name": "Jamie",
            "id": "3000000001",
            "job_title": "",
            "last_name": "Rivera",
            "name": "Jamie Rivera",
            "order_id": "4000000001",
            "phone": "",
            "quantity": 1,
            "refunded": false,
            "status": "Attending",
            "ticket_class_name": "General Admission"
          }
        ],
        "has_more": false
      },
      "name": "list_attendees",
      "output_formatter": "actions.format_list_attendees_output",
      "parameters": [
        {
          "description": "The event's ID: the number at the end of its Eventbrite link, or from List organization events.",
          "display_name": "Event ID",
          "examples": [
            {
              "label": "Event ID",
              "value": "123456789012"
            }
          ],
          "name": "event_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only attendees who are attending, who aren't (cancelled or refunded), or whose order is unpaid. Leave empty for everyone.",
          "display_name": "Status",
          "name": "status",
          "options": [
            {
              "label": "Attending",
              "value": "attending"
            },
            {
              "label": "Not attending",
              "value": "not_attending"
            },
            {
              "label": "Unpaid",
              "value": "unpaid"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 50,
          "description": "How many attendees to return, 1 to 500. Defaults to 50.",
          "display_name": "Max results",
          "maximum": 500,
          "minimum": 1,
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/eventbrite/list-attendees",
      "result_str_template": "Retrieved {attendees,length} attendees.",
      "returns": {
        "properties": {
          "attendees": {
            "description": "The event's attendees, one per ticket.",
            "items": {
              "properties": {
                "cancelled": {
                  "description": "Whether it was cancelled.",
                  "type": "boolean"
                },
                "changed": {
                  "description": "When their registration last changed.",
                  "type": "string"
                },
                "checked_in": {
                  "description": "Whether they've checked in.",
                  "type": "boolean"
                },
                "company": {
                  "description": "Their company, if asked for.",
                  "type": "string"
                },
                "created": {
                  "description": "When they registered.",
                  "type": "string"
                },
                "email": {
                  "description": "Their email address.",
                  "type": "string"
                },
                "event_id": {
                  "description": "The event they registered for.",
                  "type": "string"
                },
                "first_name": {
                  "description": "Their first name.",
                  "type": "string"
                },
                "id": {
                  "description": "The attendee's ID.",
                  "type": "string"
                },
                "job_title": {
                  "description": "Their job title, if asked for.",
                  "type": "string"
                },
                "last_name": {
                  "description": "Their last name.",
                  "type": "string"
                },
                "name": {
                  "description": "Their full name.",
                  "type": "string"
                },
                "order_id": {
                  "description": "The order their ticket was bought in.",
                  "type": "string"
                },
                "phone": {
                  "description": "Their mobile number, if asked for.",
                  "type": "string"
                },
                "quantity": {
                  "description": "How many this ticket is for.",
                  "type": "number"
                },
                "refunded": {
                  "description": "Whether it was refunded.",
                  "type": "boolean"
                },
                "status": {
                  "description": "Their status, such as Attending, Checked In or Not Attending.",
                  "type": "string"
                },
                "ticket_class_name": {
                  "description": "The ticket type, such as General Admission.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "description": "Whether the event has more than were returned.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_organization_events": {
      "description": "List events for a specific Eventbrite organization.",
      "display_name": "List organization events",
      "display_str_template": "List events for organization '{0}'.",
