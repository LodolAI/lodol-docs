      "id": "eventbrite_list_organization_events",
      "method": "POST",
      "mock_response": {
        "events": [
          {
            "id": "111111111",
            "name": {
              "text": "Annual Conference 2025"
            },
            "status": "live"
          }
        ]
      },
      "name": "list_organization_events",
      "output_formatter": "actions.format_list_organization_events_output",
      "parameters": [
