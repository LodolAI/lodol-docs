{
  "actions": {
    "create_document": {
      "description": "Create a new document from a PandaDoc template.",
      "display_name": "Create document from template",
      "display_str_template": "Create PandaDoc document '{0}'.",
      "handler": "actions.create_document",
      "id": "pandadoc_create_document",
      "method": "POST",
      "mock_response": {
        "document_id": "AbCdEfGh123456",
        "name": "Sales Proposal: Acme Corp",
        "status": "document.uploaded"
      },
      "name": "create_document",
      "parameters": [
        {
          "description": "Name for the new document.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the PandaDoc template to create the document from. Find it in the template's URL when viewing it in the PandaDoc app: app.pandadoc.com/a/#/templates/{id}.",
          "display_name": "Template ID",
          "name": "template_uuid",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Who should receive the document. Each recipient needs an email; first_name, last_name, and role are optional.",
          "display_name": "Recipients",
          "name": "recipients",
          "required": true,
          "schema": {
            "items": {
              "properties": {
                "email": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "role": {
                  "description": "Recipient role name as defined on the template. Added as CC if omitted.",
                  "type": "string"
                }
              },
              "required": [
                "email"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/pandadoc/create-document",
      "result_str_template": "Document created.",
      "returns": {
        "properties": {
          "document_id": {
            "description": "ID of the created document. Use with get-document-status and send-document.",
            "type": "string"
          },
          "name": {
            "description": "Document name",
            "type": "string"
          },
          "status": {
            "description": "Document status immediately after creation, typically 'document.uploaded' while it is generated",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_document_status": {
      "description": "Check a document's current status.",
      "display_name": "Get document status",
      "display_str_template": "Get status of PandaDoc document '{0}'.",
      "handler": "actions.get_document_status",
      "id": "pandadoc_get_document_status",
      "method": "POST",
      "mock_response": {
        "date_completed": "2026-01-16T09:00:00.000000Z",
        "date_created": "2026-01-15T10:00:00.000000Z",
        "date_modified": "2026-01-16T09:00:00.000000Z",
        "id": "AbCdEfGh123456",
        "name": "Sales Proposal: Acme Corp",
        "status": "document.completed"
      },
      "name": "get_document_status",
      "parameters": [
        {
          "description": "ID of the document to look up.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/pandadoc/get-document-status",
      "result_str_template": "Retrieved the document status.",
      "returns": {
        "properties": {
          "date_completed": {
            "description": "When the document was completed, empty if not yet completed",
            "type": "string"
          },
          "date_created": {
            "description": "When the document was created",
            "type": "string"
          },
          "date_modified": {
            "description": "When the document was last modified",
            "type": "string"
          },
          "id": {
            "description": "Document ID",
            "type": "string"
          },
          "name": {
            "description": "Document name",
            "type": "string"
          },
          "status": {
            "description": "Document status, for example 'document.draft', 'document.sent', or 'document.completed'",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_documents": {
      "description": "List the documents in your PandaDoc account.",
      "display_name": "List documents",
      "display_str_template": "List PandaDoc documents.",
      "handler": "actions.list_documents",
      "id": "pandadoc_list_documents",
      "method": "POST",
      "mock_response": {
        "documents": [
          {
            "date_created": "2026-01-15T10:00:00.000000Z",
            "date_modified": "2026-01-15T10:00:00.000000Z",
            "id": "AbCdEfGh123456",
            "name": "Sales Proposal: Acme Corp",
            "status": "document.draft"
          }
        ]
      },
      "name": "list_documents",
      "parameters": [
        {
          "description": "Maximum number of documents to return (default 25).",
          "display_name": "Maximum documents",
          "name": "count",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/pandadoc/list-documents",
      "result_str_template": "Fetched PandaDoc documents.",
      "returns": {
        "properties": {
          "documents": {
            "description": "List of documents in the account",
            "items": {
              "properties": {
                "date_created": {
                  "description": "When the document was created",
                  "type": "string"
                },
                "date_modified": {
                  "description": "When the document was last modified",
                  "type": "string"
                },
                "id": {
                  "description": "Document ID. Use with the other actions.",
                  "type": "string"
                },
                "name": {
                  "description": "Document name",
                  "type": "string"
                },
                "status": {
                  "description": "Document status, for example 'document.draft' or 'document.completed'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "send_document": {
      "description": "Send a draft document to its recipients for signature.",
      "display_name": "Send document",
      "display_str_template": "Send PandaDoc document '{0}'.",
      "handler": "actions.send_document",
      "id": "pandadoc_send_document",
      "method": "POST",
      "mock_response": {
        "id": "AbCdEfGh123456",
        "recipients": [
          {
            "email": "jane@example.com",
            "first_name": "Jane",
            "last_name": "Doe"
          }
        ],
        "status": "document.sent"
      },
      "name": "send_document",
      "parameters": [
        {
          "description": "ID of the document to send.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email subject line. Uses the document's default if omitted.",
          "display_name": "Subject",
          "name": "subject",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email message body. Uses the document's default if omitted.",
          "display_name": "Message",
          "multiline": true,
          "name": "message",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/pandadoc/send-document",
      "result_str_template": "Document sent.",
      "returns": {
        "properties": {
          "id": {
            "description": "Document ID",
            "type": "string"
          },
          "recipients": {
            "description": "Recipients the document was sent to",
            "items": {
              "properties": {
                "email": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "description": "Document status after sending, typically 'document.sent'",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your PandaDoc account to create, send, and track documents.",
  "display_name": "PandaDoc",
  "id": "pandadoc"
}
