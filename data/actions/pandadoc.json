{
  "actions": {
    "create_document": {
      "description": "Create a new document from a PandaDoc template.",
      "display_name": "Create document from template",
      "display_str_template": "Create document '{0}'.",
      "handler": "actions.create_document",
      "id": "pandadoc_create_document",
      "method": "POST",
      "mock_response": {
        "document_id": "AbCdEfGh123456",
        "name": "Sales Proposal: Acme Corp",
        "status": "document.uploaded"
      },
      "name": "create_document",
      "parameters": [
        {
          "description": "Name for the new document.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The PandaDoc template to create the document from. Pick one, or paste its ID from the template's link: app.pandadoc.com/a/#/templates/{id}.",
          "display_name": "Template",
          "dynamic_source": "templates",
          "dynamic_source_allows_custom": true,
          "name": "template_uuid",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Who should receive the document. Each recipient needs an email; first_name, last_name, and role are optional.",
          "display_name": "Recipients",
          "name": "recipients",
          "required": true,
          "schema": {
            "items": {
              "properties": {
                "email": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "role": {
                  "description": "Recipient role name as defined on the template. Added as CC if omitted.",
                  "type": "string"
                }
              },
              "required": [
                "email"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/pandadoc/create-document",
      "result_str_template": "Document created.",
      "returns": {
        "properties": {
          "document_id": {
            "description": "ID of the created document. Use with get-document-status and send-document.",
            "type": "string"
          },
          "name": {
            "description": "Document name",
            "type": "string"
          },
          "status": {
            "description": "Document status immediately after creation, typically 'document.uploaded' while it is generated",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
