        {
          "description": "The procedure's name, e.g. usp_GetCustomer. Use 'List stored procedures' to find one.",
          "display_name": "Procedure",
          "name": "procedure",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "dbo",
          "description": "The table's schema. Most tables are in dbo.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Argument names and values, e.g. {\"@customer_id\": 42}. The @ is optional.",
          "display_name": "Arguments",
          "name": "parameters",
          "object_key_name": "Parameter",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "default": 1000,
          "description": "Return at most this many rows.",
          "display_name": "Maximum rows",
          "maximum": 10000,
          "minimum": 1,
          "name": "max_rows",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/mssql/execute-stored-procedure",
      "result_str_template": "Ran the SQL Server procedure.",
      "returns": {
        "properties": {
          "procedure": {
            "type": "string"
          },
          "result_set_count": {
            "type": "number"
          },
          "result_sets": {
            "items": {
              "properties": {
                "columns": {
                  "description": "Column names, in order",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "row_count": {
                  "description": "Rows returned",
                  "type": "number"
                },
                "rows": {
                  "description": "The rows, each keyed by column",
                  "items": {
                    "description": "One row, keyed by column",
                    "type": "object"
                  },
                  "type": "array"
                },
                "truncated": {
                  "description": "True when more rows existed than the limit allowed",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "return_value": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
