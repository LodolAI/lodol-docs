          {
            "columns": [
              "id",
              "name",
              "email"
            ],
            "row_count": 1,
            "rows": [
              {
                "email": "ada@example.com",
                "id": 1,
                "name": "Ada Lovelace"
              }
            ],
            "truncated": false
          }
