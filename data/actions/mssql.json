    "select_rows": {
      "description": "Read rows from a table without writing SQL: choose columns, match on values, sort and page. A limit always applies.",
      "display_name": "Select rows",
      "display_str_template": "Read rows from SQL Server table '{0}'.",
      "handler": "actions.select_rows",
      "id": "mssql_select_rows",
      "method": "POST",
      "mock_response": {
        "columns": [
          "id",
          "name",
          "email"
        ],
        "row_count": 1,
        "rows": [
          {
            "email": "ada@example.com",
            "id": 1,
            "name": "Ada Lovelace"
          }
        ],
        "table": "dbo.Customers",
        "truncated": false
      },
      "name": "select_rows",
      "output_formatter": "actions.format_rows_output",
      "parameters": [
        {
          "description": "The table's name, e.g. Customers (or sales.Customers to name the schema too). Use 'List tables' to find one.",
          "display_name": "Table",
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "dbo",
          "description": "The table's schema. Most tables are in dbo.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Columns to return. Leave empty for all.",
          "display_name": "Columns",
          "name": "columns",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Column and value pairs every row must equal, e.g. {\"status\": \"active\"}. A list matches any of its values; null matches empty.",
          "display_name": "Match rows where",
          "name": "filters",
          "object_key_name": "Column",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Column to sort on. Leave empty for no order.",
          "display_name": "Sort by column",
          "name": "order_by",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "ASC",
          "description": "Which way to sort, when a sort column is given.",
          "display_name": "Sort direction",
          "name": "sort_direction",
          "options": [
            {
              "label": "Ascending",
              "value": "ASC"
            },
            {
              "label": "Descending",
              "value": "DESC"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 100,
          "description": "Return at most this many rows.",
          "display_name": "Maximum rows",
          "maximum": 10000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 0,
          "description": "Skip this many rows first, for paging. Set a sort column too, or the pages may overlap.",
          "display_name": "Skip rows",
          "maximum": 100000000,
          "minimum": 0,
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/mssql/select-rows",
      "result_str_template": "Read rows from the SQL Server table.",
      "returns": {
        "properties": {
          "columns": {
            "description": "Column names, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "row_count": {
            "description": "Rows returned",
            "type": "number"
          },
          "rows": {
            "description": "The rows, each keyed by column",
            "items": {
              "description": "One row, keyed by column",
              "type": "object"
            },
            "type": "array"
          },
          "table": {
            "description": "schema.table",
            "type": "string"
          },
          "truncated": {
            "description": "True when more rows existed than the limit allowed",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
