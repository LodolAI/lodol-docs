{
  "actions": {
    "count_rows": {
      "description": "How many rows in a table match the given values.",
      "display_name": "Count rows",
      "display_str_template": "Count rows in SQL Server table '{0}'.",
      "handler": "actions.count_rows",
      "id": "mssql_count_rows",
      "method": "POST",
      "mock_response": {
        "count": 42,
        "table": "dbo.Customers"
      },
      "name": "count_rows",
      "output_formatter": "actions.format_count_output",
      "parameters": [
        {
          "description": "The table's name, e.g. Customers (or sales.Customers to name the schema too). Use 'List tables' to find one.",
          "display_name": "Table",
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "dbo",
          "description": "The table's schema. Most tables are in dbo.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Column and value pairs every row must equal, e.g. {\"status\": \"active\"}. A list matches any of its values; null matches empty.",
          "display_name": "Match rows where",
          "name": "filters",
          "object_key_name": "Column",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/mssql/count-rows",
      "result_str_template": "Counted the rows.",
      "returns": {
        "properties": {
          "count": {
            "type": "number"
          },
          "table": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_table": {
      "description": "Create a table from a list of columns. By default an existing table of that name is left alone.",
      "display_name": "Create table",
      "display_str_template": "Create SQL Server table '{0}'.",
      "handler": "actions.create_table",
      "id": "mssql_create_table",
      "method": "POST",
      "mock_response": {
        "created": true,
        "table": "dbo.Customers"
      },
      "name": "create_table",
      "output_formatter": "actions.format_table_output",
      "parameters": [
        {
          "description": "The table's name, e.g. Customers (or sales.Customers to name the schema too). Use 'List tables' to find one.",
          "display_name": "Table",
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "dbo",
          "description": "The table's schema. Most tables are in dbo.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "One entry per column, written as name then type, e.g. 'id int identity primary key', 'email nvarchar(255) not null', 'amount decimal(10,2)'. Types: bigint, int, smallint, tinyint, bit, decimal, numeric, money, smallmoney, float, real, date, time, datetime2, datetimeoffset, datetime, smalldatetime, char, varchar, nchar, nvarchar, binary, varbinary, uniqueidentifier, xml.",
          "display_name": "Columns",
          "name": "columns",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "default": true,
          "description": "Leave an existing table alone instead of failing.",
          "display_name": "Skip if it exists",
          "name": "if_not_exists",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/mssql/create-table",
      "result_str_template": "Created the SQL Server table.",
      "returns": {
        "properties": {
          "created": {
            "type": "boolean"
          },
          "table": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_rows": {
      "description": "Remove the rows matching the given values. At least one match is required.",
      "display_name": "Delete rows",
      "display_str_template": "Delete rows from SQL Server table '{0}'.",
      "handler": "actions.delete_rows",
      "id": "mssql_delete_rows",
      "method": "POST",
      "mock_response": {
        "rows_affected": 1,
        "table": "dbo.Customers"
      },
      "name": "delete_rows",
      "output_formatter": "actions.format_write_output",
      "parameters": [
        {
          "description": "The table's name, e.g. Customers (or sales.Customers to name the schema too). Use 'List tables' to find one.",
          "display_name": "Table",
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "dbo",
          "description": "The table's schema. Most tables are in dbo.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Column and value pairs every row must equal, e.g. {\"id\": 42}. Required, so the whole table can never be changed by accident.",
          "display_name": "Match rows where",
          "name": "filters",
          "object_key_name": "Column",
          "required": true,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/mssql/delete-rows",
      "result_str_template": "Deleted the rows.",
      "returns": {
        "properties": {
          "rows_affected": {
            "type": "number"
          },
          "table": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "drop_table": {
      "description": "Delete a table and every row in it. This cannot be undone.",
      "display_name": "Drop table",
      "display_str_template": "Drop SQL Server table '{0}'.",
      "handler": "actions.drop_table",
      "id": "mssql_drop_table",
      "method": "POST",
      "mock_response": {
        "dropped": true,
        "table": "dbo.Customers"
      },
      "name": "drop_table",
      "output_formatter": "actions.format_table_output",
      "parameters": [
        {
          "description": "The table's name, e.g. Customers (or sales.Customers to name the schema too). Use 'List tables' to find one.",
          "display_name": "Table",
          "name": "table",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "dbo",
          "description": "The table's schema. Most tables are in dbo.",
          "display_name": "Schema",
          "dynamic_source": "schemas",
          "dynamic_source_allows_custom": true,
          "name": "schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Succeed without doing anything if it is not there.",
          "display_name": "Ignore if missing",
          "name": "if_exists",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/mssql/drop-table",
      "result_str_template": "Dropped the SQL Server table.",
      "returns": {
        "properties": {
          "dropped": {
            "type": "boolean"
          },
          "table": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "execute_query": {
      "description": "Run a T-SQL query and return its rows. Use %(name)s placeholders with 'Parameters' for any value that comes from data. The login's permissions decide what it can touch.",
      "display_name": "Run query",
      "display_str_template": "Run a SQL Server query.",
      "handler": "actions.execute_query",
      "id": "mssql_execute_query",
      "method": "POST",
      "mock_response": {
        "columns": [
          "id",
          "name",
          "email"
        ],
        "row_count": 1,
        "rows": [
          {
            "email": "ada@example.com",
            "id": 1,
            "name": "Ada Lovelace"
          }
        ],
        "rows_affected": -1,
        "truncated": false
      },
      "name": "execute_query",
      "output_formatter": "actions.format_rows_output",
      "parameters": [
        {
          "description": "The T-SQL to run, e.g. SELECT * FROM dbo.Customers WHERE status = %(status)s.",
          "display_name": "SQL query",
          "multiline": true,
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Values for each %(name)s in the SQL, e.g. {\"status\": \"active\"} for WHERE status = %(status)s. Passing values here, not pasting them into the SQL, keeps a quote in the data from changing the statement.",
          "display_name": "Parameters",
          "name": "parameters",
          "object_key_name": "Name",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "default": 1000,
          "description": "Return at most this many rows.",
          "display_name": "Maximum rows",
          "maximum": 10000,
          "minimum": 1,
          "name": "max_rows",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/mssql/execute-query",
      "result_str_template": "Ran the SQL Server query.",
      "returns": {
        "properties": {
          "columns": {
            "description": "Column names, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "row_count": {
            "description": "Rows returned",
            "type": "number"
          },
          "rows": {
            "description": "The rows, each keyed by column",
            "items": {
              "description": "One row, keyed by column",
              "type": "object"
            },
            "type": "array"
          },
          "rows_affected": {
            "description": "Rows changed, when the batch changed data",
            "type": "number"
          },
          "truncated": {
            "description": "True when more rows existed than the limit allowed",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "execute_statement": {
      "description": "Run an INSERT, UPDATE, DELETE, MERGE or DDL statement (such as CREATE VIEW) and get the number of rows it changed. Use %(name)s placeholders with 'Parameters' for values.",
      "display_name": "Run statement",
      "display_str_template": "Run a SQL Server statement.",
      "handler": "actions.execute_statement",
      "id": "mssql_execute_statement",
      "method": "POST",
      "mock_response": {
        "rows_affected": 1
      },
      "name": "execute_statement",
      "output_formatter": "actions.format_write_output",
      "parameters": [
        {
          "description": "The T-SQL to run.",
          "display_name": "SQL statement",
          "multiline": true,
          "name": "statement",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Values for each %(name)s in the SQL, e.g. {\"status\": \"active\"} for WHERE status = %(status)s. Passing values here, not pasting them into the SQL, keeps a quote in the data from changing the statement.",
          "display_name": "Parameters",
          "name": "parameters",
          "object_key_name": "Name",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/mssql/execute-statement",
      "result_str_template": "Ran the SQL Server statement.",
      "returns": {
        "properties": {
          "rows_affected": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "execute_stored_procedure": {
      "description": "Run a stored procedure with named arguments and return every result set it produces plus its return value.",
