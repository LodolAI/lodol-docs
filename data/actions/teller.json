  "categories": [
    "Accounting & Finance"
  ],
  "description": "Read linked accounts, balances and transactions using a Teller enrollment.",
  "display_name": "Teller",
  "id": "teller",
  "logo": "https://www.lodol.com/app-icons/teller-icon.ico",
  "triggers": {
    "teller_new_account_trigger": {
      "description": "Runs for each new linked account in Teller. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New linked account",
      "id": "teller_new_account_trigger",
      "output": {
        "record": "object with the fields id, name, enrollment_id, currency, last_four, status, type, subtype, institution.id, institution.name, links"
      },
      "parameters": []
    },
    "teller_new_transaction_trigger": {
      "description": "Runs for each new transaction in Teller. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New transaction",
      "id": "teller_new_transaction_trigger",
      "output": {
        "record": "object with the fields id, account_id, date, description, amount, status, type, details"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Teller account ID.",
          "display_name": "Account ID",
          "name": "account_id",
          "required": true
        }
      ]
    },
    "teller_transaction_status_changed_trigger": {
      "description": "Runs each time a transaction status changes in Teller. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Transaction status changed",
      "id": "teller_transaction_status_changed_trigger",
      "output": {
        "record": "object with the fields id, account_id, date, description, amount, status, type, details"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Teller account ID.",
          "display_name": "Account ID",
          "name": "account_id",
          "required": true
        }
      ]
    }
  }
