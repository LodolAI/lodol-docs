  "triggers": {
    "chatwork_edited_message_trigger": {
      "description": "Runs for each chat message edited in Chatwork. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Chat message edited",
      "id": "chatwork_edited_message_trigger",
      "output": {
        "record": "object with the fields message_id, body, send_time, update_time, account.account_id, account.name, account.chatwork_id, account.avatar_image_url"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The room id.",
          "display_name": "Room ID",
          "name": "room_id",
          "required": true
        }
      ]
    },
