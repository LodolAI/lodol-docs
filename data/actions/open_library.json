{
  "actions": {
    "get_author": {
      "description": "Fetch a single author by their Open Library author id, for example OL26320A. Accepts a bare id, a full key such as /authors/OL26320A, or the author's page address. An author who was merged into another returns the one they were merged into, and the bio always comes back as plain text.",
      "display_name": "Get an author",
      "display_str_template": "Get Open Library author {0}.",
      "handler": "actions.get_author",
      "id": "open_library_get_author",
      "method": "POST",
      "mock_response": {
        "author": {
          "bio": "John Ronald Reuel Tolkien (1892-1973) was a major scholar of the English language, specialising in Old and Middle English.",
