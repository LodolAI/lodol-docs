    "get_book_cover_url": {
      "description": "Build the URL of a book's cover image from an identifier. Choose the identifier type (ISBN, OCLC, LCCN, Open Library edition ID, or cover ID) and a size (small, medium, or large). For a work, use its cover ID: cover_i from Search books, or covers from Get a work. Returns the direct image URL. No request is made, so the URL is returned even if no cover exists for that identifier. Prefer cover or edition IDs for many covers: Open Library serves at most 100 covers every 5 minutes looked up by ISBN, OCLC or LCCN.",
      "display_name": "Get a book cover URL",
      "display_str_template": "Build Open Library cover URL for {0} {1}.",
      "handler": "actions.get_book_cover_url",
      "id": "open_library_get_book_cover_url",
      "method": "POST",
      "mock_response": {
        "cover_url": "https://covers.openlibrary.org/b/isbn/9780140328721-M.jpg"
      },
      "name": "get_book_cover_url",
      "parameters": [
        {
          "description": "Which kind of identifier the value is.",
          "display_name": "Identifier type",
          "name": "key",
          "options": [
            {
              "label": "ISBN",
              "value": "isbn"
            },
            {
              "label": "OCLC number",
              "value": "oclc"
            },
            {
              "label": "LCCN",
              "value": "lccn"
            },
            {
              "label": "Open Library edition ID",
              "value": "olid"
            },
            {
              "label": "Cover ID",
              "value": "id"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The identifier value (for example, 9780140328721 for an ISBN, OL7353617M for an edition, or 8739161 for a cover ID).",
          "display_name": "Identifier value",
          "name": "value",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "M",
          "description": "The cover image size: S (small), M (medium), or L (large).",
          "display_name": "Size",
          "name": "size",
          "options": [
            {
              "label": "Small",
              "value": "S"
            },
            {
              "label": "Medium",
              "value": "M"
            },
            {
              "label": "Large",
              "value": "L"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/open-library/get-book-cover-url",
      "result_str_template": "Cover URL built.",
      "returns": {
        "properties": {
          "cover_url": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
