{
  "actions": {
    "batch_create_rows": {
      "description": "Add up to 200 rows to a table in one go. Baserow does not send its own row webhooks for batch changes.",
      "display_name": "Create rows",
      "display_str_template": "Create rows in table {0}.",
      "handler": "actions.batch_create_rows",
      "id": "baserow_batch_create_rows",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "items": [
          {
            "id": 13,
            "order": "13.00000000000000000000"
          }
        ]
      },
      "name": "batch_create_rows",
      "output_formatter": "actions.format_batch_rows_output",
      "parameters": [
        {
          "description": "The table to work with. Pick it from the list, or paste its id or its web address from Baserow (the number after `/table/`).",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_allows_custom": true,
          "name": "table_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Up to 200 rows, each a set of column names and values, such as [{\"Name\": \"Acme\"}, {\"Name\": \"Globex\"}].",
          "display_name": "Rows",
          "name": "rows",
          "required": true,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The id of the row to place it in front of. Leave blank to place it at the end of the table.",
          "display_name": "Place before row",
          "name": "before_row_id",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": true,
          "description": "On: the row comes back keyed by your column names, like 'Name'. Off: by Baserow's column codes, like 'field_123'.",
          "display_name": "Use column names",
          "name": "user_field_names",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/baserow/batch-create-rows",
      "result_str_template": "Created rows in table {0}.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many rows were created.",
            "type": "integer"
          },
          "items": {
            "description": "The new rows, in order.",
            "items": {
              "description": "A row: its id and position, plus one value per column, named after it.",
              "properties": {
                "id": {
                  "description": "The row's id.",
                  "type": "integer"
                },
                "order": {
                  "description": "The row's position, as a decimal number.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
