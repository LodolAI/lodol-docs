{
  "actions": {
    "create_transaction": {
      "description": "Add one transaction to a budget account. Use a negative amount for money spent and a positive amount for money received.",
      "display_name": "Create a transaction",
      "display_str_template": "Add a {3} transaction to YNAB account {1}.",
      "handler": "actions.create_transaction",
      "id": "ynab_create_transaction",
      "method": "POST",
      "mock_response": {
        "transaction": {
          "account_id": "bb20b20b-2b2b-4b2b-8b2b-2b2b2b2b2b2b",
          "account_name": "Everyday Checking",
          "amount": -12.5,
          "approved": true,
          "category_id": "ee50e50e-5e5e-4e5e-8e5e-5e5e5e5e5e5e",
          "category_name": "Dining Out",
          "cleared": "uncleared",
          "date": "2024-01-15",
          "deleted": false,
          "flag_color": null,
          "id": "cc30c30c-3c3c-4c3c-8c3c-3c3c3c3c3c3c",
          "import_id": null,
          "memo": "Lunch",
          "payee_id": "dd40d40d-4d4d-4d4d-8d4d-4d4d4d4d4d4d",
          "payee_name": "Corner Deli",
          "transfer_account_id": null
        }
      },
      "name": "create_transaction",
      "parameters": [
        {
          "description": "Optional. Which budget to use. Defaults to the budget you most recently opened in YNAB. List budgets to find an id.",
          "display_name": "Budget ID",
          "name": "budget_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Which account the transaction belongs to. List accounts to find the id.",
          "display_name": "Account ID",
          "name": "account_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The transaction date, as YYYY-MM-DD.",
          "display_name": "Date",
          "name": "date",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The amount as a normal currency figure, for example -12.50 for money spent or 1500 for money received. YNAB's milliunit conversion is handled for you.",
          "display_name": "Amount",
          "name": "amount",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Who the money went to or came from. YNAB creates the payee if it does not exist yet.",
          "display_name": "Payee",
          "name": "payee_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Which category to file this under. List categories to find the id.",
          "display_name": "Category ID",
          "name": "category_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. A free-text memo on the transaction.",
          "display_name": "Memo",
          "name": "memo",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Whether the transaction has cleared the account. YNAB defaults to uncleared.",
          "display_name": "Cleared status",
          "name": "cleared",
          "options": [
            {
              "label": "Uncleared",
              "value": "uncleared"
            },
            {
              "label": "Cleared",
              "value": "cleared"
            },
            {
              "label": "Reconciled",
              "value": "reconciled"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Optional. Whether the transaction is approved. On by default; turn it off to leave it for review in YNAB.",
          "display_name": "Approved",
          "name": "approved",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/ynab/create-transaction",
      "result_str_template": "Added transaction {ynab_create_transaction,transaction.id}.",
      "returns": {
        "properties": {
          "transaction": {
            "description": "The transaction as YNAB stored it.",
            "properties": {
              "account_id": {
                "description": "Account this belongs to.",
                "type": "string"
              },
              "account_name": {
                "description": "Account name.",
                "type": "string"
              },
              "amount": {
                "description": "Amount as a currency amount, e.g. -12.50. Negative is money out, positive is money in.",
                "type": "number"
              },
              "approved": {
                "description": "Whether the transaction has been approved.",
                "type": "boolean"
              },
              "category_id": {
                "description": "Category id, if categorized.",
                "type": "string"
              },
              "category_name": {
                "description": "Category name.",
                "type": "string"
              },
              "cleared": {
                "description": "cleared, uncleared, or reconciled.",
                "type": "string"
              },
              "date": {
                "description": "Transaction date, YYYY-MM-DD.",
                "type": "string"
              },
              "deleted": {
                "description": "Whether the transaction was deleted.",
                "type": "boolean"
              },
              "flag_color": {
                "description": "Flag colour, e.g. red, orange, blue. Null if unflagged.",
                "type": "string"
              },
              "id": {
                "description": "Transaction id.",
                "type": "string"
              },
              "import_id": {
                "description": "Import id, set when the transaction came from a bank.",
                "type": "string"
              },
              "memo": {
                "description": "Free-text memo.",
                "type": "string"
              },
              "payee_id": {
                "description": "Payee id, if there is one.",
                "type": "string"
              },
              "payee_name": {
                "description": "Payee name.",
                "type": "string"
              },
              "transfer_account_id": {
                "description": "The other account, when this is a transfer.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_accounts": {
      "description": "List a budget's accounts with their current, cleared, and uncleared balances as currency amounts.",
      "display_name": "List accounts",
      "display_str_template": "List accounts in YNAB budget {0}.",
