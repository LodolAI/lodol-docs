                "cleared_balance": {
                  "description": "Balance of cleared transactions only.",
                  "type": "number"
                },
                "closed": {
                  "description": "Whether the account is closed.",
                  "type": "boolean"
                },
                "deleted": {
                  "description": "Whether the account was deleted.",
                  "type": "boolean"
                },
                "id": {
                  "description": "Account id, needed to create a transaction.",
                  "type": "string"
                },
                "last_reconciled_at": {
                  "description": "When the account was last reconciled, ISO 8601.",
                  "type": "string"
                },
                "name": {
                  "description": "Account name.",
                  "type": "string"
                },
                "note": {
                  "description": "Free-text note on the account.",
                  "type": "string"
                },
                "on_budget": {
                  "description": "Whether the account's activity is budgeted. False for a tracking account, where only the balance is followed.",
                  "type": "boolean"
                },
                "type": {
                  "description": "Account type, e.g. checking, savings, creditCard.",
                  "type": "string"
                },
                "uncleared_balance": {
                  "description": "Balance of transactions not yet cleared.",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "count": {
            "description": "How many accounts were returned.",
            "type": "integer"
          }
        },
        "type": "object"
      }
