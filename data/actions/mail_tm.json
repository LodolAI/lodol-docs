{
  "actions": {
    "create_inbox": {
      "description": "Create a new throwaway email inbox and get its address and password. Use the address wherever an email should go, such as a sign-up form, then read what arrives with 'Wait for an email'. The other mail.tm steps take this address and password.",
      "display_name": "Create inbox",
      "display_str_template": "Create a mail.tm inbox.",
      "handler": "actions.create_inbox",
      "id": "mail_tm_create_inbox",
      "method": "POST",
      "mock_response": {
        "address": "k3x9q2m7p1ab@maxxspace.com",
        "created_at": "2026-10-15T17:58:07Z",
        "domain": "maxxspace.com",
        "inbox_id": "6ad1142f52ef514b9c0fef28",
        "password": "q7Zr1vKx9LmPw2NcT5yHbE3s"
      },
      "name": "create_inbox",
      "output_formatter": "actions.format_create_inbox_output",
      "parameters": [
        {
          "description": "The part before the @. Leave empty for a random one, which is never already taken.",
          "display_name": "Name",
          "examples": [
            {
              "label": "A chosen name",
              "value": "signup-test"
            }
          ],
          "name": "username",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The part after the @. Leave empty to use the first one mail.tm offers.",
          "display_name": "Domain",
          "dynamic_source": "domains",
          "name": "domain",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Leave empty and a strong one is made for you. Either way, the step returns it.",
          "display_name": "Password",
          "name": "password",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mail-tm/create-inbox",
      "result_str_template": "Inbox created.",
      "returns": {
        "properties": {
          "address": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "inbox_id": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
