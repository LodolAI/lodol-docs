    "push_logs": {
      "description": "Send one or several log lines to Loki under labels you choose, such as an audit trail of what a workflow did. Each line keeps its order.",
      "display_name": "Send log lines",
      "display_str_template": "Send log lines to Loki.",
      "handler": "actions.push_logs",
      "id": "grafana_loki_push_logs",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "first_time": "2026-11-09T14:30:00Z",
        "first_timestamp": "1794234600000000000",
        "labels": {
          "app": "billing-workflow",
          "env": "production"
        },
        "last_time": "2026-11-09T14:30:00.000000001Z",
        "last_timestamp": "1794234600000000001",
        "selector": "{app=\"billing-workflow\", env=\"production\"}"
      },
      "name": "push_logs",
      "output_formatter": "actions.format_pushed",
      "parameters": [
        {
          "description": "The labels to file the lines under, such as app billing-workflow and env production. Keep them to a few values that repeat; put ids and details in the line.",
          "display_name": "Labels",
          "name": "labels",
          "object_key_name": "Label",
          "required": true,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The text to log, one line each, or a list from an earlier step (records are written as JSON).",
          "display_name": "Log lines",
          "multiline": true,
          "name": "lines",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When it happened. Leave empty for now. Loki refuses times more than about an hour old or ahead.",
          "display_name": "Time",
          "name": "timestamp",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Extra name and value pairs kept with each line without being labels, such as order_id or trace_id. Needs Loki 3.",
          "display_name": "Details",
          "name": "metadata",
          "object_key_name": "Name",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/grafana-loki/push-logs",
      "result_str_template": "Sent {grafana_loki_push_logs,count} log line(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many lines were sent",
            "type": "number"
          },
          "first_time": {
            "description": "The first line's time, in UTC (ISO 8601)",
            "type": "string"
          },
          "first_timestamp": {
            "description": "The first line's time in nanoseconds",
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The labels the lines were filed under",
            "type": "object"
          },
          "last_time": {
            "description": "The last line's time, in UTC (ISO 8601)",
            "type": "string"
          },
          "last_timestamp": {
            "description": "The last line's time in nanoseconds",
            "type": "string"
          },
          "selector": {
            "description": "Those labels as a LogQL selector, such as {app=\"billing\"}, to find the lines again",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "run_metric_query": {
      "description": "Run a LogQL metric query, such as an error rate or bytes logged per app, and get its numbers. 'value' holds the first result's number.",
      "display_name": "Run metric query",
      "display_str_template": "Run the Loki metric query {0}.",
      "handler": "actions.run_metric_query",
      "id": "grafana_loki_run_metric_query",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "query": "sum by (app)(rate({env=\"production\"} |= \"error\" [5m]))",
        "results": [
          {
            "labels": {
              "app": "checkout"
            },
            "raw_value": "0.42",
            "value": 0.42
          }
        ],
        "time": "2026-11-09T14:30:00Z",
        "truncated": false,
        "value": 0.42
      },
      "name": "run_metric_query",
      "output_formatter": "actions.format_metric",
      "parameters": [
        {
          "description": "A LogQL metric query, such as sum by (app) (rate({env=\"production\"} |= \"error\" [5m])).",
          "display_name": "Metric query",
          "examples": [
            {
              "label": "Errors per app, last 15 minutes",
              "value": "sum by (app) (count_over_time({env=\"production\"} |= \"error\" [15m]))"
            },
            {
              "label": "Lines per second",
              "value": "sum(rate({app=\"checkout\"} [5m]))"
            }
          ],
          "multiline": true,
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The moment to evaluate it at. Leave empty for now.",
          "display_name": "At",
          "name": "at_time",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/grafana-loki/run-metric-query",
      "result_str_template": "Query returned {grafana_loki_run_metric_query,count} result(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many results there are",
            "type": "number"
          },
          "query": {
            "description": "The LogQL query that ran",
            "type": "string"
          },
          "results": {
            "description": "Each result with its labels and value",
            "items": {
              "description": "One result",
              "properties": {
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "The result's labels",
                  "type": "object"
                },
                "raw_value": {
                  "description": "The value exactly as Loki gave it",
                  "type": "string"
                },
                "value": {
                  "description": "The value as a number; empty for NaN or infinity",
                  "nullable": true,
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "time": {
            "description": "The moment it was evaluated at, in UTC (ISO 8601)",
            "type": "string"
          },
          "truncated": {
            "description": "True when there were more than 1,000 results",
            "type": "boolean"
          },
          "value": {
            "description": "The first result's value; empty when there are none",
            "nullable": true,
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "search_logs": {
