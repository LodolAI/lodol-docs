{
  "actions": {
    "count_logs": {
      "description": "Count the log lines that match in the last few minutes or hours, such as errors from checkout in the last 15 minutes, in all or for each value of a label, to compare with a threshold.",
      "display_name": "Count log lines",
      "display_str_template": "Count Loki log lines.",
      "handler": "actions.count_logs",
      "id": "grafana_loki_count_logs",
      "method": "POST",
      "mock_response": {
        "count": 151,
        "groups": [
          {
            "count": 97,
            "group": "info",
            "labels": {
              "level": "info"
            }
          },
          {
            "count": 54,
            "group": "error",
            "labels": {
              "level": "error"
            }
          }
        ],
        "query": "sum by (level)(count_over_time({app=\"checkout\"} [1h]))",
        "time": "2026-11-09T14:30:00Z",
        "window": "1h"
      },
      "name": "count_logs",
      "output_formatter": "actions.format_count",
      "parameters": [
        {
          "description": "Which logs: labels and the value each must have, such as app checkout and env production. Leave empty when you give a LogQL query.",
          "display_name": "Labels",
          "name": "labels",
          "object_key_name": "Label",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Only lines containing this text, ignoring case, such as error or timeout.",
          "display_name": "Line contains",
          "name": "contains",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Leave out lines containing this text, ignoring case, such as healthcheck.",
          "display_name": "Line doesn't contain",
          "name": "excludes",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Instead of labels: a LogQL log query, such as {app=\"checkout\"} |= \"error\" | json. Leave empty to use the labels.",
          "display_name": "LogQL query",
          "multiline": true,
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "1h",
          "description": "How far back to look. Defaults to the last hour. A length of time such as 30m or 2d works too, up to 30 days.",
          "display_name": "Time range",
          "name": "since",
          "options": [
            {
              "label": "Last 5 minutes",
              "value": "5m"
            },
            {
              "label": "Last 15 minutes",
              "value": "15m"
            },
            {
              "label": "Last hour",
              "value": "1h"
            },
            {
              "label": "Last 6 hours",
              "value": "6h"
            },
            {
              "label": "Last 24 hours",
              "value": "24h"
            },
            {
              "label": "Last 7 days",
              "value": "7d"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A label to count separately for each of its values, such as level or app. Leave empty for one total.",
          "display_name": "Count for each",
          "dynamic_source": "labels",
          "dynamic_source_allows_custom": true,
          "name": "group_by",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The moment to count back from. Leave empty for now.",
          "display_name": "At",
          "name": "at_time",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/grafana-loki/count-logs",
      "result_str_template": "{grafana_loki_count_logs,count} matching line(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many lines matched, in all",
            "type": "number"
          },
          "groups": {
            "description": "The count for each value of the label counted by, most first",
            "items": {
              "description": "One group's count",
              "properties": {
                "count": {
                  "description": "How many lines matched in this group",
                  "type": "number"
                },
                "group": {
                  "description": "The value of the label counted by; empty without one",
                  "type": "string"
                },
                "labels": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "The group's labels",
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "query": {
            "description": "The LogQL query that ran",
            "type": "string"
          },
          "time": {
            "description": "The moment counted back from, in UTC (ISO 8601)",
            "type": "string"
          },
          "window": {
            "description": "How far back it counted, such as 1h",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_label_values": {
      "description": "List the values a label takes, such as every app or host sending logs, optionally only on logs with some other labels.",
      "display_name": "List label values",
      "display_str_template": "List the values of Loki label {0}.",
      "handler": "actions.list_label_values",
      "id": "grafana_loki_list_label_values",
      "method": "POST",
      "mock_response": {
        "count": 3,
        "has_more": false,
        "label": "app",
        "label_values": [
          "api",
          "checkout",
          "worker"
        ]
      },
      "name": "list_label_values",
      "output_formatter": "actions.format_label_values",
      "parameters": [
        {
          "description": "The label, such as app or host.",
          "display_name": "Label",
          "dynamic_source": "labels",
          "dynamic_source_allows_custom": true,
          "name": "label",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Other labels the logs must have, such as env production. Leave empty for all logs.",
          "display_name": "Only on logs with",
          "name": "labels",
          "object_key_name": "Label",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "default": "1h",
          "description": "Only values on logs from this far back. Defaults to the last hour.",
          "display_name": "Seen in the last",
          "name": "since",
          "options": [
            {
              "label": "Last 5 minutes",
              "value": "5m"
            },
            {
              "label": "Last 15 minutes",
              "value": "15m"
            },
            {
              "label": "Last hour",
              "value": "1h"
            },
            {
              "label": "Last 6 hours",
              "value": "6h"
            },
            {
              "label": "Last 24 hours",
              "value": "24h"
            },
            {
              "label": "Last 7 days",
              "value": "7d"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most values to return. Defaults to 1000.",
          "display_name": "Limit",
          "maximum": 5000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/grafana-loki/list-label-values",
      "result_str_template": "{grafana_loki_list_label_values,count} value(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many values were returned",
            "type": "number"
          },
          "has_more": {
            "description": "True when it has more values than the limit",
            "type": "boolean"
          },
          "label": {
            "description": "The label",
            "type": "string"
          },
          "label_values": {
            "description": "Its values, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
