{
  "actions": {
    "create_template": {
      "description": "Save HTML as an email template in Acumbamail, ready to build campaigns from. Fill Template to update to overwrite an existing template instead.",
      "display_name": "Create template",
      "display_str_template": "Create an Acumbamail email template.",
      "handler": "actions.create_template",
      "id": "acumbamail_create_template",
      "method": "POST",
      "mock_response": {
        "category": null,
        "subject": "News from Acme",
        "template_id": 3311,
        "template_name": "Monthly newsletter",
        "updated": false
      },
      "name": "create_template",
      "parameters": [
        {
          "description": "Name the template is listed under.",
          "display_name": "Template name",
          "examples": [
            {
              "label": "Name",
              "value": "Monthly newsletter"
            }
          ],
          "name": "template_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The template's HTML.",
          "display_name": "HTML content",
          "examples": [
            {
              "label": "Minimal",
              "value": "<p>Hello from Acme!</p>"
            }
          ],
          "multiline": true,
          "name": "html_content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Subject line a campaign built from it starts with.",
          "display_name": "Subject",
          "examples": [
            {
              "label": "Subject",
              "value": "News from Acme"
            }
          ],
          "name": "subject",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Category to file the template under.",
          "display_name": "Category",
          "examples": [
            {
              "label": "Category",
              "value": "Newsletters"
            }
          ],
          "name": "category",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Leave empty to create a new template. Enter an existing template's id to overwrite it instead.",
          "display_name": "Template to update",
          "name": "template_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/acumbamail/create-template",
      "result_str_template": "Template saved.",
      "returns": {
        "properties": {
          "category": {
            "description": "Category, if one was given",
            "type": "string"
          },
          "subject": {
            "description": "Subject, if one was given",
            "type": "string"
          },
          "template_id": {
            "description": "Id of the template",
            "type": "number"
          },
          "template_name": {
            "description": "Template name",
            "type": "string"
          },
          "updated": {
            "description": "True when an existing template was overwritten",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "get_forms": {
      "description": "List the sign-up forms that add subscribers to a mailing list.",
      "display_name": "Get forms",
      "display_str_template": "Get an Acumbamail list's sign-up forms.",
      "handler": "actions.get_forms",
      "id": "acumbamail_get_forms",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "forms": [
          {
            "id": 77,
            "name": "Footer sign-up"
          }
        ],
        "list_id": 123456
      },
      "name": "get_forms",
      "parameters": [
        {
          "description": "The mailing list. Pick one, or type its id or paste its link from Acumbamail.",
          "display_name": "List",
          "dynamic_source": "lists",
          "dynamic_source_allows_custom": true,
          "examples": [
            {
              "label": "List id",
              "value": "123456"
            }
          ],
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/acumbamail/get-forms",
      "result_str_template": "Forms retrieved.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many forms the list has",
            "type": "number"
          },
          "forms": {
            "description": "The list's sign-up forms",
            "items": {
              "properties": {
                "id": {
                  "description": "Form id",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "list_id": {
            "description": "List id",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
