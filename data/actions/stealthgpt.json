{
  "actions": {
    "humanize_content": {
      "description": "Rewrite AI-generated text so it reads as natural, human-written content that is less likely to be flagged by AI detectors.",
      "display_name": "Humanize content",
      "display_str_template": "Humanize content with StealthGPT.",
      "handler": "actions.humanize_content",
      "id": "stealthgpt_humanize_content",
      "method": "POST",
      "mock_response": {
        "ai_detection_score": 8,
        "humanized_text": "Solar and wind power matter more every year. They cut the carbon we put into the air and keep clean electricity flowing for the people who come after us.",
        "remaining_credits": 984740,
        "words_spent": 260
      },
      "name": "humanize_content",
      "output_formatter": "actions.format_humanize_output",
      "parameters": [
        {
          "description": "The text to humanize (up to 3,000 words).",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The reading level of the rewritten text. Defaults to Standard.",
          "display_name": "Reading level",
          "name": "tone",
          "options": [
            {
              "label": "Standard",
              "value": "Standard"
            },
            {
              "label": "High school",
              "value": "HighSchool"
            },
            {
              "label": "College",
              "value": "College"
            },
            {
              "label": "PhD",
              "value": "PhD"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Whether to favour higher quality or a faster response. Defaults to higher quality.",
          "display_name": "Quality",
          "name": "quality_mode",
          "options": [
            {
              "label": "Higher quality",
              "value": "quality"
            },
            {
              "label": "Faster",
              "value": "fast"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The format of the returned text. Defaults to plain text.",
          "display_name": "Output format",
          "name": "output_format",
          "options": [
            {
              "label": "Plain text",
              "value": "text"
            },
            {
              "label": "Markdown",
              "value": "markdown"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/stealthgpt/humanize-content",
      "result_str_template": "Content humanized.",
      "returns": {
        "properties": {
          "ai_detection_score": {
            "description": "How likely the rewritten text is to be flagged as AI, from 0 to 100. Lower is more human.",
            "type": "number"
          },
          "humanized_text": {
            "description": "The rewritten, human-sounding text.",
            "type": "string"
          },
          "remaining_credits": {
            "description": "Words remaining on your account.",
            "type": "number"
          },
          "words_spent": {
            "description": "How many words this request used.",
            "type": "number"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Rewrite AI-generated text into natural, human-sounding content with StealthGPT.",
  "display_name": "StealthGPT",
  "id": "stealthgpt"
}
