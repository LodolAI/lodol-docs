{
  "actions": {
    "check_lyrics_available": {
      "description": "Answer whether LRCLIB holds lyrics for a track, and of which kind (synchronised, plain, or instrumental) without failing the step when it holds none. Use it to decide what a workflow does next; use \"Get lyrics for a track\" once you know.",
      "display_name": "Check whether a track has lyrics",
      "display_str_template": "Check LRCLIB for lyrics for {0} by {1}.",
      "handler": "actions.check_lyrics_available",
      "id": "lrclib_check_lyrics_available",
      "method": "POST",
      "mock_response": {
        "album_name": "Baldur's Gate 3 (Original Game Soundtrack)",
        "artist_name": "Borislav Slavov",
        "available": true,
        "duration": 233,
        "duration_label": "3:53",
        "has_plain_lyrics": true,
        "has_synced_lyrics": true,
        "instrumental": false,
        "reason": null,
        "track_id": 3396226,
        "track_name": "I Want to Live"
      },
      "name": "check_lyrics_available",
      "output_formatter": "actions.format_availability_output",
      "parameters": [
        {
          "description": "Title of the track.",
          "display_name": "Track title",
          "examples": [
            {
              "label": "Track title",
              "value": "I Want to Live"
            }
          ],
          "name": "track_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the artist.",
          "display_name": "Artist name",
          "examples": [
            {
              "label": "Artist",
              "value": "Borislav Slavov"
            }
          ],
          "name": "artist_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the album. Optional, but LRCLIB recommends it: it tells two releases of the same song apart.",
          "display_name": "Album name",
          "examples": [
            {
              "label": "Album",
              "value": "Baldur's Gate 3 (Original Game Soundtrack)"
            }
          ],
          "name": "album_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Track length in seconds (1 to 3600). Optional, but the single biggest improvement to the match: LRCLIB answers only when the length is within 2 seconds of its own record. A mm:ss value such as 3:53 is also accepted.",
          "display_name": "Duration (seconds)",
          "examples": [
            {
              "label": "3:53 in seconds",
              "value": "233"
            }
          ],
          "maximum": 3600,
          "minimum": 1,
          "name": "duration",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/lrclib/check-lyrics-available",
      "result_str_template": "LRCLIB availability checked.",
      "returns": {
        "properties": {
          "album_name": {
            "type": "string"
          },
          "artist_name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "duration": {
            "type": "number"
          },
          "duration_label": {
            "type": "string"
          },
          "has_plain_lyrics": {
            "type": "boolean"
          },
          "has_synced_lyrics": {
            "type": "boolean"
          },
          "instrumental": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "track_id": {
            "type": "number"
          },
          "track_name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "flag_lyrics": {
      "description": "Report a track's current lyrics to LRCLIB for review: wrong words, wrong track metadata, or a copyright violation. Like publishing, this earns LRCLIB's single-use token by solving its proof-of-work challenge, which takes a few seconds of CPU.",
      "display_name": "Flag lyrics",
      "display_str_template": "Flag LRCLIB track {0}.",
      "handler": "actions.flag_lyrics",
      "id": "lrclib_flag_lyrics",
      "method": "POST",
      "mock_response": {
        "challenge_attempts": 16951204,
        "content": "The lyrics don't match the audio",
        "flagged": true,
        "track_id": 3396226
      },
      "name": "flag_lyrics",
      "output_formatter": "actions.format_flag_output",
      "parameters": [
        {
          "description": "LRCLIB's numeric track ID for the record to flag.",
          "display_name": "Track ID",
          "examples": [
            {
              "label": "Track ID",
              "value": "3396226"
            }
          ],
          "minimum": 1,
          "name": "track_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Why the record is being flagged. Optional, but it is what a reviewer reads.",
          "display_name": "Reason",
          "examples": [
            {
              "label": "Reason",
              "value": "The lyrics don't match the audio"
            }
          ],
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lrclib/flag-lyrics",
      "result_str_template": "LRCLIB track flagged for review.",
      "returns": {
        "properties": {
          "challenge_attempts": {
            "type": "number"
          },
          "content": {
            "type": "string"
          },
          "flagged": {
            "type": "boolean"
          },
          "track_id": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "get_lyrics": {
