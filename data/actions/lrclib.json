          "name": "artist_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the album. Optional, but LRCLIB recommends it: it tells two releases of the same song apart.",
          "display_name": "Album name",
          "examples": [
            {
              "label": "Album",
              "value": "Baldur's Gate 3 (Original Game Soundtrack)"
            }
          ],
          "name": "album_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Track length in seconds (1 to 3600). Optional, but the single biggest improvement to the match: LRCLIB answers only when the length is within 2 seconds of its own record. A mm:ss value such as 3:53 is also accepted.",
          "display_name": "Duration (seconds)",
          "examples": [
