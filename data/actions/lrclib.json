    "get_lyrics_for_tracks": {
      "description": "Look up a list of tracks in one step: a playlist, an album, or a slice of a music library. Each track can be a title and an artist, or just a line of text naming it. Requests go one at a time with the pause LRCLIB asks batch clients for, a track it has nothing for is reported against that track instead of failing the step, and hitting the rate limit stops the run and names the tracks it never reached. Up to 25 tracks per step.",
      "display_name": "Get lyrics for several tracks",
      "display_str_template": "Get LRCLIB lyrics for a list of tracks.",
      "handler": "actions.get_lyrics_for_tracks",
      "id": "lrclib_get_lyrics_for_tracks",
      "method": "POST",
      "mock_response": {
        "found_count": 1,
        "missing_count": 0,
        "not_attempted": [],
        "output_detail": "full",
        "result_count": 1,
        "results": [
          {
            "found": true,
            "matched_by": "signature",
            "reason": null,
            "record": {
              "album_name": "Baldur's Gate 3 (Original Game Soundtrack)",
              "artist_name": "Borislav Slavov",
              "duration": 233,
              "duration_label": "3:53",
