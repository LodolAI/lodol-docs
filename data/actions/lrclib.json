      "name": "get_lyrics_for_tracks",
      "output_formatter": "actions.format_batch_output",
      "parameters": [
        {
          "description": "The tracks to look up. Give each one a track title and an artist name and LRCLIB matches that exact recording; an album name and a duration in seconds sharpen it further. A track named more loosely, or a plain list of tracks written one per line, is looked up through LRCLIB's search instead.",
          "display_name": "Tracks",
          "name": "tracks",
          "required": true,
          "schema": {
            "properties": {
              "album_name": {
                "description": "Name of the album. Optional, but sharpens the match.",
                "type": "string"
              },
              "artist_name": {
                "description": "Name of the artist. Strongly recommended: with it LRCLIB matches the exact recording, without it the track is searched for.",
                "type": "string"
              },
              "duration": {
                "description": "Track length in seconds, or as mm:ss. Optional, but LRCLIB matches far more precisely with it.",
                "type": "string"
              },
              "track_name": {
                "description": "Title of the track. Required.",
                "type": "string"
              }
            },
            "required": [
              "track_name"
            ],
            "type": "object"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "default": true,
          "description": "Return each match's plain, synchronised and Lyricsfile bodies. On by default; turn it off to get back only which tracks have lyrics and of what kind.",
          "display_name": "Include the lyrics",
          "name": "include_lyrics",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": "full",
          "description": "How much to print into the run output for a person to read. 'The lyrics in full' prints every line; 'A summary line and the opening' prints the first few. This only changes what is displayed, never what is saved: a later step reads the same record either way. Defaults to the lyrics in full. A long playlist makes that a lot to scroll through, so turn it down to the opening lines when what matters is which tracks were found.",
          "display_name": "Show in the run",
          "name": "output_detail",
          "options": [
            {
              "label": "The lyrics in full",
              "value": "full"
            },
            {
              "label": "A summary line and the opening",
              "value": "summary"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
