{
  "actions": {
    "add_comment": {
      "description": "Post a comment on a Sentry issue.",
      "display_name": "Add comment",
      "display_str_template": "Add a comment to Sentry issue '{0}'.",
      "handler": "actions.add_comment",
      "id": "sentry_add_comment",
      "method": "POST",
      "mock_response": {
        "comment": {
          "id": "9876543210",
          "text": "Investigating."
        }
      },
      "name": "add_comment",
      "parameters": [
        {
          "description": "ID of the issue to comment on.",
          "display_name": "Issue ID",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Text of the comment to post.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sentry/add-comment",
      "result_str_template": "Sentry comment added.",
      "returns": {
        "properties": {
          "comment": {
            "description": "Comment details",
            "properties": {
              "id": {
                "description": "Comment ID",
                "type": "string"
              },
              "text": {
                "description": "Comment text that was posted",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_issue": {
      "description": "Look up a Sentry issue's details by its ID.",
      "display_name": "Get issue",
      "display_str_template": "Get Sentry issue '{0}'.",
      "handler": "actions.get_issue",
      "id": "sentry_get_issue",
      "method": "POST",
      "mock_response": {
        "issue": {
          "count": "42",
          "culprit": "app.js in handleClick",
          "id": "1234567890",
          "last_seen": "2026-01-01T00:00:00Z",
          "level": "error",
          "permalink": "https://sentry.io/organizations/example/issues/1234567890/",
          "status": "unresolved",
          "title": "TypeError: Cannot read property 'x' of undefined"
        }
      },
      "name": "get_issue",
      "parameters": [
        {
          "description": "ID of the issue to look up.",
          "display_name": "Issue ID",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sentry/get-issue",
      "result_str_template": "Retrieved Sentry issue.",
      "returns": {
        "properties": {
          "issue": {
            "description": "Issue details",
            "properties": {
              "count": {
                "description": "Total number of events for this issue",
                "type": "string"
              },
              "culprit": {
                "description": "The function or location where the issue occurred",
                "type": "string"
              },
              "id": {
                "description": "Issue ID. Use with get_issue, resolve_issue, and add_comment.",
                "type": "string"
              },
              "last_seen": {
                "description": "Timestamp the issue was last seen",
                "type": "string"
              },
              "level": {
                "description": "Severity level, for example 'error' or 'warning'",
                "type": "string"
              },
              "permalink": {
                "description": "URL to view the issue in Sentry",
                "type": "string"
              },
              "status": {
                "description": "Issue status, for example 'unresolved' or 'resolved'",
                "type": "string"
              },
              "title": {
                "description": "Issue title",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_issues": {
      "description": "List issues in a Sentry project, optionally filtered by a search query.",
      "display_name": "List issues",
      "display_str_template": "List Sentry issues in project '{0}'.",
      "handler": "actions.list_issues",
      "id": "sentry_list_issues",
      "method": "POST",
      "mock_response": {
        "issues": [
          {
            "culprit": "app.js in handleClick",
            "id": "1234567890",
            "level": "error",
            "permalink": "https://sentry.io/organizations/example/issues/1234567890/",
            "status": "unresolved",
            "title": "TypeError: Cannot read property 'x' of undefined"
          }
        ]
      },
      "name": "list_issues",
      "parameters": [
        {
          "description": "Slug of the project to list issues from, for example 'backend'.",
          "display_name": "Project slug",
          "name": "project_slug",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "is:unresolved",
          "description": "Sentry search query, for example 'is:unresolved'.",
          "display_name": "Query",
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of issues to return, from 1 to 100 (default 25).",
          "display_name": "Max results",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/sentry/list-issues",
      "result_str_template": "Fetched Sentry issues.",
      "returns": {
        "properties": {
          "issues": {
            "description": "List of issues matching the query",
            "items": {
              "properties": {
                "culprit": {
                  "description": "The function or location where the issue occurred",
                  "type": "string"
                },
                "id": {
                  "description": "Issue ID. Use with get_issue, resolve_issue, and add_comment.",
                  "type": "string"
                },
                "level": {
                  "description": "Severity level, for example 'error' or 'warning'",
                  "type": "string"
                },
                "permalink": {
                  "description": "URL to view the issue in Sentry",
                  "type": "string"
                },
                "status": {
                  "description": "Issue status, for example 'unresolved' or 'resolved'",
                  "type": "string"
                },
                "title": {
                  "description": "Issue title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_projects": {
      "description": "List the projects in your Sentry organization.",
      "display_name": "List projects",
      "display_str_template": "List Sentry projects.",
      "handler": "actions.list_projects",
      "id": "sentry_list_projects",
      "method": "POST",
      "mock_response": {
        "projects": [
          {
            "id": "1",
            "name": "Backend",
            "slug": "backend"
          }
        ]
      },
      "name": "list_projects",
      "parameters": [],
      "path": "/actions/library/sentry/list-projects",
      "result_str_template": "Fetched Sentry projects.",
      "returns": {
        "properties": {
          "projects": {
            "description": "List of projects in the organization",
            "items": {
              "properties": {
                "id": {
                  "description": "Project ID",
                  "type": "string"
                },
                "name": {
                  "description": "Project display name",
                  "type": "string"
                },
                "slug": {
                  "description": "Project slug. Use with list_issues.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "resolve_issue": {
      "description": "Mark a Sentry issue as resolved.",
      "display_name": "Resolve issue",
      "display_str_template": "Resolve Sentry issue '{0}'.",
      "handler": "actions.resolve_issue",
      "id": "sentry_resolve_issue",
      "method": "POST",
      "mock_response": {
        "id": "1234567890",
        "status": "resolved"
      },
      "name": "resolve_issue",
      "parameters": [
        {
          "description": "ID of the issue to resolve.",
          "display_name": "Issue ID",
          "name": "issue_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/sentry/resolve-issue",
      "result_str_template": "Resolved Sentry issue.",
      "returns": {
        "properties": {
          "id": {
            "description": "ID of the resolved issue",
            "type": "string"
          },
          "status": {
            "description": "Issue status after resolving (always 'resolved')",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your Sentry account to browse projects and list, look up, resolve, and comment on issues.",
  "display_name": "Sentry",
  "id": "sentry"
}
