{
  "actions": {
    "get_price": {
      "description": "Get a vehicle's average price in this month's FIPE table, from its brand, model and model year (names or FIPE codes), with its FIPE code. No API key required.",
      "display_name": "Get price",
      "display_str_template": "Get the FIPE price of model {1} ({2}).",
      "handler": "actions.get_price",
      "id": "fipe_get_price",
      "method": "POST",
      "mock_response": {
        "brand": "Fiat",
        "brand_code": "21",
        "fipe_code": "001267-0",
        "fuel": "Flex",
        "model": "Palio 1.0 ECONOMY Fire Flex 8V 4p",
        "model_code": "4828",
        "model_year": 2014,
        "price": 32125.0,
        "price_text": "R$ 32.125,00",
        "reference_month": "outubro de 2026",
        "vehicle_type": "cars",
        "year_code": "2014-5",
        "zero_km": false
      },
      "name": "get_price",
      "parameters": [
        {
          "description": "The brand's name or FIPE code, e.g. Fiat or 21.",
          "display_name": "Brand",
          "examples": [
            {
              "label": "Fiat",
              "value": "Fiat"
            },
            {
              "label": "Fiat, by code",
              "value": "21"
            },
            {
              "label": "Volkswagen, by code",
              "value": "59"
            }
          ],
          "name": "brand",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The model's full name or FIPE code, from List models, e.g. 'Palio 1.0 ECONOMY Fire Flex 8V 4p' or 4828.",
          "display_name": "Model",
          "examples": [
            {
              "label": "Fiat Palio, by code",
              "value": "4828"
            },
            {
              "label": "Fiat Palio, by name",
              "value": "Palio 1.0 ECONOMY Fire Flex 8V 4p"
            }
          ],
          "name": "model",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The model year, e.g. 2014, or a year code from List model years, e.g. 2014-5. Use 32000 (or 'zero km') for a brand-new vehicle.",
          "display_name": "Year",
          "examples": [
            {
              "label": "2014",
              "value": "2014"
            },
            {
              "label": "2014, flex fuel",
              "value": "2014-5"
            }
          ],
          "name": "year",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "cars",
          "description": "Cars, motorcycles, or trucks and buses. Cars by default.",
          "display_name": "Vehicle type",
          "name": "vehicle_type",
          "options": [
            {
              "label": "Cars",
              "value": "cars"
            },
            {
              "label": "Motorcycles",
              "value": "motorcycles"
            },
            {
              "label": "Trucks and buses",
              "value": "trucks"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/fipe/get-price",
      "result_str_template": "{fipe_get_price,model} is worth {fipe_get_price,price_text}.",
      "returns": {
        "properties": {
          "brand": {
            "description": "The brand, e.g. 'Fiat'.",
            "type": [
              "string",
              "null"
            ]
          },
          "brand_code": {
            "description": "The brand's FIPE code, e.g. '21' for Fiat.",
            "type": "string"
          },
          "fipe_code": {
            "description": "The vehicle's FIPE code, e.g. '001267-0'.",
            "type": [
              "string",
              "null"
            ]
          },
          "fuel": {
            "description": "The fuel, e.g. 'Flex' or 'Diesel'.",
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "description": "The model, e.g. 'Palio 1.0 ECONOMY Fire Flex 8V 4p'.",
            "type": [
              "string",
              "null"
            ]
          },
          "model_code": {
            "description": "The model's FIPE code, e.g. '4828'.",
            "type": "string"
          },
          "model_year": {
            "description": "The model year, e.g. 2014. Empty for a zero-km vehicle.",
            "type": [
              "integer",
              "null"
            ]
          },
          "price": {
            "description": "The average price in Brazilian reais, e.g. 32125.0.",
            "type": [
              "number",
              "null"
            ]
          },
          "price_text": {
            "description": "The price as FIPE writes it, e.g. 'R$ 32.125,00'.",
            "type": [
              "string",
              "null"
            ]
          },
          "reference_month": {
            "description": "The month the price is for, in Portuguese, e.g. 'outubro de 2026'.",
            "type": [
              "string",
              "null"
            ]
          },
          "vehicle_type": {
            "description": "'cars', 'motorcycles' or 'trucks'.",
            "type": "string"
          },
          "year_code": {
            "description": "The year code that was priced, e.g. '2014-5'.",
            "type": "string"
          },
          "zero_km": {
            "description": "True when this is the price of a brand-new vehicle.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
