{
  "actions": {
    "curated_photos": {
      "description": "List the photos Pexels' editors are currently featuring on the home page, newest first.",
      "display_name": "List curated photos",
      "display_str_template": "List curated Pexels photos.",
      "handler": "actions.curated_photos",
      "id": "pexels_curated_photos",
      "method": "POST",
      "mock_response": {
        "page": 1,
        "per_page": 15,
        "photos": [
          {
            "alt": "Brown Rocks During Golden Hour",
            "avg_color": "#978E82",
            "height": 3024,
            "large_url": "https://images.pexels.com/photos/2014422/pexels-photo-2014422.jpeg?w=940",
            "medium_url": "https://images.pexels.com/photos/2014422/pexels-photo-2014422.jpeg?h=350",
            "original_url": "https://images.pexels.com/photos/2014422/pexels-photo-2014422.jpeg",
            "photo_id": 2014422,
            "photographer": "Joey Farina",
            "photographer_url": "https://www.pexels.com/@joey",
            "tiny_url": "https://images.pexels.com/photos/2014422/pexels-photo-2014422.jpeg?h=200",
            "url": "https://www.pexels.com/photo/brown-rocks-during-golden-hour-2014422/",
            "width": 3024
          }
        ],
        "total_results": 8000
      },
      "name": "curated_photos",
      "parameters": [
        {
          "default": 1,
          "description": "Which page of results to return. Defaults to the first page.",
          "display_name": "Page",
          "minimum": 1,
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 15,
          "description": "How many results to return (1-80).",
          "display_name": "Results per page",
          "maximum": 80,
          "minimum": 1,
          "name": "per_page",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/pexels/curated-photos",
      "result_str_template": "Curated Pexels photos retrieved.",
      "returns": {
        "properties": {
          "page": {
            "description": "The page of results this is",
            "type": "number"
          },
          "per_page": {
            "description": "How many results this page holds",
            "type": "number"
          },
          "photos": {
            "description": "The curated photos",
            "items": {
              "properties": {
                "alt": {
                  "description": "A short description of the photo, usable as alt text",
                  "type": "string"
                },
                "avg_color": {
                  "description": "The photo's average colour as a hex code, handy as a placeholder background while the image loads",
                  "type": "string"
                },
                "height": {
                  "description": "Height of the original photo in pixels",
                  "type": "number"
                },
                "large_url": {
                  "description": "Direct link to a large (roughly 940px wide) version",
                  "type": "string"
                },
                "medium_url": {
                  "description": "Direct link to a medium (roughly 350px tall) version",
                  "type": "string"
                },
                "original_url": {
                  "description": "Direct link to the full-resolution image file",
                  "type": "string"
                },
                "photo_id": {
                  "description": "The photo's Pexels ID. Use with Get a photo.",
                  "type": "number"
                },
                "photographer": {
                  "description": "Name of the photographer, for the attribution Pexels asks for",
                  "type": "string"
                },
                "photographer_url": {
                  "description": "Link to the photographer's Pexels profile",
                  "type": "string"
                },
                "tiny_url": {
                  "description": "Direct link to a thumbnail-sized version",
                  "type": "string"
                },
                "url": {
                  "description": "Link to the photo's page on Pexels",
                  "type": "string"
                },
                "width": {
                  "description": "Width of the original photo in pixels",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total_results": {
            "description": "How many results match in total",
            "type": "number"
          }
        },
        "type": "object"
      }
