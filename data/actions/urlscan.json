    "get_scan_dom": {
      "description": "Get the page's HTML as it stood after the scan's browser ran its scripts. Long pages are cut at the maximum you set.",
      "display_name": "Get scan DOM",
      "display_str_template": "Get the DOM of the urlscan.io scan '{0}'.",
      "handler": "actions.get_scan_dom",
      "id": "urlscan_get_scan_dom",
      "method": "POST",
      "mock_response": {
        "dom": "<head><title>Example Domain</title></head><body>...</body>",
        "length": 1951,
        "scan_id": "0199a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b",
        "truncated": false
      },
      "name": "get_scan_dom",
      "output_formatter": "actions.format_get_scan_dom_output",
      "parameters": [
        {
          "description": "The scan's id, from Scan URL or Search scans. A urlscan.io report address is accepted too.",
          "display_name": "Scan ID",
          "examples": [
            {
              "label": "Scan ID",
              "value": "0199a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b"
            }
          ],
          "name": "scan_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 200000,
          "description": "Cut the DOM after this many characters.",
          "display_name": "Maximum characters",
          "maximum": 2000000,
          "minimum": 1,
          "name": "max_characters",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/urlscan/get-scan-dom",
      "result_str_template": "DOM retrieved.",
      "returns": {
        "properties": {
          "dom": {
            "description": "The page's DOM",
            "type": "string"
          },
          "length": {
            "description": "The DOM's full length in characters",
            "type": "number"
          },
          "scan_id": {
            "description": "The scan's id",
            "type": "string"
          },
          "truncated": {
            "description": "True when the DOM was cut at the maximum",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
