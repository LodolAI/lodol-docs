  "triggers": {
    "onestream_new_adapter_row_trigger": {
      "description": "Runs for each new row a OneStream dashboard data adapter returns.",
      "display_name": "New data adapter row",
      "id": "onestream_new_adapter_row_trigger",
      "output": {
        "id": "Unique event identifier",
        "row": "The record returned by the service"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The OneStream application that holds the data adapter.",
          "display_name": "Application",
          "name": "application",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "The name of the dashboard data adapter to watch.",
          "display_name": "Data adapter",
          "name": "adapter_name",
          "required": true
        },
        {
          "arg_index": 2,
          "description": "A column whose value is unique for each row, such as an ID. Leave empty to compare whole rows, so a row whose values change counts as new.",
          "display_name": "Key column",
          "name": "key_column",
          "required": false
        },
        {
          "arg_index": 3,
          "description": "Turn on when the data adapter is defined at the system level rather than in the application.",
