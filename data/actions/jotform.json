{
  "actions": {
    "add_submission": {
      "description": "Add an answer to a form, as if someone had filled it out. Forms made with \"Create a form\" have one question whose question ID is 1, so the default settings just work.",
      "display_name": "Add a submission",
      "display_str_template": "Add a submission to Jotform form {0}.",
      "handler": "actions.add_submission",
      "id": "jotform_add_submission",
      "method": "POST",
      "mock_response": {
        "submission_id": "5305509131446525148",
        "submission_url": "https://api.jotform.com/submission/5305509131446525148"
      },
      "name": "add_submission",
      "parameters": [
        {
          "description": "The form's ID, the number at the end of its link, for example 30693660548966. Pasting the full form link works too.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The answer to record for the question, for example \"Jane Doe\".",
          "display_name": "Answer",
          "name": "answer",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Which question the answer is for. Forms made with \"Create a form\" have a single question with ID 1, which is also the default.",
          "display_name": "Question ID",
          "name": "question_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/jotform/add-submission",
      "result_str_template": "Submission ID: {jotform_add_submission,submission_id}",
      "returns": {
        "properties": {
          "submission_id": {
            "type": "string"
          },
          "submission_url": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_form": {
      "description": "Create a new Jotform form with a title and one short-answer question. The new form's ID and public link are returned so later steps can open it, add answers, and read them back.",
      "display_name": "Create a form",
      "display_str_template": "Create a Jotform form titled {0}.",
      "handler": "actions.create_form",
      "id": "jotform_create_form",
      "method": "POST",
      "mock_response": {
        "form_id": "30693660548966",
        "title": "Customer feedback",
        "url": "https://form.jotform.com/30693660548966"
      },
      "name": "create_form",
      "parameters": [
        {
          "description": "The title shown at the top of the form, for example \"Customer feedback\".",
          "display_name": "Form title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The question the form asks, as a single short-answer field, for example \"What is your name?\".",
          "display_name": "Question",
          "name": "question_text",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/jotform/create-form",
      "result_str_template": "Form link: {jotform_create_form,url}",
      "returns": {
        "properties": {
          "form_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_form": {
      "description": "Delete a form. Jotform marks it DELETED and moves it to the Trash section of your My Forms page.",
      "display_name": "Delete a form",
      "display_str_template": "Delete Jotform form {0}.",
      "handler": "actions.delete_form",
      "id": "jotform_delete_form",
      "method": "POST",
      "mock_response": {
        "form_id": "30693660548966",
        "form_status": "DELETED"
      },
      "name": "delete_form",
      "parameters": [
        {
          "description": "The ID of the form to delete, the number at the end of its link, for example 30693660548966. Pasting the full form link works too.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/jotform/delete-form",
      "result_str_template": "Form status: {jotform_delete_form,form_status}",
      "returns": {
        "properties": {
          "form_id": {
            "type": "string"
          },
          "form_status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_form": {
      "description": "Look up a form's title, status (enabled, disabled, or deleted), public link, and creation date.",
      "display_name": "Get form details",
      "display_str_template": "Get details of Jotform form {0}.",
      "handler": "actions.get_form",
      "id": "jotform_get_form",
      "method": "POST",
      "mock_response": {
        "created_at": "2026-07-22 09:00:00",
        "form_id": "30693660548966",
        "form_status": "ENABLED",
        "title": "Customer feedback",
        "url": "https://form.jotform.com/30693660548966"
      },
      "name": "get_form",
      "parameters": [
        {
          "description": "The form's ID, the number at the end of its link, for example 30693660548966. Pasting the full form link works too.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/jotform/get-form",
      "result_str_template": "Form title: {jotform_get_form,title}",
      "returns": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "form_id": {
            "type": "string"
          },
          "form_status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_submissions": {
      "description": "List the answers people have submitted to a form. Each submission includes when it was sent and its answers, keyed by question ID.",
      "display_name": "List form submissions",
      "display_str_template": "List submissions of Jotform form {0}.",
      "handler": "actions.list_submissions",
      "id": "jotform_list_submissions",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "submissions": [
          {
            "answers": {
              "1": {
                "answer": "Jane Doe",
                "text": "What is your name?",
                "type": "control_textbox"
              }
            },
            "created_at": "2026-07-22 09:05:00",
            "submission_id": "5305509131446525148"
          }
        ]
      },
      "name": "list_submissions",
      "parameters": [
        {
          "description": "The form's ID, the number at the end of its link, for example 30693660548966. Pasting the full form link works too.",
          "display_name": "Form ID",
          "name": "form_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. How many submissions to return, up to 1000. Leave empty for Jotform's default of 20.",
          "display_name": "Limit",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/jotform/list-submissions",
      "result_str_template": "Submissions returned: {jotform_list_submissions,count}",
      "returns": {
        "properties": {
          "count": {
            "type": "integer"
          },
          "submissions": {
            "items": {
              "properties": {
                "answers": {
                  "type": "object"
                },
                "created_at": {
                  "type": "string"
                },
                "submission_id": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create Jotform forms, record and read the answers people submit, and delete forms you no longer need.",
  "display_name": "Jotform",
  "id": "jotform"
}
