  "triggers": {
    "churnkey_new_session_trigger": {
      "description": "Runs for each new cancellation session in Churnkey. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New cancellation session",
      "id": "churnkey_new_session_trigger",
      "output": {
        "record": "object with the fields id, customerId, canceled, aborted, offerType, _id"
      },
      "parameters": []
    },
    "churnkey_session_abandoned_trigger": {
      "description": "Runs for each cancellation session abandoned in Churnkey. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Cancellation session abandoned",
      "id": "churnkey_session_abandoned_trigger",
      "output": {
        "record": "object with the fields id, customerId, canceled, aborted, offerType, _id"
      },
      "parameters": []
    },
    "churnkey_subscription_canceled_trigger": {
      "description": "Runs each time a subscription is canceled in Churnkey. Ones canceled before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Subscription canceled",
      "id": "churnkey_subscription_canceled_trigger",
      "output": {
        "record": "object with the fields id, customerId, canceled, aborted, offerType, _id"
      },
