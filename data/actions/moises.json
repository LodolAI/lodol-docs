  "triggers": {
    "moises_job_failed_trigger": {
      "description": "Runs each time an audio job is failed in Moises. Ones failed before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Audio job failed",
      "id": "moises_job_failed_trigger",
      "output": {
        "record": "object with the fields id, status"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The job ID from Submit audio job.",
          "display_name": "Job ID",
          "name": "job_id",
          "required": true
        }
      ]
    },
    "moises_job_succeeded_trigger": {
      "description": "Runs for each audio job succeeded in Moises. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Audio job succeeded",
      "id": "moises_job_succeeded_trigger",
      "output": {
        "record": "object with the fields id, status"
      },
      "parameters": [
        {
          "arg_index": 0,
