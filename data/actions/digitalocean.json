{
  "actions": {
    "create_domain": {
      "description": "Add a domain to DigitalOcean's DNS so you can manage its records. DigitalOcean DNS hosting is free.",
      "display_name": "Create domain",
      "display_str_template": "Add domain {0} to DigitalOcean DNS.",
      "handler": "actions.create_domain",
      "id": "digitalocean_create_domain",
      "method": "POST",
      "mock_response": {
        "name": "example.com",
        "ttl": 1800,
        "zone_file": "$ORIGIN example.com.\n"
      },
      "name": "create_domain",
      "parameters": [
        {
          "description": "The domain name to add (for example, example.com)",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "[Optional] An IPv4 address. When provided, an A record for the root domain (@) is created pointing to it.",
          "display_name": "IP address",
          "name": "ip_address",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/digitalocean/create-domain",
      "result_str_template": "Created domain {create_domain,name}.",
      "returns": {
        "properties": {
          "name": {
            "type": "string"
          },
          "ttl": {
            "type": "integer"
          },
          "zone_file": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_domain_record": {
      "description": "Create a new DNS record in a domain managed by DigitalOcean.",
      "display_name": "Create DNS record",
      "display_str_template": "Create {1} record {2} in domain {0}.",
      "handler": "actions.create_domain_record",
      "id": "digitalocean_create_domain_record",
      "method": "POST",
      "mock_response": {
        "data": "192.0.2.10",
        "id": 28448429,
        "name": "www",
        "priority": null,
        "ttl": 1800,
        "type": "A"
      },
      "name": "create_domain_record",
      "parameters": [
        {
          "description": "The domain to add the record to (for example, example.com)",
          "display_name": "Domain name",
          "name": "domain_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The DNS record type (e.g., A, AAAA, CNAME, TXT, MX, NS)",
          "display_name": "Record type",
          "name": "record_type",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The host name for the record (for example, www, or @ for the root domain)",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The value for the record (for example, an IP address for an A record, or a hostname for a CNAME)",
          "display_name": "Data",
          "name": "data",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "[Optional] How long DNS servers cache this record, in seconds (DigitalOcean minimum is 30)",
          "display_name": "Time to live (TTL)",
          "name": "ttl",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "[Optional] Priority for the record, required by MX and SRV records (lower is higher priority)",
          "display_name": "Priority",
          "name": "priority",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/digitalocean/create-domain-record",
      "result_str_template": "Created DNS record {create_domain_record,id}: {create_domain_record,type} {create_domain_record,name}",
      "returns": {
        "properties": {
          "data": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ttl": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_domain": {
      "description": "Delete a domain from DigitalOcean's DNS. This also removes all of the domain's DNS records and cannot be undone.",
      "display_name": "Delete domain",
      "display_str_template": "Delete domain {0} from DigitalOcean DNS.",
      "handler": "actions.delete_domain",
      "id": "digitalocean_delete_domain",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "name": "example.com"
      },
      "name": "delete_domain",
      "parameters": [
        {
          "description": "The domain name to delete (for example, example.com)",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/digitalocean/delete-domain",
      "result_str_template": "Deleted domain {delete_domain,name}.",
      "returns": {
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_domain_records": {
      "description": "List the DNS records for a domain managed by DigitalOcean, with optional filters by record type and name.",
      "display_name": "List DNS records",
      "display_str_template": "List DNS records for domain {0}.",
      "handler": "actions.list_domain_records",
      "id": "digitalocean_list_domain_records",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "records": [
          {
            "data": "192.0.2.10",
            "id": 28448429,
            "name": "www",
            "priority": null,
            "ttl": 1800,
            "type": "A"
          }
        ]
      },
      "name": "list_domain_records",
      "parameters": [
        {
          "description": "The domain to list records for (for example, example.com)",
          "display_name": "Domain name",
          "name": "domain_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "[Optional] Only return records of this type (e.g., A, CNAME, TXT)",
          "display_name": "Record type",
          "name": "record_type",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "[Optional] Only return records with this fully qualified name (e.g., www.example.com)",
          "display_name": "Name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "[Optional] Which page of results to return (default: 1)",
          "display_name": "Page",
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "[Optional] Number of records per page (default: 20)",
          "display_name": "Per page",
          "name": "per_page",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/digitalocean/list-domain-records",
      "result_str_template": "Found {list_domain_records,count} DNS records.",
      "returns": {
        "properties": {
          "count": {
            "type": "integer"
          },
          "records": {
            "items": {
              "properties": {
                "data": {
                  "type": "string"
                },
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "priority": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "ttl": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_droplets": {
      "description": "List the Droplets (virtual machines) in your DigitalOcean account, optionally filtered by tag.",
      "display_name": "List Droplets",
      "display_str_template": "List DigitalOcean Droplets.",
      "handler": "actions.list_droplets",
      "id": "digitalocean_list_droplets",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "droplets": [
          {
            "created_at": "2024-01-15T18:37:44Z",
            "disk": 25,
            "id": 3164444,
            "image": "ubuntu-22-04-x64",
            "memory": 1024,
            "name": "web-01",
            "public_ipv4": "192.0.2.10",
            "region": "nyc3",
            "size": "s-1vcpu-1gb",
            "status": "active",
            "vcpus": 1
          }
        ]
      },
      "name": "list_droplets",
      "parameters": [
        {
          "description": "[Optional] Only return Droplets that have this tag",
          "display_name": "Tag name",
          "name": "tag_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "[Optional] Which page of results to return (default: 1)",
          "display_name": "Page",
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "[Optional] Number of Droplets per page (default: 20)",
          "display_name": "Per page",
          "name": "per_page",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/digitalocean/list-droplets",
      "result_str_template": "Found {list_droplets,count} Droplets.",
      "returns": {
        "properties": {
          "count": {
            "type": "integer"
          },
          "droplets": {
            "items": {
              "properties": {
                "created_at": {
                  "type": "string"
                },
                "disk": {
                  "type": "integer"
                },
                "id": {
                  "type": "integer"
                },
                "image": {
                  "type": "string"
                },
                "memory": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "public_ipv4": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "vcpus": {
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "List your Droplets and manage DigitalOcean DNS: add domains, create records, and clean up when you're done.",
  "display_name": "DigitalOcean",
  "id": "digitalocean"
}
