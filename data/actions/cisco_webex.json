      "handler": "actions.create_meeting",
      "id": "cisco_webex_create_meeting",
      "method": "POST",
      "mock_response": {
        "end": "2026-08-03T15:30:00Z",
        "host_email": "host@example.com",
        "meeting_id": "870f51ff287b41be84648412901e0402",
        "meeting_number": "201593823",
        "password": "BgJep43x",
        "sip_address": "201593823@example.webex.com",
        "start": "2026-08-03T15:00:00Z",
        "timezone": "UTC",
        "title": "Weekly product sync",
        "web_link": "https://example.webex.com/example/j.php?MTID=m1234567890"
      },
      "name": "create_meeting",
      "parameters": [
        {
          "description": "The name of the meeting, shown on the invite.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the meeting starts, as an ISO 8601 timestamp such as 2026-08-03T15:00:00Z.",
          "display_name": "Start time",
          "name": "start",
          "required": true,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "When the meeting ends, as an ISO 8601 timestamp such as 2026-08-03T15:30:00Z.",
          "display_name": "End time",
          "name": "end",
          "required": true,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Optional. Timezone for the start and end times, for example 'America/New_York'.",
          "display_name": "Timezone",
          "name": "timezone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. An agenda or description for the meeting.",
          "display_name": "Agenda",
          "multiline": true,
          "name": "agenda",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Email addresses to invite, as a list or a comma-separated string.",
          "display_name": "Invitee emails",
          "name": "invitees",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/cisco-webex/create-meeting",
      "result_str_template": "Webex meeting scheduled.",
      "returns": {
        "properties": {
          "end": {
            "description": "When the meeting ends",
            "type": "string"
          },
          "host_email": {
            "description": "Email of the meeting host",
            "type": "string"
          },
          "meeting_id": {
            "description": "Webex meeting ID. Use with Cancel a meeting.",
            "type": "string"
          },
          "meeting_number": {
            "description": "The numeric meeting number people dial in with",
            "type": "string"
          },
          "password": {
            "description": "Meeting password, when the site requires one",
            "type": "string"
          },
          "sip_address": {
            "description": "SIP address for joining from a video system",
            "type": "string"
          },
          "start": {
            "description": "When the meeting starts",
            "type": "string"
          },
          "timezone": {
            "description": "Timezone the start and end times are expressed in",
            "type": "string"
          },
          "title": {
            "description": "The meeting's title",
            "type": "string"
          },
          "web_link": {
            "description": "Link attendees use to join the meeting",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_meeting": {
      "description": "Cancel a scheduled Webex meeting.",
      "display_name": "Cancel a meeting",
      "display_str_template": "Cancel Webex meeting '{0}'.",
      "handler": "actions.delete_meeting",
      "id": "cisco_webex_delete_meeting",
      "method": "POST",
      "mock_response": {
        "deleted": true,
