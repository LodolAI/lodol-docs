        "content": "Deploy finished :check:",
        "id": 4312,
        "kind": "channel",
        "people": [],
        "reactions": [
          "check"
        ],
        "sender_email": "lodol-bot@example.zulipchat.com",
        "sender_id": 21,
        "sender_name": "Lodol bot",
        "sent_at": "2026-10-28T09:00:00Z",
        "topic": "deploys"
      },
      "name": "get_message",
      "output_formatter": "actions.format_message",
      "parameters": [
        {
          "description": "The message's number, from 'Send message' or 'List messages', or its link.",
          "display_name": "Message",
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zulip/get-message",
      "result_str_template": "Got the message.",
      "returns": {
        "properties": {
          "channel": {
            "description": "The channel it's in; empty for a direct message",
            "type": "string"
          },
          "content": {
            "description": "What it says, in Markdown",
            "type": "string"
          },
          "id": {
            "description": "The message's number",
            "type": "number"
          },
          "kind": {
            "description": "channel or direct",
            "type": "string"
          },
          "people": {
            "description": "For a direct message, everyone in the conversation",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reactions": {
            "description": "The emoji people reacted with",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sender_email": {
            "description": "Their email address",
            "type": "string"
          },
          "sender_id": {
            "description": "Their user number",
            "type": "number"
          },
          "sender_name": {
            "description": "Who sent it",
            "type": "string"
          },
          "sent_at": {
            "description": "When it was sent (ISO 8601)",
            "type": "string"
          },
          "topic": {
            "description": "The topic it's under; empty for a direct message",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
