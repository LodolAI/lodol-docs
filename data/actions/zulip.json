    "get_message": {
      "description": "Get one message by its number or link.",
      "display_name": "Get message",
      "display_str_template": "Get Zulip message {0}.",
      "handler": "actions.get_message",
      "id": "zulip_get_message",
      "method": "POST",
      "mock_response": {
