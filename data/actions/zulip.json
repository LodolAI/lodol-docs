{
  "actions": {
    "add_reaction": {
      "description": "React to a message with an emoji.",
      "display_name": "Add reaction",
      "display_str_template": "React to Zulip message {0}.",
      "handler": "actions.add_reaction",
      "id": "zulip_add_reaction",
      "method": "POST",
      "mock_response": {
        "emoji": "check",
        "message_id": 4312,
        "reacted": true
      },
      "name": "add_reaction",
      "output_formatter": "actions.format_reaction",
      "parameters": [
        {
          "description": "The message's number, from 'Send message' or 'List messages', or its link.",
          "display_name": "Message",
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The emoji's name, such as thumbs_up, check or tada.",
          "display_name": "Emoji",
          "name": "emoji",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zulip/add-reaction",
      "result_str_template": "Reacted.",
      "returns": {
        "properties": {
          "emoji": {
            "description": "The emoji",
            "type": "string"
          },
          "message_id": {
            "description": "The message",
            "type": "number"
          },
          "reacted": {
            "description": "True",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_channel": {
      "description": "Make a channel and join it, or join one that already exists.",
      "display_name": "Create or join channel",
      "display_str_template": "Create or join Zulip #{0}.",
      "handler": "actions.create_channel",
      "id": "zulip_create_channel",
      "method": "POST",
      "mock_response": {
        "created_or_joined": true,
        "id": 12,
        "name": "deploy-alerts",
        "private": false
      },
      "name": "create_channel",
      "output_formatter": "actions.format_channel",
      "parameters": [
        {
          "description": "The channel's name.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What it's for, for a new channel.",
          "display_name": "Description",
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Make a new channel private, so people join only by invitation. Off by default.",
          "display_name": "Private",
          "name": "private",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/zulip/create-channel",
      "result_str_template": "In #{zulip_create_channel,name}.",
      "returns": {
        "properties": {
          "created_or_joined": {
            "description": "False if you were already in it",
            "type": "boolean"
          },
          "id": {
            "description": "Its number",
            "type": "number"
          },
          "name": {
            "description": "The channel's name",
            "type": "string"
          },
          "private": {
            "description": "True if it was made private",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_message": {
      "description": "Delete a message. Zulip allows it for your own messages, within your organization's time limit.",
      "display_name": "Delete message",
      "display_str_template": "Delete Zulip message {0}.",
      "handler": "actions.delete_message",
      "id": "zulip_delete_message",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "id": 4312
      },
      "name": "delete_message",
      "output_formatter": "actions.format_deleted",
      "parameters": [
        {
          "description": "The message's number, from 'Send message' or 'List messages', or its link.",
          "display_name": "Message",
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zulip/delete-message",
      "result_str_template": "Message deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "True once deleted",
            "type": "boolean"
          },
          "id": {
            "description": "The message's number",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "get_me": {
      "description": "Get the name and email the connection posts as.",
