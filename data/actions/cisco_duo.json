  "description": "Read and manage Duo users, groups and phones; read authentication logs and administrative events.",
  "display_name": "Cisco Duo",
  "id": "cisco_duo",
  "logo": "https://www.lodol.com/app-icons/cisco-duo-icon.ico",
  "triggers": {
    "cisco_duo_new_group_trigger": {
      "description": "Runs for each new group in Cisco Duo. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New group",
      "id": "cisco_duo_new_group_trigger",
      "output": {
        "record": "object with the fields user_id, group_id, phone_id, name, username"
      },
      "parameters": []
    },
    "cisco_duo_new_or_updated_group_trigger": {
      "description": "Runs for each group added or changed in Cisco Duo. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated group",
      "id": "cisco_duo_new_or_updated_group_trigger",
      "output": {
        "record": "object with the fields user_id, group_id, phone_id, name, username"
      },
      "parameters": []
    },
    "cisco_duo_new_or_updated_phone_trigger": {
      "description": "Runs for each phone added or changed in Cisco Duo. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated phone",
      "id": "cisco_duo_new_or_updated_phone_trigger",
      "output": {
        "record": "object with the fields user_id, group_id, phone_id, name, username"
      },
      "parameters": []
    },
    "cisco_duo_new_or_updated_user_trigger": {
      "description": "Runs for each user added or changed in Cisco Duo. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated user",
