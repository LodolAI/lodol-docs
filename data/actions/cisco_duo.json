      "output": {
        "record": "object with the fields user_id, group_id, phone_id, name, username"
      },
      "parameters": []
    },
    "cisco_duo_new_phone_trigger": {
      "description": "Runs for each new phone in Cisco Duo. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
