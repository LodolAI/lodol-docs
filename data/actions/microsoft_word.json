{
  "actions": {
    "copy_document": {
      "description": "Make a copy of a document under a new name, in the same folder or another one. The copy is made in the background, so it can take a moment to appear.",
      "display_name": "Duplicate document",
      "display_str_template": "Duplicate a document as '{name}'.",
      "handler": "actions.copy_document",
      "id": "microsoft_word_copy_document",
      "method": "POST",
      "mock_response": {
        "data": {
          "accepted": false,
          "monitor_url": "example"
        }
      },
      "name": "copy_document",
      "output_formatter": "business_api.action_specs.<locals>.<lambda>",
      "parameters": [
        {
          "description": "The document's ID, from an earlier step such as List documents, Search documents or Create document.",
          "display_name": "Document ID",
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The copy's name, ending in .docx.",
          "display_name": "Name of the copy",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The folder to put the copy in, as its id (and driveId for another drive). Leave blank to keep it beside the original.",
          "display_name": "Destination folder",
          "name": "parent_reference",
          "required": false,
          "schema": {
            "description": "The folder to put the copy in, as its id (and driveId for another drive). Leave blank to keep it beside the original.",
            "properties": {
              "driveId": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/microsoft-word/copy-document",
      "result_str_template": "Duplicate document completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "Microsoft Word response data.",
            "properties": {
              "accepted": {
                "description": "Accepted.",
                "type": "boolean"
              },
              "monitor_url": {
                "description": "Monitor url.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
