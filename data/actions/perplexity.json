{
  "actions": {
    "generate_model_response": {
      "description": "Sends a prompt to Perplexity and returns the generated response text.",
      "display_name": "Generate a response with Perplexity",
      "display_str_template": "Send a prompt to Perplexity.",
      "handler": "actions.generate_model_response",
      "id": "perplexity_generate_model_response",
      "method": "POST",
      "mock_response": {
        "model": "sonar",
        "response_text": "Here is a web-researched answer to your question."
      },
      "name": "generate_model_response",
      "parameters": [
        {
          "description": "The question or instructions to send to Perplexity.",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "sonar",
          "description": "Choose which Perplexity Sonar model answers your prompt. All models search the web before answering.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Sonar (fast web search answers, recommended)",
              "value": "sonar"
            },
            {
              "label": "Sonar Pro (deeper research, more sources)",
              "value": "sonar-pro"
            },
            {
              "label": "Sonar Reasoning Pro (advanced reasoning)",
              "value": "sonar-reasoning-pro"
            },
            {
              "label": "Sonar Deep Research (long, in-depth reports)",
              "value": "sonar-deep-research"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/perplexity/generate-model-response",
      "result_str_template": "Perplexity response: {perplexity_generate_model_response,response_text}",
      "returns": {
        "properties": {
          "model": {
            "description": "Model.",
            "type": "string"
          },
          "response_text": {
            "description": "Response text.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect Perplexity's AI models to answer questions with responses backed by web search.",
  "display_name": "Perplexity",
  "id": "perplexity"
}
