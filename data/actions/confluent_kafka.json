{
  "actions": {
    "create_topic": {
      "description": "Create a topic, or check that it could be created without creating it. The cluster chooses the replication factor.",
      "display_name": "Create topic",
      "display_str_template": "Create topic {topic_name}.",
      "handler": "actions.create_topic",
      "id": "confluent_kafka_create_topic",
      "method": "POST",
      "mock_response": {
        "topic": {
          "cluster_id": "lkc-abc123",
          "is_internal": false,
          "partitions_count": 6,
          "replication_factor": 3,
          "topic_name": "orders"
        },
        "validated": false
      },
      "name": "create_topic",
      "output_formatter": "_action.<locals>.<lambda>",
      "parameters": [
        {
          "description": "Letters, digits, '.', '_' and '-' only.",
          "display_name": "Topic name",
          "examples": [
            {
              "label": "A topic name",
              "value": "orders"
            }
          ],
          "name": "topic_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many partitions. Leave empty for the cluster's default.",
          "display_name": "Partitions",
          "maximum": 100000,
          "minimum": 1,
          "name": "partitions_count",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Settings for the new topic, each a name and a value, for example retention.ms = 604800000.",
          "display_name": "Topic settings",
          "name": "configs",
          "object_key_name": "Setting name",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "default": false,
          "description": "Run Confluent's checks and stop before creating the topic.",
          "display_name": "Only check, don't create",
          "name": "validate_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/confluent-kafka/create-topic",
      "result_str_template": "Topic created.",
      "returns": {
        "properties": {
          "topic": {
            "description": "The topic",
            "properties": {
              "cluster_id": {
                "description": "The cluster's id",
                "type": "string"
              },
              "is_internal": {
                "description": "Whether Kafka keeps this topic for its own use",
                "type": "boolean"
              },
              "partitions_count": {
                "description": "How many partitions the topic has",
                "type": "number"
              },
              "replication_factor": {
                "description": "How many brokers hold a copy of each partition",
                "type": "number"
              },
              "topic_name": {
                "description": "The topic's name",
                "type": "string"
              }
            },
            "type": "object"
          },
          "validated": {
            "description": "True if the topic was only checked, not created",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
