    "produce_record": {
      "description": "Write one record to a topic and get the partition and offset it landed at. Running it twice writes two records.",
      "display_name": "Produce record",
      "display_str_template": "Produce record to topic {topic_name}.",
      "handler": "actions.produce_record",
      "id": "confluent_kafka_produce_record",
      "method": "POST",
      "mock_response": {
        "key_size": 5,
        "offset": 42,
        "partition_id": 0,
        "timestamp": "2026-11-03T12:00:00.000Z",
        "topic_name": "orders",
        "value_size": 17
      },
      "name": "produce_record",
      "output_formatter": "_action.<locals>.<lambda>",
      "parameters": [
        {
          "description": "The topic. Pick one, or type or chain its name.",
          "display_name": "Topic",
          "dynamic_source": "topics",
          "dynamic_source_allows_custom": true,
          "name": "topic_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The record's contents. Give a value, a key, or both.",
          "display_name": "Value",
          "multiline": true,
          "name": "value",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "STRING",
          "description": "How to read the value. JSON must be valid JSON; binary must be base64.",
          "display_name": "Value format",
          "name": "value_format",
          "options": [
            {
              "label": "Text (default)",
              "value": "STRING"
            },
            {
              "label": "JSON",
              "value": "JSON"
            },
            {
              "label": "Binary (as base64 text)",
              "value": "BINARY"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The record's key. Records with the same key go to the same partition.",
          "display_name": "Key",
          "name": "key",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "STRING",
          "description": "How to read the key.",
          "display_name": "Key format",
          "name": "key_format",
          "options": [
            {
              "label": "Text (default)",
              "value": "STRING"
            },
            {
              "label": "JSON",
              "value": "JSON"
            },
            {
              "label": "Binary (as base64 text)",
              "value": "BINARY"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Send to this partition. Leave empty to let Kafka choose from the key.",
          "display_name": "Partition",
          "maximum": 100000,
          "minimum": 0,
          "name": "partition_id",
          "required": false,
          "type": "ParameterType.NUMBER"
