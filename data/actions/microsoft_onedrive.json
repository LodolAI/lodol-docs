    "resolve_share_link": {
      "description": "Look up a Microsoft sharing link to get the drive ID and item ID of the shared file or folder.",
      "display_name": "Look up share link",
      "display_str_template": "Look up share link",
      "handler": "actions.resolve_share_link",
      "id": "microsoft_onedrive_resolve_share_link",
      "method": "POST",
      "mock_response": {
        "drive_id": "drive456",
        "item_id": "item123",
        "name": "Project Tracker.xlsx",
        "web_url": "https://..."
      },
      "name": "resolve_share_link",
      "parameters": [
        {
          "description": "Microsoft sharing URL (e.g., from SharePoint or OneDrive).",
          "display_name": "Share URL",
          "name": "share_url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/resolve-share-link",
      "result_str_template": "Share link looked up.",
      "returns": {
        "properties": {
          "drive_id": {
            "description": "Drive ID. Use as drive_id in Microsoft Excel actions or other OneDrive actions.",
            "type": "string"
          },
          "item_id": {
            "description": "Item ID. Use as item_id in Microsoft Excel actions or other OneDrive actions.",
            "type": "string"
          },
          "name": {
            "description": "File or folder name.",
            "type": "string"
          },
          "web_url": {
            "description": "Web URL for the item.",
            "type": "string"
          }
        },
        "type": "object"
      }
