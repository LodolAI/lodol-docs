{
  "actions": {
    "copy_item": {
      "description": "Copy a file or folder into a folder, in the same drive or another. The copy is made in the background, usually within seconds. A name already taken there gets a number added, so nothing is replaced.",
      "display_name": "Copy file or folder",
      "display_str_template": "Copy {item_id} into {destination_parent_id}.",
      "handler": "actions.copy_item",
      "id": "microsoft_onedrive_copy_item",
      "method": "POST",
      "mock_response": {
        "destination_drive_id": "drive456",
        "started": true
      },
      "name": "copy_item",
      "parameters": [
        {
          "description": "The file or folder to copy, from an earlier step or a share link you looked up.",
          "display_name": "File or folder",
          "label_source": "item_names",
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The drive to work in: pick one of your organization's document libraries, or use a drive from 'List drives' or 'Look up share link'.",
          "display_name": "Drive",
          "dynamic_source": "drives",
          "dynamic_source_allows_custom": true,
          "name": "drive_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The folder to put the copy in, from an earlier step or a share link you looked up.",
          "display_name": "Copy into folder",
          "name": "destination_parent_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The drive that folder is in. Leave blank for the same drive.",
          "display_name": "Drive to copy into",
          "name": "destination_drive_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Leave blank to keep the original's name.",
          "display_name": "Name of the copy",
          "name": "new_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/copy-item",
      "result_str_template": "Copy started.",
      "returns": {
        "properties": {
          "destination_drive_id": {
            "description": "The drive the copy goes into.",
            "type": "string"
          },
          "started": {
            "description": "Always true: OneDrive is making the copy.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_folder": {
