{
  "actions": {
    "create_folder": {
      "description": "Create a new folder in OneDrive.",
      "display_name": "Create folder",
      "display_str_template": "Create folder '{0}' in OneDrive",
      "handler": "actions.create_folder",
      "id": "microsoft_onedrive_create_folder",
      "method": "POST",
      "mock_response": {
        "id": "folder123",
        "name": "NewFolder"
      },
      "name": "create_folder",
      "parameters": [
        {
          "description": "Name for the new folder.",
          "display_name": "Folder name",
          "name": "folder_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the folder to create the new folder inside.",
          "display_name": "Parent item ID",
          "name": "parent_item_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the drive to use. You can find drive IDs with the List drives action.",
          "display_name": "Drive ID",
          "name": "drive_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/create-folder",
      "result_str_template": "Folder created.",
      "returns": {
        "properties": {
          "id": {
            "description": "Created folder item ID. Use as parent_item_id, destination_parent_id, or item_id in other OneDrive actions.",
            "type": "string"
          },
          "name": {
            "description": "Folder name.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_share_link": {
      "description": "Create a sharing link for a file or folder.",
      "display_name": "Create share link",
      "display_str_template": "Create {1} share link for item {0}",
      "handler": "actions.create_share_link",
      "id": "microsoft_onedrive_create_share_link",
      "method": "POST",
      "mock_response": {
        "link": {
          "webUrl": "https://..."
        }
      },
      "name": "create_share_link",
      "parameters": [
        {
          "description": "ID of the file or folder to share.",
          "display_name": "Item ID",
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Type of link to create (view or edit).",
          "display_name": "Link type",
          "name": "link_type",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the drive to use. You can find drive IDs with the List drives action.",
          "display_name": "Drive ID",
          "name": "drive_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/create-share-link",
      "result_str_template": "Share link created.",
      "returns": {
        "properties": {
          "link": {
            "properties": {
              "webUrl": {
                "description": "Shareable URL for the item.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_workbook": {
      "description": "Create a new blank Excel workbook (.xlsx) in OneDrive.",
      "display_name": "Create workbook",
      "display_str_template": "Create workbook '{0}' in OneDrive",
      "handler": "actions.create_workbook",
      "id": "microsoft_onedrive_create_workbook",
      "method": "POST",
      "mock_response": {
        "id": "workbook123",
        "name": "Q3 Sales.xlsx",
        "webUrl": "https://..."
      },
      "name": "create_workbook",
      "parameters": [
        {
          "description": "Name for the new workbook (e.g. 'Q3 Sales'). .xlsx extension added automatically if missing.",
          "display_name": "Workbook name",
          "name": "workbook_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the folder to create the workbook in.",
          "display_name": "Parent item ID",
          "name": "parent_item_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the drive to use. You can find drive IDs with the List drives action.",
          "display_name": "Drive ID",
          "name": "drive_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/create-workbook",
      "result_str_template": "Workbook created.",
      "returns": {
        "properties": {
          "id": {
            "description": "Created workbook item ID. Use as item_id in Microsoft Excel actions.",
            "type": "string"
          },
          "name": {
            "description": "Workbook filename.",
            "type": "string"
          },
          "webUrl": {
            "description": "Web URL to open the workbook.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_item": {
      "description": "Delete a file or folder from OneDrive.",
      "display_name": "Delete file or folder",
      "display_str_template": "Delete file or folder {0}",
      "handler": "actions.delete_item",
      "id": "microsoft_onedrive_delete_item",
      "method": "POST",
      "mock_response": {
        "deleted": true
      },
      "name": "delete_item",
      "parameters": [
        {
          "description": "ID of the file or folder to delete.",
          "display_name": "Item ID",
          "name": "item_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the drive to use. You can find drive IDs with the List drives action.",
          "display_name": "Drive ID",
          "name": "drive_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/delete-item",
      "result_str_template": "File or folder deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Whether deletion succeeded.",
            "type": "boolean"
          }
        },
        "type": "object"
      }
