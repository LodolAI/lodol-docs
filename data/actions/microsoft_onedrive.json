    "list_children": {
      "description": "List the contents of a folder in OneDrive.",
      "display_name": "List folder contents",
      "display_str_template": "List contents of folder {0}",
      "handler": "actions.list_children",
      "id": "microsoft_onedrive_list_children",
      "method": "POST",
      "mock_response": {
        "value": [
          {
            "id": "item1",
            "name": "file1.txt"
          }
        ]
      },
      "name": "list_children",
      "parameters": [
        {
          "description": "ID of the folder to list.",
          "display_name": "Parent item ID",
          "name": "parent_item_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the drive to use. You can find drive IDs with the List drives action.",
          "display_name": "Drive ID",
          "name": "drive_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/list-children",
      "result_str_template": "Folder contents listed.",
      "returns": {
        "properties": {
          "value": {
            "description": "List of files and folders.",
            "items": {
              "properties": {
                "id": {
                  "description": "Item ID. Use as item_id, parent_item_id, or destination_parent_id in other OneDrive actions.",
                  "type": "string"
                },
                "name": {
                  "description": "File or folder name.",
                  "type": "string"
                },
                "webUrl": {
                  "description": "Web URL for the item.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_drives": {
      "description": "List the drives available on a SharePoint site (uses the main site unless you specify one).",
      "display_name": "List drives",
      "display_str_template": "List OneDrive drives",
      "handler": "actions.list_drives",
      "id": "microsoft_onedrive_list_drives",
      "method": "POST",
      "mock_response": {
        "value": [
          {
            "driveType": "documentLibrary",
            "id": "drive1",
            "name": "Documents"
          }
        ]
      },
      "name": "list_drives",
      "parameters": [
        {
          "description": "SharePoint site ID. Leave blank to use the main site (defaults to 'root').",
          "display_name": "Site ID",
          "name": "site_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-onedrive/list-drives",
      "result_str_template": "Drives listed.",
      "returns": {
        "properties": {
          "value": {
            "description": "List of drives.",
            "items": {
              "properties": {
                "driveType": {
                  "description": "Drive type (e.g. documentLibrary, business).",
                  "type": "string"
                },
                "id": {
                  "description": "Drive ID. Use as drive_id in other OneDrive actions.",
                  "type": "string"
                },
                "name": {
                  "description": "Drive display name.",
                  "type": "string"
                },
                "webUrl": {
                  "description": "Web URL for the drive.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "move_item": {
