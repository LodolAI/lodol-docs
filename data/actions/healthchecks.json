  "id": "healthchecks",
  "logo": "https://www.lodol.com/app-icons/healthchecks-icon.svg",
  "triggers": {
    "healthchecks_status_changed_trigger": {
      "description": "Runs when a Healthchecks.io check goes down, or comes back up after being down. Checks already down when the workflow is turned on don't run it.",
      "display_name": "Check went down or came back up",
      "id": "healthchecks_status_changed_trigger",
      "output": {
        "last_ping": "string",
        "name": "string",
        "ping_url": "string",
        "previous_status": "string",
        "status": "string",
        "tags": "array",
        "uuid": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only this check, by its UUID. Leave blank for every check in the project.",
          "display_name": "Check",
          "name": "check",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "down: goes down; up: comes back up; any: either. Leave blank for either.",
          "display_name": "When it",
          "name": "change",
          "required": false
        }
      ]
    }
