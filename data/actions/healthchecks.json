{
  "actions": {
    "create_check": {
      "description": "Create a check that expects a ping on a period or a schedule, and get its ping address. It can update a check of the same name instead.",
      "display_name": "Create check",
      "display_str_template": "Create check {0} in Healthchecks.io.",
      "handler": "actions.create_check",
      "id": "healthchecks_create_check",
      "method": "POST",
      "mock_response": {
        "badge_url": "https://healthchecks.io/b/2/1b9d0386-d07e-44b0-8995-4a9a372de43c.svg",
        "description": "Runs ~/backup.sh",
        "grace_minutes": 60,
        "integrations": [
          "1bdea468-03bf-47b8-ab27-29a9dd0e4b94"
        ],
        "last_ping": "",
        "name": "Nightly backup",
        "next_ping": "",
        "period_minutes": null,
        "ping_url": "https://hc-ping.com/31365bce-8da9-4729-8ff3-aaa71d56b712",
        "pings": 0,
        "schedule": "0 3 * * *",
        "slug": "nightly-backup",
        "started": false,
        "status": "new",
        "tags": [
          "backup",
          "prod"
        ],
        "time_zone": "Europe/London",
        "uuid": "31365bce-8da9-4729-8ff3-aaa71d56b712"
      },
      "name": "create_check",
      "output_formatter": "actions.format_check",
      "parameters": [
        {
          "description": "What the check watches, such as Nightly backup.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A short name for pinging by slug: a-z, 0-9, '-' and '_'.",
          "display_name": "Slug",
          "name": "slug",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Tags to group it by.",
          "display_name": "Tags",
          "dynamic_source": "tags",
          "dynamic_source_allows_custom": true,
          "multi_select": true,
          "name": "tags",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "What the check is for.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How often the job runs, such as 60 for hourly. Defaults to a day.",
          "display_name": "Expect a ping every (minutes)",
          "maximum": 525600,
          "minimum": 1,
          "name": "period_minutes",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Instead of a period, a cron expression such as 0 3 * * * (3am daily).",
          "display_name": "Or on a schedule",
          "examples": [
            {
              "label": "Every day at 3am",
              "value": "0 3 * * *"
            }
          ],
          "name": "schedule",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The time zone the schedule is in, such as Europe/London. Defaults to UTC.",
          "display_name": "Schedule time zone",
          "examples": [
            {
              "label": "New York",
              "value": "America/New_York"
            }
          ],
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How late a ping may be before the check goes down. Defaults to an hour.",
          "display_name": "Grace time (minutes)",
          "maximum": 525600,
          "minimum": 1,
          "name": "grace_minutes",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The integrations to alert when it goes down.",
          "display_name": "Alert through",
          "dynamic_source": "integrations",
          "dynamic_source_allows_custom": true,
          "multi_select": true,
          "name": "integrations",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "default": false,
          "description": "Change the check with this name instead of making a second one. Off by default.",
          "display_name": "Update if it exists",
          "name": "update_if_exists",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/healthchecks/create-check",
      "result_str_template": "Check {healthchecks_create_check,name} is ready.",
      "returns": {
        "properties": {
          "badge_url": {
            "description": "Its status badge",
            "type": "string"
          },
          "description": {
            "description": "Its description",
            "type": "string"
          },
          "grace_minutes": {
            "description": "How late a ping may be before it goes down",
            "nullable": true,
            "type": "number"
          },
          "integrations": {
            "description": "The integrations it alerts",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "last_ping": {
            "description": "When it last got a ping (ISO 8601); empty if never",
            "type": "string"
          },
          "name": {
            "description": "Its name",
            "type": "string"
          },
          "next_ping": {
            "description": "When the next ping is due (ISO 8601); empty if not known",
            "type": "string"
          },
          "period_minutes": {
            "description": "How often a ping is expected; empty for a scheduled check",
            "nullable": true,
            "type": "number"
          },
          "ping_url": {
            "description": "The address the job pings",
            "type": "string"
          },
          "pings": {
            "description": "How many pings it has had",
            "type": "number"
          },
          "schedule": {
            "description": "Its cron or OnCalendar schedule; empty for a period check",
            "type": "string"
          },
          "slug": {
            "description": "Its slug",
            "type": "string"
          },
          "started": {
            "description": "True while a job that sent a start signal runs",
            "type": "boolean"
          },
          "status": {
            "description": "new, up, grace (late), down or paused",
            "type": "string"
          },
          "tags": {
            "description": "Its tags",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "time_zone": {
            "description": "The schedule's time zone",
            "type": "string"
          },
          "uuid": {
            "description": "The check's UUID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
