            "url": "https://jobicy.com/jobs/155418-principal-security-researcher-edr-windows"
          }
        ],
        "next_cursor": "AgAAAABq0nSNAAAAAGrRlsAAAAAAAAJW-b6_jtTZuW3yp8s0dv59LcgorBQX"
      },
      "name": "search_jobs",
      "parameters": [
        {
          "description": "Words to find in the job, 3 to 50 characters.",
          "display_name": "Keywords",
          "examples": [
            {
              "label": "Python",
              "value": "python"
            },
            {
              "label": "Product designer",
              "value": "product designer"
            }
          ],
          "name": "keywords",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Where candidates may live, as a slug from List locations, e.g. usa, europe or anywhere.",
          "display_name": "Location",
          "examples": [
            {
              "label": "USA",
              "value": "usa"
            },
            {
              "label": "Europe",
              "value": "europe"
            },
            {
              "label": "Anywhere",
              "value": "anywhere"
            }
          ],
          "name": "location",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A job category, as a slug from List industries, e.g. engineering or marketing.",
          "display_name": "Industry",
          "examples": [
            {
              "label": "Software Engineering",
              "value": "engineering"
            },
            {
              "label": "Marketing & Sales",
              "value": "marketing"
            },
            {
              "label": "Data Science & Analytics",
              "value": "data-science"
            }
          ],
          "name": "industry",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 20,
          "description": "How many jobs to get, from 1 to 50.",
          "display_name": "Max results",
          "maximum": 50,
          "minimum": 1,
          "name": "count",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "To get the next page, the next_cursor of an earlier search with the same filters. Leave empty for the first page.",
          "display_name": "Next page",
          "name": "cursor",
          "required": false,
          "type": "ParameterType.STRING"
        }
