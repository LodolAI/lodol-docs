{
  "actions": {
    "check_job_status": {
      "description": "Check whether Jobicy jobs you saved are still open, up to 100 at a time, including ones older than the 7-day feed. A job is 'active', 'closed' or 'unknown'. No API key required.",
      "display_name": "Check job status",
      "display_str_template": "Check the status of Jobicy jobs {0}.",
      "handler": "actions.check_job_status",
      "id": "jobicy_check_job_status",
      "method": "POST",
      "mock_response": {
        "active_count": 1,
        "checked_at": "2026-10-16T19:01:36+00:00",
        "closed_count": 0,
        "count": 2,
        "jobs": [
          {
            "id": 155418,
            "status": "active"
          },
          {
            "id": 1,
            "status": "unknown"
          }
        ]
      },
      "name": "check_job_status",
      "parameters": [
        {
          "description": "One or more Jobicy job ids, separated by commas, e.g. 155418, 155439.",
          "display_name": "Job ids",
          "examples": [
            {
              "label": "Two jobs",
              "value": "155418, 155439"
            }
          ],
          "name": "job_ids",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/jobicy/check-job-status",
      "result_str_template": "{jobicy_check_job_status,active_count} of {jobicy_check_job_status,count} jobs are still open.",
      "returns": {
        "properties": {
          "active_count": {
            "description": "How many are still open.",
            "type": "integer"
          },
          "checked_at": {
            "description": "When Jobicy checked (UTC, ISO 8601).",
            "type": [
              "string",
              "null"
            ]
          },
          "closed_count": {
            "description": "How many are closed.",
            "type": "integer"
          },
          "count": {
            "description": "How many jobs were checked.",
            "type": "integer"
          },
          "jobs": {
            "description": "Each job's status, in the order asked.",
            "items": {
              "properties": {
                "id": {
                  "description": "The job id.",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "status": {
                  "description": "'active' (still open), 'closed', or 'unknown' (not confirmed either way).",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
