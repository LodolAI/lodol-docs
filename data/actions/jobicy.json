    "search_jobs": {
      "description": "Get remote jobs posted on Jobicy in the last 7 days, newest first, optionally by keywords, where candidates may live and category: title, company, location, level, salary and the full description. To see more, run it again with the next page it gives. No API key required.",
      "display_name": "Search jobs",
      "display_str_template": "Search Jobicy for remote jobs.",
      "handler": "actions.search_jobs",
      "id": "jobicy_search_jobs",
      "method": "POST",
