      "name": "get_account",
      "output_formatter": "actions.format_get_account_output",
      "parameters": [],
      "path": "/actions/library/temporal/get-account",
      "result_str_template": "Retrieved Temporal Cloud account.",
      "returns": {
        "description": "Wrapper with a single 'account' object. The API key is scoped to one account, so this endpoint takes no parameters.",
        "properties": {
          "account": {
            "description": "The Temporal Cloud account.",
            "properties": {
              "id": {
                "description": "The account id (short identifier).",
                "type": "string"
              },
              "metrics": {
                "description": "Resolved metrics info.",
                "properties": {
                  "uri": {
                    "description": "Prometheus metrics endpoint URI; only set when metrics are enabled.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "resourceVersion": {
                "description": "Opaque version of the account spec, required by update operations.",
                "type": "string"
              },
              "spec": {
                "description": "Account specification.",
                "properties": {
                  "metrics": {
                    "description": "Metrics config; present when metrics are enabled.",
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "state": {
                "description": "Lifecycle state enum, e.g. 'RESOURCE_STATE_ACTIVE'.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
