{
  "actions": {
    "delete_object": {
      "description": "Delete an object from an S3 bucket.",
      "display_name": "Delete object from S3",
      "display_str_template": "Delete object '{1}' from S3 bucket '{0}'.",
      "handler": "actions.delete_object",
      "id": "amazon_s3_delete_object",
      "method": "POST",
      "mock_response": {
        "bucket": "my-bucket",
        "deleted": true,
        "key": "reports/june.pdf",
        "version_id": null
      },
      "name": "delete_object",
      "parameters": [
        {
          "description": "The S3 bucket to delete from.",
          "display_name": "Bucket",
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The key of the object to delete.",
          "display_name": "Object key",
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/amazon-s3/delete-object",
      "result_str_template": "Deleted s3://{bucket}/{key}.",
      "returns": {
        "properties": {
          "bucket": {
            "description": "The bucket the object was deleted from.",
            "type": "string"
          },
          "deleted": {
            "description": "True when the delete call succeeded.",
            "type": "boolean"
          },
          "key": {
            "description": "The object key that was deleted.",
            "type": "string"
          },
          "version_id": {
            "description": "Version ID of the delete, when the bucket is versioned.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    "download_object": {
      "description": "Download an object from an S3 bucket and save it to a local file.",
      "display_name": "Download object from S3",
      "display_str_template": "Download object '{1}' from S3 bucket '{0}'.",
      "handler": "actions.download_object",
      "id": "amazon_s3_download_object",
      "method": "POST",
      "mock_response": {
        "bucket": "my-bucket",
        "content_type": "application/pdf",
        "key": "reports/june.pdf",
        "path": "/tmp/june.pdf",
        "size": 20480
      },
      "name": "download_object",
      "parameters": [
        {
          "description": "The S3 bucket to read from.",
          "display_name": "Bucket",
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The key of the object to download.",
          "display_name": "Object key",
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Where to save the downloaded file. Defaults to a temporary folder when left blank.",
          "display_name": "Save to",
          "name": "destination_path",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/amazon-s3/download-object",
      "result_str_template": "Downloaded to '{path}'.",
      "returns": {
        "properties": {
          "bucket": {
            "description": "The bucket the object was read from.",
            "type": "string"
          },
          "content_type": {
            "description": "The object's Content-Type, if S3 returned one.",
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "description": "The object key that was read.",
            "type": "string"
          },
          "path": {
            "description": "Local path the object was saved to.",
            "type": "string"
          },
          "size": {
            "description": "Number of bytes downloaded.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "generate_presigned_url": {
      "description": "Create a time-limited, pre-signed URL to download (or upload) an S3 object without sharing your AWS credentials.",
      "display_name": "Create pre-signed S3 URL",
      "display_str_template": "Create a pre-signed URL for '{1}' in S3 bucket '{0}'.",
      "handler": "actions.generate_presigned_url",
      "id": "amazon_s3_generate_presigned_url",
      "method": "POST",
      "mock_response": {
        "bucket": "my-bucket",
        "expires_in": 3600,
        "key": "reports/june.pdf",
        "method": "get_object",
        "url": "https://my-bucket.s3.us-east-1.amazonaws.com/reports/june.pdf?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Expires=3600&X-Amz-Signature=EXAMPLE"
      },
      "name": "generate_presigned_url",
      "parameters": [
        {
          "description": "The S3 bucket the URL should point at.",
          "display_name": "Bucket",
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The key of the object the URL should point at.",
          "display_name": "Object key",
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "get_object",
          "description": "What the URL should authorise: a download (get_object) or an upload (put_object).",
          "display_name": "URL type",
          "name": "method",
          "options": [
            {
              "label": "Download (get_object)",
              "value": "get_object"
            },
            {
              "label": "Upload (put_object)",
              "value": "put_object"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 3600,
          "description": "How long the URL stays valid, in seconds (max 604800 = 7 days, default 3600 = 1 hour).",
          "display_name": "Expires in (seconds)",
          "maximum": 604800,
          "minimum": 1,
          "name": "expires_in",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/amazon-s3/generate-presigned-url",
      "result_str_template": "Pre-signed URL created (valid {expires_in}s).",
      "returns": {
        "properties": {
          "bucket": {
            "description": "The bucket the URL points at.",
            "type": "string"
          },
          "expires_in": {
            "description": "Seconds the URL stays valid for.",
            "type": "integer"
          },
          "key": {
            "description": "The object key the URL points at.",
            "type": "string"
          },
          "method": {
            "description": "What the URL authorises: get_object or put_object.",
            "type": "string"
          },
          "url": {
            "description": "The time-limited pre-signed URL.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_objects": {
      "description": "List objects in an S3 bucket, optionally filtered by key prefix.",
      "display_name": "List objects in S3 bucket",
      "display_str_template": "List objects in S3 bucket '{0}'.",
      "handler": "actions.list_objects",
      "id": "amazon_s3_list_objects",
      "method": "POST",
      "mock_response": {
        "bucket": "my-bucket",
        "count": 2,
        "is_truncated": false,
        "objects": [
          {
            "etag": "9b2cf535f27731c974343645a3985328",
            "key": "reports/june.pdf",
            "last_modified": "2026-07-30T12:00:00+00:00",
            "size": 20480,
            "storage_class": "STANDARD"
          },
          {
            "etag": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d",
            "key": "reports/may.pdf",
            "last_modified": "2026-06-30T12:00:00+00:00",
            "size": 18432,
            "storage_class": "STANDARD"
          }
        ],
        "prefix": "reports/"
      },
      "name": "list_objects",
      "parameters": [
        {
          "description": "The S3 bucket to list.",
          "display_name": "Bucket",
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only return objects whose key starts with this prefix (e.g. reports/). Leave blank to list the whole bucket.",
          "display_name": "Prefix",
          "name": "prefix",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of objects to return (1\u20131000, default 1000).",
          "display_name": "Max results",
          "maximum": 1000,
          "minimum": 1,
          "name": "max_keys",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/amazon-s3/list-objects",
      "result_str_template": "Found {count} object(s).",
      "returns": {
        "properties": {
          "bucket": {
            "description": "The bucket that was listed.",
            "type": "string"
          },
          "count": {
            "description": "Number of objects returned.",
            "type": "integer"
          },
          "is_truncated": {
            "description": "True if more objects exist beyond this page.",
            "type": "boolean"
          },
          "objects": {
            "description": "The objects in the bucket that matched.",
            "items": {
              "properties": {
                "etag": {
                  "description": "The object's ETag.",
                  "type": "string"
                },
                "key": {
                  "description": "The object key.",
                  "type": "string"
                },
                "last_modified": {
                  "description": "ISO-8601 last-modified time.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "size": {
                  "description": "Object size in bytes.",
                  "type": "integer"
                },
                "storage_class": {
                  "description": "The object's storage class (e.g. STANDARD).",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "prefix": {
            "description": "The key prefix filter that was applied, if any.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    "upload_object": {
      "description": "Upload an object to an S3 bucket from inline text or a local file. Provide either 'content' or 'file_path', not both.",
      "display_name": "Upload object to S3",
      "display_str_template": "Upload object '{1}' to S3 bucket '{0}'.",
      "handler": "actions.upload_object",
      "id": "amazon_s3_upload_object",
      "method": "POST",
      "mock_response": {
        "bucket": "my-bucket",
        "etag": "9b2cf535f27731c974343645a3985328",
        "key": "reports/june.pdf",
        "size": 20480,
        "version_id": null
      },
      "name": "upload_object",
      "parameters": [
        {
          "description": "The destination S3 bucket name.",
          "display_name": "Bucket",
          "name": "bucket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The object key (path within the bucket), e.g. reports/june.pdf.",
          "display_name": "Object key",
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Inline text to upload as the object's contents. Use this or 'file_path'.",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "autofill_name_param": "key",
          "description": "A local file to upload as the object. Use this or 'content'.",
          "display_name": "File to upload",
          "name": "file_path",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional MIME type (e.g. application/pdf). Guessed from the key's extension when omitted.",
          "display_name": "Content type",
          "name": "content_type",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/amazon-s3/upload-object",
      "result_str_template": "Uploaded to s3://{bucket}/{key}.",
      "returns": {
        "properties": {
          "bucket": {
            "description": "The bucket the object was written to.",
            "type": "string"
          },
          "etag": {
            "description": "The object's ETag (quotes stripped).",
            "type": "string"
          },
          "key": {
            "description": "The object key that was written.",
            "type": "string"
          },
          "size": {
            "description": "Number of bytes uploaded.",
            "type": "integer"
          },
          "version_id": {
            "description": "Version ID when the bucket has versioning enabled, else null.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Store, retrieve, and share files in Amazon S3: upload and download objects, list a bucket, delete objects, and generate pre-signed URLs.",
  "display_name": "Amazon S3",
  "id": "amazon_s3"
}
