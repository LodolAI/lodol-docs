  "description": "Read videos, playlists, livestreams and player settings from your Dailymotion profiles.",
  "display_name": "Dailymotion",
  "id": "dailymotion",
  "logo": "https://www.lodol.com/app-icons/dailymotion-icon.png",
  "triggers": {
    "dailymotion_new_livestream_trigger": {
      "description": "Runs for each new livestream in Dailymotion. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New livestream",
      "id": "dailymotion_new_livestream_trigger",
      "output": {
        "record": "object with the fields livestream_id, title"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The profile ID. Leave empty to use the profile from your connection.",
          "display_name": "Profile ID",
          "name": "profile_id",
          "required": false
        }
      ]
    },
