{
  "actions": {
    "cancel_scheduled_event": {
      "description": "Cancel a scheduled Calendly event by its ID, with an optional reason.",
      "display_name": "Cancel a Calendly scheduled event",
      "display_str_template": "Cancel Calendly event '{0}'.",
      "handler": "actions.cancel_scheduled_event",
      "id": "calendly_cancel_scheduled_event",
      "method": "POST",
      "mock_response": {
        "cancelled": true,
        "event_uuid": "IJKL1234567890",
        "status": "success"
      },
      "name": "cancel_scheduled_event",
      "output_formatter": "actions.format_cancel_scheduled_event_output",
      "parameters": [
        {
          "description": "The ID of the scheduled event to cancel (for example, ABCD123). If you have the event's full link, the ID is the part after the last '/': use the Split built-in to split the link on '/' and take the last item.",
          "display_name": "Event ID",
          "name": "event_uuid",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional cancellation reason.",
          "display_name": "Reason",
          "name": "reason",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/calendly/cancel-scheduled-event",
      "result_str_template": "Calendly event canceled.",
      "returns": {
        "properties": {
          "cancelled": {
            "description": "Always true, indicating the event was successfully cancelled.",
            "type": "boolean"
          },
          "event_uuid": {
            "description": "The UUID of the cancelled event.",
            "type": "string"
          },
          "status": {
            "description": "Always 'success' on successful requests.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_scheduling_link": {
      "description": "Generate a scheduling link for a specific Calendly event type with optional invitee details.",
      "display_name": "Create a Calendly scheduling link",
      "display_str_template": "Create a Calendly scheduling link for event type '{0}'.",
      "handler": "actions.create_scheduling_link",
      "id": "calendly_create_scheduling_link",
      "method": "POST",
      "mock_response": {
        "booking_url": "https://calendly.com/s/booking-link-12345",
        "owner": "https://api.calendly.com/event_types/EFGH1234567890",
        "status": "success"
      },
      "name": "create_scheduling_link",
      "output_formatter": "actions.format_create_scheduling_link_output",
      "parameters": [
        {
          "description": "The link for the Calendly event type to create a scheduling link for, from the List Calendly event types action.",
          "display_name": "Event type URI",
          "name": "event_type_uri",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of events that can be scheduled with this link (default 1).",
          "display_name": "Max event count",
          "name": "max_event_count",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional invitee email to prefill on the scheduling link.",
          "display_name": "Invitee email",
          "name": "invitee_email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional timezone to associate with the invitee (e.g., America/Los_Angeles).",
          "display_name": "Timezone",
          "name": "timezone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/calendly/create-scheduling-link",
      "result_str_template": "Scheduling link created.",
      "returns": {
        "properties": {
          "booking_url": {
            "description": "The generated scheduling link URL that can be sent to invitees to book appointments.",
            "type": "string"
          },
          "owner": {
            "description": "The event type URI this scheduling link was created for.",
            "type": "string"
          },
          "status": {
            "description": "Always 'success' on successful requests.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_current_user": {
      "description": "Fetch the connected Calendly user's profile, including their name, email, and account link.",
      "display_name": "Get Calendly user profile",
      "display_str_template": "Fetch Calendly user profile details.",
      "handler": "actions.get_current_user",
      "id": "calendly_get_current_user",
      "method": "POST",
      "mock_response": {
        "email": "john.doe@example.com",
        "name": "John Doe",
        "status": "success",
        "user_uri": "https://api.calendly.com/users/ABCD1234567890"
      },
      "name": "get_current_user",
      "output_formatter": "actions.format_get_current_user_output",
      "parameters": [],
      "path": "/actions/library/calendly/get-current-user",
      "result_str_template": "Calendly user profile fetched.",
      "returns": {
        "properties": {
          "email": {
            "description": "User's email address.",
            "type": "string"
          },
          "name": {
            "description": "User's display name.",
            "type": "string"
          },
          "status": {
            "description": "Always 'success' on successful requests.",
            "type": "string"
          },
          "user_uri": {
            "description": "Calendly user URI (e.g., 'https://api.calendly.com/users/ABCD123'). Use this as input for list_event_types and list_scheduled_events actions.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_event_types": {
      "description": "List the available Calendly event types for the connected user.",
      "display_name": "List Calendly event types",
      "display_str_template": "List Calendly event types for '{0}'.",
      "handler": "actions.list_event_types",
      "id": "calendly_list_event_types",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "event_types": [
          {
            "name": "30 Minute Meeting",
            "scheduling_url": "https://calendly.com/user/30min",
            "slug": "30min",
            "uri": "https://api.calendly.com/event_types/EFGH1234567890"
          }
        ],
        "status": "success"
      },
      "name": "list_event_types",
      "output_formatter": "actions.format_list_event_types_output",
      "parameters": [
        {
          "description": "The Calendly user's profile link, from the Get Calendly user profile action. Leave blank to use the connected account.",
          "display_name": "User URI",
          "name": "user_uri",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Number of event types to fetch (default 20).",
          "display_name": "Page size",
          "name": "page_size",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/calendly/list-event-types",
      "result_str_template": "Fetched {calendly_list_event_types,count} event types.",
      "returns": {
        "properties": {
          "count": {
            "description": "Number of event types returned.",
            "type": "number"
          },
          "event_types": {
            "description": "List of event type objects available for the user.",
            "items": {
              "properties": {
                "name": {
                  "description": "Display name of the event type.",
                  "type": "string"
                },
                "scheduling_url": {
                  "description": "Public scheduling URL for this event type.",
                  "type": "string"
                },
                "slug": {
                  "description": "URL-friendly slug for the event type.",
                  "type": "string"
                },
                "uri": {
                  "description": "Event type URI. Use this as event_type_uri when creating scheduling links.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "description": "Always 'success' on successful requests.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_scheduled_events": {
      "description": "List scheduled events for the connected Calendly user.",
      "display_name": "List Calendly scheduled events",
      "display_str_template": "List Calendly scheduled events for '{0}'.",
      "handler": "actions.list_scheduled_events",
      "id": "calendly_list_scheduled_events",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "events": [
          {
            "name": "30 Minute Meeting",
            "start_time": "2026-01-25T10:00:00Z",
            "status": "active",
            "uri": "https://api.calendly.com/scheduled_events/IJKL1234567890"
          }
        ],
        "status": "success"
      },
      "name": "list_scheduled_events",
      "output_formatter": "actions.format_list_scheduled_events_output",
      "parameters": [
        {
          "description": "The Calendly user's profile link, from the Get Calendly user profile action. Leave blank to use the connected account.",
          "display_name": "User URI",
          "name": "user_uri",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Filter scheduled events by status (e.g., active, canceled).",
          "display_name": "Status",
          "name": "status",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/calendly/list-scheduled-events",
      "result_str_template": "Fetched {calendly_list_scheduled_events,count} scheduled events.",
      "returns": {
        "properties": {
          "count": {
            "description": "Number of scheduled events returned.",
            "type": "number"
          },
          "events": {
            "description": "List of scheduled event objects.",
            "items": {
              "properties": {
                "name": {
                  "description": "Name of the scheduled event.",
                  "type": "string"
                },
                "start_time": {
                  "description": "Event start time in ISO 8601 format.",
                  "type": "string"
                },
                "status": {
                  "description": "Event status (e.g., 'active', 'canceled').",
                  "type": "string"
                },
                "uri": {
                  "description": "Event URI (e.g., 'https://api.calendly.com/scheduled_events/ABCD123'). To extract the UUID for cancel_scheduled_event: split the URI by '/' using the Split built-in, then take the last element of the resulting array.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "description": "Always 'success' on successful requests.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect Calendly to list event types, generate scheduling links, and manage events.",
  "display_name": "Calendly",
  "id": "calendly"
}
