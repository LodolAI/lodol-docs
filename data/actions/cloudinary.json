{
  "actions": {
    "upload_image_from_url": {
      "description": "Upload an image to Cloudinary from a web link (URL).",
      "display_name": "Upload image from URL",
      "display_str_template": "Upload image from {0} to Cloudinary.",
      "handler": "actions.upload_image_from_url",
      "id": "cloudinary_upload_image_from_url",
      "method": "POST",
      "mock_response": {
        "bytes": 12345,
        "public_id": "mock_public_id",
        "secure_url": "https://res.cloudinary.com/demo/image/upload/v1234567890/mock_public_id.jpg",
        "tags": [
          "sample"
        ],
        "version": "1234567890"
      },
      "name": "upload_image_from_url",
      "parameters": [
        {
          "description": "The web link (URL) of the image to upload.",
          "display_name": "Image URL",
          "name": "image_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The folder to store the uploaded image in, for example products/photos. If left blank, the image is stored in your main folder.",
          "display_name": "Folder",
          "name": "folder",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A custom name to identify the file in Cloudinary (its public ID). If left blank, Cloudinary generates one automatically.",
          "display_name": "Custom name",
          "name": "public_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Labels to attach to the uploaded image so you can group and find it later in Cloudinary.",
          "display_name": "Tags",
          "name": "tags",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/cloudinary/upload-image",
      "result_str_template": "Uploaded image: {upload_image_from_url,public_id}",
      "returns": {
        "properties": {
          "bytes": {
            "type": "integer"
          },
          "public_id": {
            "type": "string"
          },
          "secure_url": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Upload images to Cloudinary from a web link.",
  "display_name": "Cloudinary",
  "id": "cloudinary"
}
