{
  "actions": {
    "get_article": {
      "description": "Get one HealthCare.gov help article in full, as plain text, with its summary and links. No API key required.",
      "display_name": "Get article",
      "display_str_template": "Get the HealthCare.gov article {0}.",
      "handler": "actions.get_article",
      "id": "healthcare_gov_get_article",
      "method": "POST",
      "mock_response": {
        "keywords": "job-based insurance dependent coverage to age 26 health insurance until age 26 under 26",
        "links": [
          {
            "text": "Learn more about coverage for people under 30.",
            "url": "https://www.healthcare.gov/young-adults/coverage"
          }
        ],
        "path": "turning-26",
        "summary": "Find out what you need to know about getting your own health coverage when you turn 26 and are no longer eligible to stay on your parent's health plan.",
        "text": "If you have health coverage under a parent\u2019s plan and are turning 26, you need to take action. If you don\u2019t, you may have no health coverage. Why bother with health insurance?\nLearn more about coverage for people under 30.",
        "title": "Getting your own health coverage when you turn 26",
        "url": "https://www.healthcare.gov/turning-26/"
      },
      "name": "get_article",
      "parameters": [
        {
          "description": "The article's HealthCare.gov link or address, e.g. turning-26 (Search articles gives it as 'path').",
          "display_name": "Article",
          "examples": [
            {
              "label": "Turning 26",
              "value": "turning-26"
            },
            {
              "label": "Job-based coverage and taxes",
              "value": "https://www.healthcare.gov/taxes/job-based-insurance/"
            }
          ],
          "name": "article",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/healthcare-gov/get-article",
      "result_str_template": "Got '{healthcare_gov_get_article,title}'.",
      "returns": {
        "properties": {
          "keywords": {
            "description": "Search keywords HealthCare.gov gives the article.",
            "type": [
              "string",
              "null"
            ]
          },
          "links": {
            "description": "The links in the text.",
            "items": {
              "properties": {
                "text": {
                  "description": "The link's words.",
                  "type": "string"
                },
                "url": {
                  "description": "Where it goes (a full address).",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "path": {
            "description": "The article's address on HealthCare.gov, e.g. 'turning-26'.",
            "type": "string"
          },
          "summary": {
            "description": "HealthCare.gov's one-sentence summary of the article.",
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "description": "The whole article as plain text, one paragraph or list item a line.",
            "type": "string"
          },
          "title": {
            "description": "The article's title.",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "The article's page, to link to.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_glossary_term": {
      "description": "Get the full HealthCare.gov definition of one health insurance term, in English or Spanish, with its one-sentence summary. No API key required.",
      "display_name": "Get glossary term",
      "display_str_template": "Get the HealthCare.gov definition of {0}.",
      "handler": "actions.get_glossary_term",
      "id": "healthcare_gov_get_glossary_term",
      "method": "POST",
      "mock_response": {
        "date": "2022-05-19",
        "definition": "The amount you pay for your health insurance every month. In addition to your premium, you usually have to pay other costs for your health care, including a deductible, copayments, and coinsurance.",
        "language": "en",
        "slug": "premium",
        "summary": "A monthly amount you pay for coverage whether you get services or not.",
        "title": "Premium",
        "url": "https://www.healthcare.gov/glossary/premium/"
      },
      "name": "get_glossary_term",
      "parameters": [
        {
          "description": "The term (e.g. Premium, or Prima in Spanish) or its HealthCare.gov link.",
          "display_name": "Term",
          "examples": [
            {
              "label": "Premium",
              "value": "Premium"
            },
            {
              "label": "Out-of-pocket maximum",
              "value": "Out-of-pocket maximum/limit"
            }
          ],
          "name": "term",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "en",
          "description": "English or Spanish. English by default.",
          "display_name": "Language",
          "name": "language",
          "options": [
            {
              "label": "English",
              "value": "en"
            },
            {
              "label": "Spanish",
              "value": "es"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/healthcare-gov/get-glossary-term",
      "result_str_template": "{healthcare_gov_get_glossary_term,summary}",
      "returns": {
        "properties": {
          "date": {
            "description": "When the definition was published, as YYYY-MM-DD.",
            "type": [
              "string",
              "null"
            ]
          },
          "definition": {
            "description": "The full definition as plain text, one paragraph or list item a line.",
            "type": "string"
          },
          "language": {
            "description": "'en' for English or 'es' for Spanish.",
            "type": "string"
          },
          "slug": {
            "description": "The term's address on HealthCare.gov, e.g. 'premium'.",
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "description": "The one-sentence definition, e.g. 'A monthly amount you pay for coverage whether you get services or not.'",
            "type": "string"
          },
          "title": {
            "description": "The term, e.g. 'Premium' (or 'Prima' in Spanish).",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "The term's page, to link to.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
