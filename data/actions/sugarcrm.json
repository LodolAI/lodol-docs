  "categories": [
    "CRM & Contacts"
  ],
  "description": "Manage SugarCRM accounts, contacts, leads and tasks with complete-record updates and polling triggers.",
  "display_name": "SugarCRM",
  "id": "sugarcrm",
  "logo": "https://www.lodol.com/app-icons/sugarcrm-icon.svg",
  "triggers": {
    "sugarcrm_new_account_trigger": {
      "description": "Runs for each new account in SugarCRM. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New account",
      "id": "sugarcrm_new_account_trigger",
      "output": {
        "record": "object"
      },
      "parameters": []
    },
    "sugarcrm_new_contact_trigger": {
      "description": "Runs for each new contact in SugarCRM. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New contact",
      "id": "sugarcrm_new_contact_trigger",
      "output": {
        "record": "object"
      },
      "parameters": []
    },
    "sugarcrm_new_lead_trigger": {
      "description": "Runs for each new lead in SugarCRM. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
