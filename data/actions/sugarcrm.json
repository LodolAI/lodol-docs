      "id": "sugarcrm_new_lead_trigger",
      "output": {
        "record": "object"
      },
      "parameters": []
    },
    "sugarcrm_new_or_updated_account_trigger": {
      "description": "Runs for each account added or changed in SugarCRM. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated account",
      "id": "sugarcrm_new_or_updated_account_trigger",
