  "triggers": {
    "servicem8_new_customer_contact_trigger": {
      "description": "Runs for each new customer contact in ServiceM8. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New customer contact",
      "id": "servicem8_new_customer_contact_trigger",
      "output": {
        "record": "object with the fields uuid, company_uuid, first, last, email, phone, mobile, active"
      },
      "parameters": []
    },
    "servicem8_new_customer_trigger": {
      "description": "Runs for each new customer in ServiceM8. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New customer",
      "id": "servicem8_new_customer_trigger",
      "output": {
        "record": "object with the fields uuid, name, email, phone, edit_date, active"
      },
      "parameters": []
    },
    "servicem8_new_job_activity_trigger": {
      "description": "Runs for each new job activity in ServiceM8. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New job activity",
      "id": "servicem8_new_job_activity_trigger",
      "output": {
        "record": "object with the fields uuid, job_uuid, staff_uuid, start_date, end_date, edit_date, active"
      },
      "parameters": []
    },
    "servicem8_new_job_trigger": {
      "description": "Runs for each new job in ServiceM8. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New job",
      "id": "servicem8_new_job_trigger",
      "output": {
        "record": "object with the fields uuid, generated_job_id, status, edit_date, job_description, company_uuid, job_address, active"
      },
      "parameters": []
    },
    "servicem8_updated_customer_trigger": {
      "description": "Runs for each customer added or changed in ServiceM8. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated customer",
      "id": "servicem8_updated_customer_trigger",
      "output": {
        "record": "object with the fields uuid, name, email, phone, edit_date, active"
      },
      "parameters": []
    },
    "servicem8_updated_job_activity_trigger": {
      "description": "Runs for each job activity added or changed in ServiceM8. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New or updated job activity",
      "id": "servicem8_updated_job_activity_trigger",
      "output": {
        "record": "object with the fields uuid, job_uuid, staff_uuid, start_date, end_date, edit_date, active"
      },
      "parameters": []
    },
    "servicem8_updated_job_trigger": {
      "description": "Runs for each job added or changed in ServiceM8. Ones already there when the workflow is turned on start it only when they change. It can watch up to 4,000. How often it checks follows your workspace plan.",
