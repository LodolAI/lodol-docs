{
  "actions": {
    "cancel_meeting": {
      "description": "Cancel a scheduled meeting and let everyone invited know it's off.",
      "display_name": "Cancel meeting",
      "display_str_template": "Cancel the Google Meet meeting '{0}'.",
      "handler": "actions.cancel_meeting",
      "id": "google_meet_cancel_meeting",
      "method": "POST",
      "mock_response": {
        "cancelled": true,
        "event_id": "abc123def456"
      },
      "name": "cancel_meeting",
      "parameters": [
        {
          "description": "The calendar event ID to cancel, as returned by Schedule meeting or List meetings.",
          "display_name": "Event ID",
          "name": "event_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-meet/cancel-meeting",
      "result_str_template": "Google Meet meeting cancelled.",
      "returns": {
        "properties": {
          "cancelled": {
            "description": "Whether the meeting was cancelled.",
            "type": "boolean"
          },
          "event_id": {
            "description": "The meeting that was cancelled.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_meeting": {
      "description": "Look up one scheduled meeting and its Google Meet link.",
      "display_name": "Get meeting",
      "display_str_template": "Get the Google Meet meeting '{0}'.",
      "handler": "actions.get_meeting",
      "id": "google_meet_get_meeting",
      "method": "POST",
      "mock_response": {
        "attendees": [
          "sam@example.com",
          "jane@example.com"
        ],
        "end": "2026-08-03T11:00:00-05:00",
        "event_id": "abc123def456",
        "event_link": "https://calendar.google.com/event?eid=abc123",
        "meeting_link": "https://meet.google.com/abc-defg-hij",
        "start": "2026-08-03T10:00:00-05:00",
        "title": "Team Standup"
      },
      "name": "get_meeting",
      "parameters": [
        {
          "description": "The calendar event ID, as returned by Schedule meeting or List meetings.",
          "display_name": "Event ID",
          "name": "event_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-meet/get-meeting",
      "result_str_template": "Google Meet meeting retrieved.",
      "returns": {
        "properties": {
          "attendees": {
            "description": "Email addresses of everyone invited to the meeting.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "end": {
            "description": "When the meeting ends.",
            "type": "string"
          },
          "event_id": {
            "description": "The ID of the calendar event. Use with Get meeting and Cancel meeting.",
            "type": "string"
          },
          "event_link": {
            "description": "A link to open the meeting in Google Calendar.",
            "type": "string"
          },
          "meeting_link": {
            "description": "The Google Meet link people use to join the call.",
            "type": "string"
          },
          "start": {
            "description": "When the meeting starts.",
            "type": "string"
          },
          "title": {
            "description": "The name of the meeting.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_meetings": {
      "description": "List upcoming meetings on your calendar that have a Google Meet link. Calendar entries with no way to join are left out.",
      "display_name": "List meetings",
      "display_str_template": "List Google Meet meetings.",
      "handler": "actions.list_meetings",
      "id": "google_meet_list_meetings",
      "method": "POST",
      "mock_response": {
        "meetings": [
          {
            "attendees": [
              "sam@example.com",
              "jane@example.com"
            ],
            "end": "2026-08-03T11:00:00-05:00",
            "event_id": "abc123def456",
            "event_link": "https://calendar.google.com/event?eid=abc123",
            "meeting_link": "https://meet.google.com/abc-defg-hij",
            "start": "2026-08-03T10:00:00-05:00",
            "title": "Team Standup"
          }
        ]
      },
      "name": "list_meetings",
      "parameters": [
        {
          "default": 10,
          "description": "How many meetings to return (1-100).",
          "display_name": "Maximum meetings",
          "maximum": 100,
          "minimum": 1,
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional. Only include meetings starting on or after this time, as an ISO 8601 timestamp.",
          "display_name": "Starting from",
          "name": "time_min",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Optional. Only include meetings starting on or before this time, as an ISO 8601 timestamp.",
          "display_name": "Up until",
          "name": "time_max",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/google-meet/list-meetings",
      "result_str_template": "Google Meet meetings retrieved.",
      "returns": {
        "properties": {
          "meetings": {
            "description": "Upcoming meetings that have a Meet link.",
            "items": {
              "properties": {
                "attendees": {
                  "description": "Email addresses of everyone invited to the meeting.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "end": {
                  "description": "When the meeting ends.",
                  "type": "string"
                },
                "event_id": {
                  "description": "The ID of the calendar event. Use with Get meeting and Cancel meeting.",
                  "type": "string"
                },
                "event_link": {
                  "description": "A link to open the meeting in Google Calendar.",
                  "type": "string"
                },
                "meeting_link": {
                  "description": "The Google Meet link people use to join the call.",
                  "type": "string"
                },
                "start": {
                  "description": "When the meeting starts.",
                  "type": "string"
                },
                "title": {
                  "description": "The name of the meeting.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "schedule_meeting": {
      "description": "Create a Google Meet video call and add it to your Google Calendar. Anyone you invite gets a calendar invitation with the link to join.",
      "display_name": "Schedule meeting",
      "display_str_template": "Schedule a Google Meet call titled '{0}'.",
      "handler": "actions.schedule_meeting",
      "id": "google_meet_schedule_meeting",
      "method": "POST",
      "mock_response": {
        "attendees": [
          "sam@example.com",
          "jane@example.com"
        ],
        "end": "2026-08-03T11:00:00-05:00",
        "event_id": "abc123def456",
        "event_link": "https://calendar.google.com/event?eid=abc123",
        "meeting_link": "https://meet.google.com/abc-defg-hij",
        "start": "2026-08-03T10:00:00-05:00",
        "title": "Team Standup"
      },
      "name": "schedule_meeting",
      "parameters": [
        {
          "description": "The name of the meeting, shown on the invite.",
          "display_name": "Title",
          "examples": [
            {
              "label": "Example",
              "value": "Team Standup"
            }
          ],
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the meeting starts, for example 2024-01-15T10:00:00. Set the time zone below, or include an offset like 2024-01-15T10:00:00-05:00.",
          "display_name": "Start date and time",
          "name": "start_date_time",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "When the meeting ends, for example 2024-01-15T11:00:00. Use the same time zone as the start time.",
          "display_name": "End date and time",
          "name": "end_date_time",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The time zone for the start and end times, for example America/New_York. Leave blank to use the times exactly as written.",
          "display_name": "Time zone",
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Notes or an agenda to show on the meeting invite.",
          "display_name": "Description",
          "multiline": true,
          "name": "description",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Email addresses of the people to invite. Each guest gets a calendar invitation with the meeting link.",
          "display_name": "Attendees",
          "name": "attendees",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "An optional place for the meeting, useful when some guests join in person.",
          "display_name": "Location",
          "name": "location",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-meet/schedule-meeting",
      "result_str_template": "Google Meet call scheduled.",
      "returns": {
        "properties": {
          "attendees": {
            "description": "Email addresses of everyone invited to the meeting.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "end": {
            "description": "When the meeting ends.",
            "type": "string"
          },
          "event_id": {
            "description": "The ID of the calendar event. Use with Get meeting and Cancel meeting.",
            "type": "string"
          },
          "event_link": {
            "description": "A link to open the meeting in Google Calendar.",
            "type": "string"
          },
          "meeting_link": {
            "description": "The Google Meet link people use to join the call.",
            "type": "string"
          },
          "start": {
            "description": "When the meeting starts.",
            "type": "string"
          },
          "title": {
            "description": "The name of the meeting.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create Google Meet video calls, send calendar invites, and look up or cancel meetings you've scheduled.",
  "display_name": "Google Meet",
  "id": "google_meet"
}
