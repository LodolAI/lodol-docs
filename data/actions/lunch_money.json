{
  "actions": {
    "get_budgets": {
      "description": "Get what was budgeted and what was actually spent per category over a date range, one figure per month.",
      "display_name": "Get budgets",
      "display_str_template": "Get Lunch Money budgets from {0} to {1}.",
      "handler": "actions.get_budgets",
      "id": "lunch_money_get_budgets",
      "method": "POST",
      "mock_response": {
        "budgets": [
          {
            "archived": false,
            "category_group_name": "Food & Drink",
            "category_id": 83,
            "category_name": "Coffee Shops",
            "exclude_from_budget": false,
            "exclude_from_totals": false,
            "group_id": 12,
            "is_group": false,
            "is_income": false,
            "months": [
              {
                "budget_currency": "usd",
                "budgeted": 60.0,
                "is_automated": false,
                "month": "2024-01-01",
                "num_transactions": 9,
                "spent": 41.25
              }
            ]
          }
        ],
        "count": 1
      },
      "name": "get_budgets",
      "parameters": [
        {
          "description": "The first month to include. Must be the first of a month, as YYYY-MM-01.",
          "display_name": "Start date",
          "name": "start_date",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The last date to include, as YYYY-MM-DD.",
          "display_name": "End date",
          "name": "end_date",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lunch-money/get-budgets",
      "result_str_template": "Found budgets for {lunch_money_get_budgets,count} categories.",
      "returns": {
        "properties": {
          "budgets": {
            "description": "One entry per category.",
            "items": {
              "properties": {
                "archived": {
                  "description": "Whether the category is archived.",
                  "type": "boolean"
                },
                "category_group_name": {
                  "description": "The group the category belongs to, if any.",
                  "type": "string"
                },
                "category_id": {
                  "description": "Category this row is for.",
                  "type": "integer"
                },
                "category_name": {
                  "description": "Category name.",
                  "type": "string"
                },
                "exclude_from_budget": {
                  "description": "Whether the category is left out of budget calculations.",
                  "type": "boolean"
                },
                "exclude_from_totals": {
                  "description": "Whether the category is left out of totals.",
                  "type": "boolean"
                },
                "group_id": {
                  "description": "Category group id, if any.",
                  "type": "integer"
                },
                "is_group": {
                  "description": "Whether this row is a category group.",
                  "type": "boolean"
                },
                "is_income": {
                  "description": "Whether the category is treated as income.",
                  "type": "boolean"
                },
                "months": {
                  "description": "One entry per month in the range asked for. Lunch Money keys these by month; they are turned into a list so they can be looped over.",
                  "items": {
                    "properties": {
                      "budget_currency": {
                        "description": "Currency the budget is set in.",
                        "type": "string"
                      },
                      "budgeted": {
                        "description": "Amount budgeted for the category that month.",
                        "type": "number"
                      },
                      "is_automated": {
                        "description": "Whether Lunch Money set this budget itself.",
                        "type": "boolean"
                      },
                      "month": {
                        "description": "First day of the month, YYYY-MM-01.",
                        "type": "string"
                      },
                      "num_transactions": {
                        "description": "How many transactions made up the spend.",
                        "type": "integer"
                      },
                      "spent": {
                        "description": "Amount spent that month, in the base currency.",
                        "type": "number"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "count": {
            "description": "How many categories were returned.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "insert_transaction": {
      "description": "Add one transaction to Lunch Money and get back the id it was given. Use a negative amount for money spent and a positive amount for money received.",
      "display_name": "Insert a transaction",
      "display_str_template": "Add a {1} transaction to Lunch Money on {0}.",
      "handler": "actions.insert_transaction",
      "id": "lunch_money_insert_transaction",
      "method": "POST",
      "mock_response": {
        "transaction_id": 602
      },
      "name": "insert_transaction",
      "parameters": [
        {
          "description": "The transaction date, as YYYY-MM-DD.",
          "display_name": "Date",
          "name": "date",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The amount, for example -12.50 for money spent or 1500 for money received.",
          "display_name": "Amount",
          "name": "amount",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Who the money went to or came from.",
          "display_name": "Payee",
          "name": "payee",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Which category to file this under. List categories to find the id.",
          "display_name": "Category ID",
          "name": "category_id",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional. Which manually managed account this belongs to. List accounts to find the id.",
          "display_name": "Account ID",
          "name": "asset_id",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Optional. Lowercase ISO currency code, for example usd. Defaults to your Lunch Money primary currency.",
          "display_name": "Currency",
          "name": "currency",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. A free-text note on the transaction.",
          "display_name": "Notes",
          "name": "notes",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. Whether the transaction is settled. Lunch Money defaults to uncleared.",
          "display_name": "Status",
          "name": "status",
          "options": [
            {
              "label": "Cleared",
              "value": "cleared"
            },
            {
              "label": "Uncleared",
              "value": "uncleared"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Optional. Run your Lunch Money rules against the new transaction. Off by default.",
          "display_name": "Apply rules",
          "name": "apply_rules",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/lunch-money/insert-transaction",
      "result_str_template": "Added transaction {lunch_money_insert_transaction,transaction_id}.",
      "returns": {
        "properties": {
          "transaction_id": {
            "description": "The id Lunch Money gave the new transaction. Null if it was skipped as a duplicate.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
