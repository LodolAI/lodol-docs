    "identify_sequence": {
      "description": "Give the OEIS a run of whole numbers and find out what it is. This is what the encyclopedia is for: the counts falling out of a calculation go in, and the sequences that begin that way come back, named and explained. Negative signs count, so a sequence that alternates is never confused with the same numbers made positive. The answer also says plainly whether anything matched, so a workflow can branch on it.",
      "display_name": "Identify a sequence",
      "display_str_template": "Identify the sequence {0} in the OEIS.",
      "handler": "actions.identify_sequence",
