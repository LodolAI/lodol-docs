          {
            "explanation": "Forces browsers to use HTTPS, protecting against protocol-downgrade and cookie-hijacking attacks.",
            "header": "Strict-Transport-Security",
            "present": true,
            "result": "pass",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "explanation": "Prevents the page from being framed by other sites, blocking clickjacking.",
            "header": "X-Frame-Options",
            "present": true,
            "result": "pass",
            "value": "SAMEORIGIN"
          },
          {
            "explanation": "Missing. Full URLs may leak to third parties via the Referer header.",
            "header": "Referrer-Policy",
            "present": false,
            "result": "warn",
            "value": null
          },
          {
            "explanation": "Missing. Embedded content can request powerful features without restriction.",
            "header": "Permissions-Policy",
            "present": false,
            "result": "warn",
            "value": null
          }
        ],
        "final_url": "https://dotnet.microsoft.com/en-us/apps/aspnet",
        "grade": "B",
