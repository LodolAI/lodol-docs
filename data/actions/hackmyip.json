      "method": "POST",
      "mock_response": {
        "checked_at": "2026-10-19T22:41:38.569Z",
        "dmarc": {
          "explanation": "DMARC policy is p=quarantine: spoofed mail is sent to spam. Strong protection \u2014 p=reject is stricter still.",
          "policy": "quarantine",
          "record": "v=DMARC1; p=quarantine; sp=reject; pct=100; fo=1",
          "status": "pass"
        },
        "domain": "github.com",
        "mx": {
          "explanation": "1 mail server configured. The domain can receive email.",
          "mail_servers": [
            {
              "host": "github-com.mail.protection.outlook.com",
              "priority": 0
            }
          ],
          "record": "0 github-com.mail.protection.outlook.com",
          "status": "pass"
        },
        "overall": "pass",
        "spf": {
          "explanation": "SPF ends with ~all (soft fail): mail from unauthorized servers is accepted but flagged. A solid, common policy.",
          "record": "v=spf1 ip4:192.30.252.0/22 include:spf.protection.outlook.com ~all",
          "status": "pass"
        }
      },
