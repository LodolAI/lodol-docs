  "actions": {
    "check_email_authentication": {
      "description": "Check how a domain is set up for email: whether it has mail servers (MX), which servers may send for it (SPF) and what happens to forged mail (DMARC), each with a pass, warn or fail and a plain explanation.",
      "display_name": "Check email domain setup",
      "display_str_template": "Check the email setup of {0}.",
      "handler": "actions.check_email_authentication",
