{
  "actions": {
    "call_tool": {
      "description": "Choose an available Numeric tool and fill its schema-based arguments.",
      "display_name": "Call Numeric tool",
      "display_str_template": "Call Numeric tool.",
      "handler": "actions.call_tool",
      "id": "numeric_call_tool",
      "method": "POST",
      "mock_response": {
        "result": {}
      },
      "name": "call_tool",
      "output_formatter": "_specs.<locals>.<lambda>",
      "parameters": [
        {
          "description": "Choose an available official Numeric tool.",
          "display_name": "Tool",
          "dynamic_source": "tools",
          "name": "tool_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Fill the arguments required by the selected tool. Its live schema is available from List available tools.",
          "display_name": "Arguments",
          "dynamic_source": "arguments",
          "dynamic_source_depends_on": [
            "tool_name"
          ],
          "name": "arguments",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Choose the workspace to use for this action. It is selected in the same MCP session before the tool runs.",
          "display_name": "Workspace",
          "dynamic_source": "workspaces",
          "dynamic_source_allows_custom": true,
          "name": "workspace_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/numeric/call-tool",
      "result_str_template": "Numeric request completed.",
      "returns": {
        "properties": {
          "result": {
            "description": "The complete official Numeric tool result.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
