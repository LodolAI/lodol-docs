{
  "actions": {
    "search": {
      "description": "Search across the data synced into an Airweave collection.",
      "display_name": "Search",
      "display_str_template": "Search Airweave collection {0} for '{1}'.",
      "handler": "actions.search",
      "id": "airweave_search",
      "method": "POST",
      "mock_response": {
        "results": [
          {
            "payload": {
              "content": "Roadmap for the next quarter...",
              "title": "Q4 Planning"
            },
            "score": 0.87
          }
        ]
      },
      "name": "search",
      "parameters": [
        {
          "description": "The Airweave collection to search.",
          "display_name": "Collection",
          "dynamic_source": "collections",
          "name": "collection",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to search for.",
          "display_name": "Query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of results to return.",
          "display_name": "Max results",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/airweave/search",
      "result_str_template": "Found {results,length} results.",
      "returns": {
        "properties": {
          "results": {
            "description": "The matching results.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Search across all the apps and data you've synced into Airweave, so your workflows can retrieve knowledge from one place.",
  "display_name": "Airweave",
  "id": "airweave"
}
