{
  "actions": {
    "check_word_exists": {
      "description": "Check whether the dictionary has an entry for a word. A word that is not in it answers 'no' rather than failing the step, which is what a spell check, a word game or a form validation needs. A word that is in it also comes back with its pronunciation, its parts of speech and its first definition, so a single step can both check and report.",
      "display_name": "Check whether a word exists",
      "display_str_template": "Check whether {word} is a word.",
      "handler": "actions.check_word_exists",
      "id": "free_dictionary_api_check_word_exists",
      "method": "POST",
      "mock_response": {
        "definition_count": 2,
        "entry_count": 1,
        "exists": true,
        "first_definition": "A combination of events which have come together by chance to make a surprisingly good or wonderful outcome.",
        "parts_of_speech": [
          "noun"
        ],
        "phonetic": "/\u02ccs\u025b.\u0279\u0259n.\u02c8d\u026a.p\u026a.ti/",
        "word": "serendipity"
      },
      "name": "check_word_exists",
      "output_formatter": "actions.format_word_exists_output",
      "parameters": [
        {
          "description": "The English word to look up. One word at a time, spelled however you like: the dictionary matches without regard to capitals.",
          "display_name": "Word",
          "examples": [
            {
              "label": "An everyday word",
              "value": "hello"
            },
            {
              "label": "A word with two origins",
              "value": "bass"
            },
            {
              "label": "A longer word",
              "value": "serendipity"
            }
          ],
          "name": "word",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/free-dictionary-api/check-word-exists",
      "result_str_template": "Word exists: {free_dictionary_api_check_word_exists,exists}.",
      "returns": {
        "properties": {
          "definition_count": {
            "type": "integer"
          },
          "entry_count": {
            "type": "integer"
          },
          "exists": {
            "type": "boolean"
          },
          "first_definition": {
            "type": "string"
          },
          "parts_of_speech": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "phonetic": {
            "type": "string"
          },
          "word": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_antonyms": {
