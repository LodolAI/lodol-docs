{
  "actions": {
    "activate_campaign": {
      "description": "Activate (start sending) an Instantly campaign by ID.",
      "display_name": "Activate campaign",
      "display_str_template": "Activate Instantly campaign {0}.",
      "handler": "actions.activate_campaign",
      "id": "instantly_activate_campaign",
      "method": "POST",
      "mock_response": {
        "result": {
          "id": "01890000-0000-7000-a000-000000000001",
          "status": 1
        }
      },
      "name": "activate_campaign",
      "parameters": [
        {
          "description": "Campaign ID to activate.",
          "display_name": "Campaign ID",
          "name": "campaign_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/instantly/activate-campaign",
      "result_str_template": "Campaign activated.",
      "returns": {
        "description": "Response envelope; the payload is in the \"result\" field.",
        "properties": {
          "result": {
            "properties": {
              "id": {
                "description": "Campaign ID.",
                "type": "string"
              },
              "status": {
                "description": "Campaign status code after activation.",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_campaign": {
      "description": "Create a new cold email campaign with a default sending schedule.",
      "display_name": "Create campaign",
      "display_str_template": "Create Instantly campaign '{0}'.",
      "handler": "actions.create_campaign",
      "id": "instantly_create_campaign",
      "method": "POST",
      "mock_response": {
        "result": {
          "id": "01890000-0000-7000-a000-000000000001",
          "name": "Q1 Outbound",
          "status": 0
        }
      },
      "name": "create_campaign",
      "parameters": [
        {
          "description": "A name for the new campaign.",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "09:00",
          "description": "Time of day to start sending each day, in 24-hour HH:MM format. Defaults to 09:00.",
          "display_name": "Daily start time",
          "name": "timing_from",
          "required": false,
          "type": "ParameterType.TIME"
        },
        {
          "default": "17:00",
          "description": "Time of day to stop sending each day, in 24-hour HH:MM format. Defaults to 17:00.",
          "display_name": "Daily end time",
          "name": "timing_to",
          "required": false,
          "type": "ParameterType.TIME"
        },
        {
          "default": "America/Detroit",
          "description": "Time zone the daily sending times are based on. Defaults to US Eastern time.",
          "display_name": "Time zone",
          "name": "timezone",
          "options": [
            {
              "label": "US Eastern (Detroit)",
              "value": "America/Detroit"
            },
            {
              "label": "US Central (Chicago)",
              "value": "America/Chicago"
            },
            {
              "label": "US Mountain (Boise)",
              "value": "America/Boise"
            },
            {
              "label": "US Mountain, no DST (Creston)",
              "value": "America/Creston"
            },
            {
              "label": "US Pacific (Dawson)",
              "value": "America/Dawson"
            },
            {
              "label": "US Alaska (Anchorage)",
              "value": "America/Anchorage"
            },
            {
              "label": "UK (Isle of Man)",
              "value": "Europe/Isle_of_Man"
            },
            {
              "label": "Central Europe (Belgrade)",
              "value": "Europe/Belgrade"
            },
            {
              "label": "India (Kolkata)",
              "value": "Asia/Kolkata"
            },
            {
              "label": "Australia (Melbourne)",
              "value": "Australia/Melbourne"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": [
            1,
            2,
            3,
            4,
            5
          ],
          "description": "Days of the week to send on, as numbers from 0 (Sunday) to 6 (Saturday). Defaults to Monday\u2013Friday.",
          "display_name": "Sending days",
          "name": "days",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/instantly/create-campaign",
      "result_str_template": "Campaign created.",
      "returns": {
        "description": "Response envelope; the payload is in the \"result\" field.",
        "properties": {
          "result": {
            "properties": {
              "id": {
                "description": "Created campaign ID.",
                "type": "string"
              },
              "name": {
                "description": "Campaign name.",
                "type": "string"
              },
              "status": {
                "description": "Campaign status code.",
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "create_lead": {
      "description": "Add a lead to an Instantly campaign or lead list.",
      "display_name": "Create lead",
      "display_str_template": "Add Instantly lead {0}.",
      "handler": "actions.create_lead",
      "id": "instantly_create_lead",
      "method": "POST",
      "mock_response": {
        "result": {
          "campaign": "01890000-0000-7000-a000-000000000001",
          "email": "jane@example.com",
          "id": "01890000-0000-7000-b000-000000000001"
        }
      },
      "name": "create_lead",
      "parameters": [
        {
          "description": "Lead email address. Required when adding to a campaign; optional when adding to a lead list as long as a first or last name is provided.",
          "display_name": "Email",
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the campaign to add the lead to.",
          "display_name": "Campaign ID",
          "name": "campaign_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the lead list to add the lead to.",
          "display_name": "List ID",
          "name": "list_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Lead first name.",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Lead last name.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Lead company name.",
          "display_name": "Company name",
          "name": "company_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Lead phone number.",
          "display_name": "Phone",
          "name": "phone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Lead website URL.",
          "display_name": "Website",
          "name": "website",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Personalization snippet used in the first email.",
          "display_name": "Personalization",
          "name": "personalization",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Extra fields to save on the lead, as name and value pairs. Each value can be text, a number, true/false, or empty (no nested lists or groups).",
          "display_name": "Custom variables",
          "name": "custom_variables",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/instantly/create-lead",
      "result_str_template": "Lead created.",
      "returns": {
        "description": "Response envelope; the payload is in the \"result\" field.",
        "properties": {
          "result": {
            "properties": {
              "campaign": {
                "description": "Campaign ID the lead belongs to.",
                "type": "string"
              },
              "email": {
                "description": "Lead email address.",
                "type": "string"
              },
              "id": {
                "description": "Created lead ID.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
