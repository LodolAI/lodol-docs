    "get_campaign_analytics": {
      "description": "Retrieve analytics for one or all campaigns over an optional date range.",
      "display_name": "Get campaign analytics",
      "display_str_template": "Get Instantly campaign analytics.",
      "handler": "actions.get_campaign_analytics",
      "id": "instantly_get_campaign_analytics",
      "method": "POST",
      "mock_response": {
        "result": [
          {
            "campaign_id": "01890000-0000-7000-a000-000000000001",
            "emails_sent_count": 480,
            "leads_count": 500,
            "open_count": 240,
            "reply_count": 32
          }
        ]
      },
      "name": "get_campaign_analytics",
      "parameters": [
        {
          "description": "Campaign ID to get analytics for. Leave empty to include all campaigns.",
          "display_name": "Campaign ID",
          "name": "campaign_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Start date (YYYY-MM-DD).",
          "display_name": "Start date",
          "name": "start_date",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "End date (YYYY-MM-DD).",
          "display_name": "End date",
          "name": "end_date",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/instantly/get-campaign-analytics",
      "result_str_template": "Analytics retrieved.",
      "returns": {
        "properties": {
          "result": {
            "description": "Per-campaign analytics rows.",
            "items": {
              "properties": {
                "campaign_id": {
                  "description": "Campaign ID.",
                  "type": "string"
                },
                "emails_sent_count": {
                  "description": "Number of emails sent.",
                  "type": "integer"
                },
                "leads_count": {
                  "description": "Total leads in the campaign.",
                  "type": "integer"
                },
                "open_count": {
                  "description": "Number of opens.",
                  "type": "integer"
                },
                "reply_count": {
                  "description": "Number of replies.",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_accounts": {
