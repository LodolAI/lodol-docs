        {
          "description": "The first position to read. Defaults to 0, the first item.",
          "display_name": "From position",
          "name": "start",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The last position to read. Defaults to -1, the last item.",
          "display_name": "To position",
          "name": "stop",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/redis/get-list-items",
      "result_str_template": "Read {redis_get_list_items,count} item(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many items were read",
            "type": "number"
          },
          "items": {
            "description": "The items, in list order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "key": {
            "description": "The key",
            "type": "string"
          },
          "length": {
            "description": "How many items the whole list has",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_set_members": {
