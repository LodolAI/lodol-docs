{
  "actions": {
    "add_stream_entry": {
      "description": "Append an entry of named fields to a stream, a log that keeps every entry in order. Creates the stream if needed.",
      "display_name": "Add stream entry",
      "display_str_template": "Add an entry to stream {0} in Redis.",
      "handler": "actions.add_stream_entry",
      "id": "redis_add_stream_entry",
      "method": "POST",
      "mock_response": {
        "id": "1712345678901-0",
        "length": 12,
        "stream": "events:orders"
      },
      "name": "add_stream_entry",
      "output_formatter": "actions.format_add_stream_entry",
      "parameters": [
        {
          "description": "The key of the stream, such as events:orders.",
          "display_name": "Stream",
          "examples": [
            {
              "label": "A stream",
              "value": "events:orders"
            }
          ],
          "name": "stream",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Each field's name with its value. Objects and lists are stored as JSON.",
          "display_name": "Fields",
          "name": "fields",
          "object_key_name": "Field",
          "required": true,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Trim the stream to roughly this many of its newest entries. Leave empty to keep every entry.",
          "display_name": "Keep about",
          "minimum": 1,
          "name": "max_length",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/redis/add-stream-entry",
      "result_str_template": "Added entry {redis_add_stream_entry,id}.",
      "returns": {
        "properties": {
          "id": {
            "description": "The new entry's ID, such as 1712345678901-0",
            "type": "string"
          },
          "length": {
            "description": "How many entries the stream has now",
            "type": "number"
          },
          "stream": {
            "description": "The stream",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "add_to_set": {
      "description": "Add members to a set, a collection without repeats. A member already in it is not added twice.",
      "display_name": "Add to set",
      "display_str_template": "Add to set {0} in Redis.",
      "handler": "actions.add_to_set",
      "id": "redis_add_to_set",
      "method": "POST",
      "mock_response": {
        "added_count": 1,
        "key": "tags:featured",
        "size": 4
      },
      "name": "add_to_set",
      "output_formatter": "actions.format_add_to_set",
      "parameters": [
        {
          "description": "The key of the set, such as tags:featured.",
          "display_name": "Set",
          "examples": [
            {
              "label": "A set",
              "value": "tags:featured"
            }
          ],
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The values, one per item.",
          "display_name": "Members",
          "item_by_item": true,
          "name": "members",
          "required": true,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/redis/add-to-set",
      "result_str_template": "Added {redis_add_to_set,added_count} member(s).",
      "returns": {
        "properties": {
          "added_count": {
            "description": "Members that were new",
            "type": "number"
          },
          "key": {
            "description": "The key",
            "type": "string"
          },
          "size": {
            "description": "How many members the set has now",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "check_key": {
      "description": "Find out whether a key exists, what kind of value it holds (string, list, hash, set, sorted set or stream) and when it expires.",
      "display_name": "Check key",
      "display_str_template": "Check key {0} in Redis.",
      "handler": "actions.check_key",
      "id": "redis_check_key",
      "method": "POST",
      "mock_response": {
        "exists": true,
        "expires_in_seconds": null,
        "key": "order:1042",
        "type": "string"
      },
      "name": "check_key",
      "output_formatter": "actions.format_check_key",
      "parameters": [
        {
          "description": "The key's name, such as order:1042.",
          "display_name": "Key",
          "examples": [
            {
              "label": "A key",
              "value": "order:1042"
            }
          ],
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/redis/check-key",
      "result_str_template": "Key checked.",
      "returns": {
        "properties": {
          "exists": {
            "description": "True when the key exists",
            "type": "boolean"
          },
          "expires_in_seconds": {
            "description": "Seconds until the key expires; empty when it never does",
            "nullable": true,
            "type": "number"
          },
          "key": {
            "description": "The key",
            "type": "string"
          },
          "type": {
            "description": "string, list, hash, set, zset or stream",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "delete_hash_fields": {
      "description": "Remove named fields from a hash. The hash is deleted once it has none.",
      "display_name": "Delete hash fields",
      "display_str_template": "Delete fields of hash {0} in Redis.",
      "handler": "actions.delete_hash_fields",
      "id": "redis_delete_hash_fields",
      "method": "POST",
      "mock_response": {
        "deleted_count": 1,
        "key": "customer:42"
      },
      "name": "delete_hash_fields",
      "output_formatter": "actions.format_deleted_fields",
      "parameters": [
        {
          "description": "The key of the hash, such as customer:42.",
          "display_name": "Hash",
          "examples": [
            {
              "label": "A hash",
              "value": "customer:42"
            }
          ],
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The fields to remove, one per item.",
          "display_name": "Fields",
          "item_by_item": true,
          "name": "fields",
          "required": true,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/redis/delete-hash-fields",
      "result_str_template": "Removed {redis_delete_hash_fields,deleted_count} field(s).",
      "returns": {
        "properties": {
          "deleted_count": {
            "description": "How many fields were removed",
            "type": "number"
          },
          "key": {
            "description": "The key",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "delete_keys": {
      "description": "Delete one or more keys, whatever they hold. Missing keys are skipped.",
      "display_name": "Delete keys",
      "display_str_template": "Delete keys {0} from Redis.",
      "handler": "actions.delete_keys",
      "id": "redis_delete_keys",
      "method": "POST",
      "mock_response": {
        "deleted_count": 1,
        "keys": [
          "order:1042"
        ]
      },
      "name": "delete_keys",
      "output_formatter": "actions.format_delete_keys",
      "parameters": [
        {
          "description": "The keys to delete, one per item.",
          "display_name": "Keys",
          "item_by_item": true,
          "name": "keys",
          "required": true,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/redis/delete-keys",
      "result_str_template": "Deleted {redis_delete_keys,deleted_count} key(s).",
      "returns": {
        "properties": {
          "deleted_count": {
            "description": "How many of them existed and were deleted",
            "type": "number"
          },
          "keys": {
            "description": "The keys asked for",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "find_keys": {
      "description": "List the keys whose names match a pattern, such as order:* for every key starting order:. Safe on a busy server: Redis is read in small steps.",
      "display_name": "Find keys",
      "display_str_template": "Find keys in Redis.",
      "handler": "actions.find_keys",
      "id": "redis_find_keys",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "has_more": false,
        "keys": [
          "order:1041",
          "order:1042"
        ],
        "pattern": "order:*"
      },
      "name": "find_keys",
      "output_formatter": "actions.format_find_keys",
      "parameters": [
        {
          "description": "* matches any text and ? one character. Leave empty for every key.",
          "display_name": "Pattern",
          "examples": [
            {
              "label": "Keys starting order:",
              "value": "order:*"
            }
          ],
          "name": "pattern",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The most keys to return, up to 1000. Defaults to 100.",
          "display_name": "Limit",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/redis/find-keys",
      "result_str_template": "Found {redis_find_keys,count} key(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many were returned",
            "type": "number"
          },
          "has_more": {
            "description": "True when more keys match than were returned",
            "type": "boolean"
          },
          "keys": {
            "description": "The matching keys, in name order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pattern": {
            "description": "The pattern matched",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_hash_fields": {
      "description": "Read every field of a hash, or only the ones named.",
      "display_name": "Get hash fields",
      "display_str_template": "Get fields of hash {0} from Redis.",
      "handler": "actions.get_hash_fields",
      "id": "redis_get_hash_fields",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "fields": {
          "name": "Ada",
          "plan": "pro"
        },
        "found": true,
        "key": "customer:42"
      },
      "name": "get_hash_fields",
      "output_formatter": "actions.format_get_hash",
      "parameters": [
        {
          "description": "The key of the hash, such as customer:42.",
          "display_name": "Hash",
          "examples": [
            {
              "label": "A hash",
              "value": "customer:42"
            }
          ],
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only these fields, one per item. Leave empty for all of them.",
          "display_name": "Fields",
          "item_by_item": true,
          "name": "fields",
          "required": false,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/redis/get-hash-fields",
      "result_str_template": "Read {redis_get_hash_fields,count} field(s).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many fields were read",
            "type": "number"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Each field's name and value",
            "type": "object"
          },
          "found": {
            "description": "True when any of the fields exist",
            "type": "boolean"
          },
          "key": {
            "description": "The key",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_list_items": {
      "description": "Read a list's items by position without removing them. Positions start at 0; -1 is the last item.",
      "display_name": "Get list items",
      "display_str_template": "Get items of list {0} from Redis.",
      "handler": "actions.get_list_items",
      "id": "redis_get_list_items",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "items": [
          "job-17",
          "job-18"
        ],
        "key": "jobs:pending",
        "length": 2
      },
      "name": "get_list_items",
      "output_formatter": "actions.format_list_items",
      "parameters": [
        {
          "description": "The key of the list, such as jobs:pending.",
          "display_name": "List",
          "examples": [
            {
              "label": "A list",
              "value": "jobs:pending"
            }
          ],
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
