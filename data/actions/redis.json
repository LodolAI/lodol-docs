            "type": "boolean"
          },
          "key": {
            "description": "The key",
            "type": "string"
          },
          "members": {
            "description": "The members, in name order",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "get_value": {
      "description": "Read the text stored under a key, and how long until it expires. A missing key comes back with 'found' false rather than failing.",
      "display_name": "Get value",
      "display_str_template": "Get the value of {0} from Redis.",
      "handler": "actions.get_value",
      "id": "redis_get_value",
      "method": "POST",
      "mock_response": {
        "expires_in_seconds": 3540,
        "found": true,
        "key": "order:1042",
        "value": "{\"status\": \"paid\"}"
      },
      "name": "get_value",
      "output_formatter": "actions.format_get_value",
      "parameters": [
        {
          "description": "The key's name, such as order:1042.",
          "display_name": "Key",
          "examples": [
            {
              "label": "A key",
              "value": "order:1042"
            }
          ],
          "name": "key",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/redis/get-value",
      "result_str_template": "Value read.",
      "returns": {
        "properties": {
          "expires_in_seconds": {
            "description": "Seconds until the key expires; empty when it never does",
            "nullable": true,
            "type": "number"
          },
          "found": {
            "description": "True when the key holds a value",
            "type": "boolean"
          },
          "key": {
            "description": "The key",
            "type": "string"
          },
          "value": {
            "description": "The text stored; empty when the key is missing",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "increment": {
      "description": "Add to the number stored under a key and get the new number. A missing key starts at 0. Use a negative amount to count down.",
