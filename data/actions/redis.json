    "publish_message": {
      "description": "Send a message to a channel. Only programs subscribed at that moment receive it; nothing is kept. To keep messages, add them to a stream.",
      "display_name": "Publish message",
      "display_str_template": "Publish to channel {0} in Redis.",
      "handler": "actions.publish_message",
      "id": "redis_publish_message",
      "method": "POST",
      "mock_response": {
        "channel": "notifications",
        "receivers": 2
      },
      "name": "publish_message",
      "output_formatter": "actions.format_publish",
      "parameters": [
        {
          "description": "The channel's name, such as notifications.",
          "display_name": "Channel",
          "name": "channel",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The message. An object is sent as JSON.",
          "display_name": "Message",
          "multiline": true,
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/redis/publish-message",
      "result_str_template": "Received by {redis_publish_message,receivers} subscriber(s).",
      "returns": {
        "properties": {
          "channel": {
            "description": "The channel",
            "type": "string"
          },
          "receivers": {
            "description": "How many subscribers received it",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
