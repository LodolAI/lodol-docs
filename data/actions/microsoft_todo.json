  "categories": [
    "To-Do Lists",
    "Microsoft"
  ],
  "description": "Create, update, and organize tasks and task lists in Microsoft To Do.",
  "display_name": "Microsoft To Do",
  "id": "microsoft_todo",
  "logo": "https://www.lodol.com/app-icons/microsoft-todo-icon.svg",
  "triggers": {
    "microsoft_todo_new_task_trigger": {
      "description": "Runs for each new task added to a Microsoft To Do list, with its title, note and due date. Tasks already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New task",
      "id": "microsoft_todo_new_task_trigger",
      "output": {
        "created_at": "string",
        "due": "string",
        "importance": "string",
        "list_id": "string",
        "note": "string",
        "status": "string",
        "task_id": "string",
        "title": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The task list to watch.",
          "display_name": "List",
          "name": "list_id",
          "required": true
        }
      ]
    },
    "microsoft_todo_task_changed_trigger": {
      "description": "Runs each time a task in a Microsoft To Do list changes, such as its title, note, due date, importance or status, and when a task is added. Changes made before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Task changed",
      "id": "microsoft_todo_task_changed_trigger",
      "output": {
        "changed_at": "When it was last changed.",
        "completed_at": "When it was completed, empty until then.",
        "created_at": "string",
        "due": "string",
        "importance": "low, normal or high.",
        "list_id": "string",
        "note": "string",
        "status": "notStarted, inProgress, completed, waitingOnOthers or deferred.",
        "task_id": "string",
        "title": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The task list to watch.",
          "display_name": "List",
          "name": "list_id",
          "required": true
        }
      ]
    },
    "microsoft_todo_task_completed_trigger": {
      "description": "Runs when a task in a Microsoft To Do list is marked completed, with its title, note and when it was completed. A task reopened and completed again runs it again. Tasks completed before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Task completed",
      "id": "microsoft_todo_task_completed_trigger",
      "output": {
        "changed_at": "When it was last changed.",
        "completed_at": "When it was completed, empty until then.",
        "created_at": "string",
        "due": "string",
        "importance": "low, normal or high.",
        "list_id": "string",
        "note": "string",
        "status": "notStarted, inProgress, completed, waitingOnOthers or deferred.",
        "task_id": "string",
        "title": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The task list to watch.",
          "display_name": "List",
          "name": "list_id",
          "required": true
        }
      ]
    }
  }
}
