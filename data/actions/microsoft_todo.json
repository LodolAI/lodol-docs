{
  "actions": {
    "complete_task": {
      "description": "Mark a task as completed in Microsoft To Do.",
      "display_name": "Complete task",
      "display_str_template": "Complete task {1}",
      "handler": "actions.complete_task",
      "id": "microsoft_todo_complete_task",
      "method": "POST",
      "mock_response": {
        "list_id": "list123",
        "result": {
          "status": "completed"
        },
        "task_id": "task123"
      },
      "name": "complete_task",
      "parameters": [
        {
          "description": "The task list ID.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The task ID to complete.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-todo/complete-task",
      "result_str_template": "Task completed.",
      "returns": {
        "properties": {
          "list_id": {
            "description": "The list ID.",
            "type": "string"
          },
          "result": {
            "description": "The updated task.",
            "type": "object"
          },
          "task_id": {
            "description": "The task ID.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_task": {
      "description": "Create a new task in Microsoft To Do.",
      "display_name": "Create task",
      "display_str_template": "Create task '{1}'",
      "handler": "actions.create_task",
      "id": "microsoft_todo_create_task",
      "method": "POST",
      "mock_response": {
        "list_id": "list123",
        "task": {
          "id": "task123",
          "title": "New Task"
        }
      },
      "name": "create_task",
      "parameters": [
        {
          "description": "The ID of the To Do list to add the task to.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Task title.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional task note.",
          "display_name": "Body",
          "multiline": true,
          "name": "body",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional due date and time, for example 2026-07-15T09:00:00.",
          "display_name": "Due date and time",
          "name": "due_datetime",
          "required": false,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Time zone for the due date and time.",
          "display_name": "Time zone",
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Task importance: low, normal, or high.",
          "display_name": "Importance",
          "name": "importance",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-todo/create-task",
      "result_str_template": "Task created.",
      "returns": {
        "properties": {
          "list_id": {
            "description": "The list ID.",
            "type": "string"
          },
          "task": {
            "description": "The created task.",
            "properties": {
              "id": {
                "description": "Task ID. Use as task_id in complete_task or update_task_due_date.",
                "type": "string"
              },
              "title": {
                "description": "Task title.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_task_lists": {
      "description": "List all task lists in Microsoft To Do.",
      "display_name": "List task lists",
      "display_str_template": "List task lists",
      "handler": "actions.list_task_lists",
      "id": "microsoft_todo_list_task_lists",
      "method": "POST",
      "mock_response": {
        "lists": [
          {
            "displayName": "My Tasks",
            "id": "list123"
          }
        ]
      },
      "name": "list_task_lists",
      "parameters": [
        {
          "description": "Optional maximum number of task lists to return.",
          "display_name": "Maximum results",
          "name": "top",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/microsoft-todo/list-task-lists",
      "result_str_template": "Task lists listed.",
      "returns": {
        "properties": {
          "lists": {
            "description": "List of task lists.",
            "items": {
              "properties": {
                "displayName": {
                  "description": "The task list display name.",
                  "type": "string"
                },
                "id": {
                  "description": "Task list ID. Use as list_id in other Microsoft To Do actions.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_tasks": {
      "description": "List tasks in a Microsoft To Do task list.",
      "display_name": "List tasks",
      "display_str_template": "List tasks in list {0}",
      "handler": "actions.list_tasks",
      "id": "microsoft_todo_list_tasks",
      "method": "POST",
      "mock_response": {
        "list_id": "list123",
        "tasks": [
          {
            "id": "task1",
            "title": "Task 1"
          }
        ]
      },
      "name": "list_tasks",
      "parameters": [
        {
          "description": "The ID of the list to get tasks from.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional maximum number of tasks to return.",
          "display_name": "Maximum results",
          "name": "top",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/microsoft-todo/list-tasks",
      "result_str_template": "Tasks listed.",
      "returns": {
        "properties": {
          "list_id": {
            "description": "The list ID.",
            "type": "string"
          },
          "tasks": {
            "description": "List of tasks.",
            "items": {
              "properties": {
                "id": {
                  "description": "Task ID. Use as task_id in complete_task or update_task_due_date.",
                  "type": "string"
                },
                "title": {
                  "description": "Task title.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "update_task_due_date": {
      "description": "Update the due date of a task in Microsoft To Do.",
      "display_name": "Update task due date",
      "display_str_template": "Update due date for task {1}",
      "handler": "actions.update_task_due_date",
      "id": "microsoft_todo_update_task_due_date",
      "method": "POST",
      "mock_response": {
        "list_id": "list123",
        "result": {
          "dueDateTime": {
            "dateTime": "2024-12-31T23:59:59",
            "timeZone": "UTC"
          }
        },
        "task_id": "task123"
      },
      "name": "update_task_due_date",
      "parameters": [
        {
          "description": "The task list ID.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The task ID to update.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "New due date and time, for example 2026-07-15T09:00:00.",
          "display_name": "Due date and time",
          "name": "due_datetime",
          "required": true,
          "type": "ParameterType.DATETIME"
        },
        {
          "description": "Time zone for the due date and time (defaults to UTC).",
          "display_name": "Time zone",
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-todo/update-task-due-date",
      "result_str_template": "Task due date updated.",
      "returns": {
        "properties": {
          "list_id": {
            "description": "The list ID.",
            "type": "string"
          },
          "result": {
            "description": "The updated task.",
            "type": "object"
          },
          "task_id": {
            "description": "The task ID.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Create, update, and organize tasks and task lists in Microsoft To Do.",
  "display_name": "Microsoft To Do",
  "id": "microsoft_todo"
}
