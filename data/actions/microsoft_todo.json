        "list_id": "list123",
        "task_id": "task123"
      },
      "name": "delete_task",
      "parameters": [
        {
          "description": "The task list. Pick it from your lists, or use one an earlier step found.",
          "display_name": "List",
          "dynamic_source": "task_lists",
          "dynamic_source_allows_custom": true,
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The task, from an earlier step such as 'Create task', 'List tasks' or the 'New task' trigger.",
          "display_name": "Task",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/microsoft-todo/delete-task",
      "result_str_template": "Task deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Whether the task was deleted.",
            "type": "boolean"
          },
          "list_id": {
            "description": "The list ID.",
            "type": "string"
          },
          "task_id": {
            "description": "The task ID.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
