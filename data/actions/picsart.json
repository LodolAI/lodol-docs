    "apply_makeup": {
      "description": "Add virtual makeup to a portrait: lipstick, eye looks, blush or a full styled look. Picsart charges for each image.",
      "display_name": "Apply makeup",
      "display_str_template": "Apply makeup.",
      "handler": "documented_provider._handler.<locals>.handle",
      "id": "picsart_apply_makeup",
      "method": "POST",
      "mock_response": {
        "data": {
          "credits": 1,
          "image_url": "example",
          "image_urls": [
            "example"
          ],
          "job_id": "example",
          "status": "example"
        }
      },
      "name": "apply_makeup",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "A public link to the photo, such as one from an earlier step. Picsart downloads it, so it must open without signing in.",
          "display_name": "Image URL",
          "name": "image_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The look to apply, such as 'soft pink lipstick and light blush'.",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to keep out of the result, such as text, watermarks or blur.",
          "display_name": "Avoid",
          "name": "avoid",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/picsart/apply-makeup",
      "result_str_template": "Apply makeup completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response from Picsart.",
            "properties": {
              "credits": {
                "description": "What Picsart charged for the job, when it says.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "image_url": {
                "description": "Link to the finished image. Empty until the job is done.",
                "type": "string"
              },
              "image_urls": {
                "description": "Links to every image the job made.",
                "items": {
                  "description": "An entry from the response.",
                  "type": "string"
                },
                "minItems": 0,
                "type": "array"
              },
              "job_id": {
                "description": "The Picsart job that made the image.",
                "type": "string"
              },
              "status": {
                "description": "Where the job is: ACCEPTED, IN_PROGRESS, COMPLETED or FAILED.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
