          "Bills",
          "To pay"
        ],
        "title": "Electricity bill October 2026"
      },
      "name": "add_tag",
      "output_formatter": "actions.format_document",
      "parameters": [
        {
          "description": "The document's number, from 'Search documents' or the trigger, or its link.",
          "display_name": "Document",
          "name": "document",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The tag.",
          "display_name": "Tag",
