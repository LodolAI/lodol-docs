        "archive_serial_number": 0,
        "content": "City Power & Light. Amount due: $84.20 by 15 November 2026.",
        "correspondent": "City Power & Light",
        "created": "2026-10-21",
        "document_type": "Invoice",
        "file_name": "bill-2026-10.pdf",
        "id": 412,
        "link": "https://paperless.example.com/documents/412/details",
        "notes": 0,
        "snippet": "",
