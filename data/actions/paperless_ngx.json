          },
          "archive_serial_number": {
            "description": "Its archive serial number; 0 if none",
            "type": "number"
          },
          "content": {
            "description": "Its text, as Paperless read it; cut short in a search",
            "type": "string"
          },
          "correspondent": {
            "description": "Who it's from",
            "type": "string"
          },
          "created": {
            "description": "The date on it (YYYY-MM-DD)",
            "type": "string"
          },
          "document_type": {
            "description": "What kind of document it is",
            "type": "string"
          },
          "file_name": {
            "description": "The name of the file it came from",
            "type": "string"
          },
          "id": {
            "description": "The document's number",
            "type": "number"
          },
          "link": {
            "description": "A link to it in Paperless",
            "type": "string"
          },
          "notes": {
            "description": "How many notes it has",
            "type": "number"
          },
          "snippet": {
            "description": "In a search by words, where they matched",
            "type": "string"
          },
          "tag_ids": {
            "description": "Its tags, by number",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "tags": {
            "description": "Its tags, by name",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "description": "Its title",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
