{
  "actions": {
    "add_note": {
      "description": "Add a note to a document, shown beside it in Paperless.",
      "display_name": "Add note",
      "display_str_template": "Note on Paperless document {0}.",
      "handler": "actions.add_note",
      "id": "paperless_ngx_add_note",
      "method": "POST",
      "mock_response": {
        "document_id": 412,
        "note": "Paid on 3 November",
        "notes": 1
      },
      "name": "add_note",
      "output_formatter": "actions.format_note",
      "parameters": [
        {
          "description": "The document's number, from 'Search documents' or the trigger, or its link.",
          "display_name": "Document",
          "name": "document",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to note, such as Paid on 3 November.",
          "display_name": "Note",
          "multiline": true,
          "name": "note",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/paperless-ngx/add-note",
      "result_str_template": "Note added.",
      "returns": {
        "properties": {
          "document_id": {
            "description": "The document's number",
            "type": "number"
          },
          "note": {
            "description": "The note added",
            "type": "string"
          },
          "notes": {
            "description": "How many notes it has now",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "add_tag": {
      "description": "Put a tag on a document.",
      "display_name": "Add tag",
      "display_str_template": "Tag Paperless document {0} with {1}.",
