          "dynamic_source_allows_custom": true,
          "name": "tag",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/paperless-ngx/add-tag",
      "result_str_template": "Tag added.",
      "returns": {
        "properties": {
          "added": {
            "description": "When it was added to Paperless (ISO 8601)",
