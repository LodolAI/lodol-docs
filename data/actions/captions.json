  "triggers": {
    "captions_new_video_trigger": {
      "description": "Runs for each new video in Captions. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New video",
      "id": "captions_new_video_trigger",
      "output": {
        "record": "object with the fields id, object, status, created_at, completed_at, progress, error.code, error.message, model, generation_mode, aspect_ratio, source_video_id, caption_template_id, video_id"
      },
      "parameters": []
    },
    "captions_video_completed_trigger": {
      "description": "Runs each time a video is completed in Captions. Ones completed before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Video completed",
      "id": "captions_video_completed_trigger",
      "output": {
        "record": "object with the fields id, object, status, created_at, completed_at, progress, error.code, error.message, model, generation_mode, aspect_ratio, source_video_id, caption_template_id, video_id"
      },
      "parameters": []
    },
    "captions_video_failed_trigger": {
      "description": "Runs each time a video is failed in Captions. Ones failed before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Video failed",
      "id": "captions_video_failed_trigger",
      "output": {
        "record": "object with the fields id, object, status, created_at, completed_at, progress, error.code, error.message, model, generation_mode, aspect_ratio, source_video_id, caption_template_id, video_id"
