    "get_user": {
      "description": "Look up a Lichess player's public profile, ratings, and win/loss record.",
      "display_name": "Get a player",
      "display_str_template": "Get the Lichess player '{0}'.",
      "handler": "actions.get_user",
      "id": "lichess_get_user",
      "method": "POST",
      "mock_response": {
        "draws": 683,
        "losses": 4558,
        "ratings": {
          "blitz": 1018,
          "bullet": 1076,
          "rapid": 1056
        },
        "title": "",
        "total_games": 9824,
        "url": "https://lichess.org/@/Mary",
        "user_id": "mary",
        "username": "Mary",
        "wins": 4583
      },
      "name": "get_user",
      "parameters": [
        {
          "description": "The Lichess username, for example 'DrNykterstein'.",
          "display_name": "Username",
          "name": "username",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/lichess/get-user",
      "result_str_template": "Lichess player retrieved.",
      "returns": {
        "properties": {
          "draws": {
            "description": "Games drawn",
            "type": "number"
          },
          "losses": {
            "description": "Games lost",
            "type": "number"
          },
          "ratings": {
            "description": "Current rating per speed and variant -- for example {'blitz': 1018, 'rapid': 1056}",
            "type": "object"
          },
          "title": {
            "description": "The player's chess title such as 'GM' or 'IM', or empty if they have none",
            "type": "string"
          },
          "total_games": {
            "description": "How many games the player has finished",
            "type": "number"
          },
          "url": {
            "description": "Link to the player's Lichess profile",
            "type": "string"
          },
          "user_id": {
            "description": "The player's Lichess ID (lowercased username)",
            "type": "string"
          },
          "username": {
            "description": "The player's username, as they capitalize it",
            "type": "string"
          },
          "wins": {
            "description": "Games won",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "list_user_games": {
      "description": "List a Lichess player's most recent games, newest first. Unlike the other Lichess actions, this one requires a personal API access token: see the connection's setup instructions.",
      "display_name": "List a player's games",
      "display_str_template": "List Lichess games for '{0}'.",
      "handler": "actions.list_user_games",
      "id": "lichess_list_user_games",
      "method": "POST",
      "mock_response": {
        "games": [
          {
            "black": "Lola",
            "created_at": 1782934233712,
            "game_id": "q7ZvsdUF",
            "opening": "Sicilian Defense: Najdorf Variation",
