                  "description": "Whether the game was rated",
                  "type": "boolean"
                },
                "speed": {
                  "description": "The time control, for example 'blitz'",
                  "type": "string"
                },
                "url": {
                  "description": "Link to replay the game",
                  "type": "string"
                },
                "white": {
                  "description": "Username of the white player",
                  "type": "string"
                },
                "winner": {
                  "description": "'white' or 'black', or empty for a draw",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
