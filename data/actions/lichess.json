          "name": "rated_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/lichess/list-user-games",
      "result_str_template": "Lichess games retrieved.",
      "returns": {
        "properties": {
          "games": {
            "description": "The player's recent games, newest first",
            "items": {
              "properties": {
                "black": {
                  "description": "Username of the black player",
                  "type": "string"
                },
                "created_at": {
                  "description": "When the game started, as a Unix timestamp in milliseconds",
                  "type": "number"
                },
                "game_id": {
                  "description": "The game's ID",
                  "type": "string"
                },
                "opening": {
                  "description": "Name of the opening played",
                  "type": "string"
                },
                "outcome": {
                  "description": "How the game ended, for example 'mate', 'resign', or 'draw'",
