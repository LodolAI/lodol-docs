            "winner": "white"
          }
        ]
      },
      "name": "list_user_games",
      "parameters": [
        {
          "description": "The Lichess username, for example 'DrNykterstein'.",
          "display_name": "Username",
          "name": "username",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "How many games to return (1-100).",
          "display_name": "How many games",
          "maximum": 100,
          "minimum": 1,
          "name": "count",
          "required": false,
          "type": "ParameterType.NUMBER"
