        {
          "description": "What kind of image to search for.",
          "display_name": "Search query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "How many results to ask for, from 1 to 100. Defaults to 10. Google returns results in pages of ten, so the count you get back can be a little under what you ask for.",
          "display_name": "Number of results",
          "maximum": 100,
          "minimum": 1,
          "name": "num_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 1,
          "description": "Which page of results to return. 1 (the default) is the first page.",
          "display_name": "Page",
          "minimum": 1,
          "name": "page",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Search as if from this country, as a two-letter country code. Defaults to the United States.",
          "display_name": "Country",
          "examples": [
            {
              "label": "United States",
              "value": "us"
            },
            {
              "label": "United Kingdom",
              "value": "gb"
            },
            {
              "label": "Germany",
              "value": "de"
            },
            {
              "label": "Japan",
              "value": "jp"
            }
          ],
          "name": "country",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Return results in this language, as a two-letter language code. Defaults to English.",
          "display_name": "Language",
          "examples": [
            {
              "label": "English",
              "value": "en"
            },
            {
              "label": "Spanish",
              "value": "es"
            },
            {
              "label": "French",
              "value": "fr"
            },
            {
              "label": "German",
              "value": "de"
            }
          ],
          "name": "language",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Search from a specific place, which changes the local results Google shows. Write it the way Google does, most specific part first.",
          "display_name": "Location",
          "examples": [
            {
              "label": "City",
              "value": "Austin, Texas, United States"
            },
            {
              "label": "Country",
              "value": "United States"
            }
          ],
          "name": "location",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only return results published recently. Leave blank for any time.",
          "display_name": "Published within",
          "name": "date_range",
          "options": [
            {
              "label": "Past hour",
              "value": "qdr:h"
            },
            {
              "label": "Past 24 hours",
              "value": "qdr:d"
            },
            {
              "label": "Past week",
              "value": "qdr:w"
            },
            {
              "label": "Past month",
              "value": "qdr:m"
            },
            {
              "label": "Past year",
              "value": "qdr:y"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/serper/search-images",
      "result_str_template": "Found {images,length} images.",
      "returns": {
        "properties": {
          "credits_used": {
            "description": "How many Serper credits this search spent.",
            "type": "number"
          },
          "image_count": {
            "description": "How many images were returned.",
            "type": "number"
          },
          "images": {
            "description": "The images, each with its title, full-size and thumbnail address, size, source, and page link.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
