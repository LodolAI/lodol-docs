{
  "actions": {
    "autocomplete": {
      "description": "Get the search suggestions Google would offer for a partial query, the way its search box does. Useful for keyword research and for expanding a topic into the phrasing people actually search for.",
      "display_name": "Get search suggestions",
      "display_str_template": "Get Google suggestions for '{query}'.",
      "handler": "actions.autocomplete",
      "id": "serper_autocomplete",
      "method": "POST",
      "mock_response": {
        "credits_used": 1,
        "suggestion_count": 2,
        "suggestions": [
          "best coffee grinder for espresso",
          "best coffee grinder for french press"
        ]
      },
      "name": "autocomplete",
      "parameters": [
        {
          "description": "The partial query to get suggestions for, such as 'best coffee grinder for'.",
          "display_name": "Search query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Search as if from this country, as a two-letter country code. Defaults to the United States.",
          "display_name": "Country",
          "examples": [
            {
              "label": "United States",
              "value": "us"
            },
            {
              "label": "United Kingdom",
              "value": "gb"
            },
            {
              "label": "Germany",
              "value": "de"
            },
            {
              "label": "Japan",
              "value": "jp"
            }
          ],
          "name": "country",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Return results in this language, as a two-letter language code. Defaults to English.",
          "display_name": "Language",
          "examples": [
            {
              "label": "English",
              "value": "en"
            },
            {
              "label": "Spanish",
              "value": "es"
            },
            {
              "label": "French",
              "value": "fr"
            },
            {
              "label": "German",
              "value": "de"
            }
          ],
          "name": "language",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/serper/autocomplete",
      "result_str_template": "Found {suggestions,length} suggestions.",
      "returns": {
        "properties": {
          "credits_used": {
            "description": "How many Serper credits this search spent.",
            "type": "number"
          },
          "suggestion_count": {
            "description": "How many suggestions were returned.",
            "type": "number"
          },
          "suggestions": {
            "description": "The suggested searches, most likely first.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "search_images": {
      "description": "Search Google Images and get each picture's full-size and thumbnail address, its dimensions, and the page it came from.",
      "display_name": "Search Google Images",
      "display_str_template": "Search Google Images for '{query}'.",
      "handler": "actions.search_images",
      "id": "serper_search_images",
      "method": "POST",
      "mock_response": {
        "credits_used": 1,
        "image_count": 1,
        "images": [
          {
            "image_height": 1080,
            "image_url": "https://example.com/coffee.jpg",
