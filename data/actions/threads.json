{
  "actions": {
    "create_post": {
      "description": "Create a post on Threads from the connected account. Posts a text-only thread, or an image thread when an image URL is provided.",
      "display_name": "Create a post",
      "display_str_template": "Create a Threads post.",
      "handler": "actions.create_post",
      "id": "threads_create_post",
      "method": "POST",
      "mock_response": {
        "creation_id": "18000000000000002",
        "id": "17650000000000001"
      },
      "name": "create_post",
      "output_formatter": "actions.format_create_post_output",
      "parameters": [
        {
          "description": "The text of the post.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional public URL of an image to attach. When set, the post is published as an image thread; leave empty for a text-only post.",
          "display_name": "Image URL",
          "name": "image_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Controls who is allowed to reply to the post.",
          "display_name": "Who can reply",
          "name": "reply_control",
          "options": [
            {
              "label": "Everyone",
              "value": "everyone"
            },
            {
              "label": "Accounts you follow",
              "value": "accounts_you_follow"
            },
            {
              "label": "Mentioned only",
              "value": "mentioned_only"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/threads/create-post",
      "result_str_template": "Post created.",
      "returns": {
        "properties": {
          "creation_id": {
            "description": "The intermediate media container ID.",
            "type": "string"
          },
          "id": {
            "description": "The published thread's ID.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_profile": {
      "description": "Fetch the connected Threads account's public profile, including username, display name, profile picture, and biography.",
      "display_name": "Get profile",
      "display_str_template": "Get the Threads profile.",
      "handler": "actions.get_profile",
      "id": "threads_get_profile",
      "method": "POST",
      "mock_response": {
        "id": "9988776655443322",
        "name": "Lodol",
        "threads_biography": "Automate anything.",
        "threads_profile_picture_url": "https://scontent.cdninstagram.com/v/t51.2885-19/profile.jpg",
        "username": "lodol"
      },
      "name": "get_profile",
      "output_formatter": "actions.format_profile_output",
      "parameters": [],
      "path": "/actions/library/threads/get-profile",
      "result_str_template": "Profile fetched.",
      "returns": {
        "properties": {
          "id": {
            "description": "The Threads user's unique ID.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "threads_biography": {
            "type": "string"
          },
          "threads_profile_picture_url": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_posts": {
      "description": "List the connected account's recent Threads posts, including each post's ID, text, media type, permalink, and timestamp.",
      "display_name": "List posts",
      "display_str_template": "List Threads posts.",
      "handler": "actions.list_posts",
      "id": "threads_list_posts",
      "method": "POST",
      "mock_response": {
        "posts": [
          {
            "id": "17650000000000001",
            "media_type": "TEXT_POST",
            "permalink": "https://www.threads.net/@lodol/post/ABC123",
            "text": "Hello from Threads!",
            "timestamp": "2026-08-01T12:00:00+0000"
          }
        ]
      },
      "name": "list_posts",
      "output_formatter": "actions.format_list_posts_output",
      "parameters": [
        {
          "default": 10,
          "description": "Maximum number of posts to return (1-100).",
          "display_name": "Maximum posts",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/threads/list-posts",
      "result_str_template": "Retrieved {posts,length} posts.",
      "returns": {
        "description": "Response envelope; the payload is in the \"posts\" field.",
        "properties": {
          "posts": {
            "description": "List of posts.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Publish posts to Threads and read your profile and recent posts.",
  "display_name": "Threads",
  "id": "threads"
}
