  "triggers": {
    "getwaitlist_new_signup_trigger": {
      "description": "Runs for each new waitlist signup in GetWaitlist. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New waitlist signup",
      "id": "getwaitlist_new_signup_trigger",
      "output": {
        "record": "object with the fields uuid, email, priority, referral_token, removed_date, created_at"
      },
      "parameters": []
    },
    "getwaitlist_signup_offboarded_trigger": {
      "description": "Runs for each signup offboarded in GetWaitlist. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Signup offboarded",
      "id": "getwaitlist_signup_offboarded_trigger",
      "output": {
        "record": "object with the fields uuid, email, priority, referral_token, removed_date, created_at"
      },
      "parameters": []
