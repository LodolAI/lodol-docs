{
  "actions": {
    "create_or_update_profile": {
      "description": "Set a profile's name, phone number or custom properties, finding it by email address. Makes the profile if there isn't one. Fields left blank keep what the profile has.",
      "display_name": "Create or update profile",
      "display_str_template": "Create or update profile for '{0}'.",
      "handler": "actions.create_or_update_profile",
      "id": "klaviyo_create_or_update_profile",
      "method": "POST",
      "mock_response": {
        "profile": {
          "email": "jane@example.com",
          "first_name": "Jane",
          "id": "01HABCDEF1234567890ABCDEF",
          "last_name": "Doe",
          "phone_number": "+15555550100",
          "properties": {
            "plan": "Gold"
          }
        }
      },
      "name": "create_or_update_profile",
      "parameters": [
        {
          "description": "Email address of the profile.",
          "display_name": "Email",
          "examples": [
            {
              "label": "Email",
              "value": "jane@example.com"
            }
          ],
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "First name to set.",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name to set.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Phone number in E.164 format, e.g. +15555550100.",
          "display_name": "Phone number",
          "name": "phone_number",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Custom properties to set on the profile, such as {\"plan\": \"Gold\"}. Properties not named here are kept.",
          "display_name": "Custom properties",
          "name": "properties",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/klaviyo/create-or-update-profile",
      "result_str_template": "Saved Klaviyo profile.",
      "returns": {
        "properties": {
          "profile": {
            "description": "The profile as saved",
            "properties": {
              "email": {
                "description": "Profile email address",
                "type": "string"
              },
              "first_name": {
                "description": "First name, if set",
                "type": "string"
              },
              "id": {
                "description": "Profile ID",
                "type": "string"
              },
              "last_name": {
                "description": "Last name, if set",
                "type": "string"
              },
              "phone_number": {
                "description": "Phone number, if set",
                "type": "string"
              },
              "properties": {
                "description": "The profile's custom properties",
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write",
        "modify"
      ]
    },
    "create_profile": {
      "description": "Create a new Klaviyo profile, or return the existing profile's ID if the email is already in use.",
      "display_name": "Create profile",
      "display_str_template": "Create profile for '{0}'.",
      "handler": "actions.create_profile",
      "id": "klaviyo_create_profile",
      "method": "POST",
      "mock_response": {
        "id": "01HABCDEF1234567890ABCDEF"
      },
      "name": "create_profile",
      "parameters": [
        {
          "description": "Email address for the profile.",
          "display_name": "Email",
          "examples": [
            {
              "label": "Email",
              "value": "jane@example.com"
            }
          ],
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "First name of the profile.",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name of the profile.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Phone number in E.164 format, e.g. +15555550100.",
          "display_name": "Phone number",
          "name": "phone_number",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/klaviyo/create-profile",
      "result_str_template": "Created Klaviyo profile.",
      "returns": {
        "properties": {
          "id": {
            "description": "ID of the profile (new or already existing).",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "get_profile": {
      "description": "Look up a Klaviyo profile by email address.",
      "display_name": "Get profile",
      "display_str_template": "Get profile for '{0}'.",
      "handler": "actions.get_profile",
      "id": "klaviyo_get_profile",
      "method": "POST",
      "mock_response": {
        "profile": {
          "email": "jane@example.com",
          "first_name": "Jane",
          "id": "01HABCDEF1234567890ABCDEF",
          "last_name": "Doe",
          "phone_number": "+15555550100"
        }
      },
      "name": "get_profile",
      "parameters": [
        {
          "description": "Email address of the profile to look up.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/klaviyo/get-profile",
      "result_str_template": "Retrieved Klaviyo profile.",
      "returns": {
        "properties": {
          "profile": {
            "description": "The matching profile, or null if no profile has that email",
            "nullable": true,
            "properties": {
              "email": {
                "description": "Profile email address",
                "type": "string"
              },
              "first_name": {
                "description": "First name, if set",
                "type": "string"
              },
              "id": {
                "description": "Profile ID",
                "type": "string"
              },
              "last_name": {
                "description": "Last name, if set",
                "type": "string"
              },
              "phone_number": {
                "description": "Phone number, if set",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_lists": {
      "description": "List the lists in your Klaviyo account.",
      "display_name": "List lists",
      "display_str_template": "List lists.",
      "handler": "actions.list_lists",
      "id": "klaviyo_list_lists",
      "method": "POST",
      "mock_response": {
        "lists": [
          {
            "id": "Y6nRLr",
            "name": "Newsletter"
          }
        ]
      },
      "name": "list_lists",
      "parameters": [],
      "path": "/actions/library/klaviyo/list-lists",
      "result_str_template": "Fetched Klaviyo lists.",
      "returns": {
        "properties": {
          "lists": {
            "description": "List of lists in the account",
            "items": {
              "properties": {
                "id": {
                  "description": "List ID. Use with subscribe_profile_to_list.",
                  "type": "string"
                },
                "name": {
                  "description": "List name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "remove_profile_from_list": {
      "description": "Take a profile off a Klaviyo list, found by email address. Their email consent is left as it is.",
      "display_name": "Remove profile from list",
      "display_str_template": "Remove '{0}' from Klaviyo list '{1}'.",
      "handler": "actions.remove_profile_from_list",
      "id": "klaviyo_remove_profile_from_list",
      "method": "POST",
      "mock_response": {
        "list_id": "Y6nRLr",
        "profile_id": "01HABCDEF1234567890ABCDEF",
        "removed": true
      },
      "name": "remove_profile_from_list",
      "parameters": [
        {
          "description": "Email address of the profile to remove.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The list to take the profile off.",
          "display_name": "List",
          "dynamic_source": "lists",
          "dynamic_source_allows_custom": true,
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/klaviyo/remove-profile-from-list",
      "result_str_template": "Removed profile from Klaviyo list.",
      "returns": {
        "properties": {
          "list_id": {
            "description": "ID of the list",
            "type": "string"
          },
          "profile_id": {
            "description": "ID of the profile, blank if there was none",
            "type": "string"
          },
          "removed": {
            "description": "Whether a profile was taken off the list. False when no profile has that email.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "subscribe_profile_to_list": {
      "description": "Add a person to a Klaviyo list, creating their profile if needed, optionally with their first and last name. It adds them to the list only: it doesn't record that they agreed to marketing emails.",
      "display_name": "Subscribe profile to list",
      "display_str_template": "Subscribe '{0}' to Klaviyo list '{1}'.",
      "handler": "actions.subscribe_profile_to_list",
      "id": "klaviyo_subscribe_profile_to_list",
      "method": "POST",
      "mock_response": {
        "list_id": "Y6nRLr",
        "profile_id": "01HABCDEF1234567890ABCDEF"
      },
      "name": "subscribe_profile_to_list",
      "parameters": [
        {
          "description": "Email address of the profile to subscribe.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The list to add the profile to.",
          "display_name": "List",
          "dynamic_source": "lists",
          "dynamic_source_allows_custom": true,
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Beta. The person's first name, saved on the profile in the same step, so no 'Create or update profile' step is needed to name them. Leave blank to keep whatever name the profile has.",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Beta. The person's last name, saved on the profile in the same step. Leave blank to keep whatever name the profile has.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/klaviyo/subscribe-profile-to-list",
      "result_str_template": "Subscribed profile to Klaviyo list.",
      "returns": {
        "properties": {
          "list_id": {
            "description": "ID of the list the profile was added to",
            "type": "string"
          },
          "profile_id": {
            "description": "ID of the subscribed profile",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
    "track_event": {
      "description": "Log a custom event (e.g. 'Placed Order') for a profile, for use in Klaviyo flows and segments.",
      "display_name": "Track event",
      "display_str_template": "Track event '{1}' for '{0}'.",
      "handler": "actions.track_event",
      "id": "klaviyo_track_event",
      "method": "POST",
      "mock_response": {},
      "name": "track_event",
      "parameters": [
        {
          "description": "Email address of the profile the event belongs to.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the event/metric, for example 'Placed Order'.",
          "display_name": "Metric name",
          "examples": [
            {
              "label": "Metric name",
              "value": "Placed Order"
            }
          ],
          "name": "metric_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Custom properties to attach to the event.",
          "display_name": "Properties",
          "name": "properties",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Optional numeric value for the event, for example an order total.",
          "display_name": "Value",
          "name": "value",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/klaviyo/track-event",
      "result_str_template": "Tracked Klaviyo event.",
      "returns": {
        "properties": {},
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    }
  },
  "categories": [
    "Email Marketing",
    "E-Commerce"
  ],
  "description": "Connect your Klaviyo account to manage profiles, list subscriptions, and track marketing events.",
  "display_name": "Klaviyo",
  "id": "klaviyo",
  "logo": "https://www.lodol.com/app-icons/klaviyo-icon.png",
  "triggers": {
    "klaviyo_new_profile_trigger": {
      "description": "Runs for each new profile in your Klaviyo account, with their email, name and custom properties. Profiles already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New profile",
      "id": "klaviyo_new_profile_trigger",
      "output": {
        "created": "When the profile was made.",
        "email": "Their email address.",
        "first_name": "Their first name, if set.",
        "id": "The profile's ID in Klaviyo.",
        "last_name": "Their last name, if set.",
        "organization": "The company they work for, if set.",
        "phone_number": "Their phone number, if set.",
        "properties": "Their custom properties."
      },
      "parameters": []
    },
    "klaviyo_profile_added_to_list_trigger": {
      "description": "Runs each time a profile joins a Klaviyo list, with their email, name and custom properties. Profiles already on the list when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Profile added to list",
      "id": "klaviyo_profile_added_to_list_trigger",
      "output": {
        "created": "When the profile was made.",
        "email": "Their email address.",
        "first_name": "Their first name, if set.",
        "id": "The profile's ID in Klaviyo.",
        "joined_list_at": "When they joined the list.",
        "last_name": "Their last name, if set.",
        "list_id": "The list's ID.",
        "organization": "The company they work for, if set.",
        "phone_number": "Their phone number, if set.",
        "properties": "Their custom properties."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Klaviyo list to watch for profiles joining it.",
          "display_name": "List",
          "name": "list_id",
          "required": true
        }
      ]
    }
  }
}
