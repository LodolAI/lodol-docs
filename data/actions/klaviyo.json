{
  "actions": {
    "create_profile": {
      "description": "Create a new Klaviyo profile, or return the existing profile's ID if the email is already in use.",
      "display_name": "Create profile",
      "display_str_template": "Create Klaviyo profile for '{0}'.",
      "handler": "actions.create_profile",
      "id": "klaviyo_create_profile",
      "method": "POST",
      "mock_response": {
        "id": "01HABCDEF1234567890ABCDEF"
      },
      "name": "create_profile",
      "parameters": [
        {
          "description": "Email address for the profile.",
          "display_name": "Email",
          "examples": [
            {
              "label": "Email",
              "value": "jane@example.com"
            }
          ],
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "First name of the profile.",
          "display_name": "First name",
          "name": "first_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name of the profile.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Phone number in E.164 format, e.g. +15555550100.",
          "display_name": "Phone number",
          "name": "phone_number",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/klaviyo/create-profile",
      "result_str_template": "Created Klaviyo profile.",
      "returns": {
        "properties": {
          "id": {
            "description": "ID of the profile (new or already existing).",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_profile": {
      "description": "Look up a Klaviyo profile by email address.",
      "display_name": "Get profile",
      "display_str_template": "Get Klaviyo profile for '{0}'.",
      "handler": "actions.get_profile",
      "id": "klaviyo_get_profile",
      "method": "POST",
      "mock_response": {
        "profile": {
          "email": "jane@example.com",
          "first_name": "Jane",
          "id": "01HABCDEF1234567890ABCDEF",
          "last_name": "Doe",
          "phone_number": "+15555550100"
        }
      },
      "name": "get_profile",
      "parameters": [
        {
          "description": "Email address of the profile to look up.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/klaviyo/get-profile",
      "result_str_template": "Retrieved Klaviyo profile.",
      "returns": {
        "properties": {
          "profile": {
            "description": "The matching profile, or null if no profile has that email",
            "nullable": true,
            "properties": {
              "email": {
                "description": "Profile email address",
                "type": "string"
              },
              "first_name": {
                "description": "First name, if set",
                "type": "string"
              },
              "id": {
                "description": "Profile ID",
                "type": "string"
              },
              "last_name": {
                "description": "Last name, if set",
                "type": "string"
              },
              "phone_number": {
                "description": "Phone number, if set",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "list_lists": {
      "description": "List the lists in your Klaviyo account.",
      "display_name": "List lists",
      "display_str_template": "List Klaviyo lists.",
      "handler": "actions.list_lists",
      "id": "klaviyo_list_lists",
      "method": "POST",
      "mock_response": {
        "lists": [
          {
            "id": "Y6nRLr",
            "name": "Newsletter"
          }
        ]
      },
      "name": "list_lists",
      "parameters": [],
      "path": "/actions/library/klaviyo/list-lists",
      "result_str_template": "Fetched Klaviyo lists.",
      "returns": {
        "properties": {
          "lists": {
            "description": "List of lists in the account",
            "items": {
              "properties": {
                "id": {
                  "description": "List ID. Use with subscribe_profile_to_list.",
                  "type": "string"
                },
                "name": {
                  "description": "List name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "subscribe_profile_to_list": {
      "description": "Add a profile (creating it if needed) to a Klaviyo list.",
      "display_name": "Subscribe profile to list",
      "display_str_template": "Subscribe '{0}' to Klaviyo list '{1}'.",
      "handler": "actions.subscribe_profile_to_list",
      "id": "klaviyo_subscribe_profile_to_list",
      "method": "POST",
      "mock_response": {
        "list_id": "Y6nRLr",
        "profile_id": "01HABCDEF1234567890ABCDEF"
      },
      "name": "subscribe_profile_to_list",
      "parameters": [
        {
          "description": "Email address of the profile to subscribe.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the list to add the profile to.",
          "display_name": "List ID",
          "name": "list_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/klaviyo/subscribe-profile-to-list",
      "result_str_template": "Subscribed profile to Klaviyo list.",
      "returns": {
        "properties": {
          "list_id": {
            "description": "ID of the list the profile was added to",
            "type": "string"
          },
          "profile_id": {
            "description": "ID of the subscribed profile",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "track_event": {
      "description": "Log a custom event (e.g. 'Placed Order') for a profile, for use in Klaviyo flows and segments.",
      "display_name": "Track event",
      "display_str_template": "Track Klaviyo event '{1}' for '{0}'.",
      "handler": "actions.track_event",
      "id": "klaviyo_track_event",
      "method": "POST",
      "mock_response": {},
      "name": "track_event",
      "parameters": [
        {
          "description": "Email address of the profile the event belongs to.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Name of the event/metric, for example 'Placed Order'.",
          "display_name": "Metric name",
          "examples": [
            {
              "label": "Metric name",
              "value": "Placed Order"
            }
          ],
          "name": "metric_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Custom properties to attach to the event.",
          "display_name": "Properties",
          "name": "properties",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "Optional numeric value for the event, for example an order total.",
          "display_name": "Value",
          "name": "value",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/klaviyo/track-event",
      "result_str_template": "Tracked Klaviyo event.",
      "returns": {
        "properties": {},
        "type": "object"
      }
    }
  },
  "description": "Connect your Klaviyo account to manage profiles, list subscriptions, and track marketing events.",
  "display_name": "Klaviyo",
  "id": "klaviyo"
}
