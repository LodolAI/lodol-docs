    "send_heartbeat": {
      "description": "Tell a push monitor that a job ran (up) or failed (down), with a message and how long it took, such as at the end of a backup. Uptime Kuma alerts when the heartbeats stop.",
      "display_name": "Send push heartbeat",
      "display_str_template": "Send an Uptime Kuma heartbeat.",
      "handler": "actions.send_heartbeat",
      "id": "uptime_kuma_send_heartbeat",
      "method": "POST",
      "mock_response": {
        "message": "Backup finished: 2.4 GB",
        "response_time_ms": 5400,
        "sent": true,
        "sent_at": "2026-11-06T02:00:12Z",
        "status": "up"
      },
      "name": "send_heartbeat",
      "output_formatter": "actions.format_heartbeat",
      "parameters": [
        {
          "description": "The push monitor's Push URL, from its settings in Uptime Kuma, or the token at its end.",
          "display_name": "Push URL",
          "name": "push_token",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "up",
          "description": "Whether the job worked.",
          "display_name": "Status",
          "name": "status",
          "options": [
            {
              "label": "Up",
              "value": "up"
            },
            {
              "label": "Down",
              "value": "down"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to show with the heartbeat in Uptime Kuma, such as what the job did. Leave blank for OK.",
          "display_name": "Message",
          "name": "message",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How long the job took, in milliseconds, shown on the monitor's chart.",
          "display_name": "Response time (ms)",
          "minimum": 0,
          "name": "response_time",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/uptime-kuma/send-heartbeat",
      "result_str_template": "Sent a {uptime_kuma_send_heartbeat,status} heartbeat.",
      "returns": {
        "properties": {
          "message": {
            "description": "The message sent",
            "type": "string"
          },
          "response_time_ms": {
            "description": "The response time sent, in milliseconds",
            "type": [
              "number",
              "null"
            ]
          },
          "sent": {
            "description": "Whether Uptime Kuma took the heartbeat",
            "type": "boolean"
          },
          "sent_at": {
            "description": "When it was sent (ISO 8601, UTC)",
            "type": "string"
          },
          "status": {
            "description": "The status sent: up or down",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    }
  },
  "categories": [
    "Monitoring"
  ],
  "description": "Watch your sites and services in Uptime Kuma: get monitors' status, uptime and certificates, read a status page, send push heartbeats, and start a workflow when a monitor goes down or comes back up.",
  "display_name": "Uptime Kuma",
  "id": "uptime_kuma",
  "logo": "https://www.lodol.com/app-icons/uptime-kuma-icon.svg",
  "triggers": {
    "uptime_kuma_certificate_expiring_trigger": {
      "description": "Runs once when a monitored site's certificate has the set number of days left or fewer, including when the workflow is turned on, and again after it's renewed and comes close again.",
      "display_name": "Certificate expiring soon",
      "id": "uptime_kuma_certificate_expiring_trigger",
      "output": {
        "address": "string",
        "cert_days_remaining": "number",
        "cert_valid": "boolean",
        "id": "number",
        "link": "string",
        "name": "string",
        "previous_status": "string",
        "response_time_ms": "number",
        "seen_at": "string",
        "status": "string",
        "type": "string",
        "uptime_24h_percent": "number"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only this monitor, by its name (or its ID on Uptime Kuma 2). Leave blank for every monitor.",
          "display_name": "Monitor",
          "name": "monitor",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "How many days before the certificate expires to run. Leave blank for 14.",
          "display_name": "Days before expiry",
          "name": "days",
          "required": false
        }
      ]
    },
    "uptime_kuma_monitor_down_trigger": {
      "description": "Runs when an Uptime Kuma monitor goes down. Monitors already down when the workflow is turned on don't run it.",
      "display_name": "Monitor down",
      "id": "uptime_kuma_monitor_down_trigger",
      "output": {
        "address": "string",
        "cert_days_remaining": "number",
