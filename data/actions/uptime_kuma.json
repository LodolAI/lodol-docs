{
  "actions": {
    "get_monitor": {
      "description": "Get one monitor's status (up, down, pending or in maintenance), last response time, certificate expiry and uptime.",
      "display_name": "Get monitor status",
      "display_str_template": "Get Uptime Kuma monitor {0}.",
      "handler": "actions.get_monitor",
      "id": "uptime_kuma_get_monitor",
      "method": "POST",
      "mock_response": {
        "address": "https://www.example.com/",
        "avg_response_time_24h_ms": 175.4,
        "cert_days_remaining": 47,
        "cert_valid": true,
        "id": 3,
        "is_up": true,
        "link": "https://status.example.com/dashboard/3",
        "name": "Website",
        "response_time_ms": 182,
        "status": "up",
        "type": "http",
        "uptime_1y_percent": 99.95,
        "uptime_24h_percent": 99.93,
        "uptime_30d_percent": 99.98
      },
      "name": "get_monitor",
      "output_formatter": "actions.format_monitor",
      "parameters": [
        {
          "description": "The monitor's name, or its ID on Uptime Kuma 2.",
          "display_name": "Monitor",
          "dynamic_source": "monitors",
          "dynamic_source_allows_custom": true,
          "name": "monitor",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/uptime-kuma/get-monitor",
      "result_str_template": "{uptime_kuma_get_monitor,name} is {uptime_kuma_get_monitor,status}.",
      "returns": {
        "properties": {
          "address": {
            "description": "The address or host it checks; empty for a push monitor",
            "type": "string"
          },
          "avg_response_time_24h_ms": {
            "description": "Its average response time over 24 hours, in milliseconds; empty on Uptime Kuma version 1",
            "type": [
              "number",
              "null"
            ]
          },
          "cert_days_remaining": {
            "description": "Days until its site's certificate expires; empty when it has none",
            "type": [
              "number",
              "null"
            ]
          },
          "cert_valid": {
            "description": "Whether its certificate is valid; empty when it has none",
            "type": [
              "boolean",
              "null"
            ]
          },
          "id": {
            "description": "The monitor's ID, as in its link; empty on Uptime Kuma version 1",
            "type": [
              "number",
              "null"
            ]
          },
          "is_up": {
            "description": "Whether its status is up",
            "type": "boolean"
          },
          "link": {
            "description": "A link to it in Uptime Kuma (its dashboard on version 1)",
            "type": "string"
          },
          "name": {
            "description": "Its name",
            "type": "string"
          },
          "response_time_ms": {
            "description": "How long its last check took, in milliseconds",
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "description": "up, down, pending (failing, retrying before it counts as down) or maintenance",
            "type": "string"
          },
          "type": {
            "description": "What it checks with: http, keyword, port, ping, push, dns and so on",
            "type": "string"
          },
          "uptime_1y_percent": {
            "description": "Percent of the last year it was up; empty on Uptime Kuma version 1",
            "type": [
              "number",
              "null"
            ]
          },
          "uptime_24h_percent": {
            "description": "Percent of the last 24 hours it was up; empty on Uptime Kuma version 1",
            "type": [
              "number",
              "null"
            ]
          },
          "uptime_30d_percent": {
            "description": "Percent of the last 30 days it was up; empty on Uptime Kuma version 1",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
