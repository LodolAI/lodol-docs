          "display_name": "Monitor",
          "name": "monitor",
          "required": false
        }
      ]
    },
    "uptime_kuma_monitor_up_trigger": {
      "description": "Runs when an Uptime Kuma monitor comes back up after being down.",
      "display_name": "Monitor back up",
      "id": "uptime_kuma_monitor_up_trigger",
      "output": {
        "address": "string",
        "cert_days_remaining": "number",
        "cert_valid": "boolean",
        "id": "number",
        "link": "string",
        "name": "string",
        "previous_status": "string",
        "response_time_ms": "number",
        "seen_at": "string",
        "status": "string",
        "type": "string",
        "uptime_24h_percent": "number"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only this monitor, by its name (or its ID on Uptime Kuma 2). Leave blank for every monitor.",
          "display_name": "Monitor",
          "name": "monitor",
