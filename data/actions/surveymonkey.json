              "properties": {
                "date_created": {
                  "description": "Timestamp the response was submitted",
                  "type": "string"
                },
                "id": {
                  "description": "Response ID. Use with get_response to fetch its answers.",
                  "type": "string"
                },
                "response_status": {
                  "description": "Response status, for example 'completed' or 'partial'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
