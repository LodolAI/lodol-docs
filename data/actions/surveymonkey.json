{
  "actions": {
    "get_response": {
      "description": "Look up a single survey response and its answers.",
      "display_name": "Get response",
      "display_str_template": "Get SurveyMonkey response '{1}'.",
      "handler": "actions.get_response",
      "id": "surveymonkey_get_response",
      "method": "POST",
      "mock_response": {
        "answers": [
          {
            "answer": "Very satisfied",
            "question_id": "133186412"
          }
        ],
        "date_created": "2026-01-15T10:00:00+00:00",
        "id": "13307358020",
        "response_status": "completed"
      },
      "name": "get_response",
      "parameters": [
        {
          "description": "ID of the survey the response belongs to.",
          "display_name": "Survey ID",
          "name": "survey_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the response to fetch.",
          "display_name": "Response ID",
          "name": "response_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/surveymonkey/get-response",
      "result_str_template": "Retrieved the response.",
      "returns": {
        "properties": {
          "answers": {
            "description": "The respondent's answers, one per question answered",
            "items": {
              "properties": {
                "answer": {
                  "description": "The respondent's answer text, resolved from free text, a selected choice label, or a matrix row/column label",
                  "type": "string"
                },
                "question_id": {
                  "description": "ID of the question this answer belongs to",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "date_created": {
            "description": "Timestamp the response was submitted",
            "type": "string"
          },
          "id": {
            "description": "Response ID",
            "type": "string"
          },
          "response_status": {
            "description": "Response status, for example 'completed' or 'partial'",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_survey": {
      "description": "Look up a survey's title and question/response counts.",
      "display_name": "Get survey",
      "display_str_template": "Get SurveyMonkey survey '{0}'.",
      "handler": "actions.get_survey",
      "id": "surveymonkey_get_survey",
      "method": "POST",
      "mock_response": {
        "id": "308585",
        "question_count": 8,
        "response_count": 42,
        "title": "Customer Feedback"
      },
      "name": "get_survey",
      "parameters": [
        {
          "description": "ID of the survey to look up.",
          "display_name": "Survey ID",
          "name": "survey_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/surveymonkey/get-survey",
      "result_str_template": "Retrieved the survey.",
      "returns": {
        "properties": {
          "id": {
            "description": "Survey ID",
            "type": "string"
          },
          "question_count": {
            "description": "Number of questions in the survey",
            "type": "number"
          },
          "response_count": {
            "description": "Number of responses collected so far",
            "type": "number"
          },
          "title": {
            "description": "Survey title",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_responses": {
      "description": "List the responses submitted to a survey.",
      "display_name": "List responses",
      "display_str_template": "List responses to SurveyMonkey survey '{0}'.",
      "handler": "actions.list_responses",
      "id": "surveymonkey_list_responses",
      "method": "POST",
      "mock_response": {
        "responses": [
          {
            "date_created": "2026-01-15T10:00:00+00:00",
            "id": "13307358020",
            "response_status": "completed"
          }
        ]
      },
      "name": "list_responses",
      "parameters": [
        {
          "description": "ID of the survey to list responses for.",
          "display_name": "Survey ID",
          "name": "survey_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of responses to return (default 25).",
          "display_name": "Maximum responses",
          "name": "max_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/surveymonkey/list-responses",
