      "id": "submagic_project_completed_trigger",
      "output": {
        "record": "object"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Project ID.",
          "display_name": "Project ID",
          "name": "project_id",
          "required": true
        }
      ]
    },
    "submagic_project_failed_trigger": {
      "description": "Runs each time a video project is failed in Submagic. Ones failed before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
