    "read_rows": {
      "description": "Read every data row of a sheet at once. Each row comes back as an object keyed by the column headers (row.Email), plus the sheet row number (row.row_number), so Update row can write a result back to that exact row. Use this to loop over a list of records.",
      "display_name": "Read rows",
      "display_str_template": "Read all rows from '{1}'.",
      "handler": "actions.read_rows",
      "id": "google_sheets_read_rows",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "headers": [
          "Company",
          "Contact Name",
          "Email",
          "Status"
        ],
        "rows": [
          {
            "Company": "Acme Corp",
            "Contact Name": "Jordan Lee",
            "Email": "jordan@acme.test",
            "Status": "New",
            "row_number": 2
          },
          {
            "Company": "Northwind",
            "Contact Name": "Sam Rivera",
            "Email": "sam@northwind.test",
            "Status": "",
            "row_number": 3
          }
        ],
        "status": "success"
      },
      "name": "read_rows",
      "output_formatter": "actions.format_read_rows_output",
      "parameters": [
        {
          "description": "The URL of the spreadsheet",
          "display_name": "Spreadsheet URL",
          "name": "spreadsheet_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the sheet/tab",
          "display_name": "Sheet name",
          "name": "sheet_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Use the first row as the column names. Turn this off when the sheet starts straight into data; the columns are then named column_1, column_2, and so on.",
          "display_name": "First row is a header",
          "name": "has_header",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Read at most this many data rows. Leave empty to read them all.",
          "display_name": "Maximum rows",
          "name": "max_rows",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-sheets/read-rows",
      "result_str_template": "Read {3} row(s) from '{1}'.",
      "returns": {
        "description": "Response envelope; the rows are in the 'rows' field. Read a value off a row by its column name (row.Email), never by position.",
        "properties": {
          "count": {
            "description": "How many data rows were read",
            "type": "number"
          },
          "headers": {
            "description": "The column names, in sheet order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rows": {
            "description": "One object per data row, keyed by column header, plus 'row_number' (the row's position in the sheet, for writing a result back to it)",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
