{
  "actions": {
    "append_cell_to_column": {
      "description": "Append a single value to the end of a column.",
      "display_name": "Append cell to column",
      "display_str_template": "Append value to column {2} in '{1}'.",
      "handler": "actions.append_cell_to_column",
      "id": "google_sheets_append_cell_to_column",
      "method": "POST",
      "name": "append_cell_to_column",
      "output_formatter": "actions.format_append_cell_to_column_output",
      "parameters": [
        {
          "description": "The URL of the spreadsheet",
          "display_name": "Spreadsheet URL",
          "name": "spreadsheet_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name of the sheet/tab",
          "display_name": "Sheet name",
          "name": "sheet_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The column's position number: 1 for column A, 2 for column B, and so on.",
          "display_name": "Column number",
          "name": "column_index",
          "required": true,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The value to append",
          "display_name": "Value",
          "name": "value",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "USER_ENTERED",
          "description": "How Google Sheets reads the values written: as if typed (the default), or exactly as given.",
          "display_name": "How to save values",
          "name": "value_input_option",
          "options": [
            {
              "label": "As if typed (numbers, dates, and formulas are recognized)",
              "value": "USER_ENTERED"
            },
            {
              "label": "Exactly as given (text stays text)",
              "value": "RAW"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-sheets/append-cell-to-column",
      "result_str_template": "Appended value to column {2} in '{1}'.",
      "returns": {
        "description": "No return value",
        "type": "null"
      }
    },
