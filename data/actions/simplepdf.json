    "get_submission": {
      "description": "Get one submission: when it was made, a short-lived link to the filled-in PDF, and the answers given in each field.",
      "display_name": "Get submission",
      "display_str_template": "Get submission in SimplePDF.",
      "handler": "actions.get_submission",
      "id": "simplepdf_get_submission",
      "method": "POST",
      "mock_response": {
        "answers": [
          {
            "id": "first_name__widget_1",
            "name": "First name",
            "value": "Jane"
          }
        ],
        "answers_error": "",
        "submission": {
          "context": {
            "customer_id": "123"
          },
          "field_data_url": "https://files.simplepdf.com/answers.json?signature=example",
          "id": "5d2a1e9c-8a7b-4c53-a1f0-6e7d3b9c4f21",
          "name": "Employment form.pdf",
          "submitted_at": "2026-10-16T10:30:00Z",
          "url": "https://files.simplepdf.com/submission.pdf?signature=example"
        }
      },
      "name": "get_submission",
      "output_formatter": "formatters.submission_formatter",
      "parameters": [
        {
          "description": "The document. Pick one, or give its id from an earlier step.",
          "display_name": "Document",
          "dynamic_source": "documents",
          "dynamic_source_allows_custom": true,
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The submission's id, from 'List submissions'.",
          "display_name": "Submission ID",
          "name": "submission_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/simplepdf/get-submission",
      "result_str_template": "Submission retrieved.",
      "returns": {
        "properties": {
          "answers": {
            "description": "The answers given, one per field",
            "items": {
              "properties": {
                "id": {
                  "description": "The id of the field answered",
                  "type": "string"
                },
                "name": {
                  "description": "The field's name",
                  "nullable": true,
                  "type": "string"
                },
                "value": {
                  "description": "What was entered or chosen",
                  "nullable": true,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "answers_error": {
            "description": "Why the answers could not be read; otherwise empty",
            "type": "string"
          },
          "submission": {
            "description": "The submission",
            "properties": {
              "context": {
                "description": "The context the embedding page attached to the submission, if any",
                "nullable": true,
                "type": "object"
              },
              "field_data_url": {
                "description": "A short-lived link to the answers as JSON, null if there are none",
                "nullable": true,
                "type": "string"
              },
              "id": {
                "description": "The submission's id",
                "type": "string"
              },
              "name": {
                "description": "The submitted file's name",
                "nullable": true,
                "type": "string"
              },
              "submitted_at": {
                "description": "When the submission was made",
                "type": "string"
              },
              "url": {
                "description": "A short-lived link to download the filled-in PDF",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_document_fields": {
      "description": "List the form fields set up on a document: each field's id, name, type, page, choices and whether it is required. A document with no fields returns an empty list.",
      "display_name": "List document fields",
      "display_str_template": "List document fields in SimplePDF.",
      "handler": "actions.list_document_fields",
      "id": "simplepdf_list_document_fields",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "fields": [
          {
            "default_value": false,
            "id": "first_name__widget_1",
            "name": "First name",
            "options": null,
            "page": 1,
            "read_only": false,
            "required": true,
            "type": "text"
          }
        ],
        "note": ""
      },
      "name": "list_document_fields",
      "output_formatter": "formatters.fields_formatter",
      "parameters": [
        {
          "description": "The document. Pick one, or give its id from an earlier step.",
          "display_name": "Document",
          "dynamic_source": "documents",
          "dynamic_source_allows_custom": true,
          "name": "document_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/simplepdf/list-document-fields",
      "result_str_template": "Fields retrieved.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many fields",
            "type": "number"
          },
          "fields": {
            "description": "The document's form fields",
            "items": {
              "properties": {
                "default_value": {
                  "description": "Whether a checkbox starts ticked",
                  "type": "boolean"
                },
                "id": {
                  "description": "The field's id, which answers refer to",
                  "type": "string"
                },
                "name": {
                  "description": "The field's name, if it has one",
                  "nullable": true,
                  "type": "string"
                },
                "options": {
                  "description": "The choices of a dropdown or radio field",
                  "nullable": true,
                  "type": "array"
                },
                "page": {
                  "description": "The page the field is on, starting at 1",
                  "type": "number"
                },
                "read_only": {
                  "description": "Whether the field cannot be changed",
                  "type": "boolean"
                },
                "required": {
                  "description": "Whether the field must be filled in",
                  "type": "boolean"
                },
                "type": {
                  "description": "text, comb_text, checkbox, signature, picture, dropdown or radio",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "note": {
            "description": "Why the list is empty, if it is; otherwise empty",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
