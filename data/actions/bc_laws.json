    "search_laws": {
      "description": "Search British Columbia's statutes and regulations, best match first, with snippets showing where the words appear and each document's ID and link. Quote words to search a phrase. No API key required.",
      "display_name": "Search laws",
      "display_str_template": "Search BC Laws for {0}.",
      "handler": "actions.search_laws",
      "id": "bc_laws_search_laws",
      "method": "POST",
      "mock_response": {
        "count": 1,
        "offset": 0,
        "query": "drinking water",
        "results": [
          {
            "collection": "statreg",
            "document_id": "01009_01",
            "location": "-- D --/Drinking Water Protection Act [SBC 2001] c. 9/00_01009_01.xml",
            "parent_id": "01009",
            "rank": 1,
            "snippets": [
              "... Drinking Water Protection Act ...",
              "... Water Sustainability Act ; ..."
