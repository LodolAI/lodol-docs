              },
              "id": {
                "description": "The Yelp Lead ID (same as the ID query parameter)",
                "type": "string"
              },
              "last_event_time": {
                "description": "Time of the last event on the lead",
                "format": "date-time",
                "type": "string"
              },
              "link_to_reply_in_yelp": {
                "description": "A direct link to the lead in Yelp's Leads Center, where the business can reply to the consumer. Please contact Yelp if you want to receive this field in the response.",
