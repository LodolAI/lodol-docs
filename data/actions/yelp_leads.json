                "format": "date-time",
                "type": "string"
              },
              "time_created": {
                "description": "The time when the lead was created",
                "format": "date-time",
                "type": "string"
              },
              "user": {
                "description": "The consumer user that created the project",
                "properties": {
                  "display_name": {
                    "description": "Display name of the user",
                    "type": "string"
                  }
                },
                "required": [
                  "display_name"
                ],
                "type": "object"
              }
            },
            "required": [
              "id",
              "business_id",
              "time_created",
              "last_event_time"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
