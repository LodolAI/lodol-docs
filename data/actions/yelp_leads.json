              },
              "phone_number": {
                "description": "The consumer's phone number. **Note** This field may not be returned if the consumer has not opted into receiving phone calls.",
                "type": "string"
              },
              "project": {
                "description": "The project",
                "properties": {
                  "attachments": {
                    "description": "The project attachments (e.g. uploaded photos)",
                    "items": {
                      "description": "One attachments record.",
                      "properties": {
                        "id": {
                          "description": "The unique ID for this attachment",
                          "type": "string"
                        },
                        "mime_type": {
                          "description": "The mime type of the file",
                          "type": "string"
                        },
                        "resource_name": {
                          "description": "The name of the resource",
                          "type": "string",
                          "x-nullable": true
                        },
                        "url": {
                          "description": "A url to the attachment content. Accessible for up to 24 hours after querying this endpoint",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "availability": {
                    "description": "The consumer users availability",
                    "nullable": true,
                    "properties": {
                      "dates": {
                        "description": "The list of dates that the consumer user selected, is empty if status is not SPECIFIC_DATES",
                        "items": {
                          "description": "One dates record.",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "status": {
                        "description": "The status of the availability. Is one of SPECIFIC_DATES, ASAP or FLEXIBLE",
                        "type": "string"
                      }
                    },
                    "required": [
                      "status",
                      "dates"
                    ],
                    "type": "object"
                  },
                  "job_names": {
                    "description": "The name that identifies the type of job. For a moving business this could be \"In-state moving\" or \"Out-of-state moving\"",
                    "items": {
                      "description": "One job names record.",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "location": {
                    "description": "The consumer users location",
                    "nullable": true,
                    "properties": {
                      "postal_code": {
                        "description": "Postal code.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "postal_code"
                    ],
                    "type": "object"
                  },
                  "survey_answers": {
                    "description": "The projects survey questions and answers",
                    "items": {
                      "description": "One survey answers record.",
                      "properties": {
                        "answer_text": {
                          "description": "The survey answers. This will contain multiple entries if the consumer user selected multiple answers for e.g. a list of items that need to be moved",
                          "items": {
                            "description": "One answer text record.",
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "question_identifier": {
                          "description": "Optional custom question identifier used instead of the text to uniquely identify a question across text changes",
                          "type": "string",
                          "x-nullable": true
                        },
                        "question_text": {
                          "description": "The survey question text",
                          "type": "string"
                        }
                      },
                      "required": [
                        "question_text",
                        "answer_text"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "location",
                  "availability",
                  "job_names",
                  "survey_answers"
                ],
                "type": "object"
              },
              "temporary_email_address": {
                "description": "A temporary, one-time-use email address which the biz user can use to reply to the lead. **Note** In some cases, we may not return this temporary email address. Cases when this can happen include: * Access to proxy email addresses has not been enabled for you, see [Yelp Partner APIs](https://docs.developer.yelp.com/docs/yelp-partner-apis) on how to get access * The lead has been created more than 30 days ago * The lead has already been replied to by any biz user",
                "type": "string"
              },
              "temporary_email_address_expiry": {
                "description": "The expiry time of the reply email address (replies after expiry will be rejected). This field will only be included if a temporary email address is returned as well.",
