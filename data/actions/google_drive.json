{
  "actions": {
    "create_folder": {
      "description": "Create a folder and return a link to it.",
      "display_name": "Create folder",
      "display_str_template": "Create folder '{0}'.",
      "handler": "actions.create_folder",
      "id": "google_drive_create_folder",
      "method": "POST",
      "mock_response": {
        "folder_link": "https://drive.google.com/drive/folders/newfolder123"
      },
      "name": "create_folder",
      "output_formatter": "actions.format_create_folder_output",
      "parameters": [
        {
          "description": "The name of the folder to create.",
          "display_name": "Folder name",
          "name": "folder_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Google Drive URL of the folder to create the new folder in.",
          "display_name": "Parent folder URL",
          "name": "parent_folder_url",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/create-folder",
      "result_str_template": "Created folder at {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"folder_link\" field.",
        "properties": {
          "folder_link": {
            "description": "A link to the created folder",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "delete_file": {
      "description": "Delete a file from Drive.",
      "display_name": "Delete file",
      "display_str_template": "Delete file '{0}'.",
      "handler": "actions.delete_file",
      "id": "google_drive_delete_file",
      "method": "POST",
      "mock_response": {
        "deleted": true
      },
      "name": "delete_file",
      "output_formatter": "actions.format_delete_file_output",
      "parameters": [
        {
          "description": "The Google Drive URL of the file to delete.",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/delete-file",
      "result_str_template": "Deleted file {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"deleted\" field.",
        "properties": {
          "deleted": {
            "description": "Whether the file was deleted",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
    "download_file_from_url": {
      "description": "Save a copy of a Drive file, from its link, for later steps to attach or upload elsewhere. To use its text instead, use Read file.",
      "display_name": "Download file",
      "display_str_template": "Download file '{0}'.",
      "handler": "actions.download_file_from_url",
      "id": "google_drive_download_file_from_url",
      "method": "POST",
      "mock_response": {
        "content_type": "application/pdf",
        "document_ref": "doc_0123456789abcdef0123456789abcdea",
        "filename": "downloaded_file.txt",
        "size_bytes": 1024
      },
      "name": "download_file_from_url",
      "output_formatter": "actions.format_download_file_from_url_output",
      "parameters": [
        {
          "description": "The sharing URL of the Google Drive file.",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The folder to save the downloaded file in.",
          "display_name": "Download folder",
          "name": "download_dir",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/download-file-from-url",
      "result_str_template": "Downloaded file to {0}.",
      "returns": {
        "properties": {
          "content_type": {
            "type": "string"
          },
          "document_ref": {
            "description": "The saved file, to pass to a later step that takes a file (an email attachment, an AI step's files).",
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
    "duplicate_file": {
      "description": "Duplicate a file in its own folder and return a link to the duplicate.",
      "display_name": "Duplicate file",
      "display_str_template": "Duplicate file '{0}'.",
      "handler": "actions.duplicate_file",
      "id": "google_drive_duplicate_file",
      "method": "POST",
      "mock_response": {
        "duplicate_link": "https://drive.google.com/file/d/xyz789/view"
      },
      "name": "duplicate_file",
      "output_formatter": "actions.format_duplicate_file_output",
      "parameters": [
        {
          "description": "The Google Drive URL of the file to duplicate.",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Google Drive URL of the folder to place the copy in.",
          "display_name": "Destination folder URL",
          "name": "destination_folder_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The name for the copy.",
          "display_name": "New name",
          "name": "new_name",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/duplicate-file",
      "result_str_template": "Duplicated file to {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"duplicate_link\" field.",
        "properties": {
          "duplicate_link": {
            "description": "A link to the duplicated file",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "move_file": {
      "description": "Move a file to a different folder.",
      "display_name": "Move file",
      "display_str_template": "Move file '{0}' to folder '{1}'.",
      "handler": "actions.move_file",
      "id": "google_drive_move_file",
      "method": "POST",
      "mock_response": {
        "file_link": "https://drive.google.com/file/d/abc123/view"
      },
      "name": "move_file",
      "output_formatter": "actions.format_move_file_output",
      "parameters": [
        {
          "description": "The Google Drive URL of the file to move.",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Google Drive URL of the folder to move the file to.",
          "display_name": "Destination folder URL",
          "name": "destination_folder_url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/move-file",
      "result_str_template": "Moved file to {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"file_link\" field.",
        "properties": {
          "file_link": {
            "description": "A link to the moved file",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
    "read_file": {
      "description": "Read the text of a Google Doc, presentation, spreadsheet's first tab, PDF, Word document or text file, so later steps can use it. Use a link from Search files or a sharing link. Does not change the file. To keep the file itself, use Download file. Up to 10 MB; use the next offset to continue reading long text.",
      "display_name": "Read file",
      "display_str_template": "Read file '{0}'.",
      "handler": "actions.read_file",
      "id": "google_drive_read_file",
      "method": "POST",
      "mock_response": {
        "id": "qa-file",
        "mime_type": "text/plain",
        "name": "Security policy.txt",
        "next_offset": null,
        "note": "",
        "text": "Staff use multifactor authentication.",
        "truncated": false,
        "web_view_link": "https://drive.google.com/file/d/qa-file/view"
      },
      "name": "read_file",
      "output_formatter": "reading.format_read_file_output",
      "parameters": [
        {
          "description": "File link from Search files or a Google Drive sharing link.",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 30000,
          "description": "Maximum characters to return, from 1 to 100000.",
          "display_name": "Max chars",
          "maximum": 100000,
          "minimum": 1,
          "name": "max_chars",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": 0,
          "description": "Character offset to start at. Use next_offset from a previous read to continue.",
          "display_name": "Offset",
          "minimum": 0,
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-drive/read-file",
      "result_str_template": "Read file text.",
      "returns": {
        "properties": {
          "id": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "next_offset": {
            "type": [
              "integer",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "web_view_link": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "search_files": {
      "description": "Find files by words in their names or indexed contents, across My Drive and shared drives. No file link is needed. Returns file names and links; use Read file to answer questions from their contents. Follow the next page token for more results.",
      "display_name": "Search files",
      "display_str_template": "Search files for '{0}'.",
      "handler": "actions.search_files",
      "id": "google_drive_search_files",
      "method": "POST",
      "mock_response": {
        "files": [
          {
            "description": "Company security policy",
            "id": "qa-file",
            "mime_type": "text/plain",
            "modified_time": "2026-01-01T00:00:00Z",
            "name": "Security policy.txt",
            "web_view_link": "https://drive.google.com/file/d/qa-file/view"
          }
        ],
        "incomplete_search": false,
        "next_page_token": ""
      },
      "name": "search_files",
      "output_formatter": "reading.format_search_files_output",
      "parameters": [
        {
          "description": "Words to find in file names or contents. All words must match. Leave empty to list recent files.",
          "display_name": "Query",
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional Drive folder link to search only its direct children. Leave empty to search across Drive.",
          "display_name": "Folder URL",
          "name": "folder_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 25,
          "description": "Files per page, from 1 to 100.",
          "display_name": "Page size",
          "maximum": 100,
          "minimum": 1,
          "name": "page_size",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Next page token from an earlier search with the same query.",
          "display_name": "Page token",
          "name": "page_token",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/search-files",
      "result_str_template": "Found files in Google Drive.",
      "returns": {
        "properties": {
          "files": {
            "items": {
              "properties": {
                "description": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "mime_type": {
                  "type": "string"
                },
                "modified_time": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "web_view_link": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "incomplete_search": {
            "description": "True when Drive could not search every shared drive. Narrow to a folder before claiming no matching files exist.",
            "type": "boolean"
          },
          "next_page_token": {
            "description": "Empty when there are no more pages.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "upload_file": {
      "description": "Upload a file to Drive and return a link to it.",
      "display_name": "Upload file",
      "display_str_template": "Upload file '{0}'.",
      "handler": "actions.upload_file",
      "id": "google_drive_upload_file",
      "method": "POST",
      "mock_response": {
        "upload_link": "https://drive.google.com/file/d/abc123/view"
      },
      "name": "upload_file",
      "output_formatter": "actions.format_upload_file_output",
      "parameters": [
        {
          "description": "The file to upload, chosen with the file picker.",
          "display_name": "File",
          "name": "file_path",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Google Drive folder URL to upload the file to.",
          "display_name": "Folder URL",
          "name": "folder_url",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The file's format, for example 'application/pdf'.",
          "display_name": "File type",
          "name": "mime_type",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/upload-file",
      "result_str_template": "Uploaded file to {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"upload_link\" field.",
        "properties": {
          "upload_link": {
            "description": "A link to the uploaded file",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    }
  },
  "categories": [
    "File Storage",
    "Google"
  ],
  "description": "Search, read, upload, and manage files in Google Drive.",
  "display_name": "Google Drive",
  "id": "google_drive",
  "logo": "https://www.lodol.com/app-icons/google-drive-icon.png",
  "triggers": {
    "google_drive_new_file_trigger": {
      "description": "Triggers when a new file is added to Google Drive.",
      "display_name": "New file",
      "id": "google_drive_new_file_trigger",
      "output": {
        "created_time": "string",
        "id": "string",
        "mime_type": "string",
        "modified_time": "string",
        "name": "string",
        "web_view_link": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Google Drive folder ID to watch. Leave blank to watch your whole Drive.",
          "display_name": "Folder",
          "name": "folder_id",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "Only trigger for files of this MIME type (e.g. application/pdf). Leave blank to match any type.",
          "display_name": "File type",
          "name": "mime_type",
          "required": false
        },
        {
          "arg_index": 2,
          "description": "Only trigger for files whose name contains this text. Leave blank to match any file.",
          "display_name": "File name filter",
          "name": "name_pattern",
          "required": false
        }
      ]
    }
  }
}
