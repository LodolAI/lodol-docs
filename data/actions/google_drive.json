{
  "actions": {
    "create_folder": {
      "description": "Create a folder in Google Drive and return a link to it.",
      "display_name": "Create folder",
      "display_str_template": "Create folder '{0}'.",
      "handler": "actions.create_folder",
      "id": "google_drive_create_folder",
      "method": "POST",
      "mock_response": {
        "folder_link": "https://drive.google.com/drive/folders/newfolder123"
      },
      "name": "create_folder",
      "output_formatter": "actions.format_create_folder_output",
      "parameters": [
        {
          "description": "The name of the folder to create.",
          "display_name": "Folder name",
          "name": "folder_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The Google Drive URL of the folder to create the new folder in.",
          "display_name": "Parent folder URL",
          "name": "parent_folder_url",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/create-folder",
      "result_str_template": "Created folder at {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"folder_link\" field.",
        "properties": {
          "folder_link": {
            "description": "A link to the created folder",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "delete_file": {
      "description": "Delete a file from Google Drive.",
      "display_name": "Delete file",
      "display_str_template": "Delete file '{0}'.",
      "handler": "actions.delete_file",
      "id": "google_drive_delete_file",
      "method": "POST",
      "mock_response": {
        "deleted": true
      },
      "name": "delete_file",
      "output_formatter": "actions.format_delete_file_output",
      "parameters": [
        {
          "description": "The Google Drive URL of the file to delete.",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/delete-file",
      "result_str_template": "Deleted file {0}.",
      "returns": {
        "description": "Response envelope; the payload is in the \"deleted\" field.",
        "properties": {
          "deleted": {
            "description": "Whether the file was deleted",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "download_file_from_url": {
      "description": "Download a Google Drive file given its sharing URL.",
      "display_name": "Download file from URL",
      "display_str_template": "Download file from '{0}'.",
      "handler": "actions.download_file_from_url",
      "id": "google_drive_download_file_from_url",
      "method": "POST",
      "mock_response": {
        "content_type": "application/pdf",
        "filename": "downloaded_file.txt",
        "size_bytes": 1024
      },
      "name": "download_file_from_url",
      "output_formatter": "actions.format_download_file_from_url_output",
      "parameters": [
        {
          "description": "The sharing URL of the Google Drive file.",
          "display_name": "File URL",
          "name": "file_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The folder to save the downloaded file in.",
          "display_name": "Download folder",
          "name": "download_dir",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-drive/download-file-from-url",
      "result_str_template": "Downloaded file to {0}.",
      "returns": {
        "properties": {
          "content_type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
