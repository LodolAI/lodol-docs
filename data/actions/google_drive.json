    "upload_file": {
      "description": "Upload a file to Google Drive and return a link to it.",
      "display_name": "Upload file",
      "display_str_template": "Upload file '{0}' to Google Drive.",
      "handler": "actions.upload_file",
      "id": "google_drive_upload_file",
      "method": "POST",
      "mock_response": {
        "upload_link": "https://drive.google.com/file/d/abc123/view"
      },
      "name": "upload_file",
      "output_formatter": "actions.format_upload_file_output",
      "parameters": [
        {
          "description": "The file to upload, chosen with the file picker.",
