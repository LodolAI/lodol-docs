{
  "actions": {
    "get_latest_series_values": {
      "description": "Get the most recent values of a Banco Central do Brasil time series (SGS), up to 20, oldest first, plus the latest value on its own. Handy for 'what is the Selic rate now?'. No API key required.",
      "display_name": "Get latest series values",
      "display_str_template": "Get the latest values of series {0}.",
      "handler": "actions.get_latest_series_values",
      "id": "banco_central_do_brasil_get_latest_series_values",
      "method": "POST",
      "mock_response": {
        "count": 3,
        "first_date": "2026-07-01",
        "latest_date": "2026-09-01",
        "latest_value": 0.82,
        "series_code": 433,
        "series_name": "IPCA consumer price inflation (% change in the month)",
        "values": [
          {
            "date": "2026-07-01",
            "end_date": null,
            "value": 0.07
          },
          {
            "date": "2026-08-01",
            "end_date": null,
            "value": -0.32
          },
          {
            "date": "2026-09-01",
            "end_date": null,
            "value": 0.82
          }
        ]
      },
      "name": "get_latest_series_values",
      "parameters": [
        {
          "description": "The SGS series code: 432 is the Selic target rate, 433 monthly IPCA inflation, 1 the US dollar, 189 the IGP-M. Find other codes at https://www3.bcb.gov.br/sgspub/.",
          "display_name": "Series",
          "examples": [
            {
              "label": "Selic target rate (432)",
              "value": "432"
            },
            {
              "label": "IPCA inflation, monthly (433)",
              "value": "433"
            },
            {
              "label": "US dollar, selling (1)",
              "value": "1"
            },
            {
              "label": "CDI rate, annualized (4389)",
              "value": "4389"
            },
            {
              "label": "IGP-M, monthly (189)",
              "value": "189"
            }
          ],
          "name": "series",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "How many of the latest values to get, from 1 to 20.",
          "display_name": "Number of values",
          "maximum": 20,
          "minimum": 1,
          "name": "count",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/banco-central-do-brasil/get-latest-series-values",
      "result_str_template": "The latest value is {banco_central_do_brasil_get_latest_series_values,latest_value} ({banco_central_do_brasil_get_latest_series_values,latest_date}).",
      "returns": {
        "properties": {
          "count": {
            "description": "How many values came back. 0 when the period has none.",
            "type": "integer"
          },
          "first_date": {
            "description": "The date of the oldest value, as YYYY-MM-DD.",
            "type": [
              "string",
              "null"
            ]
          },
          "latest_date": {
            "description": "The date of the most recent value, as YYYY-MM-DD.",
            "type": [
              "string",
              "null"
            ]
          },
          "latest_value": {
            "description": "The most recent value. Empty when no values came back.",
            "type": [
              "number",
              "null"
            ]
          },
          "series_code": {
            "description": "The SGS series code that was read, e.g. 432.",
            "type": "integer"
          },
          "series_name": {
            "description": "What the series measures and its unit, for well-known series (e.g. 'Selic target rate set by Copom (% per year)'). Empty for other codes.",
            "type": [
              "string",
              "null"
            ]
          },
          "values": {
            "description": "The values, oldest first.",
            "items": {
              "properties": {
                "date": {
                  "description": "The date the value is for, as YYYY-MM-DD. A monthly series uses the first day of the month.",
                  "type": "string"
                },
                "end_date": {
                  "description": "For a series measured over a period (such as the TR rate), the last day of that period, as YYYY-MM-DD. Empty for other series.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "description": "The value, in the series' own unit (a percent, R$...).",
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_ptax_rates": {
      "description": "Get the official PTAX exchange rates of a currency in reais for each business day of a period (up to a year): the closing rate by default, or every bulletin of the day. The PTAX closing rate is the reference used in Brazilian contracts and invoices. No API key required.",
      "display_name": "Get PTAX exchange rates",
      "display_str_template": "Get PTAX exchange rates from {0}.",
      "handler": "actions.get_ptax_rates",
      "id": "banco_central_do_brasil_get_ptax_rates",
