    "read": {
      "description": "Get what's inside a file: the rows of a CSV or Excel sheet, the text of a PDF or Word document, or the data in a JSON file. Works with an upload, an email attachment, or a file an earlier step downloaded.",
      "display_name": "Read a file",
      "display_str_template": "Read {file}",
      "handler": "_handled_by_executor",
      "id": "skipflow_files_read",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "data": null,
        "filename": "leads.csv",
        "headers": [
          "Name",
          "Email",
          "Company"
        ],
        "rows": [
          {
            "Company": "Acme Corp",
            "Email": "jordan@acme.test",
            "Name": "Jordan Lee"
          },
          {
            "Company": "Northwind",
            "Email": "sam@northwind.test",
            "Name": "Sam Rivera"
          }
        ],
        "text": "Name,Email,Company\nJordan Lee,jordan@acme.test,Acme Corp\nSam Rivera,sam@northwind.test,Northwind",
        "type": "csv"
      },
      "name": "read",
      "output_formatter": "format_read_output",
      "parameters": [
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "description": "The file to read. Upload one, or pick a file from an earlier step, such as an email attachment.",
          "display_name": "File",
          "name": "file",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "For an Excel file, the sheet to read. Leave empty for the first one.",
          "display_name": "Sheet",
          "name": "sheet",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "For a spreadsheet, use the first row as the column names. Turn this off when it starts straight into data; the columns are then named column_1, column_2, and so on.",
          "display_name": "First row is a header",
          "name": "has_header",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/core/files/read",
      "returns": {
        "description": "What's inside the file. A spreadsheet's rows are in 'rows', each keyed by its column header (row.Email); a document's words are in 'text'; a JSON file's value is in 'data'.",
        "examples": [
          {
            "count": 2,
            "data": null,
            "filename": "leads.csv",
            "headers": [
              "Name",
              "Email",
              "Company"
            ],
            "rows": [
              {
                "Company": "Acme Corp",
                "Email": "jordan@acme.test",
                "Name": "Jordan Lee"
              },
              {
                "Company": "Northwind",
                "Email": "sam@northwind.test",
                "Name": "Sam Rivera"
              }
            ],
            "text": "Name,Email,Company\nJordan Lee,jordan@acme.test,Acme Corp\nSam Rivera,sam@northwind.test,Northwind",
            "type": "csv"
          }
        ],
        "properties": {
          "count": {
            "description": "How many rows were read.",
            "type": "integer"
          },
          "data": {
            "description": "A JSON file's value: an object, a list, or a single value. Empty (null) for any other file."
          },
          "filename": {
            "description": "The file's name.",
            "type": "string"
          },
          "headers": {
            "description": "A spreadsheet's column names, in order. Empty for a document.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rows": {
            "description": "One object per data row of a spreadsheet, keyed by column header. Empty for a document.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "text": {
            "description": "Everything in the file as text: a document's words, or a spreadsheet's cells line by line.",
            "type": "string"
          },
          "type": {
            "description": "What kind of file it was.",
            "enum": [
              "csv",
              "excel",
              "pdf",
              "word",
              "json",
              "text"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    },
