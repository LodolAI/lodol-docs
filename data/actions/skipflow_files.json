{
  "actions": {
    "create": {
      "description": "Turn rows, text or data into a file you can attach to an email, upload to a drive, or download: a CSV or Excel spreadsheet, a PDF such as an invoice or a report, a text file, or JSON.",
      "display_name": "Create a file",
      "display_str_template": "Create {format}",
      "handler": "_handled_by_executor",
      "id": "skipflow_files_create",
      "method": "POST",
      "mock_response": {
        "content_type": "text/csv",
        "document_ref": "doc_8f14e45fceea167a5a36dedd4bea2543",
        "documents": [
          {
            "content_type": "text/csv",
            "document_ref": "doc_8f14e45fceea167a5a36dedd4bea2543",
            "filename": "Weekly leads.csv",
            "size_bytes": 2048
          }
        ],
        "filename": "Weekly leads.csv",
        "size_bytes": 2048
      },
      "name": "create",
      "output_formatter": "format_create_output",
      "parameters": [
        {
          "default": "csv",
          "description": "CSV and Excel files are spreadsheets made from rows. A PDF is a finished document, such as an invoice, a quote or a report, laid out from text. A text file holds text. JSON holds data for another system to read.",
          "display_name": "File type",
          "name": "format",
          "options": [
            {
              "label": "CSV file",
              "value": "csv"
            },
            {
              "label": "Excel file",
              "value": "excel"
            },
            {
              "label": "PDF file",
              "value": "pdf"
            },
            {
              "label": "Text file",
              "value": "text"
            },
            {
              "label": "JSON file",
              "value": "json"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The rows to write, such as the rows a sheet or an earlier step returned. Each row's fields become the columns, and their names the header row.",
          "display_name": "Rows",
          "name": "rows",
          "required": true,
          "type": "ParameterType.ARRAY",
          "visible_when": {
            "format": [
              "csv",
              "excel"
            ]
          }
        },
        {
          "description": "What the file says. For a PDF, write it in Markdown (# Heading, **bold**, tables) or HTML, and it is laid out on the page for you.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING",
          "visible_when": {
            "format": [
              "pdf",
              "text"
            ]
          }
        },
        {
          "description": "The data to save, such as an earlier step's result.",
          "display_name": "Data",
          "name": "data",
          "required": true,
          "type": "ParameterType.STRING",
          "visible_when": {
            "format": [
              "json"
            ]
          }
        },
        {
          "description": "What to call the file, such as Weekly leads. The right extension is added for you. Leave empty to call it data (or file, for text). A PDF is named after its title.",
          "display_name": "File name",
          "name": "filename",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/core/files/create",
      "returns": {
        "description": "The new file, kept for 30 days. Give document_ref to a step that takes a file, such as an email's attachments or a drive upload.",
        "examples": [
          {
            "content_type": "text/csv",
            "document_ref": "doc_8f14e45fceea167a5a36dedd4bea2543",
            "documents": [
              {
                "content_type": "text/csv",
                "document_ref": "doc_8f14e45fceea167a5a36dedd4bea2543",
                "filename": "Weekly leads.csv",
                "size_bytes": 2048
              }
            ],
            "filename": "Weekly leads.csv",
            "size_bytes": 2048
          }
        ],
        "properties": {
          "content_type": {
            "description": "The file's media type, such as text/csv.",
            "type": "string"
          },
          "document_ref": {
            "description": "The file, for a later step that takes one.",
            "type": "string"
          },
          "documents": {
            "description": "The same file as a one-item list, the shape steps that download files return.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "filename": {
            "description": "The file's name, extension included.",
            "type": "string"
          },
          "size_bytes": {
            "description": "The file's size in bytes.",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "edit_image": {
      "description": "Get a photo ready to post or send: resize or crop it to a post's size, add a watermark, and save it as a smaller JPG, PNG or WebP, all in one step.",
      "display_name": "Edit an image",
      "display_str_template": "Edit {image}",
      "handler": "_handled_by_executor",
      "id": "skipflow_files_edit_image",
      "method": "POST",
      "mock_response": {
        "content_type": "image/jpeg",
        "document_ref": "doc_45c48cce2e2d7fbdea1afc51c7c6ad26",
        "documents": [
          {
            "content_type": "image/jpeg",
            "document_ref": "doc_45c48cce2e2d7fbdea1afc51c7c6ad26",
            "filename": "Linen shirt.jpg",
            "size_bytes": 186420
          }
        ],
        "filename": "Linen shirt.jpg",
        "height": 1080,
        "size_bytes": 186420,
        "width": 1080
      },
      "name": "edit_image",
      "output_formatter": "format_edit_image_output",
      "parameters": [
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "description": "The photo to edit. Upload one, or pick one from an earlier step, such as an email attachment.",
          "display_name": "Image",
          "name": "image",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "original",
          "description": "Square and portrait posts suit Instagram and Facebook feeds, a story or reel fills a phone screen, and wide suits X, LinkedIn and YouTube.",
          "display_name": "Size",
          "name": "size",
          "options": [
            {
              "label": "Keep its size",
              "value": "original"
            },
            {
              "label": "Square post (1080 \u00d7 1080)",
              "value": "square"
            },
            {
              "label": "Portrait post (1080 \u00d7 1350)",
              "value": "portrait"
            },
            {
              "label": "Story or reel (1080 \u00d7 1920)",
              "value": "story"
            },
            {
              "label": "Wide (1920 \u00d7 1080)",
              "value": "wide"
            },
            {
              "label": "Custom size",
              "value": "custom"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "In pixels. Leave empty to follow the height and keep the photo's proportions.",
          "display_name": "Width",
          "maximum": 8000,
          "minimum": 1,
          "name": "width",
          "required": false,
          "type": "ParameterType.NUMBER",
          "visible_when": {
            "size": [
              "custom"
            ]
          }
        },
        {
          "description": "In pixels. Leave empty to follow the width and keep the photo's proportions.",
          "display_name": "Height",
          "maximum": 8000,
          "minimum": 1,
          "name": "height",
          "required": false,
          "type": "ParameterType.NUMBER",
          "visible_when": {
            "size": [
              "custom"
            ]
          }
        },
        {
          "default": "fill",
          "description": "When the photo's shape differs from the size: fill the frame by trimming the edges evenly, or show the whole photo with a white border around it.",
          "display_name": "Fit",
          "name": "fit",
          "options": [
            {
              "label": "Fill the frame",
              "value": "fill"
            },
            {
              "label": "Show the whole photo",
              "value": "whole"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING",
          "visible_when": {
            "size": [
              "square",
              "portrait",
              "story",
              "wide",
              "custom"
            ]
          }
        },
        {
          "default": "none",
          "description": "Your name or logo in a corner, so the photo stays yours wherever it's shared.",
          "display_name": "Watermark",
          "name": "watermark",
          "options": [
            {
              "label": "None",
              "value": "none"
            },
            {
              "label": "Text",
              "value": "text"
            },
            {
              "label": "Logo",
              "value": "logo"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Such as \u00a9 Acme Store or @acmestore.",
          "display_name": "Watermark text",
          "name": "watermark_text",
          "required": true,
          "type": "ParameterType.STRING",
          "visible_when": {
            "watermark": [
              "text"
            ]
          }
        },
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "description": "The logo to stamp on the photo. A PNG with a see-through background looks best.",
          "display_name": "Logo",
          "name": "logo",
          "required": true,
          "type": "ParameterType.STRING",
          "visible_when": {
            "watermark": [
              "logo"
            ]
          }
        },
        {
          "default": "bottom_right",
          "description": "Where on the photo the watermark goes.",
          "display_name": "Watermark position",
          "name": "position",
          "options": [
            {
              "label": "Bottom right",
              "value": "bottom_right"
            },
            {
              "label": "Bottom left",
              "value": "bottom_left"
            },
            {
              "label": "Top right",
              "value": "top_right"
            },
            {
              "label": "Top left",
              "value": "top_left"
            },
            {
              "label": "Center",
              "value": "center"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING",
          "visible_when": {
            "watermark": [
              "text",
              "logo"
            ]
          }
        },
        {
          "default": "original",
          "description": "JPG suits photos and opens everywhere. PNG keeps see-through backgrounds and sharp graphics. WebP is the smallest, for websites. Keeping the original's type saves a GIF, BMP or TIFF as a PNG.",
          "display_name": "Save as",
          "name": "format",
          "options": [
            {
              "label": "Same as the original",
              "value": "original"
            },
            {
              "label": "JPG",
              "value": "jpg"
            },
            {
              "label": "PNG",
              "value": "png"
            },
            {
              "label": "WebP",
              "value": "webp"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "balanced",
          "description": "How much to shrink the file. Balanced looks right in a post at a fraction of the size; strong suits a size limit, such as a marketplace's or an email's.",
          "display_name": "Compression",
          "name": "compression",
          "options": [
            {
              "label": "Light: best quality",
              "value": "light"
            },
            {
              "label": "Balanced",
              "value": "balanced"
            },
            {
              "label": "Strong: smallest file",
              "value": "strong"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to call the edited image. The right extension is added for you. Leave empty to keep the original's name.",
          "display_name": "File name",
          "name": "filename",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
