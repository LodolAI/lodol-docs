                    "name": {
                      "description": "Display name",
                      "type": "string"
                    },
                    "slug": {
                      "description": "Unique service identifier",
                      "type": "string"
                    },
                    "status_page_url": {
                      "description": "Full URL to the IsItDownStatus page for this service",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "source": {
                  "description": "Where the outage was detected: 'user_reports' or 'official_status_page'",
                  "type": "string"
                },
                "started_at": {
                  "description": "ISO 8601 timestamp of when the outage was detected",
                  "type": "string"
                },
                "status": {
                  "description": "Outage lifecycle: 'ongoing' or 'resolved'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "description": "Number of outages returned",
            "type": "number"
          },
          "updated_at": {
            "description": "ISO 8601 timestamp of this response",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
