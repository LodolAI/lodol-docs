{
  "actions": {
    "get_status": {
      "description": "Get the current status for a single service by its slug (for example 'discord' or 'netflix'). The status combines crowdsourced user reports with the service's official status page.",
      "display_name": "Get service status",
      "display_str_template": "Get IsItDownStatus status for '{0}'.",
      "handler": "actions.get_status",
      "id": "isitdownstatus_get_status",
      "method": "POST",
      "mock_response": {
        "category": "social",
        "logo_url": "https://isitdownstatus.com/logos/discord.png",
        "name": "Discord",
        "official_indicator": null,
        "report_count_1h": 2,
        "report_count_24h": 18,
        "slug": "discord",
        "status": "operational",
        "status_page_url": "https://isitdownstatus.com/en/status/discord",
        "updated_at": "2026-04-26T12:00:00.000Z"
      },
      "name": "get_status",
      "parameters": [
        {
          "description": "The service's slug, a lowercase identifier such as 'discord', 'netflix', or 'cloudflare'.",
          "display_name": "Service slug",
          "examples": [
            {
              "label": "Discord",
              "value": "discord"
            },
            {
              "label": "Netflix",
              "value": "netflix"
            },
            {
              "label": "Cloudflare",
              "value": "cloudflare"
            }
          ],
          "name": "slug",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/isitdownstatus/get-status",
      "result_str_template": "Fetched the service status.",
      "returns": {
        "properties": {
          "category": {
            "description": "Category slug",
            "type": "string"
          },
          "logo_url": {
            "description": "Service logo URL, if available",
            "nullable": true,
            "type": "string"
          },
          "name": {
            "description": "Display name",
            "type": "string"
          },
          "official_indicator": {
            "description": "Raw value from the service's official status page: 'none', 'minor', 'major', or 'critical', or null when no official page is available.",
            "nullable": true,
            "type": "string"
          },
          "report_count_1h": {
            "description": "Problem reports in the last hour",
            "type": "number"
          },
          "report_count_24h": {
            "description": "Problem reports in the last 24 hours",
            "type": "number"
          },
          "slug": {
            "description": "Unique service identifier",
            "type": "string"
          },
          "status": {
            "description": "Combined status signal: 'operational' (reports within normal range, no official incident), 'degraded' (elevated reports or a minor official incident), or 'down' (significantly elevated reports or a major/critical official incident).",
            "type": "string"
          },
          "status_page_url": {
            "description": "Full URL to the IsItDownStatus page",
            "type": "string"
          },
          "updated_at": {
            "description": "ISO 8601 timestamp of this response",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_outages": {
