          ],
          "name": "slug",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of outages to return (1\u2013100). Defaults to 20.",
          "display_name": "Limit",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
