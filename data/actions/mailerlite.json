{
  "actions": {
    "assign_subscriber_to_group": {
      "description": "Add an existing subscriber to a MailerLite group.",
      "display_name": "Assign subscriber to group",
      "display_str_template": "Assign subscriber '{0}' to group '{1}'.",
      "handler": "actions.assign_subscriber_to_group",
      "id": "mailerlite_assign_subscriber_to_group",
      "method": "POST",
      "mock_response": {
        "group_id": "31897444756455121",
        "subscriber_id": "31897397363737764"
      },
      "name": "assign_subscriber_to_group",
      "parameters": [
        {
          "description": "Numeric ID of the subscriber (as returned by Create subscriber or Get subscriber), not the email address.",
          "display_name": "Subscriber ID",
          "name": "subscriber_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the group to add the subscriber to.",
          "display_name": "Group ID",
          "name": "group_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailerlite/assign-subscriber-to-group",
      "result_str_template": "Assigned MailerLite subscriber to group.",
      "returns": {
        "properties": {
          "group_id": {
            "description": "ID of the group the subscriber was added to.",
            "type": "string"
          },
          "subscriber_id": {
            "description": "ID of the subscriber that was assigned.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
    "create_group": {
      "description": "Create a new group (list) in your MailerLite account.",
      "display_name": "Create group",
      "display_str_template": "Create group '{0}'.",
      "handler": "actions.create_group",
      "id": "mailerlite_create_group",
      "method": "POST",
      "mock_response": {
        "id": "31897444756455121",
        "name": "Newsletter"
      },
      "name": "create_group",
      "parameters": [
        {
          "description": "Name of the group to create.",
          "display_name": "Name",
          "examples": [
            {
              "label": "Group name",
              "value": "Newsletter"
            }
          ],
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailerlite/create-group",
      "result_str_template": "Created MailerLite group.",
      "returns": {
        "properties": {
          "id": {
            "description": "ID of the newly created group.",
            "type": "string"
          },
          "name": {
            "description": "Name of the group.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_subscriber": {
      "description": "Add a subscriber to your MailerLite account, or update them if the email already exists (a non-destructive upsert).",
      "display_name": "Create or update subscriber",
      "display_str_template": "Create subscriber '{0}'.",
      "handler": "actions.create_subscriber",
      "id": "mailerlite_create_subscriber",
      "method": "POST",
      "mock_response": {
        "email": "jane@example.com",
        "id": "31897397363737764",
        "status": "active"
      },
      "name": "create_subscriber",
      "parameters": [
        {
          "description": "Email address of the subscriber.",
          "display_name": "Email",
          "examples": [
            {
              "label": "Email",
              "value": "jane@example.com"
            }
          ],
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "First name of the subscriber.",
          "display_name": "Name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Last name of the subscriber.",
          "display_name": "Last name",
          "name": "last_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Subscription status to set. Leave unset to use your account's default (typically 'unconfirmed' when double opt-in is on, otherwise 'active').",
          "display_name": "Status",
          "name": "status",
          "options": [
            {
              "label": "Active",
              "value": "active"
            },
            {
              "label": "Unconfirmed",
              "value": "unconfirmed"
            },
            {
              "label": "Unsubscribed",
              "value": "unsubscribed"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailerlite/create-subscriber",
      "result_str_template": "Created MailerLite subscriber.",
      "returns": {
        "properties": {
          "email": {
            "description": "Email address of the subscriber.",
            "type": "string"
          },
          "id": {
            "description": "ID of the subscriber (new or already existing).",
            "type": "string"
          },
          "status": {
            "description": "Subscription status after the upsert.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "get_subscriber": {
      "description": "Look up a MailerLite subscriber by email address.",
      "display_name": "Get subscriber",
      "display_str_template": "Get subscriber '{0}'.",
      "handler": "actions.get_subscriber",
      "id": "mailerlite_get_subscriber",
      "method": "POST",
      "mock_response": {
        "subscriber": {
          "email": "jane@example.com",
          "id": "31897397363737764",
          "last_name": "Doe",
          "name": "Jane",
          "status": "active"
        }
      },
      "name": "get_subscriber",
      "parameters": [
        {
          "description": "Email address of the subscriber to look up. A numeric subscriber ID also works.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/mailerlite/get-subscriber",
      "result_str_template": "Retrieved MailerLite subscriber.",
      "returns": {
        "properties": {
          "subscriber": {
            "description": "The matching subscriber, or null if no subscriber has that email.",
            "nullable": true,
            "properties": {
              "email": {
                "description": "Subscriber email address",
                "type": "string"
              },
              "id": {
                "description": "Subscriber ID",
                "type": "string"
              },
              "last_name": {
                "description": "Last name, if set",
                "type": "string"
              },
              "name": {
                "description": "First name, if set",
                "type": "string"
              },
              "status": {
                "description": "Subscription status, e.g. 'active' or 'unsubscribed'.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "list_groups": {
      "description": "List the groups in your MailerLite account.",
      "display_name": "List groups",
      "display_str_template": "List groups.",
      "handler": "actions.list_groups",
      "id": "mailerlite_list_groups",
      "method": "POST",
      "mock_response": {
        "groups": [
          {
            "id": "31897444756455121",
            "name": "Newsletter"
          }
        ]
      },
      "name": "list_groups",
      "parameters": [],
      "path": "/actions/library/mailerlite/list-groups",
      "result_str_template": "Fetched MailerLite groups.",
      "returns": {
        "properties": {
          "groups": {
            "description": "Groups in the account",
            "items": {
              "properties": {
                "id": {
                  "description": "Group ID. Use with assign_subscriber_to_group.",
                  "type": "string"
                },
                "name": {
                  "description": "Group name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    }
  },
  "categories": [
    "Email Marketing"
  ],
  "description": "Connect your MailerLite account to manage subscribers and groups: create or update subscribers, look them up, and organize them into groups.",
  "display_name": "MailerLite",
  "id": "mailerlite",
  "logo": "https://www.lodol.com/app-icons/mailerlite-icon.png",
  "triggers": {
    "mailerlite_form_submitted_trigger": {
      "description": "Runs when someone signs up through one of your MailerLite embedded or pop-up forms, with their email, name and fields. Sign-ups from before the workflow is turned on don't start it, and someone who signs up through the same form twice starts it once. If more than 100 people sign up between two checks, some may be missed. How often it checks follows your workspace plan.",
      "display_name": "Form submitted",
      "id": "mailerlite_form_submitted_trigger",
      "output": {
        "created_at": "When they were first added.",
        "email": "Their email address.",
        "fields": "Every field MailerLite holds for them.",
        "form_id": "The form's ID in MailerLite.",
        "last_name": "Their last name, if set.",
        "name": "Their first name, if set.",
        "source": "How they were added, such as a form or an import.",
        "status": "Their status, such as active or unsubscribed.",
        "subscribed_at": "When they subscribed.",
        "subscriber_id": "The subscriber's ID in MailerLite."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The sign-up form to watch.",
          "display_name": "Form",
          "name": "form_id",
          "required": true
        }
      ]
    },
    "mailerlite_new_subscriber_trigger": {
      "description": "Runs when someone new subscribes in MailerLite, or subscribes into one group, with their email, name and fields. Someone who has to confirm by email starts it once they confirm. People already subscribed when the workflow is turned on don't start it, and neither does an existing subscriber later added to the group. How often it checks follows your workspace plan.",
      "display_name": "New subscriber",
      "id": "mailerlite_new_subscriber_trigger",
      "output": {
        "created_at": "When they were first added.",
        "email": "Their email address.",
        "fields": "Every field MailerLite holds for them.",
        "last_name": "Their last name, if set.",
        "name": "Their first name, if set.",
        "source": "How they were added, such as a form or an import.",
        "status": "Their status, such as active or unsubscribed.",
        "subscribed_at": "When they subscribed.",
        "subscriber_id": "The subscriber's ID in MailerLite."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only new subscribers in this group. Leave blank for every new subscriber.",
          "display_name": "Group",
          "name": "group_id",
          "required": false
        }
      ]
    },
    "mailerlite_subscriber_unsubscribed_trigger": {
      "description": "Runs each time someone unsubscribes from your MailerLite emails, with their email, name and when they left. People who unsubscribed before the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "Subscriber unsubscribed",
      "id": "mailerlite_subscriber_unsubscribed_trigger",
      "output": {
        "created_at": "When they were first added.",
        "email": "Their email address.",
        "fields": "Every field MailerLite holds for them.",
        "last_name": "Their last name, if set.",
        "name": "Their first name, if set.",
        "source": "How they were added, such as a form or an import.",
        "status": "Their status, such as active or unsubscribed.",
        "subscribed_at": "When they subscribed.",
        "subscriber_id": "The subscriber's ID in MailerLite.",
        "unsubscribed_at": "When they unsubscribed."
      },
      "parameters": []
    }
  }
}
