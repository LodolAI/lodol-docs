{
  "actions": {
    "predict_gender": {
      "description": "Predict the gender most likely behind a name. Enter a first name or a full name; with a full name, the surname is read too and returned on its own. Choose a country to read the name the way that country uses it.",
      "display_name": "Predict gender",
      "display_str_template": "Predict gender for '{0}'.",
      "handler": "actions.predict_gender",
      "id": "gender_api_predict_gender",
      "method": "POST",
      "mock_response": {
        "credits_used": 1,
        "duration": "38ms",
        "first_name": "Sandra",
        "gender": "female",
        "last_name": "Miller",
        "probability": 0.95,
        "result_found": true,
        "samples": 8765
      },
      "name": "predict_gender",
      "parameters": [
        {
          "description": "A first name, such as Alex, or a full name, such as Alex Smith",
          "display_name": "Name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Two-letter country code (for example, US or DE) to tailor the prediction to that country",
          "display_name": "Country",
          "name": "country",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/gender-api/predict",
      "result_str_template": "Gender prediction: {0} (probability {1}).",
      "returns": {
        "properties": {
          "credits_used": {
            "description": "Number of API credits consumed",
            "type": "number"
          },
          "duration": {
            "description": "Request duration",
            "type": "string"
          },
          "first_name": {
            "description": "The detected first name",
            "type": "string"
          },
          "gender": {
            "description": "Predicted gender: male, female, or unknown",
            "type": "string"
          },
          "last_name": {
            "description": "The surname, when a full name was entered",
            "type": "string"
          },
          "probability": {
            "description": "Confidence probability (0-1)",
            "type": "number"
          },
          "result_found": {
            "description": "Whether a result was found",
            "type": "boolean"
          },
          "samples": {
            "description": "Number of samples used",
            "type": "number"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    }
  },
  "categories": [
    "Lead Enrichment",
    "Utilities"
  ],
  "description": "Predict gender for names using Gender API.",
  "display_name": "Gender API",
  "id": "gender_api",
  "logo": "https://www.lodol.com/app-icons/gender-api-icon.png",
  "triggers": {}
}
