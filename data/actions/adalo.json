          }
        ]
      },
      "name": "list_records",
      "output_formatter": "actions.format_records",
      "parameters": [
        {
          "description": "The collection. Pick one saved on the connection, or give its ID (it starts with t_) or the endpoint address from the collection's API Documentation in Adalo.",
          "display_name": "Collection",
          "dynamic_source": "collections",
          "dynamic_source_allows_custom": true,
          "name": "collection_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only records whose value for this property equals 'Match value'. Text, number, true/false and date properties only.",
          "display_name": "Match property",
          "dynamic_source": "fields",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "collection_id"
          ],
          "name": "filter_key",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The value 'Match property' must equal, such as Open or 42.",
          "display_name": "Match value",
          "name": "filter_value",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many records to return, 1 to 1,000. Adalo's default is 100.",
          "display_name": "Page size",
          "maximum": 1000,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How many records to skip, oldest first: 0 for the first page, or the 'next_offset' an earlier page gave.",
          "display_name": "Start at",
          "minimum": 0,
          "name": "offset",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/adalo/list-records",
      "result_str_template": "Records retrieved.",
      "returns": {
        "properties": {
          "collection_id": {
            "description": "The collection's ID",
            "type": "string"
          },
          "count": {
            "description": "How many are on this page",
            "type": "integer"
          },
          "has_more": {
            "description": "Whether the page was full, so more may follow",
            "type": "boolean"
          },
          "next_offset": {
            "description": "Where the next page starts",
