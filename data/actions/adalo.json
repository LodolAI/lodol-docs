    "send_push_notification": {
      "description": "Send a push notification to one user of the app, by their email address or user ID. Tapping it opens the app's home screen.",
      "display_name": "Send push notification",
      "display_str_template": "Send an Adalo push notification.",
      "handler": "actions.send_push_notification",
      "id": "adalo_send_push_notification",
      "method": "POST",
      "mock_response": {
        "delivered": true,
        "failed": 0,
        "recipient": "jo@example.com",
        "successful": 1
      },
      "name": "send_push_notification",
      "output_formatter": "actions.format_notification",
      "parameters": [
        {
          "description": "The notification's title.",
          "display_name": "Title",
          "examples": [
            {
              "label": "A title",
              "value": "Your order is ready"
            }
          ],
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The notification's text.",
          "display_name": "Message",
          "multiline": true,
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The email address the user signed up to the app with. Give this or 'Recipient user ID'.",
          "display_name": "Recipient email",
          "name": "recipient_email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The user's record ID in the app's Users collection. Give this or 'Recipient email'.",
          "display_name": "Recipient user ID",
          "name": "recipient_user_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/adalo/send-push-notification",
      "result_str_template": "Push notification sent.",
      "returns": {
        "properties": {
          "delivered": {
            "description": "Whether it reached at least one device",
            "type": "boolean"
          },
          "failed": {
            "description": "Devices that have turned notifications off",
            "type": "integer"
          },
          "recipient": {
            "description": "The email address or user ID it was sent to",
            "type": "string"
          },
          "successful": {
            "description": "Devices it was delivered to",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
