{
  "actions": {
    "create_record": {
      "description": "Add a record to a collection, with values for its properties.",
      "display_name": "Create record",
      "display_str_template": "Create a record in Adalo collection {collection_id}.",
      "handler": "actions.create_record",
      "id": "adalo_create_record",
      "method": "POST",
      "mock_response": {
        "collection_id": "t_c9422c2457064383b6fb8e75a3cb",
        "created_at": "2026-11-10T09:00:00.000Z",
        "id": 42,
        "record": {
          "Email": "jo@example.com",
          "Name": "Jo Bloggs",
          "Paid": false,
          "Quantity": 3,
          "Status": "Open",
          "created_at": "2026-11-10T09:00:00.000Z",
          "id": 42,
          "updated_at": "2026-11-10T09:00:00.000Z"
