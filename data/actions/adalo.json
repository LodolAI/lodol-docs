    "list_records": {
      "description": "List a page of a collection's records, oldest first, optionally only those whose property equals a value. Gets one page; to see more, run it again starting at the next offset it gives.",
      "display_name": "List records",
      "display_str_template": "List records in Adalo collection {collection_id}.",
      "handler": "actions.list_records",
      "id": "adalo_list_records",
      "method": "POST",
      "mock_response": {
        "collection_id": "t_c9422c2457064383b6fb8e75a3cb",
        "count": 1,
        "has_more": false,
        "next_offset": 1,
        "offset": 0,
        "records": [
          {
