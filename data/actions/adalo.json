      },
      "name": "create_record",
      "output_formatter": "actions.format_record",
      "parameters": [
        {
          "description": "The collection. Pick one saved on the connection, or give its ID (it starts with t_) or the endpoint address from the collection's API Documentation in Adalo.",
          "display_name": "Collection",
          "dynamic_source": "collections",
          "dynamic_source_allows_custom": true,
          "name": "collection_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Each property's name, as in Adalo, with its value, such as Name: Jo. Properties left out are left empty.",
          "display_name": "Fields",
          "dynamic_source": "fields",
          "dynamic_source_depends_on": [
            "collection_id"
          ],
          "name": "fields",
          "object_key_name": "Property",
          "required": true,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/adalo/create-record",
      "result_str_template": "Record created.",
      "returns": {
        "properties": {
          "collection_id": {
            "description": "The collection's ID",
            "type": "string"
          },
          "created_at": {
            "description": "When the record was added (ISO 8601), empty if Adalo gave none",
            "type": "string"
          },
          "id": {
            "description": "The record's ID",
            "type": "integer"
          },
          "record": {
            "description": "Every property of the record by name, as Adalo gives it",
            "type": "object"
          },
          "updated_at": {
            "description": "When the record last changed (ISO 8601), empty if Adalo gave none",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
