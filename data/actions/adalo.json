  "triggers": {
    "adalo_new_record_trigger": {
      "description": "Runs when a record is added to an Adalo collection, such as a new sign-up or order made in your app, with all its properties. Records already there when the workflow is turned on don't start it.",
      "display_name": "New record",
      "id": "adalo_new_record_trigger",
      "output": {
        "collection_id": "The collection's ID",
        "created_at": "When the record was added (ISO 8601)",
        "id": "The record's ID, for the other Adalo steps",
        "record": "Every property of the record by name",
        "updated_at": "When the record last changed (ISO 8601)"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The collection to watch: one saved on the connection, or its ID from the collection's API Documentation in Adalo.",
          "display_name": "Collection",
          "name": "collection_id",
          "required": true
        }
