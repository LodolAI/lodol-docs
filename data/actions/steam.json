{
  "actions": {
    "get_friend_list": {
      "description": "List a Steam user's friends. The target profile's friends list must be public.",
      "display_name": "Get friend list",
      "display_str_template": "Get friends for Steam ID '{0}'.",
      "handler": "actions.get_friend_list",
      "id": "steam_get_friend_list",
      "method": "POST",
      "mock_response": {
        "friends": [
          {
            "friend_since": 1512803400,
            "relationship": "friend",
            "steamid": "76561198000000001"
          }
        ]
      },
      "name": "get_friend_list",
      "parameters": [
        {
          "description": "The Steam ID of the user whose friends you want to list.",
          "display_name": "Steam ID",
          "name": "steam_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "all",
          "description": "Which relationships to include: 'all' (the default) or 'friend'.",
          "display_name": "Relationship",
          "name": "relationship",
          "options": [
            {
              "label": "All relationships",
              "value": "all"
            },
            {
              "label": "Friends only",
              "value": "friend"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/steam/friend-list",
      "result_str_template": "Friend list retrieved.",
      "returns": {
        "properties": {
          "friends": {
            "description": "The user's friends.",
            "items": {
              "properties": {
                "friend_since": {
                  "description": "Unix timestamp of when the friendship began.",
                  "type": "integer"
                },
                "relationship": {
                  "description": "Relationship type, e.g. 'friend'.",
                  "type": "string"
                },
                "steamid": {
                  "description": "The friend's Steam ID.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_owned_games": {
      "description": "List the games a Steam user owns.",
      "display_name": "Get owned games",
      "display_str_template": "Get owned games for Steam ID '{0}'.",
      "handler": "actions.get_owned_games",
      "id": "steam_get_owned_games",
      "method": "POST",
      "mock_response": {
        "games": [
          {
            "appid": 570,
            "name": "Dota 2",
            "playtime_forever": 120
          }
        ]
      },
      "name": "get_owned_games",
      "parameters": [
        {
          "description": "The Steam ID of the user whose games you want to list.",
          "display_name": "Steam ID",
          "name": "steam_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Set to true to include each game's name and images.",
          "display_name": "Include game details",
          "name": "include_appinfo",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/steam/owned-games",
      "result_str_template": "Owned games retrieved.",
      "returns": {
        "properties": {
          "games": {
            "description": "Owned games.",
            "items": {
              "properties": {
                "appid": {
                  "description": "App ID.",
                  "type": "integer"
                },
                "name": {
                  "description": "Game name.",
                  "type": "string"
                },
                "playtime_forever": {
                  "description": "Playtime in minutes.",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_player_summaries": {
      "description": "Look up Steam player profiles by Steam ID.",
      "display_name": "Get player profiles",
      "display_str_template": "Get Steam player profiles.",
      "handler": "actions.get_player_summaries",
      "id": "steam_get_player_summaries",
      "method": "POST",
      "mock_response": {
        "players": [
          {
            "personaname": "PlayerOne",
            "profileurl": "https://steamcommunity.com/id/playerone/",
            "steamid": "76561198000000000"
          }
        ]
      },
      "name": "get_player_summaries",
      "parameters": [
        {
          "description": "The Steam IDs of the players to look up.",
          "display_name": "Steam IDs",
          "name": "steam_ids",
          "required": true,
          "type": "ParameterType.ARRAY"
        }
      ],
      "path": "/actions/library/steam/player-summaries",
      "result_str_template": "Player profiles retrieved.",
      "returns": {
        "properties": {
          "players": {
            "description": "Player profiles.",
            "items": {
              "properties": {
                "personaname": {
                  "description": "Display name.",
                  "type": "string"
                },
                "profileurl": {
                  "description": "Profile URL.",
                  "type": "string"
                },
                "steamid": {
                  "description": "Steam ID.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_recently_played_games": {
      "description": "List the games a Steam user has played in the last two weeks.",
      "display_name": "Get recently played games",
      "display_str_template": "Get recently played games for Steam ID '{0}'.",
      "handler": "actions.get_recently_played_games",
      "id": "steam_get_recently_played_games",
      "method": "POST",
      "mock_response": {
        "games": [
          {
            "appid": 730,
            "name": "Counter-Strike 2",
            "playtime_2weeks_hours": 5.5,
            "playtime_hours": 320.0
          }
        ]
      },
      "name": "get_recently_played_games",
      "parameters": [
        {
          "description": "The Steam ID of the user whose recent games you want.",
          "display_name": "Steam ID",
          "name": "steam_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of games to return (default: all).",
          "display_name": "Count",
          "minimum": 1,
          "name": "count",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/steam/recently-played-games",
      "result_str_template": "Recently played games retrieved.",
      "returns": {
        "properties": {
          "games": {
            "description": "Games played in the last two weeks.",
            "items": {
              "properties": {
                "appid": {
                  "description": "App ID.",
                  "type": "integer"
                },
                "name": {
                  "description": "Game name.",
                  "type": "string"
                },
                "playtime_2weeks_hours": {
                  "description": "Hours played in the last two weeks.",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "resolve_vanity_url": {
      "description": "Convert a Steam custom (vanity) profile name into its 64-bit Steam ID, which the other actions require.",
      "display_name": "Resolve vanity URL",
      "display_str_template": "Resolve Steam vanity URL '{0}'.",
      "handler": "actions.resolve_vanity_url",
      "id": "steam_resolve_vanity_url",
      "method": "POST",
      "mock_response": {
        "steamid": "76561197960287930",
        "vanity_url": "gabelogannewell"
      },
      "name": "resolve_vanity_url",
      "parameters": [
        {
          "description": "The custom name from a profile's web address, for example 'gabelogannewell' in steamcommunity.com/id/gabelogannewell. A full profile URL is also accepted.",
          "display_name": "Vanity URL or name",
          "name": "vanity_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 1,
          "description": "What the name refers to: 1 for an individual profile (the default), 2 for a group, or 3 for an official game group.",
          "display_name": "URL type",
          "maximum": 3,
          "minimum": 1,
          "name": "url_type",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/steam/resolve-vanity-url",
      "result_str_template": "Resolved to Steam ID {steamid}.",
      "returns": {
        "properties": {
          "steamid": {
            "description": "The resolved 64-bit Steam ID.",
            "type": "string"
          },
          "vanity_url": {
            "description": "The vanity name that was resolved.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Look up Steam player profiles, resolve vanity URLs to Steam IDs, and list the games people own, have played recently, and their friends.",
  "display_name": "Steam",
  "id": "steam"
}
