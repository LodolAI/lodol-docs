{
  "actions": {
    "get_current_conditions": {
      "description": "Get the current weather conditions for a location.",
      "display_name": "Get current conditions",
      "display_str_template": "Get current conditions for location '{0}'.",
      "handler": "actions.get_current_conditions",
      "id": "accuweather_get_current_conditions",
      "method": "POST",
      "mock_response": {
        "observed_at": "2026-01-15T13:00:00-05:00",
        "temperature_celsius": 12.8,
        "temperature_fahrenheit": 55.0,
        "weather_text": "Mostly cloudy"
      },
      "name": "get_current_conditions",
      "parameters": [
        {
          "description": "AccuWeather location key, from search-location.",
          "display_name": "Location key",
          "name": "location_key",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/accuweather/get-current-conditions",
      "result_str_template": "Retrieved current conditions.",
      "returns": {
        "properties": {
          "observed_at": {
            "description": "Timestamp the conditions were observed",
            "type": "string"
          },
          "temperature_celsius": {
            "description": "Current temperature in Celsius",
            "type": "number"
          },
          "temperature_fahrenheit": {
            "description": "Current temperature in Fahrenheit",
            "type": "number"
          },
          "weather_text": {
            "description": "Short conditions summary, for example 'Mostly cloudy'",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_daily_forecast": {
      "description": "Get the 5-day weather forecast for a location.",
      "display_name": "Get daily forecast",
      "display_str_template": "Get 5-day forecast for location '{0}'.",
      "handler": "actions.get_daily_forecast",
      "id": "accuweather_get_daily_forecast",
      "method": "POST",
      "mock_response": {
        "days": [
          {
            "date": "2026-01-15T07:00:00-05:00",
            "day_summary": "Partly sunny",
            "max_temperature": -2.8,
            "min_temperature": -6.1,
            "night_summary": "Partly cloudy"
          }
        ],
        "headline": "Warmer temperatures expected this weekend",
        "unit": "C"
      },
      "name": "get_daily_forecast",
      "parameters": [
        {
          "description": "AccuWeather location key, from search-location.",
          "display_name": "Location key",
          "name": "location_key",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": true,
          "description": "Return temperatures in Celsius instead of Fahrenheit.",
          "display_name": "Use metric units",
          "name": "metric",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/accuweather/get-daily-forecast",
      "result_str_template": "Retrieved the forecast.",
      "returns": {
        "properties": {
          "days": {
            "description": "One entry per forecast day",
            "items": {
              "properties": {
                "date": {
                  "description": "Date this forecast is for",
                  "type": "string"
                },
                "day_summary": {
                  "description": "Short daytime conditions summary, for example 'Partly sunny'",
                  "type": "string"
                },
                "max_temperature": {
                  "description": "Maximum forecast temperature, in the requested unit",
                  "type": "number"
                },
                "min_temperature": {
                  "description": "Minimum forecast temperature, in the requested unit",
                  "type": "number"
                },
                "night_summary": {
                  "description": "Short nighttime conditions summary, for example 'Partly cloudy'",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "headline": {
            "description": "AccuWeather's headline summary for the forecast period",
            "type": "string"
          },
          "unit": {
            "description": "Temperature unit used for min_temperature/max_temperature, 'C' or 'F'",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "search_location": {
      "description": "Search for a city or place and get its AccuWeather location key.",
      "display_name": "Search location",
      "display_str_template": "Search AccuWeather locations for '{0}'.",
      "handler": "actions.search_location",
      "id": "accuweather_search_location",
      "method": "POST",
      "mock_response": {
        "locations": [
          {
            "administrative_area": "Washington",
            "country": "United States",
            "location_key": "349727",
            "name": "Seattle"
          }
        ]
      },
      "name": "search_location",
      "parameters": [
        {
          "description": "City name or postal code to search for, for example 'Seattle' or 'London, UK'.",
          "display_name": "Query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/accuweather/search-location",
      "result_str_template": "Fetched matching locations.",
      "returns": {
        "properties": {
          "locations": {
            "description": "Matching locations",
            "items": {
              "properties": {
                "administrative_area": {
                  "description": "State or province name",
                  "type": "string"
                },
                "country": {
                  "description": "Country name",
                  "type": "string"
                },
                "location_key": {
                  "description": "Location key. Use with get-current-conditions and get-daily-forecast.",
                  "type": "string"
                },
                "name": {
                  "description": "City name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Connect your AccuWeather account to look up locations and check current conditions and forecasts.",
  "display_name": "AccuWeather",
  "id": "accuweather"
}
