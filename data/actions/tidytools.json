{
  "actions": {
    "check_ai_crawler_access": {
      "description": "Check any website right now: which of 29 AI crawlers, such as ChatGPT's GPTBot, Claude's ClaudeBot and PerplexityBot, its robots.txt file lets in, partly blocks or shuts out, with the exact rule behind each one. Also says whether it has an llms.txt file and Content Signals, scores how visible it is to AI search out of 100, and gives ready-to-paste robots.txt lines that fix any AI search crawlers blocked by mistake.",
      "display_name": "Check which AI crawlers a website allows",
      "display_str_template": "Check which AI crawlers {0} allows.",
      "handler": "actions.check_ai_crawler_access",
      "id": "tidytools_check_ai_crawler_access",
      "method": "POST",
