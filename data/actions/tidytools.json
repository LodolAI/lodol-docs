    "convert_page_to_markdown": {
      "description": "Read a web page or a PDF and get its text back as clean Markdown, ready to hand to an AI step, save as a note or summarise: headings, links and tables kept, menus and page furniture dropped, up to 100,000 characters. Pages that only show their text after running scripts in a browser come back nearly empty, with a note saying so.",
      "display_name": "Turn a web page into Markdown",
      "display_str_template": "Turn {0} into Markdown.",
      "handler": "actions.convert_page_to_markdown",
      "id": "tidytools_convert_page_to_markdown",
      "method": "POST",
      "mock_response": {
        "character_count": 156,
        "description": "",
        "file_type": "text/html",
        "final_url": "https://example.com/",
        "language": "en",
        "markdown": "This domain is for use in documentation examples without needing permission. This is not a service; avoid relying on it for testing and monitoring purposes.",
        "note": "Almost no text without JavaScript.",
        "title": "Example Domain",
        "token_estimate": 39,
        "truncated": false,
        "url": "https://example.com/"
      },
      "name": "convert_page_to_markdown",
      "parameters": [
        {
          "description": "The link to the web page or PDF to read, such as https://example.com/blog/post.",
          "display_name": "Page",
          "examples": [
            {
              "label": "An article",
              "value": "https://example.com/"
            },
            {
              "label": "A Wikipedia page",
              "value": "https://en.wikipedia.org/wiki/Markdown"
            }
          ],
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/tidytools/convert-page-to-markdown",
      "result_str_template": "{tidytools_convert_page_to_markdown,title}",
      "returns": {
        "properties": {
          "character_count": {
            "description": "How long the text is.",
            "type": "integer"
          },
          "description": {
            "description": "The page's own summary, when it has one.",
            "type": "string"
          },
          "file_type": {
            "description": "text/html for a web page, application/pdf for a PDF.",
            "type": "string"
          },
          "final_url": {
            "description": "Where the link ended up after any redirects.",
            "type": "string"
          },
          "language": {
            "description": "The page's language code, such as en.",
            "type": "string"
          },
          "markdown": {
            "description": "The page's text, as Markdown.",
            "type": "string"
          },
          "note": {
            "description": "A warning when the page had almost no text without running scripts. Empty otherwise.",
            "type": "string"
          },
          "title": {
            "description": "The page's title.",
            "type": "string"
          },
          "token_estimate": {
            "description": "Roughly how many AI tokens the text is.",
            "type": "integer"
          },
          "truncated": {
            "description": "True when the page was cut at 100,000 characters.",
            "type": "boolean"
          },
          "url": {
            "description": "The link asked for.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
