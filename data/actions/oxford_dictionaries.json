{
  "actions": {
    "get_definition": {
      "description": "Look up a word's part of speech, pronunciation, and definitions.",
      "display_name": "Get definition",
      "display_str_template": "Look up the definition of '{0}'.",
      "handler": "actions.get_definition",
      "id": "oxford_dictionaries_get_definition",
      "method": "POST",
      "mock_response": {
        "definitions": [
          "present, appearing, or found everywhere"
        ],
        "part_of_speech": "adjective",
        "pronunciation": "ju\u02d0\u02c8b\u026akw\u026at\u0259s",
        "word": "ubiquitous"
      },
      "name": "get_definition",
      "parameters": [
        {
          "description": "Word to look up.",
          "display_name": "Word",
          "examples": [
            {
              "label": "Word",
              "value": "ubiquitous"
            }
          ],
          "name": "word",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "en-gb",
          "description": "Language/region code, for example 'en-gb' or 'en-us'.",
          "display_name": "Language",
          "name": "source_lang",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/oxford-dictionaries/get-definition",
      "result_str_template": "Retrieved the definition.",
      "returns": {
        "properties": {
          "definitions": {
            "description": "Definitions, in order",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "part_of_speech": {
            "description": "Part of speech, for example 'noun' or 'verb'",
            "type": "string"
          },
          "pronunciation": {
            "description": "Phonetic (IPA) spelling, if available",
            "type": "string"
          },
          "word": {
            "description": "The matched headword. Empty if not found.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_synonyms": {
      "description": "Look up synonyms and antonyms for a word.",
      "display_name": "Get synonyms",
      "display_str_template": "Look up synonyms for '{0}'.",
      "handler": "actions.get_synonyms",
      "id": "oxford_dictionaries_get_synonyms",
      "method": "POST",
      "mock_response": {
        "antonyms": [
          "sad",
          "unhappy"
        ],
        "synonyms": [
          "glad",
          "joyful",
          "content"
        ],
        "word": "happy"
      },
      "name": "get_synonyms",
      "parameters": [
        {
          "description": "Word to look up.",
          "display_name": "Word",
          "examples": [
            {
              "label": "Word",
              "value": "happy"
            }
          ],
          "name": "word",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "en-gb",
          "description": "Language/region code, for example 'en-gb' or 'en-us'.",
          "display_name": "Language",
          "name": "source_lang",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/oxford-dictionaries/get-synonyms",
      "result_str_template": "Retrieved synonyms and antonyms.",
      "returns": {
        "properties": {
          "antonyms": {
            "description": "Antonyms for the word",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "synonyms": {
            "description": "Synonyms for the word",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "word": {
            "description": "The matched headword. Empty if not found.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Look up word definitions, pronunciations, synonyms, and antonyms using the Oxford Dictionaries API.",
  "display_name": "Oxford Dictionaries",
  "id": "oxford_dictionaries"
}
