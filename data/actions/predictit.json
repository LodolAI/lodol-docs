  "triggers": {
    "predictit_market_status_changed_trigger": {
      "description": "Runs each time a market status changes in PredictIt. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Market status changed",
      "id": "predictit_market_status_changed_trigger",
      "output": {
        "record": "object with the fields id, name, shortName, image, url, contracts, timeStamp, status"
      },
      "parameters": []
    },
    "predictit_new_market_trigger": {
      "description": "Runs for each new market in PredictIt. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New market",
      "id": "predictit_new_market_trigger",
      "output": {
        "record": "object with the fields id, name, shortName, image, url, contracts, timeStamp, status"
