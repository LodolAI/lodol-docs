{
  "actions": {
    "count_specimens": {
      "description": "Count the specimen records that match, without fetching them: a quick way to track how many specimens of a species, place or collector iDigBio holds. No API key required.",
      "display_name": "Count specimens",
      "display_str_template": "Count iDigBio specimen records.",
      "handler": "actions.count_specimens",
      "id": "idigbio_count_specimens",
      "method": "POST",
      "mock_response": {
        "count": 5008
      },
      "name": "count_specimens",
      "parameters": [
        {
          "description": "Only specimens identified as this taxon, e.g. Acer rubrum. Case does not matter.",
          "display_name": "Scientific name",
          "examples": [
            {
              "label": "Example",
              "value": "Acer rubrum"
            }
          ],
          "name": "scientific_name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only specimens in this genus, e.g. Acer.",
          "display_name": "Genus",
          "examples": [
            {
              "label": "Example",
              "value": "Acer"
            }
          ],
          "name": "genus",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only specimens in this family, e.g. Sapindaceae.",
          "display_name": "Family",
          "examples": [
            {
              "label": "Example",
              "value": "Sapindaceae"
            }
          ],
          "name": "family",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only specimens collected in this country, as written in English, e.g. united states or canada.",
          "display_name": "Country",
          "examples": [
            {
              "label": "Example",
              "value": "united states"
            }
          ],
          "name": "country",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only specimens collected in this state or province, e.g. illinois.",
          "display_name": "State or province",
          "examples": [
            {
              "label": "Example",
              "value": "illinois"
            }
          ],
          "name": "state_province",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only specimens held by this institution, by its code, e.g. NY (New York Botanical Garden) or MCZ.",
          "display_name": "Institution code",
          "examples": [
            {
              "label": "Example",
              "value": "NY"
            }
          ],
          "name": "institution_code",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only specimens collected by someone with this name, e.g. a surname.",
          "display_name": "Collector",
          "examples": [
            {
              "label": "Example",
              "value": "Webber"
            }
          ],
          "name": "collector",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only specimens that have at least one image.",
          "display_name": "Has images",
          "name": "has_image",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Only specimens with a latitude and longitude.",
          "display_name": "Has coordinates",
          "name": "has_coordinates",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Only specimens collected on or after this date.",
          "display_name": "Collected on or after",
          "name": "collected_from",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only specimens collected on or before this date.",
          "display_name": "Collected on or before",
          "name": "collected_to",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Optional. Extra conditions in iDigBio's JSON query format, for any other indexed field, e.g. {\"basisofrecord\": \"fossilspecimen\"} or {\"county\": \"cook\"}. A field may not also be set above.",
          "display_name": "Advanced query",
          "examples": [
            {
              "label": "Fossils only",
              "value": "{\"basisofrecord\": \"fossilspecimen\"}"
            }
          ],
          "multiline": true,
          "name": "query",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/idigbio/count-specimens",
      "result_str_template": "{idigbio_count_specimens,count} specimens match.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many specimen records match.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
