  "categories": [
    "To-Do Lists"
  ],
  "description": "Add, read, change, complete and delete tasks in your TickTick lists, and start a workflow when a task is added.",
  "display_name": "TickTick",
  "id": "ticktick",
  "logo": "https://www.lodol.com/app-icons/ticktick-icon.png",
  "triggers": {
    "ticktick_new_task_trigger": {
      "description": "Runs for each task added to a TickTick list, with its title, notes, dates and priority. Tasks already there when the workflow is turned on don't start it. How often it checks follows your workspace plan.",
      "display_name": "New task",
      "id": "ticktick_new_task_trigger",
      "output": {
        "content": "Its notes.",
        "due_date": "When it's due, empty if not set.",
        "id": "The task's ID, for later TickTick steps.",
        "priority": "Its priority: None, Low, Medium or High.",
        "project_id": "The ID of the list it's in.",
        "project_name": "The name of the list it's in.",
        "start_date": "When it starts, empty if not set.",
        "title": "The task's title."
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The TickTick list to watch for new tasks.",
          "display_name": "List",
          "name": "project_id",
          "required": true
        }
      ]
    }
  }
