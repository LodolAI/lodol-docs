{
  "actions": {
    "add_task": {
      "description": "Create a new task in TickTick.",
      "display_name": "Add task",
      "display_str_template": "Add task '{0}'.",
      "handler": "actions.add_task",
      "id": "ticktick_add_task",
      "method": "POST",
      "mock_response": {
        "id": "6247ee29630c800f064fd145",
        "projectId": "inbox123456",
        "title": "Buy groceries"
      },
      "name": "add_task",
      "output_formatter": "actions.format_added_output",
      "parameters": [
        {
          "description": "The task's title.",
          "display_name": "Title",
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of the list/project to add the task to. Leave blank to add it to your Inbox.",
          "display_name": "Project ID",
          "name": "project_id",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional notes or description for the task.",
          "display_name": "Notes",
          "multiline": true,
          "name": "content",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The task's priority.",
          "display_name": "Priority",
          "name": "priority",
          "options": [
            {
              "label": "None",
              "value": "0"
            },
            {
              "label": "Low",
              "value": "1"
            },
            {
              "label": "Medium",
              "value": "3"
            },
            {
              "label": "High",
              "value": "5"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "An optional due date and time for the task.",
          "display_name": "Due date",
          "name": "due_date",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/ticktick/add-task",
      "result_str_template": "Task created.",
      "returns": {
        "properties": {
          "id": {
            "description": "The created task's ID.",
            "type": "string"
          },
          "projectId": {
            "description": "The ID of the project the task was added to.",
            "type": "string"
          },
          "title": {
            "description": "The task title.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "complete_task": {
      "description": "Mark a TickTick task as completed.",
      "display_name": "Complete task",
      "display_str_template": "Complete task {1}.",
      "handler": "actions.complete_task",
      "id": "ticktick_complete_task",
      "method": "POST",
      "mock_response": {
        "completed": true,
        "project_id": "inbox123456",
        "task_id": "6247ee29630c800f064fd145"
      },
      "name": "complete_task",
      "output_formatter": "actions.format_completed_output",
      "parameters": [
        {
          "description": "The ID of the project the task belongs to (from the task's details or 'Add task' result).",
          "display_name": "Project ID",
          "name": "project_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The ID of the task to complete.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/ticktick/complete-task",
      "result_str_template": "Task completed.",
      "returns": {
        "properties": {
          "completed": {
            "description": "Whether the task was completed.",
            "type": "boolean"
          },
          "project_id": {
            "description": "The project's ID.",
            "type": "string"
          },
          "task_id": {
            "description": "The task's ID.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "modify"
      ]
    },
    "delete_task": {
      "description": "Delete a TickTick task. Check the task first: Lodol can't bring it back.",
      "display_name": "Delete task",
      "display_str_template": "Delete task {1}.",
      "handler": "actions.delete_task",
      "id": "ticktick_delete_task",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "project_id": "6226ff9877acee87727f6bca",
        "task_id": "6247ee29630c800f064fd145"
      },
      "name": "delete_task",
      "output_formatter": "actions.format_deleted_output",
      "parameters": [
        {
          "description": "The TickTick list. Pick one, or give its id from an earlier step.",
          "display_name": "List",
          "dynamic_source": "projects",
          "dynamic_source_allows_custom": true,
          "name": "project_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The task's ID, from 'List tasks', 'Add task' or a trigger.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/ticktick/delete-task",
      "result_str_template": "Task deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Whether the task was deleted.",
            "type": "boolean"
          },
          "project_id": {
            "description": "The list's ID.",
            "type": "string"
          },
          "task_id": {
            "description": "The task's ID.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
