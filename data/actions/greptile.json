{
  "actions": {
    "get_repository": {
      "description": "Check a repository's indexing status, file-processing progress, and indexed commit SHA. A completed status means indexing is done.",
      "display_name": "Get repository status",
      "display_str_template": "Get Greptile index status for {0}",
      "handler": "actions.get_repository",
      "id": "greptile_get_repository",
      "method": "POST",
      "mock_response": {
        "branch": "main",
        "filesProcessed": 420,
        "numFiles": 420,
        "private": false,
        "remote": "github",
        "repository": "greptileai/greptile",
        "sha": "89b286a699b2d023b7a1ebc468abf230d84ad547",
        "status": "completed"
      },
      "name": "get_repository",
      "output_formatter": "actions.format_get_repository_output",
      "parameters": [
        {
          "description": "The repository in 'owner/name' form, e.g. 'greptileai/greptile'.",
          "display_name": "Repository",
          "examples": [
            {
              "label": "Greptile",
              "value": "greptileai/greptile"
            }
          ],
          "name": "repository",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "github",
          "description": "The Git hosting platform the repository lives on.",
          "display_name": "Remote",
          "name": "remote",
          "options": [
            {
              "label": "GitHub",
              "value": "github"
            },
            {
              "label": "GitLab",
              "value": "gitlab"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "main",
          "description": "The branch to index (e.g. 'main').",
          "display_name": "Branch",
          "name": "branch",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/greptile/get-repository",
      "result_str_template": "Retrieved index status.",
      "returns": {
        "properties": {
          "branch": {
            "type": "string"
          },
          "filesProcessed": {
            "type": "number"
          },
          "numFiles": {
            "type": "number"
          },
          "private": {
            "type": "boolean"
          },
          "remote": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "sha": {
            "description": "Indexed commit SHA (present once indexed).",
            "type": "string"
          },
          "status": {
            "description": "Indexing status, e.g. 'submitted', 'cloning', 'processing', or 'completed'.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "index_repository": {
      "description": "Submit a Git repository to Greptile for indexing: the one-time (per branch) step that prepares a codebase for Greptile.",
      "display_name": "Index repository",
      "display_str_template": "Index Greptile repository {0}",
      "handler": "actions.index_repository",
      "id": "greptile_index_repository",
      "method": "POST",
      "mock_response": {
        "response": "started indexing repository"
      },
      "name": "index_repository",
      "output_formatter": "actions.format_index_repository_output",
      "parameters": [
        {
          "description": "The repository in 'owner/name' form, e.g. 'greptileai/greptile'.",
          "display_name": "Repository",
          "examples": [
            {
              "label": "Greptile",
              "value": "greptileai/greptile"
            }
          ],
          "name": "repository",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "github",
          "description": "The Git hosting platform the repository lives on.",
          "display_name": "Remote",
          "name": "remote",
          "options": [
            {
              "label": "GitHub",
              "value": "github"
            },
            {
              "label": "GitLab",
              "value": "gitlab"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "main",
          "description": "The branch to index (e.g. 'main').",
          "display_name": "Branch",
          "name": "branch",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Force a re-index of an already-indexed repository (use after new commits land). Defaults to false.",
          "display_name": "Reload",
          "name": "reload",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Email you when indexing finishes. Defaults to false.",
          "display_name": "Notify",
          "name": "notify",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/greptile/index-repository",
      "result_str_template": "Repository submitted for indexing.",
      "returns": {
        "properties": {
          "response": {
            "description": "Greptile's acknowledgment of the indexing job.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Index your Git repositories with Greptile and track indexing progress so your codebase is ready for Greptile's AI code search.",
  "display_name": "Greptile",
  "id": "greptile"
}
