{
  "actions": {
    "complete_task": {
      "description": "Mark a task as completed.",
      "display_name": "Complete task",
      "display_str_template": "Complete task '{1}' in Google Tasks list '{0}'.",
      "handler": "actions.complete_task",
      "id": "google_tasks_complete_task",
      "method": "POST",
      "mock_response": {
        "id": "task_abc123",
        "status": "completed"
      },
      "name": "complete_task",
      "parameters": [
        {
          "description": "ID of the task list the task belongs to.",
          "display_name": "Task list ID",
          "name": "task_list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "ID of the task to complete.",
          "display_name": "Task ID",
          "name": "task_id",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-tasks/complete-task",
      "result_str_template": "Completed task '{0}'.",
      "returns": {
        "properties": {
          "id": {
            "description": "ID of the completed task",
            "type": "string"
          },
          "status": {
            "description": "Task status after completion (always 'completed')",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_task": {
      "description": "Create a new task in a task list.",
      "display_name": "Create task",
      "display_str_template": "Create task '{1}' in Google Tasks list '{0}'.",
      "handler": "actions.create_task",
      "id": "google_tasks_create_task",
      "method": "POST",
      "mock_response": {
        "id": "task_abc123"
      },
      "name": "create_task",
      "parameters": [
        {
          "description": "ID of the task list to add the task to.",
          "display_name": "Task list ID",
          "name": "task_list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Title of the task.",
          "display_name": "Title",
          "examples": [
            {
              "label": "Title",
              "value": "Follow up with customer"
            }
          ],
          "name": "title",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Notes/description for the task.",
          "display_name": "Notes",
          "multiline": true,
          "name": "notes",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Due date for the task, as an RFC 3339 timestamp (e.g. 2026-02-01T00:00:00Z).",
          "display_name": "Due date",
          "name": "due",
          "required": false,
          "type": "ParameterType.DATETIME"
        }
      ],
      "path": "/actions/library/google-tasks/create-task",
      "result_str_template": "Created task '{0}'.",
      "returns": {
        "properties": {
          "id": {
            "description": "ID of the created task. Use this with complete_task.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_task_lists": {
      "description": "List the task lists in your Google account.",
      "display_name": "List task lists",
      "display_str_template": "List Google Tasks lists.",
      "handler": "actions.list_task_lists",
      "id": "google_tasks_list_task_lists",
      "method": "POST",
      "mock_response": {
        "task_lists": [
          {
            "id": "list_abc123",
            "title": "My Tasks"
          }
        ]
      },
      "name": "list_task_lists",
      "parameters": [],
      "path": "/actions/library/google-tasks/list-task-lists",
      "result_str_template": "Fetched Google Tasks lists.",
      "returns": {
        "properties": {
          "task_lists": {
            "description": "List of task lists",
            "items": {
              "properties": {
                "id": {
                  "description": "Task list ID. Use with the other actions.",
                  "type": "string"
                },
                "title": {
                  "description": "Task list title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "list_tasks": {
      "description": "List the tasks in a task list.",
      "display_name": "List tasks",
      "display_str_template": "List tasks in Google Tasks list '{0}'.",
      "handler": "actions.list_tasks",
      "id": "google_tasks_list_tasks",
      "method": "POST",
      "mock_response": {
        "tasks": [
          {
            "due": "2026-02-01T00:00:00.000Z",
            "id": "task_abc123",
            "notes": "Sent the proposal, waiting on a reply.",
            "status": "needsAction",
            "title": "Follow up with customer"
          }
        ]
      },
      "name": "list_tasks",
      "parameters": [
        {
          "description": "ID of the task list to list tasks from.",
          "display_name": "Task list ID",
          "name": "task_list_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Whether to include completed tasks (default true).",
          "display_name": "Show completed",
          "name": "show_completed",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/google-tasks/list-tasks",
      "result_str_template": "Fetched tasks from Google Tasks list '{0}'.",
      "returns": {
        "properties": {
          "tasks": {
            "description": "List of tasks",
            "items": {
              "properties": {
                "due": {
                  "description": "Due date as an RFC 3339 timestamp, if set",
                  "type": "string"
                },
                "id": {
                  "description": "Task ID",
                  "type": "string"
                },
                "notes": {
                  "description": "Task notes/description",
                  "type": "string"
                },
                "status": {
                  "description": "Task status, either 'needsAction' or 'completed'",
                  "type": "string"
                },
                "title": {
                  "description": "Task title",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Manage task lists and tasks in Google Tasks.",
  "display_name": "Google Tasks",
  "id": "google_tasks"
}
