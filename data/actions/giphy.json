{
  "actions": {
    "search_gifs": {
      "description": "Search for GIFs on Giphy that match your search terms.",
      "display_name": "Search GIFs",
      "display_str_template": "Search Giphy for '{0}'.",
      "handler": "actions.search_gifs",
      "id": "giphy_search_gifs",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "gifs": [
          {
            "id": "abc123",
            "preview_url": "https://media.giphy.com/media/abc123/giphy.gif",
            "title": "Funny Cat",
            "url": "https://giphy.com/gifs/abc123"
          },
          {
            "id": "def456",
            "preview_url": "https://media.giphy.com/media/def456/giphy.gif",
            "title": "Dancing Dog",
            "url": "https://giphy.com/gifs/def456"
          }
        ]
      },
      "name": "search_gifs",
      "parameters": [
        {
          "description": "What to search for, for example 'happy dance'",
          "display_name": "Query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Maximum number of GIFs to return",
          "display_name": "Limit",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/giphy/search-gifs",
      "result_str_template": "Found {0} GIFs matching the search.",
      "returns": {
        "properties": {
          "count": {
            "description": "Number of GIFs returned",
            "type": "number"
          },
          "gifs": {
            "description": "List of GIF results",
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                },
                "preview_url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Search for GIFs on Giphy to use in your workflows.",
  "display_name": "Giphy",
  "id": "giphy"
}
