{
  "actions": {
    "create_comment": {
      "description": "Add a comment to one of your Instagram posts, identified by its media ID.",
      "display_name": "Create a comment",
      "display_str_template": "Comment on Instagram media {0}.",
      "handler": "actions.create_comment",
      "id": "instagram_for_business_create_comment",
      "method": "POST",
      "mock_response": {
        "id": "17900000000000000"
      },
      "name": "create_comment",
      "output_formatter": "actions.format_create_comment_output",
      "parameters": [
        {
          "description": "The ID of the media (post) to comment on, as returned by Create a post.",
          "display_name": "Media ID",
          "name": "media_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text of the comment.",
          "display_name": "Comment",
          "multiline": true,
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/instagram_for_business/create-comment",
      "result_str_template": "Comment posted.",
      "returns": {
        "properties": {
          "id": {
            "description": "The created comment's ID.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_post": {
      "description": "Create an image post on your Instagram Business account from a publicly reachable image URL, with an optional caption.",
      "display_name": "Create a post",
      "display_str_template": "Create an Instagram post.",
      "handler": "actions.create_post",
      "id": "instagram_for_business_create_post",
      "method": "POST",
      "mock_response": {
        "creation_id": "17987654321000000",
        "id": "17895695668004550"
      },
      "name": "create_post",
      "output_formatter": "actions.format_create_post_output",
      "parameters": [
        {
          "description": "A publicly reachable URL of the image to publish, for example, https://example.com/photo.jpg.",
          "display_name": "Image URL",
          "name": "image_url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional caption for the post. Hashtags and mentions are supported.",
          "display_name": "Caption",
          "multiline": true,
          "name": "caption",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/instagram_for_business/create-post",
      "result_str_template": "Post created.",
      "returns": {
        "properties": {
          "creation_id": {
            "description": "The media container ID it was published from.",
            "type": "string"
          },
          "id": {
            "description": "The published media's ID.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
