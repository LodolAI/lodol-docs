{
  "actions": {
    "find_email": {
      "description": "Find someone's verified work email from their full name and their company. Uses one finder credit only when an email is found.",
      "display_name": "Find email",
      "display_str_template": "Find an email with Findymail.",
      "handler": "actions.find_email",
      "id": "findymail_find_email",
      "method": "POST",
      "mock_response": {
        "domain": "stripe.com",
        "email": "john@stripe.com",
        "found": true,
        "name": "John Doe"
      },
      "name": "find_email",
      "parameters": [
        {
          "description": "The person's full name, e.g. 'John Doe'.",
          "display_name": "Full name",
          "name": "name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The company's website domain, e.g. 'stripe.com'. A company name also works, but a domain matches best.",
          "display_name": "Company",
          "name": "domain",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/findymail/find-email",
      "result_str_template": "Findymail email lookup complete.",
      "returns": {
        "properties": {
          "domain": {
            "description": "The company domain matched",
            "type": "string"
          },
          "email": {
            "description": "The verified work email, or empty when not found",
            "type": "string"
          },
          "found": {
            "description": "Whether a verified email was found",
            "type": "boolean"
          },
          "name": {
            "description": "The person's full name",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "find_email_from_linkedin": {
      "description": "Find someone's verified work email from their LinkedIn profile URL. Uses one finder credit only when an email is found.",
      "display_name": "Find email from LinkedIn",
      "display_str_template": "Find an email from a LinkedIn profile.",
      "handler": "actions.find_email_from_linkedin",
      "id": "findymail_find_email_from_linkedin",
      "method": "POST",
      "mock_response": {
        "domain": "stripe.com",
        "email": "john@stripe.com",
        "found": true,
        "name": "John Doe"
      },
      "name": "find_email_from_linkedin",
      "parameters": [
        {
          "description": "The person's LinkedIn profile, e.g. 'https://www.linkedin.com/in/johndoe'. The username alone ('johndoe') also works.",
          "display_name": "LinkedIn profile URL",
          "name": "linkedin_url",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/findymail/find-email-from-linkedin",
      "result_str_template": "Findymail email lookup complete.",
      "returns": {
        "properties": {
          "domain": {
            "description": "The company domain matched",
            "type": "string"
          },
          "email": {
            "description": "The verified work email, or empty when not found",
            "type": "string"
          },
          "found": {
            "description": "Whether a verified email was found",
            "type": "boolean"
          },
          "name": {
            "description": "The person's full name",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "find_employees": {
      "description": "Find people at a company whose job title matches one you give. Returns their LinkedIn profile, which you can pass to Find email from LinkedIn to reveal an email. Uses one finder credit per person found.",
      "display_name": "Find employees",
      "display_str_template": "Find employees with Findymail.",
      "handler": "actions.find_employees",
      "id": "findymail_find_employees",
      "method": "POST",
      "mock_response": {
        "employees": [
          {
            "company_name": "Findymail",
            "company_website": "https://www.findymail.com",
            "job_title": "Software Engineer",
            "linkedin_url": "https://www.linkedin.com/in/john-doe/",
            "name": "John Doe"
          }
        ],
        "total_count": 1
      },
      "name": "find_employees",
      "parameters": [
        {
          "description": "The company's website domain, e.g. 'stripe.com'.",
          "display_name": "Company website",
          "name": "website",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Job titles to match, e.g. 'Head of Sales', 'CEO'. Up to 10; a person matching any of them can be returned.",
          "display_name": "Job titles",
          "name": "job_titles",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "default": 1,
          "description": "How many people to return (1-5).",
          "display_name": "Number of people",
          "maximum": 5,
          "minimum": 1,
          "name": "count",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/findymail/find-employees",
      "result_str_template": "Findymail employees retrieved.",
      "returns": {
        "properties": {
          "employees": {
            "description": "The people found, without emails",
            "items": {
              "properties": {
                "company_name": {
                  "description": "Employer name",
                  "type": "string"
                },
                "company_website": {
                  "description": "Employer website",
                  "type": "string"
                },
                "job_title": {
                  "description": "Current job title",
                  "type": "string"
                },
                "linkedin_url": {
                  "description": "LinkedIn profile URL. Pass to Find email from LinkedIn to reveal an email.",
                  "type": "string"
                },
                "name": {
                  "description": "Full name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total_count": {
            "description": "How many people were returned",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "get_company": {
      "description": "Look up a company's size, industry, description, and LinkedIn page from its domain, name, or LinkedIn URL. Uses one finder credit only when the company is found.",
      "display_name": "Get company info",
      "display_str_template": "Look up a company with Findymail.",
      "handler": "actions.get_company",
      "id": "findymail_get_company",
      "method": "POST",
      "mock_response": {
        "company_size": "1001-5000",
        "description": "Stripe is a technology company...",
        "domain": "stripe.com",
        "found": true,
        "industry": "Financial Services",
        "linkedin_url": "https://www.linkedin.com/company/stripe/",
        "name": "Stripe"
      },
      "name": "get_company",
      "parameters": [
        {
          "description": "The company's website domain, e.g. 'stripe.com'. Matches best.",
          "display_name": "Company domain",
          "name": "domain",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. The company's name, e.g. 'Stripe'.",
          "display_name": "Company name",
          "name": "name",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional. The company's LinkedIn page, e.g. 'https://www.linkedin.com/company/stripe/'.",
          "display_name": "Company LinkedIn URL",
          "name": "linkedin_url",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/findymail/get-company",
      "result_str_template": "Findymail company retrieved.",
      "returns": {
        "properties": {
          "company_size": {
            "description": "Employee count range, e.g. '1001-5000'",
            "type": "string"
          },
          "description": {
            "description": "Company description",
            "type": "string"
          },
          "domain": {
            "description": "Website domain",
            "type": "string"
          },
          "found": {
            "description": "Whether a matching company was found",
            "type": "boolean"
          },
          "industry": {
            "description": "Industry",
            "type": "string"
          },
          "linkedin_url": {
            "description": "Company LinkedIn page",
            "type": "string"
          },
          "name": {
            "description": "Company name",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_contacts": {
      "description": "Read the contacts saved in your Findymail account, either from one contact list or across all of them. Free: uses no credits.",
      "display_name": "List saved contacts",
      "display_str_template": "List Findymail contacts.",
      "handler": "actions.list_contacts",
      "id": "findymail_list_contacts",
      "method": "POST",
      "mock_response": {
        "contacts": [
          {
            "company": "MyCompany",
            "email": "john@company.com",
            "id": 1,
            "job_title": "CEO",
            "linkedin_url": "https://www.linkedin.com/in/johndoe",
            "name": "John Doe"
          }
        ],
        "total_count": 1
      },
      "name": "list_contacts",
      "parameters": [
        {
          "default": 0,
          "description": "The contact list to read. Defaults to All contacts, which returns every saved contact.",
          "display_name": "Contact list",
          "dynamic_source": "contact_lists",
          "name": "list_id",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/findymail/list-contacts",
      "result_str_template": "Findymail contacts retrieved.",
      "returns": {
        "properties": {
          "contacts": {
            "description": "The saved contacts",
            "items": {
              "properties": {
                "company": {
                  "description": "Company name",
                  "type": "string"
                },
                "email": {
                  "description": "Saved email address",
                  "type": "string"
                },
                "id": {
                  "description": "Findymail contact ID",
                  "type": "number"
                },
                "job_title": {
                  "description": "Job title",
                  "type": "string"
                },
                "linkedin_url": {
                  "description": "LinkedIn profile URL",
                  "type": "string"
                },
                "name": {
                  "description": "Full name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "total_count": {
            "description": "How many contacts were returned",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "verify_email": {
      "description": "Check whether an email address is deliverable before sending to it. Uses one verifier credit per check.",
      "display_name": "Verify email",
      "display_str_template": "Verify an email with Findymail.",
      "handler": "actions.verify_email",
      "id": "findymail_verify_email",
      "method": "POST",
      "mock_response": {
        "email": "john@stripe.com",
        "provider": "Google",
        "verified": true
      },
      "name": "verify_email",
      "parameters": [
        {
          "description": "The email address to verify.",
          "display_name": "Email",
          "name": "email",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/findymail/verify-email",
      "result_str_template": "Findymail verification complete.",
      "returns": {
        "properties": {
          "email": {
            "description": "The email address that was checked",
            "type": "string"
          },
          "provider": {
            "description": "The mailbox provider, e.g. 'Google'",
            "type": "string"
          },
          "verified": {
            "description": "Whether the address is deliverable",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Find and verify B2B work emails, look up a company's employees, and read your saved contacts with Findymail.",
  "display_name": "Findymail",
  "id": "findymail"
}
