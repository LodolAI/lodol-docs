        {
          "description": "Give runs that belong to one conversation the same key, such as a chat thread id or a customer's email, and the agent sees what was asked and answered in the earlier runs. Leave empty and each run starts fresh.",
          "display_name": "Conversation key",
          "name": "memory_key",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "How many earlier runs under the same conversation key the agent is shown.",
          "display_name": "Runs to remember",
          "maximum": 50,
          "minimum": 1,
          "name": "memory_window",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": false,
          "description": "Replace names, email addresses, phone numbers and card and account numbers with placeholders before the model sees them. Tools still get the real values, and so does the step's result. Text only: a step with files cannot use it.",
          "display_name": "Redact personal data",
          "name": "redact_personal_data",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Check the task, the files and every tool result for text that tries to give the agent instructions, and stop the step if any does. Costs one extra model call before the first turn and one per turn that uses tools.",
          "display_name": "Block prompt injections",
          "name": "block_prompt_injection",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "For tools marked Ask first: email addresses of the people who approve what the agent wants to do, separated by commas. People in this workspace answer in the app; anyone else gets a secure link by email. Leave empty to ask whoever the run runs as.",
          "display_name": "Who to ask",
          "name": "approvers",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only the people asked, the people asked plus the workspace's owner and admins, or anyone in the workspace who can run workflows (not Viewers).",
          "display_name": "Who can answer",
          "name": "approver_group",
          "options": [
            {
              "label": "Only the people asked",
              "value": "listed"
            },
            {
              "label": "People asked, plus admins",
              "value": "admins"
            },
            {
              "label": "Anyone who can run workflows",
              "value": "anyone"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How long each request waits for an answer. Leave empty for 72 hours; at most 720 (30 days). Hours can be fractions, for example 0.5 for half an hour.",
          "display_name": "Time limit (hours)",
          "maximum": 720.0,
          "minimum": 0,
          "name": "approval_time_limit_hours",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "What happens to the tool call when the time limit runs out. Left unset, it is rejected and the agent is told nobody approved it.",
          "display_name": "If nobody answers in time",
          "name": "approval_on_timeout",
          "options": [
            {
              "label": "Treat it as rejected",
              "value": "reject"
            },
            {
              "label": "Treat it as approved",
              "value": "approve"
            },
            {
              "label": "Stop the run with an error",
              "value": "fail"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "A channel ID or #name to post each request to, with a link to answer. Uses this workspace's Slack connection; the Lodol app must be in the channel.",
          "display_name": "Also post to Slack channel",
          "name": "approval_slack_channel",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "",
      "result_str_template": "{run,result}",
      "returns": {
        "properties": {
          "model": {
            "description": "The model that finished the run.",
            "type": "string"
          },
          "output": {
            "description": "The fields asked for, filled in; or the agent's final text when no fields were asked for.",
            "type": "object"
          },
          "steps": {
            "description": "How many turns the agent took.",
            "type": "number"
          },
          "text": {
            "description": "The agent's final message.",
            "type": "string"
          },
          "tool_calls": {
            "description": "Each tool the agent used, and each web search it ran, with its input, whether it succeeded, the start of what came back and, for a tool marked Ask first, who approved or declined the call.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "usage": {
            "description": "The tokens the run used.",
            "properties": {
              "input_tokens": {
                "type": "number"
              },
              "output_tokens": {
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "categories": [
    "Lodol"
  ],
  "description": "Give an AI a task, files to read and tools to use, and use what it hands back.",
