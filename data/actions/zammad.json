{
  "actions": {
    "add_article": {
      "description": "Add an internal note, a note the customer can see, or an email reply that Zammad sends, to a ticket.",
      "display_name": "Add reply or note",
      "display_str_template": "Add to Zammad ticket {0}.",
      "handler": "actions.add_article",
      "id": "zammad_add_article",
      "method": "POST",
      "mock_response": {
        "body": "Here it is again. Sorry it went missing.",
        "cc": "",
        "created_at": "2026-11-04T09:12:44.233Z",
        "from": "Sam Agent via Billing <billing@yourcompany.com>",
        "id": 1094,
        "internal": false,
        "link": "https://yourcompany.zammad.com/#ticket/zoom/412",
        "sender": "Agent",
        "subject": "Invoice 1001 is missing",
        "ticket_id": 412,
        "to": "jane@acme.example.com",
        "type": "email"
      },
      "name": "add_article",
      "output_formatter": "actions.format_article",
      "parameters": [
        {
          "description": "The ticket's ID, from a trigger or an earlier step, its link, or its number with a #, such as #31001.",
          "display_name": "Ticket",
          "name": "ticket",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to write, as plain text or HTML.",
          "display_name": "Message",
          "multiline": true,
          "name": "body",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "internal_note",
          "description": "An internal note is seen only by agents; a public note shows in the customer's portal; an email reply is sent.",
          "display_name": "Type",
          "name": "message_type",
          "options": [
            {
              "label": "Internal note",
              "value": "internal_note"
            },
            {
              "label": "Public note",
              "value": "public_note"
            },
            {
              "label": "Email reply",
              "value": "email_reply"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Who the email goes to. Leave blank for the ticket's customer.",
          "display_name": "To",
          "name": "to",
          "required": false,
          "type": "ParameterType.STRING",
          "visible_when": {
            "message_type": [
              "email_reply"
            ]
          }
        },
        {
          "description": "Email addresses to copy, separated by commas.",
          "display_name": "CC",
          "name": "cc",
          "required": false,
          "type": "ParameterType.STRING",
          "visible_when": {
            "message_type": [
              "email_reply"
            ]
          }
        },
        {
          "description": "The subject. Leave blank for the ticket's title on an email.",
          "display_name": "Subject",
          "name": "subject",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/zammad/add-article",
      "result_str_template": "Added.",
      "returns": {
        "properties": {
          "body": {
            "description": "What it says, as plain text",
            "type": "string"
          },
          "cc": {
            "description": "Who an email was copied to",
            "type": "string"
          },
          "created_at": {
            "description": "When it was added (ISO 8601)",
            "type": "string"
          },
          "from": {
            "description": "Who wrote it",
            "type": "string"
          },
          "id": {
            "description": "The reply or note's ID",
            "type": "number"
          },
          "internal": {
            "description": "True when only agents can see it",
            "type": "boolean"
          },
          "link": {
            "description": "A link to the ticket in Zammad",
            "type": "string"
          },
          "sender": {
            "description": "Who it came from: Customer, Agent or System",
            "type": "string"
          },
          "subject": {
            "description": "Its subject",
            "type": "string"
          },
          "ticket_id": {
            "description": "The ticket's ID",
            "type": "number"
          },
          "to": {
            "description": "Who an email went to",
            "type": "string"
          },
          "type": {
            "description": "What it is: email, note, phone or web",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
