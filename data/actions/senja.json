      "id": "senja_new_testimonial_trigger",
      "output": {
        "record": "object with the fields id, type, customer_name, customer_email, title, text, rating, approved, tags"
      },
      "parameters": []
    },
    "senja_testimonial_approved_trigger": {
      "description": "Runs each time a testimonial is approved in Senja. Ones approved before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
