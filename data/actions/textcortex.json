{
  "actions": {
    "generate_text": {
      "description": "Ask a TextCortex model to write something: an answer, a rewrite, a summary, a translation or a draft. Returns the text and how many tokens it used.",
      "display_name": "Generate text",
      "display_str_template": "Generate text in TextCortex.",
      "handler": "actions.generate_text",
      "id": "textcortex_generate_text",
      "method": "POST",
      "mock_response": {
        "input_tokens": 23,
        "model": "claude-sonnet-5-5",
        "output_tokens": 28,
        "response_id": "resp_3925af9407844ff086b65ce34d6ea8f7",
        "status": "completed",
        "text": "A steel bottle that keeps drinks cold all day.",
        "total_tokens": 51,
        "truncated": false
      },
      "name": "generate_text",
      "output_formatter": "format_text",
      "parameters": [
        {
          "description": "The model that writes the answer. Pick one, or give its id from an earlier step.",
          "display_name": "Model",
          "dynamic_source": "models",
          "dynamic_source_allows_custom": true,
          "name": "model",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What you want the model to do or answer.",
          "display_name": "Prompt",
          "examples": [
            {
              "label": "A request",
              "value": "Write a two-sentence product description for a steel water bottle."
            }
          ],
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Standing instructions for how to answer, such as the role, tone or format. Optional.",
          "display_name": "System prompt",
          "examples": [
            {
              "label": "A role",
              "value": "You are a concise copywriter."
            }
          ],
          "multiline": true,
          "name": "instructions",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How varied the wording is, from 0 (most predictable) to 1 (most varied). Leave empty for the model's own default.",
          "display_name": "Temperature",
          "maximum": 1,
          "minimum": 0,
          "name": "temperature",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Only consider the most likely words that add up to this share, from 0 to 1. Change this or Temperature, not both. Optional.",
          "display_name": "Top P",
          "maximum": 1,
          "minimum": 0,
          "name": "top_p",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "The most the model may write (a token is about three quarters of a word). At least 16. Reasoning models also spend these on thinking, so leave it empty unless you need a hard cap.",
          "display_name": "Max output tokens",
          "minimum": 16,
          "name": "max_output_tokens",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/textcortex/generate-text",
      "result_str_template": "Text generated.",
      "returns": {
        "properties": {
          "input_tokens": {
            "description": "Tokens in the prompt",
            "type": "number"
          },
          "model": {
            "description": "The model that answered",
            "type": "string"
          },
          "output_tokens": {
            "description": "Tokens in the answer",
            "type": "number"
          },
          "response_id": {
            "description": "TextCortex's id for this answer",
            "type": "string"
          },
          "status": {
            "description": "completed, or incomplete if cut off",
            "type": "string"
          },
          "text": {
            "description": "The model's answer",
            "type": "string"
          },
          "total_tokens": {
            "description": "Tokens used in all",
            "type": "number"
          },
          "truncated": {
            "description": "True if the model hit 'Max output tokens' mid-answer",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
