        {
          "description": "The person's website.",
          "display_name": "Website",
          "max_length": 255,
          "name": "website",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The person's phone number.",
          "display_name": "Phone number",
          "max_length": 255,
          "name": "phone_number",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The answer to the registration form's GDPR field, if it has one.",
          "display_name": "GDPR consent",
          "max_length": 255,
          "name": "gdpr",
          "required": false,
