          "type": "ParameterType.STRING"
        },
        {
          "description": "Register for this session. Leave empty for the next one that is running or scheduled.",
          "display_name": "Session",
          "dynamic_source": "sessions",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "event_id"
          ],
