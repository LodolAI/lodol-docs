{
  "actions": {
    "get_event": {
      "description": "Get one event with its registration page and every session: scheduled, running and finished.",
      "display_name": "Get event",
      "display_str_template": "Get event {event_id}.",
      "handler": "actions.get_event",
      "id": "demio_get_event",
      "method": "POST",
      "mock_response": {
        "event": {
          "automated": null,
          "dates": [
            {
              "date_id": 1217,
              "datetime": "November 11th, 2026 at 7:26AM EST",
              "starts_at": "2026-11-11T12:26:40Z",
              "status": "finished",
              "timestamp": 1794400000,
              "zone": "America/New_York"
            },
            {
              "date_id": 1218,
              "datetime": "November 18th, 2026 at 6:06AM EST",
              "starts_at": "2026-11-18T11:06:40Z",
              "status": "scheduled",
              "timestamp": 1795000000,
              "zone": "America/New_York"
            }
          ],
          "description": "A live tour of the product",
          "id": 62,
          "name": "Product demo",
          "next_date_id": 1218,
          "registrants_stay_registered": false,
          "registration_url": "https://my.demio.com/ref/FKXeiDqyQsRYbfiv"
        }
      },
      "name": "get_event",
      "output_formatter": "_format_event",
      "parameters": [
        {
          "description": "The event. Pick one, or give its id from an earlier step.",
          "display_name": "Event",
          "dynamic_source": "events",
          "dynamic_source_allows_custom": true,
          "name": "event_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Tick to leave out sessions that have finished.",
          "display_name": "Only active sessions",
          "name": "only_active",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/demio/get-event",
      "result_str_template": "Event retrieved.",
      "returns": {
        "properties": {
          "event": {
            "description": "The event",
            "properties": {
              "automated": {
                "description": "For an automated event, its recording; empty for a live one",
                "nullable": true,
                "properties": {
                  "duration": {
                    "description": "The recording's length in seconds",
                    "type": "number"
                  },
                  "ready": {
                    "description": "Whether the recording is ready to play",
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "dates": {
                "description": "Every session, oldest first",
                "items": {
                  "properties": {
                    "date_id": {
                      "description": "The session's id",
                      "type": "number"
                    },
                    "datetime": {
                      "description": "When it starts, written out in its time zone",
                      "type": "string"
                    },
                    "starts_at": {
                      "description": "When it starts, ISO 8601 UTC",
                      "nullable": true,
                      "type": "string"
                    },
                    "status": {
                      "description": "The session's status: scheduled, running or finished",
                      "type": "string"
                    },
                    "timestamp": {
                      "description": "When it starts, in Unix seconds",
                      "type": "number"
                    },
                    "zone": {
                      "description": "The session's time zone",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "description": {
                "description": "The event's description",
                "type": "string"
              },
              "id": {
                "description": "The event's id",
                "type": "number"
              },
              "name": {
                "description": "The event's name",
                "type": "string"
              },
              "next_date_id": {
                "description": "The id of the next running or scheduled session",
                "nullable": true,
                "type": "number"
              },
              "registrants_stay_registered": {
                "description": "Whether registrants stay registered for every session in the series",
                "type": "boolean"
              },
              "registration_url": {
                "description": "The event's registration page",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
