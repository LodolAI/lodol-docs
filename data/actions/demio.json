  "categories": [
    "Events"
  ],
  "description": "Register people for Demio webinars and get their join links, read events and sessions, see who attended a session, and start a workflow when a session ends or someone new registers.",
  "display_name": "Demio",
  "id": "demio",
  "logo": "https://www.lodol.com/app-icons/demio-icon.png",
  "triggers": {
    "demio_new_registrant_trigger": {
      "description": "Runs when someone new appears on the participant list of an event's session in Demio, with their name, email and form answers. People already listed when the workflow is turned on don't start it.",
      "display_name": "New registrant",
      "id": "demio_new_registrant_trigger",
      "output": {
        "attended": "Whether they joined the session",
        "custom_fields": "Their registration form answers (id, name, value)",
        "date_id": "The session's id",
        "email": "The person's email address",
        "event_id": "The event's id",
        "event_name": "The event's name",
        "name": "The person's name",
        "session_starts_at": "When the session starts, ISO 8601 UTC",
        "status": "Their participation status, such as did not attend"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The event whose registrants to watch.",
          "display_name": "Event",
          "name": "event_id",
          "required": true
        },
        {
          "arg_index": 1,
          "description": "Only this session. Leave blank for every session of the event that hasn't finished.",
          "display_name": "Session",
          "name": "date_id",
          "required": false
        }
      ]
    },
    "demio_session_ended_trigger": {
      "description": "Runs when a Demio webinar session finishes, with the event and the session's id, ready for 'List session participants'. Sessions that ended before the workflow was turned on don't start it.",
      "display_name": "Session ended",
      "id": "demio_session_ended_trigger",
      "output": {
        "date_id": "The session's id",
        "event_id": "The event's id",
        "event_name": "The event's name",
        "registration_url": "The event's registration page",
        "starts_at": "When the session started, ISO 8601 UTC",
        "status": "The session's status, finished",
        "timestamp": "When the session started, in Unix seconds",
        "zone": "The session's time zone"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only sessions of this event. Leave blank for every event.",
          "display_name": "Event",
          "name": "event_id",
          "required": false
        }
      ]
    }
  }
}
