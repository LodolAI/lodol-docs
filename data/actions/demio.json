      "display_name": "Register person",
      "display_str_template": "Register {email} for event {event_id}.",
      "handler": "actions.register_person",
      "id": "demio_register_person",
      "method": "POST",
      "mock_response": {
        "date_id": 1218,
        "email": "sam@example.com",
        "event_id": 62,
        "hash": "fPaSYijVHXI6ZJgE",
        "join_link": "https://event.demio.com/join/fPaSYijVHXI6ZJgE"
      },
      "name": "register_person",
      "output_formatter": "_format_registration",
      "parameters": [
        {
          "description": "The event. Pick one, give its id from an earlier step, or paste its registration page address.",
