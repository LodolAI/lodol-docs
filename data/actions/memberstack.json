    "delete_member": {
      "description": "Permanently delete a member. This cannot be undone. Optionally delete their Stripe customer and cancel their subscriptions too.",
      "display_name": "Delete member",
      "display_str_template": "Delete member {member_id}.",
      "handler": "actions.delete_member",
      "id": "memberstack_delete_member",
      "method": "POST",
      "mock_response": {
        "deleted": true,
        "member_id": "mem_abc123"
      },
      "name": "delete_member",
      "output_formatter": "actions.format_delete_member_output",
      "parameters": [
        {
          "description": "The member's id (starts with mem_), from 'List members' or an earlier step.",
          "display_name": "Member ID",
          "name": "member_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Also delete the member's customer record in Stripe.",
          "display_name": "Delete their Stripe customer",
          "name": "delete_stripe_customer",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Also cancel the member's subscriptions in Stripe.",
          "display_name": "Cancel their Stripe subscriptions",
          "name": "cancel_stripe_subscriptions",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/memberstack/delete-member",
      "result_str_template": "Member deleted.",
      "returns": {
        "properties": {
          "deleted": {
            "description": "Always true once deleted",
            "type": "boolean"
          },
          "member_id": {
            "description": "The member deleted",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "delete"
      ]
    },
