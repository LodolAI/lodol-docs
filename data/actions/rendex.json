          "display_name": "Wait before capturing (seconds)",
          "maximum": 10,
          "minimum": 0,
          "name": "delay_seconds",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How long the links keep working. Defaults to 1 day.",
          "display_name": "How long it lasts",
          "name": "expires_in",
          "options": [
            {
              "label": "1 hour",
              "value": "3600"
            },
            {
              "label": "1 day (default)",
              "value": "86400"
            },
            {
              "label": "7 days",
              "value": "604800"
            },
            {
              "label": "30 days",
              "value": "2592000"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/rendex/create-image-link",
      "result_str_template": "Image link created.",
      "returns": {
        "properties": {
          "expires_at": {
