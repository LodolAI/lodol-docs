{
  "actions": {
    "create_document": {
      "description": "Make a PDF and/or PNG with your colour, header and footer from Markdown or HTML, with a page to share it. Uses one render per file made.",
      "display_name": "Create branded document",
      "display_str_template": "Create branded document in Rendex.",
      "handler": "actions.create_document",
      "id": "rendex_create_document",
      "method": "POST",
      "mock_response": {
        "expires_at": "2026-10-27T09:00:00Z",
        "pdf_url": "https://api.rendex.dev/v1/images/example.pdf?sig=abc",
        "png_url": "",
        "share_url": "https://rendex.dev/a/example"
      },
      "name": "create_document",
      "output_formatter": "actions.format_document_output",
      "parameters": [
        {
          "description": "The document's text, in Markdown or HTML (up to 4 MB).",
          "display_name": "Content",
          "multiline": true,
          "name": "content",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Defaults to Markdown.",
          "display_name": "Content is written in",
          "name": "input_format",
          "options": [
            {
              "label": "Markdown (default)",
              "value": "markdown"
            },
            {
              "label": "HTML",
              "value": "html"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Which files to make. Each one uses a render. Defaults to a PDF.",
          "display_name": "Make",
          "multi_select": true,
          "name": "formats",
          "options": [
            {
              "label": "PDF",
              "value": "pdf"
            },
            {
              "label": "PNG image",
              "value": "png"
            }
          ],
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Your brand colour, as a hex code such as #0055ff.",
          "display_name": "Accent colour",
          "name": "accent_color",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Text for the top of every page, such as your company name.",
          "display_name": "Header text",
          "name": "header",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Text for the bottom of every page.",
          "display_name": "Footer text",
          "name": "footer",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How long the links keep working. Defaults to 1 day.",
          "display_name": "How long it lasts",
          "name": "expires_in",
          "options": [
            {
              "label": "1 hour",
              "value": "3600"
            },
            {
              "label": "1 day (default)",
              "value": "86400"
            },
            {
              "label": "7 days",
              "value": "604800"
            },
            {
              "label": "30 days",
              "value": "2592000"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/rendex/create-document",
      "result_str_template": "Document created.",
      "returns": {
        "properties": {
          "expires_at": {
            "description": "When the links stop",
            "type": "string"
          },
          "pdf_url": {
            "description": "Link to the PDF",
            "type": "string"
          },
          "png_url": {
            "description": "Link to the PNG",
            "type": "string"
          },
          "share_url": {
            "description": "A page to share it",
            "type": "string"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    },
    "create_image_link": {
      "description": "Make an address that serves a page's screenshot whenever it is opened, for a link preview (og:image) or an email. It is signed, so it needs no key, and stops working after the time you choose.",
