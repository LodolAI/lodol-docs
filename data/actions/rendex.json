            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Screen width in pixels, 320 to 3840. Defaults to 1280.",
          "display_name": "Width (pixels)",
          "maximum": 3840,
          "minimum": 320,
          "name": "width",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Screen height in pixels, 240 to 2160. Defaults to 800.",
          "display_name": "Height (pixels)",
          "maximum": 2160,
          "minimum": 240,
          "name": "height",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "Ask the page for its dark colour scheme.",
          "display_name": "Dark mode",
          "name": "dark_mode",
          "required": false,
          "type": "ParameterType.BOOLEAN"
