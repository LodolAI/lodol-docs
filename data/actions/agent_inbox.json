  "triggers": {
    "agent_inbox_conversation_activity_trigger": {
      "description": "Runs each time an inbox conversation changes in Agent Inbox. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Inbox conversation updated",
      "id": "agent_inbox_conversation_activity_trigger",
      "output": {
        "record": "object with the fields id, channel, status, lastMessage.id, lastMessage.text, lastMessage.at, lastActivityAt"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Leave empty to use your default agent.",
          "display_name": "Agent identifier",
          "name": "agent_identifier",
          "required": false
        }
      ]
    },
    "agent_inbox_interaction_answered_trigger": {
      "description": "Runs for each question answered in Agent Inbox. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
