  "description": "Create and manage cloud browser sessions and capture pages with Steel.dev.",
  "display_name": "Steel.dev",
  "id": "steel",
  "logo": "https://www.lodol.com/app-icons/steel-icon.svg",
  "triggers": {
    "steel_new_session_trigger": {
      "description": "Runs for each new browser session in Steel.dev. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New browser session",
      "id": "steel_new_session_trigger",
      "output": {
        "record": "object with the fields id, status, createdAt, websocketUrl, sessionViewerUrl, timeout"
      },
      "parameters": []
    },
    "steel_session_status_changed_trigger": {
      "description": "Runs each time a browser session status changes in Steel.dev. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Browser session status changed",
      "id": "steel_session_status_changed_trigger",
      "output": {
        "record": "object with the fields id, status, createdAt, websocketUrl, sessionViewerUrl, timeout"
      },
      "parameters": []
    }
  }
