  "description": "Find books and editions and read your Hardcover library.",
  "display_name": "Hardcover",
  "id": "hardcover",
  "logo": "https://www.lodol.com/app-icons/hardcover-icon.png",
  "triggers": {
    "hardcover_library_status_changed_trigger": {
      "description": "Runs each time a library book status changes in Hardcover. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Library book status changed",
      "id": "hardcover_library_status_changed_trigger",
      "output": {
        "record": "object with the fields id, status_id, updated_at, book.id, book.title, book.slug, book.release_date, book.pages"
      },
      "parameters": []
    },
    "hardcover_new_library_book_trigger": {
      "description": "Runs for each new library book in Hardcover. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New library book",
      "id": "hardcover_new_library_book_trigger",
      "output": {
        "record": "object with the fields id, status_id, updated_at, book.id, book.title, book.slug, book.release_date, book.pages"
      },
      "parameters": []
    }
  }
