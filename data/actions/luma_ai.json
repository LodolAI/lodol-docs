  "triggers": {
    "luma_ai_file_added_trigger": {
      "description": "Runs each time a file is added in Luma AI. Ones added before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "File added",
      "id": "luma_ai_file_added_trigger",
      "output": {
        "record": "object with the fields id, state"
      },
      "parameters": []
    },
    "luma_ai_generation_completed_trigger": {
      "description": "Runs each time a generation is completed in Luma AI. Ones completed before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Generation completed",
      "id": "luma_ai_generation_completed_trigger",
      "output": {
        "record": "object"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Generation id.",
          "display_name": "Generation id",
          "name": "generation_id",
          "required": true
        }
      ]
    },
    "luma_ai_generation_failed_trigger": {
      "description": "Runs each time a generation is failed in Luma AI. Ones failed before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Generation failed",
      "id": "luma_ai_generation_failed_trigger",
      "output": {
        "record": "object"
      },
      "parameters": [
        {
