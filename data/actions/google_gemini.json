{
  "actions": {
    "count_tokens": {
      "description": "Count how many tokens a text is for a Gemini model, to check a prompt fits before sending it or to estimate what it will cost.",
      "display_name": "Count tokens",
      "display_str_template": "Count the tokens in {text}",
      "handler": "actions.count_tokens",
      "id": "google_gemini_count_tokens",
      "method": "POST",
      "mock_response": {
        "character_count": 42,
        "model": "gemini-3.8-flash",
        "token_count": 9
      },
      "name": "count_tokens",
      "output_formatter": "actions.format_count_tokens_output",
      "parameters": [
        {
          "description": "The text to count.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "gemini-3.8-flash",
          "description": "The model whose tokens to count. Defaults to Gemini 3.8 Flash. You can also type any other Gemini model id.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Gemini 3.8 Flash",
              "value": "gemini-3.8-flash"
            },
            {
              "label": "Gemini 3.6 Flash",
              "value": "gemini-3.6-flash"
            },
            {
              "label": "Gemini 3.5 Flash-Lite (fastest, lowest cost)",
              "value": "gemini-3.5-flash-lite"
            },
            {
              "label": "Gemini 4 Argon (most capable, needs billing)",
              "value": "gemini-4-argon"
            },
            {
              "label": "Gemini 3.5 Flash (older)",
              "value": "gemini-3.5-flash"
            },
            {
              "label": "Gemini 3.1 Flash-Lite (older, retires May 2027)",
              "value": "gemini-3.1-flash-lite"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-gemini/count-tokens",
      "result_str_template": "{google_gemini_count_tokens,token_count} tokens.",
      "returns": {
        "properties": {
          "character_count": {
            "description": "How many characters it is.",
            "type": "number"
          },
          "model": {
            "description": "The model counted for.",
            "type": "string"
          },
          "token_count": {
            "description": "How many tokens it is.",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "create_embeddings": {
      "description": "Turn texts into vectors for semantic search, finding similar items or grouping them, ready to store in a vector database.",
      "display_name": "Create embeddings",
      "display_str_template": "Embed {texts} with Gemini.",
      "handler": "actions.create_embeddings",
      "id": "google_gemini_create_embeddings",
      "method": "POST",
      "mock_response": {
        "count": 2,
        "dimensions": 3,
        "embedding": [
          0.012,
          -0.043,
          0.031
        ],
        "embeddings": [
          [
            0.012,
            -0.043,
            0.031
          ],
          [
            0.018,
            -0.039,
            0.027
          ]
        ],
        "model": "gemini-embedding-2",
        "task": "search_document"
      },
      "name": "create_embeddings",
      "output_formatter": "actions.format_create_embeddings_output",
      "parameters": [
        {
          "description": "The texts to embed, one per entry, up to 250. Each comes back as one vector, in the same order.",
          "display_name": "Texts",
          "name": "texts",
          "required": true,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "default": "search_document",
          "description": "How the vectors will be used, which tunes them for it. For search, embed the documents as documents and the searches as search queries.",
          "display_name": "What they're for",
          "name": "task",
          "options": [
            {
              "label": "Documents to be searched",
              "value": "search_document"
            },
            {
              "label": "Search queries",
              "value": "search_query"
            },
            {
              "label": "Questions to answer from documents",
              "value": "question"
            },
            {
              "label": "Claims to check against documents",
              "value": "fact_check"
            },
            {
              "label": "Queries for code",
              "value": "code_query"
            },
            {
              "label": "Texts to sort into categories",
              "value": "classification"
            },
            {
              "label": "Texts to group by topic",
              "value": "clustering"
            },
            {
              "label": "Texts to compare for similar meaning",
              "value": "similarity"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "gemini-embedding-2",
          "description": "Which embedding model to use. Defaults to Gemini Embedding 2. Vectors from different models can't be compared with each other.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Gemini Embedding 2",
              "value": "gemini-embedding-2"
            },
            {
              "label": "Gemini Embedding 001 (older)",
              "value": "gemini-embedding-001"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many numbers each vector has, from 128 to 3,072, for a vector database that expects a set size. Google suggests 768, 1,536 or 3,072. Leave blank for 3,072.",
          "display_name": "Dimensions",
          "name": "dimensions",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/google-gemini/create-embeddings",
      "result_str_template": "Created {google_gemini_create_embeddings,count} vectors.",
      "returns": {
        "properties": {
          "count": {
            "description": "How many vectors there are.",
            "type": "number"
          },
          "dimensions": {
            "description": "How many numbers each vector has.",
            "type": "number"
          },
          "embedding": {
            "description": "The first text's vector.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "embeddings": {
            "description": "One vector per text, in the same order.",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "model": {
            "description": "The embedding model used.",
            "type": "string"
          },
          "task": {
            "description": "What the vectors are tuned for.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "extract_data": {
      "description": "Pull the fields you name out of text or files, such as the total on a photographed receipt or the dates in a PDF contract, ready for a spreadsheet or a later step.",
      "display_name": "Extract data",
      "display_str_template": "Extract {fields} with Gemini.",
      "handler": "actions.extract_data",
      "id": "google_gemini_extract_data",
      "method": "POST",
      "mock_response": {
        "data": {
          "due_date": null,
          "total": "$412.50",
          "vendor": "Coastal Marine Supply"
        },
        "found_fields": [
          "vendor",
          "total"
        ],
        "input_tokens": 318,
        "missing_fields": [
          "due_date"
        ],
        "model": "gemini-3.8-flash",
        "output_tokens": 31
      },
      "name": "extract_data",
      "output_formatter": "actions.format_extract_data_output",
      "parameters": [
        {
          "description": "The text to pull the fields out of, such as an email or an invoice. Leave blank when the files hold everything.",
          "display_name": "Text",
          "multiline": true,
          "name": "text",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "accepts_file_upload": true,
          "accepts_variable_reference": true,
          "description": "Pictures, PDFs or other files to read: upload them, pick files from an earlier step, or paste public web addresses. Up to 10 files and 20 MB together.",
          "display_name": "Files",
          "name": "files",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The pieces of information you want, one per entry. Add what each means after a colon to steer it: 'total: the amount due in dollars'. A field the material doesn't state comes back empty.",
          "display_name": "Fields",
          "name": "fields",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Instead of 'Fields', paste a JSON Schema whose root is an object, for numbers, lists or nested fields.",
          "display_name": "JSON Schema",
          "multiline": true,
          "name": "json_schema",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Extra rules, such as 'Write dates as YYYY-MM-DD'.",
          "display_name": "Instructions",
          "multiline": true,
          "name": "instructions",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "default": "gemini-3.8-flash",
          "description": "Which Gemini model reads the material. Defaults to Gemini 3.8 Flash. You can also type any other Gemini model id.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Gemini 3.8 Flash",
              "value": "gemini-3.8-flash"
            },
            {
              "label": "Gemini 3.6 Flash",
              "value": "gemini-3.6-flash"
            },
            {
              "label": "Gemini 3.5 Flash-Lite (fastest, lowest cost)",
              "value": "gemini-3.5-flash-lite"
            },
            {
              "label": "Gemini 4 Argon (most capable, needs billing)",
              "value": "gemini-4-argon"
            },
            {
              "label": "Gemini 3.5 Flash (older)",
              "value": "gemini-3.5-flash"
            },
            {
              "label": "Gemini 3.1 Flash-Lite (older, retires May 2027)",
              "value": "gemini-3.1-flash-lite"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-gemini/extract-data",
      "result_str_template": "Filled the fields; missing: {google_gemini_extract_data,missing_fields}.",
      "returns": {
        "properties": {
          "data": {
            "description": "The fields, by name; null where the material doesn't say.",
            "type": "object"
          },
          "found_fields": {
            "description": "The fields Gemini filled in.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "input_tokens": {
            "description": "Tokens read.",
            "type": "number"
          },
          "missing_fields": {
            "description": "The fields it left empty.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "model": {
            "description": "The model that read it.",
            "type": "string"
          },
          "output_tokens": {
            "description": "Tokens written.",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
