{
  "actions": {
    "generate_image": {
      "description": "Generate an image from a text prompt.",
      "display_name": "Generate image",
      "display_str_template": "Generate image from prompt.",
      "handler": "actions.generate_image",
      "id": "google_gemini_generate_image",
      "method": "POST",
      "mock_response": {
        "image_count": 1,
        "images": [
          "base64encodedimagedata..."
        ]
      },
      "name": "generate_image",
      "parameters": [
        {
          "description": "The text prompt describing the image to generate",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "gemini-3.1-flash-image",
          "description": "Which model to use. Defaults to gemini-3.1-flash-image.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Nano Banana 2 (highest quality)",
              "value": "gemini-3.1-flash-image"
            },
            {
              "label": "Nano Banana Lite (fastest, cheapest)",
              "value": "gemini-3.1-flash-lite-image"
            },
            {
              "label": "Nano Banana Pro",
              "value": "gemini-3-pro-image"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-gemini/generate-image",
      "result_str_template": "Generated {0} image(s).",
      "returns": {
        "properties": {
          "image_count": {
            "description": "Number of images generated",
            "type": "number"
          },
          "images": {
            "description": "Base64-encoded generated images",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "generate_model_response": {
      "description": "Generate a text response using a Gemini model.",
      "display_name": "Generate text response",
      "display_str_template": "Generate response for prompt.",
      "handler": "actions.generate_model_response",
      "id": "google_gemini_generate_model_response",
      "method": "POST",
      "mock_response": {
        "response_text": "This is a sample generated response."
      },
      "name": "generate_model_response",
      "parameters": [
        {
          "description": "The text prompt to send to the model",
          "display_name": "Prompt",
          "multiline": true,
          "name": "prompt",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "gemini-3.5-flash",
          "description": "Which Gemini model to use. Defaults to gemini-3.5-flash.",
          "display_name": "Model",
          "name": "model",
          "options": [
            {
              "label": "Gemini 3.5 Flash",
              "value": "gemini-3.5-flash"
            },
            {
              "label": "Gemini 3.1 Flash-Lite (faster, lower cost)",
              "value": "gemini-3.1-flash-lite"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/google-gemini/generate-model-response",
      "result_str_template": "Generated response with {0} characters.",
      "returns": {
        "properties": {
          "response_text": {
            "description": "The generated text response",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Generate text and images with Google's Gemini AI models.",
  "display_name": "Google Gemini",
  "id": "google_gemini"
}
