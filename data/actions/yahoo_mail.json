{
  "actions": {
    "find_emails": {
      "description": "Find the newest emails in a Yahoo Mail folder, optionally only from one sender, with certain words in the subject, received after a date or unread, with each email's text. Reading them doesn't mark them as read.",
      "display_name": "Find emails",
      "display_str_template": "Find emails in Yahoo Mail.",
      "handler": "actions.find_emails",
      "id": "yahoo_mail_find_emails",
      "method": "POST",
      "mock_response": {
        "result": {
          "count": 1,
          "emails": [
            {
              "attachment_names": [
                "invoice-1042.pdf"
              ],
              "body": "Hi,\n\nPlease find invoice 1042 attached.\n",
              "cc": [],
              "folder": "INBOX",
              "from": "Accounts <accounts@supplier.example>",
              "from_address": "accounts@supplier.example",
              "from_name": "Accounts",
              "has_attachments": true,
              "id": "4182",
              "is_read": false,
              "message_id": "<abc123@supplier.example>",
              "received_at": "2026-09-22T13:14:05Z",
              "reply_body": "Hi,\n\nPlease find invoice 1042 attached.",
              "snippet": "Please find invoice 1042 attached.",
              "subject": "Invoice 1042",
              "to": [
                "you@yahoo.com"
              ]
            }
          ]
        }
      },
      "name": "find_emails",
      "output_formatter": "actions.format_found_emails",
      "parameters": [
        {
          "description": "The folder to look in, by its name as Yahoo Mail shows it, such as Inbox, Sent or Archive. Leave blank for the inbox.",
          "display_name": "Folder",
          "name": "folder",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only emails from this address or name, or any part of it, such as @example.com.",
          "display_name": "From",
          "name": "sender",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only emails whose subject contains these words.",
          "display_name": "Subject contains",
          "name": "subject",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only emails received on or after this day.",
          "display_name": "Received on or after",
          "name": "received_after",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only emails that haven't been read yet.",
          "display_name": "Unread only",
          "name": "unread_only",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "How many of the newest matching emails to return, from 1 to 50. 10 if left blank.",
          "display_name": "How many",
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/yahoo-mail/find-emails",
      "result_str_template": "Found {yahoo_mail_find_emails,result,count} emails in Yahoo Mail.",
      "returns": {
        "properties": {
          "result": {
            "description": "The emails found, newest first.",
            "properties": {
              "count": {
                "description": "How many emails were found.",
                "type": "number"
              },
              "emails": {
                "description": "The emails, newest first.",
                "items": {
                  "properties": {
                    "attachment_names": {
                      "description": "The attached files' names.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "body": {
                      "description": "Its text.",
                      "type": "string"
                    },
                    "cc": {
                      "description": "The Cc addresses.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "folder": {
                      "description": "The folder it's in.",
                      "type": "string"
                    },
                    "from": {
                      "description": "Who sent it, as written.",
                      "type": "string"
                    },
                    "from_address": {
                      "description": "The sender's email address.",
                      "type": "string"
                    },
                    "from_name": {
                      "description": "The sender's name.",
                      "type": "string"
                    },
                    "has_attachments": {
                      "description": "Whether files are attached.",
                      "type": "boolean"
                    },
                    "id": {
                      "description": "The email's ID in its folder.",
                      "type": "string"
                    },
                    "is_read": {
                      "description": "Whether it's been read.",
                      "type": "boolean"
                    },
                    "message_id": {
                      "description": "The email's Message-ID header.",
                      "type": "string"
                    },
                    "received_at": {
                      "description": "When Yahoo received it (UTC).",
                      "type": "string"
                    },
                    "reply_body": {
                      "description": "Its text without the quoted earlier emails.",
                      "type": "string"
                    },
                    "snippet": {
                      "description": "The start of its text.",
                      "type": "string"
                    },
                    "subject": {
                      "description": "The subject line.",
                      "type": "string"
                    },
                    "to": {
                      "description": "The To addresses.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read"
      ]
    },
    "send_email": {
      "description": "Send a plain text or HTML email through Yahoo Mail.",
      "display_name": "Send an email",
      "display_str_template": "Send an email to '{0}'.",
      "handler": "actions.send_email",
      "id": "yahoo_mail_send_email",
      "method": "POST",
      "mock_response": {
        "result": {
          "recipients": [
            "person@example.com"
          ],
          "sent": true
        }
      },
      "name": "send_email",
      "parameters": [
        {
          "description": "Who to send the email to. To reach more than one person, separate the addresses with commas.",
          "display_name": "To",
          "name": "to",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The subject line of the email.",
          "display_name": "Subject",
          "name": "subject",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The plain text content of the email.",
          "display_name": "Body text",
          "multiline": true,
          "name": "body_text",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "People to copy on the email. Separate multiple addresses with commas.",
          "display_name": "CC",
          "name": "cc",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "People to copy privately. Other recipients will not see these addresses. Separate multiple addresses with commas.",
          "display_name": "BCC",
          "name": "bcc",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/yahoo-mail/send-email",
      "result_str_template": "Email sent via Yahoo Mail.",
      "returns": {
        "properties": {
          "result": {
            "description": "Email sending confirmation",
            "properties": {
              "recipients": {
                "description": "All recipient addresses the email was sent to (To, Cc, and Bcc).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "sent": {
                "description": "Indicates whether the email was successfully sent. True means the message was handed off to Yahoo for delivery.",
                "type": "boolean"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "write"
      ]
    }
  },
  "categories": [
    "Email"
  ],
  "description": "Send emails from your Yahoo Mail account, find and read them, and start workflows when new ones arrive.",
  "display_name": "Yahoo Mail",
  "id": "yahoo_mail",
  "logo": "https://www.lodol.com/app-icons/yahoo-mail-icon.jpeg",
  "triggers": {
    "yahoo_mail_new_email_trigger": {
      "description": "Runs when a new email arrives in a Yahoo Mail folder - the inbox unless you choose another - optionally only from one sender or domain, or with certain words in the subject. Runs once for each email, with its text. Emails already there when the workflow is turned on don't start it.",
      "display_name": "New email",
      "id": "yahoo_mail_new_email_trigger",
      "output": {
        "attachment_names": "string",
        "body": "string",
        "cc": "string",
        "date": "string",
        "email_id": "string",
        "folder": "string",
        "from": "string",
        "from_address": "string",
        "from_name": "string",
        "has_attachments": "boolean",
        "message_id": "string",
        "received_at": "string",
        "reply_body": "string",
        "reply_to": "string",
        "snippet": "string",
        "subject": "string",
        "to": "string"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Only trigger for emails from this address, or from a whole domain written as @example.com. Leave blank to watch every new email.",
          "display_name": "From",
          "name": "sender",
          "required": false
        },
        {
          "arg_index": 1,
          "description": "Only trigger for emails whose subject contains these words, in any case. Leave blank for every subject.",
          "display_name": "Subject contains",
          "name": "subject",
          "required": false
        },
        {
          "arg_index": 2,
          "description": "The folder to watch, by its name as Yahoo Mail shows it, such as Inbox or Archive. Leave blank for the inbox.",
          "display_name": "Folder",
          "name": "folder",
          "required": false
        }
      ]
    }
  }
}
