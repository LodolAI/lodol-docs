          "description": "Job ID.",
          "display_name": "Job ID",
          "name": "job_id",
          "required": true
        }
      ]
    },
    "decart_new_file_trigger": {
      "description": "Runs for each new uploaded file in Decart. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
