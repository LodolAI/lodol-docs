      "id": "decart_job_completed_trigger",
      "output": {
        "record": "object with the fields job_id, status"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "Job ID.",
          "display_name": "Job ID",
          "name": "job_id",
          "required": true
        }
      ]
    },
    "decart_job_failed_trigger": {
      "description": "Runs each time a generation is failed in Decart. Ones failed before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Generation failed",
      "id": "decart_job_failed_trigger",
      "output": {
        "record": "object with the fields job_id, status"
      },
      "parameters": [
