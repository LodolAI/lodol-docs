{
  "actions": {
    "create_comment": {
      "description": "Add a comment to one of your Facebook Page's posts, identified by its post ID.",
      "display_name": "Create a comment",
      "display_str_template": "Comment on Facebook post {0}.",
      "handler": "actions.create_comment",
      "id": "facebook_pages_create_comment",
      "method": "POST",
      "mock_response": {
        "id": "987654321_111222333"
      },
      "name": "create_comment",
      "output_formatter": "actions.format_create_comment_output",
      "parameters": [
        {
          "description": "The ID of the post to comment on (as returned by Create a post), for example, 123456789_987654321.",
          "display_name": "Post ID",
          "name": "post_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The text of the comment.",
          "display_name": "Comment",
          "multiline": true,
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/facebook_pages/create-comment",
      "result_str_template": "Comment posted.",
      "returns": {
        "properties": {
          "id": {
            "description": "The created comment's ID.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "create_post": {
      "description": "Publish a text post to your Facebook Page, optionally attaching a link that Facebook renders as a preview card.",
      "display_name": "Create a post",
      "display_str_template": "Post to Facebook Page: '{0}'.",
      "handler": "actions.create_post",
      "id": "facebook_pages_create_post",
      "method": "POST",
      "mock_response": {
        "id": "123456789_987654321"
      },
      "name": "create_post",
      "output_formatter": "actions.format_create_post_output",
      "parameters": [
        {
          "description": "The text of the post.",
          "display_name": "Message",
          "multiline": true,
          "name": "message",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Optional URL to attach; Facebook renders it as a link preview, for example, https://example.com/article.",
          "display_name": "Link",
          "name": "link",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/facebook_pages/create-post",
      "result_str_template": "Post created.",
      "returns": {
        "properties": {
          "id": {
            "description": "The created post's ID.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "list_posts": {
      "description": "List the most recent posts published to your Facebook Page.",
      "display_name": "List posts",
      "display_str_template": "List recent Facebook Page posts.",
      "handler": "actions.list_posts",
      "id": "facebook_pages_list_posts",
      "method": "POST",
      "mock_response": {
        "posts": [
          {
            "created_time": "2024-01-15T10:00:00+0000",
            "id": "123456789_111",
            "message": "Hello from our Page!",
            "permalink_url": "https://www.facebook.com/123456789/posts/111"
          }
        ]
      },
      "name": "list_posts",
      "output_formatter": "actions.format_list_posts_output",
      "parameters": [
        {
          "default": 10,
          "description": "How many posts to return (1-100).",
          "display_name": "Limit",
          "maximum": 100,
          "minimum": 1,
          "name": "limit",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/facebook_pages/list-posts",
      "result_str_template": "Posts fetched.",
      "returns": {
        "properties": {
          "posts": {
            "description": "The Page's recent posts.",
            "items": {
              "properties": {
                "created_time": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "permalink_url": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Publish posts and comments to your Facebook Page and list its recent posts.",
  "display_name": "Facebook Pages",
  "id": "facebook_pages"
}
