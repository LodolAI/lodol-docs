    "get_color": {
      "description": "Look up one CSS colour by name and get its hex, rgb() and hsl() forms and the group and theme the service files it under. Pick a name from the list or type one from an earlier step: case, spaces and hyphens do not matter, so dodger blue finds DodgerBlue. An unknown name is reported as such, with a pointer to the search.",
      "display_name": "Get a CSS colour",
      "display_str_template": "Get the CSS colour {0}.",
      "handler": "actions.get_color",
      "id": "css_colors_get_color",
      "method": "POST",
