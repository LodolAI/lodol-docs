{
  "actions": {
    "check_service_status": {
      "description": "Check whether the CSS Colors API is answering, and how quickly. This is the one action that reports a problem as a value instead of failing the step, so a workflow can decide what to do about it. Being reachable but not serving colours is reported separately from being down.",
      "display_name": "Check service status",
      "display_str_template": "Check the CSS Colors API status.",
      "handler": "actions.check_service_status",
      "id": "css_colors_check_service_status",
      "method": "POST",
      "mock_response": {
        "message": "The CSS Colors API is up and answering.",
        "online": true,
        "reachable": true,
        "response_time_ms": 61.8,
        "status_code": 200
      },
      "name": "check_service_status",
      "output_formatter": "actions.format_status_output",
      "parameters": [],
      "path": "/actions/library/css-colors/check-service-status",
      "result_str_template": "Service status checked.",
      "returns": {
        "properties": {
