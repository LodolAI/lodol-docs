            "type": "number"
          },
          "status_code": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "find_nearest_color": {
      "description": "Find the named CSS colour closest to any colour value: a hex such as #1E90FE, a short hex such as #19F, or channels such as rgb(30, 144, 254). The service has no lookup by value, so the table is read once and every colour measured against the value, weighted the way the eye weights the channels. An exact match is reported as one, names that share the value (Aqua and Cyan, Gray and Grey) come back as aliases, and the next nearest colours are listed with their distances so a step that wants a choice has one.",
      "display_name": "Find the nearest CSS colour",
      "display_str_template": "Find the CSS colour nearest to {0}.",
      "handler": "actions.find_nearest_color",
      "id": "css_colors_find_nearest_color",
