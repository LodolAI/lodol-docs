              },
              "width": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "saved": {
            "type": "boolean"
          },
          "saved_as_file": {
            "type": "boolean"
          },
          "size_bytes": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
