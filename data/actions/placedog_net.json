{
  "actions": {
    "check_service_status": {
      "description": "Check whether placedog.net is answering, and how quickly, without failing the step when it is not. Asks for the smallest image there is, so it costs almost nothing. Branch on 'ok' before building a page of placeholders that will not load. No API key required.",
      "display_name": "Check service status",
      "display_str_template": "Check the placedog.net service status.",
      "handler": "actions.check_service_status",
      "id": "placedog_net_check_service_status",
      "method": "POST",
      "mock_response": {
        "latency_ms": 186.0,
        "message": null,
        "ok": true,
        "status_code": 200
      },
      "name": "check_service_status",
      "output_formatter": "actions.format_status_output",
      "parameters": [],
      "path": "/actions/library/placedog-net/check-service-status",
      "result_str_template": "Status checked.",
      "returns": {
        "properties": {
          "latency_ms": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "status_code": {
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "get_dog_photo": {
      "description": "Get a placeholder photograph of a dog, at a size you choose and with an optional effect, as an address to drop into a mock-up or as a file to keep. Leave 'Save as a file' off and the step costs no request at all. No API key required.",
      "display_name": "Get a dog photo",
      "display_str_template": "Get a dog photo.",
      "handler": "actions.get_dog_photo",
      "id": "placedog_net_get_dog_photo",
      "method": "POST",
      "mock_response": {
        "document_ref": "",
        "documents": [],
        "file_url": "",
        "photo": {
          "content_type": null,
          "filename": null,
          "filter": null,
          "height": 480,
          "height_is_exact": true,
          "image_id": null,
          "is_reproducible": false,
          "random": false,
          "url": "https://placedog.net/640/480",
          "width": 640
        },
        "saved": false,
        "saved_as_file": false,
        "size_bytes": 0
      },
      "name": "get_dog_photo",
      "output_formatter": "actions.format_photo_output",
      "parameters": [
        {
          "description": "How wide the photograph should be, in pixels, from 1 to 1000. Defaults to 640. Anything larger is stopped here, because placedog.net does not refuse an oversized request: it quietly returns a 1000 pixel image instead.",
          "display_name": "Width",
          "examples": [
            {
              "label": "A card image",
              "value": "640"
            }
          ],
          "maximum": 1000,
          "minimum": 1,
          "name": "width",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "How tall the photograph should be, in pixels, from 1 to 1000. Leave it empty and the service fills it in from the chosen photograph's own proportions, which vary from picture to picture, so the height is not predictable. Give one when the slot has to be filled exactly.",
          "display_name": "Height",
          "examples": [
            {
              "label": "A card image",
              "value": "480"
            }
          ],
          "maximum": 1000,
          "minimum": 1,
          "name": "height",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "description": "An effect to apply: blur, brightness, contrast, greyscale, invert, pixelate, sepia. The short forms the service uses are accepted too, so 'g' and 'greyscale' both work, as does 'grayscale'. Leave empty for no filter. A name the service does not recognise is refused here, because it would otherwise be ignored and return the unfiltered photograph with nothing to say so.",
          "display_name": "Effect",
          "examples": [
            {
              "label": "Vintage look",
              "value": "sepia"
            }
          ],
          "name": "filter",
          "options": [
            {
              "label": "Blur",
              "value": "blur"
            },
            {
              "label": "Brightness",
              "value": "brightness"
            },
            {
              "label": "Contrast",
              "value": "contrast"
            },
            {
              "label": "Greyscale",
              "value": "greyscale"
            },
            {
              "label": "Invert",
              "value": "invert"
            },
            {
              "label": "Pixelate",
              "value": "pixelate"
            },
            {
              "label": "Sepia",
              "value": "sepia"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Add the service's 'random' parameter, which stops the same address being served from cache. Useful when a page shows several placeholders at one size and you do not want the same dog in every slot.",
          "display_name": "Force a fresh draw",
          "name": "random",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "description": "Download the photograph and keep it as a file. Leave this off and the step costs no request at all: it hands back the address, which is all a mock-up or an email template needs. Turn it on when the image has to survive the page it was put on.",
          "display_name": "Save as a file",
          "name": "save_as_file",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/placedog-net/get-dog-photo",
      "result_str_template": "Photo retrieved.",
      "returns": {
