{
  "actions": {
    "find_similar_content": {
      "description": "Find web pages that are similar to a page you provide.",
      "display_name": "Find similar pages",
      "display_str_template": "Find pages similar to '{0}'.",
      "handler": "actions.find_similar_content",
      "id": "exa_find_similar_content",
      "method": "POST",
      "mock_response": {
        "results": [
          {
            "id": "similar-123",
            "score": 0.87,
            "title": "Related Article",
            "url": "https://similar-site.com/article"
          }
        ]
      },
      "name": "find_similar_content",
      "parameters": [
        {
          "description": "The web address (URL) of the page to find similar pages for.",
          "display_name": "Web page address",
          "name": "url",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "How many similar pages to return (1-100). Defaults to 10.",
          "display_name": "Number of results",
          "name": "num_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": false,
          "description": "Leave out other pages from the same website as the page you provided.",
          "display_name": "Skip the same website",
          "name": "exclude_source_domain",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/exa/find-similar",
      "result_str_template": "Found {results,length} similar pages.",
      "returns": {
        "properties": {
          "result_count": {
            "description": "How many results were returned.",
            "type": "number"
          },
          "results": {
            "description": "The similar web pages.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_answer": {
      "description": "Ask a question and get a written answer from Exa, along with the web pages the answer was based on.",
      "display_name": "Answer a question",
      "display_str_template": "Answer '{0}' with Exa.",
      "handler": "actions.get_answer",
      "id": "exa_get_answer",
      "method": "POST",
      "mock_response": {
        "answer": "SpaceX was most recently valued at $350 billion.",
        "source_count": 1,
        "sources": [
          {
            "id": "https://example.com/spacex-valuation",
            "title": "SpaceX valuation report",
            "url": "https://example.com/spacex-valuation"
          }
        ]
      },
      "name": "get_answer",
      "parameters": [
        {
          "description": "The question to answer, such as 'What is the latest valuation of SpaceX?'.",
          "display_name": "Question",
          "multiline": true,
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": false,
          "description": "Also return the text of each source page alongside the answer. Leave off unless a later step needs to read the sources.",
          "display_name": "Include source page text",
          "name": "include_sources_text",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/exa/answer",
      "result_str_template": "Answered using {sources,length} sources.",
      "returns": {
        "properties": {
          "answer": {
            "description": "The written answer.",
            "type": "string"
          },
          "source_count": {
            "description": "How many sources were used.",
            "type": "number"
          },
          "sources": {
            "description": "The web pages the answer was based on.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "get_contents": {
      "description": "Get the full text of one or more web pages by their web address.",
      "display_name": "Get page contents",
      "display_str_template": "Get the contents of {0}.",
      "handler": "actions.get_contents",
      "id": "exa_get_contents",
      "method": "POST",
      "mock_response": {
        "contents": [
          {
            "id": "https://example.com/article",
            "text": "Full article content here...",
            "url": "https://example.com/article"
          }
        ]
      },
      "name": "get_contents",
      "parameters": [
        {
          "description": "A list of web addresses (URLs) of the pages to read, such as those from an earlier search. Pass a list even when there is only one page.",
          "display_name": "Web page addresses",
          "name": "urls",
          "required": true,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Trim each page to this many characters. Leave blank to get the whole page.",
          "display_name": "Character limit per page",
          "minimum": 1,
          "name": "max_characters",
          "required": false,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/exa/get-contents",
      "result_str_template": "Retrieved content for {contents,length} pages.",
      "returns": {
        "properties": {
          "content_count": {
            "description": "How many pages were returned.",
            "type": "number"
          },
          "contents": {
            "description": "The text content of each page.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "search_web": {
      "description": "Search the web with Exa and get a list of matching pages.",
      "display_name": "Search the web",
      "display_str_template": "Search the web for '{0}'.",
      "handler": "actions.search_web",
      "id": "exa_search_web",
      "method": "POST",
      "mock_response": {
        "results": [
          {
            "id": "result-123",
            "score": 0.95,
            "title": "Example Article",
            "url": "https://example.com/article"
          }
        ]
      },
      "name": "search_web",
      "parameters": [
        {
          "description": "What to search for.",
          "display_name": "Query",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": 10,
          "description": "How many results to return (1-100). Defaults to 10.",
          "display_name": "Number of results",
          "name": "num_results",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": "auto",
          "description": "How hard Exa works on the search. 'Automatic' suits almost every case; the faster types trade some quality for speed, and the deep types research across several steps and can take up to a minute.",
          "display_name": "Search type",
          "name": "type",
          "options": [
            {
              "label": "Automatic (recommended)",
              "value": "auto"
            },
            {
              "label": "Fast",
              "value": "fast"
            },
            {
              "label": "Instant (lowest quality)",
              "value": "instant"
            },
            {
              "label": "Deep (lightweight)",
              "value": "deep-lite"
            },
            {
              "label": "Deep (multi-step research)",
              "value": "deep"
            },
            {
              "label": "Deep (maximum reasoning, slowest)",
              "value": "deep-reasoning"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Narrow results to a specific type of page. Leave blank to search everything. Companies and People are drawn from Exa's own indexes and don't support the date filters or 'Websites to exclude'.",
          "display_name": "Focus on a category",
          "name": "category",
          "options": [
            {
              "label": "Companies",
              "value": "company"
            },
            {
              "label": "People (LinkedIn profiles)",
              "value": "people"
            },
            {
              "label": "Publications (research papers)",
              "value": "publication"
            },
            {
              "label": "News",
              "value": "news"
            },
            {
              "label": "Personal sites",
              "value": "personal site"
            },
            {
              "label": "Financial reports",
              "value": "financial report"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only show results from these websites (for example, nytimes.com).",
          "display_name": "Websites to include",
          "name": "include_domains",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Leave out results from these websites (for example, reddit.com).",
          "display_name": "Websites to exclude",
          "name": "exclude_domains",
          "required": false,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "Only show pages published on or after this date, in YYYY-MM-DD format.",
          "display_name": "Published after",
          "name": "start_published_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only show pages published on or before this date, in YYYY-MM-DD format.",
          "display_name": "Published before",
          "name": "end_published_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "default": true,
          "description": "Include the passages of each page that best match the search, so later steps can read the findings without fetching every page.",
          "display_name": "Include relevant excerpts",
          "name": "include_highlights",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        },
        {
          "default": false,
          "description": "Also include the text of each page, trimmed to 8,000 characters. Leave off unless a later step needs the full page, since the excerpts above are usually enough.",
          "display_name": "Include page text",
          "name": "include_text",
          "required": false,
          "type": "ParameterType.BOOLEAN"
        }
      ],
      "path": "/actions/library/exa/search-web",
      "result_str_template": "Found {results,length} results.",
      "returns": {
        "properties": {
          "result_count": {
            "description": "How many results were returned.",
            "type": "number"
          },
          "results": {
            "description": "The matching web pages.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "summarize_contents": {
      "description": "Summarize one or more web pages by their web address, focused on a question or topic you provide.",
      "display_name": "Summarize web pages",
      "display_str_template": "Summarize {0} for '{1}'.",
      "handler": "actions.summarize_contents",
      "id": "exa_summarize_contents",
      "method": "POST",
      "mock_response": {
        "summary": "This is a summary of the requested documents..."
      },
      "name": "summarize_contents",
      "parameters": [
        {
          "description": "A list of web addresses (URLs) of the pages to summarize, such as those from an earlier search. Pass a list even when there is only one page.",
          "display_name": "Web page addresses",
          "name": "urls",
          "required": true,
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "A question or topic to focus the summary on.",
          "display_name": "Focus question or topic",
          "name": "query",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/exa/summarize-contents",
      "result_str_template": "Summary generated.",
      "returns": {
        "properties": {
          "content_count": {
            "description": "How many pages were summarized.",
            "type": "number"
          },
          "summary": {
            "description": "The generated summary.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "description": "Search the web, read and summarize pages, and answer questions with cited sources using Exa.",
  "display_name": "Exa",
  "id": "exa"
}
