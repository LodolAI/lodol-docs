          },
          "errors": {
            "description": "Only present when a formula column failed: the column and the error.",
            "type": "object"
          },
          "fields": {
            "description": "The record's column values, keyed by column ID.",
            "type": "object"
          },
          "id": {
            "description": "The record's ID, which the other record actions take.",
            "type": "integer"
          }
        },
        "type": "object"
      }
