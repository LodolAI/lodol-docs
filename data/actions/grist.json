{
  "actions": {
    "add_column": {
      "description": "Add one column of a particular type to a table.",
      "display_name": "Add a column",
      "display_str_template": "Add the column '{2}' to {1}.",
      "handler": "actions.add_column",
      "id": "grist_add_column",
      "method": "POST",
      "mock_response": {
        "id": "Renewal_date",
        "name": "Renewal date",
        "table_id": "Deals",
        "type": "Date"
      },
      "name": "add_column",
      "output_formatter": "actions.format_add_column_output",
      "parameters": [
        {
          "description": "The Grist document to work in.",
          "display_name": "Document",
          "dynamic_source": "documents",
          "name": "doc_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table to work in.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_depends_on": [
            "doc_id"
          ],
          "name": "table_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "What to call the new column, for example 'Renewal date'.",
          "display_name": "Column name",
          "name": "column_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "text",
          "description": "What the column holds.",
          "display_name": "Column type",
          "name": "column_type",
          "options": [
            {
              "label": "Text",
              "value": "text"
            },
            {
              "label": "Number",
              "value": "number"
            },
            {
              "label": "Whole number",
              "value": "whole_number"
            },
            {
              "label": "Toggle (yes or no)",
              "value": "toggle"
            },
            {
              "label": "Date",
              "value": "date"
            },
            {
              "label": "Date & time",
              "value": "datetime"
            },
            {
              "label": "One choice from a list",
              "value": "choice"
            },
            {
              "label": "Several choices from a list",
              "value": "choice_list"
            },
            {
              "label": "A link to a record in another table",
              "value": "reference"
            },
            {
              "label": "Links to records in another table",
              "value": "reference_list"
            },
            {
              "label": "Attachments",
              "value": "attachments"
            },
            {
              "label": "Anything (Grist works it out)",
              "value": "any"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The values this column allows. Only used when the column holds one or several choices.",
          "display_name": "Choices",
          "name": "choices",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "The table this column points at. Only used when the column links to another table.",
          "display_name": "Linked table",
          "dynamic_source": "tables",
          "dynamic_source_depends_on": [
            "doc_id"
          ],
          "name": "linked_table",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The time zone a date & time column displays in, for example Europe/Paris. Defaults to UTC.",
          "display_name": "Time zone",
          "name": "time_zone",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/grist/add-column",
      "result_str_template": "Added the column.",
      "returns": {
        "properties": {
          "choices": {
            "description": "The choices it allows, for a choice column.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "The column ID used in record values.",
            "type": "string"
          },
          "links_to": {
            "description": "The table it points at, for a link column.",
            "type": "string"
          },
          "name": {
            "description": "The name it was given.",
            "type": "string"
          },
          "table_id": {
            "description": "The table it was added to.",
            "type": "string"
          },
          "type": {
            "description": "What it holds.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "add_or_update_record": {
      "description": "Find the record whose column holds a given value and update it, or add it when there is no such record. The result says which happened.",
      "display_name": "Add or update a record",
      "display_str_template": "Add or update a record in {1} where {2} is {3}.",
