          "display_name": "Document",
          "dynamic_source": "documents",
          "name": "doc_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The table to work in.",
          "display_name": "Table",
          "dynamic_source": "tables",
          "dynamic_source_depends_on": [
            "doc_id"
          ],
          "name": "table_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The column that identifies the record, such as an email address or an order number.",
          "display_name": "Match column",
          "dynamic_source": "writable_columns",
          "dynamic_source_depends_on": [
            "doc_id",
            "table_id"
          ],
          "name": "match_column",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The value that column must hold.",
          "display_name": "Match value",
          "name": "match_value",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The values to set on the record, whether it is found or created. Leave a column blank to leave it alone.",
          "display_name": "Column values",
          "dynamic_source": "writable_columns",
          "dynamic_source_depends_on": [
            "doc_id",
            "table_id"
          ],
          "name": "fields",
          "required": true,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/grist/add-or-update-record",
      "result_str_template": "Saved the record.",
      "returns": {
        "properties": {
          "created": {
            "description": "True when the record was added, false when an existing one was updated.",
