          "Due": "2026-03-01",
          "Status": "Open",
          "Tags": [
            "Priority",
            "Renewal"
          ]
        },
        "id": 3
      },
      "name": "add_or_update_record",
      "output_formatter": "actions.format_add_or_update_record_output",
      "parameters": [
        {
