{
  "actions": {
    "get_book": {
      "description": "Get one of Softwium's dummy programming books by its id: its title, ISBN, page count and authors. No API key required.",
      "display_name": "Get book",
      "display_str_template": "Get Softwium book {0}.",
      "handler": "actions.get_book",
      "id": "softwium_get_book",
      "method": "POST",
      "mock_response": {
        "book": {
          "authors": [
            "Christian Bauer",
            "Gavin King"
          ],
          "authors_text": "Christian Bauer, Gavin King",
          "id": 23,
          "isbn": "1932394885",
          "page_count": 880,
          "title": "Java Persistence with Hibernate"
        }
      },
      "name": "get_book",
      "output_formatter": "actions.format_book_output",
      "parameters": [
        {
          "description": "The book's Softwium id, 1 to 80.",
          "display_name": "Book id",
          "examples": [
            {
              "label": "Java Persistence with Hibernate",
              "value": "23"
            },
            {
              "label": "Unlocking Android",
              "value": "1"
            }
          ],
          "minimum": 1,
          "name": "book_id",
          "required": true,
          "type": "ParameterType.NUMBER"
        }
      ],
      "path": "/actions/library/softwium/get-book",
      "result_str_template": "Got the book {softwium_get_book,book,title}.",
      "returns": {
        "properties": {
          "book": {
            "description": "A dummy programming book.",
            "properties": {
              "authors": {
                "description": "The book's authors, one name each.",
                "items": {
                  "description": "An author's name.",
                  "type": "string"
                },
                "type": "array"
              },
              "authors_text": {
                "description": "The authors as one comma-separated line.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Softwium's id for the book, 1 to 80.",
                "type": "number"
              },
              "isbn": {
                "description": "The book's ISBN, e.g. '1935182080'. Null when unknown.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "page_count": {
                "description": "How many pages the book has. Null when unknown.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "title": {
                "description": "The book's title.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "get_currency": {
