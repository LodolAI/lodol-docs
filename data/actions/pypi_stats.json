    "get_download_history": {
      "description": "Get a package's daily download series, up to the 180 days PyPI Stats keeps. Comes back with the total, the average per day, the busiest day, and the same figure for the equal window immediately before, so a step can say 'up 12% on the month before' rather than only quoting a number. Roll the rows up by week or month for a chart, or ask for no series at all when only the totals matter. Mirror traffic is left out by default. No API key required.",
      "display_name": "Get download history",
      "display_str_template": "Get PyPI download history for {package}.",
      "handler": "actions.get_download_history",
      "id": "pypi_stats_get_download_history",
      "method": "POST",
      "mock_response": {
        "average_per_day": 42831003.73,
        "busiest_day": {
          "date": "2026-08-11",
          "downloads": 51204884
        },
        "categories": [
          {
            "category": "without_mirrors",
            "downloads": 1284930112,
            "label": "Excluding mirrors",
            "percent": 100.0
          }
        ],
        "data_available": {
          "days": 180,
          "first_date": "2026-02-25",
          "last_date": "2026-08-23",
          "retention_days": 180
        },
        "date_range": {
          "days": 30,
          "first_date": "2026-07-25",
          "last_date": "2026-08-23"
        },
        "found": true,
        "granularity": "daily",
        "last_updated": "2026-08-23",
        "mirrors": "exclude",
        "package": "requests",
        "previous_period": {
          "change": 80811657,
          "change_percent": 6.71,
          "comparable": true,
          "downloads": 1204118455,
          "end_date": "2026-07-24",
          "start_date": "2026-06-25"
        },
        "series": [
          {
            "date": "2026-08-22",
            "downloads": 41882901
          },
          {
            "date": "2026-08-23",
            "downloads": 42118904
          }
        ],
        "total_downloads": 1284930112,
        "url": "https://pypistats.org/packages/requests"
      },
      "name": "get_download_history",
      "output_formatter": "actions.format_history_output",
      "parameters": [
        {
          "description": "The PyPI package to read. Spell it however you like: Zope.Interface, zope_interface and zope-interface all reach the same package. Use __all__ for the totals across the whole of PyPI.",
          "display_name": "Package",
          "examples": [
            {
              "label": "A widely used package",
              "value": "requests"
            },
            {
              "label": "A name with a dot in it",
              "value": "zope.interface"
            },
            {
              "label": "The whole of PyPI",
              "value": "__all__"
            }
          ],
          "name": "package",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "default": "exclude",
          "description": "Mirrors such as bandersnatch download every package on PyPI whether anyone uses it or not, so they are left out by default. Counting both keeps them on separate rows; the total then counts the with-mirrors figure once rather than adding it to a subset of itself.",
          "display_name": "Mirror traffic",
          "name": "mirrors",
          "options": [
            {
              "label": "Real users only: leave mirror traffic out",
              "value": "exclude"
            },
            {
              "label": "Everything: count mirror traffic too",
              "value": "include"
            },
            {
              "label": "Both, kept apart so you can see the difference",
              "value": "both"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Only count downloads on or after this date. Leave empty to start at the earliest day PyPI Stats still holds, which is 180 days ago.",
          "display_name": "From",
          "name": "start_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "description": "Only count downloads on or before this date. Leave empty to run up to the most recent day counted.",
          "display_name": "To",
          "name": "end_date",
          "required": false,
          "type": "ParameterType.DATE"
        },
        {
          "default": "daily",
          "description": "How much detail the returned series carries. Daily is one row per day, which is 180 rows over the full window; weekly and monthly roll those up; 'No series' returns the totals and the per-category split without any rows at all.",
          "display_name": "Roll the series up by",
          "name": "granularity",
          "options": [
            {
              "label": "Daily: one row per day",
              "value": "daily"
            },
            {
              "label": "Weekly: rows start on a Monday",
              "value": "weekly"
            },
            {
              "label": "Monthly: one row per calendar month",
              "value": "monthly"
            },
            {
              "label": "No series: just the totals",
              "value": "none"
            }
          ],
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/pypi-stats/get-download-history",
      "result_str_template": "{pypi_stats_get_download_history,total_downloads} downloads.",
