{
  "actions": {
    "compare_packages": {
      "description": "Compare the recent downloads of several packages side by side, ranked biggest first with each one's share of the total. Answers 'are we still ahead of them?' in one step rather than several. Between two and ten packages; a package PyPI Stats has no figures for is listed as missing rather than failing the step. No API key required.",
      "display_name": "Compare packages",
      "display_str_template": "Compare PyPI downloads for {packages}.",
      "handler": "actions.compare_packages",
      "id": "pypi_stats_compare_packages",
      "method": "POST",
