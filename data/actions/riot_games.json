{
  "actions": {
    "get_account": {
      "description": "Look up a player's PUUID from their Riot ID. Every other action starts here, since Riot retired summoner names.",
      "display_name": "Get an account",
      "display_str_template": "Look up the Riot account '{1}#{2}'.",
      "handler": "actions.get_account",
      "id": "riot_games_get_account",
      "method": "POST",
      "mock_response": {
        "game_name": "Faker",
        "puuid": "cJ8s4mUeK1p2QwXyZ0aBcDeFgHiJkLmNoPqRsTuVwXyZ0aBcDeFgHiJkLmNoPqRsTuVwXyZ",
        "tag_line": "KR1"
      },
      "name": "get_account",
      "parameters": [
        {
          "description": "The continent that serves this data: 'americas', 'europe', 'asia', or 'sea'. Riot routes accounts and matches per continent rather than per game server.",
          "display_name": "Continent",
          "name": "routing_region",
          "options": [
            {
              "label": "americas",
              "value": "americas"
            },
            {
              "label": "asia",
              "value": "asia"
            },
            {
              "label": "europe",
              "value": "europe"
            },
            {
              "label": "sea",
              "value": "sea"
            }
          ],
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The part before the # in a Riot ID -- for 'Faker#KR1' that's 'Faker'.",
          "display_name": "Riot ID name",
          "name": "game_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The part after the # in a Riot ID -- for 'Faker#KR1' that's 'KR1'. The # itself is optional.",
          "display_name": "Riot ID tag",
          "name": "tag_line",
          "required": true,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/riot-games/get-account",
      "result_str_template": "Riot account retrieved.",
      "returns": {
        "properties": {
          "game_name": {
            "description": "The name part of the Riot ID",
            "type": "string"
          },
          "puuid": {
            "description": "The player's unique ID. Use with Get a summoner and List recent matches.",
            "type": "string"
          },
          "tag_line": {
            "description": "The tag part of the Riot ID",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
