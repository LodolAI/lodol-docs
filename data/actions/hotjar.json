  "description": "Read your Hotjar surveys and their responses, and handle people's requests to see or delete their data.",
  "display_name": "Hotjar",
  "id": "hotjar",
  "logo": "https://www.lodol.com/app-icons/hotjar-icon.png",
  "triggers": {
    "hotjar_new_survey_response_trigger": {
      "description": "Runs when someone responds to a Hotjar survey, including responses they haven't finished.",
      "display_name": "New survey response",
      "id": "hotjar_new_survey_response_trigger",
      "output": {
        "id": "Unique event identifier",
        "survey_response": "The record returned by the service"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Hotjar survey to watch.",
          "display_name": "Survey",
          "name": "survey_id",
          "required": true
        }
      ]
    },
    "hotjar_new_survey_trigger": {
      "description": "Runs when a survey is created on your Hotjar site.",
      "display_name": "New survey",
      "id": "hotjar_new_survey_trigger",
      "output": {
        "id": "Unique event identifier",
        "survey": "The record returned by the service"
      },
      "parameters": []
    },
    "hotjar_survey_response_completed_trigger": {
      "description": "Runs when someone finishes a Hotjar survey. Unfinished responses are skipped until they're complete.",
