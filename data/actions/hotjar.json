      "mock_response": {
        "data": {
          "accepted": true
        }
      },
      "name": "delete_user_data",
      "output_formatter": "documented_provider._format_output",
      "parameters": [
        {
          "description": "The email address of the person whose data to find.",
          "display_name": "Email",
          "name": "email",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The person's own user ID on your website, if your site sends it to Hotjar through Hotjar's Identify API.",
          "display_name": "User ID on your site",
          "name": "site_user_id",
          "required": false,
          "type": "ParameterType.STRING"
        }
      ],
      "path": "/actions/library/hotjar/delete-user-data",
      "result_str_template": "Delete user data completed.",
      "returns": {
        "properties": {
          "data": {
            "description": "The response from Hotjar.",
