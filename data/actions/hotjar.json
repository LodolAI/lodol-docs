      "id": "hotjar_survey_response_completed_trigger",
      "output": {
        "id": "Unique event identifier",
        "survey_response": "The record returned by the service"
      },
      "parameters": [
        {
          "arg_index": 0,
          "description": "The Hotjar survey to watch.",
          "display_name": "Survey",
          "name": "survey_id",
          "required": true
        }
      ]
    },
    "hotjar_survey_turned_on_or_off_trigger": {
      "description": "Runs when a Hotjar survey is turned on or turned off.",
      "display_name": "Survey turned on or off",
      "id": "hotjar_survey_turned_on_or_off_trigger",
      "output": {
        "id": "Unique event identifier",
