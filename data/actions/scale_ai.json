      "id": "scale_ai_new_task_trigger",
      "output": {
        "record": "object with the fields task_id, status, created_at, type, instruction, params, metadata, response"
      },
      "parameters": []
    },
    "scale_ai_task_status_changed_trigger": {
      "description": "Runs each time a task status changes in Scale AI. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
