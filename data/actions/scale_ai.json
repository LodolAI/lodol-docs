  "triggers": {
    "scale_ai_new_project_trigger": {
      "description": "Runs for each new project in Scale AI. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "New project",
      "id": "scale_ai_new_project_trigger",
      "output": {
        "record": "object with the fields name, type, created_at, param_history"
      },
      "parameters": []
    },
    "scale_ai_new_task_trigger": {
      "description": "Runs for each new task in Scale AI. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
