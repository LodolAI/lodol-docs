  "triggers": {
    "uber_direct_delivery_status_changed_trigger": {
      "description": "Runs each time a delivery status changes in Uber Direct. Changes made before the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
      "display_name": "Delivery status changed",
      "id": "uber_direct_delivery_status_changed_trigger",
      "output": {
        "record": "object with the fields id, quote_id, status, complete, tracking_url, created, updated"
      },
      "parameters": []
    },
    "uber_direct_new_delivery_trigger": {
      "description": "Runs for each new delivery in Uber Direct. Ones already there when the workflow is turned on don't start it. It can watch up to 4,000. How often it checks follows your workspace plan.",
