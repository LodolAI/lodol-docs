      "mock_response": {
        "result": {
          "data": {},
          "message": "OK"
        }
      },
      "name": "call_tool",
      "output_formatter": "_specs.<locals>.<lambda>",
      "parameters": [
        {
          "description": "Choose an available official Any.do tool.",
          "display_name": "Tool",
          "dynamic_source": "tools",
          "name": "tool_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Fill the arguments required by the selected tool. Its live schema is available from List available tools.",
          "display_name": "Arguments",
          "dynamic_source": "arguments",
          "dynamic_source_depends_on": [
            "tool_name"
          ],
          "name": "arguments",
          "required": false,
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/any-do/call-tool",
      "result_str_template": "Any.do request completed.",
      "returns": {
        "properties": {
          "result": {
            "description": "The complete official Any.do result: message and data.",
            "type": "object"
          }
        },
        "type": "object"
      }
    },
