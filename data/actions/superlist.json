{
  "actions": {
    "call_tool": {
      "description": "Run a supported Superlist tool with the inputs advertised by your account.",
      "display_name": "Run Superlist tool",
      "display_str_template": "Run Superlist tool.",
      "handler": "actions.call_tool",
      "id": "superlist_call_tool",
      "method": "POST",
      "mock_response": {
        "result": {
          "content": [],
          "data": null
        }
      },
      "name": "call_tool",
      "output_formatter": "hosted_mcp_provider.configure.<locals>.<lambda>",
      "parameters": [
        {
          "description": "Tool name.",
          "display_name": "Tool name",
          "dynamic_source": "tools",
          "dynamic_source_allows_custom": true,
          "name": "tool_name",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Arguments.",
          "display_name": "Arguments",
          "dynamic_source": "arguments",
          "dynamic_source_allows_custom": true,
          "dynamic_source_depends_on": [
            "tool_name"
          ],
          "name": "arguments",
          "required": false,
          "schema": {
            "description": "Arguments.",
            "type": "object"
          },
          "type": "ParameterType.OBJECT"
        }
      ],
      "path": "/actions/library/superlist/call-tool",
      "result_str_template": "Run Superlist tool completed.",
      "returns": {
        "properties": {
          "result": {
            "description": "The structured result and content blocks from the tool.",
            "properties": {
              "content": {
                "description": "Content blocks from the tool.",
                "items": {
                  "description": "One content block from the tool.",
                  "type": "object"
                },
                "type": "array"
              },
              "data": {
                "description": "Structured result, when provided.",
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scopes": [
        "read",
        "write",
        "modify",
        "delete"
      ]
    },
