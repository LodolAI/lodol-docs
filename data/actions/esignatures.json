          "display_name": "Reference",
          "name": "metadata",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "How many hours the signature request stays valid. Leave blank for no expiry.",
          "display_name": "Expires after (hours)",
          "minimum": 1,
          "name": "expires_in_hours",
          "required": false,
          "type": "ParameterType.NUMBER"
        },
        {
          "default": false,
