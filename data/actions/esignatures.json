{
  "actions": {
    "create_contract": {
      "description": "Create a contract from one of your templates and send it out for signature. Fill in the template's placeholders and list the people who need to sign.",
      "display_name": "Create contract",
      "display_str_template": "Create eSignatures contract from template {template_id}.",
      "handler": "actions.create_contract",
      "id": "esignatures_create_contract",
      "method": "POST",
      "mock_response": {
        "contract_id": "1contr11-2222",
        "metadata": "ID0001",
        "signers": [
          {
            "email": "benny@me.com",
            "id": "6signer6-9999",
            "mobile": "+12481234567",
            "name": "Benny Bell",
            "sign_page_url": "https://esignatures.com/sign/6signer6-9999"
          }
        ],
        "status": "sent",
        "title": "Loan Agreement - Saver package"
      },
      "name": "create_contract",
      "parameters": [
        {
          "description": "The template to generate the contract from.",
          "display_name": "Template",
          "dynamic_source": "templates",
          "name": "template_id",
          "required": true,
          "type": "ParameterType.STRING"
        },
        {
          "description": "The people who need to sign. Each signer needs a name and either an email address or a mobile number.",
          "display_name": "Signers",
          "name": "signers",
          "required": true,
          "schema": {
            "items": {
              "properties": {
                "email": {
                  "description": "The signer's email address. Provide this or a mobile number.",
                  "type": "string"
                },
                "mobile": {
                  "description": "The signer's mobile number in international format, e.g. '+12481234567'. Provide this or an email address.",
                  "type": "string"
                },
                "name": {
                  "description": "The signer's full name.",
                  "type": "string"
                },
                "signing_order": {
                  "description": "Optional signing order, e.g. '1' then '2'. Signers with the same number are asked to sign at the same time. Leave blank for no order.",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "type": "ParameterType.ARRAY"
        },
        {
          "description": "A title for the contract. Leave blank to use the template's own title.",
          "display_name": "Contract title",
          "name": "title",
          "required": false,
          "type": "ParameterType.STRING"
        },
        {
          "description": "Values that fill the template's placeholders. Add one entry per placeholder: the key is the placeholder name from your template and the value is the text to insert.",
          "display_name": "Template placeholders",
          "name": "placeholder_fields",
          "object_key_name": "placeholder key",
          "required": false,
          "type": "ParameterType.OBJECT"
        },
        {
          "description": "The language of the signing page and signer emails. Defaults to the template's own language.",
