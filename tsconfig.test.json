{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "isolatedModules": false
  },
  "include": [
    "tests/ts/**/*.ts",
    "tests/ts/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "mdx-components.tsx",
    "app/**/*.ts",
    "app/**/*.tsx"
  ]
}
