{
  "name": "@lodol/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-actions": "node scripts/run-python.js scripts/render-actions-docs.py",
    "generate-llms": "node scripts/run-python.js scripts/render-llms.py",
    "refresh-app-data": "node scripts/run-python.js scripts/refresh-app-data.py",
    "predev": "npm run generate-actions && npm run generate-llms",
    "dev": "next dev -p 3001 --experimental-https",
    "prebuild": "npm run generate-actions && npm run generate-llms",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:python": "node scripts/run-python.js -m unittest discover -s tests/python -p \"test_*.py\" -v"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/new-amsterdam": "^5.3.0",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^1.57.0",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
