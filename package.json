{
  "name": "@lodol/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-actions": "python3 scripts/render-actions-docs.py",
    "predev": "npm run generate-actions",
    "dev": "next dev -p 3001 --experimental-https",
    "prebuild": "npm run generate-actions",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:python": "python3 -m unittest discover -s tests/python -p 'test_*.py' -v"
  },
  "dependencies": {
    "fumadocs-core": "16.8.7",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.8.7",
    "next": "^16.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
